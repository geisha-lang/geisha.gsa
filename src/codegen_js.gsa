    bufPushStr(out, "function _gs_simdShift(ln, ek, op, a, amt) { const r = _gs_sNew(ln, ek), bits = _gs_sEB[ek] * 8, m = amt & (bits - 1); for (let i = 0; i < ln; i++) { const x = _gs_sGet(a, ek, i); let z; if (ek === 6 || ek === 7) { const bm = BigInt(m), ux = BigInt.asUintN(64, x), sx = BigInt.asIntN(64, x); z = op === 0 ? (ux << bm) : op === 1 ? (sx >> bm) : (ux >> bm); } else if (ek === 4 || ek === 5) { z = op === 0 ? (x << m) : op === 1 ? ((x | 0) >> m) : (x >>> m); } else { const mask = (1 << bits) - 1, ux = x & mask, sx = (ux << (32 - bits)) >> (32 - bits); z = op === 0 ? (ux << m) : op === 1 ? (sx >> m) : (ux >>> m); } _gs_sSet(r, ek, i, z); } return r; }\n");
    bufPushStr(out, "function _gs_simdFma(ln, ek, a, b, c) { const r = _gs_sNew(ln, ek); for (let i = 0; i < ln; i++) _gs_sSet(r, ek, i, _gs_sGet(a, ek, i) * _gs_sGet(b, ek, i) + _gs_sGet(c, ek, i)); return r; }\n");
    bufPushStr(out, "function _gs_simdCmp(ln, ek, op, a, b) { const r = _gs_sNew(ln, ek), ur = new Uint8Array(r.buffer), eb = _gs_sEB[ek]; for (let i = 0; i < ln; i++) { const x = _gs_sGet(a, ek, i), y = _gs_sGet(b, ek, i); const hit = op === 0 ? x === y : op === 1 ? (ek >= 8 ? x !== y : x !== y) : op === 2 ? x < y : op === 3 ? x <= y : op === 4 ? x > y : x >= y; if (hit) ur.fill(255, i * eb, (i + 1) * eb); } return r; }\n");
    bufPushStr(out, "function _gs_simdReduce(ln, ek, op, v) { const eb = _gs_sEB[ek], ub = new Uint8Array(v.buffer, v.byteOffset, v.byteLength); if (op === 5) { let m = 0; for (let i = 0; i < ln; i++) if (ub[i * eb + eb - 1] & 128) m |= (1 << i); return m | 0; } if (op === 3 || op === 4) { const ik = ek === 8 ? 4 : ek === 9 ? 6 : ek; let acc = _gs_sGet(v, ik, 0); for (let i = 1; i < ln; i++) { const x = _gs_sGet(v, ik, i); acc = op === 3 ? (acc | x) : (acc & x); } if (ik === 5) return acc | 0; if (ik === 7) return BigInt.asIntN(64, acc); return acc; } let acc = _gs_sGet(v, ek, 0); for (let i = 1; i < ln; i++) { const x = _gs_sGet(v, ek, i); if (op === 0) acc = ek === 8 ? Math.fround(acc + x) : acc + x; else if (op === 1) acc = ek >= 8 ? (Number.isNaN(acc) ? x : Number.isNaN(x) ? acc : Math.min(acc, x)) : (x < acc ? x : acc); else acc = ek >= 8 ? (Number.isNaN(acc) ? x : Number.isNaN(x) ? acc : Math.max(acc, x)) : (x > acc ? x : acc); } const tmp = _gs_sNew(1, ek); _gs_sSet(tmp, ek, 0, acc); return _gs_simdExtract(1, ek, tmp, 0); }\n");
    bufPushStr(out, "function _gs_simdPermute(ln, ek, op, a, b, imm) { const r = _gs_sNew(ln, ek); if (op === 6) { const ua = new Uint8Array(a.buffer, a.byteOffset, a.byteLength), ub = new Uint8Array(b.buffer, b.byteOffset, b.byteLength), ur = new Uint8Array(r.buffer); for (let blk = 0; blk < ln; blk += 16) for (let i = 0; i < 16; i++) { const ix = ub[blk + i]; ur[blk + i] = ix < 16 ? ua[blk + ix] : 0; } return r; } const get2 = (k) => k < ln ? _gs_sGet(a, ek, k) : _gs_sGet(b, ek, k - ln); const h = ln >> 1, sh = ((imm % ln) + ln) % ln; for (let i = 0; i < ln; i++) { const src = op === 0 ? (ln - 1 - i) : op === 1 ? ((i & 1) ? ln + (i >> 1) : (i >> 1)) : op === 2 ? ((i & 1) ? ln + h + (i >> 1) : h + (i >> 1)) : op === 3 ? (i * 2) : op === 4 ? (i * 2 + 1) : (sh + i); _gs_sSet(r, ek, i, get2(src)); } return r; }\n");
    bufPushStr(out, "function _gs_sCastVal(sek, dek, x) { if (sek >= 8 && dek < 8) { if (Number.isNaN(x)) return dek >= 6 ? 0n : 0; if (dek === 6) return x <= -9223372036854775808 ? -9223372036854775808n : x >= 9223372036854775808 ? 9223372036854775807n : BigInt(Math.trunc(x)); if (dek === 7) return x <= 0 ? 0n : x >= 18446744073709551616 ? 18446744073709551615n : BigInt(Math.trunc(x)); return _gs_sClamp(dek, Math.trunc(x)); } if (dek >= 6 && dek <= 7) return typeof x === \"bigint\" ? x : BigInt(Math.trunc(x)); return typeof x === \"bigint\" ? Number(dek >= 8 ? x : BigInt.asIntN(32, x)) : x; }\n");
    bufPushStr(out, "function _gs_simdConvert(sln, sek, dln, dek, op, a) { if (op === 0) return new DataView(a.buffer.slice(a.byteOffset, a.byteOffset + a.byteLength)); const r = _gs_sNew(dln, dek), st = (op === 3 || op === 5) ? dln : 0; for (let i = 0; i < dln; i++) _gs_sSet(r, dek, i, op >= 4 ? _gs_sGet(a, sek, st + i) : _gs_sCastVal(sek, dek, _gs_sGet(a, sek, st + i))); return r; }\n");
    bufPushStr(out, "function _gs_simdCombine(sln, sek, dln, dek, op, a, b) { const r = _gs_sNew(dln, dek); for (let i = 0; i < dln; i++) { const x = i < sln ? _gs_sGet(a, sek, i) : _gs_sGet(b, sek, i - sln); if (op === 0) _gs_sSet(r, dek, i, x); else if (op === 1) _gs_sSet(r, dek, i, _gs_sCastVal(sek, dek, x)); else { const bx = (dek <= 5 && typeof x === \"bigint\") ? Number(x < -9007199254740991n ? -9007199254740991n : x > 9007199254740991n ? 9007199254740991n : x) : x; _gs_sSet(r, dek, i, _gs_sClamp(dek, bx)); } } return r; }\n");
    bufPushStr(out, "function _gs_simdLoadPtr(tb, p, off) { const r = new Uint8Array(tb), s = p.buf, o = p.off + off; r.set(s.subarray(o, o + tb), 0); return new DataView(r.buffer); }\n");
    bufPushStr(out, "function _gs_simdLoadStr(tb, s, off) { const r = new Uint8Array(tb); r.set(s.subarray(off, Math.min(s.length, off + tb)), 0); return new DataView(r.buffer); }\n");
    bufPushStr(out, "function _gs_simdStorePtr(tb, p, off, v) { p.buf.set(new Uint8Array(v.buffer, v.byteOffset, tb), p.off + off); }\n");
    bufPushStr(out, "function _gs_hostCall(path, args) { const parts = path.split(\".\"); let obj = globalThis; let parent = globalThis; for (const k of parts) { parent = obj; obj = obj == null ? undefined : obj[k]; } if (typeof obj !== \"function\") throw new Error(\"Geisha JS extern not found: \" + path); return _gs_fromJs(obj.apply(parent, args.map(_gs_toJs))); }\n\n")
}

// ============================================================================
// Top-Level Program -> ES Module JS Emitter
// ============================================================================

def emitJsFunction(prog: CoreProgram, out: StringBuf, fd: FunDef): Void = {
    let paramsRev: Cell (List String) = cellNew(Nil);
    let initLocals: Cell (List (String, String)) = cellNew(Nil);
    let tmpCnt = cellNew(0);
    let usedIdents: StrMap Bool = strMapNew();
    let hasFvs = match fd.fnFvs { Nil -> false, _ -> true };
    let tco = !hasFvs && hasSelfTailCall(fd.fnName, fd.fnBody);
    let tmpCtx = MkJsEmitCtx {
        jcProg: prog,
        jcBuf: out,
        jcTmpCnt: tmpCnt,
        jcUsedIdents: usedIdents,
        jcIndent: cellNew(1),
        jcCurFnName: fd.fnName,
        jcTcoActive: tco,
        jcTcoParamJs: Nil,
    };
    let cp = cellNew(fd.fnParams);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(pvd, r) -> {
                let (pjs, nextLocs) = bindLocalJs(tmpCtx, cellGet(initLocals), pvd.vname);
                cellSet(paramsRev, Cons(pjs, cellGet(paramsRev)));
                cellSet(initLocals, nextLocs);
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };
    let paramJsList = listRev(cellGet(paramsRev));
    let sigParams = if (hasFvs) listAppend(paramJsList, ["$env"]) else paramJsList;

    bufPushStr(out, "function " + jsFnIdent(fd.fnName) + "(" + strJoin(sigParams, ", ") + ") {\n");

    let ctx = MkJsEmitCtx {
        jcProg: prog,
        jcBuf: out,
        jcTmpCnt: tmpCnt,
        jcUsedIdents: usedIdents,
        jcIndent: cellNew(1),
        jcCurFnName: fd.fnName,
        jcTcoActive: tco,
        jcTcoParamJs: paramJsList,
    };

    if (hasFvs) {
        let idx = cellNew(0);
        let cf = cellNew(fd.fnFvs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fv, r) -> {
                    let (fjs, nextL) = bindLocalJs(ctx, cellGet(initLocals), fv.vname);
                    cellSet(initLocals, nextL);
                    jcEmitLine(ctx, "const " + fjs + " = $env[" + intToStr(cellGet(idx)) + "];");
                    cellSet(idx, cellGet(idx) + 1);
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    } else ();

    if (tco) {
        jcEmitLine(ctx, "while (true) {");
        jcIncIndent(ctx);
        emitJsStmt(ctx, fd.fnBody, cellGet(initLocals), TgtReturn);
        jcDecIndent(ctx);
        jcEmitLine(ctx, "}")
    } else {
        emitJsStmt(ctx, fd.fnBody, cellGet(initLocals), TgtReturn)
    };

    bufPushStr(out, "}\n\n")
}

def hasDotByte(s: String): Bool = {
    let n = strLen(s);
    let i = cellNew(0);
    let found = cellNew(false);
    while (cellGet(i) < n && !cellGet(found)) {
        if (strByteAt(s, cellGet(i)) == 46) cellSet(found, true) else ();
        cellSet(i, cellGet(i) + 1)
    };
    cellGet(found)
}

pub def collectRootPubFnNames(rawDefs: List Def, prog: CoreProgram): List String = {
    let seen: StrMap Bool = strMapNew();
    let accRev: Cell (List String) = cellNew(Nil);
    let cur = cellNew(rawDefs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (isPublicVis(d.vis) && !hasDotByte(d.ident) && d.ident != "main" && !strMapContains(seen, d.ident)) {
                    match d.item {
                        ItForm(f) -> match f.node {
                            ExAbs(_, _, _) ->
                                if (strMapContains(prog.coreFns, d.ident)) {
                                    strMapInsert(seen, d.ident, true);
                                    cellSet(accRev, Cons(d.ident, cellGet(accRev)))
                                } else (),
                            _ -> (),
                        },
                        _ -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(accRev))
}

def emitGlobalCtorsJs(prog: CoreProgram, out: StringBuf): Void = {
    let cur = cellNew(prog.coreCtors);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((fnName, _), r) -> {
                if (strMapContains(prog.coreFns, fnName)) {
                    bufPushStr(out, "  " + jsFnIdent(fnName) + "();\n")
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def collectExportPairs(prog: CoreProgram, cliExports: List String): List (String, String) = {
    let seen: StrMap Bool = strMapNew();
    let accRev: Cell (List (String, String)) = cellNew(Nil);
    // 1. `pub extern ["sym"] def ...` pairs from CoreProgram
    let ce = cellNew(prog.coreCExports);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons((fnName, expName), r) -> {
                if (strMapContains(prog.coreFns, fnName) && !strMapContains(seen, expName)) {
                    strMapInsert(seen, expName, true);
                    cellSet(accRev, Cons((fnName, expName), cellGet(accRev)))
                } else ();
                cellSet(ce, r)
            },
            Nil -> (),
        }
    };
    // 2. CLI `--export` / `[target.js] exports`
    let cx = cellNew(cliExports);
    while (match cellGet(cx) { Nil -> false, _ -> true }) {
        match cellGet(cx) {
            Cons(nm, r) -> {
                if (strMapContains(prog.coreFns, nm) && !strMapContains(seen, nm)) {
                    strMapInsert(seen, nm, true);
                    cellSet(accRev, Cons((nm, nm), cellGet(accRev)))
                } else ();
                cellSet(cx, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(accRev))
}

def isJsScalarNoMarshal(ty: Type): Bool = match ty {
    TyVoid -> true,
    TyCon(n) -> n == "Int" || n == "Int64" || n == "Float" || n == "Float32" || n == "Bool" || n == "Char" || n == "Void" || n == "Ptr" || n == "ScopedPtr" || n == "ForeignPtr" || n == "AtomicInt",
    _ -> false,
}

def wrapArgFromJs(ty: Type, expr: String, depth: Int): String = match ty {
    TyCon("String") -> "_gs_fromJsStr(" + expr + ")",
    TyArr(_, ps, r) -> {
        let pNamesRev = cellNew(Nil);
        let pCallsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(pt, rp) -> {
                    let pn = "$c" + intToStr(depth) + "_" + intToStr(cellGet(idx));
                    cellSet(pNamesRev, Cons(pn, cellGet(pNamesRev)));
                    cellSet(pCallsRev, Cons(wrapRetToJs(pt, pn, depth + 1), cellGet(pCallsRev)));
                    cellSet(idx, cellGet(idx) + 1);
                    cellSet(cur, rp)
                },
                Nil -> (),
            }
        };
        let fnVar = "$fn" + intToStr(depth);
        let callJs = "(" + fnVar + ")(" + strJoin(listRev(cellGet(pCallsRev)), ", ") + ")";
        "(((" + fnVar + ") => ((" + strJoin(listRev(cellGet(pNamesRev)), ", ") + ") => " + wrapArgFromJs(r, callJs, depth + 1) + "))(" + expr + "))"
    },
    TyComp(_, elemTy) -> {
        let base = tyConName(ty);
        if (base == "MutArray") {
            if (isJsScalarNoMarshal(elemTy)) expr
            else {
                let x = "$e" + intToStr(depth);
                "_gs_mutArrProxy(" + expr + ", (" + x + ") => " + wrapArgFromJs(elemTy, x, depth + 1) + ", (" + x + ") => " + wrapRetToJs(elemTy, x, depth + 1) + ")"
            }
        } else if (base == "Cell") {
            if (isJsScalarNoMarshal(elemTy)) expr
            else {
                let x = "$e" + intToStr(depth);
                "_gs_cellProxy(" + expr + ", (" + x + ") => " + wrapArgFromJs(elemTy, x, depth + 1) + ", (" + x + ") => " + wrapRetToJs(elemTy, x, depth + 1) + ")"
            }
        } else if (base == "ImmArray") {
            if (isJsScalarNoMarshal(elemTy)) expr
            else {
                let x = "$e" + intToStr(depth);
                "(" + expr + ").map((" + x + ") => " + wrapArgFromJs(elemTy, x, depth + 1) + ")"
            }
        } else "_gs_fromJs(" + expr + ")"
    },
    _ -> if (isJsScalarNoMarshal(ty)) expr else "_gs_fromJs(" + expr + ")",
}

def wrapRetToJs(ty: Type, expr: String, depth: Int): String = match ty {
    TyCon("String") -> "_gs_toJsStr(" + expr + ")",
    TyArr(_, ps, r) -> {
        let pNamesRev = cellNew(Nil);
        let pCallsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(pt, rp) -> {
                    let pn = "$r" + intToStr(depth) + "_" + intToStr(cellGet(idx));
                    cellSet(pNamesRev, Cons(pn, cellGet(pNamesRev)));
                    cellSet(pCallsRev, Cons(wrapArgFromJs(pt, pn, depth + 1), cellGet(pCallsRev)));
                    cellSet(idx, cellGet(idx) + 1);
                    cellSet(cur, rp)
                },
                Nil -> (),
            }
        };
        let fnVar = "$rfn" + intToStr(depth);
        let callGs = "(" + fnVar + ")(" + strJoin(listRev(cellGet(pCallsRev)), ", ") + ")";
        "(((" + fnVar + ") => ((" + strJoin(listRev(cellGet(pNamesRev)), ", ") + ") => " + wrapRetToJs(r, callGs, depth + 1) + "))(" + expr + "))"
    },
    TyComp(_, elemTy) -> {
        let base = tyConName(ty);
        if (base == "MutArray") {
            if (isJsScalarNoMarshal(elemTy)) expr
            else {
                let x = "$e" + intToStr(depth);
                "_gs_mutArrProxy(" + expr + ", (" + x + ") => " + wrapRetToJs(elemTy, x, depth + 1) + ", (" + x + ") => " + wrapArgFromJs(elemTy, x, depth + 1) + ")"
            }
        } else if (base == "Cell") {
            if (isJsScalarNoMarshal(elemTy)) expr
            else {
                let x = "$e" + intToStr(depth);
                "_gs_cellProxy(" + expr + ", (" + x + ") => " + wrapRetToJs(elemTy, x, depth + 1) + ", (" + x + ") => " + wrapArgFromJs(elemTy, x, depth + 1) + ")"
            }
        } else if (base == "ImmArray") {
            if (isJsScalarNoMarshal(elemTy)) expr
            else {
                let x = "$e" + intToStr(depth);
                "(" + expr + ").map((" + x + ") => " + wrapRetToJs(elemTy, x, depth + 1) + ")"
            }
        } else "_gs_toJs(" + expr + ")"
    },
    _ -> if (isJsScalarNoMarshal(ty)) expr else "_gs_toJs(" + expr + ")",
}

def emitJsExportWrapper(prog: CoreProgram, out: StringBuf, fnName: String, expName: String): Void =
    match strMapGet(prog.coreFns, fnName) {
        None -> bufPushStr(out, "export const " + expName + " = " + jsFnIdent(fnName) + ";\n"),
        Some(fd) -> {
            let (paramTys, retTy) = match schemeBody(fd.fnScm) {
                TyArr(_, ps, rt) -> (ps, rt),
                other -> (Nil, other),
            };
            let pNamesRev = cellNew(Nil);
            let pCallsRev = cellNew(Nil);
            let idx = cellNew(0);
            let cp = cellNew(fd.fnParams);
            let cpt = cellNew(paramTys);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(pvd, rp) -> {
                        let pty = match cellGet(cpt) {
                            Cons(t, rt) -> { cellSet(cpt, rt); t },
                            Nil -> schemeBody(pvd.vscm),
                        };
                        let pn = "a" + intToStr(cellGet(idx));
                        cellSet(pNamesRev, Cons(pn, cellGet(pNamesRev)));
                        cellSet(pCallsRev, Cons(wrapArgFromJs(pty, pn, 0), cellGet(pCallsRev)));
                        cellSet(idx, cellGet(idx) + 1);
                        cellSet(cp, rp)
                    },
                    Nil -> (),
                }
            };
            let callExpr = jsFnIdent(fnName) + "(" + strJoin(listRev(cellGet(pCallsRev)), ", ") + ")";
            let retExpr = wrapRetToJs(retTy, "$res", 0);
            bufPushStr(out, "export function " + expName + "(" + strJoin(listRev(cellGet(pNamesRev)), ", ") + ") { const $res = " + callExpr + "; return " + retExpr + "; }\n")
        },
    }

pub def emitProgramJs(prog: CoreProgram, exports: List String, noMain: Bool): String = {
    let out = bufNew();
    emitJsRuntimePrelude(out);

    // 1. Global value declarations
    let cg0 = cellNew(prog.coreGlobals);
    while (match cellGet(cg0) { Nil -> false, _ -> true }) {
        match cellGet(cg0) {
            Cons(gv, r) -> {
                bufPushStr(out, "let " + jsGlobalIdent(gv.gvName) + ";\n");
                cellSet(cg0, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(out, 10);

    // 2. Function definitions
    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnm, r) -> {
                match strMapGet(prog.coreFns, fnm) {
                    Some(fd) -> emitJsFunction(prog, out, fd),
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    // 3. Global initialization function
    bufPushStr(out, "let _gs_inited = false;\n");
    bufPushStr(out, "export function __geisha_init() {\n");
    bufPushStr(out, "  if (_gs_inited) return;\n");
    bufPushStr(out, "  _gs_inited = true;\n");
    let initCtx = MkJsEmitCtx {
        jcProg: prog,
        jcBuf: out,
        jcTmpCnt: cellNew(0),
        jcUsedIdents: strMapNew(),
        jcIndent: cellNew(1),
        jcCurFnName: "__geisha_init",
        jcTcoActive: false,
        jcTcoParamJs: Nil,
    };
    let cg1 = cellNew(prog.coreGlobals);
    while (match cellGet(cg1) { Nil -> false, _ -> true }) {
        match cellGet(cg1) {
            Cons(gv, r) -> {
                bufPushStr(out, "  {\n");
                emitJsStmt(initCtx, gv.gvInit, Nil, TgtAssign(jsGlobalIdent(gv.gvName)));
                bufPushStr(out, "  }\n");
                cellSet(cg1, r)
            },
            Nil -> (),
        }
    };
    emitGlobalCtorsJs(prog, out);
    bufPushStr(out, "}\n");
    bufPushStr(out, "__geisha_init();\n\n");

    // 4. Named ES Module exports (with UTF-8 string <-> Uint8Array boundary marshalling)
    let expPairs = collectExportPairs(prog, exports);
    let ep = cellNew(expPairs);
    while (match cellGet(ep) { Nil -> false, _ -> true }) {
        match cellGet(ep) {
            Cons((fnName, expName), r) -> {
                emitJsExportWrapper(prog, out, fnName, expName);
                cellSet(ep, r)
            },
            Nil -> (),
        }
    };

    // 5. Optional `main` export and auto-invocation
    let hasMain = strMapContains(prog.coreFns, "main");
    if (hasMain) {
        if (!listContainsStr(exports, "main")) {
            bufPushStr(out, "export const main = " + jsFnIdent("main") + ";\n")
        } else ();
        if (!noMain) {
            bufPushStr(out, jsFnIdent("main") + "();\n")
        } else ()
    } else ();

    bufToString(out)
}

// ============================================================================
// TypeScript `.d.ts` Declaration Emitter
// ============================================================================

def tsTypeIdent(raw: String): String = jsSanitizeIdent(raw, "")

def collectAdtsInType(adtReg: StrMap AdtInfo, ty: Type, seen: StrMap Bool, order: Vec String): Void = match ty {
    TyVoid -> (),
    TyVar(_) -> (),
    TyCon(n) ->
        if (strMapContains(adtReg, n) && !strMapContains(seen, n)) {
            strMapInsert(seen, n, true);
            vecPush(order, n);
            match strMapGet(adtReg, n) {
                Some(ainfo) -> collectAdtsInVariants(adtReg, ainfo.variants, seen, order),
                None -> (),
            }
        } else (),
    TyComp(b, a) -> {
        collectAdtsInType(adtReg, b, seen, order);
        collectAdtsInType(adtReg, a, seen, order)
    },
    TyTuple(es) -> collectAdtsInTypeList(adtReg, es, seen, order),
    TyArr(_, ps, r) -> {
        collectAdtsInTypeList(adtReg, ps, seen, order);
        collectAdtsInType(adtReg, r, seen, order)
    },
}

def collectAdtsInTypeList(adtReg: StrMap AdtInfo, ts: List Type, seen: StrMap Bool, order: Vec String): Void = match ts {
    Nil -> (),
    Cons(h, t) -> {
        collectAdtsInType(adtReg, h, seen, order);
        collectAdtsInTypeList(adtReg, t, seen, order)
    },
}

def collectAdtsInVariants(adtReg: StrMap AdtInfo, vs: List VariantInfo, seen: StrMap Bool, order: Vec String): Void = match vs {
    Nil -> (),
    Cons(vi, r) -> {
        collectAdtsInTypeList(adtReg, vi.fieldTypes, seen, order);
        collectAdtsInVariants(adtReg, r, seen, order)
    },
}

def typeToTs(adtReg: StrMap AdtInfo, ty: Type): String = match ty {
    TyVoid -> "void",
    TyVar(v) -> tsTypeIdent(v),
    TyCon(n) ->
        if (n == "Int" || n == "Float" || n == "Float32" || n == "Char") "number"
        else if (n == "Int64") "bigint"
        else if (n == "Bool") "boolean"
        else if (n == "String") "string"
        else if (n == "Void") "void"
        else if (n == "Ptr" || n == "ScopedPtr" || n == "ForeignPtr") "GeishaPtr | null"
        else if (n == "Arena") "Record<string, unknown>"
        else if (n == "AtomicInt") "{ v: number }"
        else if (strMapContains(adtReg, n)) tsTypeIdent(n)
        else "unknown",
    TyComp(_, _) -> {
        let base = tyConName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Cell") {
            let inner = match targs { Cons(t, _) -> typeToTs(adtReg, t), Nil -> "unknown" };
            "{ v: " + inner + " }"
        } else if (base == "MutArray") {
            let inner = match targs { Cons(t, _) -> typeToTs(adtReg, t), Nil -> "unknown" };
            "Array<" + inner + ">"
        } else if (base == "ImmArray") {
            let inner = match targs { Cons(t, _) -> typeToTs(adtReg, t), Nil -> "unknown" };
            "readonly (" + inner + ")[]"
        } else if (base == "Simd") {
            "DataView"
        } else if (strMapContains(adtReg, base)) {
            let argsTs = mapTypesToTs(adtReg, targs);
            tsTypeIdent(base) + "<" + strJoin(argsTs, ", ") + ">"
        } else "unknown"
    },
    TyTuple(es) -> "[" + strJoin(mapTypesToTs(adtReg, es), ", ") + "]",
    TyArr(_, ps, r) -> {
        let pPartsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(pt, rp) -> {
                    cellSet(pPartsRev, Cons("arg" + intToStr(cellGet(idx)) + ": " + typeToTs(adtReg, pt), cellGet(pPartsRev)));
                    cellSet(idx, cellGet(idx) + 1);
                    cellSet(cur, rp)
                },
                Nil -> (),
            }
        };
        "(" + strJoin(listRev(cellGet(pPartsRev)), ", ") + ") => " + typeToTs(adtReg, r)
    },
}

def mapTypesToTs(adtReg: StrMap AdtInfo, ts: List Type): List String = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(typeToTs(adtReg, h), mapTypesToTs(adtReg, t)),
}

def emitAdtDts(adtReg: StrMap AdtInfo, out: StringBuf, ainfo: AdtInfo): Void = {
    let tparamsStr = match ainfo.typeParams {
        Nil -> "",
        ps -> {
            let mappedRev = cellNew(Nil);
            let cur = cellNew(ps);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(p, r) -> { cellSet(mappedRev, Cons(tsTypeIdent(p), cellGet(mappedRev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            "<" + strJoin(listRev(cellGet(mappedRev)), ", ") + ">"
        },
    };
    let variantsRev = cellNew(Nil);
    let cv = cellNew(ainfo.variants);
    while (match cellGet(cv) { Nil -> false, _ -> true }) {
        match cellGet(cv) {
            Cons(vi, rv) -> {
                let fieldsRev = cellNew(["readonly $: " + intToStr(vi.tag)]);
                let idx = cellNew(0);
                let cf = cellNew(vi.fieldTypes);
                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                    match cellGet(cf) {
                        Cons(ft, rf) -> {
                            let prop = variantFieldProp(Some(vi), cellGet(idx));
                            cellSet(fieldsRev, Cons("readonly " + prop + ": " + typeToTs(adtReg, ft), cellGet(fieldsRev)));
                            cellSet(idx, cellGet(idx) + 1);
                            cellSet(cf, rf)
                        },
                        Nil -> (),
                    }
                };
                cellSet(variantsRev, Cons("{ " + strJoin(listRev(cellGet(fieldsRev)), "; ") + " }", cellGet(variantsRev)));
                cellSet(cv, rv)
            },
            Nil -> (),
        }
    };
    bufPushStr(out, "export type " + tsTypeIdent(ainfo.adtName) + tparamsStr + " =\n  | " + strJoin(listRev(cellGet(variantsRev)), "\n  | ") + ";\n\n")
}

pub def emitProgramDts(prog: CoreProgram, exports: List String, noMain: Bool): String = {
    let out = bufNew();
    bufPushStr(out, "// Generated by Geisha (`--target js`)\n\n");
    bufPushStr(out, "export interface GeishaPtr {\n  readonly buf: Uint8Array;\n  readonly off: number;\n}\n\n");
    bufPushStr(out, "export declare function __geisha_init(): void;\n\n");

    let expPairs = collectExportPairs(prog, exports);
    let seenAdts: StrMap Bool = strMapNew();
    let adtOrder: Vec String = vecNew();

    // Collect referenced ADTs from exported signatures
    let ce0 = cellNew(expPairs);
    while (match cellGet(ce0) { Nil -> false, _ -> true }) {
        match cellGet(ce0) {
            Cons((fnName, _), r) -> {
                match strMapGet(prog.coreFns, fnName) {
                    Some(fd) -> collectAdtsInType(prog.coreAdtReg, schemeBody(fd.fnScm), seenAdts, adtOrder),
                    None -> (),
                };
                cellSet(ce0, r)
            },
            Nil -> (),
        }
    };

    let ai = cellNew(0);
    while (cellGet(ai) < vecLen(adtOrder)) {
        let anm = vecGetOr(adtOrder, cellGet(ai), "");
        match strMapGet(prog.coreAdtReg, anm) {
            Some(ainfo) -> emitAdtDts(prog.coreAdtReg, out, ainfo),
            None -> (),
        };
        cellSet(ai, cellGet(ai) + 1)
    };

    // Exported function declarations
    let ce1 = cellNew(expPairs);
    while (match cellGet(ce1) { Nil -> false, _ -> true }) {
        match cellGet(ce1) {
            Cons((fnName, expName), r) -> {
                match strMapGet(prog.coreFns, fnName) {
                    Some(fd) -> {
                        let fnTy = schemeBody(fd.fnScm);
                        let (paramTys, retTy) = match fnTy {
                            TyArr(_, ps, rt) -> (ps, rt),
                            other -> (Nil, other),
                        };
                        let paramsRev = cellNew(Nil);
                        let seenParams: StrMap Bool = strMapNew();
                        let cp = cellNew(fd.fnParams);
                        let cpt = cellNew(paramTys);
                        let idx = cellNew(0);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(pvd, rp) -> {
                                    let pty = match cellGet(cpt) {
                                        Cons(t, rt) -> { cellSet(cpt, rt); t },
                                        Nil -> schemeBody(pvd.vscm),
                                    };
                                    let basePnm = jsSanitizeIdent(pvd.vname, "");
                                    let pnm =
                                        if (!strMapContains(seenParams, basePnm)) basePnm
                                        else basePnm + "_" + intToStr(cellGet(idx));
                                    strMapInsert(seenParams, pnm, true);
                                    cellSet(paramsRev, Cons(pnm + ": " + typeToTs(prog.coreAdtReg, pty), cellGet(paramsRev)));
                                    cellSet(idx, cellGet(idx) + 1);
                                    cellSet(cp, rp)
                                },
                                Nil -> (),
                            }
                        };
                        bufPushStr(
                            out,
                            "export declare function " + expName + "(" + strJoin(listRev(cellGet(paramsRev)), ", ") + "): "
                            + typeToTs(prog.coreAdtReg, retTy) + ";\n"
                        )
                    },
                    None -> (),
                };
                cellSet(ce1, r)
            },
            Nil -> (),
        }
    };

    let hasMain = strMapContains(prog.coreFns, "main");
    if (hasMain && !listContainsStr(exports, "main")) {
        bufPushStr(out, "export declare function main(): void;\n")
    } else ();

    let _ = noMain;
    bufToString(out)
}
