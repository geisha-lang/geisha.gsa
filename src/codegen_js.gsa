// Geisha Core IR -> ES Module JavaScript & TypeScript `.d.ts` Backend (`codegen_js`)
//
// Directly lowers monomorphized, K-converted `CoreProgram` to readable, zero-dependency
// ES Module JS (`.mjs`) with:
//   - Exact 32-bit signed `Int` wrapping (`| 0`, `Math.imul`, div/rem zero & INT_MIN guards)
//   - Exact 64-bit signed `Int64` via `BigInt` (`BigInt.asIntN(64, ...)`)
//   - Bit-exact IEEE-754 `Float` / `Float32` literals and bitcast intrinsics
//   - Exact UTF-8 byte semantics for `String` (`strLen`/`strByteAt`/`strSlice`/`strFromBytes`)
//     while preserving native JS `string` values at API boundaries
//   - `Uint8Array`-backed `Ptr`/`ScopedPtr`/`ForeignPtr`/`Arena` so `std.buf`/`std.str`/`std.json`
//     work out of the box without stdlib forks
//   - Direct self-tail-call optimization (`while (true)` + `continue`) for stack safety in V8/JSC/SM
//   - Automatic TypeScript `.d.ts` declaration generation for exported functions and ADTs

use std.option.{Option, Some, None}
use std.list.{listRev, listLen, listAppend}
use std.vec.{Vec, vecNew, vecPush, vecLen, vecGetOr}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.buf.{StringBuf, bufNew, bufPushStr, bufPushByte, bufPushInt, bufToString}
use std.str.{intToStr, floatToHex16, strJoin, strStartsWith}
use ast.{
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmMono, schemeBody,
    Lit, LitInt, LitFloat, LitChar, LitStr, LitBool, LitUnit,
    BinOp, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpAnd, OpOr,
    OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, OpUshr,
    OpEq, OpNe, OpLt, OpLe, OpGt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct,
    Def, ItForm, ExAbs, isPublicVis, emptySpan
}
use infer.{
    VariantInfo, AdtInfo, findVariantByName, applyExplicitSubst, buildPairMap
}
use core.{
    ClosureSpec, TaggedTerm, MkTerm, CoreArm, Term,
    TmLit, TmVar, TmGlobalVar, TmTuple, TmBlock, TmMakeCls, TmApplyCls, TmApplyDir,
    TmBin, TmUn, TmLet, TmIf, TmWhile, TmMatch, TmMakeData, TmGetTag,
    FunDef, GlobalValDef, ExternDef, CoreProgram,
    extractTypeArgs
}

// ============================================================================
// JS Identifier Escaping & String Literal Escaping
// ============================================================================

def isJsReserved(s: String): Bool =
    s == "break" || s == "case" || s == "catch" || s == "class" || s == "const"
    || s == "continue" || s == "debugger" || s == "default" || s == "delete" || s == "do"
    || s == "else" || s == "enum" || s == "export" || s == "extends" || s == "false"
    || s == "finally" || s == "for" || s == "function" || s == "if" || s == "import"
    || s == "in" || s == "instanceof" || s == "let" || s == "new" || s == "null"
    || s == "return" || s == "super" || s == "switch" || s == "this" || s == "throw"
    || s == "true" || s == "try" || s == "typeof" || s == "var" || s == "void"
    || s == "while" || s == "with" || s == "yield" || s == "await" || s == "async"
    || s == "arguments" || s == "eval" || s == "implements" || s == "interface"
    || s == "package" || s == "private" || s == "protected" || s == "public" || s == "static"
    || s == "undefined" || s == "NaN" || s == "Infinity"

def isAsciiIdentChar(b: Int, isFirst: Bool): Bool =
    (b >= 65 && b <= 90)
    || (b >= 97 && b <= 122)
    || b == 95
    || (!isFirst && b >= 48 && b <= 57)

def hexDigitLower(nib: Int): Int =
    if (nib < 10) 48 + nib else 87 + nib

def pushHex2(b: StringBuf, v: Int): Void = {
    let u = v & 255;
    bufPushByte(b, hexDigitLower((u >>> 4) & 15));
    bufPushByte(b, hexDigitLower(u & 15))
}

def jsSanitizeIdent(raw: String, prefix: String): String = {
    let b = bufNew();
    bufPushStr(b, prefix);
    let n = strLen(raw);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(raw, idx);
        if (isAsciiIdentChar(c, idx == 0 && strLen(prefix) == 0)) {
            bufPushByte(b, c)
        } else if (c == 46) {
            bufPushStr(b, "$")
        } else if (c == 36) {
            bufPushStr(b, "_$")
        } else {
            bufPushStr(b, "_x");
            pushHex2(b, c);
            bufPushByte(b, 95)
        };
        cellSet(i, idx + 1)
    };
    let s = bufToString(b);
    if (strLen(s) == 0) "_gs_empty"
    else if (isJsReserved(s)) "_gs_" + s
    else s
}

def jsFnIdent(name: String): String = jsSanitizeIdent(name, "$f_")
def jsGlobalIdent(name: String): String = jsSanitizeIdent(name, "$g_")
def jsLocalIdent(name: String): String = jsSanitizeIdent(name, "$v_")

def jsStringLit(s: String): String = {
    let b = bufNew();
    bufPushByte(b, 34);
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let c = strByteAt(s, cellGet(i));
        if (c == 34) bufPushStr(b, "\\\"")
        else if (c == 92) bufPushStr(b, "\\\\")
        else if (c == 10) bufPushStr(b, "\\n")
        else if (c == 13) bufPushStr(b, "\\r")
        else if (c == 9) bufPushStr(b, "\\t")
        else if (c == 0) bufPushStr(b, "\\0")
        else if (c < 32 || c == 127) {
            bufPushStr(b, "\\x");
            pushHex2(b, c)
        } else {
            bufPushByte(b, c)
        };
        cellSet(i, cellGet(i) + 1)
    };
    bufPushByte(b, 34);
    bufToString(b)
}

def jsFloatLit(f: Float): String = {
    let bits = floatToBits64(f);
    if (bits == intToI64(0)) "0.0"
    else if (f >= -1000000.0 && f <= 1000000.0) {
        let whole = floatToInt(f);
        let back = intToFloat(whole);
        if (floatToBits64(back) == bits) intToStr(whole) + ".0"
        else "_gs_bits64ToFloat(" + floatToHex16(f) + "n)"
    } else {
        "_gs_bits64ToFloat(" + floatToHex16(f) + "n)"
    }
}

// ============================================================================
// Type Helpers
// ============================================================================

def isVoidTy(ty: Type): Bool = match ty {
    TyVoid -> true,
    TyCon(n) -> n == "Void",
    _ -> false,
}

def tyConName(ty: Type): String = match ty {
    TyCon(n) -> n,
    TyComp(b, _) -> tyConName(b),
    _ -> "",
}

def isInt64Ty(ty: Type): Bool = match ty {
    TyCon("Int64") -> true,
    _ -> false,
}

def isFloat32Ty(ty: Type): Bool = match ty {
    TyCon("Float32") -> true,
    _ -> false,
}

def jsStripModPrefix(s: String): String = {
    let n = strLen(s);
    let lastDot = cellNew(-1);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        if (strByteAt(s, cellGet(i)) == 46) cellSet(lastDot, cellGet(i)) else ();
        cellSet(i, cellGet(i) + 1)
    };
    let d = cellGet(lastDot);
    if (d >= 0) strSlice(s, d + 1, n) else s
}

// Returns `Some((lanes, elemKind, totalBytes))` where `elemKind` is:
// 0=I8, 1=U8, 2=I16, 3=U16, 4=I32/Int, 5=U32, 6=I64/Int64, 7=U64, 8=F32/Float32, 9=F64/Float
def jsParseSimd(ty: Type): Option (Int, Int, Int) = match ty {
    TyComp(TyComp(TyCon("Simd"), TyCon(rawLane)), TyCon(rawElem)) -> {
        let ln = jsStripModPrefix(rawLane);
        let en = jsStripModPrefix(rawElem);
        let lanes =
            if (ln == "L2") 2
            else if (ln == "L4") 4
            else if (ln == "L8") 8
            else if (ln == "L16") 16
            else if (ln == "L32") 32
            else 0;
        let (ek, eb) =
            if (en == "I8") (0, 1)
            else if (en == "U8") (1, 1)
            else if (en == "I16") (2, 2)
            else if (en == "U16") (3, 2)
            else if (en == "Int" || en == "I32") (4, 4)
            else if (en == "U32") (5, 4)
            else if (en == "Int64" || en == "I64") (6, 8)
            else if (en == "U64") (7, 8)
            else if (en == "Float32" || en == "F32") (8, 4)
            else if (en == "Float" || en == "F64") (9, 8)
            else (-1, 0);
        let tb = lanes * eb;
        if (lanes > 0 && ek >= 0 && (tb == 16 || tb == 32)) Some((lanes, ek, tb))
        else None
    },
    _ -> None,
}

def jsZeroForType(ty: Type): String = match ty {
    TyVoid -> "undefined",
    TyCon(n) ->
        if (n == "Int" || n == "Char") "0"
        else if (n == "Int64") "0n"
        else if (n == "Float" || n == "Float32") "0.0"
        else if (n == "Bool") "false"
        else if (n == "String") "_gs_emptyStr"
        else if (n == "Ptr" || n == "ScopedPtr" || n == "ForeignPtr" || n == "Arena") "null"
        else "undefined",
    TyComp(_, _) -> match jsParseSimd(ty) {
        Some((_, _, tb)) -> "new DataView(new ArrayBuffer(" + intToStr(tb) + "))",
        None -> "undefined",
    },
    _ -> "undefined",
}

def findVariantByTag(vs: List VariantInfo, tag: Int): Option VariantInfo = match vs {
    Nil -> None,
    Cons(v, r) -> if (v.tag == tag) Some(v) else findVariantByTag(r, tag),
}

def nthStrOpt(xs: List String, idx: Int): Option String = match xs {
    Nil -> None,
    Cons(h, t) -> if (idx == 0) Some(h) else nthStrOpt(t, idx - 1),
}

def nthArgTerm(args: List TaggedTerm, idx: Int): TaggedTerm = match args {
    Cons(h, t) -> if (idx == 0) h else nthArgTerm(t, idx - 1),
    Nil -> match args { Cons(h, _) -> h, Nil -> panicPlaceholderTerm() },
}

def panicPlaceholderTerm(): TaggedTerm =
    MkTerm { tspan: emptySpan(), tscm: ScmMono(TyVoid), tnode: TmLit(LitUnit) }

def variantFieldProp(vinfoOpt: Option VariantInfo, idx: Int): String = match vinfoOpt {
    Some(vi) -> match vi.fieldNames {
        Some(fnames) -> match nthStrOpt(fnames, idx) {
            Some(fnm) -> fnm,
            None -> "_" + intToStr(idx),
        },
        None -> "_" + intToStr(idx),
    },
    None -> "_" + intToStr(idx),
}

def extractAdtNameAndArgs(adtReg: StrMap AdtInfo, ty: Type, ctorHint: String): (String, List Type) = match ty {
    TyCon(n) ->
        if (strMapContains(adtReg, n)) (n, Nil)
        else (findAdtByCtorName(adtReg, ctorHint), Nil),
    TyComp(_, _) -> {
        let base = tyConName(ty);
        if (strMapContains(adtReg, base)) (base, extractTypeArgs(ty))
        else (findAdtByCtorName(adtReg, ctorHint), extractTypeArgs(ty))
    },
    _ -> (findAdtByCtorName(adtReg, ctorHint), Nil),
}

def findAdtByCtorName(adtReg: StrMap AdtInfo, ctorName: String): String =
    // Fast fallback when scrutinee type is already known; unused if tyConName hit
    if (ctorName == "Cons" || ctorName == "Nil") "List"
    else if (ctorName == "Some" || ctorName == "None") "std.option.Option"
    else if (ctorName == "Ok" || ctorName == "Err") "std.result.Result"
    else ""

def substTypeList(ts: List Type, sub: StrMap Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(applyExplicitSubst(h, sub), substTypeList(t, sub)),
}

def listContainsStr(xs: List String, target: String): Bool = match xs {
    Nil -> false,
    Cons(h, t) -> if (h == target) true else listContainsStr(t, target),
}

// ============================================================================
// Self-Tail-Call Detection
// ============================================================================

def hasSelfTailCall(fnName: String, tm: TaggedTerm): Bool = match tm.tnode {
    TmApplyDir(vd, _) -> vd.vname == fnName,
    TmLet(_, _, body) -> hasSelfTailCall(fnName, body),
    TmMakeCls(_, _, body) -> hasSelfTailCall(fnName, body),
    TmIf(_, t, e) -> hasSelfTailCall(fnName, t) || hasSelfTailCall(fnName, e),
    TmBlock(es) -> hasSelfTailCallLast(fnName, es),
    TmMatch(_, arms) -> hasSelfTailCallArms(fnName, arms),
    _ -> false,
}

def hasSelfTailCallLast(fnName: String, es: List TaggedTerm): Bool = match es {
    Nil -> false,
    Cons(h, Nil) -> hasSelfTailCall(fnName, h),
    Cons(_, t) -> hasSelfTailCallLast(fnName, t),
}

def hasSelfTailCallArms(fnName: String, arms: List CoreArm): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> hasSelfTailCall(fnName, a.caBody) || hasSelfTailCallArms(fnName, r),
}

// ============================================================================
// JS Function & Module Emission Context
// ============================================================================

data JsEmitCtx {
    MkJsEmitCtx {
        jcProg: CoreProgram,
        jcBuf: StringBuf,
        jcTmpCnt: Cell Int,
        jcUsedIdents: StrMap Bool,
        jcIndent: Cell Int,
        jcCurFnName: String,
        jcTcoActive: Bool,
        jcTcoParamJs: List String,
    },
}

def jcFreshTmp(ctx: JsEmitCtx): String = {
    let n = cellGet(ctx.jcTmpCnt) + 1;
    cellSet(ctx.jcTmpCnt, n);
    "$t" + intToStr(n)
}

def jcPushIndent(ctx: JsEmitCtx): Void = {
    let n = cellGet(ctx.jcIndent);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        bufPushStr(ctx.jcBuf, "  ");
        cellSet(i, cellGet(i) + 1)
    }
}

def jcEmitLine(ctx: JsEmitCtx, line: String): Void = {
    jcPushIndent(ctx);
    bufPushStr(ctx.jcBuf, line);
    bufPushByte(ctx.jcBuf, 10)
}

def jcIncIndent(ctx: JsEmitCtx): Void = cellSet(ctx.jcIndent, cellGet(ctx.jcIndent) + 1)
def jcDecIndent(ctx: JsEmitCtx): Void = cellSet(ctx.jcIndent, cellGet(ctx.jcIndent) - 1)

def lookupLocalJs(locals: List (String, String), name: String): Option String = match locals {
    Nil -> None,
    Cons((k, v), r) -> if (k == name) Some(v) else lookupLocalJs(r, name),
}

def bindLocalJs(ctx: JsEmitCtx, locals: List (String, String), origName: String): (String, List (String, String)) = {
    let base = jsLocalIdent(origName);
    let jsName =
        if (!strMapContains(ctx.jcUsedIdents, base)) {
            strMapInsert(ctx.jcUsedIdents, base, true);
            base
        } else {
            let cand = cellNew("");
            while (strLen(cellGet(cand)) == 0) {
                let n = cellGet(ctx.jcTmpCnt) + 1;
                cellSet(ctx.jcTmpCnt, n);
                let c = base + "_" + intToStr(n);
                if (!strMapContains(ctx.jcUsedIdents, c)) {
                    strMapInsert(ctx.jcUsedIdents, c, true);
                    cellSet(cand, c)
                } else ()
            };
            cellGet(cand)
        };
    (jsName, Cons((origName, jsName), locals))
}

data StmtTarget {
    TgtReturn,
    TgtAssign(String),
    TgtDiscard,
}

def emitTargetResult(ctx: JsEmitCtx, target: StmtTarget, exprStr: String): Void = match target {
    TgtReturn -> jcEmitLine(ctx, "return " + exprStr + ";"),
    TgtAssign(v) -> jcEmitLine(ctx, v + " = " + exprStr + ";"),
    TgtDiscard ->
        if (exprStr != "undefined") jcEmitLine(ctx, exprStr + ";") else (),
}

// ============================================================================
// Pattern Matching Compilation
// ============================================================================

def emitPatternCondAndBinds(
    ctx: JsEmitCtx,
    scrutExpr: String,
    scrutTy: Type,
    pat: Pattern,
    condsRev: Cell (List String),
    bindsRev: Cell (List (String, String)),
    localsCell: Cell (List (String, String))
): Void = match pat {
    PatWild -> (),
    PatVar(vname, _) -> {
        let (jsNm, nextLocs) = bindLocalJs(ctx, cellGet(localsCell), vname);
        cellSet(localsCell, nextLocs);
        cellSet(bindsRev, Cons((jsNm, scrutExpr), cellGet(bindsRev)))
    },
    PatLit(lit) -> {
        let litJs = emitLitJs(lit, scrutTy);
        match lit {
            LitStr(_) -> cellSet(condsRev, Cons("_gs_strEq(" + scrutExpr + ", " + litJs + ")", cellGet(condsRev))),
            _ -> cellSet(condsRev, Cons("(" + scrutExpr + " === " + litJs + ")", cellGet(condsRev))),
        }
    },
    PatTuple(subPats) -> {
        let elemTys = match scrutTy {
            TyTuple(es) -> es,
            _ -> Nil,
        };
        let idx = cellNew(0);
        let cp = cellNew(subPats);
        let ct = cellNew(elemTys);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(sp, rp) -> {
                    let i = cellGet(idx);
                    let et = match cellGet(ct) {
                        Cons(t, rt) -> { cellSet(ct, rt); t },
                        Nil -> TyVoid,
                    };
                    match sp {
                        PatWild -> (),
                        _ -> emitPatternCondAndBinds(
                            ctx, scrutExpr + "[" + intToStr(i) + "]", et, sp, condsRev, bindsRev, localsCell
                        ),
                    };
                    cellSet(idx, i + 1);
                    cellSet(cp, rp)
                },
                Nil -> (),
            }
        }
    },
    PatCtor(ctorName, subPats) -> {
        let (adtName, typeArgs) = extractAdtNameAndArgs(ctx.jcProg.coreAdtReg, scrutTy, ctorName);
        match strMapGet(ctx.jcProg.coreAdtReg, adtName) {
            None -> (),
            Some(ainfo) -> match findVariantByName(ainfo.variants, ctorName) {
                None -> (),
                Some(vinfo) -> {
                    cellSet(condsRev, Cons("(" + scrutExpr + ".$ === " + intToStr(vinfo.tag) + ")", cellGet(condsRev)));
                    let sub = buildPairMap(ainfo.typeParams, typeArgs);
                    let concreteFieldTys = substTypeList(vinfo.fieldTypes, sub);
                    let idx = cellNew(0);
                    let cp = cellNew(subPats);
                    let cft = cellNew(concreteFieldTys);
                    while (match cellGet(cp) { Nil -> false, _ -> true }) {
                        match cellGet(cp) {
                            Cons(sp, rp) -> {
                                let i = cellGet(idx);
                                let ft = match cellGet(cft) {
                                    Cons(t, rt) -> { cellSet(cft, rt); t },
                                    Nil -> TyVoid,
                                };
                                match sp {
                                    PatWild -> (),
                                    _ -> {
                                        let prop = variantFieldProp(Some(vinfo), i);
                                        emitPatternCondAndBinds(
                                            ctx, scrutExpr + "." + prop, ft, sp, condsRev, bindsRev, localsCell
                                        )
                                    },
                                };
                                cellSet(idx, i + 1);
                                cellSet(cp, rp)
                            },
                            Nil -> (),
                        }
                    }
                },
            },
        }
    },
    PatStruct(_, _) -> (),
}

// ============================================================================
// Literal & Operator Emission
// ============================================================================

def emitLitJs(lit: Lit, ty: Type): String = match lit {
    LitInt(n) -> if (isInt64Ty(ty)) intToStr(n) + "n" else intToStr(n),
    LitFloat(f) ->
        if (isFloat32Ty(ty)) "Math.fround(" + jsFloatLit(f) + ")"
        else jsFloatLit(f),
    LitChar(c) -> intToStr(c),
    LitStr(s) -> "_gs_s(" + jsStringLit(s) + ")",
    LitBool(b) -> if (b) "true" else "false",
    LitUnit -> "undefined",
}

def emitBinOpJs(op: BinOp, lhs: String, rhs: String, opTy: Type): String = {
    let tyName = match opTy {
        TyCon(n) -> n,
        _ -> "Int",
    };
    if (tyName == "String") {
        match op {
            OpAdd -> "_gs_strConcat(" + lhs + ", " + rhs + ")",
            OpEq -> "_gs_strEq(" + lhs + ", " + rhs + ")",
            OpNe -> "(!_gs_strEq(" + lhs + ", " + rhs + "))",
            OpLt -> "(_gs_strCmp(" + lhs + ", " + rhs + ") < 0)",
            OpLe -> "(_gs_strCmp(" + lhs + ", " + rhs + ") <= 0)",
            OpGt -> "(_gs_strCmp(" + lhs + ", " + rhs + ") > 0)",
            OpGe -> "(_gs_strCmp(" + lhs + ", " + rhs + ") >= 0)",
            _ -> "_gs_strEq(" + lhs + ", " + rhs + ")",
        }
    } else if (tyName == "Float") {
        match op {
            OpAdd -> "(" + lhs + " + " + rhs + ")",
            OpSub -> "(" + lhs + " - " + rhs + ")",
            OpMul -> "(" + lhs + " * " + rhs + ")",
            OpDiv -> "(" + lhs + " / " + rhs + ")",
            OpEq -> "(" + lhs + " === " + rhs + ")",
            OpNe -> "(" + lhs + " !== " + rhs + ")",
            OpLt -> "(" + lhs + " < " + rhs + ")",
            OpLe -> "(" + lhs + " <= " + rhs + ")",
            OpGt -> "(" + lhs + " > " + rhs + ")",
            OpGe -> "(" + lhs + " >= " + rhs + ")",
            _ -> "(" + lhs + " + " + rhs + ")",
        }
    } else if (tyName == "Float32") {
        match op {
            OpAdd -> "Math.fround(" + lhs + " + " + rhs + ")",
            OpSub -> "Math.fround(" + lhs + " - " + rhs + ")",
            OpMul -> "Math.fround(" + lhs + " * " + rhs + ")",
            OpDiv -> "Math.fround(" + lhs + " / " + rhs + ")",
            OpEq -> "(" + lhs + " === " + rhs + ")",
            OpNe -> "(" + lhs + " !== " + rhs + ")",
            OpLt -> "(" + lhs + " < " + rhs + ")",
            OpLe -> "(" + lhs + " <= " + rhs + ")",
            OpGt -> "(" + lhs + " > " + rhs + ")",
            OpGe -> "(" + lhs + " >= " + rhs + ")",
            _ -> "Math.fround(" + lhs + " + " + rhs + ")",
        }
    } else if (tyName == "Bool" || tyName == "Char") {
        match op {
            OpEq -> "(" + lhs + " === " + rhs + ")",
            OpNe -> "(" + lhs + " !== " + rhs + ")",
            OpLt -> "(" + lhs + " < " + rhs + ")",
            OpLe -> "(" + lhs + " <= " + rhs + ")",
            OpGt -> "(" + lhs + " > " + rhs + ")",
            OpGe -> "(" + lhs + " >= " + rhs + ")",
            OpAnd -> "(" + lhs + " && " + rhs + ")",
            OpOr -> "(" + lhs + " || " + rhs + ")",
            OpBitAnd -> "(" + lhs + " & " + rhs + ")",
            OpBitOr -> "(" + lhs + " | " + rhs + ")",
            OpBitXor -> "(" + lhs + " ^ " + rhs + ")",
            _ -> "(" + lhs + " === " + rhs + ")",
        }
    } else if (tyName == "Int64") {
        match op {
            OpAdd -> "BigInt.asIntN(64, " + lhs + " + " + rhs + ")",
            OpSub -> "BigInt.asIntN(64, " + lhs + " - " + rhs + ")",
            OpMul -> "BigInt.asIntN(64, " + lhs + " * " + rhs + ")",
            OpDiv -> "_gs_idiv64(" + lhs + ", " + rhs + ")",
            OpRem -> "_gs_irem64(" + lhs + ", " + rhs + ")",
            OpBitAnd -> "BigInt.asIntN(64, " + lhs + " & " + rhs + ")",
            OpBitOr -> "BigInt.asIntN(64, " + lhs + " | " + rhs + ")",
            OpBitXor -> "BigInt.asIntN(64, " + lhs + " ^ " + rhs + ")",
            OpShl -> "BigInt.asIntN(64, " + lhs + " << BigInt(" + rhs + " & 63))",
            OpShr -> "BigInt.asIntN(64, " + lhs + " >> BigInt(" + rhs + " & 63))",
            OpUshr -> "BigInt.asIntN(64, BigInt.asUintN(64, " + lhs + ") >> BigInt(" + rhs + " & 63))",
            OpEq -> "(" + lhs + " === " + rhs + ")",
            OpNe -> "(" + lhs + " !== " + rhs + ")",
            OpLt -> "(" + lhs + " < " + rhs + ")",
            OpLe -> "(" + lhs + " <= " + rhs + ")",
            OpGt -> "(" + lhs + " > " + rhs + ")",
            OpGe -> "(" + lhs + " >= " + rhs + ")",
            _ -> "BigInt.asIntN(64, " + lhs + " + " + rhs + ")",
        }
    } else {
        // `Int` (32-bit signed)
        match op {
            OpAdd -> "((" + lhs + " + " + rhs + ") | 0)",
            OpSub -> "((" + lhs + " - " + rhs + ") | 0)",
            OpMul -> "Math.imul(" + lhs + ", " + rhs + ")",
            OpDiv -> "_gs_idiv32(" + lhs + ", " + rhs + ")",
            OpRem -> "_gs_irem32(" + lhs + ", " + rhs + ")",
            OpBitAnd -> "(" + lhs + " & " + rhs + ")",
            OpBitOr -> "(" + lhs + " | " + rhs + ")",
            OpBitXor -> "(" + lhs + " ^ " + rhs + ")",
            OpShl -> "(" + lhs + " << (" + rhs + " & 31))",
            OpShr -> "(" + lhs + " >> (" + rhs + " & 31))",
            OpUshr -> "((" + lhs + " >>> (" + rhs + " & 31)) | 0)",
            OpEq -> "(" + lhs + " === " + rhs + ")",
            OpNe -> "(" + lhs + " !== " + rhs + ")",
            OpLt -> "(" + lhs + " < " + rhs + ")",
            OpLe -> "(" + lhs + " <= " + rhs + ")",
            OpGt -> "(" + lhs + " > " + rhs + ")",
            OpGe -> "(" + lhs + " >= " + rhs + ")",
            _ -> "((" + lhs + " + " + rhs + ") | 0)",
        }
    }
}

def emitUnOpJs(op: UnOp, operand: String, opTy: Type): String = match op {
    UnNot -> "(!" + operand + ")",
    UnNeg -> match opTy {
        TyCon("Int64") -> "BigInt.asIntN(64, -" + operand + ")",
        TyCon("Float") -> "(-" + operand + ")",
        TyCon("Float32") -> "Math.fround(-" + operand + ")",
        _ -> "((-" + operand + ") | 0)",
    },
    UnBitNot -> match opTy {
        TyCon("Int64") -> "BigInt.asIntN(64, ~" + operand + ")",
        _ -> "(~" + operand + ")",
    },
}

// ============================================================================
// Builtin Intrinsics Lowering
// ============================================================================

def isPureImmutableJsExpr(tm: TaggedTerm): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(_) -> true,
    TmGlobalVar(_) -> true,
    _ -> false,
}

def anyNonPureJsExpr(ts: List TaggedTerm): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> if (!isPureImmutableJsExpr(h)) true else anyNonPureJsExpr(t),
}

def evalArgsJs(ctx: JsEmitCtx, args: List TaggedTerm, locals: List (String, String)): List String = {
    let rev = cellNew(Nil);
    let cur = cellNew(args);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                let exprStr = emitJsExpr(ctx, a, locals);
                let finalExpr =
                    if (!isPureImmutableJsExpr(a) && anyNonPureJsExpr(r)) {
                        let t = jcFreshTmp(ctx);
                        jcEmitLine(ctx, "const " + t + " = " + exprStr + ";");
                        t
                    } else exprStr;
                cellSet(rev, Cons(finalExpr, cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def nthStr(xs: List String, idx: Int): String = match xs {
    Cons(h, t) -> if (idx == 0) h else nthStr(t, idx - 1),
    Nil -> "undefined",
}

def tryEmitBuiltinJs(
    ctx: JsEmitCtx,
    name: String,
    args: List TaggedTerm,
    retTy: Type,
    locals: List (String, String)
): Option String =
    if (name == "cellNew") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("{ v: " + nthStr(vs, 0) + " }")
    } else if (name == "cellGet") {
        let vs = evalArgsJs(ctx, args, locals);
        Some(nthStr(vs, 0) + ".v")
    } else if (name == "cellSet") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, nthStr(vs, 0) + ".v = " + nthStr(vs, 1) + ";");
        Some("undefined")
    } else if (name == "arrayNew") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_arrayNew(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "arrayNewZeroed") {
        let vs = evalArgsJs(ctx, args, locals);
        let elemTy = match retTy {
            TyComp(_, et) -> et,
            _ -> TyVoid,
        };
        Some("_gs_arrayNew(" + nthStr(vs, 0) + ", " + jsZeroForType(elemTy) + ")")
    } else if (name == "arrayLen" || name == "immArrayLen") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + ".length | 0)")
    } else if (name == "arrayFreeze") {
        let vs = evalArgsJs(ctx, args, locals);
        Some(nthStr(vs, 0))
    } else if (name == "arrayGet" || name == "immArrayGet") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_arrayGet(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "arraySet") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_arraySet(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "arrayClearSlot") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_arraySet(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", undefined);");
        Some("undefined")
    } else if (name == "parTabulate") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_parTabulate(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "printLn") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_printLn(" + nthStr(vs, 0) + ");");
        Some("undefined")
    } else if (name == "putChar") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_putStr(String.fromCharCode(" + nthStr(vs, 0) + " & 255));");
        Some("undefined")
    } else if (name == "putNumber") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_putStr(String(" + nthStr(vs, 0) + "));");
        Some("undefined")
    } else if (name == "putFloat" || name == "putF32") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_putStr(String(" + nthStr(vs, 0) + "));");
        Some("undefined")
    } else if (name == "strLen") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + ".length | 0)")
    } else if (name == "strByteAt") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_strByteAt(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "strSlice") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_strSlice(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")")
    } else if (name == "strConcat") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_strConcat(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "strFromBytes") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_strFromBytes(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "bitAnd") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " & " + nthStr(vs, 1) + ")")
    } else if (name == "bitAnd64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, " + nthStr(vs, 0) + " & " + nthStr(vs, 1) + ")")
    } else if (name == "bitOr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " | " + nthStr(vs, 1) + ")")
    } else if (name == "bitOr64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, " + nthStr(vs, 0) + " | " + nthStr(vs, 1) + ")")
    } else if (name == "bitXor") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " ^ " + nthStr(vs, 1) + ")")
    } else if (name == "bitXor64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, " + nthStr(vs, 0) + " ^ " + nthStr(vs, 1) + ")")
    } else if (name == "bitNot") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(~" + nthStr(vs, 0) + ")")
    } else if (name == "bitNot64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, ~" + nthStr(vs, 0) + ")")
    } else if (name == "bitShl") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " << (" + nthStr(vs, 1) + " & 31))")
    } else if (name == "bitShr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " >> (" + nthStr(vs, 1) + " & 31))")
    } else if (name == "bitUshr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("((" + nthStr(vs, 0) + " >>> (" + nthStr(vs, 1) + " & 31)) | 0)")
    } else if (name == "bitShl64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, " + nthStr(vs, 0) + " << BigInt(" + nthStr(vs, 1) + " & 63))")
    } else if (name == "bitShr64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, " + nthStr(vs, 0) + " >> BigInt(" + nthStr(vs, 1) + " & 63))")
    } else if (name == "bitUshr64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt.asIntN(64, BigInt.asUintN(64, " + nthStr(vs, 0) + ") >> BigInt(" + nthStr(vs, 1) + " & 63))")
    } else if (name == "bitPopCount") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_popcnt32(" + nthStr(vs, 0) + ")")
    } else if (name == "bitPopCount64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_popcnt64(" + nthStr(vs, 0) + ")")
    } else if (name == "bitCtz") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ctz32(" + nthStr(vs, 0) + ")")
    } else if (name == "bitCtz64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ctz64(" + nthStr(vs, 0) + ")")
    } else if (name == "bitClz") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("Math.clz32(" + nthStr(vs, 0) + ")")
    } else if (name == "bitClz64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_clz64(" + nthStr(vs, 0) + ")")
    } else if (name == "charToInt") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " & 255)")
    } else if (name == "intToChar") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " & 255)")
    } else if (name == "intToI64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("BigInt(" + nthStr(vs, 0) + " | 0)")
    } else if (name == "i64ToInt") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(Number(BigInt.asIntN(32, " + nthStr(vs, 0) + ")) | 0)")
    } else if (name == "floatToBits64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_floatToBits64(" + nthStr(vs, 0) + ")")
    } else if (name == "bits64ToFloat") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_bits64ToFloat(" + nthStr(vs, 0) + ")")
    } else if (name == "floatToBits32" || name == "f32ToBits32") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_f32ToBits32(" + nthStr(vs, 0) + ")")
    } else if (name == "bits32ToFloat" || name == "bits32ToF32") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_bits32ToF32(" + nthStr(vs, 0) + ")")
    } else if (name == "intToFloat") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("Number(" + nthStr(vs, 0) + ")")
    } else if (name == "floatToInt" || name == "f32ToInt") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(Math.trunc(" + nthStr(vs, 0) + ") | 0)")
    } else if (name == "floatToF32" || name == "intToF32") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("Math.fround(" + nthStr(vs, 0) + ")")
    } else if (name == "f32ToFloat") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("Number(" + nthStr(vs, 0) + ")")
    } else if (name == "mathExp" || name == "mathExpF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.exp(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathExpF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathLog" || name == "mathLogF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.log(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathLogF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathSqrt" || name == "mathSqrtF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.sqrt(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathSqrtF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathSin" || name == "mathSinF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.sin(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathSinF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathCos" || name == "mathCosF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.cos(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathCosF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathTanh" || name == "mathTanhF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.tanh(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathTanhF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathPow" || name == "mathPowF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.pow(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")";
        Some(if (name == "mathPowF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathAbs" || name == "mathAbsF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.abs(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathAbsF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathFloor" || name == "mathFloorF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.floor(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathFloorF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathCeil" || name == "mathCeilF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "Math.ceil(" + nthStr(vs, 0) + ")";
        Some(if (name == "mathCeilF32") "Math.fround(" + e + ")" else e)
    } else if (name == "mathFma" || name == "mathFmaF32") {
        let vs = evalArgsJs(ctx, args, locals);
        let e = "(" + nthStr(vs, 0) + " * " + nthStr(vs, 1) + " + " + nthStr(vs, 2) + ")";
        Some(if (name == "mathFmaF32") "Math.fround(" + e + ")" else e)
    } else if (name == "ptrNull") {
        Some("null")
    } else if (name == "ptrIsNull") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + " === null)")
    } else if (name == "ptrAllocBytes" || name == "ptrAllocBytes64" || name == "foreignPtrAlloc") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrAlloc(Number(" + nthStr(vs, 0) + "))")
    } else if (name == "ptrOffset" || name == "ptrOffset64" || name == "scopedPtrOffset" || name == "scopedPtrOffset64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrOffset(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrByteAt" || name == "scopedPtrByteAt") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrByteAt(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrSetByte" || name == "scopedPtrSetByte") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrSetByte(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "ptrReadI8") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrReadI8(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrReadU16Le") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrReadU16Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrReadU32Le" || name == "scopedPtrReadI32Le") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrReadI32Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrReadI64Le" || name == "ptrReadI64Le64" || name == "scopedPtrReadI64Le") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrReadI64Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrReadF32Le" || name == "ptrReadF32Le64" || name == "scopedPtrReadF32Le" || name == "scopedPtrReadF32Le64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrReadF32Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrReadF64Le" || name == "ptrReadF64Le64" || name == "scopedPtrReadF64Le" || name == "scopedPtrReadF64Le64") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrReadF64Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrWriteU16Le") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrWriteU16Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "ptrWriteU32Le" || name == "scopedPtrWriteI32Le") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrWriteI32Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "ptrWriteI64Le" || name == "ptrWriteI64Le64" || name == "scopedPtrWriteI64Le") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrWriteI64Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "ptrWriteF32Le" || name == "ptrWriteF32Le64" || name == "scopedPtrWriteF32Le" || name == "scopedPtrWriteF32Le64") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrWriteF32Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "ptrWriteF64Le" || name == "ptrWriteF64Le64" || name == "scopedPtrWriteF64Le" || name == "scopedPtrWriteF64Le64") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrWriteF64Le(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
        Some("undefined")
    } else if (name == "ptrCopyBytes" || name == "ptrCopyBytes64" || name == "scopedPtrCopyBytes") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrCopyBytes(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ", Number(" + nthStr(vs, 3) + "), Number(" + nthStr(vs, 4) + "));");
        Some("undefined")
    } else if (name == "ptrCopyFromStr") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_ptrCopyFromStr(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ", Number(" + nthStr(vs, 3) + "));");
        Some("undefined")
    } else if (name == "ptrSliceFromStr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrSliceFromStr(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), Number(" + nthStr(vs, 2) + "))")
    } else if (name == "ptrSliceToString") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrSliceToString(" + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))")
    } else if (name == "ptrToString") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrToString(" + nthStr(vs, 0) + ")")
    } else if (name == "withStrPtr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 1) + ")({ buf: " + nthStr(vs, 0) + ", off: 0 })")
    } else if (strStartsWith(name, "__simd")) {
        let vs = evalArgsJs(ctx, args, locals);
        if (name == "__simdSplat") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdSplat(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdIota") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdIota(" + intToStr(ln) + ", " + intToStr(ek) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdExtract") {
            match jsParseSimd(schemeBody(nthArgTerm(args, 0).tscm)) {
                Some((ln, ek, _)) -> Some("_gs_simdExtract(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")"),
                None -> Some("0"),
            }
        } else if (name == "__simdReplace") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdReplace(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdUnary") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdUnary(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdBin") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdBin(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdShift") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdShift(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdFma") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdFma(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdCmp") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdCmp(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdReduce") {
            match jsParseSimd(schemeBody(nthArgTerm(args, 1).tscm)) {
                Some((ln, ek, _)) -> Some("_gs_simdReduce(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")"),
                None -> Some("0"),
            }
        } else if (name == "__simdPermute") {
            match jsParseSimd(retTy) {
                Some((ln, ek, _)) -> Some("_gs_simdPermute(" + intToStr(ln) + ", " + intToStr(ek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ", " + nthStr(vs, 3) + ")"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdConvert") {
            match (jsParseSimd(schemeBody(nthArgTerm(args, 1).tscm)), jsParseSimd(retTy)) {
                (Some((sln, sek, _)), Some((dln, dek, _))) ->
                    Some("_gs_simdConvert(" + intToStr(sln) + ", " + intToStr(sek) + ", " + intToStr(dln) + ", " + intToStr(dek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")"),
                _ -> Some("undefined"),
            }
        } else if (name == "__simdCombine") {
            match (jsParseSimd(schemeBody(nthArgTerm(args, 1).tscm)), jsParseSimd(retTy)) {
                (Some((sln, sek, _)), Some((dln, dek, _))) ->
                    Some("_gs_simdCombine(" + intToStr(sln) + ", " + intToStr(sek) + ", " + intToStr(dln) + ", " + intToStr(dek) + ", " + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")"),
                _ -> Some("undefined"),
            }
        } else if (name == "__simdLoad" || name == "__simdLoadRaw") {
            match jsParseSimd(retTy) {
                Some((_, _, tb)) -> Some("_gs_simdLoadPtr(" + intToStr(tb) + ", " + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdLoadStr") {
            match jsParseSimd(retTy) {
                Some((_, _, tb)) -> Some("_gs_simdLoadStr(" + intToStr(tb) + ", " + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "))"),
                None -> Some("undefined"),
            }
        } else if (name == "__simdStore" || name == "__simdStoreRaw") {
            match jsParseSimd(schemeBody(nthArgTerm(args, 2).tscm)) {
                Some((_, _, tb)) -> {
                    jcEmitLine(ctx, "_gs_simdStorePtr(" + intToStr(tb) + ", " + nthStr(vs, 0) + ", Number(" + nthStr(vs, 1) + "), " + nthStr(vs, 2) + ");");
                    Some("undefined")
                },
                None -> Some("undefined"),
            }
        } else None
    } else if (name == "withForeignPtr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 1) + ")(" + nthStr(vs, 0) + ")")
    } else if (name == "withArena") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + ")({})")
    } else if (name == "withAlloca") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 1) + ")(_gs_ptrAlloc(Number(" + nthStr(vs, 0) + ")))")
    } else if (name == "arenaAlloc") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_ptrAlloc(Number(" + nthStr(vs, 1) + "))")
    } else if (name == "foreignPtrNew") {
        let vs = evalArgsJs(ctx, args, locals);
        Some(nthStr(vs, 0))
    } else if (name == "cFnPtr") {
        let vs = evalArgsJs(ctx, args, locals);
        Some(nthStr(vs, 0))
    } else if (name == "gcHandleNew") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_handleNew(" + nthStr(vs, 0) + ")")
    } else if (name == "gcHandleGet") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_handleGet(" + nthStr(vs, 0) + ")")
    } else if (name == "gcHandleFree") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, "_gs_handleFree(" + nthStr(vs, 0) + ");");
        Some("undefined")
    } else if (name == "gcTrim" || name == "gcSetThresholds") {
        let _ = evalArgsJs(ctx, args, locals);
        Some("undefined")
    } else if (name == "gcHeapLiveBytes" || name == "gcExternalLiveBytes") {
        Some("0n")
    } else if (name == "__gs_contract_fail") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(() => { throw new Error(\"Contract error: \" + " + nthStr(vs, 0) + "); })()")
    } else if (name == "assert" || name == "assume") {
        Some("undefined")
    } else if (name == "__blackBox") {
        let vs = evalArgsJs(ctx, args, locals);
        Some(nthStr(vs, 0))
    } else if (name == "sysArgc") {
        Some("_gs_sysArgc()")
    } else if (name == "sysArgv") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_sysArgv(" + nthStr(vs, 0) + ")")
    } else if (name == "__concNumCpu") {
        Some("1")
    } else if (name == "__concAtomicNew") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("{ v: (" + nthStr(vs, 0) + " | 0) }")
    } else if (name == "__concAtomicLoad") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("(" + nthStr(vs, 0) + ".v | 0)")
    } else if (name == "__concAtomicStore") {
        let vs = evalArgsJs(ctx, args, locals);
        jcEmitLine(ctx, nthStr(vs, 0) + ".v = (" + nthStr(vs, 1) + " | 0);");
        Some("undefined")
    } else if (name == "__concAtomicAdd") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_atomicAdd(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ")")
    } else if (name == "__concAtomicCas") {
        let vs = evalArgsJs(ctx, args, locals);
        Some("_gs_atomicCas(" + nthStr(vs, 0) + ", " + nthStr(vs, 1) + ", " + nthStr(vs, 2) + ")")
    } else if (strStartsWith(name, "__conc")) {
        Some("(() => { throw new Error(" + jsStringLit("Geisha JS target does not support blocking multicore primitive '" + name + "'") + "); })()")
    } else {
        None
    }

def emitExternCallJs(ext: ExternDef, argExprs: List String): String =
    if (ext.extIsFnPtr) {
        match argExprs {
            Cons(fp, rest) -> "(" + fp + ")(" + strJoin(rest, ", ") + ")",
            Nil -> "(() => { throw new Error(\"Geisha extern ptr call missing function pointer\"); })()",
        }
    } else {
        let link = ext.extLink;
        let joined = strJoin(argExprs, ", ");
        if (link == "strtod") "_gs_strtod(" + nthStr(argExprs, 0) + ")"
        else if (link == "gs_fmt_f64") "_gs_fmt_f64(" + joined + ")"
        else if (link == "gs_sys_rand_seed") "_gs_rand_seed()"
        else if (link == "gs_sys_time_now_ms") "BigInt(Date.now())"
        else if (link == "gs_sys_time_mono_ms") "BigInt(Math.trunc(performance.now()))"
        else if (link == "gs_sys_time_mono_ns") "BigInt(Math.trunc(performance.now() * 1e6))"
        else if (link == "gs_sys_fd_write" || link == "write") "_gs_sys_write(" + joined + ")"
        else if (link == "gs_sys_host_os") "_gs_host_os()"
        else if (link == "gs_sys_host_arch") "_gs_host_arch()"
        else if (link == "gs_sys_exe_path") "_gs_exe_path()"
        else if (link == "getenv") "_gs_getenv(" + nthStr(argExprs, 0) + ")"
        else if (link == "exit") "_gs_sys_exit(" + nthStr(argExprs, 0) + ")"
        else if (strStartsWith(link, "js:")) {
            let jsPath = strSlice(link, 3, strLen(link));
            "_gs_hostCall(" + jsStringLit(jsPath) + ", [" + joined + "])"
        } else {
            "_gs_hostCall(" + jsStringLit(link) + ", [" + joined + "])"
        }
    }

// ============================================================================
// Expression & Statement Code Generation
// ============================================================================

def emitJsExpr(ctx: JsEmitCtx, tm: TaggedTerm, locals: List (String, String)): String = {
    let resTy = schemeBody(tm.tscm);
    match tm.tnode {
        TmLit(lit) -> emitLitJs(lit, resTy),
        TmVar(vname) -> match lookupLocalJs(locals, vname) {
            Some(jsNm) -> jsNm,
            None ->
                if (strMapContains(ctx.jcProg.coreFns, vname)) jsFnIdent(vname)
                else jsGlobalIdent(vname),
        },
        TmGlobalVar(gname) ->
            if (strMapContains(ctx.jcProg.coreFns, gname)) jsFnIdent(gname)
            else jsGlobalIdent(gname),
        TmTuple(es) -> {
            let vals = evalArgsJs(ctx, es, locals);
            "[" + strJoin(vals, ", ") + "]"
        },
        TmUn(op, e) -> {
            let ev = emitJsExpr(ctx, e, locals);
            emitUnOpJs(op, ev, schemeBody(e.tscm))
        },
        TmBin(op, l, r) -> match op {
            OpAnd -> {
                let tmp = jcFreshTmp(ctx);
                let lv = emitJsExpr(ctx, l, locals);
                jcEmitLine(ctx, "let " + tmp + " = false;");
                jcEmitLine(ctx, "if (" + lv + ") {");
                jcIncIndent(ctx);
                emitJsStmt(ctx, r, locals, TgtAssign(tmp));
                jcDecIndent(ctx);
                jcEmitLine(ctx, "}");
                tmp
            },
            OpOr -> {
                let tmp = jcFreshTmp(ctx);
                let lv = emitJsExpr(ctx, l, locals);
                jcEmitLine(ctx, "let " + tmp + " = true;");
                jcEmitLine(ctx, "if (!(" + lv + ")) {");
                jcIncIndent(ctx);
                emitJsStmt(ctx, r, locals, TgtAssign(tmp));
                jcDecIndent(ctx);
                jcEmitLine(ctx, "}");
                tmp
            },
            _ -> {
                let lv0 = emitJsExpr(ctx, l, locals);
                let lv =
                    if (!isPureImmutableJsExpr(l) && !isPureImmutableJsExpr(r)) {
                        let t = jcFreshTmp(ctx);
                        jcEmitLine(ctx, "const " + t + " = " + lv0 + ";");
                        t
                    } else lv0;
                let rv = emitJsExpr(ctx, r, locals);
                emitBinOpJs(op, lv, rv, schemeBody(l.tscm))
            },
        },
        TmGetTag(node) -> {
            let nv = emitJsExpr(ctx, node, locals);
            "(" + nv + ".$)"
        },
        TmMakeData(adtName, tag, fields, _, _) -> {
            let vinfoOpt = match strMapGet(ctx.jcProg.coreAdtReg, adtName) {
                Some(ainfo) -> findVariantByTag(ainfo.variants, tag),
                None -> None,
            };
            match fields {
                Nil -> "{ $: " + intToStr(tag) + " }",
                _ -> {
                    let fvals = evalArgsJs(ctx, fields, locals);
                    let partsRev = cellNew(["$: " + intToStr(tag)]);
                    let idx = cellNew(0);
                    let cur = cellNew(fvals);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(fv, r) -> {
                                let prop = variantFieldProp(vinfoOpt, cellGet(idx));
                                cellSet(partsRev, Cons(prop + ": " + fv, cellGet(partsRev)));
                                cellSet(idx, cellGet(idx) + 1);
                                cellSet(cur, r)
                            },
                            Nil -> (),
                        }
                    };
                    "{ " + strJoin(listRev(cellGet(partsRev)), ", ") + " }"
                },
            }
        },
        TmApplyCls(clsTm, args) -> {
            let cv = emitJsExpr(ctx, clsTm, locals);
            let avs = evalArgsJs(ctx, args, locals);
            "(" + cv + ")(" + strJoin(avs, ", ") + ")"
        },
        TmApplyDir(vd, args) -> match tryEmitBuiltinJs(ctx, vd.vname, args, resTy, locals) {
            Some(expr) -> expr,
            None -> {
                let avs = evalArgsJs(ctx, args, locals);
                match strMapGet(ctx.jcProg.coreExterns, vd.vname) {
                    Some(ext) -> emitExternCallJs(ext, avs),
                    None -> jsFnIdent(vd.vname) + "(" + strJoin(avs, ", ") + ")",
                }
            },
        },
        TmBlock(_) -> {
            let tmp = jcFreshTmp(ctx);
            jcEmitLine(ctx, "let " + tmp + ";");
            emitJsStmt(ctx, tm, locals, TgtAssign(tmp));
            tmp
        },
        TmLet(_, _, _) -> {
            let tmp = jcFreshTmp(ctx);
            jcEmitLine(ctx, "let " + tmp + ";");
            emitJsStmt(ctx, tm, locals, TgtAssign(tmp));
            tmp
        },
        TmMakeCls(_, _, _) -> {
            let tmp = jcFreshTmp(ctx);
            jcEmitLine(ctx, "let " + tmp + ";");
            emitJsStmt(ctx, tm, locals, TgtAssign(tmp));
            tmp
        },
        TmIf(_, _, _) -> {
            let tmp = jcFreshTmp(ctx);
            jcEmitLine(ctx, "let " + tmp + ";");
            emitJsStmt(ctx, tm, locals, TgtAssign(tmp));
            tmp
        },
        TmWhile(_, _) -> {
            emitJsStmt(ctx, tm, locals, TgtDiscard);
            "undefined"
        },
        TmMatch(_, _) -> {
            let tmp = jcFreshTmp(ctx);
            jcEmitLine(ctx, "let " + tmp + ";");
            emitJsStmt(ctx, tm, locals, TgtAssign(tmp));
            tmp
        },
    }
}

def emitJsStmt(ctx: JsEmitCtx, tm: TaggedTerm, locals: List (String, String), target: StmtTarget): Void = match tm.tnode {
    TmBlock(es) -> emitJsBlockItems(ctx, es, locals, target),
    TmLet(vd, valTm, bodyTm) -> {
        let vexpr = emitJsExpr(ctx, valTm, locals);
        let (jsNm, nextLocs) = bindLocalJs(ctx, locals, vd.vname);
        jcEmitLine(ctx, "const " + jsNm + " = " + vexpr + ";");
        emitJsStmt(ctx, bodyTm, nextLocs, target)
    },
    TmMakeCls(vd, cls, bodyTm) -> {
        let (jsNm, nextLocs) = bindLocalJs(ctx, locals, vd.vname);
        let entryJs = jsFnIdent(cls.clsEntry);
        match cls.clsFvs {
            Nil -> jcEmitLine(ctx, "const " + jsNm + " = " + entryJs + ";"),
            fvs -> {
                let envTmp = jcFreshTmp(ctx);
                let elemsRev = cellNew(Nil);
                let selfIdxRev = cellNew(Nil);
                let idx = cellNew(0);
                let cur = cellNew(fvs);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(fv, r) -> {
                            if (fv == vd.vname) {
                                cellSet(elemsRev, Cons("null", cellGet(elemsRev)));
                                cellSet(selfIdxRev, Cons(cellGet(idx), cellGet(selfIdxRev)))
                            } else {
                                let fvExpr = match lookupLocalJs(locals, fv) {
                                    Some(locJs) -> locJs,
                                    None ->
                                        if (strMapContains(ctx.jcProg.coreFns, fv)) jsFnIdent(fv)
                                        else jsGlobalIdent(fv),
                                };
                                cellSet(elemsRev, Cons(fvExpr, cellGet(elemsRev)))
                            };
                            cellSet(idx, cellGet(idx) + 1);
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                jcEmitLine(ctx, "const " + envTmp + " = [" + strJoin(listRev(cellGet(elemsRev)), ", ") + "];");
                jcEmitLine(ctx, "const " + jsNm + " = (...$a) => " + entryJs + "(...$a, " + envTmp + ");");
                let cs = cellNew(listRev(cellGet(selfIdxRev)));
                while (match cellGet(cs) { Nil -> false, _ -> true }) {
                    match cellGet(cs) {
                        Cons(si, r) -> {
                            jcEmitLine(ctx, envTmp + "[" + intToStr(si) + "] = " + jsNm + ";");
                            cellSet(cs, r)
                        },
                        Nil -> (),
                    }
                }
            },
        };
        emitJsStmt(ctx, bodyTm, nextLocs, target)
    },
    TmIf(c, t, e) -> {
        let cv = emitJsExpr(ctx, c, locals);
        jcEmitLine(ctx, "if (" + cv + ") {");
        jcIncIndent(ctx);
        emitJsStmt(ctx, t, locals, target);
        jcDecIndent(ctx);
        jcEmitLine(ctx, "} else {");
        jcIncIndent(ctx);
        emitJsStmt(ctx, e, locals, target);
        jcDecIndent(ctx);
        jcEmitLine(ctx, "}")
    },
    TmWhile(c, b) -> {
        jcEmitLine(ctx, "while (true) {");
        jcIncIndent(ctx);
        let cv = emitJsExpr(ctx, c, locals);
        jcEmitLine(ctx, "if (!(" + cv + ")) break;");
        emitJsStmt(ctx, b, locals, TgtDiscard);
        jcDecIndent(ctx);
        jcEmitLine(ctx, "}");
        emitTargetResult(ctx, target, "undefined")
    },
    TmMatch(scrut, arms) -> {
        let sv = emitJsExpr(ctx, scrut, locals);
        let scrutTmp = jcFreshTmp(ctx);
        jcEmitLine(ctx, "const " + scrutTmp + " = " + sv + ";");
        let scrutTy = schemeBody(scrut.tscm);
        emitJsMatchArms(ctx, scrutTmp, scrutTy, arms, locals, target)
    },
    TmApplyDir(vd, args) -> match target {
        TgtReturn if (ctx.jcTcoActive && vd.vname == ctx.jcCurFnName) -> {
            // Direct self-tail-call optimization -> update parameters + continue
            let argExprs = evalArgsJs(ctx, args, locals);
            let tmpsRev = cellNew(Nil);
            let ca = cellNew(argExprs);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(ae, r) -> {
                        let t = jcFreshTmp(ctx);
                        jcEmitLine(ctx, "const " + t + " = " + ae + ";");
                        cellSet(tmpsRev, Cons(t, cellGet(tmpsRev)));
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            };
            let cp = cellNew(ctx.jcTcoParamJs);
            let ct = cellNew(listRev(cellGet(tmpsRev)));
            while (match (cellGet(cp), cellGet(ct)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                match (cellGet(cp), cellGet(ct)) {
                    (Cons(pjs, rp), Cons(tjs, rt)) -> {
                        jcEmitLine(ctx, pjs + " = " + tjs + ";");
                        cellSet(cp, rp);
                        cellSet(ct, rt)
                    },
                    _ -> (),
                }
            };
            jcEmitLine(ctx, "continue;")
        },
        _ -> {
            let e = emitJsExpr(ctx, tm, locals);
            emitTargetResult(ctx, target, e)
        },
    },
    _ -> {
        let e = emitJsExpr(ctx, tm, locals);
        emitTargetResult(ctx, target, e)
    },
}

def emitJsBlockItems(ctx: JsEmitCtx, es: List TaggedTerm, locals: List (String, String), target: StmtTarget): Void = match es {
    Nil -> emitTargetResult(ctx, target, "undefined"),
    Cons(last, Nil) -> emitJsStmt(ctx, last, locals, target),
    Cons(h, t) -> {
        emitJsStmt(ctx, h, locals, TgtDiscard);
        emitJsBlockItems(ctx, t, locals, target)
    },
}

def emitJsMatchArms(
    ctx: JsEmitCtx,
    scrutTmp: String,
    scrutTy: Type,
    arms: List CoreArm,
    locals: List (String, String),
    target: StmtTarget
): Void = {
    let matchedVar = jcFreshTmp(ctx);
    jcEmitLine(ctx, "let " + matchedVar + " = false;");
    let cur = cellNew(arms);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(arm, rest) -> {
                let condsRev: Cell (List String) = cellNew(Nil);
                let bindsRev: Cell (List (String, String)) = cellNew(Nil);
                let armLocals = cellNew(locals);
                emitPatternCondAndBinds(ctx, scrutTmp, scrutTy, arm.caPat, condsRev, bindsRev, armLocals);
                let condList = listRev(cellGet(condsRev));
                let condStr = match condList {
                    Nil -> "!" + matchedVar,
                    _ -> "!" + matchedVar + " && " + strJoin(condList, " && "),
                };
                jcEmitLine(ctx, "if (" + condStr + ") {");
                jcIncIndent(ctx);
                let cb = cellNew(listRev(cellGet(bindsRev)));
                while (match cellGet(cb) { Nil -> false, _ -> true }) {
                    match cellGet(cb) {
                        Cons((bname, bexpr), rb) -> {
                            jcEmitLine(ctx, "const " + bname + " = " + bexpr + ";");
                            cellSet(cb, rb)
                        },
                        Nil -> (),
                    }
                };
                match arm.caGuard {
                    Some(gTerm) -> {
                        let gv = emitJsExpr(ctx, gTerm, cellGet(armLocals));
                        jcEmitLine(ctx, "if (" + gv + ") {");
                        jcIncIndent(ctx);
                        jcEmitLine(ctx, matchedVar + " = true;");
                        emitJsStmt(ctx, arm.caBody, cellGet(armLocals), target);
                        jcDecIndent(ctx);
                        jcEmitLine(ctx, "}")
                    },
                    None -> {
                        jcEmitLine(ctx, matchedVar + " = true;");
                        emitJsStmt(ctx, arm.caBody, cellGet(armLocals), target)
                    },
                };
                jcDecIndent(ctx);
