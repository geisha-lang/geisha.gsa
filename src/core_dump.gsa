// Core Geisha S-Expression Exporter (`--dump-core`)
//
// Serializes a monomorphized `CoreProgram` into `.gscore` S-expression format
// (including closure capture modes `local`/`shared` and concurrent `task`/`spawn`/`await`)
// consumed by the Lean 4 machine-checked verifier `formal/.lake/build/bin/geisha-check`.

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listLen, listAppend}
use std.buf.{StringBuf, bufNew, bufPushStr, bufPushByte, bufToString}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.str.{intToStr, i64ToStr}
use ast.{
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmMono, ScmSlot, schemeBody,
    Lit, LitInt, LitFloat, LitChar, LitStr, LitBool, LitUnit,
    BinOp, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpAnd, OpOr,
    OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, OpUshr,
    OpEq, OpNe, OpLt, OpLe, OpGt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl, MkVarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct,
    emptySpan
}
use infer.{
    VariantInfo, AdtInfo, mangleType, applyExplicitSubst, buildPairMap, findVariantByName
}
use core.{
    ClosureSpec, TaggedTerm, MkTerm, CoreArm, Term,
    TmLit, TmVar, TmGlobalVar, TmTuple, TmBlock, TmMakeCls, TmApplyCls, TmApplyDir,
    TmBin, TmUn, TmLet, TmIf, TmWhile, TmMatch, TmMakeData, TmGetTag,
    FunDef, GlobalValDef, EscapeInfo, CoreProgram, extractTypeArgs
}
use codegen.{initCodegenLayoutContext, computeCodegenVariantGcMaskSExpr}

data DumpCtx {
    MkDumpCtx {
        dcProg: CoreProgram,
        dcInstAdts: StrMap (String, List Type, String),
        dcInstAdtOrder: Cell (List String),
        dcParamShared: StrMap Bool,
        dcFvNonSend: StrMap Bool,
        dcClsLocal: StrMap Bool,
        dcRetLocal: StrMap Bool,
        dcAdtLocal: StrMap Bool,
        dcAdtDualMode: StrMap Bool,
        dcFnLocalVars: StrMap Bool,
        dcCurFn: Cell String,
        dcGlobTypes: StrMap Type,
        dcFnGlobs: StrMap (List GlobalValDef),
        dcExternMap: StrMap String,
        dcExternDefs: StrMap (List String, String),
        dcExternOrder: Cell (List String),
        dcUsedFnNames: StrMap Bool,
        dcEmittedRecCls: StrMap Bool,
        dcRecClsBuf: StringBuf,
        dcFreshCnt: Cell Int,
        dcErr: Cell (Option String),
    },
}

def setDumpErr(ctx: DumpCtx, msg: String): Void =
    match cellGet(ctx.dcErr) {
        None -> cellSet(ctx.dcErr, Some(msg)),
        Some(_) -> (),
    }

def pushQuotedStr(b: StringBuf, s: String): Void = {
    bufPushByte(b, 34);
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let c = strByteAt(s, cellGet(i));
        if (c == 34) bufPushStr(b, "\\\"")
        else if (c == 92) bufPushStr(b, "\\\\")
        else if (c == 10) bufPushStr(b, "\\n")
        else if (c == 13) bufPushStr(b, "\\r")
        else if (c == 9) bufPushStr(b, "\\t")
        else bufPushByte(b, c);
        cellSet(i, cellGet(i) + 1)
    };
    bufPushByte(b, 34)
}

def compBaseName(ty: Type): String = match ty {
    TyComp(b, _) -> compBaseName(b),
    TyCon(n) -> n,
    _ -> "",
}

def mangleCoreAdt(baseName: String, targs: List Type): String = match targs {
    Nil -> baseName,
    _ -> {
        let b = bufNew();
        bufPushStr(b, baseName);
        let cur = cellNew(targs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    bufPushByte(b, 95);
                    bufPushStr(b, mangleType(t));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufToString(b)
    },
}

// ============================================================================
// Mode Synthesis Pass (`local` vs `shared`) on Monomorphized `CoreProgram`
// ============================================================================

def markStrMap(m: StrMap Bool, key: String, changed: Cell Bool): Void =
    if (!strMapContains(m, key)) {
        strMapInsert(m, key, true);
        cellSet(changed, true)
    } else ()

def collectBodyBindings(
    tm: TaggedTerm,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec
): Void = match tm.tnode {
    TmMakeCls(vd, cls, body) -> {
        strMapInsert(localCls, vd.vname, cls);
        collectBodyBindings(body, letRhs, localCls)
    },
    TmLet(vd, e1, e2) -> {
        strMapInsert(letRhs, vd.vname, e1);
        collectBodyBindings(e1, letRhs, localCls);
        collectBodyBindings(e2, letRhs, localCls)
    },
    TmTuple(es) -> collectBodyBindingsList(es, letRhs, localCls),
    TmBlock(es) -> collectBodyBindingsList(es, letRhs, localCls),
    TmApplyCls(c, args) -> {
        collectBodyBindings(c, letRhs, localCls);
        collectBodyBindingsList(args, letRhs, localCls)
    },
    TmApplyDir(_, args) -> collectBodyBindingsList(args, letRhs, localCls),
    TmBin(_, l, r) -> {
        collectBodyBindings(l, letRhs, localCls);
        collectBodyBindings(r, letRhs, localCls)
    },
    TmUn(_, e1) -> collectBodyBindings(e1, letRhs, localCls),
    TmIf(c, t, e) -> {
        collectBodyBindings(c, letRhs, localCls);
        collectBodyBindings(t, letRhs, localCls);
        collectBodyBindings(e, letRhs, localCls)
    },
    TmWhile(c, b) -> {
        collectBodyBindings(c, letRhs, localCls);
        collectBodyBindings(b, letRhs, localCls)
    },
    TmMatch(s, arms) -> {
        collectBodyBindings(s, letRhs, localCls);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard {
                        Some(g) -> collectBodyBindings(g, letRhs, localCls),
                        None -> (),
                    };
                    collectBodyBindings(a.caBody, letRhs, localCls);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> collectBodyBindingsList(args, letRhs, localCls),
    TmGetTag(e1) -> collectBodyBindings(e1, letRhs, localCls),
    _ -> (),
}

def collectBodyBindingsList(
    es: List TaggedTerm,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec
): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectBodyBindings(h, letRhs, localCls);
        collectBodyBindingsList(t, letRhs, localCls)
    },
}

def requireTermSend(
    fnName: String,
    tm: TaggedTerm,
    paramSet: StrMap Bool,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec,
    visitedVars: StrMap Bool,
    paramShared: StrMap Bool,
    clsReqShared: StrMap Bool,
    retReqShared: StrMap Bool,
    changed: Cell Bool
): Void = match tm.tnode {
    TmVar(x) ->
        if (!strMapContains(visitedVars, x)) {
            strMapInsert(visitedVars, x, true);
            if (strMapContains(paramSet, x)) {
                markStrMap(paramShared, fnName + ":" + x, changed)
            } else ();
            match strMapGet(localCls, x) {
                Some(cls) -> markStrMap(clsReqShared, cls.clsEntry, changed),
                None -> (),
            };
            match strMapGet(letRhs, x) {
                Some(rhs) -> requireTermSend(
                    fnName, rhs, paramSet, letRhs, localCls, visitedVars,
                    paramShared, clsReqShared, retReqShared, changed
                ),
                None -> (),
            }
        } else (),
    TmMakeCls(_, _, body) ->
        requireTermSend(
            fnName, body, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        ),
    TmLet(_, _, body) ->
        requireTermSend(
            fnName, body, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        ),
    TmBlock(es) -> match listRev(es) {
        Cons(lastTm, _) -> requireTermSend(
            fnName, lastTm, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        ),
        Nil -> (),
    },
    TmIf(_, t, e) -> {
        requireTermSend(
            fnName, t, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        );
        requireTermSend(
            fnName, e, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        )
    },
    TmMatch(_, arms) -> {
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    requireTermSend(
                        fnName, a.caBody, paramSet, letRhs, localCls, visitedVars,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmTuple(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    requireTermSend(
                        fnName, a, paramSet, letRhs, localCls, visitedVars,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, es, _, _) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    requireTermSend(
                        fnName, a, paramSet, letRhs, localCls, visitedVars,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmApplyDir(vd, _) -> markStrMap(retReqShared, vd.vname, changed),
    _ -> (),
}

def isChanRecvWrapper(prog: CoreProgram, name: String): Bool =
    match strMapGet(prog.coreFns, name) {
        Some(fd) -> match fd.fnBody.tnode {
            TmMatch(scrut, _) -> match scrut.tnode {
                TmApplyDir(ivd, _) -> ivd.vname == "__concChanRecv",
                _ -> false,
            },
            _ -> false,
        },
        None -> false,
    }

def markTypeAdtsShared(
    prog: CoreProgram,
    ty: Type,
    adtReqShared: StrMap Bool,
    visiting: StrMap Bool,
    changed: Cell Bool
): Void = match ty {
    TyCon(n) ->
        if (strMapContains(prog.coreAdtReg, n) && !strMapContains(visiting, n)) {
            strMapInsert(visiting, n, true);
            markStrMap(adtReqShared, n, changed);
            match strMapGet(prog.coreAdtReg, n) {
                Some(ainfo) -> {
                    let cv = cellNew(ainfo.variants);
                    while (match cellGet(cv) { Nil -> false, _ -> true }) {
                        match cellGet(cv) {
                            Cons(vi, vr) -> {
                                markTypeListAdtsShared(prog, vi.fieldTypes, adtReqShared, visiting, changed);
                                cellSet(cv, vr)
                            },
                            Nil -> (),
                        }
                    }
                },
                None -> (),
            }
        } else (),
    TyTuple(es) -> markTypeListAdtsShared(prog, es, adtReqShared, visiting, changed),
    TyArr(_, ps, r) -> {
        markTypeListAdtsShared(prog, ps, adtReqShared, visiting, changed);
        markTypeAdtsShared(prog, r, adtReqShared, visiting, changed)
    },
    TyComp(_, _) -> {
        let base = compBaseName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Actor") ()
        else if (strMapContains(prog.coreAdtReg, base)) {
            let mangled = mangleCoreAdt(base, targs);
            if (!strMapContains(visiting, mangled)) {
                strMapInsert(visiting, mangled, true);
                markStrMap(adtReqShared, mangled, changed);
                match strMapGet(prog.coreAdtReg, base) {
                    Some(ainfo) -> {
                        let sub = buildPairMap(ainfo.typeParams, targs);
                        let cv = cellNew(ainfo.variants);
                        while (match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(vi, vr) -> {
                                    let cf = cellNew(vi.fieldTypes);
                                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                        match cellGet(cf) {
                                            Cons(ft, fr) -> {
                                                markTypeAdtsShared(prog, applyExplicitSubst(ft, sub), adtReqShared, visiting, changed);
                                                cellSet(cf, fr)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    cellSet(cv, vr)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                }
            } else ()
        } else {
            markTypeListAdtsShared(prog, targs, adtReqShared, visiting, changed)
        }
    },
    _ -> (),
}

def markTypeListAdtsShared(
    prog: CoreProgram,
    ts: List Type,
    adtReqShared: StrMap Bool,
    visiting: StrMap Bool,
    changed: Cell Bool
): Void = match ts {
    Nil -> (),
    Cons(h, t) -> {
        markTypeAdtsShared(prog, h, adtReqShared, visiting, changed);
        markTypeListAdtsShared(prog, t, adtReqShared, visiting, changed)
    },
}

def scanSendDemandsInTerm(
    prog: CoreProgram,
    fnName: String,
    tm: TaggedTerm,
    paramSet: StrMap Bool,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec,
    paramShared: StrMap Bool,
    clsReqShared: StrMap Bool,
    retReqShared: StrMap Bool,
    adtReqShared: StrMap Bool,
    changed: Cell Bool
): Void = match tm.tnode {
    TmMakeCls(vd, cls, body) -> {
        let cf = cellNew(cls.clsFvs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fvName, r) -> {
                    if (fvName != vd.vname
                        && (strMapContains(clsReqShared, cls.clsEntry)
                            || strMapContains(paramShared, cls.clsEntry + ":" + fvName))) {
                        let vset: StrMap Bool = strMapNew();
                        requireTermSend(
                            fnName,
                            MkTerm { tspan: emptySpan(), tscm: ScmSlot, tnode: TmVar(fvName) },
                            paramSet, letRhs, localCls, vset,
                            paramShared, clsReqShared, retReqShared, changed
                        )
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        scanSendDemandsInTerm(
            prog, fnName, body, paramSet, letRhs, localCls,
            paramShared, clsReqShared, retReqShared, adtReqShared, changed
        )
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname == "__concTaskSpawn" || vd.vname == "__concMVarEmpty" || vd.vname == "__concChanNew" || vd.vname == "__concActorCall" || isChanRecvWrapper(prog, vd.vname)) {
            markTypeAdtsShared(prog, schemeBody(tm.tscm), adtReqShared, strMapNew(), changed)
        } else ();
        if (vd.vname == "__concTaskSpawn" || vd.vname == "__concActorSpawn" || vd.vname == "__concMVarNew") {
            match args {
                Cons(a0, _) -> {
                    if (vd.vname == "__concMVarNew") {
                        markTypeAdtsShared(prog, schemeBody(a0.tscm), adtReqShared, strMapNew(), changed)
                    } else ();
                    let vset: StrMap Bool = strMapNew();
                    requireTermSend(
                        fnName, a0, paramSet, letRhs, localCls, vset,
                        paramShared, clsReqShared, retReqShared, changed
                    )
                },
                Nil -> (),
            }
        } else if (vd.vname == "__concMVarPut" || vd.vname == "__concChanSend" || vd.vname == "__concActorCall" || vd.vname == "__concActorSend" || vd.vname == "parTabulate") {
            match args {
                Cons(_, Cons(a1, _)) -> {
                    if (vd.vname == "__concMVarPut" || vd.vname == "__concChanSend") {
                        markTypeAdtsShared(prog, schemeBody(a1.tscm), adtReqShared, strMapNew(), changed)
                    } else ();
                    let vset: StrMap Bool = strMapNew();
                    requireTermSend(
                        fnName, a1, paramSet, letRhs, localCls, vset,
                        paramShared, clsReqShared, retReqShared, changed
                    )
                },
                _ -> (),
            }
        } else if (!isChanRecvWrapper(prog, vd.vname)) {
            match strMapGet(prog.coreFns, vd.vname) {
                Some(calleeFd) -> {
                    let cp = cellNew(calleeFd.fnParams);
                    let ca = cellNew(args);
                    while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                        match (cellGet(cp), cellGet(ca)) {
                            (Cons(pvd, pr), Cons(argTm, ar)) -> {
                                if (strMapContains(paramShared, vd.vname + ":" + pvd.vname)) {
                                    markTypeAdtsShared(prog, schemeBody(argTm.tscm), adtReqShared, strMapNew(), changed);
                                    let vset: StrMap Bool = strMapNew();
                                    requireTermSend(
                                        fnName, argTm, paramSet, letRhs, localCls, vset,
                                        paramShared, clsReqShared, retReqShared, changed
                                    )
                                } else ();
                                cellSet(cp, pr);
                                cellSet(ca, ar)
                            },
                            _ -> (),
                        }
                    }
                },
                None -> (),
            }
        } else ();
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, adtReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmApplyCls(c, args) -> {
        scanSendDemandsInTerm(
            prog, fnName, c, paramSet, letRhs, localCls,
            paramShared, clsReqShared, retReqShared, adtReqShared, changed
        );
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, adtReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmTuple(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, adtReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmBlock(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, adtReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmBin(_, l, r) -> {
        scanSendDemandsInTerm(prog, fnName, l, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, r, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed)
    },
    TmUn(_, e1) -> scanSendDemandsInTerm(prog, fnName, e1, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed),
    TmLet(_, e1, e2) -> {
        scanSendDemandsInTerm(prog, fnName, e1, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, e2, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed)
    },
    TmIf(c, t, e) -> {
        scanSendDemandsInTerm(prog, fnName, c, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, t, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, e, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed)
    },
    TmWhile(c, b) -> {
        scanSendDemandsInTerm(prog, fnName, c, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, b, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed)
    },
    TmMatch(s, arms) -> {
        scanSendDemandsInTerm(prog, fnName, s, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard {
                        Some(g) -> scanSendDemandsInTerm(prog, fnName, g, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed),
                        None -> (),
                    };
                    scanSendDemandsInTerm(prog, fnName, a.caBody, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> {
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(prog, fnName, a, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmGetTag(e1) -> scanSendDemandsInTerm(prog, fnName, e1, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, adtReqShared, changed),
    _ -> (),
}

def adtHasIntrinsicNonSend(
    prog: CoreProgram,
    adtLocal: StrMap Bool,
    baseName: String,
    targs: List Type,
    visiting: StrMap Bool
): Bool = {
    let mangled = mangleCoreAdt(baseName, targs);
    if (strMapContains(adtLocal, mangled) || strMapContains(adtLocal, baseName)) true
    else if (strMapContains(visiting, mangled)) false
    else {
        strMapInsert(visiting, mangled, true);
        match strMapGet(prog.coreAdtReg, baseName) {
            None -> false,
            Some(ainfo) -> {
                let sub = buildPairMap(ainfo.typeParams, targs);
                let hit = cellNew(false);
                let cv = cellNew(ainfo.variants);
                while (match cellGet(cv) { Nil -> false, _ -> !cellGet(hit) }) {
                    match cellGet(cv) {
                        Cons(vi, vr) -> {
                            let cf = cellNew(vi.fieldTypes);
                            while (match cellGet(cf) { Nil -> false, _ -> !cellGet(hit) }) {
                                match cellGet(cf) {
                                    Cons(ft, fr) -> {
                                        let instFt = applyExplicitSubst(ft, sub);
                                        if (typeHasIntrinsicNonSend(prog, adtLocal, instFt, visiting)) {
                                            cellSet(hit, true)
                                        } else ();
                                        cellSet(cf, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            cellSet(cv, vr)
                        },
                        Nil -> (),
                    }
                };
                cellGet(hit)
            },
        }
    }
}

def typeHasIntrinsicNonSend(
    prog: CoreProgram,
    adtLocal: StrMap Bool,
    ty: Type,
    visiting: StrMap Bool
): Bool = match ty {
    TyVoid -> false,
    TyCon(n) ->
        if (n == "Cell" || n == "MutArray" || n == "Ptr" || n == "ScopedPtr" || n == "Arena" || n == "ForeignPtr") true
        else if (strMapContains(prog.coreAdtReg, n)) adtHasIntrinsicNonSend(prog, adtLocal, n, Nil, visiting)
        else strMapContains(adtLocal, n),
    TyArr(_, _, _) -> false,
    TyTuple(es) -> {
        let bad = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(bad) }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    if (typeHasIntrinsicNonSend(prog, adtLocal, t, visiting)) cellSet(bad, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(bad)
    },
    TyComp(_, _) -> {
        let base = compBaseName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Cell" || base == "MutArray") true
        else if (base == "Actor") false
        else if (strMapContains(prog.coreAdtReg, base)) adtHasIntrinsicNonSend(prog, adtLocal, base, targs, visiting)
        else {
            let bad = cellNew(false);
            let cur = cellNew(targs);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(bad) }) {
                match cellGet(cur) {
                    Cons(t, r) -> {
                        if (typeHasIntrinsicNonSend(prog, adtLocal, t, visiting)) cellSet(bad, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(bad)
        }
    },
    TyVar(_) -> false,
}

def isTypeNonSendInDump(prog: CoreProgram, adtLocal: StrMap Bool, ty: Type, fnMode: String): Bool = match ty {
    TyVoid -> false,
    TyCon(n) ->
        if (n == "Cell" || n == "MutArray" || n == "Ptr" || n == "ScopedPtr" || n == "Arena" || n == "ForeignPtr") true
        else if (strMapContains(prog.coreAdtReg, n)) adtHasIntrinsicNonSend(prog, adtLocal, n, Nil, strMapNew())
        else strMapContains(adtLocal, n),
    TyArr(_, _, _) -> fnMode == "local",
    TyTuple(es) -> {
        let bad = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(bad) }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    if (isTypeNonSendInDump(prog, adtLocal, t, fnMode)) cellSet(bad, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(bad)
    },
    TyComp(_, _) -> {
        let base = compBaseName(ty);
        let targs = extractTypeArgs(ty);
        let mangled = mangleCoreAdt(base, targs);
        if (base == "Cell" || base == "MutArray") true
        else if (base == "Actor") false
        else if (strMapContains(adtLocal, mangled) || strMapContains(adtLocal, base)) true
        else if (strMapContains(prog.coreAdtReg, base) && adtHasIntrinsicNonSend(prog, adtLocal, base, targs, strMapNew())) true
        else {
            let bad = cellNew(false);
            let cur = cellNew(targs);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(bad) }) {
                match cellGet(cur) {
                    Cons(t, r) -> {
                        if (isTypeNonSendInDump(prog, adtLocal, t, fnMode)) cellSet(bad, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(bad)
        }
    },
    TyVar(_) -> false,
}

def bindPatNonSendVars(
    adtLocal: StrMap Bool,
    pat: Pattern,
    scrutNonSend: Bool,
    nonSendVars: StrMap Bool
): Void = match pat {
    PatWild -> (),
    PatLit(_) -> (),
    PatVar(x) -> if (scrutNonSend) strMapInsert(nonSendVars, x, true) else (),
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    bindPatNonSendVars(adtLocal, p, scrutNonSend, nonSendVars);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    PatCtor(_, ps) -> {
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    bindPatNonSendVars(adtLocal, p, scrutNonSend, nonSendVars);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    PatStruct(_, _) -> (),
}

def termUsesNonSendGlobal(
    prog: CoreProgram,
    tm: TaggedTerm,
    globTypes: StrMap Type,
    adtLocal: StrMap Bool,
    visitedCls: StrMap Bool
): Bool = match tm.tnode {
    TmLit(_) -> false,
    TmVar(_) -> false,
    TmGlobalVar(g) -> match strMapGet(globTypes, g) {
        Some(gty) -> isTypeNonSendInDump(prog, adtLocal, gty, "local"),
        None -> true,
    },
    TmTuple(es) -> termListUsesNonSendGlobal(prog, es, globTypes, adtLocal, visitedCls),
    TmBlock(es) -> termListUsesNonSendGlobal(prog, es, globTypes, adtLocal, visitedCls),
    TmMakeCls(_, cls, body) -> {
        let inCls =
            if (strMapContains(visitedCls, cls.clsEntry)) false
            else {
                strMapInsert(visitedCls, cls.clsEntry, true);
                match strMapGet(prog.coreFns, cls.clsEntry) {
                    Some(cfd) -> termUsesNonSendGlobal(prog, cfd.fnBody, globTypes, adtLocal, visitedCls),
                    None -> false,
                }
            };
        inCls || termUsesNonSendGlobal(prog, body, globTypes, adtLocal, visitedCls)
    },
    TmApplyCls(c, args) ->
        termUsesNonSendGlobal(prog, c, globTypes, adtLocal, visitedCls)
        || termListUsesNonSendGlobal(prog, args, globTypes, adtLocal, visitedCls),
    TmApplyDir(_, args) -> termListUsesNonSendGlobal(prog, args, globTypes, adtLocal, visitedCls),
    TmBin(_, l, r) ->
        termUsesNonSendGlobal(prog, l, globTypes, adtLocal, visitedCls)
        || termUsesNonSendGlobal(prog, r, globTypes, adtLocal, visitedCls),
    TmUn(_, e1) -> termUsesNonSendGlobal(prog, e1, globTypes, adtLocal, visitedCls),
    TmLet(_, e1, e2) ->
        termUsesNonSendGlobal(prog, e1, globTypes, adtLocal, visitedCls)
        || termUsesNonSendGlobal(prog, e2, globTypes, adtLocal, visitedCls),
    TmIf(c, t, e) ->
        termUsesNonSendGlobal(prog, c, globTypes, adtLocal, visitedCls)
        || termUsesNonSendGlobal(prog, t, globTypes, adtLocal, visitedCls)
        || termUsesNonSendGlobal(prog, e, globTypes, adtLocal, visitedCls),
    TmWhile(c, b) ->
        termUsesNonSendGlobal(prog, c, globTypes, adtLocal, visitedCls)
        || termUsesNonSendGlobal(prog, b, globTypes, adtLocal, visitedCls),
    TmMatch(s, arms) -> {
        if (termUsesNonSendGlobal(prog, s, globTypes, adtLocal, visitedCls)) true
        else {
            let hit = cellNew(false);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let gHit = match a.caGuard {
                            Some(g) -> termUsesNonSendGlobal(prog, g, globTypes, adtLocal, visitedCls),
                            None -> false,
                        };
                        if (gHit || termUsesNonSendGlobal(prog, a.caBody, globTypes, adtLocal, visitedCls)) {
                            cellSet(hit, true)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        }
    },
    TmMakeData(_, _, args, _, _) -> termListUsesNonSendGlobal(prog, args, globTypes, adtLocal, visitedCls),
    TmGetTag(e1) -> termUsesNonSendGlobal(prog, e1, globTypes, adtLocal, visitedCls),
}

def termListUsesNonSendGlobal(
    prog: CoreProgram,
    es: List TaggedTerm,
    globTypes: StrMap Type,
    adtLocal: StrMap Bool,
    visitedCls: StrMap Bool
): Bool = match es {
    Nil -> false,
    Cons(h, t) ->
        if (termUsesNonSendGlobal(prog, h, globTypes, adtLocal, visitedCls)) true
        else termListUsesNonSendGlobal(prog, t, globTypes, adtLocal, visitedCls),
}

def clsUsesNonSendGlobal(
    prog: CoreProgram,
    clsEntry: String,
    fnGlobs: StrMap (List GlobalValDef),
    adtLocal: StrMap Bool
): Bool = match strMapGet(fnGlobs, clsEntry) {
    None -> false,
    Some(gs) -> {
        let hit = cellNew(false);
        let cg = cellNew(gs);
        while (match cellGet(cg) { Nil -> false, _ -> !cellGet(hit) }) {
            match cellGet(cg) {
                Cons(g, gr) -> {
                    if (isTypeNonSendInDump(prog, adtLocal, g.gvTy, "local")) {
                        cellSet(hit, true)
                    } else ();
                    cellSet(cg, gr)
                },
                Nil -> (),
            }
        };
        cellGet(hit)
    },
}

def collectTermBoundNames(tm: TaggedTerm, revOut: Cell (List String)): Void = match tm.tnode {
    TmMakeCls(vd, _, body) -> {
        cellSet(revOut, Cons(vd.vname, cellGet(revOut)));
        collectTermBoundNames(body, revOut)
    },
    TmLet(vd, e1, e2) -> {
        cellSet(revOut, Cons(vd.vname, cellGet(revOut)));
        collectTermBoundNames(e1, revOut);
        collectTermBoundNames(e2, revOut)
    },
    TmTuple(es) -> collectTermListBoundNames(es, revOut),
    TmBlock(es) -> collectTermListBoundNames(es, revOut),
    TmApplyCls(c, args) -> {
        collectTermBoundNames(c, revOut);
        collectTermListBoundNames(args, revOut)
    },
    TmApplyDir(_, args) -> collectTermListBoundNames(args, revOut),
    TmBin(_, l, r) -> {
        collectTermBoundNames(l, revOut);
        collectTermBoundNames(r, revOut)
    },
    TmUn(_, e1) -> collectTermBoundNames(e1, revOut),
    TmIf(c, t, e) -> {
        collectTermBoundNames(c, revOut);
        collectTermBoundNames(t, revOut);
        collectTermBoundNames(e, revOut)
    },
    TmWhile(c, b) -> {
        collectTermBoundNames(c, revOut);
        collectTermBoundNames(b, revOut)
    },
    TmMatch(s, arms) -> {
        collectTermBoundNames(s, revOut);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    collectPatBoundNames(a.caPat, revOut);
                    match a.caGuard { Some(g) -> collectTermBoundNames(g, revOut), None -> () };
                    collectTermBoundNames(a.caBody, revOut);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> collectTermListBoundNames(args, revOut),
    TmGetTag(e1) -> collectTermBoundNames(e1, revOut),
    _ -> (),
}

def collectTermListBoundNames(es: List TaggedTerm, revOut: Cell (List String)): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectTermBoundNames(h, revOut);
        collectTermListBoundNames(t, revOut)
    },
}

def collectPatBoundNames(pat: Pattern, revOut: Cell (List String)): Void = match pat {
    PatVar(x) -> cellSet(revOut, Cons(x, cellGet(revOut))),
    PatTuple(ps) -> collectPatListBoundNames(ps, revOut),
    PatCtor(_, ps) -> collectPatListBoundNames(ps, revOut),
    _ -> (),
}

def collectPatListBoundNames(ps: List Pattern, revOut: Cell (List String)): Void = match ps {
    Nil -> (),
    Cons(p, r) -> {
        collectPatBoundNames(p, revOut);
        collectPatListBoundNames(r, revOut)
    },
}

def gTmpAdtReqShared: Cell (StrMap Bool) = cellNew(strMapNew())
def gTmpAdtDualMode: Cell (StrMap Bool) = cellNew(strMapNew())

def propagateLocalInTerm(
    prog: CoreProgram,
    tm: TaggedTerm,
    nonSendVars: StrMap Bool,
    localCls: StrMap ClosureSpec,
    fvNonSend: StrMap Bool,
    globTypes: StrMap Type,
    fnGlobs: StrMap (List GlobalValDef),
    clsLocal: StrMap Bool,
    retLocal: StrMap Bool,
    adtLocal: StrMap Bool,
    changed: Cell Bool
): Bool = match tm.tnode {
    TmLit(_) -> false,
    TmVar(x) ->
        strMapContains(nonSendVars, x)
        || isTypeNonSendInDump(prog, adtLocal, schemeBody(tm.tscm), "shared"),
    TmGlobalVar(g) -> match strMapGet(globTypes, g) {
        Some(gty) -> isTypeNonSendInDump(prog, adtLocal, gty, "local"),
        None -> true,
    },
    TmTuple(es) -> {
        let anyLocal = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    if (propagateLocalInTerm(prog, a, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed)) {
                        cellSet(anyLocal, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(anyLocal)
    },
    TmBlock(es) -> {
        let lastLocal = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let isLoc = propagateLocalInTerm(prog, a, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
                    cellSet(lastLocal, isLoc);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(lastLocal)
    },
    TmMakeCls(vd, cls, body) -> {
        strMapInsert(localCls, vd.vname, cls);
        if (strMapContains(clsLocal, cls.clsEntry)) {
            strMapInsert(nonSendVars, vd.vname, true)
        } else ();
        let cf = cellNew(cls.clsFvs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fvName, r) -> {
                    if (strMapContains(nonSendVars, fvName)) {
                        markStrMap(clsLocal, cls.clsEntry, changed);
                        markStrMap(fvNonSend, cls.clsEntry + ":" + fvName, changed)
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        if (clsUsesNonSendGlobal(prog, cls.clsEntry, fnGlobs, adtLocal)) {
            markStrMap(clsLocal, cls.clsEntry, changed)
        } else ();
        if (strMapContains(clsLocal, cls.clsEntry)) {
            strMapInsert(nonSendVars, vd.vname, true);
            if (listContainsStrDump(cls.clsFvs, vd.vname)) {
                markStrMap(fvNonSend, cls.clsEntry + ":" + vd.vname, changed)
            } else ()
        } else ();
        propagateLocalInTerm(prog, body, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed)
    },
    TmApplyCls(c, args) -> {
        let _ = propagateLocalInTerm(prog, c, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let _ = propagateLocalInTerm(prog, a, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        isTypeNonSendInDump(prog, adtLocal, schemeBody(tm.tscm), "shared")
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname == "cellNew") {
            match args {
                Cons(a0, _) -> match a0.tnode {
                    TmVar(vn) -> match strMapGet(localCls, vn) {
                        Some(cls) -> markStrMap(clsLocal, cls.clsEntry, changed),
                        None -> (),
                    },
                    _ -> (),
                },
                Nil -> (),
            }
        } else if (vd.vname == "cellSet" || vd.vname == "arrayNew") {
            match args {
                Cons(_, Cons(a1, _)) -> match a1.tnode {
                    TmVar(vn) -> match strMapGet(localCls, vn) {
                        Some(cls) -> markStrMap(clsLocal, cls.clsEntry, changed),
                        None -> (),
                    },
                    _ -> (),
                },
                _ -> (),
            }
        } else if (vd.vname == "arraySet") {
            match args {
                Cons(_, Cons(_, Cons(a2, _))) -> match a2.tnode {
                    TmVar(vn) -> match strMapGet(localCls, vn) {
                        Some(cls) -> markStrMap(clsLocal, cls.clsEntry, changed),
                        None -> (),
                    },
                    _ -> (),
                },
                _ -> (),
            }
        } else ();
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let _ = propagateLocalInTerm(prog, a, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        if (vd.vname == "cellNew") true
        else if (vd.vname == "arrayGet" || vd.vname == "gcHandleGet") {
            isTypeNonSendInDump(prog, adtLocal, schemeBody(tm.tscm), "local")
        } else {
            strMapContains(retLocal, vd.vname) || isTypeNonSendInDump(prog, adtLocal, schemeBody(tm.tscm), "shared")
        }
    },
    TmBin(_, l, r) -> {
        let _ = propagateLocalInTerm(prog, l, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        let _ = propagateLocalInTerm(prog, r, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        false
    },
    TmUn(_, e1) -> {
        let _ = propagateLocalInTerm(prog, e1, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        false
    },
    TmLet(vd, e1, e2) -> {
        let v1Local = propagateLocalInTerm(prog, e1, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        if (v1Local || isTypeNonSendInDump(prog, adtLocal, schemeBody(vd.vscm), "shared")) {
            strMapInsert(nonSendVars, vd.vname, true)
        } else ();
        propagateLocalInTerm(prog, e2, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed)
    },
    TmIf(c, t, e) -> {
        let _ = propagateLocalInTerm(prog, c, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        let tLoc = propagateLocalInTerm(prog, t, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        let eLoc = propagateLocalInTerm(prog, e, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        tLoc || eLoc
    },
    TmWhile(c, b) -> {
        let _ = propagateLocalInTerm(prog, c, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        let _ = propagateLocalInTerm(prog, b, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        false
    },
    TmMatch(s, arms) -> {
        let sLoc = propagateLocalInTerm(prog, s, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        let anyArmLoc = cellNew(false);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arm, r) -> {
                    bindPatNonSendVars(adtLocal, arm.caPat, sLoc, nonSendVars);
                    match arm.caGuard {
                        Some(g) -> {
                            let _ = propagateLocalInTerm(prog, g, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
                            ()
                        },
                        None -> (),
                    };
                    if (propagateLocalInTerm(prog, arm.caBody, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed)) {
                        cellSet(anyArmLoc, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(anyArmLoc)
    },
    TmMakeData(adtName, _, args, _, targs) -> {
        let mangled = mangleCoreAdt(adtName, targs);
        let anyArgLoc = cellNew(false);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    if (propagateLocalInTerm(prog, a, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed)) {
                        cellSet(anyArgLoc, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let hardNonSend = adtHasIntrinsicNonSend(prog, strMapNew(), adtName, targs, strMapNew());
        if (!hardNonSend && strMapContains(cellGet(gTmpAdtReqShared), mangled)) {
            if (cellGet(anyArgLoc)) {
                markStrMap(cellGet(gTmpAdtDualMode), mangled, changed)
            } else ();
            cellGet(anyArgLoc)
        } else {
            if (cellGet(anyArgLoc) || adtHasIntrinsicNonSend(prog, adtLocal, adtName, targs, strMapNew())) {
                markStrMap(adtLocal, mangled, changed)
            } else ();
            strMapContains(adtLocal, mangled) || cellGet(anyArgLoc)
        }
    },
    TmGetTag(e1) -> {
        let _ = propagateLocalInTerm(prog, e1, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs, clsLocal, retLocal, adtLocal, changed);
        false
    },
}

def analyzeCoreModes(
    prog: CoreProgram,
    activeFnNames: List String,
    globTypes: StrMap Type,
    fnGlobs: StrMap (List GlobalValDef),
    paramShared: StrMap Bool,
    fvNonSend: StrMap Bool,
    clsLocal: StrMap Bool,
    retLocal: StrMap Bool,
    adtLocal: StrMap Bool,
    adtDualMode: StrMap Bool,
    fnLocalVars: StrMap Bool
): Void = {
    let clsReqShared: StrMap Bool = strMapNew();
    let retReqShared: StrMap Bool = strMapNew();
    let adtReqShared: StrMap Bool = strMapNew();
    cellSet(gTmpAdtReqShared, adtReqShared);
    cellSet(gTmpAdtDualMode, adtDualMode);

    // Pass 1: Backward demand from `__concTaskSpawn`
    let changed1 = cellNew(true);
    while (cellGet(changed1)) {
        cellSet(changed1, false);
        let cf = cellNew(activeFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            let paramSet: StrMap Bool = strMapNew();
                            let cp = cellNew(fd.fnParams);
                            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                match cellGet(cp) {
                                    Cons(pvd, pr) -> {
                                        strMapInsert(paramSet, pvd.vname, true);
                                        cellSet(cp, pr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let cfv = cellNew(fd.fnFvs);
                            while (match cellGet(cfv) { Nil -> false, _ -> true }) {
                                match cellGet(cfv) {
                                    Cons(fvd, fr) -> {
                                        strMapInsert(paramSet, fvd.vname, true);
                                        cellSet(cfv, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let letRhs: StrMap TaggedTerm = strMapNew();
                            let localCls: StrMap ClosureSpec = strMapNew();
                            collectBodyBindings(fd.fnBody, letRhs, localCls);
                            scanSendDemandsInTerm(
                                prog, fnName, fd.fnBody, paramSet, letRhs, localCls,
                                paramShared, clsReqShared, retReqShared, adtReqShared, changed1
                            );
                            if (strMapContains(retReqShared, fnName)) {
                                markTypeAdtsShared(prog, schemeBody(fd.fnBody.tscm), adtReqShared, strMapNew(), changed1);
                                let vset: StrMap Bool = strMapNew();
                                requireTermSend(
                                    fnName, fd.fnBody, paramSet, letRhs, localCls, vset,
                                    paramShared, clsReqShared, retReqShared, changed1
                                )
                            } else ()
                        },
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    };

    // Pass 2: Forward propagation of `local` (`!Send`) captures & return values
    let changed2 = cellNew(true);
    while (cellGet(changed2)) {
        cellSet(changed2, false);
        let cg = cellNew(prog.coreGlobals);
        while (match cellGet(cg) { Nil -> false, _ -> true }) {
            match cellGet(cg) {
                Cons(g, gr) -> {
                    let gVars: StrMap Bool = strMapNew();
                    let gCls: StrMap ClosureSpec = strMapNew();
                    let _ = propagateLocalInTerm(
                        prog, g.gvInit, gVars, gCls, fvNonSend, globTypes, fnGlobs,
                        clsLocal, retLocal, adtLocal, changed2
                    );
                    cellSet(cg, gr)
                },
                Nil -> (),
            }
        };
        let cf = cellNew(activeFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            let nonSendVars: StrMap Bool = strMapNew();
                            let localCls: StrMap ClosureSpec = strMapNew();
                            let cp = cellNew(fd.fnParams);
                            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                match cellGet(cp) {
                                    Cons(pvd, pr) -> {
                                        let pMode = if (strMapContains(paramShared, fnName + ":" + pvd.vname)) "shared" else "local";
                                        if (isTypeNonSendInDump(prog, adtLocal, schemeBody(pvd.vscm), pMode)) {
                                            strMapInsert(nonSendVars, pvd.vname, true)
                                        } else ();
                                        cellSet(cp, pr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let cfv = cellNew(fd.fnFvs);
                            while (match cellGet(cfv) { Nil -> false, _ -> true }) {
                                match cellGet(cfv) {
                                    Cons(fvd, fr) -> {
                                        if (strMapContains(fvNonSend, fnName + ":" + fvd.vname)
                                            || isTypeNonSendInDump(prog, adtLocal, schemeBody(fvd.vscm), "shared")) {
                                            strMapInsert(nonSendVars, fvd.vname, true)
                                        } else ();
                                        cellSet(cfv, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let bodyLoc = propagateLocalInTerm(
                                prog, fd.fnBody, nonSendVars, localCls, fvNonSend, globTypes, fnGlobs,
                                clsLocal, retLocal, adtLocal, changed2
                            );
                            if (bodyLoc) {
                                markStrMap(retLocal, fnName, changed2)
                            } else ();
                            let boundRev: Cell (List String) = cellNew(Nil);
                            let cp2 = cellNew(fd.fnParams);
                            while (match cellGet(cp2) { Nil -> false, _ -> true }) {
                                match cellGet(cp2) {
                                    Cons(pvd, pr) -> {
                                        cellSet(boundRev, Cons(pvd.vname, cellGet(boundRev)));
                                        cellSet(cp2, pr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let cfv2 = cellNew(fd.fnFvs);
                            while (match cellGet(cfv2) { Nil -> false, _ -> true }) {
                                match cellGet(cfv2) {
                                    Cons(fvd, fr) -> {
                                        cellSet(boundRev, Cons(fvd.vname, cellGet(boundRev)));
                                        cellSet(cfv2, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            collectTermBoundNames(fd.fnBody, boundRev);
                            let cb = cellNew(cellGet(boundRev));
                            while (match cellGet(cb) { Nil -> false, _ -> true }) {
                                match cellGet(cb) {
                                    Cons(vn, br) -> {
                                        if (strMapContains(nonSendVars, vn)) {
                                            strMapInsert(fnLocalVars, fnName + ":" + vn, true)
                                        } else ();
                                        cellSet(cb, br)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    }
}

// ============================================================================
// Core Type, Pattern, and Term S-Expression Serialization
// ============================================================================

def isInstAdtLocal(ctx: DumpCtx, baseName: String, targs: List Type, mangled: String): Bool =
    strMapContains(ctx.dcAdtLocal, mangled)
    || strMapContains(ctx.dcAdtLocal, baseName)
    || adtHasIntrinsicNonSend(ctx.dcProg, ctx.dcAdtLocal, baseName, targs, strMapNew())

def registerCoreAdtMode(ctx: DumpCtx, baseName: String, targs: List Type, reqMode: String): String = {
    let baseMangled = mangleCoreAdt(baseName, targs);
    let useLocalClone = reqMode == "local" && strMapContains(ctx.dcAdtDualMode, baseMangled);
    let mangled = if (useLocalClone) baseMangled + "$local" else baseMangled;
    let fMode = if (useLocalClone || isInstAdtLocal(ctx, baseName, targs, baseMangled)) "local" else "shared";
    if (!strMapContains(ctx.dcInstAdts, mangled)) {
        strMapInsert(ctx.dcInstAdts, mangled, (baseName, targs, fMode));
        cellSet(ctx.dcInstAdtOrder, Cons(mangled, cellGet(ctx.dcInstAdtOrder)));
        match strMapGet(ctx.dcProg.coreAdtReg, baseName) {
            Some(ainfo) -> {
                let sub = buildPairMap(ainfo.typeParams, targs);
                let cv = cellNew(ainfo.variants);
                while (match cellGet(cv) { Nil -> false, _ -> true }) {
                    match cellGet(cv) {
                        Cons(vi, r) -> {
                            let cf = cellNew(vi.fieldTypes);
                            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                match cellGet(cf) {
                                    Cons(ft, fr) -> {
                                        let instFt = applyExplicitSubst(ft, sub);
                                        let tmp = bufNew();
                                        emitCoreTyWithMode(ctx, tmp, instFt, fMode);
                                        cellSet(cf, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            cellSet(cv, r)
                        },
                        Nil -> (),
                    }
                }
            },
            None -> setDumpErr(ctx, "Unknown ADT '" + baseName + "'"),
        }
    } else ();
    mangled
}

def registerCoreAdt(ctx: DumpCtx, baseName: String, targs: List Type): String =
    registerCoreAdtMode(ctx, baseName, targs, "shared")

def isDumpTermLocal(ctx: DumpCtx, fnName: String, tm: TaggedTerm): Bool = match tm.tnode {
    TmVar(x) -> strMapContains(ctx.dcFnLocalVars, fnName + ":" + x),
    TmGlobalVar(g) -> match strMapGet(ctx.dcGlobTypes, g) {
        Some(gty) -> isTypeNonSendInDump(ctx.dcProg, ctx.dcAdtLocal, gty, "local"),
        None -> true,
    },
    TmMakeCls(_, _, body) -> isDumpTermLocal(ctx, fnName, body),
    TmLet(_, _, e2) -> isDumpTermLocal(ctx, fnName, e2),
    TmBlock(es) -> match listRev(es) {
        Cons(lastTm, _) -> isDumpTermLocal(ctx, fnName, lastTm),
        Nil -> false,
    },
    TmIf(_, t, e) -> isDumpTermLocal(ctx, fnName, t) || isDumpTermLocal(ctx, fnName, e),
    TmMatch(_, arms) -> {
        let hit = cellNew(false);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    if (isDumpTermLocal(ctx, fnName, a.caBody)) cellSet(hit, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(hit)
    },
    TmMakeData(adtName, _, args, _, targs) -> {
        let hit = cellNew(isInstAdtLocal(ctx, adtName, targs, mangleCoreAdt(adtName, targs)));
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    if (isDumpTermLocal(ctx, fnName, a)) cellSet(hit, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(hit)
    },
    TmApplyDir(vd, _) -> vd.vname == "cellNew" || strMapContains(ctx.dcRetLocal, vd.vname),
    _ -> false,
}

def emitCoreTyWithMode(ctx: DumpCtx, b: StringBuf, ty: Type, fnMode: String): Void = match ty {
    TyVoid -> bufPushStr(b, "void"),
    TyCon(n) ->
        if (n == "Void") bufPushStr(b, "void")
        else if (n == "Int") bufPushStr(b, "int")
        else if (n == "Int64") bufPushStr(b, "int64")
        else if (n == "Float") bufPushStr(b, "float")
        else if (n == "Float32") bufPushStr(b, "float32")
        else if (n == "Bool") bufPushStr(b, "bool")
        else if (n == "Char") bufPushStr(b, "char")
        else if (n == "String") bufPushStr(b, "str")
        else if (n == "Ptr") bufPushStr(b, "ptr")
        else if (n == "ScopedPtr") bufPushStr(b, "scoped-ptr")
        else if (n == "Arena") bufPushStr(b, "arena")
        else if (n == "ForeignPtr") bufPushStr(b, "foreign-ptr")
        else if (n == "AtomicInt") bufPushStr(b, "atomic-int")
        else if (strMapContains(ctx.dcProg.coreAdtReg, n)) {
            let m = registerCoreAdtMode(ctx, n, Nil, fnMode);
            bufPushStr(b, "(adt ");
            pushQuotedStr(b, m);
            bufPushByte(b, 41)
        } else {
            setDumpErr(ctx, "Type '" + n + "' is outside the Core Geisha subset");
            bufPushStr(b, "void")
        },
    TyTuple(es) -> {
        bufPushStr(b, "(tuple");
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTyWithMode(ctx, b, t, fnMode);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TyArr(_, ps, ret) -> {
        bufPushStr(b, "(fn ");
        bufPushStr(b, fnMode);
        bufPushStr(b, " (");
        let first = cellNew(true);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    if (!cellGet(first)) bufPushByte(b, 32) else cellSet(first, false);
                    emitCoreTyWithMode(ctx, b, p, fnMode);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushStr(b, ") ");
        emitCoreTyWithMode(ctx, b, ret, fnMode);
        bufPushByte(b, 41)
    },
    TyComp(_, _) -> {
        let base = compBaseName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Cell") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(cell ");
                    emitCoreTyWithMode(ctx, b, elemTy, "local");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Cell type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "MutArray") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(mut-array ");
                    emitCoreTyWithMode(ctx, b, elemTy, "local");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid MutArray type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "ImmArray") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(imm-array ");
                    emitCoreTyWithMode(ctx, b, elemTy, fnMode);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid ImmArray type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "Task") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(task ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Task type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "MVar") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(mvar ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid MVar type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "Chan") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(chan ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Chan type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "Actor") {
            match targs {
                Cons(stateTy, Nil) -> {
                    bufPushStr(b, "(actor ");
                    emitCoreTyWithMode(ctx, b, stateTy, "local");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Actor type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (strMapContains(ctx.dcProg.coreAdtReg, base)) {
            let m = registerCoreAdtMode(ctx, base, targs, fnMode);
            bufPushStr(b, "(adt ");
            pushQuotedStr(b, m);
            bufPushByte(b, 41)
        } else {
            setDumpErr(ctx, "Parameterized type '" + base + "' is outside the Core Geisha subset");
            bufPushStr(b, "void")
        }
    },
    TyVar(v) -> {
        setDumpErr(ctx, "Unmonomorphized type variable '" + v + "' in Core IR");
        bufPushStr(b, "void")
    },
}

def emitCoreLit(ctx: DumpCtx, b: StringBuf, l: Lit, expectedTy: Type): Void = match l {
    LitInt(n) -> match expectedTy {
        TyCon("Int64") -> {
            bufPushStr(b, "(lit-int64 ");
            bufPushStr(b, i64ToStr(intToI64(n)));
            bufPushByte(b, 41)
        },
        _ -> {
            bufPushStr(b, "(lit-int ");
            bufPushStr(b, intToStr(n));
            bufPushByte(b, 41)
        },
    },
    LitBool(v) ->
        if (v) bufPushStr(b, "(lit-bool true)")
        else bufPushStr(b, "(lit-bool false)"),
    LitStr(s) -> {
        bufPushStr(b, "(lit-str ");
        pushQuotedStr(b, s);
        bufPushByte(b, 41)
    },
    LitUnit -> bufPushStr(b, "(lit-unit)"),
    LitFloat(f) -> {
        let _ = ctx;
        bufPushStr(b, "(lit-float-bits ");
        bufPushStr(b, i64ToStr(floatToBits64(f)));
        bufPushByte(b, 41)
    },
    LitChar(c) -> {
        bufPushStr(b, "(lit-char ");
        bufPushStr(b, intToStr(c & 255));
        bufPushByte(b, 41)
    },
}

def emitCorePatMode(ctx: DumpCtx, b: StringBuf, pat: Pattern, scrutTy: Type, scrutMode: String): Void = match pat {
    PatWild -> bufPushStr(b, "wild"),
    PatVar(x) -> {
        bufPushStr(b, "(pvar ");
        pushQuotedStr(b, x);
        bufPushByte(b, 41)
    },
    PatLit(l) -> {
        bufPushStr(b, "(plit ");
        emitCoreLit(ctx, b, l, scrutTy);
        bufPushByte(b, 41)
    },
    PatTuple(ps) -> {
        bufPushStr(b, "(ptuple");
        let elemTys = match scrutTy {
            TyTuple(ts) -> ts,
            _ -> Nil,
        };
        let cp = cellNew(ps);
        let ct = cellNew(elemTys);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(p, pr) -> {
                    let et = match cellGet(ct) {
                        Cons(t, tr) -> { cellSet(ct, tr); t },
                        Nil -> TyVoid,
                    };
                    bufPushByte(b, 32);
                    emitCorePatMode(ctx, b, p, et, scrutMode);
                    cellSet(cp, pr)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    PatCtor(cname, ps) -> {
        let baseName = compBaseName(scrutTy);
        let targs = extractTypeArgs(scrutTy);
        let mangled = registerCoreAdtMode(ctx, baseName, targs, scrutMode);
        match strMapGet(ctx.dcProg.coreAdtReg, baseName) {
            Some(ainfo) -> match findVariantByName(ainfo.variants, cname) {
                Some(vi) -> {
                    let sub = buildPairMap(ainfo.typeParams, targs);
                    let rev = cellNew(Nil);
                    let cf = cellNew(vi.fieldTypes);
                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                        match cellGet(cf) {
                            Cons(ft, fr) -> {
                                cellSet(rev, Cons(applyExplicitSubst(ft, sub), cellGet(rev)));
                                cellSet(cf, fr)
                            },
                            Nil -> (),
                        }
                    };
                    let fldTys = listRev(cellGet(rev));
                    bufPushStr(b, "(pctor ");
                    pushQuotedStr(b, mangled);
                    bufPushByte(b, 32);
                    bufPushStr(b, intToStr(vi.tag));
                    let cp = cellNew(ps);
                    let ct = cellNew(fldTys);
                    while (match cellGet(cp) { Nil -> false, _ -> true }) {
                        match cellGet(cp) {
                            Cons(p, pr) -> {
                                let ft = match cellGet(ct) {
                                    Cons(t, tr) -> { cellSet(ct, tr); t },
                                    Nil -> TyVoid,
                                };
                                bufPushByte(b, 32);
                                emitCorePatMode(ctx, b, p, ft, scrutMode);
                                cellSet(cp, pr)
                            },
                            Nil -> (),
                        }
                    };
                    bufPushByte(b, 41)
                },
                None -> {
                    setDumpErr(ctx, "Unknown constructor pattern '" + cname + "'");
                    bufPushStr(b, "wild")
                },
            },
            None -> {
                setDumpErr(ctx, "Unknown ADT '" + baseName + "' in constructor pattern");
                bufPushStr(b, "wild")
            },
        }
    },
    PatStruct(cname, _) -> {
        setDumpErr(ctx, "Unnormalized struct pattern '" + cname + "' in Core IR");
        bufPushStr(b, "wild")
    },
}

def emitCorePat(ctx: DumpCtx, b: StringBuf, pat: Pattern, scrutTy: Type): Void =
    emitCorePatMode(ctx, b, pat, scrutTy, "shared")

def binOpCoreName(op: BinOp, lhsTy: Type): Option String = {
    let tyName = match lhsTy { TyCon(n) -> n, _ -> "" };
    match op {
        OpAdd ->
            if (tyName == "String") Some("strConcat")
            else if (tyName == "Int") Some("add")
            else if (tyName == "Int64") Some("add64")
            else if (tyName == "Float") Some("addFloat")
            else if (tyName == "Float32") Some("addF32")
            else None,
        OpSub ->
            if (tyName == "Int") Some("sub")
            else if (tyName == "Int64") Some("sub64")
            else if (tyName == "Float") Some("subFloat")
            else if (tyName == "Float32") Some("subF32")
            else None,
        OpMul ->
            if (tyName == "Int") Some("mul")
            else if (tyName == "Int64") Some("mul64")
            else if (tyName == "Float") Some("mulFloat")
            else if (tyName == "Float32") Some("mulF32")
            else None,
        OpDiv ->
            if (tyName == "Int") Some("div")
            else if (tyName == "Int64") Some("div64")
            else if (tyName == "Float") Some("divFloat")
            else if (tyName == "Float32") Some("divF32")
            else None,
        OpRem ->
            if (tyName == "Int") Some("rem")
            else if (tyName == "Int64") Some("rem64")
            else None,
        OpBitAnd ->
            if (tyName == "Int") Some("bitAnd")
            else if (tyName == "Int64") Some("bitAnd64")
            else if (tyName == "Bool") Some("bitAndBool")
            else None,
        OpBitOr ->
            if (tyName == "Int") Some("bitOr")
            else if (tyName == "Int64") Some("bitOr64")
            else if (tyName == "Bool") Some("bitOrBool")
            else None,
        OpBitXor ->
            if (tyName == "Int") Some("bitXor")
            else if (tyName == "Int64") Some("bitXor64")
            else if (tyName == "Bool") Some("bitXorBool")
            else None,
        OpShl ->
            if (tyName == "Int") Some("shlInt")
            else if (tyName == "Int64") Some("shl64")
            else None,
        OpShr ->
            if (tyName == "Int") Some("shrInt")
            else if (tyName == "Int64") Some("shr64")
            else None,
        OpUshr ->
            if (tyName == "Int") Some("ushrInt")
            else if (tyName == "Int64") Some("ushr64")
            else None,
        OpAnd -> Some("and"),
        OpOr -> Some("or"),
        OpEq ->
            if (tyName == "Int") Some("eqInt")
            else if (tyName == "Int64") Some("eq64")
            else if (tyName == "Float") Some("eqFloat")
            else if (tyName == "Float32") Some("eqF32")
            else if (tyName == "Bool") Some("eqBool")
            else if (tyName == "Char") Some("eqChar")
            else if (tyName == "String") Some("eqStr")
            else None,
        OpNe ->
            if (tyName == "Int") Some("neInt")
            else if (tyName == "Int64") Some("ne64")
            else if (tyName == "Float") Some("neFloat")
            else if (tyName == "Float32") Some("neF32")
            else if (tyName == "Bool") Some("neBool")
            else if (tyName == "Char") Some("neChar")
            else if (tyName == "String") Some("neStr")
            else None,
        OpLt ->
            if (tyName == "Int") Some("ltInt")
            else if (tyName == "Int64") Some("lt64")
            else if (tyName == "Float") Some("ltFloat")
            else if (tyName == "Float32") Some("ltF32")
            else if (tyName == "Char") Some("ltChar")
            else if (tyName == "String") Some("ltStr")
            else None,
        OpLe ->
            if (tyName == "Int") Some("leInt")
            else if (tyName == "Int64") Some("le64")
            else if (tyName == "Float") Some("leFloat")
            else if (tyName == "Float32") Some("leF32")
            else if (tyName == "Char") Some("leChar")
            else if (tyName == "String") Some("leStr")
            else None,
        OpGt ->
            if (tyName == "Int") Some("gtInt")
            else if (tyName == "Int64") Some("gt64")
            else if (tyName == "Float") Some("gtFloat")
            else if (tyName == "Float32") Some("gtF32")
            else if (tyName == "Char") Some("gtChar")
            else if (tyName == "String") Some("gtStr")
            else None,
        OpGe ->
            if (tyName == "Int") Some("geInt")
            else if (tyName == "Int64") Some("ge64")
            else if (tyName == "Float") Some("geFloat")
            else if (tyName == "Float32") Some("geF32")
            else if (tyName == "Char") Some("geChar")
            else if (tyName == "String") Some("geStr")
            else None,
    }
}

def isKnownCoreIntrinsic(name: String): Bool =
    name == "printLn" || name == "putNumber" || name == "putFloat" || name == "putF32" || name == "putChar"
    || name == "arrayNew" || name == "arrayNewZeroed" || name == "arrayLen" || name == "arrayGet"
    || name == "arraySet" || name == "arrayClearSlot" || name == "arrayFreeze"
    || name == "immArrayLen" || name == "immArrayGet" || name == "parTabulate"
    || name == "bitAnd" || name == "bitOr" || name == "bitXor" || name == "bitNot"
    || name == "bitShl" || name == "bitShr" || name == "bitUshr"
    || name == "bitAnd64" || name == "bitOr64" || name == "bitXor64" || name == "bitNot64"
    || name == "bitShl64" || name == "bitShr64" || name == "bitUshr64"
    || name == "bitPopCount" || name == "bitPopCount64" || name == "bitCtz"
    || name == "charToInt" || name == "intToChar" || name == "intToI64" || name == "i64ToInt"
    || name == "floatToBits64" || name == "bits64ToFloat" || name == "floatToBits32" || name == "bits32ToFloat"
    || name == "intToFloat" || name == "floatToInt" || name == "floatToF32" || name == "f32ToFloat"
    || name == "intToF32" || name == "f32ToInt" || name == "f32ToBits32" || name == "bits32ToF32"
    || name == "mathExp" || name == "mathLog" || name == "mathSqrt" || name == "mathSin"
    || name == "mathCos" || name == "mathTanh" || name == "mathPow" || name == "mathAbs"
    || name == "mathFloor" || name == "mathCeil" || name == "mathFma"
    || name == "mathExpF32" || name == "mathLogF32" || name == "mathSqrtF32" || name == "mathSinF32"
    || name == "mathCosF32" || name == "mathTanhF32" || name == "mathPowF32" || name == "mathAbsF32"
    || name == "mathFloorF32" || name == "mathCeilF32" || name == "mathFmaF32"
    || name == "strLen" || name == "strByteAt" || name == "strSlice" || name == "strConcat" || name == "strFromBytes"
    || name == "ptrNull" || name == "ptrIsNull" || name == "ptrOffset" || name == "ptrOffset64"
    || name == "ptrAllocBytes" || name == "ptrByteAt" || name == "ptrSetByte" || name == "ptrReadI8"
    || name == "ptrReadU16Le" || name == "ptrReadU32Le" || name == "ptrReadI64Le"
    || name == "ptrReadF32Le" || name == "ptrReadF64Le"
    || name == "ptrWriteU16Le" || name == "ptrWriteU32Le" || name == "ptrWriteI64Le"
    || name == "ptrWriteF32Le" || name == "ptrWriteF64Le"
    || name == "ptrAllocBytes64" || name == "ptrReadI64Le64" || name == "ptrWriteI64Le64"
    || name == "ptrReadF32Le64" || name == "ptrWriteF32Le64" || name == "ptrReadF64Le64" || name == "ptrWriteF64Le64"
    || name == "ptrCopyBytes" || name == "ptrCopyBytes64" || name == "ptrCopyFromStr"
    || name == "ptrSliceFromStr" || name == "ptrSliceToString" || name == "ptrToString"
    || name == "foreignPtrAlloc" || name == "foreignPtrNew" || name == "cFnPtr"
    || name == "withForeignPtr" || name == "withAlloca" || name == "withArena" || name == "arenaAlloc"
    || name == "scopedPtrOffset" || name == "scopedPtrOffset64" || name == "scopedPtrByteAt" || name == "scopedPtrSetByte"
    || name == "scopedPtrReadI32Le" || name == "scopedPtrWriteI32Le"
    || name == "scopedPtrReadI64Le" || name == "scopedPtrWriteI64Le"
    || name == "scopedPtrReadF32Le" || name == "scopedPtrWriteF32Le"
    || name == "scopedPtrReadF32Le64" || name == "scopedPtrWriteF32Le64"
    || name == "scopedPtrReadF64Le" || name == "scopedPtrWriteF64Le"
    || name == "scopedPtrReadF64Le64" || name == "scopedPtrWriteF64Le64"
    || name == "scopedPtrCopyBytes"
    || name == "gcHandleNew" || name == "gcHandleGet" || name == "gcHandleFree"
    || name == "__blackBox"
    || name == "__gs_contract_fail"
    || name == "__gs_requires" || name == "__gs_ensures" || name == "__gs_invariant" || name == "__gs_decreases"
    || name == "assert" || name == "assume"
    || name == "gcTrim" || name == "gcSetThresholds" || name == "gcHeapLiveBytes" || name == "gcExternalLiveBytes"
    || name == "sysArgc" || name == "sysArgv"
    || name == "__concAtomicNew" || name == "__concAtomicLoad" || name == "__concAtomicStore"
    || name == "__concAtomicAdd" || name == "__concAtomicCas"
    || name == "__concMVarRead" || name == "__concMVarTryTake"
    || name == "__concChanRecv" || name == "__concChanTryRecv" || name == "__concChanIsClosed"
    || name == "__concTaskIsReady" || name == "__concTaskWaitAny"
    || name == "__concNumCpu" || name == "__concSleepMs" || name == "__concActorStop"

def getOrRegisterCoreExtern(
    ctx: DumpCtx,
    rawName: String,
    args: List TaggedTerm,
    retTy: Type
): String = {
    if (!strMapContains(ctx.dcProg.coreExterns, rawName) && !isKnownCoreIntrinsic(rawName)) {
        setDumpErr(ctx, "Unhandled compiler intrinsic '" + rawName + "' in --dump-core (not in coreExterns or audited prelude allowlist)")
    } else ();
    let paramTysRev: Cell (List String) = cellNew(Nil);
    let sigBuf = bufNew();
    bufPushStr(sigBuf, rawName);
    bufPushByte(sigBuf, 124);
    let idx = cellNew(0);
    let cur = cellNew(args);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                let i = cellGet(idx);
                if (i > 0) bufPushByte(sigBuf, 44) else ();
                let argMode = if (rawName == "parTabulate" && i == 1) "shared" else "local";
                let actualArgTy =
                    if (rawName == "cFnPtr") match a.tnode {
                        TmLit(LitStr(_)) -> TyCon("String"),
                        _ -> schemeBody(a.tscm),
                    } else schemeBody(a.tscm);
                let ab = bufNew();
                emitCoreTyWithMode(ctx, ab, actualArgTy, argMode);
                let atStr = bufToString(ab);
                bufPushStr(sigBuf, atStr);
                cellSet(paramTysRev, Cons(atStr, cellGet(paramTysRev)));
                cellSet(idx, i + 1);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    bufPushStr(sigBuf, "->");
    let retMode = if (rawName == "arrayGet" || rawName == "gcHandleGet") "local" else "shared";
    let rb = bufNew();
    emitCoreTyWithMode(ctx, rb, retTy, retMode);
    let retStr = bufToString(rb);
    bufPushStr(sigBuf, retStr);
    let sigKey = bufToString(sigBuf);
    match strMapGet(ctx.dcExternMap, sigKey) {
        Some(existing) -> existing,
        None -> {
            let chosen =
                if (!strMapContains(ctx.dcUsedFnNames, rawName)) rawName
                else {
                    let k = cellNew(1);
                    let cand = cellNew(rawName + "$1");
                    while (strMapContains(ctx.dcUsedFnNames, cellGet(cand))) {
                        let nextK = cellGet(k) + 1;
                        cellSet(k, nextK);
                        cellSet(cand, rawName + "$" + intToStr(nextK))
                    };
                    cellGet(cand)
                };
            strMapInsert(ctx.dcUsedFnNames, chosen, true);
            strMapInsert(ctx.dcExternMap, sigKey, chosen);
            strMapInsert(ctx.dcExternDefs, chosen, (listRev(cellGet(paramTysRev)), retStr));
            cellSet(ctx.dcExternOrder, Cons(chosen, cellGet(ctx.dcExternOrder)));
            chosen
        },
    }
}

def isIrrefutableDumpPat(pat: Pattern): Bool = match pat {
    PatWild -> true,
    PatVar(_) -> true,
    PatTuple(ps) -> {
        let ok = cellNew(true);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    if (!isIrrefutableDumpPat(p)) cellSet(ok, false) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(ok)
    },
    _ -> false,
}

def armsHasGuard(arms: List CoreArm): Bool = {
    let hit = cellNew(false);
    let cur = cellNew(arms);
    while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                match a.caGuard {
                    Some(_) -> cellSet(hit, true),
                    None -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(hit)
}

def armsHasIrrefutable(arms: List CoreArm): Bool = {
    let hit = cellNew(false);
    let cur = cellNew(arms);
    while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                match a.caGuard {
                    None -> if (isIrrefutableDumpPat(a.caPat)) cellSet(hit, true) else (),
                    Some(_) -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(hit)
}

def emitGuardedMatchChain(
    ctx: DumpCtx,
    b: StringBuf,
    sv: String,
    scrutTy: Type,
    remArms: List CoreArm,
    priorUnguardedRev: List CoreArm
): Void =
    if (!armsHasGuard(remArms)) {
        bufPushStr(b, "(match (var ");
        pushQuotedStr(b, sv);
        bufPushByte(b, 41);
        let cur = cellNew(remArms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arm, r) -> {
                    bufPushStr(b, " (arm ");
                    emitCorePat(ctx, b, arm.caPat, scrutTy);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, arm.caBody);
                    bufPushByte(b, 41);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        if (!armsHasIrrefutable(remArms)) {
            let cp = cellNew(listRev(priorUnguardedRev));
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(parm, pr) -> {
                        bufPushStr(b, " (arm ");
                        emitCorePat(ctx, b, parm.caPat, scrutTy);
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, parm.caBody);
                        bufPushByte(b, 41);
                        cellSet(cp, pr)
                    },
                    Nil -> (),
                }
            }
        } else ();
        bufPushByte(b, 41)
    } else {
        match remArms {
            Cons(arm, rest) -> match arm.caGuard {
                Some(g) ->
                    if (isIrrefutableDumpPat(arm.caPat)) {
                        bufPushStr(b, "(match (var ");
                        pushQuotedStr(b, sv);
                        bufPushStr(b, ") (arm ");
                        emitCorePat(ctx, b, arm.caPat, scrutTy);
                        bufPushStr(b, " (if ");
                        emitCoreTerm(ctx, b, g);
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, arm.caBody);
                        bufPushByte(b, 32);
                        emitGuardedMatchChain(ctx, b, sv, scrutTy, rest, priorUnguardedRev);
                        bufPushStr(b, ")))")
                    } else {
                        bufPushStr(b, "(match (var ");
                        pushQuotedStr(b, sv);
                        bufPushStr(b, ") (arm ");
                        emitCorePat(ctx, b, arm.caPat, scrutTy);
                        bufPushStr(b, " (if ");
                        emitCoreTerm(ctx, b, g);
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, arm.caBody);
                        bufPushByte(b, 32);
                        emitGuardedMatchChain(ctx, b, sv, scrutTy, rest, priorUnguardedRev);
                        bufPushStr(b, ")) (arm wild ");
                        emitGuardedMatchChain(ctx, b, sv, scrutTy, rest, priorUnguardedRev);
                        bufPushStr(b, "))")
                    },
                None ->
                    if (isIrrefutableDumpPat(arm.caPat)) {
                        bufPushStr(b, "(match (var ");
                        pushQuotedStr(b, sv);
                        bufPushStr(b, ") (arm ");
                        emitCorePat(ctx, b, arm.caPat, scrutTy);
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, arm.caBody);
                        bufPushStr(b, "))")
                    } else {
                        bufPushStr(b, "(match (var ");
                        pushQuotedStr(b, sv);
                        bufPushStr(b, ") (arm ");
                        emitCorePat(ctx, b, arm.caPat, scrutTy);
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, arm.caBody);
                        bufPushStr(b, ") (arm wild ");
                        emitGuardedMatchChain(ctx, b, sv, scrutTy, rest, Cons(arm, priorUnguardedRev));
                        bufPushStr(b, "))")
                    },
            },
            Nil -> bufPushStr(b, "(lit-unit)"),
        }
    }

def emitParamList(ctx: DumpCtx, b: StringBuf, fnName: String, params: List VarDecl): Void = {
    bufPushByte(b, 40);
    let first = cellNew(true);
    let cur = cellNew(params);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(vd, r) -> {
                if (!cellGet(first)) bufPushByte(b, 32) else cellSet(first, false);
                let pMode = if (strMapContains(ctx.dcParamShared, fnName + ":" + vd.vname)) "shared" else "local";
                bufPushByte(b, 40);
                pushQuotedStr(b, vd.vname);
                bufPushByte(b, 32);
                emitCoreTyWithMode(ctx, b, schemeBody(vd.vscm), pMode);
                bufPushByte(b, 41);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(b, 41)
}

def emitRecClsSelfLam(
    ctx: DumpCtx,
    b: StringBuf,
    fd: FunDef,
    clsMode: String,
    rMode: String,
    retTy: Type,
    otherFvs: List VarDecl,
    extraGlobs: List GlobalValDef
): Void = {
    bufPushStr(b, "(lam ");
    bufPushStr(b, clsMode);
    bufPushByte(b, 32);
    emitParamList(ctx, b, fd.fnName, fd.fnParams);
    bufPushByte(b, 32);
    emitCoreTyWithMode(ctx, b, retTy, rMode);
    bufPushStr(b, " (apply-dir ");
    pushQuotedStr(b, fd.fnName);
    let cp = cellNew(fd.fnParams);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(pvd, pr) -> {
                bufPushStr(b, " (var ");
                pushQuotedStr(b, pvd.vname);
                bufPushByte(b, 41);
                cellSet(cp, pr)
            },
            Nil -> (),
        }
    };
    let cf = cellNew(otherFvs);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fvd, fr) -> {
                bufPushStr(b, " (var ");
                pushQuotedStr(b, fvd.vname);
                bufPushByte(b, 41);
                cellSet(cf, fr)
            },
            Nil -> (),
        }
    };
    let cg = cellNew(extraGlobs);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(g, gr) -> {
                bufPushStr(b, " (var ");
                pushQuotedStr(b, "__glob$" + g.gvName);
                bufPushByte(b, 41);
                cellSet(cg, gr)
            },
            Nil -> (),
        }
    };
    bufPushStr(b, "))")
}

def emitCoreTerm(ctx: DumpCtx, b: StringBuf, tm: TaggedTerm): Void = match tm.tnode {
    TmLit(l) -> emitCoreLit(ctx, b, l, schemeBody(tm.tscm)),
    TmVar(x) -> {
        bufPushStr(b, "(var ");
        pushQuotedStr(b, x);
        bufPushByte(b, 41)
    },
    TmGlobalVar(g) -> {
        bufPushStr(b, "(var ");
        pushQuotedStr(b, "__glob$" + g);
        bufPushByte(b, 41)
    },
    TmTuple(es) -> {
        bufPushStr(b, "(tuple");
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, e);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmBlock(es) -> {
        bufPushStr(b, "(block");
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, e);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmMakeCls(vd, cls, body) -> {
        match strMapGet(ctx.dcProg.coreFns, cls.clsEntry) {
            Some(fd) -> {
                let retTy = match schemeBody(fd.fnScm) {
                    TyArr(_, _, r) -> r,
                    other -> other,
                };
                let clsMode = if (strMapContains(ctx.dcClsLocal, cls.clsEntry)) "local" else "shared";
                let rMode = if (strMapContains(ctx.dcRetLocal, fd.fnName)) "local" else "shared";
                if (!listContainsStrDump(cls.clsFvs, vd.vname)) {
                    bufPushStr(b, "(let ");
                    pushQuotedStr(b, vd.vname);
                    bufPushStr(b, " (lam ");
                    bufPushStr(b, clsMode);
                    bufPushByte(b, 32);
                    emitParamList(ctx, b, fd.fnName, fd.fnParams);
                    bufPushByte(b, 32);
                    emitCoreTyWithMode(ctx, b, retTy, rMode);
                    bufPushByte(b, 32);
                    let prevFn = cellGet(ctx.dcCurFn);
                    cellSet(ctx.dcCurFn, fd.fnName);
                    emitCoreTerm(ctx, b, fd.fnBody);
                    cellSet(ctx.dcCurFn, prevFn);
                    bufPushStr(b, ") ");
                    emitCoreTerm(ctx, b, body);
                    bufPushByte(b, 41)
                } else {
                    let otherFvsRev: Cell (List VarDecl) = cellNew(Nil);
                    let cfv = cellNew(fd.fnFvs);
                    while (match cellGet(cfv) { Nil -> false, _ -> true }) {
                        match cellGet(cfv) {
                            Cons(fvd, fr) -> {
                                if (fvd.vname != vd.vname) {
                                    cellSet(otherFvsRev, Cons(fvd, cellGet(otherFvsRev)))
                                } else ();
                                cellSet(cfv, fr)
                            },
                            Nil -> (),
                        }
                    };
                    let otherFvs = listRev(cellGet(otherFvsRev));
                    let extraGlobs = match strMapGet(ctx.dcFnGlobs, fd.fnName) {
                        Some(gs) -> gs,
                        None -> Nil,
                    };
                    if (!strMapContains(ctx.dcEmittedRecCls, cls.clsEntry)) {
                        strMapInsert(ctx.dcEmittedRecCls, cls.clsEntry, true);
                        let rb = bufNew();
                        bufPushStr(rb, "    (fun ");
                        pushQuotedStr(rb, fd.fnName);
                        bufPushStr(rb, " (");
                        let firstP = cellNew(true);
                        let cp0 = cellNew(fd.fnParams);
                        while (match cellGet(cp0) { Nil -> false, _ -> true }) {
                            match cellGet(cp0) {
                                Cons(pvd, pr) -> {
                                    if (!cellGet(firstP)) bufPushByte(rb, 32) else cellSet(firstP, false);
                                    let pMode = if (strMapContains(ctx.dcParamShared, fd.fnName + ":" + pvd.vname)) "shared" else "local";
                                    bufPushByte(rb, 40);
                                    pushQuotedStr(rb, pvd.vname);
                                    bufPushByte(rb, 32);
                                    emitCoreTyWithMode(ctx, rb, schemeBody(pvd.vscm), pMode);
                                    bufPushByte(rb, 41);
                                    cellSet(cp0, pr)
                                },
                                Nil -> (),
                            }
                        };
                        let cf0 = cellNew(otherFvs);
                        while (match cellGet(cf0) { Nil -> false, _ -> true }) {
                            match cellGet(cf0) {
                                Cons(fvd, fr) -> {
                                    if (!cellGet(firstP)) bufPushByte(rb, 32) else cellSet(firstP, false);
                                    let fMode = if (strMapContains(ctx.dcFvNonSend, fd.fnName + ":" + fvd.vname)) "local" else "shared";
                                    bufPushByte(rb, 40);
                                    pushQuotedStr(rb, fvd.vname);
                                    bufPushByte(rb, 32);
                                    emitCoreTyWithMode(ctx, rb, schemeBody(fvd.vscm), fMode);
                                    bufPushByte(rb, 41);
                                    cellSet(cf0, fr)
                                },
                                Nil -> (),
                            }
                        };
                        let cg0 = cellNew(extraGlobs);
                        while (match cellGet(cg0) { Nil -> false, _ -> true }) {
                            match cellGet(cg0) {
                                Cons(g, gr) -> {
                                    if (!cellGet(firstP)) bufPushByte(rb, 32) else cellSet(firstP, false);
                                    bufPushByte(rb, 40);
                                    pushQuotedStr(rb, "__glob$" + g.gvName);
                                    bufPushByte(rb, 32);
                                    emitCoreTyWithMode(ctx, rb, g.gvTy, "local");
                                    bufPushByte(rb, 41);
                                    cellSet(cg0, gr)
                                },
                                Nil -> (),
                            }
                        };
                        bufPushStr(rb, ") ");
                        emitCoreTyWithMode(ctx, rb, retTy, rMode);
                        bufPushStr(rb, " (let ");
                        pushQuotedStr(rb, vd.vname);
                        bufPushByte(rb, 32);
                        emitRecClsSelfLam(ctx, rb, fd, clsMode, rMode, retTy, otherFvs, extraGlobs);
                        bufPushByte(rb, 32);
                        let prevFn = cellGet(ctx.dcCurFn);
                        cellSet(ctx.dcCurFn, fd.fnName);
                        emitCoreTerm(ctx, rb, fd.fnBody);
                        cellSet(ctx.dcCurFn, prevFn);
                        bufPushStr(rb, "))\n");
                        bufPushStr(ctx.dcRecClsBuf, bufToString(rb))
                    } else ();
                    bufPushStr(b, "(let ");
                    pushQuotedStr(b, vd.vname);
                    bufPushByte(b, 32);
                    emitRecClsSelfLam(ctx, b, fd, clsMode, rMode, retTy, otherFvs, extraGlobs);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, body);
                    bufPushByte(b, 41)
                }
            },
            None -> {
                setDumpErr(ctx, "Missing closure entry '" + cls.clsEntry + "'");
                bufPushStr(b, "(lit-unit)")
            },
        }
    },
    TmApplyCls(fnTm, args) -> {
        bufPushStr(b, "(apply ");
        emitCoreTerm(ctx, b, fnTm);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname == "cellNew") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(cell-new ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "cellNew expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "cellGet") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(cell-get ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "cellGet expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "cellSet") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(cell-set ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "cellSet expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concTaskSpawn") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(spawn ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concTaskSpawn expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concTaskAwait") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(await ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concTaskAwait expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarNew") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim mvar-new ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarNew expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarEmpty") {
            let retTy = schemeBody(tm.tscm);
            match extractTypeArgs(retTy) {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(conc-prim (mvar-empty ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushStr(b, "))")
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarEmpty return type must be MVar");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarTake") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim mvar-take ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarTake expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarPut") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim mvar-put ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarPut expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concChanNew") {
            let retTy = schemeBody(tm.tscm);
            match (args, extractTypeArgs(retTy)) {
                (Cons(a0, Nil), Cons(elemTy, Nil)) -> {
                    bufPushStr(b, "(conc-prim (chan-new ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushStr(b, ") ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concChanNew invalid arguments or return type");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concChanSend") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim chan-send ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concChanSend expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (isChanRecvWrapper(ctx.dcProg, vd.vname)) {
            let retTy = schemeBody(tm.tscm);
            let optMangled = registerCoreAdt(ctx, compBaseName(retTy), extractTypeArgs(retTy));
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim (chan-recv ");
                    pushQuotedStr(b, optMangled);
                    bufPushStr(b, ") ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "chanRecv expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concChanClose") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim chan-close ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concChanClose expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concActorSpawn") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim actor-spawn ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concActorSpawn expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concActorCall") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim actor-call ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concActorCall expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concActorSend") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim actor-send ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concActorSend expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (strMapContains(ctx.dcProg.coreFns, vd.vname)) {
            bufPushStr(b, "(apply-dir ");
            pushQuotedStr(b, vd.vname);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, a);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            if (vd.vname != "main") {
                match strMapGet(ctx.dcFnGlobs, vd.vname) {
                    Some(gs) -> {
                        let cg = cellNew(gs);
                        while (match cellGet(cg) { Nil -> false, _ -> true }) {
                            match cellGet(cg) {
                                Cons(g, gr) -> {
                                    bufPushStr(b, " (var ");
                                    pushQuotedStr(b, "__glob$" + g.gvName);
                                    bufPushByte(b, 41);
                                    cellSet(cg, gr)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                }
            } else ();
            bufPushByte(b, 41)
        } else {
            let extSym = getOrRegisterCoreExtern(ctx, vd.vname, args, schemeBody(tm.tscm));
            bufPushStr(b, "(apply-dir ");
            pushQuotedStr(b, extSym);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, a);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            bufPushByte(b, 41)
        }
    },
    TmBin(op, e1, e2) -> {
        match binOpCoreName(op, schemeBody(e1.tscm)) {
            Some(opName) -> {
                bufPushStr(b, "(bin ");
                bufPushStr(b, opName);
                bufPushByte(b, 32);
                emitCoreTerm(ctx, b, e1);
                bufPushByte(b, 32);
                emitCoreTerm(ctx, b, e2);
                bufPushByte(b, 41)
            },
            None -> {
                setDumpErr(ctx, "Binary operator is outside the Core Geisha subset");
                bufPushStr(b, "(lit-unit)")
            },
        }
    },
    TmUn(op, e1) -> {
        let opTyName = match schemeBody(e1.tscm) { TyCon(n) -> n, _ -> "" };
        let opName = match op {
            UnNot -> "not",
            UnNeg ->
                if (opTyName == "Int64") "neg64"
                else if (opTyName == "Float") "negFloat"
                else if (opTyName == "Float32") "negFloat32"
                else "neg",
            UnBitNot ->
                if (opTyName == "Int64") "bitNot64"
                else "bitNot",
        };
        bufPushStr(b, "(un ");
        bufPushStr(b, opName);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e1);
        bufPushByte(b, 41)
    },
    TmLet(vd, e1, e2) -> {
        bufPushStr(b, "(let ");
        pushQuotedStr(b, vd.vname);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e1);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e2);
        bufPushByte(b, 41)
    },
    TmIf(c, t, e) -> {
        bufPushStr(b, "(if ");
        emitCoreTerm(ctx, b, c);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, t);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e);
        bufPushByte(b, 41)
    },
    TmWhile(c, body) -> {
        bufPushStr(b, "(while ");
        emitCoreTerm(ctx, b, c);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, body);
        bufPushByte(b, 41)
    },
    TmMatch(scrut, arms) -> {
        let scrutTy = schemeBody(scrut.tscm);
        let sMode = if (isDumpTermLocal(ctx, cellGet(ctx.dcCurFn), scrut)) "local" else "shared";
        if (!armsHasGuard(arms)) {
            bufPushStr(b, "(match ");
            emitCoreTerm(ctx, b, scrut);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arm, r) -> {
                        bufPushStr(b, " (arm ");
                        emitCorePatMode(ctx, b, arm.caPat, scrutTy, sMode);
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, arm.caBody);
                        bufPushByte(b, 41);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            bufPushByte(b, 41)
        } else {
            let id = cellGet(ctx.dcFreshCnt);
            cellSet(ctx.dcFreshCnt, id + 1);
            let sv = "__gs_scrut$" + intToStr(id);
            if (sMode == "local") {
                strMapInsert(ctx.dcFnLocalVars, cellGet(ctx.dcCurFn) + ":" + sv, true)
            } else ();
            bufPushStr(b, "(let ");
            pushQuotedStr(b, sv);
            bufPushByte(b, 32);
            emitCoreTerm(ctx, b, scrut);
            bufPushByte(b, 32);
            emitGuardedMatchChain(ctx, b, sv, scrutTy, arms, Nil);
            bufPushByte(b, 41)
        }
    },
    TmMakeData(adtName, tag, args, _, targs) -> {
        let mkMode = if (isDumpTermLocal(ctx, cellGet(ctx.dcCurFn), tm)) "local" else "shared";
        let mangled = registerCoreAdtMode(ctx, adtName, targs, mkMode);
        bufPushStr(b, "(make-data ");
        pushQuotedStr(b, mangled);
        bufPushByte(b, 32);
        bufPushStr(b, intToStr(tag));
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmGetTag(e1) -> {
        bufPushStr(b, "(get-tag ");
        emitCoreTerm(ctx, b, e1);
        bufPushByte(b, 41)
    },
}

def markReachFn(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool,
    wl: Cell (List String),
    name: String,
    isDir: Bool
): Void =
    if (strMapContains(prog.coreFns, name)) {
        if (isDir) {
            strMapInsert(dirReach, name, true)
        } else ();
        if (!strMapContains(allReach, name)) {
            strMapInsert(allReach, name, true);
            cellSet(wl, Cons(name, cellGet(wl)))
        } else ()
    } else ()

def scanReachTermList(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool,
    wl: Cell (List String),
    es: List TaggedTerm
): Void = {
    let cur = cellNew(es);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(e, r) -> {
                scanReachTerm(prog, allReach, dirReach, wl, e);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def scanReachTerm(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool,
    wl: Cell (List String),
    tm: TaggedTerm
): Void = match tm.tnode {
    TmLit(_) -> (),
    TmVar(_) -> (),
    TmGlobalVar(_) -> (),
    TmTuple(es) -> scanReachTermList(prog, allReach, dirReach, wl, es),
    TmBlock(es) -> scanReachTermList(prog, allReach, dirReach, wl, es),
    TmMakeCls(_, cls, body) -> {
        markReachFn(prog, allReach, dirReach, wl, cls.clsEntry, false);
        scanReachTerm(prog, allReach, dirReach, wl, body)
    },
    TmApplyCls(fnTm, args) -> {
        scanReachTerm(prog, allReach, dirReach, wl, fnTm);
        scanReachTermList(prog, allReach, dirReach, wl, args)
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname == "cFnPtr") {
            match args {
                Cons(a0, _) -> match a0.tnode {
                    TmLit(LitStr(fnNm)) -> markReachFn(prog, allReach, dirReach, wl, fnNm, true),
                    _ -> (),
                },
                Nil -> (),
            }
        } else if (!isChanRecvWrapper(prog, vd.vname)) {
            markReachFn(prog, allReach, dirReach, wl, vd.vname, true)
        } else ();
        scanReachTermList(prog, allReach, dirReach, wl, args)
    },
    TmBin(_, e1, e2) -> {
        scanReachTerm(prog, allReach, dirReach, wl, e1);
        scanReachTerm(prog, allReach, dirReach, wl, e2)
    },
    TmUn(_, e1) -> scanReachTerm(prog, allReach, dirReach, wl, e1),
    TmLet(_, e1, e2) -> {
        scanReachTerm(prog, allReach, dirReach, wl, e1);
        scanReachTerm(prog, allReach, dirReach, wl, e2)
    },
    TmIf(c, t, e) -> {
        scanReachTerm(prog, allReach, dirReach, wl, c);
        scanReachTerm(prog, allReach, dirReach, wl, t);
        scanReachTerm(prog, allReach, dirReach, wl, e)
    },
    TmWhile(c, body) -> {
        scanReachTerm(prog, allReach, dirReach, wl, c);
        scanReachTerm(prog, allReach, dirReach, wl, body)
    },
    TmMatch(scrut, arms) -> {
        scanReachTerm(prog, allReach, dirReach, wl, scrut);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arm, r) -> {
                    match arm.caGuard {
                        Some(g) -> scanReachTerm(prog, allReach, dirReach, wl, g),
                        None -> (),
                    };
                    scanReachTerm(prog, allReach, dirReach, wl, arm.caBody);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> scanReachTermList(prog, allReach, dirReach, wl, args),
    TmGetTag(e1) -> scanReachTerm(prog, allReach, dirReach, wl, e1),
}

def collectReachableCoreFns(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool
): List String =
    if (!strMapContains(prog.coreFns, "main")) {
        let cf = cellNew(prog.coreFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    strMapInsert(allReach, fnName, true);
                    strMapInsert(dirReach, fnName, true);
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        prog.coreFnNames
    } else {
        let wl: Cell (List String) = cellNew(Nil);
        markReachFn(prog, allReach, dirReach, wl, "main", true);
        let cg = cellNew(prog.coreGlobals);
        while (match cellGet(cg) { Nil -> false, _ -> true }) {
            match cellGet(cg) {
                Cons(g, gr) -> {
                    scanReachTerm(prog, allReach, dirReach, wl, g.gvInit);
                    cellSet(cg, gr)
                },
                Nil -> (),
            }
        };
        while (match cellGet(wl) { Nil -> false, _ -> true }) {
            match cellGet(wl) {
                Cons(fnName, rest) -> {
                    cellSet(wl, rest);
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> scanReachTerm(prog, allReach, dirReach, wl, fd.fnBody),
                        None -> (),
                    }
                },
                Nil -> (),
            }
        };
        let revAcc: Cell (List String) = cellNew(Nil);
        let cf = cellNew(prog.coreFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    if (strMapContains(allReach, fnName)) {
                        cellSet(revAcc, Cons(fnName, cellGet(revAcc)))
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        listRev(cellGet(revAcc))
    }

def listContainsStrDump(xs: List String, target: String): Bool = match xs {
    Nil -> false,
    Cons(h, t) -> if (h == target) true else listContainsStrDump(t, target),
}

def collectLetCellNewCandidates(tm: TaggedTerm, seen: StrMap Bool, revOut: Cell (List String)): Void = match tm.tnode {
    TmLet(vd, e1, e2) -> {
        match e1.tnode {
            TmApplyDir(fvd, Cons(_, Nil)) ->
                if (fvd.vname == "cellNew" && !strMapContains(seen, vd.vname)) {
                    strMapInsert(seen, vd.vname, true);
                    cellSet(revOut, Cons(vd.vname, cellGet(revOut)))
                } else (),
            _ -> (),
        };
        collectLetCellNewCandidates(e1, seen, revOut);
        collectLetCellNewCandidates(e2, seen, revOut)
    },
    TmMakeCls(_, _, body) -> collectLetCellNewCandidates(body, seen, revOut),
    TmTuple(es) -> collectLetCellNewList(es, seen, revOut),
    TmBlock(es) -> collectLetCellNewList(es, seen, revOut),
    TmApplyCls(c, args) -> {
        collectLetCellNewCandidates(c, seen, revOut);
        collectLetCellNewList(args, seen, revOut)
    },
    TmApplyDir(_, args) -> collectLetCellNewList(args, seen, revOut),
    TmBin(_, e1, e2) -> {
        collectLetCellNewCandidates(e1, seen, revOut);
        collectLetCellNewCandidates(e2, seen, revOut)
    },
    TmUn(_, e1) -> collectLetCellNewCandidates(e1, seen, revOut),
    TmIf(c, t, e) -> {
        collectLetCellNewCandidates(c, seen, revOut);
        collectLetCellNewCandidates(t, seen, revOut);
        collectLetCellNewCandidates(e, seen, revOut)
    },
    TmWhile(c, b) -> {
        collectLetCellNewCandidates(c, seen, revOut);
        collectLetCellNewCandidates(b, seen, revOut)
    },
    TmMatch(s, arms) -> {
        collectLetCellNewCandidates(s, seen, revOut);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard {
                        Some(g) -> collectLetCellNewCandidates(g, seen, revOut),
                        None -> (),
                    };
                    collectLetCellNewCandidates(a.caBody, seen, revOut);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> collectLetCellNewList(args, seen, revOut),
    TmGetTag(e1) -> collectLetCellNewCandidates(e1, seen, revOut),
    _ -> (),
}

def collectLetCellNewList(es: List TaggedTerm, seen: StrMap Bool, revOut: Cell (List String)): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectLetCellNewCandidates(h, seen, revOut);
        collectLetCellNewList(t, seen, revOut)
    },
}

// Emit raw, unfiltered stack-promoted `Cell` bindings (and any erroneously
// marked parameters) straight from `prog.coreEscape.escFnStackVars` so Lean 4's
// `Escape.lean` directly gates `src/core.gsa` without pre-filtering.
def collectRawStackCellVarsForFn(prog: CoreProgram, fd: FunDef): List String =
    match strMapGet(prog.coreEscape.escFnStackVars, fd.fnName) {
        None -> Nil,
        Some(stackSet) -> {
            let seen: StrMap Bool = strMapNew();
            let revOut: Cell (List String) = cellNew(Nil);
            let cp = cellNew(fd.fnParams);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(pvd, pr) -> {
                        if (strMapContains(stackSet, pvd.vname) && !strMapContains(seen, pvd.vname)) {
                            strMapInsert(seen, pvd.vname, true);
                            cellSet(revOut, Cons(pvd.vname, cellGet(revOut)))
                        } else ();
                        cellSet(cp, pr)
                    },
                    Nil -> (),
                }
            };
            let candSeen: StrMap Bool = strMapNew();
            let revCand: Cell (List String) = cellNew(Nil);
            collectLetCellNewCandidates(fd.fnBody, candSeen, revCand);
            let cands = listRev(cellGet(revCand));
            let cc = cellNew(cands);
            while (match cellGet(cc) { Nil -> false, _ -> true }) {
                match cellGet(cc) {
                    Cons(vname, r) -> {
                        if (strMapContains(stackSet, vname) && !strMapContains(seen, vname)) {
                            strMapInsert(seen, vname, true);
                            cellSet(revOut, Cons(vname, cellGet(revOut)))
                        } else ();
                        cellSet(cc, r)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(revOut))
        },
    }

def collectGlobalMentionsInTerm(
    prog: CoreProgram,
    tm: TaggedTerm,
    gset: StrMap Bool,
    fnGlobSets: StrMap (StrMap Bool),
    changed: Cell Bool
): Void = match tm.tnode {
    TmLit(_) -> (),
    TmVar(_) -> (),
    TmGlobalVar(g) -> markStrMap(gset, g, changed),
    TmTuple(es) -> collectGlobalMentionsList(prog, es, gset, fnGlobSets, changed),
    TmBlock(es) -> collectGlobalMentionsList(prog, es, gset, fnGlobSets, changed),
    TmMakeCls(_, cls, body) -> {
        unionGlobSetFrom(prog, cls.clsEntry, gset, fnGlobSets, changed);
        collectGlobalMentionsInTerm(prog, body, gset, fnGlobSets, changed)
    },
    TmApplyCls(c, args) -> {
        collectGlobalMentionsInTerm(prog, c, gset, fnGlobSets, changed);
        collectGlobalMentionsList(prog, args, gset, fnGlobSets, changed)
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname != "main" && strMapContains(prog.coreFns, vd.vname)) {
            unionGlobSetFrom(prog, vd.vname, gset, fnGlobSets, changed)
        } else ();
        collectGlobalMentionsList(prog, args, gset, fnGlobSets, changed)
    },
    TmBin(_, e1, e2) -> {
        collectGlobalMentionsInTerm(prog, e1, gset, fnGlobSets, changed);
        collectGlobalMentionsInTerm(prog, e2, gset, fnGlobSets, changed)
    },
    TmUn(_, e1) -> collectGlobalMentionsInTerm(prog, e1, gset, fnGlobSets, changed),
    TmLet(_, e1, e2) -> {
        collectGlobalMentionsInTerm(prog, e1, gset, fnGlobSets, changed);
        collectGlobalMentionsInTerm(prog, e2, gset, fnGlobSets, changed)
    },
    TmIf(c, t, e) -> {
        collectGlobalMentionsInTerm(prog, c, gset, fnGlobSets, changed);
        collectGlobalMentionsInTerm(prog, t, gset, fnGlobSets, changed);
        collectGlobalMentionsInTerm(prog, e, gset, fnGlobSets, changed)
    },
    TmWhile(c, b) -> {
        collectGlobalMentionsInTerm(prog, c, gset, fnGlobSets, changed);
        collectGlobalMentionsInTerm(prog, b, gset, fnGlobSets, changed)
    },
    TmMatch(s, arms) -> {
        collectGlobalMentionsInTerm(prog, s, gset, fnGlobSets, changed);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard {
                        Some(g) -> collectGlobalMentionsInTerm(prog, g, gset, fnGlobSets, changed),
                        None -> (),
                    };
                    collectGlobalMentionsInTerm(prog, a.caBody, gset, fnGlobSets, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> collectGlobalMentionsList(prog, args, gset, fnGlobSets, changed),
    TmGetTag(e1) -> collectGlobalMentionsInTerm(prog, e1, gset, fnGlobSets, changed),
}

def collectGlobalMentionsList(
    prog: CoreProgram,
    es: List TaggedTerm,
    gset: StrMap Bool,
    fnGlobSets: StrMap (StrMap Bool),
    changed: Cell Bool
): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectGlobalMentionsInTerm(prog, h, gset, fnGlobSets, changed);
        collectGlobalMentionsList(prog, t, gset, fnGlobSets, changed)
    },
}

def unionGlobSetFrom(
    prog: CoreProgram,
    callee: String,
    dst: StrMap Bool,
    fnGlobSets: StrMap (StrMap Bool),
    changed: Cell Bool
): Void =
    match strMapGet(fnGlobSets, callee) {
        Some(srcSet) -> {
            let cg = cellNew(prog.coreGlobals);
            while (match cellGet(cg) { Nil -> false, _ -> true }) {
                match cellGet(cg) {
                    Cons(g, gr) -> {
                        if (strMapContains(srcSet, g.gvName)) {
                            markStrMap(dst, g.gvName, changed)
                        } else ();
                        cellSet(cg, gr)
                    },
                    Nil -> (),
                }
            }
        },
        None -> (),
    }

def computeFnGlobals(prog: CoreProgram, activeFnNames: List String): StrMap (List GlobalValDef) = {
    let out: StrMap (List GlobalValDef) = strMapNew();
    match prog.coreGlobals {
        Nil -> out,
        _ -> {
            let fnGlobSets: StrMap (StrMap Bool) = strMapNew();
            let cf0 = cellNew(activeFnNames);
            while (match cellGet(cf0) { Nil -> false, _ -> true }) {
                match cellGet(cf0) {
                    Cons(fnName, r) -> {
                        if (fnName != "main") {
                            strMapInsert(fnGlobSets, fnName, strMapNew())
                        } else ();
                        cellSet(cf0, r)
                    },
                    Nil -> (),
                }
            };
            let changed = cellNew(true);
            while (cellGet(changed)) {
                cellSet(changed, false);
                let cf = cellNew(activeFnNames);
                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                    match cellGet(cf) {
                        Cons(fnName, r) -> {
                            if (fnName != "main") {
                                match (strMapGet(prog.coreFns, fnName), strMapGet(fnGlobSets, fnName)) {
                                    (Some(fd), Some(gset)) ->
                                        collectGlobalMentionsInTerm(prog, fd.fnBody, gset, fnGlobSets, changed),
                                    _ -> (),
                                }
                            } else ();
                            cellSet(cf, r)
                        },
                        Nil -> (),
                    }
                }
            };
            let cf2 = cellNew(activeFnNames);
            while (match cellGet(cf2) { Nil -> false, _ -> true }) {
                match cellGet(cf2) {
                    Cons(fnName, r) -> {
                        if (fnName != "main") {
                            match strMapGet(fnGlobSets, fnName) {
                                Some(gset) -> {
                                    let revG: Cell (List GlobalValDef) = cellNew(Nil);
                                    let cg = cellNew(prog.coreGlobals);
                                    while (match cellGet(cg) { Nil -> false, _ -> true }) {
                                        match cellGet(cg) {
                                            Cons(g, gr) -> {
                                                if (strMapContains(gset, g.gvName)) {
                                                    cellSet(revG, Cons(g, cellGet(revG)))
                                                } else ();
                                                cellSet(cg, gr)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    strMapInsert(out, fnName, listRev(cellGet(revG)))
                                },
                                None -> (),
                            }
                        } else ();
                        cellSet(cf2, r)
                    },
                    Nil -> (),
                }
            };
            out
        },
    }
}

def emitMainBodyWithGlobals(ctx: DumpCtx, b: StringBuf, gs: List GlobalValDef, body: TaggedTerm): Void = match gs {
    Nil -> emitCoreTerm(ctx, b, body),
    Cons(g, rest) -> {
        bufPushStr(b, "(let ");
        pushQuotedStr(b, "__glob$" + g.gvName);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, g.gvInit);
        bufPushByte(b, 32);
        emitMainBodyWithGlobals(ctx, b, rest, body);
        bufPushByte(b, 41)
    },
}

pub def dumpCoreProgramSExpr(prog: CoreProgram): Result String String = {
    let allReach: StrMap Bool = strMapNew();
    let dirReach: StrMap Bool = strMapNew();
    let activeFnNames = collectReachableCoreFns(prog, allReach, dirReach);

    let globTypes: StrMap Type = strMapNew();
    let cg0 = cellNew(prog.coreGlobals);
    while (match cellGet(cg0) { Nil -> false, _ -> true }) {
        match cellGet(cg0) {
            Cons(g, gr) -> {
                strMapInsert(globTypes, g.gvName, g.gvTy);
                cellSet(cg0, gr)
            },
            Nil -> (),
        }
    };

    let fnGlobs = computeFnGlobals(prog, activeFnNames);

    let paramShared: StrMap Bool = strMapNew();
    let fvNonSend: StrMap Bool = strMapNew();
    let clsLocal: StrMap Bool = strMapNew();
    let retLocal: StrMap Bool = strMapNew();
    let adtLocal: StrMap Bool = strMapNew();
    let adtDualMode: StrMap Bool = strMapNew();
    let fnLocalVars: StrMap Bool = strMapNew();
    analyzeCoreModes(
        prog, activeFnNames, globTypes, fnGlobs, paramShared, fvNonSend,
        clsLocal, retLocal, adtLocal, adtDualMode, fnLocalVars
    );
    let usedFnNames: StrMap Bool = strMapNew();
    let cu = cellNew(activeFnNames);
    while (match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons(fnName, r) -> {
                strMapInsert(usedFnNames, fnName, true);
                cellSet(cu, r)
            },
            Nil -> (),
        }
    };

    let ctx = MkDumpCtx {
        dcProg: prog,
        dcInstAdts: strMapNew(),
        dcInstAdtOrder: cellNew(Nil),
        dcParamShared: paramShared,
        dcFvNonSend: fvNonSend,
        dcClsLocal: clsLocal,
        dcRetLocal: retLocal,
        dcAdtLocal: adtLocal,
        dcAdtDualMode: adtDualMode,
        dcFnLocalVars: fnLocalVars,
        dcCurFn: cellNew(""),
        dcGlobTypes: globTypes,
        dcFnGlobs: fnGlobs,
        dcExternMap: strMapNew(),
        dcExternDefs: strMapNew(),
        dcExternOrder: cellNew(Nil),
        dcUsedFnNames: usedFnNames,
        dcEmittedRecCls: strMapNew(),
        dcRecClsBuf: bufNew(),
        dcFreshCnt: cellNew(0),
        dcErr: cellNew(None),
    };

    let funsBuf = bufNew();
    let stackBuf = bufNew();
    let cf = cellNew(activeFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnName, r) -> {
                if (strMapContains(dirReach, fnName)) {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            // Lifted closures with captured free variables are inlined at `TmMakeCls`
                            if (listLen(fd.fnFvs) == 0) {
                                cellSet(ctx.dcCurFn, fd.fnName);
                                let retTy = match schemeBody(fd.fnScm) {
                                    TyArr(_, _, ret) -> ret,
                                    other -> other,
                                };
                                let rMode = if (strMapContains(ctx.dcRetLocal, fd.fnName)) "local" else "shared";
                                let extParams =
                                    if (fd.fnName == "main") fd.fnParams
                                    else match strMapGet(ctx.dcFnGlobs, fd.fnName) {
                                        None -> fd.fnParams,
                                        Some(gs) -> {
                                            let revExtra: Cell (List VarDecl) = cellNew(Nil);
                                            let cg = cellNew(gs);
                                            while (match cellGet(cg) { Nil -> false, _ -> true }) {
                                                match cellGet(cg) {
                                                    Cons(g, gr) -> {
                                                        cellSet(revExtra, Cons(MkVarDecl {
                                                            vname: "__glob$" + g.gvName,
                                                            vscm: ScmMono(g.gvTy),
                                                        }, cellGet(revExtra)));
                                                        cellSet(cg, gr)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            listAppend(fd.fnParams, listRev(cellGet(revExtra)))
                                        },
                                    };
                                bufPushStr(funsBuf, "    (fun ");
                                pushQuotedStr(funsBuf, fd.fnName);
                                bufPushByte(funsBuf, 32);
                                emitParamList(ctx, funsBuf, fd.fnName, extParams);
                                bufPushByte(funsBuf, 32);
                                emitCoreTyWithMode(ctx, funsBuf, retTy, rMode);
                                bufPushByte(funsBuf, 32);
                                if (fd.fnName == "main") {
                                    emitMainBodyWithGlobals(ctx, funsBuf, prog.coreGlobals, fd.fnBody)
                                } else {
                                    emitCoreTerm(ctx, funsBuf, fd.fnBody)
                                };
                                bufPushStr(funsBuf, ")\n");
                                let svars = collectRawStackCellVarsForFn(prog, fd);
                                match svars {
                                    Nil -> (),
                                    _ -> {
                                        bufPushStr(stackBuf, "    (fn-stack ");
                                        pushQuotedStr(stackBuf, fd.fnName);
                                        let cs = cellNew(svars);
                                        while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                            match cellGet(cs) {
                                                Cons(sv, sr) -> {
                                                    bufPushByte(stackBuf, 32);
                                                    pushQuotedStr(stackBuf, sv);
                                                    cellSet(cs, sr)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        bufPushStr(stackBuf, ")\n")
                                    },
                                }
                            } else ()
                        },
                        None -> (),
                    }
                } else if (strMapContains(ctx.dcEmittedRecCls, fnName)) {
                    ()
                } else ();
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    let cfRec = cellNew(activeFnNames);
    while (match cellGet(cfRec) { Nil -> false, _ -> true }) {
        match cellGet(cfRec) {
            Cons(fnName, r) -> {
                if (strMapContains(ctx.dcEmittedRecCls, fnName)) {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            let svars = collectRawStackCellVarsForFn(prog, fd);
                            match svars {
                                Nil -> (),
                                _ -> {
                                    bufPushStr(stackBuf, "    (fn-stack ");
                                    pushQuotedStr(stackBuf, fd.fnName);
                                    let cs = cellNew(svars);
                                    while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                        match cellGet(cs) {
                                            Cons(sv, sr) -> {
                                                bufPushByte(stackBuf, 32);
                                                pushQuotedStr(stackBuf, sv);
                                                cellSet(cs, sr)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    bufPushStr(stackBuf, ")\n")
                                },
                            }
                        },
                        None -> (),
                    }
                } else ();
                cellSet(cfRec, r)
            },
            Nil -> (),
        }
    };

    let externsBuf = bufNew();
    let extOrder = listRev(cellGet(ctx.dcExternOrder));
    let ce = cellNew(extOrder);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons(extName, r) -> {
                match strMapGet(ctx.dcExternDefs, extName) {
                    Some((paramTys, retStr)) -> {
                        bufPushStr(externsBuf, "    (extern ");
                        pushQuotedStr(externsBuf, extName);
                        bufPushStr(externsBuf, " (");
                        let pi = cellNew(0);
                        let cp = cellNew(paramTys);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(ptyStr, pr) -> {
                                    let idx = cellGet(pi);
                                    if (idx > 0) bufPushByte(externsBuf, 32) else ();
                                    bufPushByte(externsBuf, 40);
                                    pushQuotedStr(externsBuf, "p" + intToStr(idx));
                                    bufPushByte(externsBuf, 32);
                                    bufPushStr(externsBuf, ptyStr);
                                    bufPushByte(externsBuf, 41);
                                    cellSet(pi, idx + 1);
                                    cellSet(cp, pr)
                                },
                                Nil -> (),
                            }
                        };
                        bufPushStr(externsBuf, ") ");
                        bufPushStr(externsBuf, retStr);
                        bufPushStr(externsBuf, ")\n")
                    },
                    None -> (),
                };
                cellSet(ce, r)
            },
            Nil -> (),
        }
    };

    initCodegenLayoutContext(prog);
    let adtsBuf = bufNew();
    let gcMasksBuf = bufNew();
    let adtOrder = listRev(cellGet(ctx.dcInstAdtOrder));
    let ca = cellNew(adtOrder);
    while (match cellGet(ca) { Nil -> false, _ -> true }) {
        match cellGet(ca) {
            Cons(mangled, r) -> {
                match strMapGet(ctx.dcInstAdts, mangled) {
                    Some((baseName, targs, fMode)) -> {
                        match strMapGet(prog.coreAdtReg, baseName) {
                            Some(ainfo) -> {
                                let sub = buildPairMap(ainfo.typeParams, targs);
                                bufPushStr(adtsBuf, "    (adt ");
                                pushQuotedStr(adtsBuf, mangled);
                                bufPushStr(gcMasksBuf, "    (adt-masks ");
                                if (ainfo.isCStruct) bufPushStr(gcMasksBuf, "cstruct ") else ();
                                pushQuotedStr(gcMasksBuf, mangled);
                                let cv = cellNew(ainfo.variants);
                                while (match cellGet(cv) { Nil -> false, _ -> true }) {
                                    match cellGet(cv) {
                                        Cons(vi, vr) -> {
                                            bufPushStr(adtsBuf, " (variant ");
                                            bufPushStr(adtsBuf, intToStr(vi.tag));
                                            let instFtRev: Cell (List Type) = cellNew(Nil);
                                            let cft = cellNew(vi.fieldTypes);
                                            while (match cellGet(cft) { Nil -> false, _ -> true }) {
                                                match cellGet(cft) {
                                                    Cons(ft, fr) -> {
                                                        let instFt = applyExplicitSubst(ft, sub);
                                                        cellSet(instFtRev, Cons(instFt, cellGet(instFtRev)));
                                                        bufPushByte(adtsBuf, 32);
                                                        emitCoreTyWithMode(ctx, adtsBuf, instFt, fMode);
                                                        cellSet(cft, fr)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            bufPushByte(adtsBuf, 41);
                                            let instFts = listRev(cellGet(instFtRev));
                                            let maskSpec = computeCodegenVariantGcMaskSExpr(baseName, targs, instFts);
                                            bufPushStr(gcMasksBuf, " (vmask ");
                                            bufPushStr(gcMasksBuf, intToStr(vi.tag));
                                            bufPushByte(gcMasksBuf, 32);
                                            bufPushStr(gcMasksBuf, maskSpec);
                                            bufPushByte(gcMasksBuf, 41);
                                            cellSet(cv, vr)
                                        },
                                        Nil -> (),
                                    }
                                };
                                bufPushStr(adtsBuf, ")\n");
                                bufPushStr(gcMasksBuf, ")\n")
                            },
                            None -> (),
                        }
                    },
                    None -> (),
                };
                cellSet(ca, r)
            },
            Nil -> (),
        }
    };

    match cellGet(ctx.dcErr) {
        Some(errMsg) -> Err(errMsg),
        None -> {
            let extStr = bufToString(externsBuf);
            let out = bufNew();
            bufPushStr(out, "(program\n  (adts\n");
            bufPushStr(out, bufToString(adtsBuf));
            if (strLen(extStr) > 0) {
                bufPushStr(out, "  )\n  (externs\n");
                bufPushStr(out, extStr)
            } else ();
            bufPushStr(out, "  )\n  (funs\n");
            bufPushStr(out, bufToString(ctx.dcRecClsBuf));
            bufPushStr(out, bufToString(funsBuf));
            bufPushStr(out, "  )\n  (stack-allocs\n");
            bufPushStr(out, bufToString(stackBuf));
            bufPushStr(out, "  )\n  (gc-masks\n");
            bufPushStr(out, bufToString(gcMasksBuf));
            bufPushStr(out, "  )\n)\n");
            Ok(bufToString(out))
        },
    }
}
