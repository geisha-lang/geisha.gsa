// Core Geisha S-Expression Exporter (`--dump-core`)
//
// Serializes a monomorphized `CoreProgram` into `.gscore` S-expression format
// (including closure capture modes `local`/`shared` and concurrent `task`/`spawn`/`await`)
// consumed by the Lean 4 machine-checked verifier `formal/.lake/build/bin/geisha-check`.

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listLen}
use std.buf.{StringBuf, bufNew, bufPushStr, bufPushByte, bufToString}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.str.intToStr
use ast.{
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmSlot, schemeBody,
    Lit, LitInt, LitFloat, LitChar, LitStr, LitBool, LitUnit,
    BinOp, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpAnd, OpOr,
    OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, OpUshr,
    OpEq, OpNe, OpLt, OpLe, OpGt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct
}
use infer.{
    VariantInfo, AdtInfo, mangleType, applyExplicitSubst, buildPairMap, findVariantByName
}
use core.{
    ClosureSpec, TaggedTerm, MkTerm, CoreArm, Term,
    TmLit, TmVar, TmGlobalVar, TmTuple, TmBlock, TmMakeCls, TmApplyCls, TmApplyDir,
    TmBin, TmUn, TmLet, TmIf, TmWhile, TmMatch, TmMakeData, TmGetTag,
    FunDef, EscapeInfo, CoreProgram, extractTypeArgs
}

data DumpCtx {
    MkDumpCtx {
        dcProg: CoreProgram,
        dcInstAdts: StrMap (String, List Type),
        dcInstAdtOrder: Cell (List String),
        dcParamShared: StrMap Bool,
        dcClsLocal: StrMap Bool,
        dcRetLocal: StrMap Bool,
        dcAdtLocal: StrMap Bool,
        dcErr: Cell (Option String),
    },
}

def setDumpErr(ctx: DumpCtx, msg: String): Void =
    match cellGet(ctx.dcErr) {
        None -> cellSet(ctx.dcErr, Some(msg)),
        Some(_) -> (),
    }

def pushQuotedStr(b: StringBuf, s: String): Void = {
    bufPushByte(b, 34);
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let c = strByteAt(s, cellGet(i));
        if (c == 34) bufPushStr(b, "\\\"")
        else if (c == 92) bufPushStr(b, "\\\\")
        else if (c == 10) bufPushStr(b, "\\n")
        else if (c == 13) bufPushStr(b, "\\r")
        else if (c == 9) bufPushStr(b, "\\t")
        else bufPushByte(b, c);
        cellSet(i, cellGet(i) + 1)
    };
    bufPushByte(b, 34)
}

def compBaseName(ty: Type): String = match ty {
    TyComp(b, _) -> compBaseName(b),
    TyCon(n) -> n,
    _ -> "",
}

def mangleCoreAdt(baseName: String, targs: List Type): String = match targs {
    Nil -> baseName,
    _ -> {
        let b = bufNew();
        bufPushStr(b, baseName);
        let cur = cellNew(targs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    bufPushByte(b, 95);
                    bufPushStr(b, mangleType(t));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufToString(b)
    },
}

// ============================================================================
// Mode Synthesis Pass (`local` vs `shared`) on Monomorphized `CoreProgram`
// ============================================================================

def markStrMap(m: StrMap Bool, key: String, changed: Cell Bool): Void =
    if (!strMapContains(m, key)) {
        strMapInsert(m, key, true);
        cellSet(changed, true)
    } else ()

def collectBodyBindings(
    tm: TaggedTerm,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec
): Void = match tm.tnode {
    TmMakeCls(vd, cls, body) -> {
        strMapInsert(localCls, vd.vname, cls);
        collectBodyBindings(body, letRhs, localCls)
    },
    TmLet(vd, e1, e2) -> {
        strMapInsert(letRhs, vd.vname, e1);
        collectBodyBindings(e1, letRhs, localCls);
        collectBodyBindings(e2, letRhs, localCls)
    },
    TmTuple(es) -> collectBodyBindingsList(es, letRhs, localCls),
    TmBlock(es) -> collectBodyBindingsList(es, letRhs, localCls),
    TmApplyCls(c, args) -> {
        collectBodyBindings(c, letRhs, localCls);
        collectBodyBindingsList(args, letRhs, localCls)
    },
    TmApplyDir(_, args) -> collectBodyBindingsList(args, letRhs, localCls),
    TmBin(_, l, r) -> {
        collectBodyBindings(l, letRhs, localCls);
        collectBodyBindings(r, letRhs, localCls)
    },
    TmUn(_, e1) -> collectBodyBindings(e1, letRhs, localCls),
    TmIf(c, t, e) -> {
        collectBodyBindings(c, letRhs, localCls);
        collectBodyBindings(t, letRhs, localCls);
        collectBodyBindings(e, letRhs, localCls)
    },
    TmWhile(c, b) -> {
        collectBodyBindings(c, letRhs, localCls);
        collectBodyBindings(b, letRhs, localCls)
    },
    TmMatch(s, arms) -> {
        collectBodyBindings(s, letRhs, localCls);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    collectBodyBindings(a.caBody, letRhs, localCls);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> collectBodyBindingsList(args, letRhs, localCls),
    TmGetTag(e1) -> collectBodyBindings(e1, letRhs, localCls),
    _ -> (),
}

def collectBodyBindingsList(
    es: List TaggedTerm,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec
): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectBodyBindings(h, letRhs, localCls);
        collectBodyBindingsList(t, letRhs, localCls)
    },
}

def requireTermSend(
    fnName: String,
    tm: TaggedTerm,
    paramSet: StrMap Bool,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec,
    visitedVars: StrMap Bool,
    paramShared: StrMap Bool,
    clsReqShared: StrMap Bool,
    retReqShared: StrMap Bool,
    changed: Cell Bool
): Void = match tm.tnode {
    TmVar(x) ->
        if (!strMapContains(visitedVars, x)) {
            strMapInsert(visitedVars, x, true);
            if (strMapContains(paramSet, x)) {
                markStrMap(paramShared, fnName + ":" + x, changed)
            } else ();
            match strMapGet(localCls, x) {
                Some(cls) -> markStrMap(clsReqShared, cls.clsEntry, changed),
                None -> (),
            };
            match strMapGet(letRhs, x) {
                Some(rhs) -> requireTermSend(
                    fnName, rhs, paramSet, letRhs, localCls, visitedVars,
                    paramShared, clsReqShared, retReqShared, changed
                ),
                None -> (),
            }
        } else (),
    TmMakeCls(_, _, body) ->
        requireTermSend(
            fnName, body, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        ),
    TmLet(_, _, body) ->
        requireTermSend(
            fnName, body, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        ),
    TmBlock(es) -> match listRev(es) {
        Cons(lastTm, _) -> requireTermSend(
            fnName, lastTm, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        ),
        Nil -> (),
    },
    TmIf(_, t, e) -> {
        requireTermSend(
            fnName, t, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        );
        requireTermSend(
            fnName, e, paramSet, letRhs, localCls, visitedVars,
            paramShared, clsReqShared, retReqShared, changed
        )
    },
    TmMatch(_, arms) -> {
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    requireTermSend(
                        fnName, a.caBody, paramSet, letRhs, localCls, visitedVars,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmTuple(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    requireTermSend(
                        fnName, a, paramSet, letRhs, localCls, visitedVars,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, es, _, _) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    requireTermSend(
                        fnName, a, paramSet, letRhs, localCls, visitedVars,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmApplyDir(vd, _) -> markStrMap(retReqShared, vd.vname, changed),
    _ -> (),
}

def isChanRecvWrapper(prog: CoreProgram, name: String): Bool =
    match strMapGet(prog.coreFns, name) {
        Some(fd) -> match fd.fnBody.tnode {
            TmMatch(scrut, _) -> match scrut.tnode {
                TmApplyDir(ivd, _) -> ivd.vname == "__concChanRecv",
                _ -> false,
            },
            _ -> false,
        },
        None -> false,
    }

def scanSendDemandsInTerm(
    prog: CoreProgram,
    fnName: String,
    tm: TaggedTerm,
    paramSet: StrMap Bool,
    letRhs: StrMap TaggedTerm,
    localCls: StrMap ClosureSpec,
    paramShared: StrMap Bool,
    clsReqShared: StrMap Bool,
    retReqShared: StrMap Bool,
    changed: Cell Bool
): Void = match tm.tnode {
    TmMakeCls(_, cls, body) -> {
        if (strMapContains(clsReqShared, cls.clsEntry)) {
            let cf = cellNew(cls.clsFvs);
            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons(fvName, r) -> {
                        let vset: StrMap Bool = strMapNew();
                        requireTermSend(
                            fnName,
                            MkTerm { tscm: ScmSlot, tnode: TmVar(fvName) },
                            paramSet, letRhs, localCls, vset,
                            paramShared, clsReqShared, retReqShared, changed
                        );
                        cellSet(cf, r)
                    },
                    Nil -> (),
                }
            }
        } else ();
        scanSendDemandsInTerm(
            prog, fnName, body, paramSet, letRhs, localCls,
            paramShared, clsReqShared, retReqShared, changed
        )
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname == "__concTaskSpawn" || vd.vname == "__concActorSpawn" || vd.vname == "__concMVarNew") {
            match args {
                Cons(a0, _) -> {
                    let vset: StrMap Bool = strMapNew();
                    requireTermSend(
                        fnName, a0, paramSet, letRhs, localCls, vset,
                        paramShared, clsReqShared, retReqShared, changed
                    )
                },
                Nil -> (),
            }
        } else if (vd.vname == "__concMVarPut" || vd.vname == "__concChanSend" || vd.vname == "__concActorCall" || vd.vname == "__concActorSend") {
            match args {
                Cons(_, Cons(a1, _)) -> {
                    let vset: StrMap Bool = strMapNew();
                    requireTermSend(
                        fnName, a1, paramSet, letRhs, localCls, vset,
                        paramShared, clsReqShared, retReqShared, changed
                    )
                },
                _ -> (),
            }
        } else if (!isChanRecvWrapper(prog, vd.vname)) {
            match strMapGet(prog.coreFns, vd.vname) {
                Some(calleeFd) -> {
                    let cp = cellNew(calleeFd.fnParams);
                    let ca = cellNew(args);
                    while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                        match (cellGet(cp), cellGet(ca)) {
                            (Cons(pvd, pr), Cons(argTm, ar)) -> {
                                if (strMapContains(paramShared, vd.vname + ":" + pvd.vname)) {
                                    let vset: StrMap Bool = strMapNew();
                                    requireTermSend(
                                        fnName, argTm, paramSet, letRhs, localCls, vset,
                                        paramShared, clsReqShared, retReqShared, changed
                                    )
                                } else ();
                                cellSet(cp, pr);
                                cellSet(ca, ar)
                            },
                            _ -> (),
                        }
                    }
                },
                None -> (),
            }
        } else ();
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmApplyCls(c, args) -> {
        scanSendDemandsInTerm(
            prog, fnName, c, paramSet, letRhs, localCls,
            paramShared, clsReqShared, retReqShared, changed
        );
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmTuple(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmBlock(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(
                        prog, fnName, a, paramSet, letRhs, localCls,
                        paramShared, clsReqShared, retReqShared, changed
                    );
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmBin(_, l, r) -> {
        scanSendDemandsInTerm(prog, fnName, l, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, r, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed)
    },
    TmUn(_, e1) -> scanSendDemandsInTerm(prog, fnName, e1, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed),
    TmLet(_, e1, e2) -> {
        scanSendDemandsInTerm(prog, fnName, e1, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, e2, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed)
    },
    TmIf(c, t, e) -> {
        scanSendDemandsInTerm(prog, fnName, c, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, t, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, e, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed)
    },
    TmWhile(c, b) -> {
        scanSendDemandsInTerm(prog, fnName, c, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
        scanSendDemandsInTerm(prog, fnName, b, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed)
    },
    TmMatch(s, arms) -> {
        scanSendDemandsInTerm(prog, fnName, s, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(prog, fnName, a.caBody, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> {
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    scanSendDemandsInTerm(prog, fnName, a, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmGetTag(e1) -> scanSendDemandsInTerm(prog, fnName, e1, paramSet, letRhs, localCls, paramShared, clsReqShared, retReqShared, changed),
    _ -> (),
}

def isTypeNonSendInDump(adtLocal: StrMap Bool, ty: Type, fnMode: String): Bool = match ty {
    TyVoid -> false,
    TyCon(n) ->
        if (n == "Cell" || n == "MutArray" || n == "Ptr") true
        else strMapContains(adtLocal, n),
    TyArr(_, _, _) -> fnMode == "local",
    TyTuple(es) -> {
        let bad = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(bad) }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    if (isTypeNonSendInDump(adtLocal, t, fnMode)) cellSet(bad, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(bad)
    },
    TyComp(_, _) -> {
        let base = compBaseName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Cell" || base == "MutArray") true
        else if (base == "Actor") false
        else if (strMapContains(adtLocal, base)) true
        else {
            let bad = cellNew(false);
            let cur = cellNew(targs);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(bad) }) {
                match cellGet(cur) {
                    Cons(t, r) -> {
                        if (isTypeNonSendInDump(adtLocal, t, fnMode)) cellSet(bad, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(bad)
        }
    },
    TyVar(_) -> false,
}

def bindPatNonSendVars(
    adtLocal: StrMap Bool,
    pat: Pattern,
    scrutNonSend: Bool,
    nonSendVars: StrMap Bool
): Void = match pat {
    PatWild -> (),
    PatLit(_) -> (),
    PatVar(x) -> if (scrutNonSend) strMapInsert(nonSendVars, x, true) else (),
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    bindPatNonSendVars(adtLocal, p, scrutNonSend, nonSendVars);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    PatCtor(_, ps) -> {
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    bindPatNonSendVars(adtLocal, p, scrutNonSend, nonSendVars);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    PatStruct(_, _) -> (),
}

def propagateLocalInTerm(
    prog: CoreProgram,
    tm: TaggedTerm,
    nonSendVars: StrMap Bool,
    fvNonSend: StrMap Bool,
    clsLocal: StrMap Bool,
    retLocal: StrMap Bool,
    adtLocal: StrMap Bool,
    changed: Cell Bool
): Bool = match tm.tnode {
    TmLit(_) -> false,
    TmVar(x) ->
        strMapContains(nonSendVars, x)
        || isTypeNonSendInDump(adtLocal, schemeBody(tm.tscm), "shared"),
    TmGlobalVar(_) -> true,
    TmTuple(es) -> {
        let anyLocal = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    if (propagateLocalInTerm(prog, a, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed)) {
                        cellSet(anyLocal, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(anyLocal)
    },
    TmBlock(es) -> {
        let lastLocal = cellNew(false);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let isLoc = propagateLocalInTerm(prog, a, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
                    cellSet(lastLocal, isLoc);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(lastLocal)
    },
    TmMakeCls(vd, cls, body) -> {
        let cf = cellNew(cls.clsFvs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fvName, r) -> {
                    if (strMapContains(nonSendVars, fvName)) {
                        markStrMap(clsLocal, cls.clsEntry, changed);
                        markStrMap(fvNonSend, cls.clsEntry + ":" + fvName, changed)
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        if (strMapContains(clsLocal, cls.clsEntry)) {
            strMapInsert(nonSendVars, vd.vname, true)
        } else ();
        propagateLocalInTerm(prog, body, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed)
    },
    TmApplyCls(c, args) -> {
        let _ = propagateLocalInTerm(prog, c, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let _ = propagateLocalInTerm(prog, a, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        isTypeNonSendInDump(adtLocal, schemeBody(tm.tscm), "shared")
    },
    TmApplyDir(vd, args) -> {
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let _ = propagateLocalInTerm(prog, a, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        if (vd.vname == "cellNew") true
        else strMapContains(retLocal, vd.vname) || isTypeNonSendInDump(adtLocal, schemeBody(tm.tscm), "shared")
    },
    TmBin(_, l, r) -> {
        let _ = propagateLocalInTerm(prog, l, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        let _ = propagateLocalInTerm(prog, r, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        false
    },
    TmUn(_, e1) -> {
        let _ = propagateLocalInTerm(prog, e1, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        false
    },
    TmLet(vd, e1, e2) -> {
        let v1Local = propagateLocalInTerm(prog, e1, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        if (v1Local || isTypeNonSendInDump(adtLocal, schemeBody(vd.vscm), "shared")) {
            strMapInsert(nonSendVars, vd.vname, true)
        } else ();
        propagateLocalInTerm(prog, e2, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed)
    },
    TmIf(c, t, e) -> {
        let _ = propagateLocalInTerm(prog, c, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        let tLoc = propagateLocalInTerm(prog, t, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        let eLoc = propagateLocalInTerm(prog, e, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        tLoc || eLoc
    },
    TmWhile(c, b) -> {
        let _ = propagateLocalInTerm(prog, c, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        let _ = propagateLocalInTerm(prog, b, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        false
    },
    TmMatch(s, arms) -> {
        let sLoc = propagateLocalInTerm(prog, s, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        let anyArmLoc = cellNew(false);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arm, r) -> {
                    bindPatNonSendVars(adtLocal, arm.caPat, sLoc, nonSendVars);
                    if (propagateLocalInTerm(prog, arm.caBody, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed)) {
                        cellSet(anyArmLoc, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(anyArmLoc)
    },
    TmMakeData(adtName, _, args, _, _) -> {
        let anyArgLoc = cellNew(false);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    if (propagateLocalInTerm(prog, a, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed)) {
                        cellSet(anyArgLoc, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        if (cellGet(anyArgLoc)) {
            markStrMap(adtLocal, adtName, changed)
        } else ();
        strMapContains(adtLocal, adtName) || cellGet(anyArgLoc)
    },
    TmGetTag(e1) -> {
        let _ = propagateLocalInTerm(prog, e1, nonSendVars, fvNonSend, clsLocal, retLocal, adtLocal, changed);
        false
    },
}

def analyzeCoreModes(
    prog: CoreProgram,
    activeFnNames: List String,
    paramShared: StrMap Bool,
    clsLocal: StrMap Bool,
    retLocal: StrMap Bool,
    adtLocal: StrMap Bool
): Void = {
    let clsReqShared: StrMap Bool = strMapNew();
    let retReqShared: StrMap Bool = strMapNew();

    // Pass 1: Backward demand from `__concTaskSpawn`
    let changed1 = cellNew(true);
    while (cellGet(changed1)) {
        cellSet(changed1, false);
        let cf = cellNew(activeFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            let paramSet: StrMap Bool = strMapNew();
                            let cp = cellNew(fd.fnParams);
                            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                match cellGet(cp) {
                                    Cons(pvd, pr) -> {
                                        strMapInsert(paramSet, pvd.vname, true);
                                        cellSet(cp, pr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let cfv = cellNew(fd.fnFvs);
                            while (match cellGet(cfv) { Nil -> false, _ -> true }) {
                                match cellGet(cfv) {
                                    Cons(fvd, fr) -> {
                                        strMapInsert(paramSet, fvd.vname, true);
                                        cellSet(cfv, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let letRhs: StrMap TaggedTerm = strMapNew();
                            let localCls: StrMap ClosureSpec = strMapNew();
                            collectBodyBindings(fd.fnBody, letRhs, localCls);
                            scanSendDemandsInTerm(
                                prog, fnName, fd.fnBody, paramSet, letRhs, localCls,
                                paramShared, clsReqShared, retReqShared, changed1
                            );
                            if (strMapContains(retReqShared, fnName)) {
                                let vset: StrMap Bool = strMapNew();
                                requireTermSend(
                                    fnName, fd.fnBody, paramSet, letRhs, localCls, vset,
                                    paramShared, clsReqShared, retReqShared, changed1
                                )
                            } else ()
                        },
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    };

    // Pass 2: Forward propagation of `local` (`!Send`) captures & return values
    let fvNonSend: StrMap Bool = strMapNew();
    let changed2 = cellNew(true);
    while (cellGet(changed2)) {
        cellSet(changed2, false);
        let cf = cellNew(activeFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            let nonSendVars: StrMap Bool = strMapNew();
                            let cp = cellNew(fd.fnParams);
                            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                match cellGet(cp) {
                                    Cons(pvd, pr) -> {
                                        let pMode = if (strMapContains(paramShared, fnName + ":" + pvd.vname)) "shared" else "local";
                                        if (isTypeNonSendInDump(adtLocal, schemeBody(pvd.vscm), pMode)) {
                                            strMapInsert(nonSendVars, pvd.vname, true)
                                        } else ();
                                        cellSet(cp, pr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let cfv = cellNew(fd.fnFvs);
                            while (match cellGet(cfv) { Nil -> false, _ -> true }) {
                                match cellGet(cfv) {
                                    Cons(fvd, fr) -> {
                                        if (strMapContains(fvNonSend, fnName + ":" + fvd.vname)
                                            || isTypeNonSendInDump(adtLocal, schemeBody(fvd.vscm), "shared")) {
                                            strMapInsert(nonSendVars, fvd.vname, true)
                                        } else ();
                                        cellSet(cfv, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            let bodyLoc = propagateLocalInTerm(
                                prog, fd.fnBody, nonSendVars, fvNonSend,
                                clsLocal, retLocal, adtLocal, changed2
                            );
                            if (bodyLoc) {
                                markStrMap(retLocal, fnName, changed2)
                            } else ()
                        },
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    }
}

// ============================================================================
// Core Type, Pattern, and Term S-Expression Serialization
// ============================================================================

def registerCoreAdt(ctx: DumpCtx, baseName: String, targs: List Type): String = {
    let mangled = mangleCoreAdt(baseName, targs);
    if (!strMapContains(ctx.dcInstAdts, mangled)) {
        strMapInsert(ctx.dcInstAdts, mangled, (baseName, targs));
        cellSet(ctx.dcInstAdtOrder, Cons(mangled, cellGet(ctx.dcInstAdtOrder)));
        let fMode = if (strMapContains(ctx.dcAdtLocal, baseName)) "local" else "shared";
        match strMapGet(ctx.dcProg.coreAdtReg, baseName) {
            Some(ainfo) -> {
                let sub = buildPairMap(ainfo.typeParams, targs);
                let cv = cellNew(ainfo.variants);
                while (match cellGet(cv) { Nil -> false, _ -> true }) {
                    match cellGet(cv) {
                        Cons(vi, r) -> {
                            let cf = cellNew(vi.fieldTypes);
                            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                match cellGet(cf) {
                                    Cons(ft, fr) -> {
                                        let instFt = applyExplicitSubst(ft, sub);
                                        let tmp = bufNew();
                                        emitCoreTyWithMode(ctx, tmp, instFt, fMode);
                                        cellSet(cf, fr)
                                    },
                                    Nil -> (),
                                }
                            };
                            cellSet(cv, r)
                        },
                        Nil -> (),
                    }
                }
            },
            None -> setDumpErr(ctx, "Unknown ADT '" + baseName + "'"),
        }
    } else ();
    mangled
}

def emitCoreTyWithMode(ctx: DumpCtx, b: StringBuf, ty: Type, fnMode: String): Void = match ty {
    TyVoid -> bufPushStr(b, "void"),
    TyCon(n) ->
        if (n == "Void") bufPushStr(b, "void")
        else if (n == "Int") bufPushStr(b, "int")
        else if (n == "Bool") bufPushStr(b, "bool")
        else if (n == "String") bufPushStr(b, "str")
        else if (strMapContains(ctx.dcProg.coreAdtReg, n)) {
            let m = registerCoreAdt(ctx, n, Nil);
            bufPushStr(b, "(adt ");
            pushQuotedStr(b, m);
            bufPushByte(b, 41)
        } else {
            setDumpErr(ctx, "Type '" + n + "' is outside the Core Geisha subset");
            bufPushStr(b, "void")
        },
    TyTuple(es) -> {
        bufPushStr(b, "(tuple");
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(t, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTyWithMode(ctx, b, t, fnMode);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TyArr(_, ps, ret) -> {
        bufPushStr(b, "(fn ");
        bufPushStr(b, fnMode);
        bufPushStr(b, " (");
        let first = cellNew(true);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    if (!cellGet(first)) bufPushByte(b, 32) else cellSet(first, false);
                    emitCoreTyWithMode(ctx, b, p, fnMode);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushStr(b, ") ");
        emitCoreTyWithMode(ctx, b, ret, fnMode);
        bufPushByte(b, 41)
    },
    TyComp(_, _) -> {
        let base = compBaseName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Cell") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(cell ");
                    emitCoreTyWithMode(ctx, b, elemTy, fnMode);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Cell type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "Task") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(task ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Task type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "MVar") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(mvar ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid MVar type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "Chan") {
            match targs {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(chan ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Chan type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (base == "Actor") {
            match targs {
                Cons(stateTy, Nil) -> {
                    bufPushStr(b, "(actor ");
                    emitCoreTyWithMode(ctx, b, stateTy, "local");
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "Invalid Actor type application");
                    bufPushStr(b, "void")
                },
            }
        } else if (strMapContains(ctx.dcProg.coreAdtReg, base)) {
            let m = registerCoreAdt(ctx, base, targs);
            bufPushStr(b, "(adt ");
            pushQuotedStr(b, m);
            bufPushByte(b, 41)
        } else {
            setDumpErr(ctx, "Parameterized type '" + base + "' is outside the Core Geisha subset");
            bufPushStr(b, "void")
        }
    },
    TyVar(v) -> {
        setDumpErr(ctx, "Unmonomorphized type variable '" + v + "' in Core IR");
        bufPushStr(b, "void")
    },
}

def emitCoreLit(ctx: DumpCtx, b: StringBuf, l: Lit): Void = match l {
    LitInt(n) -> {
        bufPushStr(b, "(lit-int ");
        bufPushStr(b, intToStr(n));
        bufPushByte(b, 41)
    },
    LitBool(v) ->
        if (v) bufPushStr(b, "(lit-bool true)")
        else bufPushStr(b, "(lit-bool false)"),
    LitStr(s) -> {
        bufPushStr(b, "(lit-str ");
        pushQuotedStr(b, s);
        bufPushByte(b, 41)
    },
    LitUnit -> bufPushStr(b, "(lit-unit)"),
    LitFloat(_) -> {
        setDumpErr(ctx, "Float literal is outside the Core Geisha subset");
        bufPushStr(b, "(lit-unit)")
    },
    LitChar(_) -> {
        setDumpErr(ctx, "Char literal is outside the Core Geisha subset");
        bufPushStr(b, "(lit-unit)")
    },
}

def emitCorePat(ctx: DumpCtx, b: StringBuf, pat: Pattern, scrutTy: Type): Void = match pat {
    PatWild -> bufPushStr(b, "wild"),
    PatVar(x) -> {
        bufPushStr(b, "(pvar ");
        pushQuotedStr(b, x);
        bufPushByte(b, 41)
    },
    PatLit(l) -> {
        bufPushStr(b, "(plit ");
        emitCoreLit(ctx, b, l);
        bufPushByte(b, 41)
    },
    PatTuple(ps) -> {
        bufPushStr(b, "(ptuple");
        let elemTys = match scrutTy {
            TyTuple(ts) -> ts,
            _ -> Nil,
        };
        let cp = cellNew(ps);
        let ct = cellNew(elemTys);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(p, pr) -> {
                    let et = match cellGet(ct) {
                        Cons(t, tr) -> { cellSet(ct, tr); t },
                        Nil -> TyVoid,
                    };
                    bufPushByte(b, 32);
                    emitCorePat(ctx, b, p, et);
                    cellSet(cp, pr)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    PatCtor(cname, ps) -> {
        let baseName = compBaseName(scrutTy);
        let targs = extractTypeArgs(scrutTy);
        let mangled = registerCoreAdt(ctx, baseName, targs);
        match strMapGet(ctx.dcProg.coreAdtReg, baseName) {
            Some(ainfo) -> match findVariantByName(ainfo.variants, cname) {
                Some(vi) -> {
                    let sub = buildPairMap(ainfo.typeParams, targs);
                    let rev = cellNew(Nil);
                    let cf = cellNew(vi.fieldTypes);
                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                        match cellGet(cf) {
                            Cons(ft, fr) -> {
                                cellSet(rev, Cons(applyExplicitSubst(ft, sub), cellGet(rev)));
                                cellSet(cf, fr)
                            },
                            Nil -> (),
                        }
                    };
                    let fldTys = listRev(cellGet(rev));
                    bufPushStr(b, "(pctor ");
                    pushQuotedStr(b, mangled);
                    bufPushByte(b, 32);
                    bufPushStr(b, intToStr(vi.tag));
                    let cp = cellNew(ps);
                    let ct = cellNew(fldTys);
                    while (match cellGet(cp) { Nil -> false, _ -> true }) {
                        match cellGet(cp) {
                            Cons(p, pr) -> {
                                let ft = match cellGet(ct) {
                                    Cons(t, tr) -> { cellSet(ct, tr); t },
                                    Nil -> TyVoid,
                                };
                                bufPushByte(b, 32);
                                emitCorePat(ctx, b, p, ft);
                                cellSet(cp, pr)
                            },
                            Nil -> (),
                        }
                    };
                    bufPushByte(b, 41)
                },
                None -> {
                    setDumpErr(ctx, "Unknown constructor pattern '" + cname + "'");
                    bufPushStr(b, "wild")
                },
            },
            None -> {
                setDumpErr(ctx, "Unknown ADT '" + baseName + "' in constructor pattern");
                bufPushStr(b, "wild")
            },
        }
    },
    PatStruct(cname, _) -> {
        setDumpErr(ctx, "Unnormalized struct pattern '" + cname + "' in Core IR");
        bufPushStr(b, "wild")
    },
}

def binOpCoreName(op: BinOp, lhsTy: Type): Option String = {
    let tyName = match lhsTy { TyCon(n) -> n, _ -> "" };
    match op {
        OpAdd -> if (tyName == "String") Some("strConcat") else if (tyName == "Int") Some("add") else None,
        OpSub -> if (tyName == "Int") Some("sub") else None,
        OpMul -> if (tyName == "Int") Some("mul") else None,
        OpDiv -> if (tyName == "Int") Some("div") else None,
        OpRem -> if (tyName == "Int") Some("rem") else None,
        OpBitAnd -> if (tyName == "Int") Some("bitAnd") else None,
        OpBitOr -> if (tyName == "Int") Some("bitOr") else None,
        OpBitXor -> if (tyName == "Int") Some("bitXor") else None,
        OpAnd -> Some("and"),
        OpOr -> Some("or"),
        OpEq ->
            if (tyName == "Int") Some("eqInt")
            else if (tyName == "Bool") Some("eqBool")
            else if (tyName == "String") Some("eqStr")
            else None,
        OpNe -> if (tyName == "Int") Some("neInt") else None,
        OpLt -> if (tyName == "Int") Some("ltInt") else None,
        OpLe -> if (tyName == "Int") Some("leInt") else None,
        OpGt -> if (tyName == "Int") Some("gtInt") else None,
        OpGe -> if (tyName == "Int") Some("geInt") else None,
        _ -> None,
    }
}

def emitParamList(ctx: DumpCtx, b: StringBuf, fnName: String, params: List VarDecl): Void = {
    bufPushByte(b, 40);
    let first = cellNew(true);
    let cur = cellNew(params);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(vd, r) -> {
                if (!cellGet(first)) bufPushByte(b, 32) else cellSet(first, false);
                let pMode = if (strMapContains(ctx.dcParamShared, fnName + ":" + vd.vname)) "shared" else "local";
                bufPushByte(b, 40);
                pushQuotedStr(b, vd.vname);
                bufPushByte(b, 32);
                emitCoreTyWithMode(ctx, b, schemeBody(vd.vscm), pMode);
                bufPushByte(b, 41);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(b, 41)
}

def emitCoreTerm(ctx: DumpCtx, b: StringBuf, tm: TaggedTerm): Void = match tm.tnode {
    TmLit(l) -> emitCoreLit(ctx, b, l),
    TmVar(x) -> {
        bufPushStr(b, "(var ");
        pushQuotedStr(b, x);
        bufPushByte(b, 41)
    },
    TmGlobalVar(g) -> {
        setDumpErr(ctx, "Global variable '" + g + "' is outside the Core Geisha subset");
        bufPushStr(b, "(lit-unit)")
    },
    TmTuple(es) -> {
        bufPushStr(b, "(tuple");
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, e);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmBlock(es) -> {
        bufPushStr(b, "(block");
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, e);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmMakeCls(vd, cls, body) -> {
        match strMapGet(ctx.dcProg.coreFns, cls.clsEntry) {
            Some(fd) -> {
                let retTy = match schemeBody(fd.fnScm) {
                    TyArr(_, _, r) -> r,
                    other -> other,
                };
                let clsMode = if (strMapContains(ctx.dcClsLocal, cls.clsEntry)) "local" else "shared";
                let rMode = if (strMapContains(ctx.dcRetLocal, fd.fnName)) "local" else "shared";
                bufPushStr(b, "(let ");
                pushQuotedStr(b, vd.vname);
                bufPushStr(b, " (lam ");
                bufPushStr(b, clsMode);
                bufPushByte(b, 32);
                emitParamList(ctx, b, fd.fnName, fd.fnParams);
                bufPushByte(b, 32);
                emitCoreTyWithMode(ctx, b, retTy, rMode);
                bufPushByte(b, 32);
                emitCoreTerm(ctx, b, fd.fnBody);
                bufPushStr(b, ") ");
                emitCoreTerm(ctx, b, body);
                bufPushByte(b, 41)
            },
            None -> {
                setDumpErr(ctx, "Missing closure entry '" + cls.clsEntry + "'");
                bufPushStr(b, "(lit-unit)")
            },
        }
    },
    TmApplyCls(fnTm, args) -> {
        bufPushStr(b, "(apply ");
        emitCoreTerm(ctx, b, fnTm);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmApplyDir(vd, args) -> {
        if (vd.vname == "cellNew") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(cell-new ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "cellNew expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "cellGet") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(cell-get ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "cellGet expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "cellSet") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(cell-set ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "cellSet expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concTaskSpawn") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(spawn ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concTaskSpawn expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concTaskAwait") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(await ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concTaskAwait expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarNew") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim mvar-new ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarNew expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarEmpty") {
            let retTy = schemeBody(tm.tscm);
            match extractTypeArgs(retTy) {
                Cons(elemTy, Nil) -> {
                    bufPushStr(b, "(conc-prim (mvar-empty ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushStr(b, "))")
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarEmpty return type must be MVar");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarTake") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim mvar-take ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarTake expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concMVarPut") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim mvar-put ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concMVarPut expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concChanNew") {
            let retTy = schemeBody(tm.tscm);
            match (args, extractTypeArgs(retTy)) {
                (Cons(a0, Nil), Cons(elemTy, Nil)) -> {
                    bufPushStr(b, "(conc-prim (chan-new ");
                    emitCoreTyWithMode(ctx, b, elemTy, "shared");
                    bufPushStr(b, ") ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concChanNew invalid arguments or return type");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concChanSend") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim chan-send ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concChanSend expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (isChanRecvWrapper(ctx.dcProg, vd.vname)) {
            let retTy = schemeBody(tm.tscm);
            let optMangled = registerCoreAdt(ctx, compBaseName(retTy), extractTypeArgs(retTy));
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim (chan-recv ");
                    pushQuotedStr(b, optMangled);
                    bufPushStr(b, ") ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "chanRecv expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concChanClose") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim chan-close ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concChanClose expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concActorSpawn") {
            match args {
                Cons(a0, Nil) -> {
                    bufPushStr(b, "(conc-prim actor-spawn ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concActorSpawn expects 1 argument");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concActorCall") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim actor-call ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concActorCall expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (vd.vname == "__concActorSend") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> {
                    bufPushStr(b, "(conc-prim actor-send ");
                    emitCoreTerm(ctx, b, a0);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a1);
                    bufPushByte(b, 41)
                },
                _ -> {
                    setDumpErr(ctx, "__concActorSend expects 2 arguments");
                    bufPushStr(b, "(lit-unit)")
                },
            }
        } else if (strMapContains(ctx.dcProg.coreFns, vd.vname)) {
            bufPushStr(b, "(apply-dir ");
            pushQuotedStr(b, vd.vname);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        bufPushByte(b, 32);
                        emitCoreTerm(ctx, b, a);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            bufPushByte(b, 41)
        } else {
            setDumpErr(ctx, "Builtin/extern call '" + vd.vname + "' is outside the Core Geisha subset");
            bufPushStr(b, "(lit-unit)")
        }
    },
    TmBin(op, e1, e2) -> {
        match binOpCoreName(op, schemeBody(e1.tscm)) {
            Some(opName) -> {
                bufPushStr(b, "(bin ");
                bufPushStr(b, opName);
                bufPushByte(b, 32);
                emitCoreTerm(ctx, b, e1);
                bufPushByte(b, 32);
                emitCoreTerm(ctx, b, e2);
                bufPushByte(b, 41)
            },
            None -> {
                setDumpErr(ctx, "Binary operator is outside the Core Geisha subset");
                bufPushStr(b, "(lit-unit)")
            },
        }
    },
    TmUn(op, e1) -> {
        let opName = match op {
            UnNot -> "not",
            UnNeg -> "neg",
            UnBitNot -> "bitNot",
        };
        bufPushStr(b, "(un ");
        bufPushStr(b, opName);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e1);
        bufPushByte(b, 41)
    },
    TmLet(vd, e1, e2) -> {
        bufPushStr(b, "(let ");
        pushQuotedStr(b, vd.vname);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e1);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e2);
        bufPushByte(b, 41)
    },
    TmIf(c, t, e) -> {
        bufPushStr(b, "(if ");
        emitCoreTerm(ctx, b, c);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, t);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, e);
        bufPushByte(b, 41)
    },
    TmWhile(c, body) -> {
        bufPushStr(b, "(while ");
        emitCoreTerm(ctx, b, c);
        bufPushByte(b, 32);
        emitCoreTerm(ctx, b, body);
        bufPushByte(b, 41)
    },
    TmMatch(scrut, arms) -> {
        bufPushStr(b, "(match ");
        emitCoreTerm(ctx, b, scrut);
        let scrutTy = schemeBody(scrut.tscm);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arm, r) -> {
                    match arm.caGuard {
                        Some(_) -> setDumpErr(ctx, "Pattern guard is outside Core Geisha v1 subset"),
                        None -> (),
                    };
                    bufPushStr(b, " (arm ");
                    emitCorePat(ctx, b, arm.caPat, scrutTy);
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, arm.caBody);
                    bufPushByte(b, 41);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmMakeData(adtName, tag, args, _, targs) -> {
        let mangled = registerCoreAdt(ctx, adtName, targs);
        bufPushStr(b, "(make-data ");
        pushQuotedStr(b, mangled);
        bufPushByte(b, 32);
        bufPushStr(b, intToStr(tag));
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    bufPushByte(b, 32);
                    emitCoreTerm(ctx, b, a);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 41)
    },
    TmGetTag(e1) -> {
        bufPushStr(b, "(get-tag ");
        emitCoreTerm(ctx, b, e1);
        bufPushByte(b, 41)
    },
}

def markReachFn(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool,
    wl: Cell (List String),
    name: String,
    isDir: Bool
): Void =
    if (strMapContains(prog.coreFns, name)) {
        if (isDir) {
            strMapInsert(dirReach, name, true)
        } else ();
        if (!strMapContains(allReach, name)) {
            strMapInsert(allReach, name, true);
            cellSet(wl, Cons(name, cellGet(wl)))
        } else ()
    } else ()

def scanReachTermList(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool,
    wl: Cell (List String),
    es: List TaggedTerm
): Void = {
    let cur = cellNew(es);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(e, r) -> {
                scanReachTerm(prog, allReach, dirReach, wl, e);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def scanReachTerm(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool,
    wl: Cell (List String),
    tm: TaggedTerm
): Void = match tm.tnode {
    TmLit(_) -> (),
    TmVar(_) -> (),
    TmGlobalVar(_) -> (),
    TmTuple(es) -> scanReachTermList(prog, allReach, dirReach, wl, es),
    TmBlock(es) -> scanReachTermList(prog, allReach, dirReach, wl, es),
    TmMakeCls(_, cls, body) -> {
        markReachFn(prog, allReach, dirReach, wl, cls.clsEntry, false);
        scanReachTerm(prog, allReach, dirReach, wl, body)
    },
    TmApplyCls(fnTm, args) -> {
        scanReachTerm(prog, allReach, dirReach, wl, fnTm);
        scanReachTermList(prog, allReach, dirReach, wl, args)
    },
    TmApplyDir(vd, args) -> {
        if (!isChanRecvWrapper(prog, vd.vname)) {
            markReachFn(prog, allReach, dirReach, wl, vd.vname, true)
        } else ();
        scanReachTermList(prog, allReach, dirReach, wl, args)
    },
    TmBin(_, e1, e2) -> {
        scanReachTerm(prog, allReach, dirReach, wl, e1);
        scanReachTerm(prog, allReach, dirReach, wl, e2)
    },
    TmUn(_, e1) -> scanReachTerm(prog, allReach, dirReach, wl, e1),
    TmLet(_, e1, e2) -> {
        scanReachTerm(prog, allReach, dirReach, wl, e1);
        scanReachTerm(prog, allReach, dirReach, wl, e2)
    },
    TmIf(c, t, e) -> {
        scanReachTerm(prog, allReach, dirReach, wl, c);
        scanReachTerm(prog, allReach, dirReach, wl, t);
        scanReachTerm(prog, allReach, dirReach, wl, e)
    },
    TmWhile(c, body) -> {
        scanReachTerm(prog, allReach, dirReach, wl, c);
        scanReachTerm(prog, allReach, dirReach, wl, body)
    },
    TmMatch(scrut, arms) -> {
        scanReachTerm(prog, allReach, dirReach, wl, scrut);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arm, r) -> {
                    match arm.caGuard {
                        Some(g) -> scanReachTerm(prog, allReach, dirReach, wl, g),
                        None -> (),
                    };
                    scanReachTerm(prog, allReach, dirReach, wl, arm.caBody);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> scanReachTermList(prog, allReach, dirReach, wl, args),
    TmGetTag(e1) -> scanReachTerm(prog, allReach, dirReach, wl, e1),
}

def collectReachableCoreFns(
    prog: CoreProgram,
    allReach: StrMap Bool,
    dirReach: StrMap Bool
): List String =
    if (!strMapContains(prog.coreFns, "main")) {
        let cf = cellNew(prog.coreFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    strMapInsert(allReach, fnName, true);
                    strMapInsert(dirReach, fnName, true);
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        prog.coreFnNames
    } else {
        let wl: Cell (List String) = cellNew(Nil);
        markReachFn(prog, allReach, dirReach, wl, "main", true);
        while (match cellGet(wl) { Nil -> false, _ -> true }) {
            match cellGet(wl) {
                Cons(fnName, rest) -> {
                    cellSet(wl, rest);
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> scanReachTerm(prog, allReach, dirReach, wl, fd.fnBody),
                        None -> (),
                    }
                },
                Nil -> (),
            }
        };
        let revAcc: Cell (List String) = cellNew(Nil);
        let cf = cellNew(prog.coreFnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnName, r) -> {
                    if (strMapContains(allReach, fnName)) {
                        cellSet(revAcc, Cons(fnName, cellGet(revAcc)))
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        listRev(cellGet(revAcc))
    }

def listContainsStrDump(xs: List String, target: String): Bool = match xs {
    Nil -> false,
    Cons(h, t) -> if (h == target) true else listContainsStrDump(t, target),
}

def patBindsNameDump(pat: Pattern, target: String): Bool = match pat {
    PatWild -> false,
    PatLit(_) -> false,
    PatVar(x) -> x == target,
    PatTuple(ps) -> patListBindsNameDump(ps, target),
    PatCtor(_, ps) -> patListBindsNameDump(ps, target),
    PatStruct(_, _) -> false,
}

def patListBindsNameDump(ps: List Pattern, target: String): Bool = match ps {
    Nil -> false,
    Cons(p, r) -> if (patBindsNameDump(p, target)) true else patListBindsNameDump(r, target),
}

def termMentionsVarDump(prog: CoreProgram, tm: TaggedTerm, x: String): Bool = match tm.tnode {
    TmLit(_) -> false,
    TmVar(y) -> y == x,
    TmGlobalVar(_) -> false,
    TmTuple(es) -> termListMentionsVarDump(prog, es, x),
    TmBlock(es) -> termListMentionsVarDump(prog, es, x),
    TmMakeCls(vd, cls, body) ->
        vd.vname == x
        || listContainsStrDump(cls.clsFvs, x)
        || (match strMapGet(prog.coreFns, cls.clsEntry) {
            Some(cfd) -> termMentionsVarDump(prog, cfd.fnBody, x),
            None -> false,
        })
        || termMentionsVarDump(prog, body, x),
    TmApplyCls(fnTm, args) ->
        termMentionsVarDump(prog, fnTm, x) || termListMentionsVarDump(prog, args, x),
    TmApplyDir(_, args) -> termListMentionsVarDump(prog, args, x),
    TmBin(_, e1, e2) ->
        termMentionsVarDump(prog, e1, x) || termMentionsVarDump(prog, e2, x),
    TmUn(_, e1) -> termMentionsVarDump(prog, e1, x),
    TmLet(vd, e1, e2) ->
        vd.vname == x || termMentionsVarDump(prog, e1, x) || termMentionsVarDump(prog, e2, x),
    TmIf(c, t, e) ->
        termMentionsVarDump(prog, c, x) || termMentionsVarDump(prog, t, x) || termMentionsVarDump(prog, e, x),
    TmWhile(c, b) ->
        termMentionsVarDump(prog, c, x) || termMentionsVarDump(prog, b, x),
    TmMatch(s, arms) -> {
        if (termMentionsVarDump(prog, s, x)) true
        else {
            let hit = cellNew(false);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        if (patBindsNameDump(a.caPat, x) || termMentionsVarDump(prog, a.caBody, x)) {
                            cellSet(hit, true)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        }
    },
    TmMakeData(_, _, args, _, _) -> termListMentionsVarDump(prog, args, x),
    TmGetTag(e1) -> termMentionsVarDump(prog, e1, x),
}

def termListMentionsVarDump(prog: CoreProgram, es: List TaggedTerm, x: String): Bool = match es {
    Nil -> false,
    Cons(h, t) -> if (termMentionsVarDump(prog, h, x)) true else termListMentionsVarDump(prog, t, x),
}

def onlyDirectCellOpsDump(prog: CoreProgram, tm: TaggedTerm, x: String): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(y) -> y != x,
    TmGlobalVar(_) -> true,
    TmTuple(es) -> onlyDirectCellOpsListDump(prog, es, x),
    TmBlock(es) -> onlyDirectCellOpsListDump(prog, es, x),
    TmMakeCls(vd, cls, body) ->
        vd.vname != x
        && !listContainsStrDump(cls.clsFvs, x)
        && (match strMapGet(prog.coreFns, cls.clsEntry) {
            Some(cfd) ->
                !listContainsStrDump(
                    {
                        let rev = cellNew(Nil);
                        let cp = cellNew(cfd.fnParams);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(pvd, pr) -> {
                                    cellSet(rev, Cons(pvd.vname, cellGet(rev)));
                                    cellSet(cp, pr)
                                },
                                Nil -> (),
                            }
                        };
                        cellGet(rev)
                    },
                    x
                ) && !termMentionsVarDump(prog, cfd.fnBody, x),
            None -> false,
        })
        && onlyDirectCellOpsDump(prog, body, x),
    TmApplyCls(fnTm, args) ->
        onlyDirectCellOpsDump(prog, fnTm, x) && onlyDirectCellOpsListDump(prog, args, x),
    TmApplyDir(vd, args) ->
        if (vd.vname == "cellGet") {
            match args {
                Cons(a0, Nil) -> match a0.tnode {
                    TmVar(y) -> if (y == x) true else onlyDirectCellOpsDump(prog, a0, x),
                    _ -> onlyDirectCellOpsDump(prog, a0, x),
                },
                _ -> false,
            }
        } else if (vd.vname == "cellSet") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> match a0.tnode {
                    TmVar(y) ->
                        if (y == x) onlyDirectCellOpsDump(prog, a1, x)
                        else onlyDirectCellOpsDump(prog, a0, x) && onlyDirectCellOpsDump(prog, a1, x),
                    _ -> onlyDirectCellOpsDump(prog, a0, x) && onlyDirectCellOpsDump(prog, a1, x),
                },
                _ -> false,
            }
        } else onlyDirectCellOpsListDump(prog, args, x),
    TmBin(_, e1, e2) ->
        onlyDirectCellOpsDump(prog, e1, x) && onlyDirectCellOpsDump(prog, e2, x),
    TmUn(_, e1) -> onlyDirectCellOpsDump(prog, e1, x),
    TmLet(vd, e1, e2) ->
        vd.vname != x && onlyDirectCellOpsDump(prog, e1, x) && onlyDirectCellOpsDump(prog, e2, x),
    TmIf(c, t, e) ->
        onlyDirectCellOpsDump(prog, c, x) && onlyDirectCellOpsDump(prog, t, x) && onlyDirectCellOpsDump(prog, e, x),
    TmWhile(c, b) ->
        onlyDirectCellOpsDump(prog, c, x) && onlyDirectCellOpsDump(prog, b, x),
    TmMatch(s, arms) -> {
        if (!onlyDirectCellOpsDump(prog, s, x)) false
        else {
            let ok = cellNew(true);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        if (patBindsNameDump(a.caPat, x) || !onlyDirectCellOpsDump(prog, a.caBody, x)) {
                            cellSet(ok, false)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(ok)
        }
    },
    TmMakeData(_, _, args, _, _) -> onlyDirectCellOpsListDump(prog, args, x),
    TmGetTag(e1) -> onlyDirectCellOpsDump(prog, e1, x),
}

def onlyDirectCellOpsListDump(prog: CoreProgram, es: List TaggedTerm, x: String): Bool = match es {
    Nil -> true,
    Cons(h, t) -> if (onlyDirectCellOpsDump(prog, h, x)) onlyDirectCellOpsListDump(prog, t, x) else false,
}

def checkStackVarInCoreDump(prog: CoreProgram, tm: TaggedTerm, x: String): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(y) -> y != x,
    TmGlobalVar(_) -> true,
    TmTuple(es) -> checkStackVarInCoreListDump(prog, es, x),
    TmBlock(es) -> checkStackVarInCoreListDump(prog, es, x),
    TmMakeCls(vd, cls, body) ->
        vd.vname != x
        && !listContainsStrDump(cls.clsFvs, x)
        && (match strMapGet(prog.coreFns, cls.clsEntry) {
            Some(cfd) -> !termMentionsVarDump(prog, cfd.fnBody, x),
            None -> false,
        })
        && checkStackVarInCoreDump(prog, body, x),
    TmApplyCls(fnTm, args) ->
        checkStackVarInCoreDump(prog, fnTm, x) && checkStackVarInCoreListDump(prog, args, x),
    TmApplyDir(_, args) -> checkStackVarInCoreListDump(prog, args, x),
    TmBin(_, e1, e2) ->
        checkStackVarInCoreDump(prog, e1, x) && checkStackVarInCoreDump(prog, e2, x),
    TmUn(_, e1) -> checkStackVarInCoreDump(prog, e1, x),
    TmLet(vd, e1, e2) ->
        if (vd.vname == x) {
            match e1.tnode {
                TmApplyDir(fvd, Cons(init, Nil)) ->
                    fvd.vname == "cellNew"
                    && !termMentionsVarDump(prog, init, x)
                    && onlyDirectCellOpsDump(prog, e2, x),
                _ -> false,
            }
        } else {
            checkStackVarInCoreDump(prog, e1, x) && checkStackVarInCoreDump(prog, e2, x)
        },
    TmIf(c, t, e) ->
        checkStackVarInCoreDump(prog, c, x) && checkStackVarInCoreDump(prog, t, x) && checkStackVarInCoreDump(prog, e, x),
    TmWhile(c, b) ->
        checkStackVarInCoreDump(prog, c, x) && checkStackVarInCoreDump(prog, b, x),
    TmMatch(s, arms) -> {
        if (!checkStackVarInCoreDump(prog, s, x)) false
        else {
            let ok = cellNew(true);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        if (patBindsNameDump(a.caPat, x) || !checkStackVarInCoreDump(prog, a.caBody, x)) {
                            cellSet(ok, false)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(ok)
        }
    },
    TmMakeData(_, _, args, _, _) -> checkStackVarInCoreListDump(prog, args, x),
    TmGetTag(e1) -> checkStackVarInCoreDump(prog, e1, x),
}

def checkStackVarInCoreListDump(prog: CoreProgram, es: List TaggedTerm, x: String): Bool = match es {
    Nil -> true,
    Cons(h, t) -> if (checkStackVarInCoreDump(prog, h, x)) checkStackVarInCoreListDump(prog, t, x) else false,
}

def collectLetCellNewCandidates(tm: TaggedTerm, seen: StrMap Bool, revOut: Cell (List String)): Void = match tm.tnode {
    TmLet(vd, e1, e2) -> {
        match e1.tnode {
            TmApplyDir(fvd, Cons(_, Nil)) ->
                if (fvd.vname == "cellNew" && !strMapContains(seen, vd.vname)) {
                    strMapInsert(seen, vd.vname, true);
                    cellSet(revOut, Cons(vd.vname, cellGet(revOut)))
                } else (),
            _ -> (),
        };
        collectLetCellNewCandidates(e1, seen, revOut);
        collectLetCellNewCandidates(e2, seen, revOut)
    },
    TmMakeCls(_, _, body) -> collectLetCellNewCandidates(body, seen, revOut),
    TmTuple(es) -> collectLetCellNewList(es, seen, revOut),
    TmBlock(es) -> collectLetCellNewList(es, seen, revOut),
    TmApplyCls(c, args) -> {
        collectLetCellNewCandidates(c, seen, revOut);
        collectLetCellNewList(args, seen, revOut)
    },
    TmApplyDir(_, args) -> collectLetCellNewList(args, seen, revOut),
    TmBin(_, e1, e2) -> {
        collectLetCellNewCandidates(e1, seen, revOut);
        collectLetCellNewCandidates(e2, seen, revOut)
    },
    TmUn(_, e1) -> collectLetCellNewCandidates(e1, seen, revOut),
    TmIf(c, t, e) -> {
        collectLetCellNewCandidates(c, seen, revOut);
        collectLetCellNewCandidates(t, seen, revOut);
        collectLetCellNewCandidates(e, seen, revOut)
    },
    TmWhile(c, b) -> {
        collectLetCellNewCandidates(c, seen, revOut);
        collectLetCellNewCandidates(b, seen, revOut)
    },
    TmMatch(s, arms) -> {
        collectLetCellNewCandidates(s, seen, revOut);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    collectLetCellNewCandidates(a.caBody, seen, revOut);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> collectLetCellNewList(args, seen, revOut),
    TmGetTag(e1) -> collectLetCellNewCandidates(e1, seen, revOut),
    _ -> (),
}

def collectLetCellNewList(es: List TaggedTerm, seen: StrMap Bool, revOut: Cell (List String)): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectLetCellNewCandidates(h, seen, revOut);
        collectLetCellNewList(t, seen, revOut)
    },
}

def collectVerifiedStackVarsForFn(prog: CoreProgram, fd: FunDef): List String =
    match strMapGet(prog.coreEscape.escFnStackVars, fd.fnName) {
        None -> Nil,
        Some(stackSet) -> {
            let paramNames: StrMap Bool = strMapNew();
            let cp = cellNew(fd.fnParams);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(pvd, pr) -> {
                        strMapInsert(paramNames, pvd.vname, true);
                        cellSet(cp, pr)
                    },
                    Nil -> (),
                }
            };
            let seen: StrMap Bool = strMapNew();
            let revCand: Cell (List String) = cellNew(Nil);
            collectLetCellNewCandidates(fd.fnBody, seen, revCand);
            let cands = listRev(cellGet(revCand));
            let revOk: Cell (List String) = cellNew(Nil);
            let cc = cellNew(cands);
            while (match cellGet(cc) { Nil -> false, _ -> true }) {
                match cellGet(cc) {
                    Cons(vname, r) -> {
                        if (strMapContains(stackSet, vname)
                            && !strMapContains(paramNames, vname)
                            && checkStackVarInCoreDump(prog, fd.fnBody, vname)) {
                            cellSet(revOk, Cons(vname, cellGet(revOk)))
                        } else ();
                        cellSet(cc, r)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(revOk))
        },
    }

pub def dumpCoreProgramSExpr(prog: CoreProgram): Result String String = {
    let allReach: StrMap Bool = strMapNew();
    let dirReach: StrMap Bool = strMapNew();
    let activeFnNames = collectReachableCoreFns(prog, allReach, dirReach);

    let paramShared: StrMap Bool = strMapNew();
    let clsLocal: StrMap Bool = strMapNew();
    let retLocal: StrMap Bool = strMapNew();
    let adtLocal: StrMap Bool = strMapNew();
    analyzeCoreModes(prog, activeFnNames, paramShared, clsLocal, retLocal, adtLocal);

    let ctx = MkDumpCtx {
        dcProg: prog,
        dcInstAdts: strMapNew(),
        dcInstAdtOrder: cellNew(Nil),
        dcParamShared: paramShared,
        dcClsLocal: clsLocal,
        dcRetLocal: retLocal,
        dcAdtLocal: adtLocal,
        dcErr: cellNew(None),
    };

    let funsBuf = bufNew();
    let stackBuf = bufNew();
    let cf = cellNew(activeFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnName, r) -> {
                if (strMapContains(dirReach, fnName)) {
                    match strMapGet(prog.coreFns, fnName) {
                        Some(fd) -> {
                            // Lifted closures with captured free variables are inlined at `TmMakeCls`
                            if (listLen(fd.fnFvs) == 0) {
                                let retTy = match schemeBody(fd.fnScm) {
                                    TyArr(_, _, ret) -> ret,
                                    other -> other,
                                };
                                let rMode = if (strMapContains(ctx.dcRetLocal, fd.fnName)) "local" else "shared";
                                bufPushStr(funsBuf, "    (fun ");
                                pushQuotedStr(funsBuf, fd.fnName);
                                bufPushByte(funsBuf, 32);
                                emitParamList(ctx, funsBuf, fd.fnName, fd.fnParams);
                                bufPushByte(funsBuf, 32);
                                emitCoreTyWithMode(ctx, funsBuf, retTy, rMode);
                                bufPushByte(funsBuf, 32);
                                emitCoreTerm(ctx, funsBuf, fd.fnBody);
                                bufPushStr(funsBuf, ")\n");
                                let svars = collectVerifiedStackVarsForFn(prog, fd);
                                match svars {
                                    Nil -> (),
                                    _ -> {
                                        bufPushStr(stackBuf, "    (fn-stack ");
                                        pushQuotedStr(stackBuf, fd.fnName);
                                        let cs = cellNew(svars);
                                        while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                            match cellGet(cs) {
                                                Cons(sv, sr) -> {
                                                    bufPushByte(stackBuf, 32);
                                                    pushQuotedStr(stackBuf, sv);
                                                    cellSet(cs, sr)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        bufPushStr(stackBuf, ")\n")
                                    },
                                }
                            } else ()
                        },
                        None -> (),
                    }
                } else ();
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    let adtsBuf = bufNew();
    let adtOrder = listRev(cellGet(ctx.dcInstAdtOrder));
    let ca = cellNew(adtOrder);
    while (match cellGet(ca) { Nil -> false, _ -> true }) {
        match cellGet(ca) {
            Cons(mangled, r) -> {
                match strMapGet(ctx.dcInstAdts, mangled) {
                    Some((baseName, targs)) -> {
                        let fMode = if (strMapContains(ctx.dcAdtLocal, baseName)) "local" else "shared";
                        match strMapGet(prog.coreAdtReg, baseName) {
                            Some(ainfo) -> {
                                let sub = buildPairMap(ainfo.typeParams, targs);
                                bufPushStr(adtsBuf, "    (adt ");
                                pushQuotedStr(adtsBuf, mangled);
                                let cv = cellNew(ainfo.variants);
                                while (match cellGet(cv) { Nil -> false, _ -> true }) {
                                    match cellGet(cv) {
                                        Cons(vi, vr) -> {
                                            bufPushStr(adtsBuf, " (variant ");
                                            bufPushStr(adtsBuf, intToStr(vi.tag));
                                            let cft = cellNew(vi.fieldTypes);
                                            while (match cellGet(cft) { Nil -> false, _ -> true }) {
                                                match cellGet(cft) {
                                                    Cons(ft, fr) -> {
                                                        bufPushByte(adtsBuf, 32);
                                                        emitCoreTyWithMode(ctx, adtsBuf, applyExplicitSubst(ft, sub), fMode);
                                                        cellSet(cft, fr)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            bufPushByte(adtsBuf, 41);
                                            cellSet(cv, vr)
                                        },
                                        Nil -> (),
                                    }
                                };
                                bufPushStr(adtsBuf, ")\n")
                            },
                            None -> (),
                        }
                    },
                    None -> (),
                };
                cellSet(ca, r)
            },
            Nil -> (),
        }
    };

    match cellGet(ctx.dcErr) {
        Some(errMsg) -> Err(errMsg),
        None -> {
            let out = bufNew();
            bufPushStr(out, "(program\n  (adts\n");
            bufPushStr(out, bufToString(adtsBuf));
            bufPushStr(out, "  )\n  (funs\n");
            bufPushStr(out, bufToString(funsBuf));
            bufPushStr(out, "  )\n  (stack-allocs\n");
            bufPushStr(out, bufToString(stackBuf));
            bufPushStr(out, "  )\n)\n");
            Ok(bufToString(out))
        },
    }
}
