// Geisha Language Server Protocol (LSP 3.17 over stdio JSON-RPC 2.0)
//
// Reuses the compiler frontend (`lexer`, `parser`, `loader`, `infer`, `core`, `doc`, `diag`)
// to provide live diagnostics, hover (inferred types + `///` docs), go-to-definition,
// document symbols, and completion (local/imported symbols + `std.*`/`sys.*`).

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend}
use std.vec.{Vec, vecNew, vecPush, vecLen, vecGetOr}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.buf.{StringBuf, bufNew, bufPushByte, bufPushStr, bufToString}
use std.str.{
    intToStr, i64ToStr, floatToStr, parseInt, parseInt64, parseFloat,
    strStartsWith, strEndsWith, strIndexOfByte, strSplitChar, strJoin, strTrim
}
use std.char.{isIdentStartByte, isIdentContByte, isDigitByte}
use std.path.{pathDirname}
use std.codec.{Value, VNull, VBool, VInt, VFloat, VStr, VArr, VObj}
use sys.fs.fileExists
use sys.io.eprintLn
use ast.{
    Span, MkSpan, isPublicVis,
    Type, Scheme, ScmSlot,
    VarDecl, MatchArm, Form,
    Expr, ExLit, ExVar, ExTuple, ExStructInit, ExList, ExBlock, ExApply,
    ExAbs, ExBin, ExUn, ExLet, ExIf, ExWhile, ExMatch, ExField, ExTry,
    VariantBody, VarStruct, VariantDef, MethodDecl,
    Item, ItForm, ItExtern, ItAlias, ItAlg, ItConcept, ItInstance,
    Def, UseSpec, useSpecLocalName,
    UseItem, UseSingle, UseMulti, UseGlob, UseAlias,
    ModuleItem, ModDef, ModUse, ModSub,
    FileModule
}
use diag.{
    SourceFile, MkSourceFile, DiagRecord, MkDiagRecord,
    diagReset, diagRegisterFile, diagRegisteredFiles, diagLastError
}
use parser.parseFileModuleInFile
use loader.{PkgSpec, MkPkgSpec, loadSingleSourceProgramWithPkgsNamed}
use infer.{InferOutput, inferProgram}
use core.lowerToCore
use doc.{formatScheme, formatVariant, extractDocComment, formatDefSig}
use stdlib_bundle.{builtinModuleKeys, builtinModuleSource}
use pkg.{findProjectRoot, resolveProjectGraph, toLoaderPkgSpecs}

extern "read" def c_read(fd: Int, buf: Ptr, count: Int64): Int64
extern "write" def c_write(fd: Int, buf: String, count: Int64): Int64

// ============================================================================
// Minimal RFC 8259 JSON Parser & Serializer (for JSON-RPC 2.0 on `std.codec.Value`)
// ============================================================================

data JsonCursor {
    MkJsonCursor { jcSrc: String, jcLen: Int, jcIdx: Cell Int },
}

def jcPeek(c: JsonCursor): Int = {
    let i = cellGet(c.jcIdx);
    if (i >= c.jcLen) -1 else strByteAt(c.jcSrc, i)
}

def jcBump(c: JsonCursor): Int = {
    let i = cellGet(c.jcIdx);
    if (i >= c.jcLen) -1
    else {
        cellSet(c.jcIdx, i + 1);
        strByteAt(c.jcSrc, i)
    }
}

def jcSkipWs(c: JsonCursor): Void = {
    let looping = cellNew(true);
    while (cellGet(looping)) {
        let b = jcPeek(c);
        if (b == 32 || b == 9 || b == 10 || b == 13) {
            let _ = jcBump(c);
            ()
        } else {
            cellSet(looping, false)
        }
    }
}

def jcHexVal(b: Int): Int =
    if (b >= 48 && b <= 57) b - 48
    else if (b >= 65 && b <= 70) b - 55
    else if (b >= 97 && b <= 102) b - 87
    else -1

def jcHexLower(n: Int): Int =
    if (n < 10) 48 + n else 87 + n

def jcPushUtf8(b: StringBuf, cp: Int): Void =
    if (cp < 128) bufPushByte(b, cp)
    else if (cp < 2048) {
        bufPushByte(b, 192 | (cp >>> 6));
        bufPushByte(b, 128 | (cp & 63))
    } else if (cp < 65536) {
        bufPushByte(b, 224 | (cp >>> 12));
        bufPushByte(b, 128 | ((cp >>> 6) & 63));
        bufPushByte(b, 128 | (cp & 63))
    } else {
        bufPushByte(b, 240 | (cp >>> 18));
        bufPushByte(b, 128 | ((cp >>> 12) & 63));
        bufPushByte(b, 128 | ((cp >>> 6) & 63));
        bufPushByte(b, 128 | (cp & 63))
    }

def jcReadHex4(c: JsonCursor): Result Int String = {
    let b0 = jcHexVal(jcBump(c));
    let b1 = jcHexVal(jcBump(c));
    let b2 = jcHexVal(jcBump(c));
    let b3 = jcHexVal(jcBump(c));
    if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) Err("invalid unicode escape in JSON")
    else Ok((b0 << 12) | (b1 << 8) | (b2 << 4) | b3)
}

def jcParseString(c: JsonCursor): Result String String = {
    if (jcBump(c) != 34) Err("expected '\"' in JSON string")
    else {
        let out = bufNew();
        let done = cellNew(false);
        let err = cellNew("");
        while (!cellGet(done) && strLen(cellGet(err)) == 0) {
            let ch = jcBump(c);
            if (ch < 0) cellSet(err, "unterminated JSON string")
            else if (ch == 34) cellSet(done, true)
            else if (ch == 92) {
                let esc = jcBump(c);
                if (esc == 34) bufPushByte(out, 34)
                else if (esc == 92) bufPushByte(out, 92)
                else if (esc == 47) bufPushByte(out, 47)
                else if (esc == 98) bufPushByte(out, 8)
                else if (esc == 102) bufPushByte(out, 12)
                else if (esc == 110) bufPushByte(out, 10)
                else if (esc == 114) bufPushByte(out, 13)
                else if (esc == 116) bufPushByte(out, 9)
                else if (esc == 117) {
                    match jcReadHex4(c) {
                        Err(e) -> cellSet(err, e),
                        Ok(u1) ->
                            if (u1 >= 55296 && u1 <= 56319) {
                                let s1 = jcBump(c);
                                let s2 = jcBump(c);
                                if (s1 != 92 || s2 != 117) cellSet(err, "expected low surrogate")
                                else match jcReadHex4(c) {
                                    Err(e2) -> cellSet(err, e2),
                                    Ok(u2) -> jcPushUtf8(out, 65536 + ((u1 - 55296) << 10) + (u2 - 56320)),
                                }
                            } else jcPushUtf8(out, u1),
                    }
                } else cellSet(err, "invalid JSON escape")
            } else bufPushByte(out, ch)
        };
        if (strLen(cellGet(err)) > 0) Err(cellGet(err)) else Ok(bufToString(out))
    }
}

def jcExpectLit(c: JsonCursor, lit: String): Result Void String = {
    let n = strLen(lit);
    let st = cellGet(c.jcIdx);
    if (st + n > c.jcLen) Err("unexpected EOF expecting '" + lit + "'")
    else if (strStartsWith(strSlice(c.jcSrc, st, st + n), lit)) {
        cellSet(c.jcIdx, st + n);
        Ok(())
    } else Err("expected '" + lit + "' in JSON")
}

def jcParseNumber(c: JsonCursor): Result Value String = {
    let st = cellGet(c.jcIdx);
    let isFlt = cellNew(false);
    if (jcPeek(c) == 45) { let _ = jcBump(c); () } else ();
    while (jcPeek(c) >= 48 && jcPeek(c) <= 57) { let _ = jcBump(c); () };
    if (jcPeek(c) == 46) {
        cellSet(isFlt, true);
        let _ = jcBump(c);
        while (jcPeek(c) >= 48 && jcPeek(c) <= 57) { let _ = jcBump(c); () }
    } else ();
    if (jcPeek(c) == 101 || jcPeek(c) == 69) {
        cellSet(isFlt, true);
        let _ = jcBump(c);
        if (jcPeek(c) == 43 || jcPeek(c) == 45) { let _ = jcBump(c); () } else ();
        while (jcPeek(c) >= 48 && jcPeek(c) <= 57) { let _ = jcBump(c); () }
    } else ();
    let raw = strSlice(c.jcSrc, st, cellGet(c.jcIdx));
    if (cellGet(isFlt)) {
        let fv = parseFloat(raw)?;
        Ok(VFloat(fv))
    } else {
        let iv = parseInt64(raw)?;
        Ok(VInt(iv))
    }
}

def jcParseValue(c: JsonCursor, depth: Int): Result Value String =
    if (depth > 128) Err("JSON nesting too deep")
    else {
        jcSkipWs(c);
        let b = jcPeek(c);
        if (b < 0) Err("unexpected EOF in JSON")
        else if (b == 110) { jcExpectLit(c, "null")?; Ok(VNull) }
        else if (b == 116) { jcExpectLit(c, "true")?; Ok(VBool(true)) }
        else if (b == 102) { jcExpectLit(c, "false")?; Ok(VBool(false)) }
        else if (b == 34) { let s = jcParseString(c)?; Ok(VStr(s)) }
        else if (b == 91) jcParseArray(c, depth + 1)
        else if (b == 123) jcParseObject(c, depth + 1)
        else if (b == 45 || (b >= 48 && b <= 57)) jcParseNumber(c)
        else Err("unexpected token in JSON")
    }

def jcParseArray(c: JsonCursor, depth: Int): Result Value String = {
    let _ = jcBump(c);
    jcSkipWs(c);
    if (jcPeek(c) == 93) { let _ = jcBump(c); Ok(VArr(Nil)) }
    else {
        let acc = cellNew(Nil);
        let done = cellNew(false);
        let err = cellNew("");
        while (!cellGet(done) && strLen(cellGet(err)) == 0) {
            match jcParseValue(c, depth) {
                Err(e) -> cellSet(err, e),
                Ok(v) -> {
                    cellSet(acc, Cons(v, cellGet(acc)));
                    jcSkipWs(c);
                    let nx = jcPeek(c);
                    if (nx == 44) { let _ = jcBump(c); () }
                    else if (nx == 93) { let _ = jcBump(c); cellSet(done, true) }
                    else cellSet(err, "expected ',' or ']' in JSON array")
                },
            }
        };
        if (strLen(cellGet(err)) > 0) Err(cellGet(err)) else Ok(VArr(listRev(cellGet(acc))))
    }
}

def jcParseObject(c: JsonCursor, depth: Int): Result Value String = {
    let _ = jcBump(c);
    jcSkipWs(c);
    if (jcPeek(c) == 125) { let _ = jcBump(c); Ok(VObj(Nil)) }
    else {
        let acc = cellNew(Nil);
        let done = cellNew(false);
        let err = cellNew("");
        while (!cellGet(done) && strLen(cellGet(err)) == 0) {
            jcSkipWs(c);
            match jcParseString(c) {
                Err(e) -> cellSet(err, e),
                Ok(k) -> {
                    jcSkipWs(c);
                    if (jcPeek(c) != 58) cellSet(err, "expected ':' in JSON object")
                    else {
                        let _ = jcBump(c);
                        match jcParseValue(c, depth) {
                            Err(e2) -> cellSet(err, e2),
                            Ok(v) -> {
                                cellSet(acc, Cons((k, v), cellGet(acc)));
                                jcSkipWs(c);
                                let nx = jcPeek(c);
                                if (nx == 44) { let _ = jcBump(c); () }
                                else if (nx == 125) { let _ = jcBump(c); cellSet(done, true) }
                                else cellSet(err, "expected ',' or '}' in JSON object")
                            },
                        }
                    }
                },
            }
        };
        if (strLen(cellGet(err)) > 0) Err(cellGet(err)) else Ok(VObj(listRev(cellGet(acc))))
    }
}

def jsonParse(input: String): Result Value String = {
    let c = MkJsonCursor { jcSrc: input, jcLen: strLen(input), jcIdx: cellNew(0) };
    let v = jcParseValue(c, 0)?;
    jcSkipWs(c);
    if (cellGet(c.jcIdx) != c.jcLen) Err("trailing characters after JSON")
    else Ok(v)
}

def emitJsonStr(b: StringBuf, s: String): Void = {
    bufPushByte(b, 34);
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let ch = strByteAt(s, idx);
        if (ch == 34) bufPushStr(b, "\\\"")
        else if (ch == 92) bufPushStr(b, "\\\\")
        else if (ch == 8) bufPushStr(b, "\\b")
        else if (ch == 12) bufPushStr(b, "\\f")
        else if (ch == 10) bufPushStr(b, "\\n")
        else if (ch == 13) bufPushStr(b, "\\r")
        else if (ch == 9) bufPushStr(b, "\\t")
        else if (ch < 32) {
            bufPushStr(b, "\\u00");
            bufPushByte(b, jcHexLower((ch >>> 4) & 15));
            bufPushByte(b, jcHexLower(ch & 15))
        } else bufPushByte(b, ch);
        cellSet(i, idx + 1)
    };
    bufPushByte(b, 34)
}

def emitJsonVal(b: StringBuf, v: Value): Void = match v {
    VNull -> bufPushStr(b, "null"),
    VBool(true) -> bufPushStr(b, "true"),
    VBool(false) -> bufPushStr(b, "false"),
    VInt(n) -> bufPushStr(b, i64ToStr(n)),
    VFloat(f) -> bufPushStr(b, floatToStr(f)),
    VStr(s) -> emitJsonStr(b, s),
    VArr(xs) -> {
        bufPushByte(b, 91);
        let cur = cellNew(xs);
        let first = cellNew(true);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(h, t) -> {
                    if (!cellGet(first)) bufPushByte(b, 44) else cellSet(first, false);
                    emitJsonVal(b, h);
                    cellSet(cur, t)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 93)
    },
    VObj(fs) -> {
        bufPushByte(b, 123);
        let cur = cellNew(fs);
        let first = cellNew(true);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((k, val), t) -> {
                    if (!cellGet(first)) bufPushByte(b, 44) else cellSet(first, false);
                    emitJsonStr(b, k);
                    bufPushByte(b, 58);
                    emitJsonVal(b, val);
                    cellSet(cur, t)
                },
                Nil -> (),
            }
        };
        bufPushByte(b, 125)
    },
}

def jsonStringify(v: Value): String = {
    let b = bufNew();
    emitJsonVal(b, v);
    bufToString(b)
}

// ============================================================================
// Buffered stdio JSON-RPC 2.0 Framing (Content-Length)
// ============================================================================

data StdinReader {
    MkStdinReader {
        srBuf: Ptr,
        srCap: Int,
        srPos: Cell Int,
        srLen: Cell Int,
    },
}

def stdinReaderNew(): StdinReader = {
    let cap = 65536;
    MkStdinReader {
        srBuf: ptrAllocBytes(cap),
        srCap: cap,
        srPos: cellNew(0),
        srLen: cellNew(0),
    }
}

def stdinReadByte(r: StdinReader): Int = {
    let pos = cellGet(r.srPos);
    let len = cellGet(r.srLen);
    if (pos < len) {
        cellSet(r.srPos, pos + 1);
        ptrByteAt(r.srBuf, pos)
    } else {
        let got = i64ToInt(c_read(0, r.srBuf, intToI64(r.srCap)));
        if (got <= 0) {
            -1
        } else {
            cellSet(r.srPos, 1);
            cellSet(r.srLen, got);
            ptrByteAt(r.srBuf, 0)
        }
    }
}

def stdinReadLine(r: StdinReader): Option String = {
    let b = bufNew();
    let any = cellNew(false);
    let done = cellNew(false);
    while (!cellGet(done)) {
        let ch = stdinReadByte(r);
        if (ch < 0) {
            cellSet(done, true)
        } else {
            cellSet(any, true);
            if (ch == 10) {
                cellSet(done, true)
            } else if (ch != 13) {
                bufPushByte(b, ch)
            } else ()
        }
    };
    if (!cellGet(any)) None else Some(bufToString(b))
}

def stdinReadExact(r: StdinReader, n: Int): Option String = {
    let b = bufNew();
    let rem = cellNew(n);
    let ok = cellNew(true);
    while (cellGet(rem) > 0 && cellGet(ok)) {
        let ch = stdinReadByte(r);
        if (ch < 0) {
            cellSet(ok, false)
        } else {
            bufPushByte(b, ch);
            cellSet(rem, cellGet(rem) - 1)
        }
    };
    if (cellGet(ok)) Some(bufToString(b)) else None
}

def writeAllStdout(s: String): Void = {
    let total = strLen(s);
    let off = cellNew(0);
    let ok = cellNew(true);
    while (cellGet(off) < total && cellGet(ok)) {
        let cur = cellGet(off);
        let chunk = if (cur == 0) s else strSlice(s, cur, total);
        let written = i64ToInt(c_write(1, chunk, intToI64(total - cur)));
        if (written <= 0) cellSet(ok, false)
        else cellSet(off, cur + written)
    }
}

def sendRpcValue(v: Value): Void = {
    let body = jsonStringify(v);
    let frame = "Content-Length: " + intToStr(strLen(body)) + "\r\n\r\n" + body;
    writeAllStdout(frame)
}

def sendRpcResponse(idVal: Value, resultVal: Value): Void =
    sendRpcValue(VObj([
        ("jsonrpc", VStr("2.0")),
        ("id", idVal),
        ("result", resultVal),
    ]))

def sendRpcError(idVal: Value, code: Int, message: String): Void =
    sendRpcValue(VObj([
        ("jsonrpc", VStr("2.0")),
        ("id", idVal),
        ("error", VObj([
            ("code", VInt(intToI64(code))),
            ("message", VStr(message)),
        ])),
    ]))

def sendRpcNotification(method: String, paramsVal: Value): Void =
    sendRpcValue(VObj([
        ("jsonrpc", VStr("2.0")),
        ("method", VStr(method)),
        ("params", paramsVal),
    ]))

def toLowerAscii(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(s, idx);
        if (c >= 65 && c <= 90) bufPushByte(b, c + 32) else bufPushByte(b, c);
        cellSet(i, idx + 1)
    };
    bufToString(b)
}

def readLspMessage(r: StdinReader): Option String = {
    let contentLen = cellNew(-1);
    let eof = cellNew(false);
    let inHeaders = cellNew(true);
    while (cellGet(inHeaders) && !cellGet(eof)) {
        match stdinReadLine(r) {
            None -> cellSet(eof, true),
            Some(line) -> {
                if (strLen(line) == 0) {
                    if (cellGet(contentLen) >= 0) cellSet(inHeaders, false) else ()
                } else {
                    match strIndexOfByte(line, 58, 0) {
                        Some(col) -> {
                            let k = toLowerAscii(strTrim(strSlice(line, 0, col)));
                            let v = strTrim(strSlice(line, col + 1, strLen(line)));
                            if (k == "content-length") {
                                match parseInt(v) {
                                    Ok(n) -> cellSet(contentLen, n),
                                    Err(_) -> (),
                                }
                            } else ()
                        },
                        None -> (),
                    }
                }
            },
        }
    };
    if (cellGet(eof) || cellGet(contentLen) < 0) None
    else stdinReadExact(r, cellGet(contentLen))
}

// ============================================================================
// JSON Value Helpers
// ============================================================================

def objGet(v: Value, key: String): Option Value = match v {
    VObj(fields) -> {
        let cur = cellNew(fields);
        let found: Cell (Option Value) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((k, val), r) -> {
                    if (k == key) cellSet(found, Some(val)) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> None,
}

def objGetStr(v: Value, key: String): Option String = match objGet(v, key) {
    Some(VStr(s)) -> Some(s),
    _ -> None,
}

def objGetInt(v: Value, key: String): Option Int = match objGet(v, key) {
    Some(VInt(n)) -> Some(i64ToInt(n)),
    _ -> None,
}

// ============================================================================
// URI <-> Path & UTF-8 / UTF-16 Position Mapping
// ============================================================================

def hexDigitVal(b: Int): Int =
    if (b >= 48 && b <= 57) b - 48
    else if (b >= 65 && b <= 70) b - 55
    else if (b >= 97 && b <= 102) b - 87
    else -1

def hexUpperByte(n: Int): Int =
    if (n < 10) 48 + n else 55 + n

def percentDecode(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(s, idx);
        if (c == 37 && idx + 2 < n) {
            let h1 = hexDigitVal(strByteAt(s, idx + 1));
            let h2 = hexDigitVal(strByteAt(s, idx + 2));
            if (h1 >= 0 && h2 >= 0) {
                bufPushByte(b, (h1 << 4) | h2);
                cellSet(i, idx + 3)
            } else {
                bufPushByte(b, c);
                cellSet(i, idx + 1)
            }
        } else {
            bufPushByte(b, c);
            cellSet(i, idx + 1)
        }
    };
    bufToString(b)
}

def isUriSafeByte(c: Int): Bool =
    (c >= 65 && c <= 90)
    || (c >= 97 && c <= 122)
    || (c >= 48 && c <= 57)
    || c == 47 || c == 45 || c == 95 || c == 46 || c == 126 || c == 58

def percentEncodePath(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(s, idx);
        if (isUriSafeByte(c)) {
            bufPushByte(b, c)
        } else {
            bufPushByte(b, 37);
            bufPushByte(b, hexUpperByte((c >>> 4) & 15));
            bufPushByte(b, hexUpperByte(c & 15))
        };
        cellSet(i, idx + 1)
    };
    bufToString(b)
}

def uriToPath(uri: String): String =
    if (strStartsWith(uri, "file://")) {
        let rest = strSlice(uri, 7, strLen(uri));
        percentDecode(rest)
    } else uri

def pathToUri(path: String): String =
    if (strStartsWith(path, "file://")) path
    else if (strStartsWith(path, "/")) "file://" + percentEncodePath(path)
    else "file:///" + percentEncodePath(path)

def offsetToLspPos(src: String, byteOff: Int): (Int, Int) = {
    let n = strLen(src);
    let target = if (byteOff < 0) 0 else if (byteOff > n) n else byteOff;
    let line = cellNew(0);
    let col = cellNew(0);
    let i = cellNew(0);
    while (cellGet(i) < target) {
        let idx = cellGet(i);
        let b = strByteAt(src, idx);
        if (b == 10) {
            cellSet(line, cellGet(line) + 1);
            cellSet(col, 0);
            cellSet(i, idx + 1)
        } else if (b < 128) {
            cellSet(col, cellGet(col) + 1);
            cellSet(i, idx + 1)
        } else if (b < 224) {
            cellSet(col, cellGet(col) + 1);
            cellSet(i, idx + 2)
        } else if (b < 240) {
            cellSet(col, cellGet(col) + 1);
            cellSet(i, idx + 3)
        } else {
            cellSet(col, cellGet(col) + 2);
            cellSet(i, idx + 4)
        }
    };
    (cellGet(line), cellGet(col))
}

def lspPosToOffset(src: String, targetLine: Int, targetChar: Int): Int = {
    let n = strLen(src);
    let line = cellNew(0);
    let col = cellNew(0);
    let i = cellNew(0);
    let done = cellNew(false);
    while (cellGet(i) < n && !cellGet(done)) {
        let curLine = cellGet(line);
        let curCol = cellGet(col);
        if (curLine > targetLine || (curLine == targetLine && curCol >= targetChar)) {
            cellSet(done, true)
        } else {
            let idx = cellGet(i);
            let b = strByteAt(src, idx);
            if (b == 10) {
                if (curLine == targetLine) {
                    cellSet(done, true)
                } else {
                    cellSet(line, curLine + 1);
                    cellSet(col, 0);
                    cellSet(i, idx + 1)
                }
            } else if (b < 128) {
                cellSet(col, curCol + 1);
                cellSet(i, idx + 1)
            } else if (b < 224) {
                cellSet(col, curCol + 1);
                cellSet(i, idx + 2)
            } else if (b < 240) {
                cellSet(col, curCol + 1);
                cellSet(i, idx + 3)
            } else {
                cellSet(col, curCol + 2);
                cellSet(i, idx + 4)
            }
        }
    };
    let res = cellGet(i);
    if (res > n) n else res
}

def makeLspPos(line: Int, ch: Int): Value =
    VObj([
        ("line", VInt(intToI64(line))),
        ("character", VInt(intToI64(ch))),
    ])

def makeLspRange(src: String, startByte: Int, endByte: Int): Value = {
    let n = strLen(src);
    let s = if (startByte < 0) 0 else if (startByte > n) n else startByte;
    let e0 = if (endByte < s) s else if (endByte > n) n else endByte;
    let e = if (e0 == s && s < n) s + 1 else e0;
    let (sl, sc) = offsetToLspPos(src, s);
    let (el, ec) = offsetToLspPos(src, e);
    VObj([
        ("start", makeLspPos(sl, sc)),
        ("end", makeLspPos(el, ec)),
    ])
}

// ============================================================================
// Document State & Frontend Analysis
// ============================================================================

data DocState {
    MkDocState {
        dsUri: String,
        dsPath: String,
        dsText: String,
        dsVersion: Int,
        dsParsed: Option FileModule,
        dsInfer: Option InferOutput,
        dsFiles: Vec SourceFile,
        dsFileId: Int,
    },
}

data ServerState {
    MkServerState {
        ssDocs: StrMap DocState,
        ssShuttingDown: Cell Bool,
        ssRootDir: Cell (Option String),
    },
}

def resolveDocPkgSpecs(filePath: String): (PkgSpec, List PkgSpec) = {
    let dir = pathDirname(filePath);
    let searchDir = if (strLen(dir) == 0) "." else dir;
    match findProjectRoot(searchDir) {
        Some(projDir) -> match resolveProjectGraph(projDir, false, None, true) {
            Ok((_, rootSpec, resolvedPkgs)) -> {
                let extSpecs = toLoaderPkgSpecs(resolvedPkgs);
                let roots = listAppend(rootSpec.srcRoots, [searchDir]);
                let mergedRoot = MkPkgSpec {
                    pkgId: rootSpec.pkgId,
                    pkgName: rootSpec.pkgName,
                    srcRoots: roots,
                    deps: rootSpec.deps,
                };
                (mergedRoot, extSpecs)
            },
            Err(_) -> (MkPkgSpec { pkgId: "", pkgName: "", srcRoots: [searchDir], deps: Nil }, Nil),
        },
        None -> (MkPkgSpec { pkgId: "", pkgName: "", srcRoots: [searchDir], deps: Nil }, Nil),
    }
}

def getSourceFileFromVec(files: Vec SourceFile, fileId: Int): Option SourceFile =
    if (fileId <= 0 || fileId > vecLen(files)) None
    else Some(vecGetOr(files, fileId - 1, MkSourceFile { sfPath: "", sfContent: "" }))

def buildDiagFromError(docPath: String, docText: String, errMsg: String, files: Vec SourceFile): Value =
    match diagLastError() {
        Some(rec) -> {
            let fullMsg = match rec.drHint {
                Some(h) -> rec.drMsg + "\nhint: " + h,
                None -> rec.drMsg,
            };
            let rangeVal = match getSourceFileFromVec(files, rec.drFileId) {
                Some(sf) if (sf.sfPath == docPath) ->
                    makeLspRange(docText, rec.drStart, rec.drEnd),
                _ -> makeLspRange(docText, 0, 1),
            };
            let displayMsg = match getSourceFileFromVec(files, rec.drFileId) {
                Some(sf) if (sf.sfPath != docPath && strLen(sf.sfPath) > 0) ->
                    sf.sfPath + ": " + fullMsg,
                _ -> fullMsg,
            };
            VObj([
                ("range", rangeVal),
                ("severity", VInt(intToI64(1))),
                ("code", VStr(rec.drKind)),
                ("source", VStr("geisha")),
                ("message", VStr(displayMsg)),
            ])
        },
        None ->
            VObj([
                ("range", makeLspRange(docText, 0, 1)),
                ("severity", VInt(intToI64(1))),
                ("source", VStr("geisha")),
                ("message", VStr(errMsg)),
            ]),
    }

def runFrontendCheck(path: String, text: String, rootSpec: PkgSpec, extSpecs: List PkgSpec): Result InferOutput String = {
    let rawDefs = loadSingleSourceProgramWithPkgsNamed(path, text, rootSpec, extSpecs, Nil)?;
    let inf = inferProgram(rawDefs)?;
    let _ = lowerToCore(inf)?;
    Ok(inf)
}

def analyzeAndPublish(ss: ServerState, uri: String, text: String, version: Int): Void = {
    let path = uriToPath(uri);
    let prevDocOpt = strMapGet(ss.ssDocs, uri);

    // Always try a standalone parse for DocumentSymbol / Completion resilience
    diagReset();
    let parseFid = diagRegisterFile(path, text);
    let parsedOpt = match parseFileModuleInFile(text, Nil, parseFid) {
        Ok(fm) -> Some(fm),
        Err(_) -> match prevDocOpt {
            Some(prev) -> prev.dsParsed,
            None -> None,
        },
    };

    // Full frontend analysis: load + infer + core lowering (Send/exhaustiveness/etc.)
    diagReset();
    let (rootSpec, extSpecs) = resolveDocPkgSpecs(path);
    let checkRes = runFrontendCheck(path, text, rootSpec, extSpecs);
    let filesSnap = diagRegisteredFiles();

    match checkRes {
        Ok(inf) -> {
            let st = MkDocState {
                dsUri: uri,
                dsPath: path,
                dsText: text,
                dsVersion: version,
                dsParsed: parsedOpt,
                dsInfer: Some(inf),
                dsFiles: filesSnap,
                dsFileId: 1,
            };
            strMapInsert(ss.ssDocs, uri, st);
            sendRpcNotification("textDocument/publishDiagnostics", VObj([
                ("uri", VStr(uri)),
                ("diagnostics", VArr(Nil)),
            ]))
        },
        Err(errMsg) -> {
            let diagObj = buildDiagFromError(path, text, errMsg, filesSnap);
            let keepInf = match prevDocOpt {
                Some(prev) -> prev.dsInfer,
                None -> None,
            };
            let keepFiles = match prevDocOpt {
                Some(prev) -> if (vecLen(prev.dsFiles) > 0) prev.dsFiles else filesSnap,
                None -> filesSnap,
            };
            let st = MkDocState {
                dsUri: uri,
                dsPath: path,
                dsText: text,
                dsVersion: version,
                dsParsed: parsedOpt,
                dsInfer: keepInf,
                dsFiles: keepFiles,
                dsFileId: 1,
            };
            strMapInsert(ss.ssDocs, uri, st);
            sendRpcNotification("textDocument/publishDiagnostics", VObj([
                ("uri", VStr(uri)),
                ("diagnostics", VArr([diagObj])),
            ]))
        },
    }
}

// ============================================================================
// Identifier Scanning & Doc Comment Formatting
// ============================================================================

def identAtOffset(src: String, off: Int): Option (String, Int, Int) = {
    let n = strLen(src);
    if (n == 0) None
    else {
        let p0 = if (off < 0) 0 else if (off >= n) n - 1 else off;
        let p =
            if (isIdentContByte(strByteAt(src, p0))) p0
            else if (p0 > 0 && isIdentContByte(strByteAt(src, p0 - 1))) p0 - 1
            else -1;
        if (p < 0) None
        else {
            let s = cellNew(p);
            while (cellGet(s) > 0 && isIdentContByte(strByteAt(src, cellGet(s) - 1))) {
                cellSet(s, cellGet(s) - 1)
            };
            let e = cellNew(p + 1);
            while (cellGet(e) < n && isIdentContByte(strByteAt(src, cellGet(e)))) {
                cellSet(e, cellGet(e) + 1)
            };
            let st = cellGet(s);
            let en = cellGet(e);
            if (en > st && isIdentStartByte(strByteAt(src, st))) {
                Some((strSlice(src, st, en), st, en))
            } else None
        }
    }
}

def stripDocPrefix(line: String): String =
    if (strStartsWith(line, "/// ")) strSlice(line, 4, strLen(line))
    else if (strStartsWith(line, "///")) strSlice(line, 3, strLen(line))
    else line

def formatDocCommentMarkdown(src: String, startByte: Int): String = {
    let lines = extractDocComment(src, startByte);
    match lines {
        Nil -> "",
        _ -> {
            let cleaned = cellNew(Nil);
            let cur = cellNew(lines);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(l, r) -> {
                        cellSet(cleaned, listAppend(cellGet(cleaned), [stripDocPrefix(l)]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            strJoin(cellGet(cleaned), "\n")
        },
    }
}

def shortSymName(qname: String): String = {
    let segs = strSplitChar(qname, '.');
    let last = cellNew(qname);
    let cur = cellNew(segs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(s, r) -> { cellSet(last, s); cellSet(cur, r) },
            Nil -> (),
        }
    };
    cellGet(last)
}

// ============================================================================
// AST Traversal for Innermost Expression & Local Bindings
// ============================================================================

data FoundForm {
    MkFoundForm {
        ffForm: Form,
        ffSize: Int,
        ffLocals: List (String, Span),
    },
}

def spanContains(sp: Span, fileId: Int, off: Int): Bool =
    sp.fileId == fileId && sp.start <= off && off <= sp.end

def spanSize(sp: Span): Int =
    if (sp.end >= sp.start) sp.end - sp.start else 0

def searchFormList(fs: List Form, fileId: Int, off: Int, locals: List (String, Span), best: Cell (Option FoundForm)): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                searchFormAt(h, fileId, off, locals, best);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def searchFormAt(f: Form, fileId: Int, off: Int, locals: List (String, Span), best: Cell (Option FoundForm)): Void = {
    if (spanContains(f.pos, fileId, off)) {
        let sz = spanSize(f.pos);
        let better = match cellGet(best) {
            None -> true,
            Some(prev) -> sz <= prev.ffSize,
        };
        if (better) {
            cellSet(best, Some(MkFoundForm { ffForm: f, ffSize: sz, ffLocals: locals }))
        } else ()
    } else ();
    match f.node {
        ExLit(_) -> (),
        ExVar(_) -> (),
        ExTuple(es) -> searchFormList(es, fileId, off, locals, best),
        ExList(es) -> searchFormList(es, fileId, off, locals, best),
        ExBlock(es) -> searchFormList(es, fileId, off, locals, best),
        ExStructInit(_, fields) -> {
            let cur = cellNew(fields);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons((_, fv), r) -> {
                        searchFormAt(fv, fileId, off, locals, best);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExApply(callee, args) -> {
            searchFormAt(callee, fileId, off, locals, best);
            searchFormList(args, fileId, off, locals, best)
        },
        ExAbs(ps, _, body) -> {
            let nextLocals = cellNew(locals);
            let cur = cellNew(ps);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(vd, r) -> {
                        cellSet(nextLocals, Cons((vd.vname, f.pos), cellGet(nextLocals)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            searchFormAt(body, fileId, off, cellGet(nextLocals), best)
        },
        ExBin(_, lhs, rhs) -> {
            searchFormAt(lhs, fileId, off, locals, best);
            searchFormAt(rhs, fileId, off, locals, best)
        },
        ExUn(_, sub) -> searchFormAt(sub, fileId, off, locals, best),
        ExLet(vd, rhs, body) -> {
            searchFormAt(rhs, fileId, off, locals, best);
            let nextLocals = Cons((vd.vname, f.pos), locals);
            searchFormAt(body, fileId, off, nextLocals, best)
        },
        ExIf(c, t, e) -> {
            searchFormAt(c, fileId, off, locals, best);
            searchFormAt(t, fileId, off, locals, best);
            searchFormAt(e, fileId, off, locals, best)
        },
        ExWhile(c, b) -> {
            searchFormAt(c, fileId, off, locals, best);
            searchFormAt(b, fileId, off, locals, best)
        },
        ExMatch(scrut, arms) -> {
            searchFormAt(scrut, fileId, off, locals, best);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arm, r) -> {
                        match arm.guard {
                            Some(g) -> searchFormAt(g, fileId, off, locals, best),
                            None -> (),
                        };
                        searchFormAt(arm.body, fileId, off, locals, best);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExField(base, _) -> searchFormAt(base, fileId, off, locals, best),
        ExTry(inner) -> searchFormAt(inner, fileId, off, locals, best),
    }
}

def findInnermostFormInDefs(defs: List Def, fileId: Int, off: Int): Option FoundForm = {
    let best: Cell (Option FoundForm) = cellNew(None);
    let cur = cellNew(defs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> searchFormAt(f, fileId, off, Nil, best),
                    ItInstance(_, _, _, impls) -> {
                        let ci = cellNew(impls);
                        while (match cellGet(ci) { Nil -> false, _ -> true }) {
                            match cellGet(ci) {
                                Cons(mi, ri) -> {
                                    searchFormAt(mi.implBody, fileId, off, Nil, best);
                                    cellSet(ci, ri)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(best)
}

def defHasVariant(d: Def, name: String): Bool = match d.item {
    ItAlg(_, vs) -> {
        let cur = cellNew(vs);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    if (v.vname == name) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def defHasMethod(d: Def, name: String): Bool = match d.item {
    ItConcept(_, _, _, ms) -> {
        let cur = cellNew(ms);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(m, r) -> {
                    if (m.mname == name) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def lookupDefExact(defs: List Def, name: String): Option Def = {
    let cur = cellNew(defs);
    let found: Cell (Option Def) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (d.ident == name || defHasVariant(d, name) || defHasMethod(d, name)) {
                    cellSet(found, Some(d))
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def lookupDefLoose(defs: List Def, name: String): Option Def =
    match lookupDefExact(defs, name) {
        Some(d) -> Some(d),
        None -> {
            let suffix = "." + name;
            let cur = cellNew(defs);
            let found: Cell (Option Def) = cellNew(None);
            while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(d, r) -> {
                        if (strEndsWith(d.ident, suffix)) cellSet(found, Some(d)) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
    }

def lookupDefAtOffset(defs: List Def, fileId: Int, off: Int): Option Def = {
    let cur = cellNew(defs);
    let found: Cell (Option Def) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (spanContains(d.dpos, fileId, off)) cellSet(found, Some(d)) else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def lookupLocalBinding(locals: List (String, Span), name: String): Option Span = match locals {
    Nil -> None,
    Cons((n, sp), r) -> if (n == name) Some(sp) else lookupLocalBinding(r, name),
}

def docForDef(files: Vec SourceFile, d: Def): String =
    match getSourceFileFromVec(files, d.dpos.fileId) {
        Some(sf) -> formatDocCommentMarkdown(sf.sfContent, d.dpos.start),
        None -> "",
    }

def findParsedDefByName(items: List ModuleItem, name: String): Option Def = {
    let cur = cellNew(items);
    let found: Cell (Option Def) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), r) -> {
                if (d.ident == name || defHasVariant(d, name) || defHasMethod(d, name)) {
                    cellSet(found, Some(d))
                } else ();
                cellSet(cur, r)
            },
            Cons(ModSub(_, _, subItems, _), r) -> {
                match findParsedDefByName(subItems, name) {
                    Some(sd) -> cellSet(found, Some(sd)),
                    None -> (),
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

// ============================================================================
// Hover (`textDocument/hover`)
// ============================================================================

def makeHoverResult(md: String, rangeOpt: Option Value): Value = {
    let contents = VObj([
        ("kind", VStr("markdown")),
        ("value", VStr(md)),
    ]);
    match rangeOpt {
        Some(r) -> VObj([("contents", contents), ("range", r)]),
        None -> VObj([("contents", contents)]),
    }
}

def formatHoverBlock(codeLine: String, docMd: String): String =
    if (strLen(docMd) > 0) "```geisha\n" + codeLine + "\n```\n\n" + docMd
    else "```geisha\n" + codeLine + "\n```"

def handleHover(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                let wordOpt = identAtOffset(doc.dsText, off);
                let fromInfer: Option Value = match doc.dsInfer {
                    None -> None,
                    Some(inf) -> {
                        match findInnermostFormInDefs(inf.defs, doc.dsFileId, off) {
                            Some(ff) -> {
                                let f: Form = ff.ffForm;
                                let tyStr = formatScheme(f.ty);
                                let rng = Some(makeLspRange(doc.dsText, f.pos.start, f.pos.end));
                                match f.node {
                                    ExVar(qname) -> {
                                        let docStr = match lookupDefExact(inf.defs, qname) {
                                            Some(d) -> docForDef(doc.dsFiles, d),
                                            None -> "",
                                        };
                                        let label = shortSymName(qname);
                                        Some(makeHoverResult(formatHoverBlock(label + ": " + tyStr, docStr), rng))
                                    },
                                    ExStructInit(qname, _) -> {
                                        let docStr = match lookupDefExact(inf.defs, qname) {
                                            Some(d) -> docForDef(doc.dsFiles, d),
                                            None -> "",
                                        };
                                        let label = shortSymName(qname);
                                        Some(makeHoverResult(formatHoverBlock(label + ": " + tyStr, docStr), rng))
                                    },
                                    _ ->
                                        Some(makeHoverResult(formatHoverBlock(tyStr, ""), rng)),
                                }
                            },
                            None -> match lookupDefAtOffset(inf.defs, doc.dsFileId, off) {
                                Some(d) -> {
                                    let sig = match d.item {
                                        ItForm(f) -> d.ident + ": " + formatScheme(f.ty),
                                        _ -> formatDefSig(d),
                                    };
                                    let docStr = docForDef(doc.dsFiles, d);
                                    Some(makeHoverResult(formatHoverBlock(sig, docStr), Some(makeLspRange(doc.dsText, d.dpos.start, d.dpos.end))))
                                },
                                None -> match wordOpt {
                                    Some((word, ws, we)) -> match lookupDefLoose(inf.defs, word) {
                                        Some(d) -> {
                                            let sig = match d.item {
                                                ItForm(f) -> shortSymName(d.ident) + ": " + formatScheme(f.ty),
                                                _ -> formatDefSig(d),
                                            };
                                            let docStr = docForDef(doc.dsFiles, d);
                                            Some(makeHoverResult(formatHoverBlock(sig, docStr), Some(makeLspRange(doc.dsText, ws, we))))
                                        },
                                        None -> None,
                                    },
                                    None -> None,
                                },
                            },
                        }
                    },
                };
                match fromInfer {
                    Some(v) -> v,
                    None -> match (doc.dsParsed, wordOpt) {
                        (Some(fm), Some((word, ws, we))) -> match findParsedDefByName(fm.items, word) {
                            Some(d) -> {
                                let sig = formatDefSig(d);
                                let docStr = formatDocCommentMarkdown(doc.dsText, d.dpos.start);
                                makeHoverResult(formatHoverBlock(sig, docStr), Some(makeLspRange(doc.dsText, ws, we)))
                            },
                            None -> VNull,
                        },
                        _ -> VNull,
                    },
                }
            },
            _ -> VNull,
        },
        _ -> VNull,
    }
}

// ============================================================================
// Go to Definition (`textDocument/definition`)
// ============================================================================

def makeLocationFromSpan(files: Vec SourceFile, currentUri: String, currentText: String, currentFileId: Int, sp: Span): Option Value =
    if (sp.fileId == currentFileId) {
        Some(VObj([
            ("uri", VStr(currentUri)),
            ("range", makeLspRange(currentText, sp.start, sp.end)),
        ]))
    } else {
        match getSourceFileFromVec(files, sp.fileId) {
            Some(sf) ->
                if (strStartsWith(sf.sfPath, "/") || fileExists(sf.sfPath)) {
                    Some(VObj([
                        ("uri", VStr(pathToUri(sf.sfPath))),
                        ("range", makeLspRange(sf.sfContent, sp.start, sp.end)),
                    ]))
                } else None,
            None -> None,
        }
    }

def handleDefinition(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                let wordOpt = identAtOffset(doc.dsText, off);
                let fromInfer: Option Value = match doc.dsInfer {
                    None -> None,
                    Some(inf) -> {
                        let byForm: Option Value = match findInnermostFormInDefs(inf.defs, doc.dsFileId, off) {
                            Some(ff) -> match ff.ffForm.node {
                                ExVar(qname) -> match lookupLocalBinding(ff.ffLocals, qname) {
                                    Some(locSp) -> makeLocationFromSpan(doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, locSp),
                                    None -> match lookupDefExact(inf.defs, qname) {
                                        Some(d) -> makeLocationFromSpan(doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, d.dpos),
                                        None -> None,
                                    },
                                },
                                ExStructInit(qname, _) -> match lookupDefExact(inf.defs, qname) {
                                    Some(d) -> makeLocationFromSpan(doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, d.dpos),
                                    None -> None,
                                },
                                _ -> None,
                            },
                            None -> None,
                        };
                        match byForm {
                            Some(v) -> Some(v),
                            None -> match wordOpt {
                                Some((word, _, _)) -> match lookupDefLoose(inf.defs, word) {
                                    Some(d) -> makeLocationFromSpan(doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, d.dpos),
                                    None -> None,
                                },
                                None -> None,
                            },
                        }
                    },
                };
                match fromInfer {
                    Some(v) -> v,
                    None -> match (doc.dsParsed, wordOpt) {
                        (Some(fm), Some((word, _, _))) -> match findParsedDefByName(fm.items, word) {
                            Some(d) -> VObj([
                                ("uri", VStr(doc.dsUri)),
                                ("range", makeLspRange(doc.dsText, d.dpos.start, d.dpos.end)),
                            ]),
                            None -> VNull,
                        },
                        _ -> VNull,
                    },
                }
            },
            _ -> VNull,
        },
        _ -> VNull,
    }
}

// ============================================================================
// Document Symbols (`textDocument/documentSymbol`)
// ============================================================================

def findSubstrInSpan(src: String, needle: String, startByte: Int, endByte: Int): (Int, Int) = {
    let n = strLen(src);
    let nl = strLen(needle);
    let s = if (startByte < 0) 0 else if (startByte > n) n else startByte;
    let e = if (endByte < s) s else if (endByte > n) n else endByte;
    if (nl == 0 || s + nl > e) (s, if (e > s) e else s)
    else {
        let i = cellNew(s);
        let found = cellNew(-1);
        let limit = e - nl;
        while (cellGet(i) <= limit && cellGet(found) < 0) {
            let cur = cellGet(i);
            if (strStartsWith(strSlice(src, cur, cur + nl), needle)) {
                cellSet(found, cur)
            } else {
                cellSet(i, cur + 1)
            }
        };
        let f = cellGet(found);
        if (f >= 0) (f, f + nl) else (s, if (e > s) e else s)
    }
}

def defSymbolKind(d: Def): Int = match d.item {
    ItAlg(_, vs) -> match vs {
        Cons(v, Nil) -> match v.vbody { VarStruct(_) -> 23, _ -> 10 },
        _ -> 10,
    },
    ItAlias(_, _) -> 26,
    ItConcept(_, _, _, _) -> 11,
    ItInstance(_, _, _, _) -> 5,
    ItExtern(_, _, _, _) -> 12,
    ItForm(f) -> match f.node {
        ExAbs(_, _, _) -> 12,
        _ -> 13,
    },
}

def defSymbolName(d: Def): String = match d.item {
    ItInstance(cname, _, _, _) -> "instance " + cname,
    _ -> d.ident,
}

def buildDefSymbol(src: String, d: Def): Value = {
    let fullRange = makeLspRange(src, d.dpos.start, d.dpos.end);
    let (selS, selE) = findSubstrInSpan(src, d.ident, d.dpos.start, d.dpos.end);
    let selRange = makeLspRange(src, selS, selE);
    let children: List Value = match d.item {
        ItAlg(_, vs) -> {
            let acc = cellNew(Nil);
            let cur = cellNew(vs);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(v, r) -> {
                        let (vs1, ve1) = findSubstrInSpan(src, v.vname, d.dpos.start, d.dpos.end);
                        let vr = makeLspRange(src, vs1, ve1);
                        cellSet(acc, listAppend(cellGet(acc), [VObj([
                            ("name", VStr(v.vname)),
                            ("detail", VStr(formatVariant(v))),
                            ("kind", VInt(intToI64(22))),
                            ("range", vr),
                            ("selectionRange", vr),
                        ])]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(acc)
        },
        ItConcept(_, _, _, ms) -> {
            let acc = cellNew(Nil);
            let cur = cellNew(ms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(m, r) -> {
                        let (ms1, me1) = findSubstrInSpan(src, m.mname, d.dpos.start, d.dpos.end);
                        let mr = makeLspRange(src, ms1, me1);
                        cellSet(acc, listAppend(cellGet(acc), [VObj([
                            ("name", VStr(m.mname)),
                            ("detail", VStr(formatScheme(m.mty))),
                            ("kind", VInt(intToI64(6))),
                            ("range", mr),
                            ("selectionRange", mr),
                        ])]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(acc)
        },
        _ -> Nil,
    };
    let baseFields = [
        ("name", VStr(defSymbolName(d))),
        ("detail", VStr(formatDefSig(d))),
        ("kind", VInt(intToI64(defSymbolKind(d)))),
        ("range", fullRange),
        ("selectionRange", selRange),
    ];
    match children {
        Nil -> VObj(baseFields),
        cs -> VObj(listAppend(baseFields, [("children", VArr(cs))])),
    }
}

def buildModuleSymbols(src: String, items: List ModuleItem): List Value = {
    let acc = cellNew(Nil);
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), r) -> {
                cellSet(acc, listAppend(cellGet(acc), [buildDefSymbol(src, d)]));
                cellSet(cur, r)
            },
            Cons(ModSub(_, subName, subItems, sp), r) -> {
                let rng = makeLspRange(src, sp.start, sp.end);
                let (selS, selE) = findSubstrInSpan(src, subName, sp.start, sp.end);
                let selRng = makeLspRange(src, selS, selE);
                let subSyms = buildModuleSymbols(src, subItems);
                cellSet(acc, listAppend(cellGet(acc), [VObj([
                    ("name", VStr(subName)),
                    ("kind", VInt(intToI64(2))),
                    ("range", rng),
                    ("selectionRange", selRng),
                    ("children", VArr(subSyms)),
                ])]));
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(acc)
}

def handleDocumentSymbol(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    match uriOpt {
        Some(uri) -> match strMapGet(ss.ssDocs, uri) {
            Some(doc) -> match doc.dsParsed {
                Some(fm) -> VArr(buildModuleSymbols(doc.dsText, fm.items)),
                None -> VArr(Nil),
            },
            None -> VArr(Nil),
        },
        None -> VArr(Nil),
    }
}

// ============================================================================
// Completion (`textDocument/completion`)
// ============================================================================

def makeCompItem(label: String, kind: Int, detail: String, docMd: String): Value = {
    let f0 = [
        ("label", VStr(label)),
        ("kind", VInt(intToI64(kind))),
    ];
    let f1 = if (strLen(detail) > 0) listAppend(f0, [("detail", VStr(detail))]) else f0;
    let f2 =
        if (strLen(docMd) > 0) {
            listAppend(f1, [("documentation", VObj([("kind", VStr("markdown")), ("value", VStr(docMd))]))])
        } else f1;
    VObj(f2)
}

def addUniqueComp(seen: StrMap Bool, out: Cell (List Value), label: String, kind: Int, detail: String, docMd: String, prefix: String): Void = {
    if (strLen(label) > 0 && !strMapContains(seen, label)) {
        let matches =
            if (strLen(prefix) == 0) true
            else strStartsWith(toLowerAscii(label), toLowerAscii(prefix));
        if (matches) {
            strMapInsert(seen, label, true);
            cellSet(out, listAppend(cellGet(out), [makeCompItem(label, kind, detail, docMd)]))
        } else ()
    } else ()
}

def completionKindForDef(d: Def): Int = match d.item {
    ItAlg(_, _) -> 13,
    ItAlias(_, _) -> 7,
    ItConcept(_, _, _, _) -> 8,
    ItInstance(_, _, _, _) -> 7,
    ItExtern(_, _, _, _) -> 3,
    ItForm(f) -> match f.node {
        ExAbs(_, _, _) -> 3,
        _ -> 6,
    },
}

def collectDefsFromModuleItems(
    src: String,
    items: List ModuleItem,
    onlyPub: Bool,
    seen: StrMap Bool,
    out: Cell (List Value),
    prefix: String
): Void = {
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(vis, d), r) -> {
                if (!onlyPub || isPublicVis(vis)) {
                    let sig = formatDefSig(d);
                    let docMd = formatDocCommentMarkdown(src, d.dpos.start);
                    match d.item {
                        ItInstance(_, _, _, _) -> (),
                        _ -> addUniqueComp(seen, out, d.ident, completionKindForDef(d), sig, docMd, prefix),
                    };
                    match d.item {
                        ItAlg(_, vs) -> {
                            let cv = cellNew(vs);
                            while (match cellGet(cv) { Nil -> false, _ -> true }) {
                                match cellGet(cv) {
                                    Cons(v, rv) -> {
                                        addUniqueComp(seen, out, v.vname, 4, formatVariant(v), "", prefix);
                                        cellSet(cv, rv)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        ItConcept(_, _, _, ms) -> {
                            let cm = cellNew(ms);
                            while (match cellGet(cm) { Nil -> false, _ -> true }) {
                                match cellGet(cm) {
                                    Cons(m, rm) -> {
                                        addUniqueComp(seen, out, m.mname, 2, formatScheme(m.mty), "", prefix);
                                        cellSet(cm, rm)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        _ -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    }
}

def collectBuiltinModuleExports(modKey: String, seen: StrMap Bool, out: Cell (List Value), prefix: String): Bool =
    match builtinModuleSource(modKey) {
        None -> false,
        Some(src) -> {
            match parseFileModuleInFile(src, Nil, 0) {
                Ok(fm) -> {
                    collectDefsFromModuleItems(src, fm.items, true, seen, out, prefix);
                    true
                },
                Err(_) -> false,
            }
        },
    }

def resolveImportedAliasModKey(items: List ModuleItem, aliasName: String): Option String = {
    let cur = cellNew(items);
    let found: Cell (Option String) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, UseAlias(segs, al)), r) -> {
                if (al == aliasName) cellSet(found, Some(strJoin(segs, "."))) else ();
                cellSet(cur, r)
            },
            Cons(ModUse(_, UseSingle(segs)), r) -> {
                let full = strJoin(segs, ".");
                if (shortSymName(full) == aliasName) cellSet(found, Some(full)) else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

def extractDotQualifier(src: String, off: Int): (String, String) = {
    let n = strLen(src);
    let end = if (off < 0) 0 else if (off > n) n else off;
    // Walk back over identifier characters for the trailing partial token
    let p = cellNew(end);
    while (cellGet(p) > 0 && isIdentContByte(strByteAt(src, cellGet(p) - 1))) {
        cellSet(p, cellGet(p) - 1)
    };
    let partial = strSlice(src, cellGet(p), end);
    if (cellGet(p) > 0 && strByteAt(src, cellGet(p) - 1) == 46) {
        let qEnd = cellGet(p) - 1;
        let qStart = cellNew(qEnd);
        while (cellGet(qStart) > 0 && (isIdentContByte(strByteAt(src, cellGet(qStart) - 1)) || strByteAt(src, cellGet(qStart) - 1) == 46)) {
            cellSet(qStart, cellGet(qStart) - 1)
        };
        (strSlice(src, cellGet(qStart), qEnd), partial)
    } else {
        ("", partial)
    }
}

def linePrefixBefore(src: String, off: Int): String = {
    let n = strLen(src);
    let end = if (off < 0) 0 else if (off > n) n else off;
    let s = cellNew(end);
    while (cellGet(s) > 0 && strByteAt(src, cellGet(s) - 1) != 10) {
        cellSet(s, cellGet(s) - 1)
    };
    strTrim(strSlice(src, cellGet(s), end))
}

def collectUseImportsCompletion(items: List ModuleItem, seen: StrMap Bool, out: Cell (List Value), prefix: String): Void = {
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseMulti(modSegs, specs) -> {
                        let modKey = strJoin(modSegs, ".");
                        let cs = cellNew(specs);
                        while (match cellGet(cs) { Nil -> false, _ -> true }) {
                            match cellGet(cs) {
                                Cons(sp, rs) -> {
                                    addUniqueComp(seen, out, useSpecLocalName(sp), 3, "from " + modKey, "", prefix);
                                    cellSet(cs, rs)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    UseSingle(segs) -> {
                        let full = strJoin(segs, ".");
                        addUniqueComp(seen, out, shortSymName(full), 3, "from " + full, "", prefix)
                    },
                    UseAlias(segs, al) -> {
                        let full = strJoin(segs, ".");
                        addUniqueComp(seen, out, al, 9, "alias for " + full, "", prefix)
                    },
                    UseGlob(segs) -> {
                        let modKey = strJoin(segs, ".");
                        let _ = collectBuiltinModuleExports(modKey, seen, out, prefix);
                        ()
                    },
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    }
}

def addBuiltinSubmodules(rootPrefix: String, seen: StrMap Bool, out: Cell (List Value), partial: String): Void = {
    let want = rootPrefix + ".";
    let cur = cellNew(builtinModuleKeys());
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(k, r) -> {
                if (strStartsWith(k, want)) {
                    let sub = strSlice(k, strLen(want), strLen(k));
                    addUniqueComp(seen, out, sub, 9, "builtin module " + k, "", partial)
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def addGeishaKeywordsAndBuiltins(seen: StrMap Bool, out: Cell (List Value), prefix: String): Void = {
    let kws = [
        "def", "pub", "data", "type", "concept", "instance", "use", "mod",
        "open", "as", "let", "in", "if", "else", "while", "match", "extern",
        "forall", "true", "false", "Void", "Int", "Int64", "Float", "Float32",
        "Bool", "Char", "String", "List", "Cell", "Array", "ImmArray", "Ptr",
        "ForeignPtr", "ScopedPtr", "Nil", "Cons", "std", "sys"
    ];
    let ck = cellNew(kws);
    while (match cellGet(ck) { Nil -> false, _ -> true }) {
        match cellGet(ck) {
            Cons(k, r) -> {
                addUniqueComp(seen, out, k, 14, "keyword / builtin", "", prefix);
                cellSet(ck, r)
            },
            Nil -> (),
        }
    };
    let prims = [
        ("printLn", "(String) -> Void"),
        ("strLen", "(String) -> Int"),
        ("strByteAt", "(String, Int) -> Int"),
        ("strSlice", "(String, Int, Int) -> String"),
        ("strConcat", "(String, String) -> String"),
        ("cellNew", "(a) -> Cell a"),
        ("cellGet", "(Cell a) -> a"),
        ("cellSet", "(Cell a, a) -> Void"),
        ("arrayNew", "(Int, a) -> Array a"),
        ("arrayGet", "(Array a, Int) -> a"),
        ("arraySet", "(Array a, Int, a) -> Void"),
        ("arrayLen", "(Array a) -> Int"),
        ("intToI64", "(Int) -> Int64"),
        ("i64ToInt", "(Int64) -> Int"),
        ("ptrIsNull", "(Ptr) -> Bool"),
        ("ptrNull", "() -> Ptr"),
        ("ptrToString", "(Ptr) -> String"),
        ("ptrAllocBytes", "(Int) -> Ptr"),
        ("ptrByteAt", "(Ptr, Int) -> Int"),
        ("ptrSliceFromStr", "(String, Int, Int) -> String"),
        ("ptrSliceToString", "(Ptr, Int) -> String"),
        ("parTabulate", "(Int, (Int) -> a) -> Array a"),
        ("cFnPtr", "(fn) -> Ptr")
    ];
    let cp = cellNew(prims);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons((nm, sig), r) -> {
                addUniqueComp(seen, out, nm, 3, sig, "", prefix);
                cellSet(cp, r)
            },
            Nil -> (),
        }
    }
}

def handleCompletion(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                let (qual, partial) = extractDotQualifier(doc.dsText, off);
                let seen: StrMap Bool = strMapNew();
                let items: Cell (List Value) = cellNew(Nil);

                if (strLen(qual) > 0) {
                    if (qual == "std" || qual == "sys") {
                        addBuiltinSubmodules(qual, seen, items, partial)
                    } else {
                        let resolvedKey = match doc.dsParsed {
                            Some(fm) -> match resolveImportedAliasModKey(fm.items, qual) {
                                Some(rk) -> rk,
                                None -> qual,
                            },
                            None -> qual,
                        };
                        let okBuiltin = collectBuiltinModuleExports(resolvedKey, seen, items, partial);
                        if (!okBuiltin) {
                            // Also check inferred definitions with `<resolvedKey>.` prefix
                            match doc.dsInfer {
                                Some(inf) -> {
                                    let pfx = resolvedKey + ".";
                                    let cd = cellNew(inf.defs);
                                    while (match cellGet(cd) { Nil -> false, _ -> true }) {
                                        match cellGet(cd) {
                                            Cons(d, r) -> {
                                                if (strStartsWith(d.ident, pfx) && isPublicVis(d.vis)) {
                                                    let shortName = strSlice(d.ident, strLen(pfx), strLen(d.ident));
                                                    let sig = match d.item {
                                                        ItForm(f) -> formatScheme(f.ty),
                                                        _ -> formatDefSig(d),
                                                    };
                                                    let docMd = docForDef(doc.dsFiles, d);
                                                    addUniqueComp(seen, items, shortName, completionKindForDef(d), sig, docMd, partial)
                                                } else ();
                                                cellSet(cd, r)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                },
                                None -> (),
                            }
                        } else ()
                    }
                } else {
                    let linePfx = linePrefixBefore(doc.dsText, off);
                    if (strStartsWith(linePfx, "use ") || strStartsWith(linePfx, "pub use ")) {
                        let ck = cellNew(builtinModuleKeys());
                        while (match cellGet(ck) { Nil -> false, _ -> true }) {
                            match cellGet(ck) {
                                Cons(k, r) -> {
                                    addUniqueComp(seen, items, k, 9, "builtin module", "", partial);
                                    cellSet(ck, r)
                                },
                                Nil -> (),
                            }
                        }
                    } else ();
                    // 1. Current document definitions & explicit imports
                    match doc.dsParsed {
                        Some(fm) -> {
                            collectDefsFromModuleItems(doc.dsText, fm.items, false, seen, items, partial);
                            collectUseImportsCompletion(fm.items, seen, items, partial)
                        },
                        None -> (),
                    };
                    // 2. Local inferred defs (with inferred types)
                    match doc.dsInfer {
                        Some(inf) -> {
                            let cd = cellNew(inf.defs);
                            while (match cellGet(cd) { Nil -> false, _ -> true }) {
                                match cellGet(cd) {
                                    Cons(d, r) -> {
                                        if (d.dpos.fileId == doc.dsFileId) {
                                            let sig = match d.item {
                                                ItForm(f) -> formatScheme(f.ty),
                                                _ -> formatDefSig(d),
                                            };
                                            addUniqueComp(seen, items, d.ident, completionKindForDef(d), sig, docForDef(doc.dsFiles, d), partial)
                                        } else ();
                                        cellSet(cd, r)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    };
                    // 3. Builtins & keywords
                    addGeishaKeywordsAndBuiltins(seen, items, partial)
                };

                VObj([
                    ("isIncomplete", VBool(false)),
                    ("items", VArr(cellGet(items))),
                ])
            },
            _ -> VArr(Nil),
        },
        _ -> VArr(Nil),
    }
}

// ============================================================================
// JSON-RPC Dispatcher & Main Loop
// ============================================================================

def handleInitialize(ss: ServerState, params: Value): Value = {
    match objGetStr(params, "rootUri") {
        Some(ru) -> cellSet(ss.ssRootDir, Some(uriToPath(ru))),
        None -> match objGetStr(params, "rootPath") {
            Some(rp) -> cellSet(ss.ssRootDir, Some(rp)),
            None -> (),
        },
    };
    VObj([
        ("capabilities", VObj([
            ("textDocumentSync", VObj([
                ("openClose", VBool(true)),
                ("change", VInt(intToI64(1))),
                ("save", VObj([("includeText", VBool(true))])),
            ])),
            ("hoverProvider", VBool(true)),
            ("definitionProvider", VBool(true)),
            ("documentSymbolProvider", VBool(true)),
            ("completionProvider", VObj([
                ("triggerCharacters", VArr([VStr(".")])),
            ])),
        ])),
        ("serverInfo", VObj([
            ("name", VStr("geisha-lsp")),
            ("version", VStr("0.1.0")),
        ])),
    ])
}

def handleDidOpen(ss: ServerState, params: Value): Void =
    match objGet(params, "textDocument") {
        Some(td) -> match (objGetStr(td, "uri"), objGetStr(td, "text")) {
            (Some(uri), Some(text)) -> {
                let ver = match objGetInt(td, "version") { Some(v) -> v, None -> 0 };
                analyzeAndPublish(ss, uri, text, ver)
            },
            _ -> (),
        },
        None -> (),
    }

def handleDidChange(ss: ServerState, params: Value): Void =
    match (objGet(params, "textDocument"), objGet(params, "contentChanges")) {
        (Some(td), Some(VArr(changes))) -> match objGetStr(td, "uri") {
            Some(uri) -> {
                let ver = match objGetInt(td, "version") { Some(v) -> v, None -> 0 };
                let lastText: Cell (Option String) = cellNew(None);
                let cur = cellNew(changes);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(ch, r) -> {
                            match objGetStr(ch, "text") {
                                Some(t) -> cellSet(lastText, Some(t)),
                                None -> (),
                            };
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                match cellGet(lastText) {
                    Some(text) -> analyzeAndPublish(ss, uri, text, ver),
                    None -> (),
                }
            },
            None -> (),
        },
        _ -> (),
    }

def handleDidSave(ss: ServerState, params: Value): Void =
    match objGet(params, "textDocument") {
        Some(td) -> match objGetStr(td, "uri") {
            Some(uri) -> match objGetStr(params, "text") {
                Some(text) -> analyzeAndPublish(ss, uri, text, 0),
                None -> match strMapGet(ss.ssDocs, uri) {
                    Some(doc) -> analyzeAndPublish(ss, uri, doc.dsText, doc.dsVersion),
                    None -> (),
                },
            },
            None -> (),
        },
        None -> (),
    }

def handleDidClose(ss: ServerState, params: Value): Void =
    match objGet(params, "textDocument") {
        Some(td) -> match objGetStr(td, "uri") {
            Some(uri) -> sendRpcNotification("textDocument/publishDiagnostics", VObj([
                ("uri", VStr(uri)),
                ("diagnostics", VArr(Nil)),
            ])),
            None -> (),
        },
        None -> (),
    }

pub def cmdLsp(args: List String): Result Int String = {
    let _ = args;
    let ss = MkServerState {
        ssDocs: strMapNew(),
        ssShuttingDown: cellNew(false),
        ssRootDir: cellNew(None),
    };
    let reader = stdinReaderNew();
    let running = cellNew(true);
    let exitCode = cellNew(0);

    while (cellGet(running)) {
        match readLspMessage(reader) {
            None -> cellSet(running, false),
            Some(rawJson) -> match jsonParse(rawJson) {
                Err(e) -> eprintLn("geisha lsp: invalid JSON-RPC payload: " + e),
                Ok(msg) -> {
                    let idOpt = objGet(msg, "id");
                    let methodOpt = objGetStr(msg, "method");
                    let params = match objGet(msg, "params") {
                        Some(p) -> p,
                        None -> VObj(Nil),
                    };
                    match methodOpt {
                        None -> (),
                        Some(method) ->
                            if (method == "initialize") {
                                let res = handleInitialize(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "initialized") {
                                ()
                            } else if (method == "shutdown") {
                                cellSet(ss.ssShuttingDown, true);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, VNull), None -> () }
                            } else if (method == "exit") {
                                cellSet(exitCode, if (cellGet(ss.ssShuttingDown)) 0 else 1);
                                cellSet(running, false)
                            } else if (method == "textDocument/didOpen") {
                                handleDidOpen(ss, params)
                            } else if (method == "textDocument/didChange") {
                                handleDidChange(ss, params)
                            } else if (method == "textDocument/didSave") {
                                handleDidSave(ss, params)
                            } else if (method == "textDocument/didClose") {
                                handleDidClose(ss, params)
                            } else if (method == "textDocument/hover") {
                                let res = handleHover(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/definition") {
                                let res = handleDefinition(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/documentSymbol") {
                                let res = handleDocumentSymbol(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/completion") {
                                let res = handleCompletion(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (strStartsWith(method, "$/")) {
                                ()
                            } else {
                                match idOpt {
                                    Some(idVal) -> sendRpcError(idVal, -32601, "Method not found: " + method),
                                    None -> (),
                                }
                            },
                    }
                },
            },
        }
    };
    Ok(cellGet(exitCode))
}
