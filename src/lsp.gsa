// Geisha Language Server Protocol (LSP 3.17 over stdio JSON-RPC 2.0)
//
// Reuses the compiler frontend (`lexer`, `parser`, `loader`, `infer`, `core`, `doc`, `diag`)
// and `std.json` to provide live diagnostics, hover (inferred types + `///` docs),
// go-to-definition, document symbols, and completion (local/imported symbols + `std.*`/`sys.*`).

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend}
use std.vec.{Vec, vecNew, vecLen, vecGetOr}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains, strMapRemove}
use std.buf.{bufNew, bufPushByte, bufPushStr, bufToString}
use std.str.{
    intToStr, parseInt, strStartsWith, strEndsWith, strContains,
    strIndexOfByte, strSplitChar, strJoin, strTrim
}
use std.char.{isIdentStartByte, isIdentContByte}
use std.path.{pathDirname, pathJoin, pathStem}
use std.codec.{Value, VNull, VBool, VInt, VStr, VArr, VObj}
use std.json.{parse as jsonParse, stringify as jsonStringify}
use sys.env.hostOs
use sys.fs.{fileExists, isDir, readDir, readFile}
use sys.io.eprintLn
use ast.{
    Span, MkSpan, isPublicVis,
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmSlot, schemeBody,
    VarDecl, Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct,
    MatchArm, Form,
    Expr, ExLit, ExVar, ExTuple, ExStructInit, ExList, ExBlock, ExApply,
    ExAbs, ExBin, ExUn, ExLet, ExIf, ExWhile, ExMatch, ExField, ExTry,
    FieldDecl, VariantBody, VarUnit, VarTuple, VarStruct, VariantDef, MethodDecl,
    Item, ItForm, ItExtern, ItAlias, ItAlg, ItConcept, ItInstance,
    Def, UseSpec, useSpecLocalName,
    UseItem, UseSingle, UseMulti, UseGlob, UseAlias,
    ModuleItem, ModDef, ModUse, ModSub,
    FileModule
}
use diag.{
    SourceFile, MkSourceFile,
    diagReset, diagRegisterFile, diagRegisteredFiles, diagLastError
}
use lexer.{Token, MkToken, TokKind, TkIdent, TkDot, TkLBrace, TkRBrace, TkLParen, TkRParen, TkComma, TkDef, TkSym, TkEof, tokenizeInFile}
use parser.parseFileModuleInFile
use loader.{
    PkgSpec, MkPkgSpec, NameInfo, loadSingleSourceProgramWithPkgsNamed,
    loaderCanonicalPath, loaderSetOverlay, loaderRemoveOverlay, loaderLastPublicExports
}
use infer.{InferOutput, AdtInfo, VariantInfo, inferProgram, preludePrimSpecs}
use core.lowerToCoreForCheck
use doc.{formatScheme, formatVariant, extractDocComment, formatDefSig}
use stdlib_bundle.{builtinModuleKeys, builtinModuleSource}
use pkg.{findProjectRoot, resolveProjectGraph, toLoaderPkgSpecs, sanitizeIdentAlias}

extern "gs_pipe_read" def gs_pipe_read(fd: Int, buf: Ptr, cap: Int): Int
extern "gs_pipe_write" def gs_pipe_write(fd: Int, buf: String, len: Int): Int

// ============================================================================
// Buffered stdio JSON-RPC 2.0 Framing (Content-Length)
// ============================================================================

data StdinReader {
    MkStdinReader {
        srBuf: Ptr,
        srCap: Int,
        srPos: Cell Int,
        srLen: Cell Int,
    },
}

def stdinReaderNew(): StdinReader = {
    let cap = 65536;
    MkStdinReader {
        srBuf: ptrAllocBytes(cap),
        srCap: cap,
        srPos: cellNew(0),
        srLen: cellNew(0),
    }
}

def stdinReadByte(r: StdinReader): Int = {
    let pos = cellGet(r.srPos);
    let len = cellGet(r.srLen);
    if (pos < len) {
        cellSet(r.srPos, pos + 1);
        ptrByteAt(r.srBuf, pos)
    } else {
        let got = gs_pipe_read(0, r.srBuf, r.srCap);
        if (got <= 0) {
            -1
        } else {
            cellSet(r.srPos, 1);
            cellSet(r.srLen, got);
            ptrByteAt(r.srBuf, 0)
        }
    }
}

def stdinReadLine(r: StdinReader): Option String = {
    let b = bufNew();
    let any = cellNew(false);
    let done = cellNew(false);
    while (!cellGet(done)) {
        let ch = stdinReadByte(r);
        if (ch < 0) {
            cellSet(done, true)
        } else {
            cellSet(any, true);
            if (ch == 10) {
                cellSet(done, true)
            } else if (ch != 13) {
                bufPushByte(b, ch)
            } else ()
        }
    };
    if (!cellGet(any)) None else Some(bufToString(b))
}

def stdinReadExact(r: StdinReader, n: Int): Option String = {
    let b = bufNew();
    let rem = cellNew(n);
    let ok = cellNew(true);
    while (cellGet(rem) > 0 && cellGet(ok)) {
        let ch = stdinReadByte(r);
        if (ch < 0) {
            cellSet(ok, false)
        } else {
            bufPushByte(b, ch);
            cellSet(rem, cellGet(rem) - 1)
        }
    };
    if (cellGet(ok)) Some(bufToString(b)) else None
}

def writeAllStdout(s: String): Void = {
    let total = strLen(s);
    if (total > 0) {
        let _ = gs_pipe_write(1, s, total);
        ()
    } else ()
}

def sendRpcValue(v: Value): Void = {
    let body = jsonStringify(v);
    let frame = "Content-Length: " + intToStr(strLen(body)) + "\r\n\r\n" + body;
    writeAllStdout(frame)
}

def sendRpcResponse(idVal: Value, resultVal: Value): Void =
    sendRpcValue(VObj([
        ("jsonrpc", VStr("2.0")),
        ("id", idVal),
        ("result", resultVal),
    ]))

def sendRpcError(idVal: Value, code: Int, message: String): Void =
    sendRpcValue(VObj([
        ("jsonrpc", VStr("2.0")),
        ("id", idVal),
        ("error", VObj([
            ("code", VInt(intToI64(code))),
            ("message", VStr(message)),
        ])),
    ]))

def sendRpcNotification(method: String, paramsVal: Value): Void =
    sendRpcValue(VObj([
        ("jsonrpc", VStr("2.0")),
        ("method", VStr(method)),
        ("params", paramsVal),
    ]))

def toLowerAscii(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(s, idx);
        if (c >= 65 && c <= 90) bufPushByte(b, c + 32) else bufPushByte(b, c);
        cellSet(i, idx + 1)
    };
    bufToString(b)
}

def readLspMessage(r: StdinReader): Option String = {
    let contentLen = cellNew(-1);
    let eof = cellNew(false);
    let inHeaders = cellNew(true);
    while (cellGet(inHeaders) && !cellGet(eof)) {
        match stdinReadLine(r) {
            None -> cellSet(eof, true),
            Some(line) -> {
                if (strLen(line) == 0) {
                    if (cellGet(contentLen) >= 0) cellSet(inHeaders, false) else ()
                } else {
                    match strIndexOfByte(line, 58, 0) {
                        Some(col) -> {
                            let k = toLowerAscii(strTrim(strSlice(line, 0, col)));
                            let v = strTrim(strSlice(line, col + 1, strLen(line)));
                            if (k == "content-length") {
                                match parseInt(v) {
                                    Ok(n) -> cellSet(contentLen, n),
                                    Err(_) -> (),
                                }
                            } else ()
                        },
                        None -> (),
                    }
                }
            },
        }
    };
    if (cellGet(eof) || cellGet(contentLen) < 0) None
    else stdinReadExact(r, cellGet(contentLen))
}

// ============================================================================
// JSON Value Helpers
// ============================================================================

def objGet(v: Value, key: String): Option Value = match v {
    VObj(fields) -> {
        let cur = cellNew(fields);
        let found: Cell (Option Value) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((k, val), r) -> {
                    if (k == key) cellSet(found, Some(val)) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> None,
}

def objGetStr(v: Value, key: String): Option String = match objGet(v, key) {
    Some(VStr(s)) -> Some(s),
    _ -> None,
}

def objGetInt(v: Value, key: String): Option Int = match objGet(v, key) {
    Some(VInt(n)) -> Some(i64ToInt(n)),
    _ -> None,
}

def objGetBool(v: Value, key: String): Option Bool = match objGet(v, key) {
    Some(VBool(b)) -> Some(b),
    _ -> None,
}

// ============================================================================
// URI <-> Path & UTF-8 / UTF-16 Position Mapping (with CRLF & UTF-8 defense)
// ============================================================================

def hexDigitVal(b: Int): Int =
    if (b >= 48 && b <= 57) b - 48
    else if (b >= 65 && b <= 70) b - 55
    else if (b >= 97 && b <= 102) b - 87
    else -1

def hexUpperByte(n: Int): Int =
    if (n < 10) 48 + n else 55 + n

def percentDecode(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(s, idx);
        if (c == 37 && idx + 2 < n) {
            let h1 = hexDigitVal(strByteAt(s, idx + 1));
            let h2 = hexDigitVal(strByteAt(s, idx + 2));
            if (h1 >= 0 && h2 >= 0) {
                bufPushByte(b, (h1 << 4) | h2);
                cellSet(i, idx + 3)
            } else {
                bufPushByte(b, c);
                cellSet(i, idx + 1)
            }
        } else {
            bufPushByte(b, c);
            cellSet(i, idx + 1)
        }
    };
    bufToString(b)
}

def isUriSafeByte(c: Int): Bool =
    (c >= 65 && c <= 90)
    || (c >= 97 && c <= 122)
    || (c >= 48 && c <= 57)
    || c == 47 || c == 45 || c == 95 || c == 46 || c == 126 || c == 58

def percentEncodePath(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let c = strByteAt(s, idx);
        if (isUriSafeByte(c)) {
            bufPushByte(b, c)
        } else {
            bufPushByte(b, 37);
            bufPushByte(b, hexUpperByte((c >>> 4) & 15));
            bufPushByte(b, hexUpperByte(c & 15))
        };
        cellSet(i, idx + 1)
    };
    bufToString(b)
}

def isAsciiLetter(c: Int): Bool =
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122)

def stripWinLeadingSlash(dec: String): String =
    if (strLen(dec) >= 3 && strByteAt(dec, 0) == 47 && isAsciiLetter(strByteAt(dec, 1)) && strByteAt(dec, 2) == 58) {
        strSlice(dec, 1, strLen(dec))
    } else dec

def uriToPath(uri: String): String =
    if (strStartsWith(uri, "file://")) {
        let rest = strSlice(uri, 7, strLen(uri));
        if (strStartsWith(rest, "/")) {
            // Local file URI: `file:///Users/...` or `file:///C:/...`
            stripWinLeadingSlash(percentDecode(rest))
        } else if (strStartsWith(rest, "localhost/")) {
            let localPart = strSlice(rest, 9, strLen(rest));
            stripWinLeadingSlash(percentDecode(localPart))
        } else {
            // UNC authority URI: `file://server/share/...` -> `//server/share/...`
            "//" + percentDecode(rest)
        }
    } else uri

def normalizeUriPath(path: String): String =
    if (hostOs() != "windows") path
    else {
        let n = strLen(path);
        let b = bufNew();
        let i = cellNew(0);
        while (cellGet(i) < n) {
            let c = strByteAt(path, cellGet(i));
            bufPushByte(b, if (c == 92) 47 else c);
            cellSet(i, cellGet(i) + 1)
        };
        bufToString(b)
    }

def pathToUri(path: String): String =
    if (strStartsWith(path, "file://")) path
    else {
        let norm = normalizeUriPath(path);
        if (strStartsWith(norm, "//")) "file://" + percentEncodePath(strSlice(norm, 2, strLen(norm)))
        else if (strStartsWith(norm, "/")) "file://" + percentEncodePath(norm)
        else "file:///" + percentEncodePath(norm)
    }

def isUtf8Cont(b: Int): Bool = b >= 128 && b < 192

// Returns `(byteStep, utf16Width)` for the UTF-8 sequence starting at `idx`.
// Defends against stray continuation bytes, truncated sequences, and `\r\n`.
def utf8StepAt(src: String, n: Int, idx: Int): (Int, Int) = {
    let b = strByteAt(src, idx);
    if (b == 13 && idx + 1 < n && strByteAt(src, idx + 1) == 10) {
        (1, 0)
    } else if (b < 128) {
        (1, 1)
    } else if (b >= 192 && b < 224) {
        if (idx + 1 < n && isUtf8Cont(strByteAt(src, idx + 1))) (2, 1) else (1, 1)
    } else if (b >= 224 && b < 240) {
        if (idx + 2 < n && isUtf8Cont(strByteAt(src, idx + 1)) && isUtf8Cont(strByteAt(src, idx + 2))) (3, 1)
        else (1, 1)
    } else if (b >= 240 && b < 248) {
        if (idx + 3 < n && isUtf8Cont(strByteAt(src, idx + 1)) && isUtf8Cont(strByteAt(src, idx + 2)) && isUtf8Cont(strByteAt(src, idx + 3))) (4, 2)
        else (1, 1)
    } else {
        // Stray continuation byte (0x80..0xBF) or invalid lead (>= 0xF8)
        (1, 0)
    }
}

def offsetToLspPos(src: String, byteOff: Int): (Int, Int) = {
    let n = strLen(src);
    let target = if (byteOff < 0) 0 else if (byteOff > n) n else byteOff;
    let line = cellNew(0);
    let col = cellNew(0);
    let i = cellNew(0);
    while (cellGet(i) < target) {
        let idx = cellGet(i);
        let b = strByteAt(src, idx);
        if (b == 10) {
            cellSet(line, cellGet(line) + 1);
            cellSet(col, 0);
            cellSet(i, idx + 1)
        } else {
            let (step, w16) = utf8StepAt(src, n, idx);
            cellSet(col, cellGet(col) + w16);
            cellSet(i, idx + step)
        }
    };
    (cellGet(line), cellGet(col))
}

def lspPosToOffset(src: String, targetLine: Int, targetChar: Int): Int = {
    let n = strLen(src);
    let line = cellNew(0);
    let col = cellNew(0);
    let i = cellNew(0);
    let done = cellNew(false);
    while (cellGet(i) < n && !cellGet(done)) {
        let curLine = cellGet(line);
        let curCol = cellGet(col);
        if (curLine > targetLine || (curLine == targetLine && curCol >= targetChar)) {
            cellSet(done, true)
        } else {
            let idx = cellGet(i);
            let b = strByteAt(src, idx);
            if (b == 10) {
                if (curLine == targetLine) {
                    cellSet(done, true)
                } else {
                    cellSet(line, curLine + 1);
                    cellSet(col, 0);
                    cellSet(i, idx + 1)
                }
            } else if (b == 13 && idx + 1 < n && strByteAt(src, idx + 1) == 10) {
                if (curLine == targetLine) {
                    cellSet(done, true)
                } else {
                    cellSet(i, idx + 1)
                }
            } else {
                let (step, w16) = utf8StepAt(src, n, idx);
                cellSet(col, curCol + w16);
                cellSet(i, idx + step)
            }
        }
    };
    let res = cellGet(i);
    if (res > n) n else res
}

def makeLspPos(line: Int, ch: Int): Value =
    VObj([
        ("line", VInt(intToI64(line))),
        ("character", VInt(intToI64(ch))),
    ])

def makeLspRange(src: String, startByte: Int, endByte: Int): Value = {
    let n = strLen(src);
    let s = if (startByte < 0) 0 else if (startByte > n) n else startByte;
    let e0 = if (endByte < s) s else if (endByte > n) n else endByte;
    let e = if (e0 == s && s < n) s + 1 else e0;
    let (sl, sc) = offsetToLspPos(src, s);
    let (el, ec) = offsetToLspPos(src, e);
    VObj([
        ("start", makeLspPos(sl, sc)),
        ("end", makeLspPos(el, ec)),
    ])
}

// ============================================================================
// Document State & Frontend Analysis
// ============================================================================

data DocState {
    MkDocState {
        dsUri: String,
        dsPath: String,
        dsText: String,
        dsVersion: Int,
        dsParsed: Option FileModule,
        dsInfer: Option InferOutput,
        dsExports: StrMap NameInfo,
        dsFiles: Vec SourceFile,
        dsFileId: Int,
        dsDiagTargetUri: Option String,
    },
}

data ServerState {
    MkServerState {
        ssDocs: StrMap DocState,
        ssCanonToUri: StrMap String,
        ssOpenUris: Cell (List String),
        ssShuttingDown: Cell Bool,
        ssRootDir: Cell (Option String),
    },
}

def resolveClientUriForPath(ss: ServerState, path: String): String =
    match strMapGet(ss.ssCanonToUri, loaderCanonicalPath(path)) {
        Some(clientUri) -> clientUri,
        None -> pathToUri(path),
    }

def trackOpenUri(ss: ServerState, uri: String): Void = {
    let cur = cellGet(ss.ssOpenUris);
    let found = cellNew(false);
    let it = cellNew(cur);
    while (match cellGet(it) { Nil -> false, _ -> !cellGet(found) }) {
        match cellGet(it) {
            Cons(u, r) -> { if (u == uri) cellSet(found, true) else (); cellSet(it, r) },
            Nil -> (),
        }
    };
    if (!cellGet(found)) cellSet(ss.ssOpenUris, Cons(uri, cur)) else ()
}

def untrackOpenUri(ss: ServerState, uri: String): Void = {
    let accRev = cellNew(Nil);
    let it = cellNew(cellGet(ss.ssOpenUris));
    while (match cellGet(it) { Nil -> false, _ -> true }) {
        match cellGet(it) {
            Cons(u, r) -> {
                if (u != uri) cellSet(accRev, Cons(u, cellGet(accRev))) else ();
                cellSet(it, r)
            },
            Nil -> (),
        }
    };
    cellSet(ss.ssOpenUris, listRev(cellGet(accRev)))
}

def resolveDocPkgSpecs(filePath: String): (PkgSpec, List PkgSpec) = {
    let dir = pathDirname(filePath);
    let searchDir = if (strLen(dir) == 0) "." else dir;
    match findProjectRoot(searchDir) {
        Some(projDir) -> match resolveProjectGraph(projDir, false, None, false) {
            Ok((rootMf, rootSpec, resolvedPkgs)) -> {
                let extSpecs0 = toLoaderPkgSpecs(resolvedPkgs);
                let roots = listAppend(rootSpec.srcRoots, [searchDir]);
                if (rootMf.mfName != "") {
                    let selfPkgId = "__self_" + sanitizeIdentAlias(rootMf.mfName);
                    let selfPkgSpec = MkPkgSpec {
                        pkgId: selfPkgId,
                        pkgName: rootMf.mfName,
                        srcRoots: rootSpec.srcRoots,
                        deps: rootSpec.deps,
                    };
                    let mergedRoot = MkPkgSpec {
                        pkgId: rootSpec.pkgId,
                        pkgName: rootSpec.pkgName,
                        srcRoots: roots,
                        deps: listAppend(rootSpec.deps, [(rootMf.mfName, selfPkgId)]),
                    };
                    (mergedRoot, Cons(selfPkgSpec, extSpecs0))
                } else {
                    let mergedRoot = MkPkgSpec {
                        pkgId: rootSpec.pkgId,
                        pkgName: rootSpec.pkgName,
                        srcRoots: roots,
                        deps: rootSpec.deps,
                    };
                    (mergedRoot, extSpecs0)
                }
            },
            Err(_) -> (MkPkgSpec { pkgId: "", pkgName: "", srcRoots: [searchDir], deps: Nil }, Nil),
        },
        None -> (MkPkgSpec { pkgId: "", pkgName: "", srcRoots: [searchDir], deps: Nil }, Nil),
    }
}

def getSourceFileFromVec(files: Vec SourceFile, fileId: Int): Option SourceFile =
    if (fileId <= 0 || fileId > vecLen(files)) None
    else Some(vecGetOr(files, fileId - 1, MkSourceFile { sfPath: "", sfContent: "" }))

def buildDiagWithTarget(ss: ServerState, docUri: String, docPath: String, docText: String, errMsg: String, files: Vec SourceFile): (String, Value) =
    match diagLastError() {
        Some(rec) -> {
            let fullMsg = match rec.drHint {
                Some(h) -> rec.drMsg + "\nhint: " + h,
                None -> rec.drMsg,
            };
            let docCanon = loaderCanonicalPath(docPath);
            match getSourceFileFromVec(files, rec.drFileId) {
                Some(sf) if (sf.sfPath == docPath || loaderCanonicalPath(sf.sfPath) == docCanon) ->
                    (docUri, VObj([
                        ("range", makeLspRange(docText, rec.drStart, rec.drEnd)),
                        ("severity", VInt(intToI64(1))),
                        ("code", VStr(rec.drKind)),
                        ("source", VStr("geisha")),
                        ("message", VStr(fullMsg)),
                    ])),
                Some(sf) if (strLen(sf.sfPath) > 0 && (strStartsWith(sf.sfPath, "/") || strStartsWith(sf.sfPath, "//") || fileExists(sf.sfPath))) ->
                    (resolveClientUriForPath(ss, sf.sfPath), VObj([
                        ("range", makeLspRange(sf.sfContent, rec.drStart, rec.drEnd)),
                        ("severity", VInt(intToI64(1))),
                        ("code", VStr(rec.drKind)),
                        ("source", VStr("geisha")),
                        ("message", VStr(fullMsg)),
                    ])),
                Some(sf) if (strLen(sf.sfPath) > 0) ->
                    (docUri, VObj([
                        ("range", makeLspRange(docText, 0, 1)),
                        ("severity", VInt(intToI64(1))),
                        ("code", VStr(rec.drKind)),
                        ("source", VStr("geisha")),
                        ("message", VStr(sf.sfPath + ": " + fullMsg)),
                    ])),
                _ ->
                    (docUri, VObj([
                        ("range", makeLspRange(docText, 0, 1)),
                        ("severity", VInt(intToI64(1))),
                        ("code", VStr(rec.drKind)),
                        ("source", VStr("geisha")),
                        ("message", VStr(fullMsg)),
                    ])),
            }
        },
        None ->
            (docUri, VObj([
                ("range", makeLspRange(docText, 0, 1)),
                ("severity", VInt(intToI64(1))),
                ("source", VStr("geisha")),
                ("message", VStr(errMsg)),
            ])),
    }

def runFrontendCheck(path: String, text: String, rootSpec: PkgSpec, extSpecs: List PkgSpec): Result InferOutput String = {
    let rawDefs = loadSingleSourceProgramWithPkgsNamed(path, text, rootSpec, extSpecs, Nil)?;
    let inf = inferProgram(rawDefs)?;
    lowerToCoreForCheck(inf)?;
    Ok(inf)
}

def clearStaleForeignDiag(prevDocOpt: Option DocState, currentUri: String, newTargetUri: Option String): Void =
    match prevDocOpt {
        Some(prev) -> match prev.dsDiagTargetUri {
            Some(oldTarget) if (oldTarget != currentUri) -> {
                let stillSame = match newTargetUri {
                    Some(nt) -> nt == oldTarget,
                    None -> false,
                };
                if (!stillSame) {
                    sendRpcNotification("textDocument/publishDiagnostics", VObj([
                        ("uri", VStr(oldTarget)),
                        ("diagnostics", VArr(Nil)),
                    ]))
                } else ()
            },
            _ -> (),
        },
        None -> (),
    }

def analyzeSingleDoc(ss: ServerState, uri: String, text: String, version: Int): Void = {
    let path = uriToPath(uri);
    let prevDocOpt = strMapGet(ss.ssDocs, uri);

    // Always try a standalone parse for DocumentSymbol / Completion resilience
    diagReset();
    let parseFid = diagRegisterFile(path, text);
    let parsedOpt = match parseFileModuleInFile(text, Nil, parseFid) {
        Ok(fm) -> Some(fm),
        Err(_) -> match prevDocOpt {
            Some(prev) -> prev.dsParsed,
            None -> None,
        },
    };

    // Full frontend analysis: load (with in-memory overlays) + infer + core lowering
    diagReset();
    let (rootSpec, extSpecs) = resolveDocPkgSpecs(path);
    let checkRes = runFrontendCheck(path, text, rootSpec, extSpecs);
    let filesSnap = diagRegisteredFiles();
    let exportsSnap = loaderLastPublicExports();

    match checkRes {
        Ok(inf) -> {
            clearStaleForeignDiag(prevDocOpt, uri, None);
            let st = MkDocState {
                dsUri: uri,
                dsPath: path,
                dsText: text,
                dsVersion: version,
                dsParsed: parsedOpt,
                dsInfer: Some(inf),
                dsExports: exportsSnap,
                dsFiles: filesSnap,
                dsFileId: 1,
                dsDiagTargetUri: None,
            };
            strMapInsert(ss.ssDocs, uri, st);
            sendRpcNotification("textDocument/publishDiagnostics", VObj([
                ("uri", VStr(uri)),
                ("diagnostics", VArr(Nil)),
            ]))
        },
        Err(errMsg) -> {
            let (targetUri, diagObj) = buildDiagWithTarget(ss, uri, path, text, errMsg, filesSnap);
            let foreignOpt = if (targetUri != uri) Some(targetUri) else None;
            clearStaleForeignDiag(prevDocOpt, uri, foreignOpt);
            let keepInf = match prevDocOpt {
                Some(prev) -> prev.dsInfer,
                None -> None,
            };
            let keepExports = match prevDocOpt {
                Some(prev) -> prev.dsExports,
                None -> exportsSnap,
            };
            let keepFiles = match prevDocOpt {
                Some(prev) -> if (vecLen(prev.dsFiles) > 0) prev.dsFiles else filesSnap,
                None -> filesSnap,
            };
            let st = MkDocState {
                dsUri: uri,
                dsPath: path,
                dsText: text,
                dsVersion: version,
                dsParsed: parsedOpt,
                dsInfer: keepInf,
                dsExports: keepExports,
                dsFiles: keepFiles,
                dsFileId: 1,
                dsDiagTargetUri: foreignOpt,
            };
            strMapInsert(ss.ssDocs, uri, st);
            if (targetUri != uri) {
                sendRpcNotification("textDocument/publishDiagnostics", VObj([
                    ("uri", VStr(uri)),
                    ("diagnostics", VArr(Nil)),
                ]))
            } else ();
            sendRpcNotification("textDocument/publishDiagnostics", VObj([
                ("uri", VStr(targetUri)),
                ("diagnostics", VArr([diagObj])),
            ]))
        },
    }
}

def refreshOtherOpenDocs(ss: ServerState, skipUri: String): Void = {
    let cur = cellNew(cellGet(ss.ssOpenUris));
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(otherUri, r) -> {
                if (otherUri != skipUri) {
                    match strMapGet(ss.ssDocs, otherUri) {
                        Some(doc) -> analyzeSingleDoc(ss, doc.dsUri, doc.dsText, doc.dsVersion),
                        None -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def analyzeAndPublish(ss: ServerState, uri: String, text: String, version: Int): Void = {
    let path = uriToPath(uri);
    strMapInsert(ss.ssCanonToUri, loaderCanonicalPath(path), uri);
    loaderSetOverlay(path, text);
    trackOpenUri(ss, uri);
    analyzeSingleDoc(ss, uri, text, version);
    refreshOtherOpenDocs(ss, uri)
}

// ============================================================================
// Identifier Scanning, Word-Boundary Search & Doc Comment Formatting
// ============================================================================

def identAtOffset(src: String, off: Int): Option (String, Int, Int) = {
    let n = strLen(src);
    if (n == 0) None
    else {
        let p0 = if (off < 0) 0 else if (off >= n) n - 1 else off;
        let p =
            if (isIdentContByte(strByteAt(src, p0))) p0
            else if (p0 > 0 && isIdentContByte(strByteAt(src, p0 - 1))) p0 - 1
            else -1;
        if (p < 0) None
        else {
            let s = cellNew(p);
            while (cellGet(s) > 0 && isIdentContByte(strByteAt(src, cellGet(s) - 1))) {
                cellSet(s, cellGet(s) - 1)
            };
            let e = cellNew(p + 1);
            while (cellGet(e) < n && isIdentContByte(strByteAt(src, cellGet(e)))) {
                cellSet(e, cellGet(e) + 1)
            };
            let st = cellGet(s);
            let en = cellGet(e);
            if (en > st && isIdentStartByte(strByteAt(src, st))) {
                Some((strSlice(src, st, en), st, en))
            } else None
        }
    }
}

// Word-boundary identifier search within `[startByte, endByte)`.
def findIdentInSpan(src: String, ident: String, startByte: Int, endByte: Int): (Int, Int) = {
    let n = strLen(src);
    let nl = strLen(ident);
    let s = if (startByte < 0) 0 else if (startByte > n) n else startByte;
    let e = if (endByte < s) s else if (endByte > n) n else endByte;
    if (nl == 0 || s + nl > e) (s, if (e > s) e else s)
    else {
        let isWordIdent = isIdentStartByte(strByteAt(ident, 0));
        let i = cellNew(s);
        let found = cellNew(-1);
        let limit = e - nl;
        while (cellGet(i) <= limit && cellGet(found) < 0) {
            let cur = cellGet(i);
            let b = strByteAt(src, cur);
            if (b == 47 && cur + 1 < e && strByteAt(src, cur + 1) == 47) {
                let j = cellNew(cur + 2);
                while (cellGet(j) < e && strByteAt(src, cellGet(j)) != 10) {
                    cellSet(j, cellGet(j) + 1)
                };
                cellSet(i, cellGet(j))
            } else if (b == 47 && cur + 1 < e && strByteAt(src, cur + 1) == 42) {
                let j = cellNew(cur + 2);
                let closed = cellNew(false);
                while (cellGet(j) + 1 < e && !cellGet(closed)) {
                    if (strByteAt(src, cellGet(j)) == 42 && strByteAt(src, cellGet(j) + 1) == 47) {
                        cellSet(j, cellGet(j) + 2);
                        cellSet(closed, true)
                    } else cellSet(j, cellGet(j) + 1)
                };
                cellSet(i, if (cellGet(closed)) cellGet(j) else e)
            } else if (b == 34) {
                let j = cellNew(cur + 1);
                let closed = cellNew(false);
                while (cellGet(j) < e && !cellGet(closed)) {
                    let cb = strByteAt(src, cellGet(j));
                    if (cb == 92 && cellGet(j) + 1 < e) {
                        cellSet(j, cellGet(j) + 2)
                    } else if (cb == 34) {
                        cellSet(j, cellGet(j) + 1);
                        cellSet(closed, true)
                    } else cellSet(j, cellGet(j) + 1)
                };
                cellSet(i, if (cellGet(closed)) cellGet(j) else e)
            } else {
                let matched = strStartsWith(strSlice(src, cur, cur + nl), ident);
                let leftOk = !isWordIdent || cur == 0 || !isIdentContByte(strByteAt(src, cur - 1));
                let rightOk = !isWordIdent || (cur + nl) >= n || !isIdentContByte(strByteAt(src, cur + nl));
                if (matched && leftOk && rightOk) {
                    cellSet(found, cur)
                } else {
                    cellSet(i, cur + 1)
                }
            }
        };
        let f = cellGet(found);
        if (f >= 0) (f, f + nl) else (s, if (e > s) e else s)
    }
}

def stripDocPrefix(line: String): String =
    if (strStartsWith(line, "/// ")) strSlice(line, 4, strLen(line))
    else if (strStartsWith(line, "///")) strSlice(line, 3, strLen(line))
    else line

def formatDocCommentMarkdown(src: String, startByte: Int): String = {
    let lines = extractDocComment(src, startByte);
    match lines {
        Nil -> "",
        _ -> {
            let cleanedRev = cellNew(Nil);
            let cur = cellNew(lines);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(l, r) -> {
                        cellSet(cleanedRev, Cons(stripDocPrefix(l), cellGet(cleanedRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            strJoin(listRev(cellGet(cleanedRev)), "\n")
        },
    }
}

def shortSymName(qname: String): String = {
    let segs = strSplitChar(qname, '.');
    let last = cellNew(qname);
    let cur = cellNew(segs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(s, r) -> { cellSet(last, s); cellSet(cur, r) },
            Nil -> (),
        }
    };
    cellGet(last)
}

// ============================================================================
// AST Traversal for Innermost Expression & Local Bindings
// ============================================================================

data LocalBind {
    MkLocalBind {
        lbName: String,
        lbSpan: Span,
        lbScheme: Scheme,
    },
}

data FoundForm {
    MkFoundForm {
        ffForm: Form,
        ffSize: Int,
        ffLocals: List LocalBind,
    },
}

def spanContains(sp: Span, fileId: Int, off: Int): Bool =
    sp.fileId == fileId && sp.start <= off && off <= sp.end

def spanSize(sp: Span): Int =
    if (sp.end >= sp.start) sp.end - sp.start else 0

def locateBinderSpan(src: String, fileId: Int, name: String, lo: Int, hi: Int): Span = {
    let (s, e) = findIdentInSpan(src, name, lo, hi);
    MkSpan { fileId: fileId, start: s, end: e }
}

def findPatVarSpanInPat(pat: Pattern, src: String, fileId: Int, vn: String, lo: Int, hi: Int): Option Span = match pat {
    PatVar(v) ->
        if (v == vn) {
            let (s1, e1) = findIdentInSpan(src, vn, lo, hi);
            if (s1 < e1 && strSlice(src, s1, e1) == vn) Some(MkSpan { fileId: fileId, start: s1, end: e1 })
            else None
        } else None,
    PatWild -> None,
    PatLit(_) -> None,
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        let found: Cell (Option Span) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    match findPatVarSpanInPat(p, src, fileId, vn, lo, hi) {
                        Some(sp) -> cellSet(found, Some(sp)),
                        None -> (),
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    PatCtor(_, ps) -> {
        let cur = cellNew(ps);
        let found: Cell (Option Span) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    match findPatVarSpanInPat(p, src, fileId, vn, lo, hi) {
                        Some(sp) -> cellSet(found, Some(sp)),
                        None -> (),
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    PatStruct(_, fs) -> {
        let cur = cellNew(fs);
        let found: Cell (Option Span) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((fname, subPat, fSp, isShort), r) -> {
                    if (isShort) {
                        if (fname == vn && fSp.fileId == fileId && fSp.end > fSp.start) {
                            cellSet(found, Some(fSp))
                        } else ()
                    } else {
                        let subLo = if (fSp.fileId == fileId && fSp.end > fSp.start) fSp.end else lo;
                        let subHi = if (hi > subLo) hi else strLen(src);
                        match findPatVarSpanInPat(subPat, src, fileId, vn, subLo, subHi) {
                            Some(sp) -> cellSet(found, Some(sp)),
                            None -> (),
                        }
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
}

def locatePatVarSpan(pat: Pattern, src: String, fileId: Int, vn: String, patLo: Int, patHi: Int, fStart: Int, fEnd: Int): Span = {
    let lo = if (patHi > patLo) patLo else fStart;
    let hi = if (patHi > patLo) patHi else fEnd;
    match findPatVarSpanInPat(pat, src, fileId, vn, lo, hi) {
        Some(sp) -> sp,
        None -> locateBinderSpan(src, fileId, vn, fStart, fEnd),
    }
}

def collectPatVarNames(pat: Pattern, acc: Cell (List String)): Void = match pat {
    PatVar(v) -> cellSet(acc, Cons(v, cellGet(acc))),
    PatWild -> (),
    PatLit(_) -> (),
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> { collectPatVarNames(p, acc); cellSet(cur, r) },
                Nil -> (),
            }
        }
    },
    PatCtor(_, ps) -> {
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> { collectPatVarNames(p, acc); cellSet(cur, r) },
                Nil -> (),
            }
        }
    },
    PatStruct(_, fs) -> {
        let cur = cellNew(fs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, p, _, _), r) -> { collectPatVarNames(p, acc); cellSet(cur, r) },
                Nil -> (),
            }
        }
    },
}

def searchFormList(src: String, fs: List Form, fileId: Int, off: Int, locals: List LocalBind, best: Cell (Option FoundForm)): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                searchFormAt(src, h, fileId, off, locals, best);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def searchFormAt(src: String, f: Form, fileId: Int, off: Int, locals: List LocalBind, best: Cell (Option FoundForm)): Void = {
    if (spanContains(f.pos, fileId, off)) {
        let sz = spanSize(f.pos);
        let better = match cellGet(best) {
            None -> true,
            Some(prev) -> sz <= prev.ffSize,
        };
        if (better) {
            cellSet(best, Some(MkFoundForm { ffForm: f, ffSize: sz, ffLocals: locals }))
        } else ()
    } else ();
    match f.node {
        ExLit(_) -> (),
        ExVar(_) -> (),
        ExTuple(es) -> searchFormList(src, es, fileId, off, locals, best),
        ExList(es) -> searchFormList(src, es, fileId, off, locals, best),
        ExBlock(es) -> searchFormList(src, es, fileId, off, locals, best),
        ExStructInit(_, fields) -> {
            let cur = cellNew(fields);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons((_, fv), r) -> {
                        searchFormAt(src, fv, fileId, off, locals, best);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExApply(callee, args) -> {
            searchFormAt(src, callee, fileId, off, locals, best);
            searchFormList(src, args, fileId, off, locals, best)
        },
        ExAbs(ps, _, body) -> {
            let nextLocals = cellNew(locals);
            if (f.pos.start < body.pos.start) {
                let cur = cellNew(ps);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(vd, r) -> {
                            let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, body.pos.start);
                            cellSet(nextLocals, Cons(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }, cellGet(nextLocals)));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                }
            } else ();
            searchFormAt(src, body, fileId, off, cellGet(nextLocals), best)
        },
        ExBin(_, lhs, rhs) -> {
            searchFormAt(src, lhs, fileId, off, locals, best);
            searchFormAt(src, rhs, fileId, off, locals, best)
        },
        ExUn(_, sub) -> searchFormAt(src, sub, fileId, off, locals, best),
        ExLet(vd, rhs, body) -> {
            searchFormAt(src, rhs, fileId, off, locals, best);
            let bindEnd = if (rhs.pos.start > f.pos.start) rhs.pos.start else f.pos.end;
            let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, bindEnd);
            let bindScm = match vd.vscm { ScmSlot -> rhs.ty, sc -> sc };
            let nextLocals = Cons(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: bindScm }, locals);
            searchFormAt(src, body, fileId, off, nextLocals, best)
        },
        ExIf(c, t, e) -> {
            searchFormAt(src, c, fileId, off, locals, best);
            searchFormAt(src, t, fileId, off, locals, best);
            searchFormAt(src, e, fileId, off, locals, best)
        },
        ExWhile(c, b) -> {
            searchFormAt(src, c, fileId, off, locals, best);
            searchFormAt(src, b, fileId, off, locals, best)
        },
        ExMatch(scrut, arms) -> {
            searchFormAt(src, scrut, fileId, off, locals, best);
            let prevArmEnd = cellNew(if (scrut.pos.end > f.pos.start) scrut.pos.end else f.pos.start);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arm, r) -> {
                        let patNames: Cell (List String) = cellNew(Nil);
                        collectPatVarNames(arm.pat, patNames);
                        let patLo = cellGet(prevArmEnd);
                        let patHi = if (arm.body.pos.start > patLo) arm.body.pos.start else f.pos.end;
                        let armLocals = cellNew(locals);
                        let cn = cellNew(listRev(cellGet(patNames)));
                        while (match cellGet(cn) { Nil -> false, _ -> true }) {
                            match cellGet(cn) {
                                Cons(vn, rn) -> {
                                    let bsp = locatePatVarSpan(arm.pat, src, fileId, vn, patLo, patHi, f.pos.start, f.pos.end);
                                    cellSet(armLocals, Cons(MkLocalBind { lbName: vn, lbSpan: bsp, lbScheme: ScmSlot }, cellGet(armLocals)));
                                    cellSet(cn, rn)
                                },
                                Nil -> (),
                            }
                        };
                        let al = cellGet(armLocals);
                        match arm.guard {
                            Some(g) -> searchFormAt(src, g, fileId, off, al, best),
                            None -> (),
                        };
                        searchFormAt(src, arm.body, fileId, off, al, best);
                        if (arm.body.pos.end > cellGet(prevArmEnd)) cellSet(prevArmEnd, arm.body.pos.end) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExField(base, _) -> searchFormAt(src, base, fileId, off, locals, best),
        ExTry(inner) -> searchFormAt(src, inner, fileId, off, locals, best),
    }
}

def findInnermostFormInDefs(src: String, defs: List Def, fileId: Int, off: Int): Option FoundForm = {
    let best: Cell (Option FoundForm) = cellNew(None);
    let cur = cellNew(defs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        let defLocals: List LocalBind = match f.node {
                            ExAbs(ps, _, body) -> {
                                let headEnd = if (body.pos.start > d.dpos.start) body.pos.start else d.dpos.end;
                                let acc = cellNew(Nil);
                                let cp = cellNew(ps);
                                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                    match cellGet(cp) {
                                        Cons(vd, rp) -> {
                                            let bsp = locateBinderSpan(src, fileId, vd.vname, d.dpos.start, headEnd);
                                            cellSet(acc, Cons(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }, cellGet(acc)));
                                            cellSet(cp, rp)
                                        },
                                        Nil -> (),
                                    }
                                };
                                cellGet(acc)
                            },
                            _ -> Nil,
                        };
                        searchFormAt(src, f, fileId, off, defLocals, best)
                    },
                    ItInstance(_, _, _, impls) -> {
                        let ci = cellNew(impls);
                        while (match cellGet(ci) { Nil -> false, _ -> true }) {
                            match cellGet(ci) {
                                Cons(mi, ri) -> {
                                    searchFormAt(src, mi.implBody, fileId, off, Nil, best);
                                    cellSet(ci, ri)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(best)
}

def defHasVariant(d: Def, name: String): Bool = match d.item {
    ItAlg(_, vs) -> {
        let cur = cellNew(vs);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    if (v.vname == name) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def defHasVariantSuffix(d: Def, suffix: String): Bool = match d.item {
    ItAlg(_, vs) -> {
        let cur = cellNew(vs);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    if (strEndsWith(v.vname, suffix)) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def defHasMethod(d: Def, name: String): Bool = match d.item {
    ItConcept(_, _, _, ms) -> {
        let cur = cellNew(ms);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(m, r) -> {
                    if (m.mname == name) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def defHasMethodSuffix(d: Def, suffix: String): Bool = match d.item {
    ItConcept(_, _, _, ms) -> {
        let cur = cellNew(ms);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(m, r) -> {
                    if (strEndsWith(m.mname, suffix)) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def lookupDefExact(defs: List Def, name: String): Option Def = {
    let cur = cellNew(defs);
    let found: Cell (Option Def) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (d.ident == name || defHasVariant(d, name) || defHasMethod(d, name)) {
                    cellSet(found, Some(d))
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def lookupDefLoose(defs: List Def, name: String): Option Def =
    match lookupDefExact(defs, name) {
        Some(d) -> Some(d),
        None -> {
            let suffix = "." + name;
            let cur = cellNew(defs);
            let found: Cell (Option Def) = cellNew(None);
            while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(d, r) -> {
                        if (strEndsWith(d.ident, suffix) || defHasVariantSuffix(d, suffix) || defHasMethodSuffix(d, suffix)) {
                            cellSet(found, Some(d))
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
    }

def lookupDefAtOffset(defs: List Def, fileId: Int, off: Int): Option Def = {
    let cur = cellNew(defs);
    let found: Cell (Option Def) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (spanContains(d.dpos, fileId, off)) cellSet(found, Some(d)) else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def lookupLocalBind(locals: List LocalBind, name: String): Option LocalBind = match locals {
    Nil -> None,
    Cons(lb, r) -> if (lb.lbName == name) Some(lb) else lookupLocalBind(r, name),
}

def docForDef(files: Vec SourceFile, d: Def): String =
    match getSourceFileFromVec(files, d.dpos.fileId) {
        Some(sf) -> formatDocCommentMarkdown(sf.sfContent, d.dpos.start),
        None -> "",
    }

def findParsedDefByName(items: List ModuleItem, name: String): Option Def = {
    let cur = cellNew(items);
    let found: Cell (Option Def) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), r) -> {
                if (d.ident == name || defHasVariant(d, name) || defHasMethod(d, name)) {
                    cellSet(found, Some(d))
                } else ();
                cellSet(cur, r)
            },
            Cons(ModSub(_, _, subItems, _), r) -> {
                match findParsedDefByName(subItems, name) {
                    Some(sd) -> cellSet(found, Some(sd)),
                    None -> (),
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

// ============================================================================
// Hover (`textDocument/hover`)
// ============================================================================

def makeHoverResult(md: String, rangeOpt: Option Value): Value = {
    let contents = VObj([
        ("kind", VStr("markdown")),
        ("value", VStr(md)),
    ]);
    match rangeOpt {
        Some(r) -> VObj([("contents", contents), ("range", r)]),
        None -> VObj([("contents", contents)]),
    }
}

def formatHoverBlock(codeLine: String, docMd: String): String =
    if (strLen(docMd) > 0) "```geisha\n" + codeLine + "\n```\n\n" + docMd
    else "```geisha\n" + codeLine + "\n```"

def hoverForWordInScope(doc: DocState, inf: InferOutput, locals: List LocalBind, word: String, ws: Int, we: Int): Option Value = {
    let wrng = Some(makeLspRange(doc.dsText, ws, we));
    match lookupLocalBind(locals, word) {
        Some(lb) -> match lb.lbScheme {
            ScmSlot -> None,
            sc -> Some(makeHoverResult(formatHoverBlock(lb.lbName + ": " + formatScheme(sc), ""), wrng)),
        },
        None -> match lookupDefLoose(inf.defs, word) {
            Some(d) -> {
                let sig = match d.item {
                    ItForm(f) -> shortSymName(d.ident) + ": " + formatScheme(f.ty),
                    _ -> formatDefSig(d),
                };
                let docStr = docForDef(doc.dsFiles, d);
                Some(makeHoverResult(formatHoverBlock(sig, docStr), wrng))
            },
            None -> None,
        },
    }
}

def handleHover(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                let wordOpt = identAtOffset(doc.dsText, off);
                let fromInfer: Option Value = match doc.dsInfer {
                    None -> None,
                    Some(inf) -> {
                        match findInnermostFormInDefs(doc.dsText, inf.defs, doc.dsFileId, off) {
                            Some(ff) -> {
                                let f: Form = ff.ffForm;
                                let tyStr = formatScheme(f.ty);
                                let rng = Some(makeLspRange(doc.dsText, f.pos.start, f.pos.end));
                                match f.node {
                                    ExVar(qname) -> {
                                        let docStr = match lookupDefExact(inf.defs, qname) {
                                            Some(d) -> docForDef(doc.dsFiles, d),
                                            None -> "",
                                        };
                                        let label = shortSymName(qname);
                                        Some(makeHoverResult(formatHoverBlock(label + ": " + tyStr, docStr), rng))
                                    },
                                    ExStructInit(qname, _) -> {
                                        let docStr = match lookupDefExact(inf.defs, qname) {
                                            Some(d) -> docForDef(doc.dsFiles, d),
                                            None -> "",
                                        };
                                        let label = shortSymName(qname);
                                        Some(makeHoverResult(formatHoverBlock(label + ": " + tyStr, docStr), rng))
                                    },
                                    ExLit(_) ->
                                        Some(makeHoverResult(formatHoverBlock(tyStr, ""), rng)),
                                    _ -> {
                                        // On compound nodes (let/match/abs/block/apply), prefer local binder or constructor under cursor
                                        let byWord = match wordOpt {
                                            Some((word, ws, we)) -> hoverForWordInScope(doc, inf, ff.ffLocals, word, ws, we),
                                            None -> None,
                                        };
                                        match byWord {
                                            Some(v) -> Some(v),
                                            None -> Some(makeHoverResult(formatHoverBlock(tyStr, ""), rng)),
                                        }
                                    },
                                }
                            },
                            None -> match lookupDefAtOffset(inf.defs, doc.dsFileId, off) {
                                Some(d) -> {
                                    let sig = match d.item {
                                        ItForm(f) -> d.ident + ": " + formatScheme(f.ty),
                                        _ -> formatDefSig(d),
                                    };
                                    let docStr = docForDef(doc.dsFiles, d);
                                    Some(makeHoverResult(formatHoverBlock(sig, docStr), Some(makeLspRange(doc.dsText, d.dpos.start, d.dpos.end))))
                                },
                                None -> match wordOpt {
                                    Some((word, ws, we)) -> hoverForWordInScope(doc, inf, Nil, word, ws, we),
                                    None -> None,
                                },
                            },
                        }
                    },
                };
                match fromInfer {
                    Some(v) -> v,
                    None -> match (doc.dsParsed, wordOpt) {
                        (Some(fm), Some((word, ws, we))) -> match findParsedDefByName(fm.items, word) {
                            Some(d) -> {
                                let sig = formatDefSig(d);
                                let docStr = formatDocCommentMarkdown(doc.dsText, d.dpos.start);
                                makeHoverResult(formatHoverBlock(sig, docStr), Some(makeLspRange(doc.dsText, ws, we)))
                            },
                            None -> VNull,
                        },
                        _ -> VNull,
                    },
                }
            },
            _ -> VNull,
        },
        _ -> VNull,
    }
}

// ============================================================================
// Go to Definition (`textDocument/definition`)
// ============================================================================

def makeLocationFromSpan(ss: ServerState, files: Vec SourceFile, currentUri: String, currentText: String, currentFileId: Int, sp: Span): Option Value =
    if (sp.fileId == currentFileId) {
        Some(VObj([
            ("uri", VStr(currentUri)),
            ("range", makeLspRange(currentText, sp.start, sp.end)),
        ]))
    } else {
        match getSourceFileFromVec(files, sp.fileId) {
            Some(sf) ->
                if (strStartsWith(sf.sfPath, "/") || strStartsWith(sf.sfPath, "//") || fileExists(sf.sfPath)) {
                    Some(VObj([
                        ("uri", VStr(resolveClientUriForPath(ss, sf.sfPath))),
                        ("range", makeLspRange(sf.sfContent, sp.start, sp.end)),
                    ]))
                } else None,
            None -> None,
        }
    }

def handleDefinition(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                let wordOpt = identAtOffset(doc.dsText, off);
                let fromInfer: Option Value = match doc.dsInfer {
                    None -> None,
                    Some(inf) -> {
                        let byForm: Option Value = match findInnermostFormInDefs(doc.dsText, inf.defs, doc.dsFileId, off) {
                            Some(ff) -> match ff.ffForm.node {
                                ExVar(qname) -> match lookupLocalBind(ff.ffLocals, qname) {
                                    Some(lb) -> makeLocationFromSpan(ss, doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, lb.lbSpan),
                                    None -> match lookupDefExact(inf.defs, qname) {
                                        Some(d) -> makeLocationFromSpan(ss, doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, d.dpos),
                                        None -> None,
                                    },
                                },
                                ExStructInit(qname, _) -> match lookupDefExact(inf.defs, qname) {
                                    Some(d) -> makeLocationFromSpan(ss, doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, d.dpos),
                                    None -> None,
                                },
                                _ -> match wordOpt {
                                    Some((word, _, _)) -> match lookupLocalBind(ff.ffLocals, word) {
                                        Some(lb) -> makeLocationFromSpan(ss, doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, lb.lbSpan),
                                        None -> None,
                                    },
                                    None -> None,
                                },
                            },
                            None -> None,
                        };
                        match byForm {
                            Some(v) -> Some(v),
                            None -> match wordOpt {
                                Some((word, _, _)) -> match lookupDefLoose(inf.defs, word) {
                                    Some(d) -> makeLocationFromSpan(ss, doc.dsFiles, doc.dsUri, doc.dsText, doc.dsFileId, d.dpos),
                                    None -> None,
                                },
                                None -> None,
                            },
                        }
                    },
                };
                match fromInfer {
                    Some(v) -> v,
                    None -> match (doc.dsParsed, wordOpt) {
                        (Some(fm), Some((word, _, _))) -> match findParsedDefByName(fm.items, word) {
                            Some(d) -> VObj([
                                ("uri", VStr(doc.dsUri)),
                                ("range", makeLspRange(doc.dsText, d.dpos.start, d.dpos.end)),
                            ]),
                            None -> VNull,
                        },
                        _ -> VNull,
                    },
                }
            },
            _ -> VNull,
        },
        _ -> VNull,
    }
}

// ============================================================================
// Document Symbols (`textDocument/documentSymbol`)
// ============================================================================

def defSymbolKind(d: Def): Int = match d.item {
    ItAlg(_, vs) -> match vs {
        Cons(v, Nil) -> match v.vbody { VarStruct(_) -> 23, _ -> 10 },
        _ -> 10,
    },
    ItAlias(_, _) -> 26,
    ItConcept(_, _, _, _) -> 11,
    ItInstance(_, _, _, _) -> 5,
    ItExtern(_, _, _, _) -> 12,
    ItForm(f) -> match f.node {
        ExAbs(_, _, _) -> 12,
        _ -> 13,
    },
}

def defSymbolName(d: Def): String = match d.item {
    ItInstance(cname, _, _, _) -> "instance " + cname,
    _ -> d.ident,
}

def buildDefSymbol(src: String, d: Def): Value = {
    let fullRange = makeLspRange(src, d.dpos.start, d.dpos.end);
    let selKey = match d.item { ItInstance(cname, _, _, _) -> cname, _ -> d.ident };
    let (selS, selE) = findIdentInSpan(src, selKey, d.dpos.start, d.dpos.end);
    let selRange = makeLspRange(src, selS, selE);
    let children: List Value = match d.item {
        ItAlg(_, vs) -> {
            let accRev = cellNew(Nil);
            let cur = cellNew(vs);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(v, r) -> {
                        let (vs1, ve1) = findIdentInSpan(src, v.vname, d.dpos.start, d.dpos.end);
                        let vr = makeLspRange(src, vs1, ve1);
                        cellSet(accRev, Cons(VObj([
                            ("name", VStr(v.vname)),
                            ("detail", VStr(formatVariant(v))),
                            ("kind", VInt(intToI64(22))),
                            ("range", vr),
                            ("selectionRange", vr),
                        ]), cellGet(accRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(accRev))
        },
        ItConcept(_, _, _, ms) -> {
            let accRev = cellNew(Nil);
            let cur = cellNew(ms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(m, r) -> {
                        let (ms1, me1) = findIdentInSpan(src, m.mname, d.dpos.start, d.dpos.end);
                        let mr = makeLspRange(src, ms1, me1);
                        cellSet(accRev, Cons(VObj([
                            ("name", VStr(m.mname)),
                            ("detail", VStr(formatScheme(m.mty))),
                            ("kind", VInt(intToI64(6))),
                            ("range", mr),
                            ("selectionRange", mr),
                        ]), cellGet(accRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(accRev))
        },
        _ -> Nil,
    };
    let baseFields = [
        ("name", VStr(defSymbolName(d))),
        ("detail", VStr(formatDefSig(d))),
        ("kind", VInt(intToI64(defSymbolKind(d)))),
        ("range", fullRange),
        ("selectionRange", selRange),
    ];
    match children {
        Nil -> VObj(baseFields),
        cs -> VObj(listAppend(baseFields, [("children", VArr(cs))])),
    }
}

def isSyntheticDerivedDef(d: Def): Bool =
    strStartsWith(d.ident, "instance_") && match d.item {
        ItInstance(_, _, _, _) -> false,
        _ -> true,
    }

def buildModuleSymbols(src: String, items: List ModuleItem): List Value = {
    let accRev = cellNew(Nil);
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), r) -> {
                if (!isSyntheticDerivedDef(d)) {
                    cellSet(accRev, Cons(buildDefSymbol(src, d), cellGet(accRev)))
                } else ();
                cellSet(cur, r)
            },
            Cons(ModSub(_, subName, subItems, sp), r) -> {
                let rng = makeLspRange(src, sp.start, sp.end);
                let (selS, selE) = findIdentInSpan(src, subName, sp.start, sp.end);
                let selRng = makeLspRange(src, selS, selE);
                let subSyms = buildModuleSymbols(src, subItems);
                cellSet(accRev, Cons(VObj([
                    ("name", VStr(subName)),
                    ("kind", VInt(intToI64(2))),
                    ("range", rng),
                    ("selectionRange", selRng),
                    ("children", VArr(subSyms)),
                ]), cellGet(accRev)));
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    listRev(cellGet(accRev))
}

def handleDocumentSymbol(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    match uriOpt {
        Some(uri) -> match strMapGet(ss.ssDocs, uri) {
            Some(doc) -> match doc.dsParsed {
                Some(fm) -> VArr(buildModuleSymbols(doc.dsText, fm.items)),
                None -> VArr(Nil),
            },
            None -> VArr(Nil),
        },
        None -> VArr(Nil),
    }
}

// ============================================================================
// Completion (`textDocument/completion`)
// ============================================================================

def makeCompItem(label: String, kind: Int, detail: String, docMd: String): Value = {
    let f0 = [
        ("label", VStr(label)),
        ("kind", VInt(intToI64(kind))),
    ];
    let f1 = if (strLen(detail) > 0) listAppend(f0, [("detail", VStr(detail))]) else f0;
    let f2 =
        if (strLen(docMd) > 0) {
            listAppend(f1, [("documentation", VObj([("kind", VStr("markdown")), ("value", VStr(docMd))]))])
        } else f1;
    VObj(f2)
}

def addUniqueComp(seen: StrMap Bool, outRev: Cell (List Value), label: String, kind: Int, detail: String, docMd: String, prefix: String): Void = {
    if (strLen(label) > 0 && !strMapContains(seen, label)) {
        let matches =
            if (strLen(prefix) == 0) true
            else strStartsWith(toLowerAscii(label), toLowerAscii(prefix));
        if (matches) {
            strMapInsert(seen, label, true);
            cellSet(outRev, Cons(makeCompItem(label, kind, detail, docMd), cellGet(outRev)))
        } else ()
    } else ()
}

def completionKindForDef(d: Def): Int = match d.item {
    ItAlg(_, _) -> 13,
    ItAlias(_, _) -> 7,
    ItConcept(_, _, _, _) -> 8,
    ItInstance(_, _, _, _) -> 7,
    ItExtern(_, _, _, _) -> 3,
    ItForm(f) -> match f.node {
        ExAbs(_, _, _) -> 3,
        _ -> 6,
    },
}

def collectDefsFromModuleItems(
    src: String,
    items: List ModuleItem,
    onlyPub: Bool,
    seen: StrMap Bool,
    outRev: Cell (List Value),
    prefix: String
): Void = {
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(vis, d), r) -> {
                if (!onlyPub || isPublicVis(vis)) {
                    let sig = formatDefSig(d);
                    let docMd = formatDocCommentMarkdown(src, d.dpos.start);
                    match d.item {
                        ItInstance(_, _, _, _) -> (),
                        _ -> addUniqueComp(seen, outRev, d.ident, completionKindForDef(d), sig, docMd, prefix),
                    };
                    match d.item {
                        ItAlg(_, vs) -> {
                            let cv = cellNew(vs);
                            while (match cellGet(cv) { Nil -> false, _ -> true }) {
                                match cellGet(cv) {
                                    Cons(v, rv) -> {
                                        addUniqueComp(seen, outRev, v.vname, 4, formatVariant(v), "", prefix);
                                        cellSet(cv, rv)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        ItConcept(_, _, _, ms) -> {
                            let cm = cellNew(ms);
                            while (match cellGet(cm) { Nil -> false, _ -> true }) {
                                match cellGet(cm) {
                                    Cons(m, rm) -> {
                                        addUniqueComp(seen, outRev, m.mname, 2, formatScheme(m.mty), "", prefix);
                                        cellSet(cm, rm)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        _ -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    }
}

def collectBuiltinModuleExports(modKey: String, seen: StrMap Bool, outRev: Cell (List Value), prefix: String): Bool =
    match builtinModuleSource(modKey) {
        None -> false,
        Some(src) -> {
            match parseFileModuleInFile(src, Nil, 0) {
                Ok(fm) -> {
                    collectDefsFromModuleItems(src, fm.items, true, seen, outRev, prefix);
                    true
                },
                Err(_) -> false,
            }
        },
    }

def resolveImportedAliasModKey(items: List ModuleItem, aliasName: String): Option String = {
    let cur = cellNew(items);
    let found: Cell (Option String) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, UseAlias(segs, al, _)), r) -> {
                if (al == aliasName) cellSet(found, Some(strJoin(segs, "."))) else ();
                cellSet(cur, r)
            },
            Cons(ModUse(_, UseSingle(segs, _)), r) -> {
                let full = strJoin(segs, ".");
                if (shortSymName(full) == aliasName) cellSet(found, Some(full)) else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

def extractDotQualifier(src: String, off: Int): (String, String) = {
    let n = strLen(src);
    let end = if (off < 0) 0 else if (off > n) n else off;
    let p = cellNew(end);
    while (cellGet(p) > 0 && isIdentContByte(strByteAt(src, cellGet(p) - 1))) {
        cellSet(p, cellGet(p) - 1)
    };
    let partial = strSlice(src, cellGet(p), end);
    if (cellGet(p) > 0 && strByteAt(src, cellGet(p) - 1) == 46) {
        let qEnd = cellGet(p) - 1;
        let qStart = cellNew(qEnd);
        while (cellGet(qStart) > 0 && (isIdentContByte(strByteAt(src, cellGet(qStart) - 1)) || strByteAt(src, cellGet(qStart) - 1) == 46)) {
            cellSet(qStart, cellGet(qStart) - 1)
        };
        (strSlice(src, cellGet(qStart), qEnd), partial)
    } else {
        ("", partial)
    }
}

def linePrefixBefore(src: String, off: Int): String = {
    let n = strLen(src);
    let end = if (off < 0) 0 else if (off > n) n else off;
    let s = cellNew(end);
    while (cellGet(s) > 0 && strByteAt(src, cellGet(s) - 1) != 10) {
        cellSet(s, cellGet(s) - 1)
    };
    strTrim(strSlice(src, cellGet(s), end))
}

def collectUseImportsCompletion(items: List ModuleItem, seen: StrMap Bool, outRev: Cell (List Value), prefix: String): Void = {
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseMulti(modSegs, specs) -> {
                        let modKey = strJoin(modSegs, ".");
                        let cs = cellNew(specs);
                        while (match cellGet(cs) { Nil -> false, _ -> true }) {
                            match cellGet(cs) {
                                Cons(sp, rs) -> {
                                    addUniqueComp(seen, outRev, useSpecLocalName(sp), 3, "from " + modKey, "", prefix);
                                    cellSet(cs, rs)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    UseSingle(segs, _) -> {
                        let full = strJoin(segs, ".");
                        addUniqueComp(seen, outRev, shortSymName(full), 3, "from " + full, "", prefix)
                    },
                    UseAlias(segs, al, _) -> {
                        let full = strJoin(segs, ".");
                        addUniqueComp(seen, outRev, al, 9, "alias for " + full, "", prefix)
                    },
                    UseGlob(segs) -> {
                        let modKey = strJoin(segs, ".");
                        let _ = collectBuiltinModuleExports(modKey, seen, outRev, prefix);
                        ()
                    },
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    }
}

def addBuiltinSubmodules(rootPrefix: String, seen: StrMap Bool, outRev: Cell (List Value), partial: String): Void = {
    let want = rootPrefix + ".";
    let cur = cellNew(builtinModuleKeys());
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(k, r) -> {
                if (strStartsWith(k, want)) {
                    let sub = strSlice(k, strLen(want), strLen(k));
                    addUniqueComp(seen, outRev, sub, 9, "builtin module " + k, "", partial)
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def addGeishaKeywordsAndBuiltins(seen: StrMap Bool, outRev: Cell (List Value), prefix: String): Void = {
    let kws = [
        "def", "pub", "data", "type", "concept", "instance", "use", "mod",
        "open", "as", "let", "in", "if", "else", "while", "match", "extern",
        "noalloc", "init", "ptr", "forall", "true", "false",
        "Void", "Int", "Int64", "Float", "Float32", "Bool", "Char", "String",
        "List", "Cell", "MutArray", "ImmArray", "Ptr", "ForeignPtr", "ScopedPtr",
        "Arena", "Send", "Task", "Actor", "Chan", "MVar", "AtomicInt",
        "Nil", "Cons", "std", "sys"
    ];
    let ck = cellNew(kws);
    while (match cellGet(ck) { Nil -> false, _ -> true }) {
        match cellGet(ck) {
            Cons(k, r) -> {
                addUniqueComp(seen, outRev, k, 14, "keyword / builtin", "", prefix);
                cellSet(ck, r)
            },
            Nil -> (),
        }
    };
    let showInternal = strStartsWith(prefix, "__");
    let cp = cellNew(preludePrimSpecs());
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons((nm, sig), r) -> {
                if (showInternal || !strStartsWith(nm, "__")) {
                    addUniqueComp(seen, outRev, nm, 3, sig, "", prefix)
                } else ();
                cellSet(cp, r)
            },
            Nil -> (),
        }
    }
}

def handleCompletion(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                let (qual, partial) = extractDotQualifier(doc.dsText, off);
                let seen: StrMap Bool = strMapNew();
                let itemsRev: Cell (List Value) = cellNew(Nil);

                if (strLen(qual) > 0) {
                    if (qual == "std" || qual == "sys") {
                        addBuiltinSubmodules(qual, seen, itemsRev, partial)
                    } else {
                        let resolvedKey = match doc.dsParsed {
                            Some(fm) -> match resolveImportedAliasModKey(fm.items, qual) {
                                Some(rk) -> rk,
                                None -> qual,
                            },
                            None -> qual,
                        };
                        let okBuiltin = collectBuiltinModuleExports(resolvedKey, seen, itemsRev, partial);
                        if (!okBuiltin) {
                            match doc.dsInfer {
                                Some(inf) -> {
                                    let pfx = resolvedKey + ".";
                                    let cd = cellNew(inf.defs);
                                    while (match cellGet(cd) { Nil -> false, _ -> true }) {
                                        match cellGet(cd) {
                                            Cons(d, r) -> {
                                                if (strStartsWith(d.ident, pfx) && isPublicVis(d.vis)) {
                                                    let shortName = strSlice(d.ident, strLen(pfx), strLen(d.ident));
                                                    let sig = match d.item {
                                                        ItForm(f) -> formatScheme(f.ty),
                                                        _ -> formatDefSig(d),
                                                    };
                                                    let docMd = docForDef(doc.dsFiles, d);
                                                    addUniqueComp(seen, itemsRev, shortName, completionKindForDef(d), sig, docMd, partial)
                                                } else ();
                                                cellSet(cd, r)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                },
                                None -> (),
                            }
                        } else ()
                    }
                } else {
                    let linePfx = linePrefixBefore(doc.dsText, off);
                    if (strStartsWith(linePfx, "use ") || strStartsWith(linePfx, "pub use ")) {
                        let ck = cellNew(builtinModuleKeys());
                        while (match cellGet(ck) { Nil -> false, _ -> true }) {
                            match cellGet(ck) {
                                Cons(k, r) -> {
                                    addUniqueComp(seen, itemsRev, k, 9, "builtin module", "", partial);
                                    cellSet(ck, r)
                                },
                                Nil -> (),
                            }
                        }
                    } else ();
                    match doc.dsParsed {
                        Some(fm) -> {
                            collectDefsFromModuleItems(doc.dsText, fm.items, false, seen, itemsRev, partial);
                            collectUseImportsCompletion(fm.items, seen, itemsRev, partial)
                        },
                        None -> (),
                    };
                    match doc.dsInfer {
                        Some(inf) -> {
                            let cd = cellNew(inf.defs);
                            while (match cellGet(cd) { Nil -> false, _ -> true }) {
                                match cellGet(cd) {
                                    Cons(d, r) -> {
                                        if (d.dpos.fileId == doc.dsFileId && !isSyntheticDerivedDef(d)) {
                                            let sig = match d.item {
                                                ItForm(f) -> formatScheme(f.ty),
                                                _ -> formatDefSig(d),
                                            };
                                            addUniqueComp(seen, itemsRev, d.ident, completionKindForDef(d), sig, docForDef(doc.dsFiles, d), partial)
                                        } else ();
                                        cellSet(cd, r)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    };
                    addGeishaKeywordsAndBuiltins(seen, itemsRev, partial)
                };

                VObj([
                    ("isIncomplete", VBool(false)),
                    ("items", VArr(listRev(cellGet(itemsRev)))),
                ])
            },
            _ -> VArr(Nil),
        },
        _ -> VArr(Nil),
    }
}

// ============================================================================
// Symbol Resolution, References (`textDocument/references`) & Rename
// ============================================================================

def isGeishaKeyword(s: String): Bool =
    s == "def" || s == "pub" || s == "data" || s == "type"
    || s == "concept" || s == "instance" || s == "use" || s == "mod"
    || s == "open" || s == "as" || s == "let" || s == "in"
    || s == "if" || s == "else" || s == "while" || s == "match"
    || s == "extern" || s == "noalloc" || s == "init" || s == "ptr"
    || s == "forall" || s == "true" || s == "false" || s == "return"
    || s == "_"

def isValidGeishaIdent(s: String): Bool = {
    let n = strLen(s);
    if (n == 0 || isGeishaKeyword(s)) false
    else if (!isIdentStartByte(strByteAt(s, 0))) false
    else {
        let i = cellNew(1);
        let ok = cellNew(true);
        while (cellGet(i) < n && cellGet(ok)) {
            if (!isIdentContByte(strByteAt(s, cellGet(i)))) cellSet(ok, false) else ();
            cellSet(i, cellGet(i) + 1)
        };
        cellGet(ok)
    }
}

def headTypeConName(ty: Type): Option String = match ty {
    TyCon(name) -> Some(name),
    TyComp(base, _) -> headTypeConName(base),
    _ -> None,
}

def isWinDrivePath(p: String): Bool =
    strLen(p) >= 2 && isAsciiLetter(strByteAt(p, 0)) && strByteAt(p, 1) == 58

def isUserSourceFile(files: Vec SourceFile, fileId: Int): Bool =
    match getSourceFileFromVec(files, fileId) {
        Some(sf) ->
            strLen(sf.sfPath) > 0
            && !strStartsWith(sf.sfPath, "<")
            && (strStartsWith(sf.sfPath, "/") || strStartsWith(sf.sfPath, "//") || isWinDrivePath(sf.sfPath) || fileExists(sf.sfPath)),
        None -> false,
    }

def isIgnoredWorkspaceDir(name: String): Bool =
    name == ".git" || name == "build" || name == "dist" || name == "target"
    || name == "node_modules" || strStartsWith(name, ".")

def collectWorkspaceGsaFiles(dir: String, outRev: Cell (List String)): Void =
    match readDir(dir) {
        Err(_) -> (),
        Ok(entries) -> {
            let cur = cellNew(entries);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(nm, r) -> {
                        if (!isIgnoredWorkspaceDir(nm)) {
                            let full = pathJoin(dir, nm);
                            if (isDir(full)) {
                                collectWorkspaceGsaFiles(full, outRev)
                            } else if (strEndsWith(nm, ".gsa")) {
                                cellSet(outRev, Cons(full, cellGet(outRev)))
                            } else ()
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    }

data SymKind {
    SkLocal,
    SkTopDef,
    SkField,
}

data SymTarget {
    MkSymTarget {
        stKind: SymKind,
        stName: String,
        stQName: String,
        stDeclCanon: String,
        stDeclDefStart: Int,
        stDeclDefEnd: Int,
        stDefSpan: Span,
        stRenameable: Bool,
        stIsType: Bool,
    },
}

data OccSpan {
    MkOccSpan {
        occUri: String,
        occText: String,
        occStart: Int,
        occEnd: Int,
        occReplace: Option String,
    },
}

data WorkspaceDoc {
    MkWorkspaceDoc {
        wdUri: String,
        wdPath: String,
        wdCanon: String,
        wdText: String,
        wdParsed: Option FileModule,
        wdInfer: Option InferOutput,
        wdExports: StrMap NameInfo,
        wdFiles: Vec SourceFile,
        wdFileId: Int,
    },
}

def spanEq(a: Span, b: Span): Bool =
    a.fileId == b.fileId && a.start == b.start && a.end == b.end

def lookupAdtForCtor(inf: InferOutput, ctorQName: String): Option String = {
    let cur = cellNew(inf.defs);
    let found: Cell (Option String) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (d.ident == ctorQName || defHasVariant(d, ctorQName)) {
                    match d.item {
                        ItAlg(_, _) -> cellSet(found, Some(d.ident)),
                        _ -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def findLocalDeclInForm(src: String, f: Form, fileId: Int, off: Int, word: String): Option LocalBind =
    if (f.pos.fileId != fileId || off < f.pos.start || off > f.pos.end) None
    else match f.node {
        ExAbs(ps, _, body) -> {
            let headEnd = if (body.pos.start > f.pos.start) body.pos.start else f.pos.end;
            let found: Cell (Option LocalBind) = cellNew(None);
            let cp = cellNew(ps);
            while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(vd, r) -> {
                        if (vd.vname == word) {
                            let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, headEnd);
                            if (off >= bsp.start && off <= bsp.end) {
                                cellSet(found, Some(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }))
                            } else ()
                        } else ();
                        cellSet(cp, r)
                    },
                    Nil -> (),
                }
            };
            match cellGet(found) {
                Some(lb) -> Some(lb),
                None -> findLocalDeclInForm(src, body, fileId, off, word),
            }
        },
        ExLet(vd, rhs, body) -> {
            let bindEnd = if (rhs.pos.start > f.pos.start) rhs.pos.start else f.pos.end;
            let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, bindEnd);
            if (vd.vname == word && off >= bsp.start && off <= bsp.end) {
                Some(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm })
            } else {
                match findLocalDeclInForm(src, rhs, fileId, off, word) {
                    Some(lb) -> Some(lb),
                    None -> findLocalDeclInForm(src, body, fileId, off, word),
                }
            }
        },
        ExMatch(scrut, arms) -> {
            match findLocalDeclInForm(src, scrut, fileId, off, word) {
                Some(lb) -> Some(lb),
                None -> {
                    let prevArmEnd = cellNew(if (scrut.pos.end > f.pos.start) scrut.pos.end else f.pos.start);
                    let found: Cell (Option LocalBind) = cellNew(None);
                    let ca = cellNew(arms);
                    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(ca) { Nil -> false, _ -> true }) {
                        match cellGet(ca) {
                            Cons(arm, r) -> {
                                let patNames: Cell (List String) = cellNew(Nil);
                                collectPatVarNames(arm.pat, patNames);
                                let patLo = cellGet(prevArmEnd);
                                let patHi = if (arm.body.pos.start > patLo) arm.body.pos.start else f.pos.end;
                                let cn = cellNew(listRev(cellGet(patNames)));
                                while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cn) { Nil -> false, _ -> true }) {
                                    match cellGet(cn) {
                                        Cons(vn, rn) -> {
                                            if (vn == word) {
                                                let bsp = locatePatVarSpan(arm.pat, src, fileId, vn, patLo, patHi, f.pos.start, f.pos.end);
                                                if (off >= bsp.start && off <= bsp.end) {
                                                    cellSet(found, Some(MkLocalBind { lbName: vn, lbSpan: bsp, lbScheme: ScmSlot }))
                                                } else ()
                                            } else ();
                                            cellSet(cn, rn)
                                        },
                                        Nil -> (),
                                    }
                                };
                                match cellGet(found) {
                                    None -> {
                                        match arm.guard {
                                            Some(g) -> match findLocalDeclInForm(src, g, fileId, off, word) {
                                                Some(lb) -> cellSet(found, Some(lb)),
                                                None -> (),
                                            },
                                            None -> (),
                                        };
                                        match cellGet(found) {
                                            None -> match findLocalDeclInForm(src, arm.body, fileId, off, word) {
                                                Some(lb) -> cellSet(found, Some(lb)),
                                                None -> (),
                                            },
                                            Some(_) -> (),
                                        }
                                    },
                                    Some(_) -> (),
                                };
                                if (arm.body.pos.end > cellGet(prevArmEnd)) cellSet(prevArmEnd, arm.body.pos.end) else ();
                                cellSet(ca, r)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(found)
                },
            }
        },
        ExTuple(es) -> findLocalDeclInFormList(src, es, fileId, off, word),
        ExList(es) -> findLocalDeclInFormList(src, es, fileId, off, word),
        ExBlock(es) -> findLocalDeclInFormList(src, es, fileId, off, word),
        ExStructInit(_, fields) -> {
            let cf = cellNew(fields);
            let found: Cell (Option LocalBind) = cellNew(None);
            while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons((_, fv), r) -> {
                        match findLocalDeclInForm(src, fv, fileId, off, word) {
                            Some(lb) -> cellSet(found, Some(lb)),
                            None -> (),
                        };
                        cellSet(cf, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
        ExApply(callee, args) -> match findLocalDeclInForm(src, callee, fileId, off, word) {
            Some(lb) -> Some(lb),
            None -> findLocalDeclInFormList(src, args, fileId, off, word),
        },
        ExBin(_, lhs, rhs) -> match findLocalDeclInForm(src, lhs, fileId, off, word) {
            Some(lb) -> Some(lb),
            None -> findLocalDeclInForm(src, rhs, fileId, off, word),
        },
        ExUn(_, sub) -> findLocalDeclInForm(src, sub, fileId, off, word),
        ExIf(c, t, e) -> match findLocalDeclInForm(src, c, fileId, off, word) {
            Some(lb) -> Some(lb),
            None -> match findLocalDeclInForm(src, t, fileId, off, word) {
                Some(lb) -> Some(lb),
                None -> findLocalDeclInForm(src, e, fileId, off, word),
            },
        },
        ExWhile(c, b) -> match findLocalDeclInForm(src, c, fileId, off, word) {
            Some(lb) -> Some(lb),
            None -> findLocalDeclInForm(src, b, fileId, off, word),
        },
        ExField(base, _) -> findLocalDeclInForm(src, base, fileId, off, word),
        ExTry(inner) -> findLocalDeclInForm(src, inner, fileId, off, word),
        ExLit(_) -> None,
        ExVar(_) -> None,
    }

def findLocalDeclInFormList(src: String, fs: List Form, fileId: Int, off: Int, word: String): Option LocalBind = {
    let cur = cellNew(fs);
    let found: Cell (Option LocalBind) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                match findLocalDeclInForm(src, h, fileId, off, word) {
                    Some(lb) -> cellSet(found, Some(lb)),
                    None -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def findLocalDeclAtOffset(src: String, defs: List Def, fileId: Int, off: Int, word: String): Option LocalBind = {
    let cur = cellNew(defs);
    let found: Cell (Option LocalBind) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                if (spanContains(d.dpos, fileId, off)) {
                    match d.item {
                        ItForm(f) -> {
                            match f.node {
                                ExAbs(ps, _, body) -> {
                                    let headEnd = if (body.pos.start > d.dpos.start) body.pos.start else d.dpos.end;
                                    let cp = cellNew(ps);
                                    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cp) { Nil -> false, _ -> true }) {
                                        match cellGet(cp) {
                                            Cons(vd, rp) -> {
                                                if (vd.vname == word) {
                                                    let bsp = locateBinderSpan(src, fileId, vd.vname, d.dpos.start, headEnd);
                                                    if (off >= bsp.start && off <= bsp.end) {
                                                        cellSet(found, Some(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }))
                                                    } else ()
                                                } else ();
                                                cellSet(cp, rp)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                },
                                _ -> (),
                            };
                            match cellGet(found) {
                                None -> match findLocalDeclInForm(src, f, fileId, off, word) {
                                    Some(lb) -> cellSet(found, Some(lb)),
                                    None -> (),
                                },
                                Some(_) -> (),
                            }
                        },
                        ItInstance(_, _, _, impls) -> {
                            let ci = cellNew(impls);
                            while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(ci) { Nil -> false, _ -> true }) {
                                match cellGet(ci) {
                                    Cons(mi, ri) -> {
                                        match findLocalDeclInForm(src, mi.implBody, fileId, off, word) {
                                            Some(lb) -> cellSet(found, Some(lb)),
                                            None -> (),
                                        };
                                        cellSet(ci, ri)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        _ -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def makeTopDefTarget(files: Vec SourceFile, d: Def, qname: String, isType: Bool): SymTarget = {
    let shortNm = shortSymName(qname);
    let canon = match getSourceFileFromVec(files, d.dpos.fileId) {
        Some(sf) -> loaderCanonicalPath(sf.sfPath),
        None -> "",
    };
    let nameSp = match getSourceFileFromVec(files, d.dpos.fileId) {
        Some(sf) -> {
            let (ns, ne) = findIdentInSpan(sf.sfContent, shortNm, d.dpos.start, d.dpos.end);
            MkSpan { fileId: d.dpos.fileId, start: ns, end: ne }
        },
        None -> d.dpos,
    };
    MkSymTarget {
        stKind: SkTopDef,
        stName: shortNm,
        stQName: qname,
        stDeclCanon: canon,
        stDeclDefStart: d.dpos.start,
        stDeclDefEnd: d.dpos.end,
        stDefSpan: nameSp,
        stRenameable: isUserSourceFile(files, d.dpos.fileId),
        stIsType: isType,
    }
}

def makeFieldTarget(files: Vec SourceFile, adtDef: Def, fieldName: String): SymTarget = {
    let canon = match getSourceFileFromVec(files, adtDef.dpos.fileId) {
        Some(sf) -> loaderCanonicalPath(sf.sfPath),
        None -> "",
    };
    let fieldSp = match getSourceFileFromVec(files, adtDef.dpos.fileId) {
        Some(sf) -> {
            let (fs, fe) = findIdentInSpan(sf.sfContent, fieldName, adtDef.dpos.start, adtDef.dpos.end);
            MkSpan { fileId: adtDef.dpos.fileId, start: fs, end: fe }
        },
        None -> adtDef.dpos,
    };
    MkSymTarget {
        stKind: SkField,
        stName: fieldName,
        stQName: adtDef.ident,
        stDeclCanon: canon,
        stDeclDefStart: adtDef.dpos.start,
        stDeclDefEnd: adtDef.dpos.end,
        stDefSpan: fieldSp,
        stRenameable: isUserSourceFile(files, adtDef.dpos.fileId),
        stIsType: false,
    }
}

def defIsTypeDecl(d: Def, qname: String): Bool =
    if (d.ident != qname) false
    else match d.item {
        ItAlg(_, _) -> true,
        ItAlias(_, _) -> true,
        ItConcept(_, _, _, _) -> true,
        _ -> false,
    }

def defHasStructField(d: Def, fieldName: String): Bool = match d.item {
    ItAlg(_, vs) -> {
        let cv = cellNew(vs);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cv) { Nil -> false, _ -> true }) {
            match cellGet(cv) {
                Cons(v, rv) -> {
                    match v.vbody {
                        VarStruct(fds) -> {
                            let cf = cellNew(fds);
                            while (!cellGet(found) && match cellGet(cf) { Nil -> false, _ -> true }) {
                                match cellGet(cf) {
                                    Cons(fd, rf) -> {
                                        match fd.fname {
                                            Some(fn) if (fn == fieldName) -> cellSet(found, true),
                                            _ -> (),
                                        };
                                        cellSet(cf, rf)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        _ -> (),
                    };
                    cellSet(cv, rv)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def findVariantExactQName(d: Def, word: String): Option String = match d.item {
    ItAlg(_, vs) -> {
        let cv = cellNew(vs);
        let found: Cell (Option String) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cv) { Nil -> false, _ -> true }) {
            match cellGet(cv) {
                Cons(v, rv) -> {
                    if (v.vname == word || shortSymName(v.vname) == word) {
                        cellSet(found, Some(v.vname))
                    } else ();
                    cellSet(cv, rv)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> None,
}

def findMethodExactQName(d: Def, word: String): Option String = match d.item {
    ItConcept(_, _, _, ms) -> {
        let cm = cellNew(ms);
        let found: Cell (Option String) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cm) { Nil -> false, _ -> true }) {
            match cellGet(cm) {
                Cons(m, rm) -> {
                    if (m.mname == word || shortSymName(m.mname) == word) {
                        cellSet(found, Some(m.mname))
                    } else ();
                    cellSet(cm, rm)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> None,
}

def findPatTargetInPat(pat: Pattern, inf: InferOutput, off: Int, word: String): Option (Bool, String) = match pat {
    PatCtor(qname, ps) ->
        if (shortSymName(qname) == word) Some((false, qname))
        else {
            let cur = cellNew(ps);
            let found: Cell (Option (Bool, String)) = cellNew(None);
            while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(p, r) -> {
                        match findPatTargetInPat(p, inf, off, word) {
                            Some(x) -> cellSet(found, Some(x)),
                            None -> (),
                        };
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
    PatStruct(qname, fs) -> {
        let cur = cellNew(fs);
        let found: Cell (Option (Bool, String)) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((fn, p, fSp, _), r) -> {
                    if (fn == word && fSp.end > fSp.start && off >= fSp.start && off <= fSp.end) {
                        match lookupAdtForCtor(inf, qname) {
                            Some(adtName) -> cellSet(found, Some((true, adtName))),
                            None -> (),
                        }
                    } else {
                        match findPatTargetInPat(p, inf, off, word) {
                            Some(x) -> cellSet(found, Some(x)),
                            None -> (),
                        }
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        match cellGet(found) {
            Some(x) -> Some(x),
            None -> if (shortSymName(qname) == word) Some((false, qname)) else None,
        }
    },
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        let found: Cell (Option (Bool, String)) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    match findPatTargetInPat(p, inf, off, word) {
                        Some(x) -> cellSet(found, Some(x)),
                        None -> (),
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> None,
}

def resolveTargetAtOffset(doc: DocState, off: Int): Option (SymTarget, Int, Int) =
    match identAtOffset(doc.dsText, off) {
        None -> None,
        Some((word, ws, we)) ->
            if (isGeishaKeyword(word)) None
            else match doc.dsInfer {
                None -> None,
                Some(inf) -> {
                    let docCanon = loaderCanonicalPath(doc.dsPath);
                    // 1. Check if cursor is directly on a local declaration binder (param / let / match pat var)
                    match findLocalDeclAtOffset(doc.dsText, inf.defs, doc.dsFileId, off, word) {
                        Some(lb) -> Some((MkSymTarget {
                            stKind: SkLocal,
                            stName: lb.lbName,
                            stQName: "",
                            stDeclCanon: docCanon,
                            stDeclDefStart: lb.lbSpan.start,
                            stDeclDefEnd: lb.lbSpan.end,
                            stDefSpan: lb.lbSpan,
                            stRenameable: true,
                            stIsType: false,
                        }, ws, we)),
                        None -> {
                            // 2. Check innermost expression form
                            let byForm: Option SymTarget = match findInnermostFormInDefs(doc.dsText, inf.defs, doc.dsFileId, off) {
                                Some(ff) -> match ff.ffForm.node {
                                    ExVar(qname) -> match lookupLocalBind(ff.ffLocals, qname) {
                                        Some(lb) -> Some(MkSymTarget {
                                            stKind: SkLocal,
                                            stName: lb.lbName,
                                            stQName: "",
                                            stDeclCanon: docCanon,
                                            stDeclDefStart: lb.lbSpan.start,
                                            stDeclDefEnd: lb.lbSpan.end,
                                            stDefSpan: lb.lbSpan,
                                            stRenameable: true,
                                            stIsType: false,
                                        }),
                                        None -> match lookupDefExact(inf.defs, qname) {
                                            Some(d) -> Some(makeTopDefTarget(doc.dsFiles, d, qname, defIsTypeDecl(d, qname))),
                                            None -> None,
                                        },
                                    },
                                    ExField(base, fname) if (fname == word) ->
                                        match headTypeConName(schemeBody(base.ty)) {
                                            Some(adtName) -> match lookupDefExact(inf.defs, adtName) {
                                                Some(adtDef) -> Some(makeFieldTarget(doc.dsFiles, adtDef, fname)),
                                                None -> None,
                                            },
                                            None -> None,
                                        },
                                    ExStructInit(ctorQn, fields) ->
                                        if (shortSymName(ctorQn) == word) {
                                            match lookupDefExact(inf.defs, ctorQn) {
                                                Some(d) -> Some(makeTopDefTarget(doc.dsFiles, d, ctorQn, defIsTypeDecl(d, ctorQn))),
                                                None -> None,
                                            }
                                        } else {
                                            let isField = cellNew(false);
                                            let cf = cellNew(fields);
                                            while (!cellGet(isField) && match cellGet(cf) { Nil -> false, _ -> true }) {
                                                match cellGet(cf) {
                                                    Cons((fn, _), r) -> {
                                                        if (fn == word) cellSet(isField, true) else ();
                                                        cellSet(cf, r)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            if (cellGet(isField)) {
                                                match lookupAdtForCtor(inf, ctorQn) {
                                                    Some(adtName) -> match lookupDefExact(inf.defs, adtName) {
                                                        Some(adtDef) -> Some(makeFieldTarget(doc.dsFiles, adtDef, word)),
                                                        None -> None,
                                                    },
                                                    None -> None,
                                                }
                                            } else None
                                        },
                                    ExMatch(_, arms) -> {
                                        let ca = cellNew(arms);
                                        let found: Cell (Option SymTarget) = cellNew(None);
                                        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(ca) { Nil -> false, _ -> true }) {
                                            match cellGet(ca) {
                                                Cons(arm, r) -> {
                                                    match findPatTargetInPat(arm.pat, inf, off, word) {
                                                        Some((true, adtName)) -> match lookupDefExact(inf.defs, adtName) {
                                                            Some(adtDef) -> cellSet(found, Some(makeFieldTarget(doc.dsFiles, adtDef, word))),
                                                            None -> (),
                                                        },
                                                        Some((false, ctorQn)) -> match lookupDefExact(inf.defs, ctorQn) {
                                                            Some(d) -> cellSet(found, Some(makeTopDefTarget(doc.dsFiles, d, ctorQn, false))),
                                                            None -> (),
                                                        },
                                                        None -> (),
                                                    };
                                                    cellSet(ca, r)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        cellGet(found)
                                    },
                                    _ -> match lookupLocalBind(ff.ffLocals, word) {
                                        Some(lb) -> Some(MkSymTarget {
                                            stKind: SkLocal,
                                            stName: lb.lbName,
                                            stQName: "",
                                            stDeclCanon: docCanon,
                                            stDeclDefStart: lb.lbSpan.start,
                                            stDeclDefEnd: lb.lbSpan.end,
                                            stDefSpan: lb.lbSpan,
                                            stRenameable: true,
                                            stIsType: false,
                                        }),
                                        None -> None,
                                    },
                                },
                                None -> None,
                            };
                            match byForm {
                                Some(t) -> Some((t, ws, we)),
                                None -> {
                                    // 3. Check enclosing top-level Def (data type, variant, struct field, concept, method, fn name)
                                    let byDef: Option SymTarget = match lookupDefAtOffset(inf.defs, doc.dsFileId, off) {
                                        Some(d) ->
                                            if (shortSymName(d.ident) == word) {
                                                Some(makeTopDefTarget(doc.dsFiles, d, d.ident, defIsTypeDecl(d, d.ident)))
                                            } else {
                                                match findVariantExactQName(d, word) {
                                                    Some(vqn) -> Some(makeTopDefTarget(doc.dsFiles, d, vqn, false)),
                                                    None -> match findMethodExactQName(d, word) {
                                                        Some(mqn) -> Some(makeTopDefTarget(doc.dsFiles, d, mqn, false)),
                                                        None -> if (defHasStructField(d, word)) {
                                                            Some(makeFieldTarget(doc.dsFiles, d, word))
                                                        } else None,
                                                    },
                                                }
                                            },
                                        None -> None,
                                    };
                                    match byDef {
                                        Some(t) -> Some((t, ws, we)),
                                        None -> match lookupDefLoose(inf.defs, word) {
                                            Some(d) -> {
                                                let qn =
                                                    if (shortSymName(d.ident) == word) d.ident
                                                    else match findVariantExactQName(d, word) {
                                                        Some(vqn) -> vqn,
                                                        None -> match findMethodExactQName(d, word) {
                                                            Some(mqn) -> mqn,
                                                            None -> d.ident,
                                                        },
                                                    };
                                                Some((makeTopDefTarget(doc.dsFiles, d, qn, defIsTypeDecl(d, qn)), ws, we))
                                            },
                                            None -> None,
                                        },
                                    }
                                },
                            }
                        },
                    }
                },
            },
    }

def collectWorkspaceDocsForTarget(ss: ServerState, currentDoc: DocState, targetName: String, declCanon: String): List WorkspaceDoc = {
    let seenCanon: StrMap Bool = strMapNew();
    let docsRev: Cell (List WorkspaceDoc) = cellNew(Nil);

    // 1. Add all open documents (with live in-memory overlays)
    let curOpen = cellNew(cellGet(ss.ssOpenUris));
    while (match cellGet(curOpen) { Nil -> false, _ -> true }) {
        match cellGet(curOpen) {
            Cons(u, r) -> {
                match strMapGet(ss.ssDocs, u) {
                    Some(d) -> {
                        let c = loaderCanonicalPath(d.dsPath);
                        if (!strMapContains(seenCanon, c)) {
                            strMapInsert(seenCanon, c, true);
                            cellSet(docsRev, Cons(MkWorkspaceDoc {
                                wdUri: d.dsUri,
                                wdPath: d.dsPath,
                                wdCanon: c,
                                wdText: d.dsText,
                                wdParsed: d.dsParsed,
                                wdInfer: d.dsInfer,
                                wdExports: d.dsExports,
                                wdFiles: d.dsFiles,
                                wdFileId: d.dsFileId,
                            }, cellGet(docsRev)))
                        } else ()
                    },
                    None -> (),
                };
                cellSet(curOpen, r)
            },
            Nil -> (),
        }
    };

    // 2. Discover candidate .gsa files on disk in project / workspace / current dir
    let candPaths: Cell (List String) = cellNew(Nil);
    if (strLen(declCanon) > 0 && fileExists(declCanon)) {
        cellSet(candPaths, Cons(declCanon, cellGet(candPaths)))
    } else ();
    let searchRoot = match findProjectRoot(pathDirname(currentDoc.dsPath)) {
        Some(pr) -> pr,
        None -> match cellGet(ss.ssRootDir) {
            Some(rd) -> rd,
            None -> pathDirname(currentDoc.dsPath),
        },
    };
    if (strLen(searchRoot) > 0 && isDir(searchRoot)) {
        collectWorkspaceGsaFiles(searchRoot, candPaths)
    } else ();

    let cp = cellNew(cellGet(candPaths));
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(fp, r) -> {
                let c = loaderCanonicalPath(fp);
                if (!strMapContains(seenCanon, c)) {
                    strMapInsert(seenCanon, c, true);
                    match readFile(fp) {
                        Ok(txt) ->
                            if (strContains(txt, targetName)) {
                                diagReset();
                                let pfid = diagRegisterFile(fp, txt);
                                let parsedOpt = match parseFileModuleInFile(txt, Nil, pfid) {
                                    Ok(fm) -> Some(fm),
                                    Err(_) -> None,
                                };
                                diagReset();
                                let (rSpec, eSpecs) = resolveDocPkgSpecs(fp);
                                let infOpt = match runFrontendCheck(fp, txt, rSpec, eSpecs) {
                                    Ok(inf) -> Some(inf),
                                    Err(_) -> None,
                                };
                                let fSnap = diagRegisteredFiles();
                                let eSnap = loaderLastPublicExports();
                                cellSet(docsRev, Cons(MkWorkspaceDoc {
                                    wdUri: resolveClientUriForPath(ss, fp),
                                    wdPath: fp,
                                    wdCanon: c,
                                    wdText: txt,
                                    wdParsed: parsedOpt,
                                    wdInfer: infOpt,
                                    wdExports: eSnap,
                                    wdFiles: fSnap,
                                    wdFileId: 1,
                                }, cellGet(docsRev)))
                            } else (),
                        Err(_) -> (),
                    }
                } else ();
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(docsRev))
}

// Find what qualified name `target` has inside `wd`'s `InferOutput` by matching canonical declaration file + def span.
def findTargetQNameInDoc(wd: WorkspaceDoc, target: SymTarget): Option String = match wd.wdInfer {
    None -> None,
    Some(inf) -> {
        let cur = cellNew(inf.defs);
        let found: Cell (Option String) = cellNew(None);
        while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(d, r) -> {
                    let matchesDecl = match getSourceFileFromVec(wd.wdFiles, d.dpos.fileId) {
                        Some(sf) ->
                            loaderCanonicalPath(sf.sfPath) == target.stDeclCanon
                            && d.dpos.start == target.stDeclDefStart
                            && d.dpos.end == target.stDeclDefEnd,
                        None -> false,
                    };
                    if (matchesDecl) {
                        match target.stKind {
                            SkField -> cellSet(found, Some(d.ident)),
                            SkTopDef ->
                                if (shortSymName(d.ident) == target.stName) {
                                    cellSet(found, Some(d.ident))
                                } else {
                                    match findVariantExactQName(d, target.stName) {
                                        Some(vqn) -> cellSet(found, Some(vqn)),
                                        None -> match findMethodExactQName(d, target.stName) {
                                            Some(mqn) -> cellSet(found, Some(mqn)),
                                            None -> (),
                                        },
                                    }
                                },
                            SkLocal -> (),
                        }
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
}

def pushOcc(seen: StrMap Bool, outRev: Cell (List OccSpan), uri: String, text: String, s: Int, e: Int): Void = {
    if (e > s) {
        let key = uri + "#" + intToStr(s) + ":" + intToStr(e);
        if (!strMapContains(seen, key)) {
            strMapInsert(seen, key, true);
            cellSet(outRev, Cons(MkOccSpan { occUri: uri, occText: text, occStart: s, occEnd: e, occReplace: None }, cellGet(outRev)))
        } else ()
    } else ()
}

def pushOccReplace(seen: StrMap Bool, outRev: Cell (List OccSpan), uri: String, text: String, s: Int, e: Int, rep: String): Void = {
    if (e > s) {
        let key = uri + "#" + intToStr(s) + ":" + intToStr(e);
        if (!strMapContains(seen, key)) {
            strMapInsert(seen, key, true);
            cellSet(outRev, Cons(MkOccSpan { occUri: uri, occText: text, occStart: s, occEnd: e, occReplace: Some(rep) }, cellGet(outRev)))
        } else ()
    } else ()
}

def localsContainSpan(locals: List LocalBind, sp: Span): Bool = match locals {
    Nil -> false,
    Cons(lb, r) -> if (spanEq(lb.lbSpan, sp)) true else localsContainSpan(r, sp),
}

// True if `name` is bound in `locals` strictly inside `targetDefSpan` (appears before `targetDefSpan` in the innermost-first list).
def localsBindInsideTarget(locals: List LocalBind, name: String, targetDefSpan: Span): Bool = match locals {
    Nil -> false,
    Cons(lb, r) ->
        if (spanEq(lb.lbSpan, targetDefSpan)) false
        else if (lb.lbName == name) true
        else localsBindInsideTarget(r, name, targetDefSpan),
}

def collectLocalOccsInForm(
    uri: String,
    src: String,
    f: Form,
    fileId: Int,
    locals: List LocalBind,
    targetDefSpan: Span,
    includeDecl: Bool,
    newNameOpt: Option String,
    conflict: Cell (Option String),
    seen: StrMap Bool,
    outRev: Cell (List OccSpan)
): Void = {
    match f.node {
        ExLit(_) -> (),
        ExVar(name) ->
            if (f.pos.fileId == fileId) {
                match lookupLocalBind(locals, name) {
                    Some(lb) if (spanEq(lb.lbSpan, targetDefSpan)) -> {
                        match newNameOpt {
                            Some(nn) if (nn != name) -> match lookupLocalBind(locals, nn) {
                                Some(confLb) if (!spanEq(confLb.lbSpan, targetDefSpan)) ->
                                    cellSet(conflict, Some("Renaming '" + name + "' to '" + nn + "' would be captured by an existing binding '" + nn + "'")),
                                _ -> (),
                            },
                            _ -> (),
                        };
                        let (s, e) = findIdentInSpan(src, name, f.pos.start, f.pos.end);
                        pushOcc(seen, outRev, uri, src, s, e)
                    },
                    _ -> match newNameOpt {
                        Some(nn) if (shortSymName(name) == nn && localsContainSpan(locals, targetDefSpan)) ->
                            if (!localsBindInsideTarget(locals, nn, targetDefSpan)) {
                                cellSet(conflict, Some("Renaming to '" + nn + "' would capture an existing reference to '" + nn + "'"))
                            } else (),
                        _ -> (),
                    },
                }
            } else (),
        ExTuple(es) -> collectLocalOccsInList(uri, src, es, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
        ExList(es) -> collectLocalOccsInList(uri, src, es, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
        ExBlock(es) -> collectLocalOccsInList(uri, src, es, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
        ExStructInit(_, fields) -> {
            let cf = cellNew(fields);
            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons((_, fv), r) -> {
                        collectLocalOccsInForm(uri, src, fv, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
                        cellSet(cf, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExApply(callee, args) -> {
            collectLocalOccsInForm(uri, src, callee, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            collectLocalOccsInList(uri, src, args, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
        },
        ExAbs(ps, _, body) -> {
            let nextLocals = cellNew(locals);
            let targetInParams = cellNew(false);
            if (f.pos.fileId == fileId && f.pos.start < body.pos.start) {
                let cp = cellNew(ps);
                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                    match cellGet(cp) {
                        Cons(vd, r) -> {
                            let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, body.pos.start);
                            if (spanEq(bsp, targetDefSpan)) {
                                cellSet(targetInParams, true);
                                if (includeDecl) pushOcc(seen, outRev, uri, src, bsp.start, bsp.end) else ()
                            } else ();
                            cellSet(nextLocals, Cons(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }, cellGet(nextLocals)));
                            cellSet(cp, r)
                        },
                        Nil -> (),
                    }
                };
                if (cellGet(targetInParams)) {
                    match newNameOpt {
                        Some(nn) -> {
                            let cp2 = cellNew(ps);
                            while (match cellGet(cp2) { Nil -> false, _ -> true }) {
                                match cellGet(cp2) {
                                    Cons(vd, r) -> {
                                        let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, body.pos.start);
                                        if (!spanEq(bsp, targetDefSpan) && vd.vname == nn) {
                                            cellSet(conflict, Some("Duplicate parameter name '" + nn + "' in scope"))
                                        } else ();
                                        cellSet(cp2, r)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    }
                } else ()
            } else ();
            collectLocalOccsInForm(uri, src, body, fileId, cellGet(nextLocals), targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
        },
        ExBin(_, lhs, rhs) -> {
            collectLocalOccsInForm(uri, src, lhs, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            collectLocalOccsInForm(uri, src, rhs, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
        },
        ExUn(_, sub) -> collectLocalOccsInForm(uri, src, sub, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
        ExLet(vd, rhs, body) -> {
            collectLocalOccsInForm(uri, src, rhs, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            let bindEnd = if (rhs.pos.start > f.pos.start) rhs.pos.start else f.pos.end;
            let bsp = locateBinderSpan(src, fileId, vd.vname, f.pos.start, bindEnd);
            if (includeDecl && spanEq(bsp, targetDefSpan)) {
                pushOcc(seen, outRev, uri, src, bsp.start, bsp.end)
            } else ();
            let nextLocals = Cons(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }, locals);
            collectLocalOccsInForm(uri, src, body, fileId, nextLocals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
        },
        ExIf(c, t, e) -> {
            collectLocalOccsInForm(uri, src, c, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            collectLocalOccsInForm(uri, src, t, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            collectLocalOccsInForm(uri, src, e, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
        },
        ExWhile(c, b) -> {
            collectLocalOccsInForm(uri, src, c, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            collectLocalOccsInForm(uri, src, b, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
        },
        ExMatch(scrut, arms) -> {
            collectLocalOccsInForm(uri, src, scrut, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
            let prevArmEnd = cellNew(if (scrut.pos.end > f.pos.start) scrut.pos.end else f.pos.start);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        let patNames: Cell (List String) = cellNew(Nil);
                        collectPatVarNames(arm.pat, patNames);
                        let patLo = cellGet(prevArmEnd);
                        let patHi = if (arm.body.pos.start > patLo) arm.body.pos.start else f.pos.end;
                        let armLocals = cellNew(locals);
                        let targetInArm = cellNew(false);
                        let armNewBinds: Cell (List LocalBind) = cellNew(Nil);
                        let cn = cellNew(listRev(cellGet(patNames)));
                        while (match cellGet(cn) { Nil -> false, _ -> true }) {
                            match cellGet(cn) {
                                Cons(vn, rn) -> {
                                    let bsp = locatePatVarSpan(arm.pat, src, fileId, vn, patLo, patHi, f.pos.start, f.pos.end);
                                    if (spanEq(bsp, targetDefSpan)) {
                                        cellSet(targetInArm, true);
                                        if (includeDecl) pushOcc(seen, outRev, uri, src, bsp.start, bsp.end) else ()
                                    } else ();
                                    let lb = MkLocalBind { lbName: vn, lbSpan: bsp, lbScheme: ScmSlot };
                                    cellSet(armNewBinds, Cons(lb, cellGet(armNewBinds)));
                                    cellSet(armLocals, Cons(lb, cellGet(armLocals)));
                                    cellSet(cn, rn)
                                },
                                Nil -> (),
                            }
                        };
                        if (cellGet(targetInArm)) {
                            match newNameOpt {
                                Some(nn) -> {
                                    let cb = cellNew(cellGet(armNewBinds));
                                    while (match cellGet(cb) { Nil -> false, _ -> true }) {
                                        match cellGet(cb) {
                                            Cons(lb, rb) -> {
                                                if (!spanEq(lb.lbSpan, targetDefSpan) && lb.lbName == nn) {
                                                    cellSet(conflict, Some("Duplicate pattern binding '" + nn + "' in match arm"))
                                                } else ();
                                                cellSet(cb, rb)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                },
                                None -> (),
                            }
                        } else ();
                        let al = cellGet(armLocals);
                        match arm.guard {
                            Some(g) -> collectLocalOccsInForm(uri, src, g, fileId, al, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
                            None -> (),
                        };
                        collectLocalOccsInForm(uri, src, arm.body, fileId, al, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
                        if (arm.body.pos.end > cellGet(prevArmEnd)) cellSet(prevArmEnd, arm.body.pos.end) else ();
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExField(base, _) -> collectLocalOccsInForm(uri, src, base, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
        ExTry(inner) -> collectLocalOccsInForm(uri, src, inner, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev),
    }
}

def collectLocalOccsInList(
    uri: String, src: String, fs: List Form, fileId: Int,
    locals: List LocalBind, targetDefSpan: Span, includeDecl: Bool,
    newNameOpt: Option String, conflict: Cell (Option String),
    seen: StrMap Bool, outRev: Cell (List OccSpan)
): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                collectLocalOccsInForm(uri, src, h, fileId, locals, targetDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

// Find all word-boundary occurrences of `ident` in `[lo, hi)` outside comments & string literals.
def findAllIdentsInSpan(src: String, ident: String, lo: Int, hi: Int): List (Int, Int) = {
    let n = strLen(src);
    let nl = strLen(ident);
    let s0 = if (lo < 0) 0 else if (lo > n) n else lo;
    let e0 = if (hi < s0) s0 else if (hi > n) n else hi;
    if (nl == 0 || s0 + nl > e0) Nil
    else {
        let outRev: Cell (List (Int, Int)) = cellNew(Nil);
        let i = cellNew(s0);
        let inStr = cellNew(false);
        let inLineComment = cellNew(false);
        while (cellGet(i) < e0) {
            let idx = cellGet(i);
            let b = strByteAt(src, idx);
            if (cellGet(inLineComment)) {
                if (b == 10) cellSet(inLineComment, false) else ();
                cellSet(i, idx + 1)
            } else if (cellGet(inStr)) {
                if (b == 92 && idx + 1 < e0) {
                    cellSet(i, idx + 2)
                } else {
                    if (b == 34) cellSet(inStr, false) else ();
                    cellSet(i, idx + 1)
                }
            } else if (b == 47 && idx + 1 < e0 && strByteAt(src, idx + 1) == 47) {
                cellSet(inLineComment, true);
                cellSet(i, idx + 2)
            } else if (b == 34) {
                cellSet(inStr, true);
                cellSet(i, idx + 1)
            } else if (idx + nl <= e0 && strStartsWith(strSlice(src, idx, idx + nl), ident)) {
                let leftOk = idx == 0 || !isIdentContByte(strByteAt(src, idx - 1));
                let rightOk = (idx + nl) >= n || !isIdentContByte(strByteAt(src, idx + nl));
                if (leftOk && rightOk) {
                    cellSet(outRev, Cons((idx, idx + nl), cellGet(outRev)));
                    cellSet(i, idx + nl)
                } else {
                    cellSet(i, idx + 1)
                }
            } else {
                cellSet(i, idx + 1)
            }
        };
        listRev(cellGet(outRev))
    }
}

def patContainsCtor(pat: Pattern, targetQn: String): Bool = match pat {
    PatCtor(qn, ps) ->
        if (qn == targetQn) true
        else {
            let cur = cellNew(ps);
            let found = cellNew(false);
            while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(p, r) -> { if (patContainsCtor(p, targetQn)) cellSet(found, true) else (); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
    PatStruct(qn, fs) ->
        if (qn == targetQn) true
        else {
            let cur = cellNew(fs);
            let found = cellNew(false);
            while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons((_, p, _, _), r) -> { if (patContainsCtor(p, targetQn)) cellSet(found, true) else (); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> { if (patContainsCtor(p, targetQn)) cellSet(found, true) else (); cellSet(cur, r) },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

def patContainsStructField(pat: Pattern, inf: InferOutput, targetAdtQn: String, fieldName: String): Bool = match pat {
    PatStruct(qn, fs) -> {
        let matchAdt = match lookupAdtForCtor(inf, qn) {
            Some(an) -> an == targetAdtQn,
            None -> false,
        };
        let cur = cellNew(fs);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((fn, p, _, _), r) -> {
                    if ((matchAdt && fn == fieldName) || patContainsStructField(p, inf, targetAdtQn, fieldName)) {
                        cellSet(found, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    PatCtor(_, ps) -> {
        let cur = cellNew(ps);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> { if (patContainsStructField(p, inf, targetAdtQn, fieldName)) cellSet(found, true) else (); cellSet(cur, r) },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    PatTuple(ps) -> {
        let cur = cellNew(ps);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> { if (patContainsStructField(p, inf, targetAdtQn, fieldName)) cellSet(found, true) else (); cellSet(cur, r) },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

data RenameScope {
    MkRenameScope {
        rsExports: StrMap NameInfo,
        rsItems: List ModuleItem,
        rsAllowUnaliased: Bool,
        rsToks: Vec Token,
    },
}

def dummyEofTok(): Token = MkToken { kind: TkEof, span: MkSpan { fileId: 0, start: 0, end: 0 }, hadNewline: false }

def resolveModAliasInItems(items: List ModuleItem, qual: String): String = {
    let cur = cellNew(items);
    let res = cellNew(qual);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseAlias(segs, al, _) if (al == qual) -> cellSet(res, strJoin(segs, ".")),
                    UseSingle(segs, _) -> {
                        let full = strJoin(segs, ".");
                        if (shortSymName(full) == qual) cellSet(res, full) else ()
                    },
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(res)
}

def findTokIdxForSpanLastIdent(toks: Vec Token, lo: Int, hi: Int): Int = {
    let n = vecLen(toks);
    let d = dummyEofTok();
    let i = cellNew(0);
    let found = cellNew(-1);
    while (cellGet(i) < n) {
        let tok = vecGetOr(toks, cellGet(i), d);
        if (tok.span.start >= hi) {
            cellSet(i, n)
        } else {
            if (tok.span.start >= lo && tok.span.end <= hi) {
                match tok.kind {
                    TkIdent(_) -> cellSet(found, cellGet(i)),
                    _ -> (),
                }
            } else ();
            cellSet(i, cellGet(i) + 1)
        }
    };
    cellGet(found)
}

def findTokIdxForStructCtor(toks: Vec Token, lo: Int, hi: Int): Int = {
    let n = vecLen(toks);
    let d = dummyEofTok();
    let i = cellNew(0);
    let found = cellNew(-1);
    while (cellGet(i) < n) {
        let tok = vecGetOr(toks, cellGet(i), d);
        if (tok.span.start >= hi) {
            cellSet(i, n)
        } else if (tok.span.start >= lo && tok.span.end <= hi) {
            match tok.kind {
                TkLBrace -> cellSet(i, n),
                TkIdent(_) -> {
                    cellSet(found, cellGet(i));
                    cellSet(i, cellGet(i) + 1)
                },
                _ -> cellSet(i, cellGet(i) + 1),
            }
        } else cellSet(i, cellGet(i) + 1)
    };
    cellGet(found)
}

def findAllIdentTokIndicesInSpan(toks: Vec Token, ident: String, lo: Int, hi: Int): List Int = {
    let n = vecLen(toks);
    let d = dummyEofTok();
    let i = cellNew(0);
    let outRev: Cell (List Int) = cellNew(Nil);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let tok = vecGetOr(toks, idx, d);
        if (tok.span.start >= hi) {
            cellSet(i, n)
        } else {
            if (tok.span.start >= lo && tok.span.end <= hi) {
                match tok.kind {
                    TkIdent(nm) if (nm == ident) -> {
                        let followedByDot = if (idx + 1 < n) {
                            match vecGetOr(toks, idx + 1, d).kind { TkDot -> true, _ -> false }
                        } else false;
                        if (!followedByDot) cellSet(outRev, Cons(idx, cellGet(outRev))) else ()
                    },
                    _ -> (),
                }
            } else ();
            cellSet(i, idx + 1)
        }
    };
    listRev(cellGet(outRev))
}

def findTypeTokIndicesInSigHeader(toks: Vec Token, ident: String, lo: Int, hi: Int): List Int = {
    let n = vecLen(toks);
    let d = dummyEofTok();
    let i = cellNew(0);
    let inType = cellNew(false);
    let inParamList = cellNew(false);
    let parenDepth = cellNew(0);
    let outRev: Cell (List Int) = cellNew(Nil);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let tok = vecGetOr(toks, idx, d);
        if (tok.span.start >= hi) {
            cellSet(i, n)
        } else {
            if (tok.span.start >= lo && tok.span.end <= hi) {
                match tok.kind {
                    TkDef -> {
                        cellSet(inType, false);
                        cellSet(inParamList, false);
                        cellSet(parenDepth, 0)
                    },
                    TkLParen -> {
                        if (cellGet(parenDepth) == 0 && !cellGet(inType)) {
                            cellSet(inParamList, true);
                            cellSet(parenDepth, 1);
                            cellSet(inType, false)
                        } else cellSet(parenDepth, cellGet(parenDepth) + 1)
                    },
                    TkRParen -> {
                        if (cellGet(inParamList) && cellGet(parenDepth) == 1) {
                            cellSet(inParamList, false);
                            cellSet(parenDepth, 0);
                            cellSet(inType, false)
                        } else if (cellGet(parenDepth) > 0) {
                            cellSet(parenDepth, cellGet(parenDepth) - 1)
                        } else ()
                    },
                    TkComma -> {
                        if (cellGet(inParamList) && cellGet(parenDepth) == 1) {
                            cellSet(inType, false)
                        } else ()
                    },
                    TkSym(sym) -> {
                        if (sym == ":") cellSet(inType, true)
                        else if (sym == "=" && cellGet(parenDepth) == 0) cellSet(inType, false)
                        else ()
                    },
                    TkIdent(nm) if (nm == ident && cellGet(inType)) -> {
                        let followedByDot = if (idx + 1 < n) {
                            match vecGetOr(toks, idx + 1, d).kind { TkDot -> true, _ -> false }
                        } else false;
                        if (!followedByDot) cellSet(outRev, Cons(idx, cellGet(outRev))) else ()
                    },
                    _ -> (),
                }
            } else ();
            cellSet(i, idx + 1)
        }
    };
    listRev(cellGet(outRev))
}

def findTypeTokIndicesInTypeDecl(toks: Vec Token, ident: String, lo: Int, hi: Int): List Int = {
    let n = vecLen(toks);
    let d = dummyEofTok();
    let i = cellNew(0);
    let outRev: Cell (List Int) = cellNew(Nil);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let tok = vecGetOr(toks, idx, d);
        if (tok.span.start >= hi) {
            cellSet(i, n)
        } else {
            if (tok.span.start >= lo && tok.span.end <= hi) {
                match tok.kind {
                    TkIdent(nm) if (nm == ident) -> {
                        let followedByDotOrColon = if (idx + 1 < n) {
                            match vecGetOr(toks, idx + 1, d).kind {
                                TkDot -> true,
                                TkSym(s) if (s == ":") -> true,
                                _ -> false,
                            }
                        } else false;
                        let precededByDef = if (idx > 0) {
                            match vecGetOr(toks, idx - 1, d).kind { TkDef -> true, _ -> false }
                        } else false;
                        if (!followedByDotOrColon && !precededByDef) cellSet(outRev, Cons(idx, cellGet(outRev))) else ()
                    },
                    _ -> (),
                }
            } else ();
            cellSet(i, idx + 1)
        }
    };
    listRev(cellGet(outRev))
}

def collectPatFieldOccsFromAst(
    pat: Pattern,
    uri: String,
    src: String,
    fileId: Int,
    inf: InferOutput,
    targetField: String,
    targetAdtQn: String,
    newNameOpt: Option String,
    seen: StrMap Bool,
    outRev: Cell (List OccSpan)
): Void = match pat {
    PatWild -> (),
    PatVar(_) -> (),
    PatLit(_) -> (),
    PatTuple(ps) -> {
        let cp = cellNew(ps);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(p, rp) -> {
                    collectPatFieldOccsFromAst(p, uri, src, fileId, inf, targetField, targetAdtQn, newNameOpt, seen, outRev);
                    cellSet(cp, rp)
                },
                Nil -> (),
            }
        }
    },
    PatCtor(_, ps) -> {
        let cp = cellNew(ps);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(p, rp) -> {
                    collectPatFieldOccsFromAst(p, uri, src, fileId, inf, targetField, targetAdtQn, newNameOpt, seen, outRev);
                    cellSet(cp, rp)
                },
                Nil -> (),
            }
        }
    },
    PatStruct(ctorQn, fs) -> {
        let matchesAdt = match lookupAdtForCtor(inf, ctorQn) {
            Some(an) -> an == targetAdtQn,
            None -> false,
        };
        let cf = cellNew(fs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons((fname, subPat, fSp, isShort), rf) -> {
                    if (matchesAdt && fname == targetField && fSp.fileId == fileId && fSp.end > fSp.start) {
                        if (isShort) {
                            match newNameOpt {
                                Some(nn) -> pushOccReplace(seen, outRev, uri, src, fSp.start, fSp.end, nn + ": " + fname),
                                None -> pushOcc(seen, outRev, uri, src, fSp.start, fSp.end),
                            }
                        } else {
                            pushOcc(seen, outRev, uri, src, fSp.start, fSp.end)
                        }
                    } else ();
                    if (!isShort) {
                        collectPatFieldOccsFromAst(subPat, uri, src, fileId, inf, targetField, targetAdtQn, newNameOpt, seen, outRev)
                    } else ();
                    cellSet(cf, rf)
                },
                Nil -> (),
            }
        }
    },
}

def extractQualBeforeTokIdx(toks: Vec Token, idx: Int): Option String = {
    let d = dummyEofTok();
    let j = cellNew(idx - 1);
    let segs: Cell (List String) = cellNew(Nil);
    let sawDot = cellNew(false);
    let done = cellNew(false);
    while (!cellGet(done) && cellGet(j) >= 1) {
        let cur = cellGet(j);
        let isDot = match vecGetOr(toks, cur, d).kind { TkDot -> true, _ -> false };
        if (isDot) {
            match vecGetOr(toks, cur - 1, d).kind {
                TkIdent(seg) -> {
                    cellSet(sawDot, true);
                    cellSet(segs, Cons(seg, cellGet(segs)));
                    cellSet(j, cur - 2)
                },
                _ -> cellSet(done, true),
            }
        } else cellSet(done, true)
    };
    if (cellGet(sawDot)) {
        match cellGet(segs) {
            Nil -> None,
            ss -> Some(strJoin(ss, ".")),
        }
    } else None
}

def allowTokIdxRename(rscope: RenameScope, idx: Int, origName: String, targetQn: String, forRename: Bool): Bool =
    if (!forRename) true
    else match extractQualBeforeTokIdx(rscope.rsToks, idx) {
        Some(qual) -> {
            let canonMod = resolveModAliasInItems(rscope.rsItems, qual);
            modExportsTargetAsOrigName(rscope.rsExports, canonMod, origName, targetQn)
        },
        None -> rscope.rsAllowUnaliased,
    }

def findEnclosingScopeItems(items: List ModuleItem, posStart: Int, posEnd: Int): List ModuleItem = {
    let cur = cellNew(items);
    let res = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModSub(_, _, subItems, subSpan), r) -> {
                if (posStart >= subSpan.start && posEnd <= subSpan.end) {
                    cellSet(res, findEnclosingScopeItems(subItems, posStart, posEnd));
                    cellSet(cur, Nil)
                } else cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(res)
}

def scopeContainsDeclSpan(items: List ModuleItem, declStart: Int, declEnd: Int): Bool = {
    let cur = cellNew(items);
    let found = cellNew(false);
    while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), r) -> {
                if (d.dpos.start == declStart && d.dpos.end == declEnd) cellSet(found, true) else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

def collectTopDefOccsInForm(
    uri: String,
    src: String,
    inf: InferOutput,
    f: Form,
    fileId: Int,
    locals: List LocalBind,
    rscope: RenameScope,
    target: SymTarget,
    targetQn: String,
    newNameOpt: Option String,
    conflict: Cell (Option String),
    seen: StrMap Bool,
    outRev: Cell (List OccSpan)
): Void = {
    let forRename = match newNameOpt { Some(_) -> true, None -> false };
    match f.node {
        ExLit(_) -> (),
        ExVar(qn) ->
            if (f.pos.fileId == fileId) {
                match target.stKind {
                    SkTopDef if (qn == targetQn) -> {
                        let shadowed = match lookupLocalBind(locals, qn) { Some(_) -> true, None -> false };
                        if (!shadowed) {
                            let tidx = findTokIdxForSpanLastIdent(rscope.rsToks, f.pos.start, f.pos.end);
                            if (tidx >= 0) {
                                let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                                let exactNameMatch = match tok.kind { TkIdent(nm) -> nm == target.stName, _ -> false };
                                if (exactNameMatch) {
                                    if (allowTokIdxRename(rscope, tidx, target.stName, targetQn, forRename)) {
                                        match newNameOpt {
                                            Some(nn) if (nn != target.stName) -> match lookupLocalBind(locals, nn) {
                                                Some(_) -> cellSet(conflict, Some("Renaming '" + target.stName + "' to '" + nn + "' would be shadowed by a local binding")),
                                                None -> (),
                                            },
                                            _ -> (),
                                        };
                                        pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                                    } else ()
                                } else if (!forRename) {
                                    // Explicit local alias usage (e.g. `loadA` from `use a.{load as loadA}`):
                                    // include in Find All References, but do not overwrite alias during rename.
                                    pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                                } else ()
                            } else ()
                        } else ()
                    },
                    _ -> (),
                }
            } else (),
        ExField(base, fname) -> {
            collectTopDefOccsInForm(uri, src, inf, base, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            if (f.pos.fileId == fileId) {
                match target.stKind {
                    SkField if (fname == target.stName) ->
                        match headTypeConName(schemeBody(base.ty)) {
                            Some(an) if (an == targetQn) -> {
                                let lo = if (base.pos.end >= f.pos.start) base.pos.end else f.pos.start;
                                let (s, e) = findIdentInSpan(src, fname, lo, f.pos.end);
                                pushOcc(seen, outRev, uri, src, s, e)
                            },
                            _ -> (),
                        },
                    _ -> (),
                }
            } else ()
        },
        ExStructInit(ctorQn, fields) -> {
            if (f.pos.fileId == fileId) {
                match target.stKind {
                    SkTopDef if (ctorQn == targetQn) -> {
                        let tidx = findTokIdxForStructCtor(rscope.rsToks, f.pos.start, f.pos.end);
                        if (tidx >= 0) {
                            let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                            let exactNameMatch = match tok.kind { TkIdent(nm) -> nm == target.stName, _ -> false };
                            if (exactNameMatch) {
                                if (allowTokIdxRename(rscope, tidx, target.stName, targetQn, forRename)) {
                                    pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                                } else ()
                            } else if (!forRename) {
                                pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                            } else ()
                        } else ()
                    },
                    SkField -> {
                        let matchAdt = match lookupAdtForCtor(inf, ctorQn) {
                            Some(an) -> an == targetQn,
                            None -> false,
                        };
                        if (matchAdt) {
                            let prevEnd = cellNew(f.pos.start);
                            let cf = cellNew(fields);
                            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                match cellGet(cf) {
                                    Cons((fn, fv), r) -> {
                                        if (fn == target.stName) {
                                            let hi = if (fv.pos.start > cellGet(prevEnd)) fv.pos.start else f.pos.end;
                                            let (s, e) = findIdentInSpan(src, fn, cellGet(prevEnd), hi);
                                            pushOcc(seen, outRev, uri, src, s, e)
                                        } else ();
                                        if (fv.pos.end > cellGet(prevEnd)) cellSet(prevEnd, fv.pos.end) else ();
                                        cellSet(cf, r)
                                    },
                                    Nil -> (),
                                }
                            }
                        } else ()
                    },
                    _ -> (),
                }
            } else ();
            let cf2 = cellNew(fields);
            while (match cellGet(cf2) { Nil -> false, _ -> true }) {
                match cellGet(cf2) {
                    Cons((_, fv), r) -> {
                        collectTopDefOccsInForm(uri, src, inf, fv, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
                        cellSet(cf2, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExTuple(es) -> collectTopDefOccsInList(uri, src, inf, es, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev),
        ExList(es) -> collectTopDefOccsInList(uri, src, inf, es, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev),
        ExBlock(es) -> collectTopDefOccsInList(uri, src, inf, es, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev),
        ExApply(callee, args) -> {
            collectTopDefOccsInForm(uri, src, inf, callee, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            collectTopDefOccsInList(uri, src, inf, args, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
        },
        ExAbs(ps, _, body) -> {
            let nextLocals = cellNew(locals);
            let cp = cellNew(ps);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(vd, r) -> {
                        cellSet(nextLocals, Cons(MkLocalBind { lbName: vd.vname, lbSpan: f.pos, lbScheme: vd.vscm }, cellGet(nextLocals)));
                        cellSet(cp, r)
                    },
                    Nil -> (),
                }
            };
            collectTopDefOccsInForm(uri, src, inf, body, fileId, cellGet(nextLocals), rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
        },
        ExBin(_, lhs, rhs) -> {
            collectTopDefOccsInForm(uri, src, inf, lhs, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            collectTopDefOccsInForm(uri, src, inf, rhs, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
        },
        ExUn(_, sub) -> collectTopDefOccsInForm(uri, src, inf, sub, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev),
        ExLet(vd, rhs, body) -> {
            collectTopDefOccsInForm(uri, src, inf, rhs, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            let nextLocals = Cons(MkLocalBind { lbName: vd.vname, lbSpan: f.pos, lbScheme: vd.vscm }, locals);
            collectTopDefOccsInForm(uri, src, inf, body, fileId, nextLocals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
        },
        ExIf(c, t, e) -> {
            collectTopDefOccsInForm(uri, src, inf, c, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            collectTopDefOccsInForm(uri, src, inf, t, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            collectTopDefOccsInForm(uri, src, inf, e, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
        },
        ExWhile(c, b) -> {
            collectTopDefOccsInForm(uri, src, inf, c, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            collectTopDefOccsInForm(uri, src, inf, b, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
        },
        ExMatch(scrut, arms) -> {
            collectTopDefOccsInForm(uri, src, inf, scrut, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
            let prevArmEnd = cellNew(if (scrut.pos.end > f.pos.start) scrut.pos.end else f.pos.start);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        let patLo = cellGet(prevArmEnd);
                        let patHi = if (arm.body.pos.start > patLo) arm.body.pos.start else f.pos.end;
                        if (f.pos.fileId == fileId) {
                            match target.stKind {
                                SkTopDef if (patHi > patLo && patContainsCtor(arm.pat, targetQn)) -> {
                                    let occs = findAllIdentTokIndicesInSpan(rscope.rsToks, target.stName, patLo, patHi);
                                    let co = cellNew(occs);
                                    while (match cellGet(co) { Nil -> false, _ -> true }) {
                                        match cellGet(co) {
                                            Cons(tidx, ro) -> {
                                                if (allowTokIdxRename(rscope, tidx, target.stName, targetQn, forRename)) {
                                                    let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                                                    pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                                                } else ();
                                                cellSet(co, ro)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                },
                                SkField ->
                                    collectPatFieldOccsFromAst(arm.pat, uri, src, fileId, inf, target.stName, targetQn, newNameOpt, seen, outRev),
                                _ -> (),
                            }
                        } else ();
                        let patNames: Cell (List String) = cellNew(Nil);
                        collectPatVarNames(arm.pat, patNames);
                        let armLocals = cellNew(locals);
                        let cn = cellNew(cellGet(patNames));
                        while (match cellGet(cn) { Nil -> false, _ -> true }) {
                            match cellGet(cn) {
                                Cons(vn, rn) -> {
                                    cellSet(armLocals, Cons(MkLocalBind { lbName: vn, lbSpan: f.pos, lbScheme: ScmSlot }, cellGet(armLocals)));
                                    cellSet(cn, rn)
                                },
                                Nil -> (),
                            }
                        };
                        let al = cellGet(armLocals);
                        match arm.guard {
                            Some(g) -> collectTopDefOccsInForm(uri, src, inf, g, fileId, al, rscope, target, targetQn, newNameOpt, conflict, seen, outRev),
                            None -> (),
                        };
                        collectTopDefOccsInForm(uri, src, inf, arm.body, fileId, al, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
                        if (arm.body.pos.end > cellGet(prevArmEnd)) cellSet(prevArmEnd, arm.body.pos.end) else ();
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExTry(inner) -> collectTopDefOccsInForm(uri, src, inf, inner, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev),
    }
}

def collectTopDefOccsInList(
    uri: String, src: String, inf: InferOutput, fs: List Form, fileId: Int,
    locals: List LocalBind, rscope: RenameScope, target: SymTarget, targetQn: String,
    newNameOpt: Option String, conflict: Cell (Option String),
    seen: StrMap Bool, outRev: Cell (List OccSpan)
): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                collectTopDefOccsInForm(uri, src, inf, h, fileId, locals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def qnameModulePrefix(qn: String): String = {
    let n = strLen(qn);
    let lastDot = cellNew(-1);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        if (strByteAt(qn, cellGet(i)) == 46) cellSet(lastDot, cellGet(i)) else ();
        cellSet(i, cellGet(i) + 1)
    };
    let ld = cellGet(lastDot);
    if (ld > 0) strSlice(qn, 0, ld) else ""
}

def exportResolvesToTarget(exports: StrMap NameInfo, exportKey: String, targetQn: String): Bool =
    match strMapGet(exports, exportKey) {
        Some(info) -> !info.viaExplicitAlias && info.qualifiedName == targetQn,
        None -> false,
    }

// True iff `modKey` exports `origName` resolving to `targetQn` (either directly or via
// unaliased `pub use` / `pub open` re-export). Stops at any explicit `pub use ... as alias`
// anywhere in the chain, even when `alias == origName`.
def modExportsTargetAsOrigName(exports: StrMap NameInfo, modKey: String, origName: String, targetQn: String): Bool = {
    let targetMod = qnameModulePrefix(targetQn);
    (strLen(targetMod) > 0 && modKey == targetMod)
    || exportResolvesToTarget(exports, modKey + "." + origName, targetQn)
}

def collectUseImportOccsInItems(
    wd: WorkspaceDoc,
    items: List ModuleItem,
    target: SymTarget,
    targetQn: String,
    seen: StrMap Bool,
    outRev: Cell (List OccSpan)
): Void = {
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseSingle(segs, sp) -> {
                        let full = strJoin(segs, ".");
                        let mk = qnameModulePrefix(full);
                        if (shortSymName(full) == target.stName && modExportsTargetAsOrigName(wd.wdExports, mk, target.stName, targetQn)) {
                            pushOcc(seen, outRev, wd.wdUri, wd.wdText, sp.start, sp.end)
                        } else ()
                    },
                    UseAlias(segs, _, sp) -> {
                        let full = strJoin(segs, ".");
                        let mk = qnameModulePrefix(full);
                        if (shortSymName(full) == target.stName && modExportsTargetAsOrigName(wd.wdExports, mk, target.stName, targetQn)) {
                            pushOcc(seen, outRev, wd.wdUri, wd.wdText, sp.start, sp.end)
                        } else ()
                    },
                    UseMulti(modSegs, specs) -> {
                        let modKey = strJoin(modSegs, ".");
                        if (modExportsTargetAsOrigName(wd.wdExports, modKey, target.stName, targetQn)) {
                            let cs = cellNew(specs);
                            while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                match cellGet(cs) {
                                    Cons(sp, rs) -> {
                                        if (sp.orig == target.stName) {
                                            pushOcc(seen, outRev, wd.wdUri, wd.wdText, sp.origSpan.start, sp.origSpan.end)
                                        } else ();
                                        cellSet(cs, rs)
                                    },
                                    Nil -> (),
                                }
                            }
                        } else ()
                    },
                    UseGlob(_) -> (),
                };
                cellSet(cur, r)
            },
            Cons(ModSub(_, _, subItems, _), r) -> {
                collectUseImportOccsInItems(wd, subItems, target, targetQn, seen, outRev);
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    }
}

def collectUseImportOccs(
    wd: WorkspaceDoc,
    target: SymTarget,
    targetQn: String,
    seen: StrMap Bool,
    outRev: Cell (List OccSpan)
): Void = match wd.wdParsed {
    None -> (),
    Some(fm) -> collectUseImportOccsInItems(wd, fm.items, target, targetQn, seen, outRev),
}

def inferModuleExportsName(inf: InferOutput, exports: StrMap NameInfo, modKey: String, symName: String): Bool = {
    let want = modKey + "." + symName;
    if (strMapContains(exports, want)) true
    else {
        let cur = cellNew(inf.defs);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(d, r) -> {
                    if (isPublicVis(d.vis) && (d.ident == want || defHasVariant(d, want) || defHasMethod(d, want))) {
                        cellSet(found, true)
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        if (cellGet(found)) true
        else match builtinModuleSource(modKey) {
            Some(msrc) if (strContains(msrc, symName)) -> match parseFileModuleInFile(msrc, Nil, 0) {
                Ok(fm) -> moduleItemsExportName(fm.items, symName),
                Err(_) -> false,
            },
            _ -> false,
        }
    }
}

def moduleHasBindingNamed(inf: InferOutput, exports: StrMap NameInfo, items: List ModuleItem, name: String, skipDefStart: Int, skipDefEnd: Int): Bool = {
    let cur = cellNew(items);
    let found = cellNew(false);
    while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), r) -> {
                let isSameDef = d.dpos.start == skipDefStart && d.dpos.end == skipDefEnd;
                if (!isSameDef) {
                    if (d.ident == name || defHasVariant(d, name) || defHasMethod(d, name)) {
                        cellSet(found, true)
                    } else ()
                } else {
                    if (d.ident == name || defHasVariant(d, name) || defHasMethod(d, name)) {
                        cellSet(found, true)
                    } else ()
                };
                cellSet(cur, r)
            },
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseSingle(segs, _) ->
                        if (shortSymName(strJoin(segs, ".")) == name) cellSet(found, true) else (),
                    UseAlias(_, al, _) ->
                        if (al == name) cellSet(found, true) else (),
                    UseMulti(_, specs) -> {
                        let cs = cellNew(specs);
                        while (!cellGet(found) && match cellGet(cs) { Nil -> false, _ -> true }) {
                            match cellGet(cs) {
                                Cons(sp, rs) -> {
                                    if (useSpecLocalName(sp) == name) cellSet(found, true) else ();
                                    cellSet(cs, rs)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    UseGlob(segs) ->
                        if (inferModuleExportsName(inf, exports, strJoin(segs, "."), name)) cellSet(found, true) else (),
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

def docImportsTargetUnaliased(exports: StrMap NameInfo, items: List ModuleItem, targetQn: String, origName: String): Bool = {
    let cur = cellNew(items);
    let found = cellNew(false);
    while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseSingle(segs, _) -> {
                        let full = strJoin(segs, ".");
                        let mk = qnameModulePrefix(full);
                        if (shortSymName(full) == origName && modExportsTargetAsOrigName(exports, mk, origName, targetQn)) {
                            cellSet(found, true)
                        } else ()
                    },
                    UseGlob(segs) -> {
                        let mk = strJoin(segs, ".");
                        if (modExportsTargetAsOrigName(exports, mk, origName, targetQn)) {
                            cellSet(found, true)
                        } else ()
                    },
                    UseMulti(modSegs, specs) -> {
                        let mk = strJoin(modSegs, ".");
                        if (modExportsTargetAsOrigName(exports, mk, origName, targetQn)) {
                            let cs = cellNew(specs);
                            while (!cellGet(found) && match cellGet(cs) { Nil -> false, _ -> true }) {
                                match cellGet(cs) {
                                    Cons(sp, rs) -> {
                                        if (sp.orig == origName && match sp.alias { None -> true, Some(_) -> false }) {
                                            cellSet(found, true)
                                        } else ();
                                        cellSet(cs, rs)
                                    },
                                    Nil -> (),
                                }
                            }
                        } else ()
                    },
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

def checkScopeUnaliasedImportConflict(inf: InferOutput, exports: StrMap NameInfo, items: List ModuleItem, targetQn: String, origName: String, newName: String): Bool = {
    if (docImportsTargetUnaliased(exports, items, targetQn, origName) && moduleHasBindingNamed(inf, exports, items, newName, -1, -1)) {
        true
    } else {
        let cur = cellNew(items);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(ModSub(_, _, subItems, _), r) -> {
                    if (checkScopeUnaliasedImportConflict(inf, exports, subItems, targetQn, origName, newName)) {
                        cellSet(found, true)
                    } else ();
                    cellSet(cur, r)
                },
                Cons(_, r) -> cellSet(cur, r),
                Nil -> (),
            }
        };
        cellGet(found)
    }
}

def collectTypeAnnotOccsInForm(
    uri: String, src: String, f: Form, fileId: Int, rscope: RenameScope,
    typeName: String, targetQn: String, forRename: Bool,
    seen: StrMap Bool, outRev: Cell (List OccSpan)
): Void = {
    if (f.pos.fileId != fileId) ()
    else match f.node {
        ExLet(vd, rhs, body) -> {
            let bindEnd = if (rhs.pos.start > f.pos.start) rhs.pos.start else f.pos.end;
            let (_, be) = findIdentInSpan(src, vd.vname, f.pos.start, bindEnd);
            if (be > f.pos.start && hasColonBeforeEq(src, be, bindEnd)) {
                let occs = findAllIdentTokIndicesInSpan(rscope.rsToks, typeName, be, bindEnd);
                let co = cellNew(occs);
                while (match cellGet(co) { Nil -> false, _ -> true }) {
                    match cellGet(co) {
                        Cons(tidx, ro) -> {
                            if (allowTokIdxRename(rscope, tidx, typeName, targetQn, forRename)) {
                                let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                                pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                            } else ();
                            cellSet(co, ro)
                        },
                        Nil -> (),
                    }
                }
            } else ();
            collectTypeAnnotOccsInForm(uri, src, rhs, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            collectTypeAnnotOccsInForm(uri, src, body, fileId, rscope, typeName, targetQn, forRename, seen, outRev)
        },
        ExAbs(_, _, body) -> {
            if (body.pos.start > f.pos.start) {
                let occs = findTypeTokIndicesInSigHeader(rscope.rsToks, typeName, f.pos.start, body.pos.start);
                let co = cellNew(occs);
                while (match cellGet(co) { Nil -> false, _ -> true }) {
                    match cellGet(co) {
                        Cons(tidx, ro) -> {
                            if (allowTokIdxRename(rscope, tidx, typeName, targetQn, forRename)) {
                                let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                                pushOcc(seen, outRev, uri, src, tok.span.start, tok.span.end)
                            } else ();
                            cellSet(co, ro)
                        },
                        Nil -> (),
                    }
                }
            } else ();
            collectTypeAnnotOccsInForm(uri, src, body, fileId, rscope, typeName, targetQn, forRename, seen, outRev)
        },
        ExTuple(es) -> collectTypeAnnotOccsInList(uri, src, es, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
        ExList(es) -> collectTypeAnnotOccsInList(uri, src, es, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
        ExBlock(es) -> collectTypeAnnotOccsInList(uri, src, es, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
        ExStructInit(_, fs) -> {
            let cf = cellNew(fs);
            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons((_, fv), r) -> { collectTypeAnnotOccsInForm(uri, src, fv, fileId, rscope, typeName, targetQn, forRename, seen, outRev); cellSet(cf, r) },
                    Nil -> (),
                }
            }
        },
        ExApply(c, args) -> {
            collectTypeAnnotOccsInForm(uri, src, c, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            collectTypeAnnotOccsInList(uri, src, args, fileId, rscope, typeName, targetQn, forRename, seen, outRev)
        },
        ExBin(_, l, r) -> {
            collectTypeAnnotOccsInForm(uri, src, l, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            collectTypeAnnotOccsInForm(uri, src, r, fileId, rscope, typeName, targetQn, forRename, seen, outRev)
        },
        ExUn(_, s) -> collectTypeAnnotOccsInForm(uri, src, s, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
        ExIf(c, t, e) -> {
            collectTypeAnnotOccsInForm(uri, src, c, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            collectTypeAnnotOccsInForm(uri, src, t, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            collectTypeAnnotOccsInForm(uri, src, e, fileId, rscope, typeName, targetQn, forRename, seen, outRev)
        },
        ExWhile(c, b) -> {
            collectTypeAnnotOccsInForm(uri, src, c, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            collectTypeAnnotOccsInForm(uri, src, b, fileId, rscope, typeName, targetQn, forRename, seen, outRev)
        },
        ExMatch(scrut, arms) -> {
            collectTypeAnnotOccsInForm(uri, src, scrut, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        match arm.guard {
                            Some(g) -> collectTypeAnnotOccsInForm(uri, src, g, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
                            None -> (),
                        };
                        collectTypeAnnotOccsInForm(uri, src, arm.body, fileId, rscope, typeName, targetQn, forRename, seen, outRev);
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExField(base, _) -> collectTypeAnnotOccsInForm(uri, src, base, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
        ExTry(inner) -> collectTypeAnnotOccsInForm(uri, src, inner, fileId, rscope, typeName, targetQn, forRename, seen, outRev),
        ExLit(_) -> (),
        ExVar(_) -> (),
    }
}

def collectTypeAnnotOccsInList(
    uri: String, src: String, fs: List Form, fileId: Int, rscope: RenameScope,
    typeName: String, targetQn: String, forRename: Bool,
    seen: StrMap Bool, outRev: Cell (List OccSpan)
): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> { collectTypeAnnotOccsInForm(uri, src, h, fileId, rscope, typeName, targetQn, forRename, seen, outRev); cellSet(cur, r) },
            Nil -> (),
        }
    }
}

def collectTypeOccsInDef(
    wd: WorkspaceDoc, d: Def, rscope: RenameScope, target: SymTarget, targetQn: String,
    includeDecl: Bool, forRename: Bool,
    seen: StrMap Bool, outRev: Cell (List OccSpan)
): Void = {
    let isDeclSelf = wd.wdCanon == target.stDeclCanon && d.dpos.start == target.stDeclDefStart && d.dpos.end == target.stDeclDefEnd;
    let (declS, declE) = if (isDeclSelf) findIdentInSpan(wd.wdText, target.stName, d.dpos.start, d.dpos.end) else (-1, -1);
    match d.item {
        ItForm(f) -> {
            let bodyStart = match f.node {
                ExAbs(_, _, body) -> if (body.pos.start > d.dpos.start) body.pos.start else d.dpos.end,
                _ -> if (f.pos.start > d.dpos.start) f.pos.start else d.dpos.end,
            };
            let occs = findTypeTokIndicesInSigHeader(rscope.rsToks, target.stName, d.dpos.start, bodyStart);
            let co = cellNew(occs);
            while (match cellGet(co) { Nil -> false, _ -> true }) {
                match cellGet(co) {
                    Cons(tidx, ro) -> {
                        if (allowTokIdxRename(rscope, tidx, target.stName, targetQn, forRename)) {
                            let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                            pushOcc(seen, outRev, wd.wdUri, wd.wdText, tok.span.start, tok.span.end)
                        } else ();
                        cellSet(co, ro)
                    },
                    Nil -> (),
                }
            };
            collectTypeAnnotOccsInForm(wd.wdUri, wd.wdText, f, wd.wdFileId, rscope, target.stName, targetQn, forRename, seen, outRev)
        },
        ItInstance(_, _, _, impls) -> {
            let headEnd = match strIndexOfByte(wd.wdText, 123, d.dpos.start) {
                Some(ob) if (ob < d.dpos.end) -> ob,
                _ -> d.dpos.end,
            };
            let occs = findAllIdentTokIndicesInSpan(rscope.rsToks, target.stName, d.dpos.start, headEnd);
            let co = cellNew(occs);
            while (match cellGet(co) { Nil -> false, _ -> true }) {
                match cellGet(co) {
                    Cons(tidx, ro) -> {
                        if (allowTokIdxRename(rscope, tidx, target.stName, targetQn, forRename)) {
                            let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                            pushOcc(seen, outRev, wd.wdUri, wd.wdText, tok.span.start, tok.span.end)
                        } else ();
                        cellSet(co, ro)
                    },
                    Nil -> (),
                }
            };
            let ci = cellNew(impls);
            while (match cellGet(ci) { Nil -> false, _ -> true }) {
                match cellGet(ci) {
                    Cons(mi, ri) -> {
                        collectTypeAnnotOccsInForm(wd.wdUri, wd.wdText, mi.implBody, wd.wdFileId, rscope, target.stName, targetQn, forRename, seen, outRev);
                        cellSet(ci, ri)
                    },
                    Nil -> (),
                }
            }
        },
        _ -> {
            let occs = findTypeTokIndicesInTypeDecl(rscope.rsToks, target.stName, d.dpos.start, d.dpos.end);
            let co = cellNew(occs);
            while (match cellGet(co) { Nil -> false, _ -> true }) {
                match cellGet(co) {
                    Cons(tidx, ro) -> {
                        let tok = vecGetOr(rscope.rsToks, tidx, dummyEofTok());
                        let isHeaderToken = isDeclSelf && tok.span.start == declS && tok.span.end == declE;
                        if ((!isHeaderToken || includeDecl) && (isHeaderToken || allowTokIdxRename(rscope, tidx, target.stName, targetQn, forRename))) {
                            pushOcc(seen, outRev, wd.wdUri, wd.wdText, tok.span.start, tok.span.end)
                        } else ();
                        cellSet(co, ro)
                    },
                    Nil -> (),
                }
            }
        },
    }
}

def collectSymbolOccurrences(
    ss: ServerState,
    currentDoc: DocState,
    target: SymTarget,
    includeDecl: Bool,
    newNameOpt: Option String,
    conflict: Cell (Option String)
): List OccSpan = {
    let seen: StrMap Bool = strMapNew();
    let outRev: Cell (List OccSpan) = cellNew(Nil);
    match target.stKind {
        SkLocal -> match currentDoc.dsInfer {
            None -> Nil,
            Some(inf) -> {
                let cur = cellNew(inf.defs);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(d, r) -> {
                            if (d.dpos.fileId == currentDoc.dsFileId) {
                                match d.item {
                                    ItForm(f) -> {
                                        let defLocals: List LocalBind = match f.node {
                                            ExAbs(ps, _, body) -> {
                                                let headEnd = if (body.pos.start > d.dpos.start) body.pos.start else d.dpos.end;
                                                let acc = cellNew(Nil);
                                                let targetInParams = cellNew(false);
                                                let cp = cellNew(ps);
                                                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                                    match cellGet(cp) {
                                                        Cons(vd, rp) -> {
                                                            let bsp = locateBinderSpan(currentDoc.dsText, currentDoc.dsFileId, vd.vname, d.dpos.start, headEnd);
                                                            if (spanEq(bsp, target.stDefSpan)) {
                                                                cellSet(targetInParams, true);
                                                                if (includeDecl) pushOcc(seen, outRev, currentDoc.dsUri, currentDoc.dsText, bsp.start, bsp.end) else ()
                                                            } else ();
                                                            cellSet(acc, Cons(MkLocalBind { lbName: vd.vname, lbSpan: bsp, lbScheme: vd.vscm }, cellGet(acc)));
                                                            cellSet(cp, rp)
                                                        },
                                                        Nil -> (),
                                                    }
                                                };
                                                if (cellGet(targetInParams)) {
                                                    match newNameOpt {
                                                        Some(nn) -> {
                                                            let cp2 = cellNew(ps);
                                                            while (match cellGet(cp2) { Nil -> false, _ -> true }) {
                                                                match cellGet(cp2) {
                                                                    Cons(vd, rp) -> {
                                                                        let bsp = locateBinderSpan(currentDoc.dsText, currentDoc.dsFileId, vd.vname, d.dpos.start, headEnd);
                                                                        if (!spanEq(bsp, target.stDefSpan) && vd.vname == nn) {
                                                                            cellSet(conflict, Some("Duplicate parameter name '" + nn + "' in scope"))
                                                                        } else ();
                                                                        cellSet(cp2, rp)
                                                                    },
                                                                    Nil -> (),
                                                                }
                                                            }
                                                        },
                                                        None -> (),
                                                    }
                                                } else ();
                                                cellGet(acc)
                                            },
                                            _ -> Nil,
                                        };
                                        collectLocalOccsInForm(currentDoc.dsUri, currentDoc.dsText, f, currentDoc.dsFileId, defLocals, target.stDefSpan, includeDecl, newNameOpt, conflict, seen, outRev)
                                    },
                                    ItInstance(_, _, _, impls) -> {
                                        let ci = cellNew(impls);
                                        while (match cellGet(ci) { Nil -> false, _ -> true }) {
                                            match cellGet(ci) {
                                                Cons(mi, ri) -> {
                                                    collectLocalOccsInForm(currentDoc.dsUri, currentDoc.dsText, mi.implBody, currentDoc.dsFileId, Nil, target.stDefSpan, includeDecl, newNameOpt, conflict, seen, outRev);
                                                    cellSet(ci, ri)
                                                },
                                                Nil -> (),
                                            }
                                        }
                                    },
                                    _ -> (),
                                }
                            } else ();
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                listRev(cellGet(outRev))
            },
        },
        _ -> {
            let wDocs = collectWorkspaceDocsForTarget(ss, currentDoc, target.stName, target.stDeclCanon);
            let cw = cellNew(wDocs);
            while (match cellGet(cw) { Nil -> false, _ -> true }) {
                match cellGet(cw) {
                    Cons(wd, rw) -> {
                        match (wd.wdInfer, findTargetQNameInDoc(wd, target)) {
                            (Some(inf), Some(targetQn)) -> {
                                // Check for top-level / field name collision when renaming
                                match newNameOpt {
                                    Some(nn) if (nn != target.stName) -> match target.stKind {
                                        SkTopDef -> match wd.wdParsed {
                                            Some(fm) ->
                                                if (wd.wdCanon == target.stDeclCanon) {
                                                    if (moduleHasBindingNamed(inf, wd.wdExports, fm.items, nn, target.stDeclDefStart, target.stDeclDefEnd)) {
                                                        cellSet(conflict, Some("Symbol '" + nn + "' already exists in this module"))
                                                    } else ()
                                                } else if (checkScopeUnaliasedImportConflict(inf, wd.wdExports, fm.items, targetQn, target.stName, nn)) {
                                                    cellSet(conflict, Some("Renaming to '" + nn + "' conflicts with an existing binding in '" + wd.wdPath + "'"))
                                                } else (),
                                            None -> (),
                                        },
                                        SkField if (wd.wdCanon == target.stDeclCanon) ->
                                            match lookupDefExact(inf.defs, targetQn) {
                                                Some(adtDef) if (defHasStructField(adtDef, nn)) ->
                                                    cellSet(conflict, Some("Field '" + nn + "' already exists on type '" + shortSymName(targetQn) + "'")),
                                                _ -> (),
                                            },
                                        _ -> (),
                                    },
                                    _ -> (),
                                };

                                // Declaration site in declaring file
                                if (includeDecl && wd.wdCanon == target.stDeclCanon) {
                                    let (ds, de) = findIdentInSpan(wd.wdText, target.stName, target.stDeclDefStart, target.stDeclDefEnd);
                                    pushOcc(seen, outRev, wd.wdUri, wd.wdText, ds, de)
                                } else ();

                                // Import sites (`use ...`) for SkTopDef
                                match target.stKind {
                                    SkTopDef -> collectUseImportOccs(wd, target, targetQn, seen, outRev),
                                    _ -> (),
                                };

                                // Expression, pattern, and type-annotation sites in `wd.wdFileId`
                                let forRenDoc = match newNameOpt { Some(_) -> true, None -> false };
                                let wdToks = match tokenizeInFile(wd.wdText, wd.wdFileId) {
                                    Ok(tv) -> tv,
                                    Err(_) -> vecNew(),
                                };
                                let cd = cellNew(inf.defs);
                                while (match cellGet(cd) { Nil -> false, _ -> true }) {
                                    match cellGet(cd) {
                                        Cons(d, rd) -> {
                                            if (d.dpos.fileId == wd.wdFileId) {
                                                let scopeItems = match wd.wdParsed {
                                                    Some(fm) -> findEnclosingScopeItems(fm.items, d.dpos.start, d.dpos.end),
                                                    None -> Nil,
                                                };
                                                let allowUnaliased =
                                                    (wd.wdCanon == target.stDeclCanon && scopeContainsDeclSpan(scopeItems, target.stDeclDefStart, target.stDeclDefEnd))
                                                    || docImportsTargetUnaliased(wd.wdExports, scopeItems, targetQn, target.stName);
                                                let rscope = MkRenameScope {
                                                    rsExports: wd.wdExports,
                                                    rsItems: scopeItems,
                                                    rsAllowUnaliased: allowUnaliased,
                                                    rsToks: wdToks,
                                                };
                                                // If target is a type/concept, scan AST type-annotation & declaration regions (per-site alias check)
                                                if (target.stIsType) {
                                                    collectTypeOccsInDef(wd, d, rscope, target, targetQn, includeDecl, forRenDoc, seen, outRev)
                                                } else ();
                                                match d.item {
                                                    ItForm(f) -> {
                                                        let defLocals: List LocalBind = match f.node {
                                                            ExAbs(ps, _, _) -> {
                                                                let acc = cellNew(Nil);
                                                                let cp = cellNew(ps);
                                                                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                                                    match cellGet(cp) {
                                                                        Cons(vd, rp) -> {
                                                                            cellSet(acc, Cons(MkLocalBind { lbName: vd.vname, lbSpan: d.dpos, lbScheme: vd.vscm }, cellGet(acc)));
                                                                            cellSet(cp, rp)
                                                                        },
                                                                        Nil -> (),
                                                                    }
                                                                };
                                                                cellGet(acc)
                                                            },
                                                            _ -> Nil,
                                                        };
                                                        collectTopDefOccsInForm(wd.wdUri, wd.wdText, inf, f, wd.wdFileId, defLocals, rscope, target, targetQn, newNameOpt, conflict, seen, outRev)
                                                    },
                                                    ItInstance(_, _, _, impls) -> {
                                                        let ci = cellNew(impls);
                                                        while (match cellGet(ci) { Nil -> false, _ -> true }) {
                                                            match cellGet(ci) {
                                                                Cons(mi, ri) -> {
                                                                    collectTopDefOccsInForm(wd.wdUri, wd.wdText, inf, mi.implBody, wd.wdFileId, Nil, rscope, target, targetQn, newNameOpt, conflict, seen, outRev);
                                                                    cellSet(ci, ri)
                                                                },
                                                                Nil -> (),
                                                            }
                                                        }
                                                    },
                                                    _ -> (),
                                                }
                                            } else ();
                                            cellSet(cd, rd)
                                        },
                                        Nil -> (),
                                    }
                                }
                            },
                            _ -> (),
                        };
                        cellSet(cw, rw)
                    },
                    Nil -> (),
                }
            };
            listRev(cellGet(outRev))
        },
    }
}

def handleReferences(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    let includeDecl = match objGet(params, "context") {
        Some(ctx) -> match objGetBool(ctx, "includeDeclaration") {
            Some(b) -> b,
            None -> true,
        },
        None -> true,
    };
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                match resolveTargetAtOffset(doc, off) {
                    None -> VArr(Nil),
                    Some((target, _, _)) -> {
                        let noConflict: Cell (Option String) = cellNew(None);
                        let occs = collectSymbolOccurrences(ss, doc, target, includeDecl, None, noConflict);
                        let locsRev: Cell (List Value) = cellNew(Nil);
                        let co = cellNew(occs);
                        while (match cellGet(co) { Nil -> false, _ -> true }) {
                            match cellGet(co) {
                                Cons(occ, r) -> {
                                    cellSet(locsRev, Cons(VObj([
                                        ("uri", VStr(occ.occUri)),
                                        ("range", makeLspRange(occ.occText, occ.occStart, occ.occEnd)),
                                    ]), cellGet(locsRev)));
                                    cellSet(co, r)
                                },
                                Nil -> (),
                            }
                        };
                        VArr(listRev(cellGet(locsRev)))
                    },
                }
            },
            _ -> VArr(Nil),
        },
        _ -> VArr(Nil),
    }
}

def handlePrepareRename(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    match (uriOpt, posOpt) {
        (Some(uri), Some(pos)) -> match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
            (Some(doc), Some(line), Some(ch)) -> {
                let off = lspPosToOffset(doc.dsText, line, ch);
                match resolveTargetAtOffset(doc, off) {
                    Some((target, ws, we)) if (target.stRenameable) ->
                        VObj([
                            ("range", makeLspRange(doc.dsText, ws, we)),
                            ("placeholder", VStr(target.stName)),
                        ]),
                    _ -> VNull,
                }
            },
            _ -> VNull,
        },
        _ -> VNull,
    }
}

def handleRename(ss: ServerState, params: Value): Result Value (Int, String) = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let posOpt = objGet(params, "position");
    let newNameOpt = objGetStr(params, "newName");
    match (uriOpt, posOpt, newNameOpt) {
        (Some(uri), Some(pos), Some(newName)) ->
            if (!isValidGeishaIdent(newName)) {
                Err((-32602, "Invalid identifier name for rename: '" + newName + "'"))
            } else {
                match (strMapGet(ss.ssDocs, uri), objGetInt(pos, "line"), objGetInt(pos, "character")) {
                    (Some(doc), Some(line), Some(ch)) -> {
                        let off = lspPosToOffset(doc.dsText, line, ch);
                        match resolveTargetAtOffset(doc, off) {
                            Some((target, _, _)) if (target.stRenameable) -> {
                                let conflict: Cell (Option String) = cellNew(None);
                                let occs = collectSymbolOccurrences(ss, doc, target, true, Some(newName), conflict);
                                match cellGet(conflict) {
                                    Some(cmsg) -> Err((-32602, cmsg)),
                                    None -> {
                                        // Group TextEdits by URI
                                        let byUri: StrMap (List Value) = strMapNew();
                                        let urisRev: Cell (List String) = cellNew(Nil);
                                        let co = cellNew(occs);
                                        while (match cellGet(co) { Nil -> false, _ -> true }) {
                                            match cellGet(co) {
                                                Cons(occ, r) -> {
                                                    let editText = match occ.occReplace { Some(rep) -> rep, None -> newName };
                                                    let edit = VObj([
                                                        ("range", makeLspRange(occ.occText, occ.occStart, occ.occEnd)),
                                                        ("newText", VStr(editText)),
                                                    ]);
                                                    match strMapGet(byUri, occ.occUri) {
                                                        Some(prev) -> strMapInsert(byUri, occ.occUri, Cons(edit, prev)),
                                                        None -> {
                                                            strMapInsert(byUri, occ.occUri, [edit]);
                                                            cellSet(urisRev, Cons(occ.occUri, cellGet(urisRev)))
                                                        },
                                                    };
                                                    cellSet(co, r)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        let changeFieldsRev: Cell (List (String, Value)) = cellNew(Nil);
                                        let cu = cellNew(listRev(cellGet(urisRev)));
                                        while (match cellGet(cu) { Nil -> false, _ -> true }) {
                                            match cellGet(cu) {
                                                Cons(u, ru) -> {
                                                    let edits = match strMapGet(byUri, u) {
                                                        Some(es) -> listRev(es),
                                                        None -> Nil,
                                                    };
                                                    cellSet(changeFieldsRev, Cons((u, VArr(edits)), cellGet(changeFieldsRev)));
                                                    cellSet(cu, ru)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        Ok(VObj([("changes", VObj(listRev(cellGet(changeFieldsRev))))]))
                                    },
                                }
                            },
                            _ -> Err((-32602, "Cannot rename symbol at this position")),
                        }
                    },
                    _ -> Ok(VNull),
                }
            },
        _ -> Err((-32602, "Missing required parameters for textDocument/rename")),
    }
}

// ============================================================================
// Inlay Hints (`textDocument/inlayHint`)
// ============================================================================

def hasColonBeforeEq(src: String, startOff: Int, endOff: Int): Bool = {
    let n = strLen(src);
    let s = if (startOff < 0) 0 else if (startOff > n) n else startOff;
    let e = if (endOff < s) s else if (endOff > n) n else endOff;
    let i = cellNew(s);
    let foundColon = cellNew(false);
    let done = cellNew(false);
    while (cellGet(i) < e && !cellGet(done)) {
        let b = strByteAt(src, cellGet(i));
        if (b == 58) {
            cellSet(foundColon, true);
            cellSet(done, true)
        } else if (b == 61) {
            cellSet(done, true)
        } else ();
        cellSet(i, cellGet(i) + 1)
    };
    cellGet(foundColon)
}

def makeInlayHint(src: String, byteOff: Int, label: String, kind: Int, padRight: Bool): Value = {
    let (l, c) = offsetToLspPos(src, byteOff);
    VObj([
        ("position", makeLspPos(l, c)),
        ("label", VStr(label)),
        ("kind", VInt(intToI64(kind))),
        ("paddingLeft", VBool(false)),
        ("paddingRight", VBool(padRight)),
    ])
}

def collectInlayHintsInForm(
    src: String,
    inf: InferOutput,
    f: Form,
    fileId: Int,
    reqStart: Int,
    reqEnd: Int,
    outRev: Cell (List Value)
): Void = {
    if (f.pos.fileId != fileId || f.pos.end < reqStart || f.pos.start > reqEnd) ()
    else match f.node {
        ExLit(_) -> (),
        ExVar(_) -> (),
        ExTuple(es) -> collectInlayHintsInList(src, inf, es, fileId, reqStart, reqEnd, outRev),
        ExList(es) -> collectInlayHintsInList(src, inf, es, fileId, reqStart, reqEnd, outRev),
        ExBlock(es) -> collectInlayHintsInList(src, inf, es, fileId, reqStart, reqEnd, outRev),
        ExStructInit(_, fields) -> {
            let cf = cellNew(fields);
            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons((_, fv), r) -> {
                        collectInlayHintsInForm(src, inf, fv, fileId, reqStart, reqEnd, outRev);
                        cellSet(cf, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExApply(callee, args) -> {
            collectInlayHintsInForm(src, inf, callee, fileId, reqStart, reqEnd, outRev);
            // Parameter name hints for direct calls to user-defined functions
            match callee.node {
                ExVar(qname) -> match lookupDefExact(inf.defs, qname) {
                    Some(d) -> match d.item {
                        ItForm(df) -> match df.node {
                            ExAbs(ps, _, _) -> {
                                let cp = cellNew(ps);
                                let ca = cellNew(args);
                                while (match cellGet(cp) { Nil -> false, _ -> true } && match cellGet(ca) { Nil -> false, _ -> true }) {
                                    match (cellGet(cp), cellGet(ca)) {
                                        (Cons(vd, rp), Cons(arg, ra)) -> {
                                            if (vd.vname != "_" && !strStartsWith(vd.vname, "__")
                                                && arg.pos.fileId == fileId
                                                && arg.pos.start >= reqStart && arg.pos.start <= reqEnd) {
                                                let sameAsVar = match arg.node {
                                                    ExVar(an) -> shortSymName(an) == vd.vname,
                                                    _ -> false,
                                                };
                                                if (!sameAsVar) {
                                                    cellSet(outRev, Cons(makeInlayHint(src, arg.pos.start, vd.vname + ":", 2, true), cellGet(outRev)))
                                                } else ()
                                            } else ();
                                            cellSet(cp, rp);
                                            cellSet(ca, ra)
                                        },
                                        _ -> (),
                                    }
                                }
                            },
                            _ -> (),
                        },
                        _ -> (),
                    },
                    None -> (),
                },
                _ -> (),
            };
            collectInlayHintsInList(src, inf, args, fileId, reqStart, reqEnd, outRev)
        },
        ExAbs(_, _, body) -> collectInlayHintsInForm(src, inf, body, fileId, reqStart, reqEnd, outRev),
        ExBin(_, lhs, rhs) -> {
            collectInlayHintsInForm(src, inf, lhs, fileId, reqStart, reqEnd, outRev);
            collectInlayHintsInForm(src, inf, rhs, fileId, reqStart, reqEnd, outRev)
        },
        ExUn(_, sub) -> collectInlayHintsInForm(src, inf, sub, fileId, reqStart, reqEnd, outRev),
        ExLet(vd, rhs, body) -> {
            if (vd.vname != "_" && !strStartsWith(vd.vname, "__")) {
                let bindEnd = if (rhs.pos.start > f.pos.start) rhs.pos.start else f.pos.end;
                let (bs, be) = findIdentInSpan(src, vd.vname, f.pos.start, bindEnd);
                if (be > bs && be >= reqStart && be <= reqEnd && !hasColonBeforeEq(src, be, bindEnd)) {
                    let tyScm = match rhs.ty { ScmSlot -> vd.vscm, sc -> sc };
                    let tyStr = formatScheme(tyScm);
                    if (strLen(tyStr) > 0 && tyStr != "?") {
                        cellSet(outRev, Cons(makeInlayHint(src, be, ": " + tyStr, 1, false), cellGet(outRev)))
                    } else ()
                } else ()
            } else ();
            collectInlayHintsInForm(src, inf, rhs, fileId, reqStart, reqEnd, outRev);
            collectInlayHintsInForm(src, inf, body, fileId, reqStart, reqEnd, outRev)
        },
        ExIf(c, t, e) -> {
            collectInlayHintsInForm(src, inf, c, fileId, reqStart, reqEnd, outRev);
            collectInlayHintsInForm(src, inf, t, fileId, reqStart, reqEnd, outRev);
            collectInlayHintsInForm(src, inf, e, fileId, reqStart, reqEnd, outRev)
        },
        ExWhile(c, b) -> {
            collectInlayHintsInForm(src, inf, c, fileId, reqStart, reqEnd, outRev);
            collectInlayHintsInForm(src, inf, b, fileId, reqStart, reqEnd, outRev)
        },
        ExMatch(scrut, arms) -> {
            collectInlayHintsInForm(src, inf, scrut, fileId, reqStart, reqEnd, outRev);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        match arm.guard {
                            Some(g) -> collectInlayHintsInForm(src, inf, g, fileId, reqStart, reqEnd, outRev),
                            None -> (),
                        };
                        collectInlayHintsInForm(src, inf, arm.body, fileId, reqStart, reqEnd, outRev);
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExField(base, _) -> collectInlayHintsInForm(src, inf, base, fileId, reqStart, reqEnd, outRev),
        ExTry(inner) -> collectInlayHintsInForm(src, inf, inner, fileId, reqStart, reqEnd, outRev),
    }
}

def collectInlayHintsInList(
    src: String, inf: InferOutput, fs: List Form, fileId: Int,
    reqStart: Int, reqEnd: Int, outRev: Cell (List Value)
): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                collectInlayHintsInForm(src, inf, h, fileId, reqStart, reqEnd, outRev);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def handleInlayHint(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let rangeOpt = objGet(params, "range");
    match uriOpt {
        Some(uri) -> match strMapGet(ss.ssDocs, uri) {
            Some(doc) -> match doc.dsInfer {
                None -> VArr(Nil),
                Some(inf) -> {
                    let (reqStart, reqEnd) = match rangeOpt {
                        Some(rng) -> match (objGet(rng, "start"), objGet(rng, "end")) {
                            (Some(sp), Some(ep)) -> match (objGetInt(sp, "line"), objGetInt(sp, "character"), objGetInt(ep, "line"), objGetInt(ep, "character")) {
                                (Some(sl), Some(sc), Some(el), Some(ec)) ->
                                    (lspPosToOffset(doc.dsText, sl, sc), lspPosToOffset(doc.dsText, el, ec)),
                                _ -> (0, strLen(doc.dsText)),
                            },
                            _ -> (0, strLen(doc.dsText)),
                        },
                        None -> (0, strLen(doc.dsText)),
                    };
                    let hintsRev: Cell (List Value) = cellNew(Nil);
                    let cd = cellNew(inf.defs);
                    while (match cellGet(cd) { Nil -> false, _ -> true }) {
                        match cellGet(cd) {
                            Cons(d, r) -> {
                                if (d.dpos.fileId == doc.dsFileId) {
                                    match d.item {
                                        ItForm(f) -> collectInlayHintsInForm(doc.dsText, inf, f, doc.dsFileId, reqStart, reqEnd, hintsRev),
                                        ItInstance(_, _, _, impls) -> {
                                            let ci = cellNew(impls);
                                            while (match cellGet(ci) { Nil -> false, _ -> true }) {
                                                match cellGet(ci) {
                                                    Cons(mi, ri) -> {
                                                        collectInlayHintsInForm(doc.dsText, inf, mi.implBody, doc.dsFileId, reqStart, reqEnd, hintsRev);
                                                        cellSet(ci, ri)
                                                    },
                                                    Nil -> (),
                                                }
                                            }
                                        },
                                        _ -> (),
                                    }
                                } else ();
                                cellSet(cd, r)
                            },
                            Nil -> (),
                        }
                    };
                    VArr(listRev(cellGet(hintsRev)))
                },
            },
            None -> VArr(Nil),
        },
        None -> VArr(Nil),
    }
}

// ============================================================================
// Code Actions / Quick Fixes (`textDocument/codeAction`)
// ============================================================================

def makeQuickFixAction(title: String, uri: String, text: String, editStart: Int, editEnd: Int, newText: String, diagOpt: Option Value): Value = {
    let editRange =
        if (editStart == editEnd) {
            let (l, c) = offsetToLspPos(text, editStart);
            VObj([("start", makeLspPos(l, c)), ("end", makeLspPos(l, c))])
        } else {
            makeLspRange(text, editStart, editEnd)
        };
    let editObj = VObj([
        ("changes", VObj([
            (uri, VArr([
                VObj([
                    ("range", editRange),
                    ("newText", VStr(newText)),
                ]),
            ])),
        ])),
    ]);
    let base = [
        ("title", VStr(title)),
        ("kind", VStr("quickfix")),
        ("edit", editObj),
    ];
    match diagOpt {
        Some(d) -> VObj(listAppend(base, [("diagnostics", VArr([d]))])),
        None -> VObj(base),
    }
}

def formUsesLocalName(f: Form, targetName: String): Bool = match f.node {
    ExLit(_) -> false,
    ExVar(n) -> n == targetName,
    ExTuple(es) -> formListUsesLocalName(es, targetName),
    ExList(es) -> formListUsesLocalName(es, targetName),
    ExBlock(es) -> formListUsesLocalName(es, targetName),
    ExStructInit(_, fs) -> {
        let cf = cellNew(fs);
        let used = cellNew(false);
        while (!cellGet(used) && match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons((_, fv), r) -> { if (formUsesLocalName(fv, targetName)) cellSet(used, true) else (); cellSet(cf, r) },
                Nil -> (),
            }
        };
        cellGet(used)
    },
    ExApply(c, args) -> formUsesLocalName(c, targetName) || formListUsesLocalName(args, targetName),
    ExAbs(ps, _, body) -> {
        let shadowed = cellNew(false);
        let cp = cellNew(ps);
        while (!cellGet(shadowed) && match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(vd, r) -> { if (vd.vname == targetName) cellSet(shadowed, true) else (); cellSet(cp, r) },
                Nil -> (),
            }
        };
        if (cellGet(shadowed)) false else formUsesLocalName(body, targetName)
    },
    ExBin(_, l, r) -> formUsesLocalName(l, targetName) || formUsesLocalName(r, targetName),
    ExUn(_, s) -> formUsesLocalName(s, targetName),
    ExLet(vd, rhs, body) ->
        formUsesLocalName(rhs, targetName)
        || (if (vd.vname == targetName) false else formUsesLocalName(body, targetName)),
    ExIf(c, t, e) -> formUsesLocalName(c, targetName) || formUsesLocalName(t, targetName) || formUsesLocalName(e, targetName),
    ExWhile(c, b) -> formUsesLocalName(c, targetName) || formUsesLocalName(b, targetName),
    ExMatch(scrut, arms) ->
        if (formUsesLocalName(scrut, targetName)) true
        else {
            let ca = cellNew(arms);
            let used = cellNew(false);
            while (!cellGet(used) && match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        let patNames: Cell (List String) = cellNew(Nil);
                        collectPatVarNames(arm.pat, patNames);
                        let shadowed = cellNew(false);
                        let cn = cellNew(cellGet(patNames));
                        while (!cellGet(shadowed) && match cellGet(cn) { Nil -> false, _ -> true }) {
                            match cellGet(cn) {
                                Cons(vn, rn) -> { if (vn == targetName) cellSet(shadowed, true) else (); cellSet(cn, rn) },
                                Nil -> (),
                            }
                        };
                        if (!cellGet(shadowed)) {
                            let gUsed = match arm.guard { Some(g) -> formUsesLocalName(g, targetName), None -> false };
                            if (gUsed || formUsesLocalName(arm.body, targetName)) cellSet(used, true) else ()
                        } else ();
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(used)
        },
    ExField(base, _) -> formUsesLocalName(base, targetName),
    ExTry(inner) -> formUsesLocalName(inner, targetName),
}

def formListUsesLocalName(fs: List Form, targetName: String): Bool = {
    let cur = cellNew(fs);
    let used = cellNew(false);
    while (!cellGet(used) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> { if (formUsesLocalName(h, targetName)) cellSet(used, true) else (); cellSet(cur, r) },
            Nil -> (),
        }
    };
    cellGet(used)
}

def spansOverlap(s1: Int, e1: Int, s2: Int, e2: Int): Bool =
    s1 <= e2 && s2 <= e1

def collectUnusedVarFixesInForm(
    uri: String, src: String, f: Form, fileId: Int,
    reqStart: Int, reqEnd: Int,
    seen: StrMap Bool, outRev: Cell (List Value)
): Void = {
    if (f.pos.fileId != fileId || !spansOverlap(f.pos.start, f.pos.end, reqStart, reqEnd)) ()
    else match f.node {
        ExLet(vd, rhs, body) -> {
            if (!strStartsWith(vd.vname, "_") && !formUsesLocalName(body, vd.vname)) {
                let bindEnd = if (rhs.pos.start > f.pos.start) rhs.pos.start else f.pos.end;
                let (bs, be) = findIdentInSpan(src, vd.vname, f.pos.start, bindEnd);
                if (be > bs && spansOverlap(bs, be, reqStart, reqEnd)) {
                    let key = "unused:" + intToStr(bs);
                    if (!strMapContains(seen, key)) {
                        strMapInsert(seen, key, true);
                        cellSet(outRev, Cons(makeQuickFixAction(
                            "Prefix unused variable '" + vd.vname + "' with '_'",
                            uri, src, bs, be, "_" + vd.vname, None
                        ), cellGet(outRev)))
                    } else ()
                } else ()
            } else ();
            collectUnusedVarFixesInForm(uri, src, rhs, fileId, reqStart, reqEnd, seen, outRev);
            collectUnusedVarFixesInForm(uri, src, body, fileId, reqStart, reqEnd, seen, outRev)
        },
        ExAbs(ps, _, body) -> {
            let headEnd = if (body.pos.start > f.pos.start) body.pos.start else f.pos.end;
            let cp = cellNew(ps);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(vd, r) -> {
                        if (!strStartsWith(vd.vname, "_") && !formUsesLocalName(body, vd.vname)) {
                            let (bs, be) = findIdentInSpan(src, vd.vname, f.pos.start, headEnd);
                            if (be > bs && spansOverlap(bs, be, reqStart, reqEnd)) {
                                let key = "unused:" + intToStr(bs);
                                if (!strMapContains(seen, key)) {
                                    strMapInsert(seen, key, true);
                                    cellSet(outRev, Cons(makeQuickFixAction(
                                        "Prefix unused variable '" + vd.vname + "' with '_'",
                                        uri, src, bs, be, "_" + vd.vname, None
                                    ), cellGet(outRev)))
                                } else ()
                            } else ()
                        } else ();
                        cellSet(cp, r)
                    },
                    Nil -> (),
                }
            };
            collectUnusedVarFixesInForm(uri, src, body, fileId, reqStart, reqEnd, seen, outRev)
        },
        ExMatch(scrut, arms) -> {
            collectUnusedVarFixesInForm(uri, src, scrut, fileId, reqStart, reqEnd, seen, outRev);
            let prevArmEnd = cellNew(if (scrut.pos.end > f.pos.start) scrut.pos.end else f.pos.start);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        let patLo = cellGet(prevArmEnd);
                        let patHi = if (arm.body.pos.start > patLo) arm.body.pos.start else f.pos.end;
                        let patNames: Cell (List String) = cellNew(Nil);
                        collectPatVarNames(arm.pat, patNames);
                        let cn = cellNew(listRev(cellGet(patNames)));
                        while (match cellGet(cn) { Nil -> false, _ -> true }) {
                            match cellGet(cn) {
                                Cons(vn, rn) -> {
                                    let gUsed = match arm.guard { Some(g) -> formUsesLocalName(g, vn), None -> false };
                                    if (!strStartsWith(vn, "_") && !gUsed && !formUsesLocalName(arm.body, vn)) {
                                        let (bs, be) = findIdentInSpan(src, vn, patLo, patHi);
                                        if (be > bs && strSlice(src, bs, be) == vn && spansOverlap(bs, be, reqStart, reqEnd)) {
                                            let key = "unused:" + intToStr(bs);
                                            if (!strMapContains(seen, key)) {
                                                strMapInsert(seen, key, true);
                                                cellSet(outRev, Cons(makeQuickFixAction(
                                                    "Prefix unused variable '" + vn + "' with '_'",
                                                    uri, src, bs, be, "_" + vn, None
                                                ), cellGet(outRev)))
                                            } else ()
                                        } else ()
                                    } else ();
                                    cellSet(cn, rn)
                                },
                                Nil -> (),
                            }
                        };
                        match arm.guard {
                            Some(g) -> collectUnusedVarFixesInForm(uri, src, g, fileId, reqStart, reqEnd, seen, outRev),
                            None -> (),
                        };
                        collectUnusedVarFixesInForm(uri, src, arm.body, fileId, reqStart, reqEnd, seen, outRev);
                        if (arm.body.pos.end > cellGet(prevArmEnd)) cellSet(prevArmEnd, arm.body.pos.end) else ();
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            }
        },
        ExTuple(es) -> collectUnusedVarFixesInList(uri, src, es, fileId, reqStart, reqEnd, seen, outRev),
        ExList(es) -> collectUnusedVarFixesInList(uri, src, es, fileId, reqStart, reqEnd, seen, outRev),
        ExBlock(es) -> collectUnusedVarFixesInList(uri, src, es, fileId, reqStart, reqEnd, seen, outRev),
        ExStructInit(_, fs) -> {
            let cf = cellNew(fs);
            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons((_, fv), r) -> { collectUnusedVarFixesInForm(uri, src, fv, fileId, reqStart, reqEnd, seen, outRev); cellSet(cf, r) },
                    Nil -> (),
                }
            }
        },
        ExApply(c, args) -> {
            collectUnusedVarFixesInForm(uri, src, c, fileId, reqStart, reqEnd, seen, outRev);
            collectUnusedVarFixesInList(uri, src, args, fileId, reqStart, reqEnd, seen, outRev)
        },
        ExBin(_, l, r) -> {
            collectUnusedVarFixesInForm(uri, src, l, fileId, reqStart, reqEnd, seen, outRev);
            collectUnusedVarFixesInForm(uri, src, r, fileId, reqStart, reqEnd, seen, outRev)
        },
        ExUn(_, s) -> collectUnusedVarFixesInForm(uri, src, s, fileId, reqStart, reqEnd, seen, outRev),
        ExIf(c, t, e) -> {
            collectUnusedVarFixesInForm(uri, src, c, fileId, reqStart, reqEnd, seen, outRev);
            collectUnusedVarFixesInForm(uri, src, t, fileId, reqStart, reqEnd, seen, outRev);
            collectUnusedVarFixesInForm(uri, src, e, fileId, reqStart, reqEnd, seen, outRev)
        },
        ExWhile(c, b) -> {
            collectUnusedVarFixesInForm(uri, src, c, fileId, reqStart, reqEnd, seen, outRev);
            collectUnusedVarFixesInForm(uri, src, b, fileId, reqStart, reqEnd, seen, outRev)
        },
        ExField(base, _) -> collectUnusedVarFixesInForm(uri, src, base, fileId, reqStart, reqEnd, seen, outRev),
        ExTry(inner) -> collectUnusedVarFixesInForm(uri, src, inner, fileId, reqStart, reqEnd, seen, outRev),
        ExLit(_) -> (),
        ExVar(_) -> (),
    }
}

def collectUnusedVarFixesInList(
    uri: String, src: String, fs: List Form, fileId: Int,
    reqStart: Int, reqEnd: Int, seen: StrMap Bool, outRev: Cell (List Value)
): Void = {
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> { collectUnusedVarFixesInForm(uri, src, h, fileId, reqStart, reqEnd, seen, outRev); cellSet(cur, r) },
            Nil -> (),
        }
    }
}

def findMatchCloseBrace(src: String, startOff: Int): Option Int = {
    let n = strLen(src);
    let i = cellNew(if (startOff < 0) 0 else startOff);
    let depth = cellNew(0);
    let sawOpen = cellNew(false);
    let found = cellNew(-1);
    let inStr = cellNew(false);
    let inComment = cellNew(false);
    while (cellGet(i) < n && cellGet(found) < 0) {
        let idx = cellGet(i);
        let b = strByteAt(src, idx);
        if (cellGet(inComment)) {
            if (b == 10) cellSet(inComment, false) else ();
            cellSet(i, idx + 1)
        } else if (cellGet(inStr)) {
            if (b == 92 && idx + 1 < n) cellSet(i, idx + 2)
            else { if (b == 34) cellSet(inStr, false) else (); cellSet(i, idx + 1) }
        } else if (b == 47 && idx + 1 < n && strByteAt(src, idx + 1) == 47) {
            cellSet(inComment, true);
            cellSet(i, idx + 2)
        } else if (b == 34) {
            cellSet(inStr, true);
            cellSet(i, idx + 1)
        } else if (b == 123) {
            cellSet(sawOpen, true);
            cellSet(depth, cellGet(depth) + 1);
            cellSet(i, idx + 1)
        } else if (b == 125) {
            let d = cellGet(depth) - 1;
            cellSet(depth, d);
            if (cellGet(sawOpen) && d == 0) cellSet(found, idx) else ();
            cellSet(i, idx + 1)
        } else {
            cellSet(i, idx + 1)
        }
    };
    if (cellGet(found) >= 0) Some(cellGet(found)) else None
}

def lineIndentAt(src: String, off: Int): String = {
    let n = strLen(src);
    let p = cellNew(if (off < 0) 0 else if (off > n) n else off);
    while (cellGet(p) > 0 && strByteAt(src, cellGet(p) - 1) != 10) {
        cellSet(p, cellGet(p) - 1)
    };
    let ls = cellGet(p);
    let e = cellNew(ls);
    while (cellGet(e) < n && (strByteAt(src, cellGet(e)) == 32 || strByteAt(src, cellGet(e)) == 9)) {
        cellSet(e, cellGet(e) + 1)
    };
    strSlice(src, ls, cellGet(e))
}

def extractAfterPrefix(s: String, prefix: String): Option String = {
    let n = strLen(s);
    let pl = strLen(prefix);
    if (pl == 0 || n < pl) None
    else {
        let i = cellNew(0);
        let found = cellNew(-1);
        while (cellGet(i) <= n - pl && cellGet(found) < 0) {
            if (strStartsWith(strSlice(s, cellGet(i), cellGet(i) + pl), prefix)) {
                cellSet(found, cellGet(i) + pl)
            } else {
                cellSet(i, cellGet(i) + 1)
            }
        };
        let f = cellGet(found);
        if (f >= 0) Some(strSlice(s, f, n)) else None
    }
}

def moduleItemsExportName(items: List ModuleItem, symName: String): Bool = {
    let cur = cellNew(items);
    let found = cellNew(false);
    while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(vis, d), r) -> {
                if (isPublicVis(vis)) {
                    if (d.ident == symName || defHasVariant(d, symName) || defHasMethod(d, symName)) {
                        cellSet(found, true)
                    } else ()
                } else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    cellGet(found)
}

def computeUseInsertOffset(src: String): Int = {
    let n = strLen(src);
    let pos = cellNew(0);
    let lastUseEnd = cellNew(0);
    let scanning = cellNew(true);
    while (cellGet(pos) < n && cellGet(scanning)) {
        let ls = cellGet(pos);
        let le = match strIndexOfByte(src, 10, ls) {
            Some(nl) -> nl + 1,
            None -> n,
        };
        let trimmed = strTrim(strSlice(src, ls, le));
        if (strStartsWith(trimmed, "use ") || strStartsWith(trimmed, "pub use ")) {
            cellSet(lastUseEnd, le);
            cellSet(pos, le)
        } else if (strLen(trimmed) == 0 || strStartsWith(trimmed, "//")) {
            cellSet(pos, le)
        } else {
            cellSet(scanning, false)
        }
    };
    cellGet(lastUseEnd)
}

def computeModuleKeyForFile(fp: String, srcRoots: List String): String = {
    let fc = loaderCanonicalPath(fp);
    let cur = cellNew(srcRoots);
    let found: Cell (Option String) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(sr, r) -> {
                let sr0 = loaderCanonicalPath(sr);
                let srCanon =
                    if (strLen(sr0) > 1 && strEndsWith(sr0, "/")) strSlice(sr0, 0, strLen(sr0) - 1)
                    else sr0;
                let pfx = srCanon + "/";
                if (strStartsWith(fc, pfx) && strEndsWith(fc, ".gsa")) {
                    let rel = strSlice(fc, strLen(pfx), strLen(fc) - 4);
                    let segs = strSplitChar(rel, '/');
                    let joined = strJoin(segs, ".");
                    if (strLen(joined) > 0) cellSet(found, Some(joined)) else ()
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    match cellGet(found) {
        Some(mk) -> mk,
        None -> pathStem(fp),
    }
}

def addImportSuggestionsForSym(
    ss: ServerState,
    doc: DocState,
    symName: String,
    diagVal: Value,
    seen: StrMap Bool,
    outRev: Cell (List Value)
): Void = {
    let insertOff = computeUseInsertOffset(doc.dsText);
    // 1. Search std.*/sys.* builtin modules
    let ck = cellNew(builtinModuleKeys());
    while (match cellGet(ck) { Nil -> false, _ -> true }) {
        match cellGet(ck) {
            Cons(modKey, r) -> {
                match builtinModuleSource(modKey) {
                    Some(msrc) if (strContains(msrc, symName)) ->
                        match parseFileModuleInFile(msrc, Nil, 0) {
                            Ok(fm) if (moduleItemsExportName(fm.items, symName)) -> {
                                let key = "import:" + modKey + "." + symName;
                                if (!strMapContains(seen, key)) {
                                    strMapInsert(seen, key, true);
                                    cellSet(outRev, Cons(makeQuickFixAction(
                                        "Import '" + symName + "' from '" + modKey + "'",
                                        doc.dsUri, doc.dsText, insertOff, insertOff,
                                        "use " + modKey + "." + symName + "\n",
                                        Some(diagVal)
                                    ), cellGet(outRev)))
                                } else ()
                            },
                            _ -> (),
                        },
                    _ -> (),
                };
                cellSet(ck, r)
            },
            Nil -> (),
        }
    };
    // 2. Search sibling / project `.gsa` files (and open docs)
    let docCanon = loaderCanonicalPath(doc.dsPath);
    let (rootSpec, _) = resolveDocPkgSpecs(doc.dsPath);
    let candPaths: Cell (List String) = cellNew(Nil);
    let searchDir = match findProjectRoot(pathDirname(doc.dsPath)) {
        Some(pr) -> pr,
        None -> pathDirname(doc.dsPath),
    };
    if (strLen(searchDir) > 0 && isDir(searchDir)) {
        collectWorkspaceGsaFiles(searchDir, candPaths)
    } else ();
    let cp = cellNew(cellGet(candPaths));
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(fp, r) -> {
                let fc = loaderCanonicalPath(fp);
                if (fc != docCanon) {
                    let txtOpt = match strMapGet(ss.ssCanonToUri, fc) {
                        Some(ou) -> match strMapGet(ss.ssDocs, ou) {
                            Some(od) -> Some(od.dsText),
                            None -> match readFile(fp) { Ok(t) -> Some(t), Err(_) -> None },
                        },
                        None -> match readFile(fp) { Ok(t) -> Some(t), Err(_) -> None },
                    };
                    match txtOpt {
                        Some(txt) if (strContains(txt, symName)) ->
                            match parseFileModuleInFile(txt, Nil, 0) {
                                Ok(fm) if (moduleItemsExportName(fm.items, symName)) -> {
                                    let modKey = computeModuleKeyForFile(fp, rootSpec.srcRoots);
                                    let key = "import:" + modKey + "." + symName;
                                    if (!strMapContains(seen, key)) {
                                        strMapInsert(seen, key, true);
                                        cellSet(outRev, Cons(makeQuickFixAction(
                                            "Import '" + symName + "' from '" + modKey + "'",
                                            doc.dsUri, doc.dsText, insertOff, insertOff,
                                            "use " + modKey + "." + symName + "\n",
                                            Some(diagVal)
                                        ), cellGet(outRev)))
                                    } else ()
                                },
                                _ -> (),
                            },
                        _ -> (),
                    }
                } else ();
                cellSet(cp, r)
            },
            Nil -> (),
        }
    }
}

def handleCodeAction(ss: ServerState, params: Value): Value = {
    let uriOpt = match objGet(params, "textDocument") {
        Some(td) -> objGetStr(td, "uri"),
        None -> None,
    };
    let rangeOpt = objGet(params, "range");
    match uriOpt {
        Some(uri) -> match strMapGet(ss.ssDocs, uri) {
            Some(doc) -> {
                let (reqStart, reqEnd) = match rangeOpt {
                    Some(rng) -> match (objGet(rng, "start"), objGet(rng, "end")) {
                        (Some(sp), Some(ep)) -> match (objGetInt(sp, "line"), objGetInt(sp, "character"), objGetInt(ep, "line"), objGetInt(ep, "character")) {
                            (Some(sl), Some(sc), Some(el), Some(ec)) ->
                                (lspPosToOffset(doc.dsText, sl, sc), lspPosToOffset(doc.dsText, el, ec)),
                            _ -> (0, strLen(doc.dsText)),
                        },
                        _ -> (0, strLen(doc.dsText)),
                    },
                    None -> (0, strLen(doc.dsText)),
                };
                let seen: StrMap Bool = strMapNew();
                let actionsRev: Cell (List Value) = cellNew(Nil);

                // 1. Diagnostic-driven Quick Fixes (missing match arms & auto-import for undefined symbol)
                let ctxDiags: List Value = match objGet(params, "context") {
                    Some(ctx) -> match objGet(ctx, "diagnostics") {
                        Some(VArr(ds)) -> ds,
                        _ -> Nil,
                    },
                    None -> Nil,
                };
                let cd = cellNew(ctxDiags);
                while (match cellGet(cd) { Nil -> false, _ -> true }) {
                    match cellGet(cd) {
                        Cons(diagVal, r) -> {
                            match objGetStr(diagVal, "message") {
                                Some(msg) -> {
                                    // 1a. Non-exhaustive pattern match -> insert missing match arm skeleton
                                    match extractAfterPrefix(msg, "Non-exhaustive pattern match; missing case: ") {
                                        Some(rest) -> {
                                            let missingPat = strTrim(match strIndexOfByte(rest, 10, 0) {
                                                Some(nl) -> strSlice(rest, 0, nl),
                                                None -> rest,
                                            });
                                            let diagStartOff = match objGet(diagVal, "range") {
                                                Some(dr) -> match objGet(dr, "start") {
                                                    Some(sp) -> match (objGetInt(sp, "line"), objGetInt(sp, "character")) {
                                                        (Some(l), Some(c)) -> lspPosToOffset(doc.dsText, l, c),
                                                        _ -> reqStart,
                                                    },
                                                    None -> reqStart,
                                                },
                                                None -> reqStart,
                                            };
                                            match findMatchCloseBrace(doc.dsText, diagStartOff) {
                                                Some(closePos) -> {
                                                    let baseIndent = lineIndentAt(doc.dsText, diagStartOff);
                                                    let armIndent = baseIndent + "    ";
                                                    // Check if previous non-whitespace char before `}` needs a comma
                                                    let prevIdx = cellNew(closePos - 1);
                                                    while (cellGet(prevIdx) >= 0 && (
                                                        strByteAt(doc.dsText, cellGet(prevIdx)) == 32
                                                        || strByteAt(doc.dsText, cellGet(prevIdx)) == 9
                                                        || strByteAt(doc.dsText, cellGet(prevIdx)) == 10
                                                        || strByteAt(doc.dsText, cellGet(prevIdx)) == 13
                                                    )) {
                                                        cellSet(prevIdx, cellGet(prevIdx) - 1)
                                                    };
                                                    let prevCh = if (cellGet(prevIdx) >= 0) strByteAt(doc.dsText, cellGet(prevIdx)) else 0;
                                                    let needComma = prevCh != 44 && prevCh != 123;
                                                    let insertPos = if (needComma && cellGet(prevIdx) >= 0) cellGet(prevIdx) + 1 else closePos;
                                                    let snippet =
                                                        if (needComma) ",\n" + armIndent + missingPat + " -> (),"
                                                        else armIndent + missingPat + " -> (),\n" + baseIndent;
                                                    let key = "match:" + intToStr(closePos) + ":" + missingPat;
                                                    if (!strMapContains(seen, key)) {
                                                        strMapInsert(seen, key, true);
                                                        cellSet(actionsRev, Cons(makeQuickFixAction(
                                                            "Add missing match arm '" + missingPat + "'",
                                                            doc.dsUri, doc.dsText, insertPos, insertPos, snippet, Some(diagVal)
                                                        ), cellGet(actionsRev)))
                                                    } else ()
                                                },
                                                None -> (),
                                            }
                                        },
                                        None -> (),
                                    };
                                    // 1b. Undefined name `<sym>` -> auto-import suggestion
                                    match extractAfterPrefix(msg, "undefined name `") {
                                        Some(rest) -> match strIndexOfByte(rest, 96, 0) {
                                            Some(bt) if (bt > 0) -> {
                                                let symName = strSlice(rest, 0, bt);
                                                addImportSuggestionsForSym(ss, doc, symName, diagVal, seen, actionsRev)
                                            },
                                            _ -> (),
                                        },
                                        None -> (),
                                    }
                                },
                                None -> (),
                            };
                            cellSet(cd, r)
                        },
                        Nil -> (),
                    }
                };

                // 2. AST-driven Quick Fixes: unused local variables -> prefix with `_`
                match doc.dsInfer {
                    Some(inf) -> {
                        let cdef = cellNew(inf.defs);
                        while (match cellGet(cdef) { Nil -> false, _ -> true }) {
                            match cellGet(cdef) {
                                Cons(d, rd) -> {
                                    if (d.dpos.fileId == doc.dsFileId) {
                                        match d.item {
                                            ItForm(f) -> collectUnusedVarFixesInForm(doc.dsUri, doc.dsText, f, doc.dsFileId, reqStart, reqEnd, seen, actionsRev),
                                            ItInstance(_, _, _, impls) -> {
                                                let ci = cellNew(impls);
                                                while (match cellGet(ci) { Nil -> false, _ -> true }) {
                                                    match cellGet(ci) {
                                                        Cons(mi, ri) -> {
                                                            collectUnusedVarFixesInForm(doc.dsUri, doc.dsText, mi.implBody, doc.dsFileId, reqStart, reqEnd, seen, actionsRev);
                                                            cellSet(ci, ri)
                                                        },
                                                        Nil -> (),
                                                    }
                                                }
                                            },
                                            _ -> (),
                                        }
                                    } else ();
                                    cellSet(cdef, rd)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                };

                VArr(listRev(cellGet(actionsRev)))
            },
            None -> VArr(Nil),
        },
        None -> VArr(Nil),
    }
}

// ============================================================================
// JSON-RPC Dispatcher & Main Loop
// ============================================================================

def handleInitialize(ss: ServerState, params: Value): Value = {
    match objGetStr(params, "rootUri") {
        Some(ru) -> cellSet(ss.ssRootDir, Some(uriToPath(ru))),
        None -> match objGetStr(params, "rootPath") {
            Some(rp) -> cellSet(ss.ssRootDir, Some(rp)),
            None -> (),
        },
    };
    VObj([
        ("capabilities", VObj([
            ("textDocumentSync", VObj([
                ("openClose", VBool(true)),
                ("change", VInt(intToI64(1))),
                ("save", VObj([("includeText", VBool(true))])),
            ])),
            ("hoverProvider", VBool(true)),
            ("definitionProvider", VBool(true)),
            ("referencesProvider", VBool(true)),
            ("renameProvider", VObj([
                ("prepareProvider", VBool(true)),
            ])),
            ("inlayHintProvider", VBool(true)),
            ("codeActionProvider", VObj([
                ("codeActionKinds", VArr([VStr("quickfix")])),
            ])),
            ("documentSymbolProvider", VBool(true)),
            ("completionProvider", VObj([
                ("triggerCharacters", VArr([VStr(".")])),
            ])),
        ])),
        ("serverInfo", VObj([
            ("name", VStr("geisha-lsp")),
            ("version", VStr("0.2.0")),
        ])),
    ])
}

def handleDidOpen(ss: ServerState, params: Value): Void =
    match objGet(params, "textDocument") {
        Some(td) -> match (objGetStr(td, "uri"), objGetStr(td, "text")) {
            (Some(uri), Some(text)) -> {
                let ver = match objGetInt(td, "version") { Some(v) -> v, None -> 0 };
                analyzeAndPublish(ss, uri, text, ver)
            },
            _ -> (),
        },
        None -> (),
    }

def handleDidChange(ss: ServerState, params: Value): Void =
    match (objGet(params, "textDocument"), objGet(params, "contentChanges")) {
        (Some(td), Some(VArr(changes))) -> match objGetStr(td, "uri") {
            Some(uri) -> {
                let ver = match objGetInt(td, "version") { Some(v) -> v, None -> 0 };
                let lastText: Cell (Option String) = cellNew(None);
                let cur = cellNew(changes);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(ch, r) -> {
                            match objGetStr(ch, "text") {
                                Some(t) -> cellSet(lastText, Some(t)),
                                None -> (),
                            };
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                match cellGet(lastText) {
                    Some(text) -> analyzeAndPublish(ss, uri, text, ver),
                    None -> (),
                }
            },
            None -> (),
        },
        _ -> (),
    }

def handleDidSave(ss: ServerState, params: Value): Void =
    match objGet(params, "textDocument") {
        Some(td) -> match objGetStr(td, "uri") {
            Some(uri) -> {
                let prevVer = match strMapGet(ss.ssDocs, uri) {
                    Some(doc) -> doc.dsVersion,
                    None -> 0,
                };
                match objGetStr(params, "text") {
                    Some(text) -> analyzeAndPublish(ss, uri, text, prevVer),
                    None -> match strMapGet(ss.ssDocs, uri) {
                        Some(doc) -> analyzeAndPublish(ss, uri, doc.dsText, doc.dsVersion),
                        None -> (),
                    },
                }
            },
            None -> (),
        },
        None -> (),
    }

def handleDidClose(ss: ServerState, params: Value): Void =
    match objGet(params, "textDocument") {
        Some(td) -> match objGetStr(td, "uri") {
            Some(uri) -> {
                let prevOpt = strMapGet(ss.ssDocs, uri);
                let path = uriToPath(uri);
                clearStaleForeignDiag(prevOpt, uri, None);
                let _ = strMapRemove(ss.ssCanonToUri, loaderCanonicalPath(path));
                loaderRemoveOverlay(path);
                untrackOpenUri(ss, uri);
                let _ = strMapRemove(ss.ssDocs, uri);
                sendRpcNotification("textDocument/publishDiagnostics", VObj([
                    ("uri", VStr(uri)),
                    ("diagnostics", VArr(Nil)),
                ]));
                refreshOtherOpenDocs(ss, uri)
            },
            None -> (),
        },
        None -> (),
    }

def validateLspArgs(args: List String): Result Void String = {
    let cur = cellNew(args);
    let errOpt: Cell (Option String) = cellNew(None);
    while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                if (a == "--stdio") {
                    ()
                } else if (strStartsWith(a, "-")) {
                    cellSet(errOpt, Some("unknown option for 'geisha lsp': '" + a + "' (usage: geisha lsp [--stdio])"))
                } else {
                    cellSet(errOpt, Some("unexpected argument for 'geisha lsp': '" + a + "' (usage: geisha lsp [--stdio])"))
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None -> Ok(()),
    }
}

pub def cmdLsp(args: List String): Result Int String = {
    validateLspArgs(args)?;
    let ss = MkServerState {
        ssDocs: strMapNew(),
        ssCanonToUri: strMapNew(),
        ssOpenUris: cellNew(Nil),
        ssShuttingDown: cellNew(false),
        ssRootDir: cellNew(None),
    };
    let reader = stdinReaderNew();
    let running = cellNew(true);
    let exitCode = cellNew(0);

    while (cellGet(running)) {
        match readLspMessage(reader) {
            None -> cellSet(running, false),
            Some(rawJson) -> match jsonParse(rawJson) {
                Err(e) -> eprintLn("geisha lsp: invalid JSON-RPC payload: " + e),
                Ok(msg) -> {
                    let idOpt = objGet(msg, "id");
                    let methodOpt = objGetStr(msg, "method");
                    let params = match objGet(msg, "params") {
                        Some(p) -> p,
                        None -> VObj(Nil),
                    };
                    match methodOpt {
                        None -> (),
                        Some(method) ->
                            if (method == "exit") {
                                cellSet(exitCode, if (cellGet(ss.ssShuttingDown)) 0 else 1);
                                cellSet(running, false)
                            } else if (cellGet(ss.ssShuttingDown)) {
                                match idOpt {
                                    Some(idVal) -> sendRpcError(idVal, -32600, "Server is shutting down"),
                                    None -> (),
                                }
                            } else if (method == "initialize") {
                                let res = handleInitialize(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "initialized") {
                                ()
                            } else if (method == "shutdown") {
                                cellSet(ss.ssShuttingDown, true);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, VNull), None -> () }
                            } else if (method == "textDocument/didOpen") {
                                handleDidOpen(ss, params)
                            } else if (method == "textDocument/didChange") {
                                handleDidChange(ss, params)
                            } else if (method == "textDocument/didSave") {
                                handleDidSave(ss, params)
                            } else if (method == "textDocument/didClose") {
                                handleDidClose(ss, params)
                            } else if (method == "textDocument/hover") {
                                let res = handleHover(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/definition") {
                                let res = handleDefinition(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/references") {
                                let res = handleReferences(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/prepareRename") {
                                let res = handlePrepareRename(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/rename") {
                                match handleRename(ss, params) {
                                    Ok(res) -> match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () },
                                    Err((code, emsg)) -> match idOpt { Some(idVal) -> sendRpcError(idVal, code, emsg), None -> () },
                                }
                            } else if (method == "textDocument/inlayHint") {
                                let res = handleInlayHint(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/codeAction") {
                                let res = handleCodeAction(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/documentSymbol") {
                                let res = handleDocumentSymbol(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (method == "textDocument/completion") {
                                let res = handleCompletion(ss, params);
                                match idOpt { Some(idVal) -> sendRpcResponse(idVal, res), None -> () }
                            } else if (strStartsWith(method, "$/")) {
                                ()
                            } else {
                                match idOpt {
                                    Some(idVal) -> sendRpcError(idVal, -32601, "Method not found: " + method),
                                    None -> (),
                                }
                            },
                    }
                },
            },
        }
    };
    Ok(cellGet(exitCode))
}
