// Mechanically verified pure arithmetic, encoding, span-clamping, alignment,
// GC-bitmap, and Core HOF optimization kernels used directly by the Geisha compiler
// passes (`core`, `codegen_wasmgc`, `diag`, `doc`, `lsp`, `codegen`, `verify`).
//
// Every function in this module is restricted to the scalar/Cell fragment modeled
// by BOTH `geisha verify` (Z3 QF_BV) and Lean 4 `CoreGeisha.VCG` (`geisha-check --verify-vcg`),
// so 100% of obligations are cross-verified with 0 failed and 0 unknown.

// ============================================================================
// 1. WasmGC LEB128 Encoding Step & Byte-Length Kernels
// ============================================================================

pub def uleb32Next(cur: Int): Int
    ensures r -> r == (cur >>> 7)
= cur >>> 7

pub def uleb32Byte(cur: Int): Int
    ensures r -> 0 <= r && r <= 255
        && (((cur >>> 7) != 0 && (r & 128) == 128) || ((cur >>> 7) == 0 && (r & 128) == 0))
= {
    let low = cur & 127;
    if ((cur >>> 7) != 0) low | 128 else low
}

pub def uleb32Len(n: Int): Int
    ensures r -> 1 <= r && r <= 5
= {
    let v = cellNew(n);
    let cnt = cellNew(0);
    let more = cellNew(true);
    while (cellGet(more) && cellGet(cnt) < 5)
        invariant 0 <= cellGet(cnt) && cellGet(cnt) <= 5
        invariant cellGet(more) || cellGet(cnt) >= 1
        decreases 5 - cellGet(cnt)
    {
        let next = cellGet(v) >>> 7;
        cellSet(cnt, cellGet(cnt) + 1);
        if (next != 0) cellSet(v, next) else cellSet(more, false)
    };
    cellGet(cnt)
}

pub def sleb32Done(cur: Int): Bool
    ensures r -> r == (((cur >> 7) == 0 && ((cur & 127) & 64) == 0) || ((cur >> 7) == -1 && ((cur & 127) & 64) != 0))
= {
    let low = cur & 127;
    let next = cur >> 7;
    (next == 0 && (low & 64) == 0) || (next == -1 && (low & 64) != 0)
}

pub def sleb32Next(cur: Int): Int
    ensures r -> r == (cur >> 7)
= cur >> 7

pub def sleb32Byte(cur: Int): Int
    ensures r -> 0 <= r && r <= 255
        && (((((cur >> 7) == 0 && ((cur & 127) & 64) == 0) || ((cur >> 7) == -1 && ((cur & 127) & 64) != 0)) && (r & 128) == 0)
            || (!(((cur >> 7) == 0 && ((cur & 127) & 64) == 0) || ((cur >> 7) == -1 && ((cur & 127) & 64) != 0)) && (r & 128) == 128))
= {
    let low = cur & 127;
    if (sleb32Done(cur)) low else low | 128
}

pub def sleb32Len(n: Int): Int
    ensures r -> 1 <= r && r <= 5
= {
    let v = cellNew(n);
    let cnt = cellNew(0);
    let more = cellNew(true);
    while (cellGet(more) && cellGet(cnt) < 5)
        invariant 0 <= cellGet(cnt) && cellGet(cnt) <= 5
        invariant cellGet(more) || cellGet(cnt) >= 1
        decreases 5 - cellGet(cnt)
    {
        let cur = cellGet(v);
        cellSet(cnt, cellGet(cnt) + 1);
        if (sleb32Done(cur)) cellSet(more, false) else cellSet(v, cur >> 7)
    };
    cellGet(cnt)
}

pub def sleb64Done(cur: Int64): Bool
    ensures r -> r == (((cur >> 7) == intToI64(0) && (i64ToInt(cur & intToI64(127)) & 64) == 0)
        || ((cur >> 7) == intToI64(-1) && (i64ToInt(cur & intToI64(127)) & 64) != 0))
= {
    let low = i64ToInt(cur & intToI64(127));
    let next = cur >> 7;
    (next == intToI64(0) && (low & 64) == 0) || (next == intToI64(-1) && (low & 64) != 0)
}

pub def sleb64Next(cur: Int64): Int64
    ensures r -> r == (cur >> 7)
= cur >> 7

pub def sleb64Byte(cur: Int64): Int
    ensures r -> 0 <= r && r <= 255
        && (((((cur >> 7) == intToI64(0) && (i64ToInt(cur & intToI64(127)) & 64) == 0)
              || ((cur >> 7) == intToI64(-1) && (i64ToInt(cur & intToI64(127)) & 64) != 0)) && (r & 128) == 0)
            || (!(((cur >> 7) == intToI64(0) && (i64ToInt(cur & intToI64(127)) & 64) == 0)
                  || ((cur >> 7) == intToI64(-1) && (i64ToInt(cur & intToI64(127)) & 64) != 0)) && (r & 128) == 128))
= {
    let low = i64ToInt(cur & intToI64(127));
    if (sleb64Done(cur)) low else low | 128
}

pub def sleb64Len(n: Int64): Int
    ensures r -> 1 <= r && r <= 10
= {
    let v = cellNew(n);
    let cnt = cellNew(0);
    let more = cellNew(true);
    while (cellGet(more) && cellGet(cnt) < 10)
        invariant 0 <= cellGet(cnt) && cellGet(cnt) <= 10
        invariant cellGet(more) || cellGet(cnt) >= 1
        decreases 10 - cellGet(cnt)
    {
        let cur = cellGet(v);
        cellSet(cnt, cellGet(cnt) + 1);
        if (sleb64Done(cur)) cellSet(more, false) else cellSet(v, cur >> 7)
    };
    cellGet(cnt)
}

// ============================================================================
// 2. Span Clamping & Interval Safety Kernels
// ============================================================================

pub def clampOffset(pos: Int, totalLen: Int): Int
    requires totalLen >= 0
    ensures r -> 0 <= r && r <= totalLen
= if (pos < 0) 0 else if (pos > totalLen) totalLen else pos

pub def clampSpanEnd(clampedStart: Int, endPos: Int, totalLen: Int): Int
    requires 0 <= clampedStart && clampedStart <= totalLen
    ensures r -> clampedStart <= r && r <= totalLen
= if (endPos < clampedStart) clampedStart else if (endPos > totalLen) totalLen else endPos

// ============================================================================
// 3. Memory Alignment, GC Bitmap Index/Mask & Hex Encoding Kernels
// ============================================================================

pub def alignUp8(n: Int): Int
    requires 0 <= n && n <= 2147483640
    ensures r -> r >= n && (r & 7) == 0 && r - n < 8
= (n + 7) & ~7

pub def alignUp16(n: Int): Int
    requires 0 <= n && n <= 2147483632
    ensures r -> r >= n && (r & 15) == 0 && r - n < 16
= (n + 15) & ~15

pub def bitmapWordIdx(byteOff: Int): Int
    requires 0 <= byteOff && byteOff < 320 && (byteOff & 7) == 0
    ensures r -> 0 <= r && r < 40 && r * 8 == byteOff
= byteOff >> 3

pub def bitmapBitMask(wordIdx: Int): Int64
    requires 0 <= wordIdx && wordIdx < 40
    ensures r -> r != intToI64(0) && (r & (r - intToI64(1))) == intToI64(0)
= intToI64(1) << wordIdx

pub def hexDigitUpperByte(nib: Int): Int
    requires 0 <= nib && nib < 16
    ensures r -> (48 <= r && r <= 57) || (65 <= r && r <= 70)
= if (nib < 10) 48 + nib else 55 + nib

pub def hexNibbleVal(b: Int): Int
    ensures r -> r == -1 || (0 <= r && r < 16)
= if (b >= 48 && b <= 57) b - 48
  else if (b >= 65 && b <= 70) b - 55
  else if (b >= 97 && b <= 102) b - 87
  else -1

// ============================================================================
// 4. Core Higher-Order Optimization, Pattern Lattice & Specialization Kernels
// ============================================================================

pub def coFreshNextId(curId: Int): Int
    requires 0 <= curId && curId < 2147483647
    ensures r -> r == curId + 1 && r > curId && r > 0
= curId + 1

pub def coFreshBatchEnd(startId: Int, count: Int): Int
    requires 0 <= startId && startId <= 1073741824 && 0 <= count && count <= 1048576
    ensures r -> r == startId + count && r >= startId
= {
    let cur = cellNew(startId);
    let rem = cellNew(count);
    while (cellGet(rem) > 0)
        invariant 0 <= cellGet(rem) && cellGet(rem) <= count
        invariant 0 <= cellGet(cur) && cellGet(cur) == startId + (count - cellGet(rem))
        decreases cellGet(rem)
    {
        cellSet(cur, cellGet(cur) + 1);
        cellSet(rem, cellGet(rem) - 1)
    };
    cellGet(cur)
}

pub def coFlatTotalArity(fvCount: Int, paramCount: Int): Int
    requires 0 <= fvCount && fvCount <= 1048576 && 0 <= paramCount && paramCount <= 1048576
    ensures r -> r == fvCount + paramCount && r >= fvCount && r >= paramCount
= fvCount + paramCount

pub def coSpecSlotStepArity(curArity: Int, isSpecCb: Bool, fvCount: Int): Int
    requires 0 <= curArity && curArity <= 1048576 && 0 <= fvCount && fvCount <= 1024
    ensures r -> r >= curArity
        && ((isSpecCb && r == curArity + fvCount) || (!isSpecCb && r == curArity + 1))
= if (isSpecCb) curArity + fvCount else curArity + 1

pub def coAnfInFloatPrefix(idx: Int, lastFloatIdx: Int): Bool
    requires idx >= 0 && lastFloatIdx >= -1
    ensures r -> (r == (idx <= lastFloatIdx)) && (!r || lastFloatIdx >= 0)
= idx <= lastFloatIdx

// 3-valued sequential pattern-list conjunction lattice (`0 = CoPatYes`, `1 = CoPatNo`, `2 = CoPatUnknown`)
pub def coPatSeqStatus(s1: Int, s2: Int): Int
    requires 0 <= s1 && s1 <= 2 && 0 <= s2 && s2 <= 2
    ensures r -> 0 <= r && r <= 2
        && ((r == 1) == (s1 == 1 || s2 == 1))
        && ((r == 0) == (s1 == 0 && s2 == 0))
= if (s1 == 1) 1 else if (s1 == 2) { if (s2 == 1) 1 else 2 } else s2

pub def coInlineBudgetAllows(
    cost: Int,
    maxCost: Int,
    inlCnt: Int,
    maxInlines: Int,
    depth: Int,
    maxDepth: Int
): Bool
    requires maxCost >= 1 && maxInlines >= 0 && maxDepth >= 0
    ensures r -> r == (
        1 <= cost && cost <= maxCost
        && 0 <= inlCnt && inlCnt < maxInlines
        && 0 <= depth && depth < maxDepth
    )
= 1 <= cost && cost <= maxCost
    && 0 <= inlCnt && inlCnt < maxInlines
    && 0 <= depth && depth < maxDepth
