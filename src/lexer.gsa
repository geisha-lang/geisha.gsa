// Handwritten linear-time Geisha Lexer (`lexer`)

use std.result.{Result, Ok, Err}
use std.char.{isDigitByte, isIdentStartByte, isIdentContByte}
use std.vec.{Vec, vecNew, vecPush}
use std.buf.{StringBuf, bufNew, bufClear, bufPushByte, bufToString}
use std.str.intToStr
use ast.{Span, MkSpan}
use diag.formatDiagAt

pub data TokKind {
    TkIdent(String),
    TkInt(String),
    TkFloat(String),
    TkStr(String),
    TkChar(Int),
    TkSym(String),
    TkQuestion,
    TkLParen,
    TkRParen,
    TkLBrace,
    TkRBrace,
    TkLBracket,
    TkRBracket,
    TkComma,
    TkSemi,
    TkDot,
    TkDef,
    TkExtern,
    TkIf,
    TkElse,
    TkWhile,
    TkLet,
    TkIn,
    TkType,
    TkData,
    TkMatch,
    TkConcept,
    TkInstance,
    TkForall,
    TkPub,
    TkUse,
    TkMod,
    TkOpen,
    TkAs,
    TkTrue,
    TkFalse,
    TkVoid,
    TkEof,
}

pub data Token {
    MkToken { kind: TokKind, span: Span, hadNewline: Bool },
}

pub def isOpByte(b: Int): Bool =
    b == 33 || b == 35 || b == 36 || b == 37 || b == 38
    || b == 42 || b == 43 || b == 45 || b == 47 || b == 58
    || b == 60 || b == 61 || b == 62 || b == 63 || b == 64
    || b == 92 || b == 94 || b == 124 || b == 126

def unescapeByte(esc: Int, fileId: Int, pos: Int): Result Int String =
    if (esc == 110) Ok(10)
    else if (esc == 114) Ok(13)
    else if (esc == 116) Ok(9)
    else if (esc == 48) Ok(0)
    else if (esc == 92) Ok(92)
    else if (esc == 34) Ok(34)
    else if (esc == 39) Ok(39)
    else Err(formatDiagAt("Lex error", fileId, pos, pos + 2, "invalid escape sequence"))

def classifyWord(w: String): TokKind =
    if (w == "def") TkDef
    else if (w == "extern") TkExtern
    else if (w == "if") TkIf
    else if (w == "else") TkElse
    else if (w == "while") TkWhile
    else if (w == "let") TkLet
    else if (w == "in") TkIn
    else if (w == "type") TkType
    else if (w == "data") TkData
    else if (w == "match") TkMatch
    else if (w == "concept") TkConcept
    else if (w == "instance") TkInstance
    else if (w == "forall") TkForall
    else if (w == "pub") TkPub
    else if (w == "use") TkUse
    else if (w == "mod") TkMod
    else if (w == "open") TkOpen
    else if (w == "as") TkAs
    else if (w == "true") TkTrue
    else if (w == "false") TkFalse
    else if (w == "Void") TkVoid
    else TkIdent(w)

def sliceIntoBuf(buf: StringBuf, src: String, start: Int, end: Int): String =
    ptrSliceFromStr(src, start, end - start)

def isRadixDigitByte(b: Int, radix: Int): Bool =
    if (radix == 16) {
        (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
    } else if (radix == 8) {
        b >= 48 && b <= 55
    } else if (radix == 2) {
        b == 48 || b == 49
    } else {
        isDigitByte(b)
    }

def scanDigitsToBuf(src: String, len: Int, i: Cell Int, radix: Int, allowLeadingSep: Bool, outBuf: StringBuf): Result Int String = {
    let count = cellNew(0);
    let scanning = cellNew(true);
    let badSep = cellNew(false);
    while (cellGet(i) < len && cellGet(scanning) && !cellGet(badSep)) {
        let cur = cellGet(i);
        let c = strByteAt(src, cur);
        if (isRadixDigitByte(c, radix)) {
            bufPushByte(outBuf, c);
            cellSet(count, cellGet(count) + 1);
            cellSet(i, cur + 1)
        } else if (c == 95) {
            if ((cellGet(count) > 0 || allowLeadingSep) && cur + 1 < len && isRadixDigitByte(strByteAt(src, cur + 1), radix)) {
                cellSet(i, cur + 1)
            } else {
                cellSet(badSep, true)
            }
        } else {
            cellSet(scanning, false)
        }
    };
    if (cellGet(badSep)) Err("invalid '_' digit separator in numeric literal")
    else Ok(cellGet(count))
}

pub def tokenize(src: String): Result (Vec Token) String =
    tokenizeInFile(src, 0)

pub def tokenizeInFile(src: String, fileId: Int): Result (Vec Token) String = {
    let len = strLen(src);
    let out: Vec Token = vecNew();
    let tokBuf = bufNew();
    let i = cellNew(0);
    let errMsg = cellNew("");
    let failed = cellNew(false);

    // Skip optional Unix shebang (`#!...`) on line 1 while preserving line numbers
    if (len >= 2 && strByteAt(src, 0) == 35 && strByteAt(src, 1) == 33) {
        cellSet(i, 2);
        while (cellGet(i) < len && strByteAt(src, cellGet(i)) != 10) {
            cellSet(i, cellGet(i) + 1)
        }
    } else ();

    while (cellGet(i) < len && !cellGet(failed)) {
        let sawNl = cellNew(false);
        let skipping = cellNew(true);
        while (cellGet(skipping) && cellGet(i) < len && !cellGet(failed)) {
            let p = cellGet(i);
            let b = strByteAt(src, p);
            if (b == 32 || b == 9 || b == 13) {
                cellSet(i, p + 1)
            } else if (b == 10) {
                cellSet(sawNl, true);
                cellSet(i, p + 1)
            } else if (b == 47 && p + 1 < len && strByteAt(src, p + 1) == 47) {
                cellSet(i, p + 2);
                while (cellGet(i) < len && strByteAt(src, cellGet(i)) != 10) {
                    cellSet(i, cellGet(i) + 1)
                }
            } else if (b == 47 && p + 1 < len && strByteAt(src, p + 1) == 42) {
                cellSet(i, p + 2);
                let closed = cellNew(false);
                while (cellGet(i) + 1 < len && !cellGet(closed)) {
                    let k = cellGet(i);
                    if (strByteAt(src, k) == 10) cellSet(sawNl, true) else ();
                    if (strByteAt(src, k) == 42 && strByteAt(src, k + 1) == 47) {
                        cellSet(i, k + 2);
                        cellSet(closed, true)
                    } else {
                        cellSet(i, k + 1)
                    }
                };
                if (!cellGet(closed)) {
                    cellSet(errMsg, formatDiagAt("Lex error", fileId, p, p + 2, "unterminated block comment"));
                    cellSet(failed, true)
                } else ()
            } else {
                cellSet(skipping, false)
            }
        };

        if (!cellGet(failed) && cellGet(i) < len) {
            let start = cellGet(i);
            let b = strByteAt(src, start);
            let nl = cellGet(sawNl);

            if (b == 40) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkLParen, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 41) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkRParen, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 123) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkLBrace, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 125) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkRBrace, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 91) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkLBracket, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 93) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkRBracket, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 44) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkComma, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 59) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkSemi, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (b == 46) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkDot, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (isIdentStartByte(b)) {
                cellSet(i, start + 1);
                while (cellGet(i) < len && isIdentContByte(strByteAt(src, cellGet(i)))) {
                    cellSet(i, cellGet(i) + 1)
                };
                let end = cellGet(i);
                let word = sliceIntoBuf(tokBuf, src, start, end);
                vecPush(out, MkToken { kind: classifyWord(word), span: MkSpan { fileId: fileId, start: start, end: end }, hadNewline: nl })
            } else if (isDigitByte(b)) {
                bufClear(tokBuf);
                let radix =
                    if (b == 48 && start + 1 < len) {
                        let b1 = strByteAt(src, start + 1);
                        if (b1 == 120 || b1 == 88) 16
                        else if (b1 == 111 || b1 == 79) 8
                        else if (b1 == 98 || b1 == 66) 2
                        else 10
                    } else 10;

                if (radix != 10) {
                    bufPushByte(tokBuf, 48);
                    bufPushByte(tokBuf, if (radix == 16) 120 else if (radix == 8) 111 else 98);
                    cellSet(i, start + 2);
                    match scanDigitsToBuf(src, len, i, radix, true, tokBuf) {
                        Err(msg) -> {
                            cellSet(errMsg, formatDiagAt("Lex error", fileId, start, cellGet(i) + 1, msg));
                            cellSet(failed, true)
                        },
                        Ok(dcount) ->
                            if (dcount == 0) {
                                let errEnd = if (cellGet(i) < len) cellGet(i) + 1 else cellGet(i);
                                cellSet(errMsg, formatDiagAt("Lex error", fileId, start, errEnd, "expected digits after base prefix"));
                                cellSet(failed, true)
                            } else if (cellGet(i) < len && isIdentContByte(strByteAt(src, cellGet(i)))) {
                                cellSet(errMsg, formatDiagAt("Lex error", fileId, start, cellGet(i) + 1, "invalid digit in radix integer literal"));
                                cellSet(failed, true)
                            } else {
                                let end = cellGet(i);
                                vecPush(out, MkToken { kind: TkInt(bufToString(tokBuf)), span: MkSpan { fileId: fileId, start: start, end: end }, hadNewline: nl })
                            },
                    }
                } else {
                    match scanDigitsToBuf(src, len, i, 10, false, tokBuf) {
                        Err(msg) -> {
                            cellSet(errMsg, formatDiagAt("Lex error", fileId, start, cellGet(i) + 1, msg));
                            cellSet(failed, true)
                        },
                        Ok(_) -> {
                            let isFloat = cellNew(false);
                            if (cellGet(i) + 1 < len && strByteAt(src, cellGet(i)) == 46 && isDigitByte(strByteAt(src, cellGet(i) + 1))) {
                                cellSet(isFloat, true);
                                bufPushByte(tokBuf, 46);
                                cellSet(i, cellGet(i) + 1);
                                match scanDigitsToBuf(src, len, i, 10, false, tokBuf) {
                                    Err(fmsg) -> {
                                        cellSet(errMsg, formatDiagAt("Lex error", fileId, start, cellGet(i) + 1, fmsg));
                                        cellSet(failed, true)
                                    },
                                    Ok(_) ->
                                        if (cellGet(i) < len && (strByteAt(src, cellGet(i)) == 101 || strByteAt(src, cellGet(i)) == 69)) {
                                            let expStart = cellGet(i);
                                            let expSaveLen = strLen(bufToString(tokBuf));
                                            bufPushByte(tokBuf, strByteAt(src, expStart));
                                            cellSet(i, expStart + 1);
                                            if (cellGet(i) < len && (strByteAt(src, cellGet(i)) == 43 || strByteAt(src, cellGet(i)) == 45)) {
                                                bufPushByte(tokBuf, strByteAt(src, cellGet(i)));
                                                cellSet(i, cellGet(i) + 1)
                                            } else ();
                                            match scanDigitsToBuf(src, len, i, 10, false, tokBuf) {
                                                Err(emsg) -> {
                                                    cellSet(errMsg, formatDiagAt("Lex error", fileId, start, cellGet(i) + 1, emsg));
                                                    cellSet(failed, true)
                                                },
                                                Ok(expDigits) ->
                                                    if (expDigits == 0) {
                                                        cellSet(i, expStart);
                                                        let preExp = ptrSliceFromStr(bufToString(tokBuf), 0, expSaveLen);
                                                        bufClear(tokBuf);
                                                        let j = cellNew(0);
                                                        while (cellGet(j) < expSaveLen) {
                                                            bufPushByte(tokBuf, strByteAt(preExp, cellGet(j)));
                                                            cellSet(j, cellGet(j) + 1)
                                                        }
                                                    } else (),
                                            }
                                        } else (),
                                }
                            } else ();

                            if (!cellGet(failed)) {
                                if (cellGet(i) < len && strByteAt(src, cellGet(i)) == 95) {
                                    cellSet(errMsg, formatDiagAt("Lex error", fileId, start, cellGet(i) + 1, "invalid trailing '_' in numeric literal"));
                                    cellSet(failed, true)
                                } else {
                                    let end = cellGet(i);
                                    let cleanNum = bufToString(tokBuf);
                                    let k = if (cellGet(isFloat)) TkFloat(cleanNum) else TkInt(cleanNum);
                                    vecPush(out, MkToken { kind: k, span: MkSpan { fileId: fileId, start: start, end: end }, hadNewline: nl })
                                }
                            } else ()
                        },
                    }
                }
            } else if (b == 34) {
                // String literal `"..."`
                cellSet(i, start + 1);
                let sbuf = bufNew();
                let doneStr = cellNew(false);
                while (cellGet(i) < len && !cellGet(doneStr) && !cellGet(failed)) {
                    let cur = cellGet(i);
                    let ch = strByteAt(src, cur);
                    if (ch == 34) {
                        cellSet(i, cur + 1);
                        cellSet(doneStr, true)
                    } else if (ch == 92) {
                        if (cur + 1 >= len) {
                            cellSet(errMsg, formatDiagAt("Lex error", fileId, cur, cur + 1, "unterminated string escape"));
                            cellSet(failed, true)
                        } else {
                            match unescapeByte(strByteAt(src, cur + 1), fileId, cur) {
                                Ok(ub) -> {
                                    bufPushByte(sbuf, ub);
                                    cellSet(i, cur + 2)
                                },
                                Err(e) -> {
                                    cellSet(errMsg, e);
                                    cellSet(failed, true)
                                },
                            }
                        }
                    } else {
                        bufPushByte(sbuf, ch);
                        cellSet(i, cur + 1)
                    }
                };
                if (!cellGet(failed) && !cellGet(doneStr)) {
                    cellSet(errMsg, formatDiagAt("Lex error", fileId, start, start + 1, "unterminated string literal"));
                    cellSet(failed, true)
                } else if (!cellGet(failed)) {
                    let end = cellGet(i);
                    vecPush(out, MkToken { kind: TkStr(bufToString(sbuf)), span: MkSpan { fileId: fileId, start: start, end: end }, hadNewline: nl })
                } else ()
            } else if (b == 39) {
                // Char literal `'a'` or `'\n'`
                if (start + 2 >= len) {
                    cellSet(errMsg, formatDiagAt("Lex error", fileId, start, start + 1, "unterminated char literal"));
                    cellSet(failed, true)
                } else if (strByteAt(src, start + 1) == 92) {
                    if (start + 3 >= len || strByteAt(src, start + 3) != 39) {
                        cellSet(errMsg, formatDiagAt("Lex error", fileId, start, start + 2, "invalid escaped char literal"));
                        cellSet(failed, true)
                    } else {
                        match unescapeByte(strByteAt(src, start + 2), fileId, start + 1) {
                            Ok(cb) -> {
                                cellSet(i, start + 4);
                                vecPush(out, MkToken { kind: TkChar(cb), span: MkSpan { fileId: fileId, start: start, end: start + 4 }, hadNewline: nl })
                            },
                            Err(e) -> {
                                cellSet(errMsg, e);
                                cellSet(failed, true)
                            },
                        }
                    }
                } else if (strByteAt(src, start + 2) == 39) {
                    let cb = strByteAt(src, start + 1);
                    cellSet(i, start + 3);
                    vecPush(out, MkToken { kind: TkChar(cb), span: MkSpan { fileId: fileId, start: start, end: start + 3 }, hadNewline: nl })
                } else {
                    cellSet(errMsg, formatDiagAt("Lex error", fileId, start, start + 1, "multi-byte or invalid char literal"));
                    cellSet(failed, true)
                }
            } else if (b == 63 && !(start + 1 < len && (strByteAt(src, start + 1) == 63 || strByteAt(src, start + 1) == 62 || strByteAt(src, start + 1) == 61 || strByteAt(src, start + 1) == 58))) {
                cellSet(i, start + 1);
                vecPush(out, MkToken { kind: TkQuestion, span: MkSpan { fileId: fileId, start: start, end: start + 1 }, hadNewline: nl })
            } else if (isOpByte(b)) {
                cellSet(i, start + 1);
                let keepOp = cellNew(true);
                while (cellGet(i) < len && cellGet(keepOp)) {
                    let cur = cellGet(i);
                    let nb = strByteAt(src, cur);
                    // Stop before `//` or `/*` comment start!
                    if (nb == 47 && cur + 1 < len && (strByteAt(src, cur + 1) == 47 || strByteAt(src, cur + 1) == 42)) {
                        cellSet(keepOp, false)
                    } else if (isOpByte(nb)) {
                        cellSet(i, cur + 1)
                    } else {
                        cellSet(keepOp, false)
                    }
                };
                let end = cellGet(i);
                vecPush(out, MkToken { kind: TkSym(sliceIntoBuf(tokBuf, src, start, end)), span: MkSpan { fileId: fileId, start: start, end: end }, hadNewline: nl })
            } else {
                cellSet(errMsg, formatDiagAt("Lex error", fileId, start, start + 1, "unexpected character (ASCII " + intToStr(b) + ")"));
                cellSet(failed, true)
            }
        } else ()
    };

    if (cellGet(failed)) Err(cellGet(errMsg))
    else {
        vecPush(out, MkToken { kind: TkEof, span: MkSpan { fileId: fileId, start: len, end: len }, hadNewline: true });
        Ok(out)
    }
}
