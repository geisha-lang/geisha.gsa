// Microbenchmark Runner (`geisha bench [file.gsa|filter] [--iters N] [--warmup N] [--rounds N] [--filter <pat>] [--json]`)

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend}
use std.buf.{StringBuf, bufNew, bufPushStr, bufPushByte, bufToString}
use std.str.{strStartsWith, strEndsWith, strTrim, strSplitChar, strJoin, intToStr, parseInt}
use std.path.{pathJoin, pathDirname, pathStem}
use std.codec.{Value, VObj, VStr, VInt, VFloat}
use std.json.{parse, stringify}
use sys.fs.{fileExists, isDir, readFile, removeFile, mkdirAll, readDir}
use sys.io.eprintLn
use ast.{
    Span, emptySpan, ModuleItem, ModDef, Item, ItForm, ExAbs, sortUniqueStrings, addUniqueStr
}
use diag.{diagReset, diagRegisterFile, formatSpanDiag}
use parser.parseFileModuleInFile
use loader.{PkgSpec, MkPkgSpec}
use pkg.{
    Manifest, TargetCfg, MkTargetCfg, CompileCallbacks,
    geishaHomeDir, findProjectRoot, resolveProjectGraph, toLoaderPkgSpecs,
    sanitizeIdentAlias, resolveRelList, mergeTargetConfigs
}

extern "getpid" def c_bench_getpid(): Int
extern "gs_proc_spawn" def c_bench_proc_spawn(
    program: String,
    argBlob: String,
    argc: Int,
    cwd: String,
    envMode: Int,
    envBlob: String,
    envc: Int,
    stdioPacked: Int,
    ownGroup: Int,
    outInts: Ptr
): Int
extern "gs_proc_wait" def c_bench_proc_wait(pid: Int, nohang: Int): Int64
extern "gs_pipe_read" def c_bench_pipe_read(fd: Int, buf: Ptr, cap: Int): Int
extern "gs_pipe_close" def c_bench_pipe_close(fd: Int): Int
extern "gs_pipe_poll2" def c_bench_pipe_poll2(fd0: Int, fd1: Int, timeoutMs: Int): Int

data BenchCliOpts {
    MkBenchCliOpts {
        bFile: Option String,
        bFilter: Option String,
        bIters: Option Int,
        bWarmup: Option Int,
        bRounds: Option Int,
        bJson: Bool,
    },
}

data InspectedBenchFile {
    MkInspectedBenchFile {
        ibHasMain: Bool,
        ibBenchFns: List String,
    },
}

def parsePositiveIntArg(flag: String, raw: String, minVal: Int): Result Int String =
    match parseInt(raw) {
        Ok(v) if (v >= minVal) -> Ok(v),
        _ -> Err("invalid integer for '" + flag + "': '" + raw + "' (expected >= " + intToStr(minVal) + ")"),
    }

def parseBenchSubArgs(args: List String, jsonFromTop: Bool): Result BenchCliOpts String = {
    let fileOpt: Cell (Option String) = cellNew(None);
    let filterOpt: Cell (Option String) = cellNew(None);
    let itersOpt: Cell (Option Int) = cellNew(None);
    let warmupOpt: Cell (Option Int) = cellNew(None);
    let roundsOpt: Cell (Option Int) = cellNew(None);
    let jsonFlag = cellNew(jsonFromTop);
    let errOpt: Cell (Option String) = cellNew(None);

    let cur = cellNew(args);
    while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(a, rest) -> {
                if (a == "--json") {
                    cellSet(jsonFlag, true);
                    cellSet(cur, rest)
                } else if (a == "--iters") {
                    match rest {
                        Cons(val, r2) -> {
                            match parsePositiveIntArg("--iters", val, 1) {
                                Ok(n) -> cellSet(itersOpt, Some(n)),
                                Err(e) -> cellSet(errOpt, Some(e)),
                            };
                            cellSet(cur, r2)
                        },
                        Nil -> cellSet(errOpt, Some("missing integer after '--iters'")),
                    }
                } else if (a == "--warmup") {
                    match rest {
                        Cons(val, r2) -> {
                            match parsePositiveIntArg("--warmup", val, 0) {
                                Ok(n) -> cellSet(warmupOpt, Some(n)),
                                Err(e) -> cellSet(errOpt, Some(e)),
                            };
                            cellSet(cur, r2)
                        },
                        Nil -> cellSet(errOpt, Some("missing integer after '--warmup'")),
                    }
                } else if (a == "--rounds") {
                    match rest {
                        Cons(val, r2) -> {
                            match parsePositiveIntArg("--rounds", val, 1) {
                                Ok(n) -> cellSet(roundsOpt, Some(n)),
                                Err(e) -> cellSet(errOpt, Some(e)),
                            };
                            cellSet(cur, r2)
                        },
                        Nil -> cellSet(errOpt, Some("missing integer after '--rounds'")),
                    }
                } else if (a == "--filter") {
                    match rest {
                        Cons(val, r2) -> {
                            cellSet(filterOpt, Some(val));
                            cellSet(cur, r2)
                        },
                        Nil -> cellSet(errOpt, Some("missing pattern after '--filter'")),
                    }
                } else if (strLen(a) > 0 && strByteAt(a, 0) == 45) {
                    cellSet(errOpt, Some("unknown option for 'geisha bench': '" + a + "'"))
                } else {
                    let looksLikeFile = strEndsWith(a, ".gsa") || (fileExists(a) && !isDir(a));
                    if (looksLikeFile && match cellGet(fileOpt) { None -> true, Some(_) -> false }) {
                        cellSet(fileOpt, Some(a));
                        cellSet(cur, rest)
                    } else if (match cellGet(filterOpt) { None -> true, Some(_) -> false }) {
                        cellSet(filterOpt, Some(a));
                        cellSet(cur, rest)
                    } else {
                        cellSet(errOpt, Some("unexpected argument for 'geisha bench': '" + a + "'"))
                    }
                }
            },
            Nil -> (),
        }
    };

    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None -> Ok(MkBenchCliOpts {
            bFile: cellGet(fileOpt),
            bFilter: cellGet(filterOpt),
            bIters: cellGet(itersOpt),
            bWarmup: cellGet(warmupOpt),
            bRounds: cellGet(roundsOpt),
            bJson: cellGet(jsonFlag),
        }),
    }
}

def strContainsSub(hay: String, needle: String): Bool = {
    let hl = strLen(hay);
    let nl = strLen(needle);
    if (nl == 0) true
    else if (nl > hl) false
    else {
        let i = cellNew(0);
        let found = cellNew(false);
        let limit = hl - nl;
        while (cellGet(i) <= limit && !cellGet(found)) {
            let start = cellGet(i);
            let j = cellNew(0);
            let ok = cellNew(true);
            while (cellGet(j) < nl && cellGet(ok)) {
                if (strByteAt(hay, start + cellGet(j)) != strByteAt(needle, cellGet(j))) {
                    cellSet(ok, false)
                } else ();
                cellSet(j, cellGet(j) + 1)
            };
            if (cellGet(ok)) cellSet(found, true) else cellSet(i, start + 1)
        };
        cellGet(found)
    }
}

def inspectBenchFile(filePath: String, src: String): Result InspectedBenchFile String = {
    diagReset();
    let fid = diagRegisterFile(filePath, src);
    let fm = parseFileModuleInFile(src, Nil, fid)?;
    let mainSpanOpt: Cell (Option Span) = cellNew(None);
    let fnsRev: Cell (List String) = cellNew(Nil);
    let errOpt: Cell (Option String) = cellNew(None);
    let cur = cellNew(fm.items);
    while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(_, d), rest) -> {
                if (d.ident == "main") {
                    cellSet(mainSpanOpt, Some(d.dpos))
                } else if (strStartsWith(d.ident, "bench_")) {
                    match d.item {
                        ItForm(f) -> match f.node {
                            ExAbs(Nil, _, _) -> cellSet(fnsRev, Cons(d.ident, cellGet(fnsRev))),
                            ExAbs(_, _, _) ->
                                cellSet(errOpt, Some(formatSpanDiag(
                                    "Bench error",
                                    d.dpos,
                                    "benchmark function '" + d.ident + "' must take zero parameters (use `def " + d.ident + "(): ...`)"
                                ))),
                            _ ->
                                cellSet(errOpt, Some(formatSpanDiag(
                                    "Bench error",
                                    d.dpos,
                                    "benchmark item '" + d.ident + "' must be a zero-parameter function (use `def " + d.ident + "(): ...`)"
                                ))),
                        },
                        _ -> (),
                    }
                } else ();
                cellSet(cur, rest)
            },
            Cons(_, rest) -> cellSet(cur, rest),
            Nil -> (),
        }
    };
    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None -> {
            let fns = listRev(cellGet(fnsRev));
            let hasFns = match fns { Cons(_, _) -> true, Nil -> false };
            match cellGet(mainSpanOpt) {
                Some(msp) if (hasFns) ->
                    Err(formatSpanDiag(
                        "Bench error",
                        msp,
                        "cannot mix `bench_*` functions with `def main` or top-level script statements in the same benchmark file"
                    )),
                Some(_) -> Ok(MkInspectedBenchFile { ibHasMain: true, ibBenchFns: Nil }),
                None -> Ok(MkInspectedBenchFile { ibHasMain: false, ibBenchFns: fns }),
            }
        },
    }
}

// Replace leading `#!...` with `//...` while preserving the trailing `\n` so user line numbers stay 1:1.
def neutralizeShebangPreserveLines(src: String): String =
    if (strStartsWith(src, "#!")) {
        let n = strLen(src);
        let i = cellNew(0);
        while (cellGet(i) < n && strByteAt(src, cellGet(i)) != 10) {
            cellSet(i, cellGet(i) + 1)
        };
        let rest = if (cellGet(i) < n) strSlice(src, cellGet(i), n) else "";
        "//" + rest
    } else {
        src
    }

def escapeGeishaStrLit(s: String): String = {
    let b = bufNew();
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let ch = strByteAt(s, cellGet(i));
        if (ch == 34) bufPushStr(b, "\\\"")
        else if (ch == 92) bufPushStr(b, "\\\\")
        else bufPushByte(b, ch);
        cellSet(i, cellGet(i) + 1)
    };
    bufToString(b)
}

// Append harness at EOF so all user source lines remain at their exact original 1-based line numbers.
def synthesizeBenchHarnessSource(origSrc: String, benchFns: List String): String = {
    let b = bufNew();
    bufPushStr(b, neutralizeShebangPreserveLines(origSrc));
    bufPushStr(b, "\n\nuse std.bench as __gs_bench_rt\n\ndef main(): Void = {\n");
    bufPushStr(b, "    let __cfg = __gs_bench_rt.envConfig();\n");
    let cur = cellNew(benchFns);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(fnName, rest) -> {
                bufPushStr(b, "    let _ = __gs_bench_rt.benchWith(\"");
                bufPushStr(b, escapeGeishaStrLit(fnName));
                bufPushStr(b, "\", __cfg, () -> { let _ = ");
                bufPushStr(b, fnName);
                bufPushStr(b, "(); () });\n");
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    bufPushStr(b, "    ()\n}\n");
    bufToString(b)
}

def filterBenchFnNames(fns: List String, filePath: String, filterOpt: Option String): List String =
    match filterOpt {
        None -> fns,
        Some(pat) if (strLen(pat) == 0) -> fns,
        Some(pat) ->
            if (strContainsSub(filePath, pat)) fns
            else {
                let acc: Cell (List String) = cellNew(Nil);
                let cur = cellNew(fns);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(nm, rest) -> {
                            if (strContainsSub(nm, pat)) cellSet(acc, Cons(nm, cellGet(acc))) else ();
                            cellSet(cur, rest)
                        },
                        Nil -> (),
                    }
                };
                listRev(cellGet(acc))
            },
    }

def listSortedGsaFilesInDir(dir: String): Result (List String) String = {
    let entries = readDir(dir)?;
    let gsaFiles: Cell (List String) = cellNew(Nil);
    let cur = cellNew(sortUniqueStrings(entries));
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(nm, r) -> {
                if (strEndsWith(nm, ".gsa")) {
                    cellSet(gsaFiles, listAppend(cellGet(gsaFiles), [pathJoin(dir, nm)]))
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    Ok(cellGet(gsaFiles))
}

def discoverProjectBenchFiles(projectDir: String, mf: Manifest): Result (List String) String =
    match mf.mfBenches {
        Cons(_, _) -> Ok(resolveRelList(projectDir, mf.mfBenches)),
        Nil -> {
            let benchesDir = pathJoin(projectDir, "benches");
            if (isDir(benchesDir)) {
                let fs = listSortedGsaFilesInDir(benchesDir)?;
                match fs {
                    Nil -> Err("no .gsa benchmark files found under '" + benchesDir + "'"),
                    _ -> Ok(fs),
                }
            } else {
                let srcDir = pathJoin(projectDir, mf.mfSrcDir);
                if (!isDir(srcDir)) {
                    Err("no 'benches/' directory or 'benches = [...]' entry in geisha.toml")
                } else {
                    let srcFiles = listSortedGsaFilesInDir(srcDir)?;
                    let matched: Cell (List String) = cellNew(Nil);
                    let errOpt: Cell (Option String) = cellNew(None);
                    let cur = cellNew(srcFiles);
                    while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(sf, r) -> {
                                match readFile(sf) {
                                    Ok(raw) -> match inspectBenchFile(sf, raw) {
                                        Ok(info) -> match info.ibBenchFns {
                                            Cons(_, _) -> cellSet(matched, listAppend(cellGet(matched), [sf])),
                                            Nil -> (),
                                        },
                                        Err(e) -> cellSet(errOpt, Some(e)),
                                    },
                                    Err(e) -> cellSet(errOpt, Some(e)),
                                };
                                cellSet(cur, r)
                            },
                            Nil -> (),
                        }
                    };
                    match cellGet(errOpt) {
                        Some(e) -> Err(e),
                        None -> match cellGet(matched) {
                            Nil -> Err("no 'benches/' directory, 'benches = [...]' entry in geisha.toml, or 'bench_*' functions in '" + srcDir + "'"),
                            xs -> Ok(xs),
                        },
                    }
                }
            }
        },
    }

def emptyBenchTargetCfg(): TargetCfg = MkTargetCfg {
    tcCSources: Nil,
    tcCFlags: Nil,
    tcLinkFlags: Nil,
    tcExtraUnits: Nil,
    tcExports: Nil,
    tcWebAssets: Nil,
    tcOwnsMain: false,
    tcBootSymbol: None,
}

def buildBenchEnvVars(
    filePath: String,
    bOpts: BenchCliOpts,
    passFilterToChild: Bool
): List (String, String) = {
    let vars: Cell (List (String, String)) = cellNew([
        ("GEISHA_BENCH_FILE", filePath),
        ("GEISHA_BENCH_JSON", if (bOpts.bJson) "1" else "0"),
    ]);
    if (passFilterToChild) {
        match bOpts.bFilter {
            Some(pat) if (strLen(pat) > 0) ->
                cellSet(vars, listAppend(cellGet(vars), [("GEISHA_BENCH_FILTER", pat)])),
            _ -> (),
        }
    } else {
        cellSet(vars, listAppend(cellGet(vars), [("GEISHA_BENCH_FILTER", "")]))
    };
    match bOpts.bIters {
        Some(n) -> cellSet(vars, listAppend(cellGet(vars), [("GEISHA_BENCH_ITERS", intToStr(n))])),
        None -> (),
    };
    match bOpts.bWarmup {
        Some(n) -> cellSet(vars, listAppend(cellGet(vars), [("GEISHA_BENCH_WARMUP", intToStr(n))])),
        None -> (),
    };
    match bOpts.bRounds {
        Some(n) -> cellSet(vars, listAppend(cellGet(vars), [("GEISHA_BENCH_ROUNDS", intToStr(n))])),
        None -> (),
    };
    cellGet(vars)
}

def packBenchArgBlob(prog: String): (String, Int) = {
    let b = bufNew();
    bufPushStr(b, prog);
    bufPushByte(b, 0);
    (bufToString(b), 1)
}

def packBenchEnvBlob(vars: List (String, String)): (String, Int) = {
    let b = bufNew();
    let count = cellNew(0);
    let cur = cellNew(vars);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((k, v), rest) -> {
                bufPushStr(b, k);
                bufPushByte(b, 61);
                bufPushStr(b, v);
                bufPushByte(b, 0);
                cellSet(count, cellGet(count) + 1);
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    (bufToString(b), cellGet(count))
}

def readI32Le(p: Ptr, off: Int): Int =
    ptrByteAt(p, off)
    | (ptrByteAt(p, off + 1) << 8)
    | (ptrByteAt(p, off + 2) << 16)
    | (ptrByteAt(p, off + 3) << 24)

def pushPtrBytes(b: StringBuf, p: Ptr, n: Int): Void = {
    let i = cellNew(0);
    while (cellGet(i) < n) {
        bufPushByte(b, ptrByteAt(p, cellGet(i)));
        cellSet(i, cellGet(i) + 1)
    }
}

// Spawn benchmark binary directly via posix_spawnp (no `/bin/sh`, no `.tmp` files).
// Text mode inherits stdout/stderr for real-time streaming; JSON mode pipes stdout/stderr for aggregation.
def execBenchBinDirect(
    outBin: String,
    workDirOpt: Option String,
    envVars: List (String, String),
    capturePipes: Bool
): Result (Int, Int, String, String) String = {
    let (argBlob, argc) = packBenchArgBlob(outBin);
    let (envBlob, envc) = packBenchEnvBlob(envVars);
    let cwdStr = match workDirOpt { Some(wd) -> wd, None -> "" };
    // stdioPacked: stdin=Inherit(0), stdout/stderr=Piped(2) when capturePipes else Inherit(0)
    let stdioPacked = if (capturePipes) (0 | (2 << 2) | (2 << 4)) else 0;
    let outInts = ptrAllocBytes(16);
    let rc = c_bench_proc_spawn(outBin, argBlob, argc, cwdStr, 1, envBlob, envc, stdioPacked, 0, outInts);
    if (rc != 0) {
        Err("failed to spawn benchmark binary '" + outBin + "'")
    } else {
        let pid = readI32Le(outInts, 0);
        let outFd = cellNew(readI32Le(outInts, 8));
        let errFd = cellNew(readI32Le(outInts, 12));
        let outBuf = bufNew();
        let errBuf = bufNew();
        if (capturePipes) {
            let scratch = ptrAllocBytes(16384);
            let ioDone = cellNew(false);
            while (!cellGet(ioDone) && (cellGet(outFd) >= 0 || cellGet(errFd) >= 0)) {
                let mask = c_bench_pipe_poll2(cellGet(outFd), cellGet(errFd), -1);
                if (mask <= 0) {
                    cellSet(ioDone, true)
                } else {
                    if ((mask & 1) != 0 && cellGet(outFd) >= 0) {
                        let n = c_bench_pipe_read(cellGet(outFd), scratch, 16384);
                        if (n <= 0) { let _ = c_bench_pipe_close(cellGet(outFd)); cellSet(outFd, -1) }
                        else pushPtrBytes(outBuf, scratch, n)
                    } else ();
                    if ((mask & 2) != 0 && cellGet(errFd) >= 0) {
                        let n = c_bench_pipe_read(cellGet(errFd), scratch, 16384);
                        if (n <= 0) { let _ = c_bench_pipe_close(cellGet(errFd)); cellSet(errFd, -1) }
                        else pushPtrBytes(errBuf, scratch, n)
                    } else ()
                }
            };
            if (cellGet(outFd) >= 0) { let _ = c_bench_pipe_close(cellGet(outFd)); () } else ();
            if (cellGet(errFd) >= 0) { let _ = c_bench_pipe_close(cellGet(errFd)); () } else ()
        } else ();

        let rawWait = c_bench_proc_wait(pid, 0);
        if (rawWait <= intToI64(0)) {
            Err("waitpid failed for benchmark binary '" + outBin + "'")
        } else {
            let tag = i64ToInt(rawWait >>> 32);
            let lowMask = (intToI64(65535) << 16) | intToI64(65535);
            let code = i64ToInt(rawWait & lowMask);
            Ok((tag, code, bufToString(outBuf), bufToString(errBuf)))
        }
    }
}

def isBenchStatsJsonObj(fields: List (String, Value)): Bool = {
    let hasName = cellNew(false);
    let hasMeanNs = cellNew(false);
    let hasOpsPerSec = cellNew(false);
    let cur = cellNew(fields);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((k, v), rest) -> {
                if (k == "name") {
                    match v { VStr(_) -> cellSet(hasName, true), _ -> () }
                } else if (k == "mean_ns") {
                    match v { VFloat(_) -> cellSet(hasMeanNs, true), VInt(_) -> cellSet(hasMeanNs, true), _ -> () }
                } else if (k == "ops_per_sec") {
                    match v { VFloat(_) -> cellSet(hasOpsPerSec, true), VInt(_) -> cellSet(hasOpsPerSec, true), _ -> () }
                } else ();
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    cellGet(hasName) && cellGet(hasMeanNs) && cellGet(hasOpsPerSec)
}

def collectJsonLines(stdout: String, accRev: Cell (List String)): Int = {
    let lines = strSplitChar(stdout, '\n');
    let cur = cellNew(lines);
    let count = cellNew(0);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(line, rest) -> {
                let t = strTrim(line);
                let isBenchRec =
                    if (strStartsWith(t, "{") && strEndsWith(t, "}")) {
                        match parse(t) {
                            Ok(VObj(fields)) -> isBenchStatsJsonObj(fields),
                            _ -> false,
                        }
                    } else false;
                if (isBenchRec) {
                    cellSet(accRev, Cons(t, cellGet(accRev)));
                    cellSet(count, cellGet(count) + 1)
                } else if (strLen(t) > 0) {
                    eprintLn(line)
                } else ();
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    cellGet(count)
}

def withBenchFileDirInRootSpec(rootSpec: PkgSpec, bf: String): PkgSpec = {
    let dir = pathDirname(bf);
    let dirs =
        if (dir != "" && dir != ".") addUniqueStr(rootSpec.srcRoots, dir)
        else rootSpec.srcRoots;
    MkPkgSpec {
        pkgId: rootSpec.pkgId,
        pkgName: rootSpec.pkgName,
        srcRoots: dirs,
        deps: rootSpec.deps,
    }
}

def runSingleBenchFile(
    bf: String,
    explicitSingle: Bool,
    workDirOpt: Option String,
    buildDir: String,
    removeBinAfter: Bool,
    rootSpec0: PkgSpec,
    extSpecs: List PkgSpec,
    benchTc: TargetCfg,
    bOpts: BenchCliOpts,
    rtOverrideOpt: Option String,
    cbs: CompileCallbacks,
    jsonLinesRev: Cell (List String),
    filesRunCell: Cell Int
): Result Void String = {
    let src = readFile(bf)?;
    let info = inspectBenchFile(bf, src)?;
    let hasBenchFns = match info.ibBenchFns { Cons(_, _) -> true, Nil -> false };
    let rootSpec = withBenchFileDirInRootSpec(rootSpec0, bf);

    if (!info.ibHasMain && !hasBenchFns) {
        if (explicitSingle) {
            Err("no 'bench_*' functions or 'main' found in '" + bf + "'")
        } else {
            Ok(())
        }
    } else if (!info.ibHasMain && hasBenchFns) {
        let selectedFns = filterBenchFnNames(info.ibBenchFns, bf, bOpts.bFilter);
        match selectedFns {
            Nil -> Ok(()),
            _ -> {
                let stem = pathStem(bf);
                let pidStr = intToStr(c_bench_getpid());
                let outBin = pathJoin(buildDir, "bench_" + stem + "_" + pidStr);
                let harnessSrc = synthesizeBenchHarnessSource(src, selectedFns);
                cbs.cbCompileNativeExeSource(
                    bf, harnessSrc, rootSpec, extSpecs, benchTc, Some(outBin), rtOverrideOpt
                )?;

                let envVars = buildBenchEnvVars(bf, bOpts, false);
                let runRes = execBenchBinDirect(outBin, workDirOpt, envVars, bOpts.bJson);
                if (removeBinAfter) { let _ = removeFile(outBin); () } else ();
                let (tag, code, stdoutStr, stderrStr) = runRes?;
                if (tag == 2) {
                    Err("benchmark killed by signal " + intToStr(code) + " (" + bf + ")")
                } else if (code != 0) {
                    let detail = strTrim(stderrStr);
                    Err("benchmark failed (" + bf + ", exit " + intToStr(code) + ")" + (if (strLen(detail) > 0) ": " + detail else ""))
                } else {
                    cellSet(filesRunCell, cellGet(filesRunCell) + 1);
                    if (bOpts.bJson) {
                        let _ = collectJsonLines(stdoutStr, jsonLinesRev);
                        Ok(())
                    } else {
                        Ok(())
                    }
                }
            },
        }
    } else {
        // File defines explicit `main()`
        let stem = pathStem(bf);
        let pidStr = intToStr(c_bench_getpid());
        let outBin = pathJoin(buildDir, "bench_" + stem + "_" + pidStr);
        cbs.cbCompileNativeExe(bf, rootSpec, extSpecs, benchTc, Some(outBin), None, rtOverrideOpt)?;
        let passFilter = match bOpts.bFilter {
            None -> false,
            Some(pat) ->
                if (explicitSingle) true
                else !strContainsSub(bf, pat),
        };
        let envVars = buildBenchEnvVars(bf, bOpts, passFilter);
        let runRes = execBenchBinDirect(outBin, workDirOpt, envVars, bOpts.bJson);
        if (removeBinAfter) { let _ = removeFile(outBin); () } else ();
        let (tag, code, stdoutStr, stderrStr) = runRes?;
        if (tag == 2) {
            Err("benchmark killed by signal " + intToStr(code) + " (" + bf + ")")
        } else if (code != 0) {
            let detail = strTrim(stderrStr);
            Err("benchmark failed (" + bf + ", exit " + intToStr(code) + ")" + (if (strLen(detail) > 0) ": " + detail else ""))
        } else {
            if (bOpts.bJson) {
                let nAdded = collectJsonLines(stdoutStr, jsonLinesRev);
                if (nAdded > 0) cellSet(filesRunCell, cellGet(filesRunCell) + 1) else ();
                Ok(())
            } else {
                cellSet(filesRunCell, cellGet(filesRunCell) + 1);
                Ok(())
            }
        }
    }
}

def runBenchFilesList(
    files: List String,
    explicitSingle: Bool,
    workDirOpt: Option String,
    buildDir: String,
    removeBinAfter: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    benchTc: TargetCfg,
    bOpts: BenchCliOpts,
    rtOverrideOpt: Option String,
    cbs: CompileCallbacks,
    jsonLinesRev: Cell (List String),
    filesRunCell: Cell Int
): Result Void String = match files {
    Nil -> Ok(()),
    Cons(bf, rest) -> {
        runSingleBenchFile(
            bf, explicitSingle, workDirOpt, buildDir, removeBinAfter,
            rootSpec, extSpecs, benchTc, bOpts, rtOverrideOpt, cbs, jsonLinesRev, filesRunCell
        )?;
        runBenchFilesList(
            rest, explicitSingle, workDirOpt, buildDir, removeBinAfter,
            rootSpec, extSpecs, benchTc, bOpts, rtOverrideOpt, cbs, jsonLinesRev, filesRunCell
        )
    },
}

def printZeroBenchNotice(filterOpt: Option String): Void = match filterOpt {
    Some(pat) if (strLen(pat) > 0) -> printLn("No benchmarks matched filter '" + pat + "'."),
    _ -> printLn("No benchmarks were executed."),
}

def cmdBenchInner(
    bOpts: BenchCliOpts,
    rtOverrideOpt: Option String,
    cbs: CompileCallbacks
): Result Int String = {
    let jsonLinesRev: Cell (List String) = cellNew(Nil);
    let filesRunCell = cellNew(0);

    match bOpts.bFile {
        Some(gsaFile) -> {
            if (!fileExists(gsaFile)) {
                Err("benchmark file not found: '" + gsaFile + "'")
            } else {
                let fileDir = pathDirname(gsaFile);
                let searchRoot = if (fileDir == "") "." else fileDir;
                let (workDirOpt, buildDir, removeBinAfter, rootSpec, extSpecs, benchTc) =
                    match findProjectRoot(searchRoot) {
                        Some(projDir) -> {
                            let (rootMf, rootSpec0, resolvedPkgs) = resolveProjectGraph(projDir, false, None, true)?;
                            let extSpecs0 = toLoaderPkgSpecs(resolvedPkgs);
                            let selfPkgId = "__self_" + sanitizeIdentAlias(rootMf.mfName);
                            let selfPkgSpec = MkPkgSpec {
                                pkgId: selfPkgId,
                                pkgName: rootMf.mfName,
                                srcRoots: rootSpec0.srcRoots,
                                deps: rootSpec0.deps,
                            };
                            let benchRootDeps =
                                if (rootMf.mfName != "") listAppend(rootSpec0.deps, [(rootMf.mfName, selfPkgId)])
                                else rootSpec0.deps;
                            let benchSrcRoots = listAppend([searchRoot], rootSpec0.srcRoots);
                            let benchRootSpec = MkPkgSpec {
                                pkgId: "",
                                pkgName: "",
                                srcRoots: benchSrcRoots,
                                deps: benchRootDeps,
                            };
                            let mergedNative = mergeTargetConfigs(projDir, rootMf, resolvedPkgs, false, Nil, false, None);
                            let tc = MkTargetCfg {
                                tcCSources: if (mergedNative.tcOwnsMain) Nil else mergedNative.tcCSources,
                                tcCFlags: mergedNative.tcCFlags,
                                tcLinkFlags: if (mergedNative.tcOwnsMain) Nil else mergedNative.tcLinkFlags,
                                tcExtraUnits: if (mergedNative.tcOwnsMain) Nil else mergedNative.tcExtraUnits,
                                tcExports: Nil,
                                tcWebAssets: Nil,
                                tcOwnsMain: false,
                                tcBootSymbol: None,
                            };
                            let bd = pathJoin(projDir, "build/benches");
                            mkdirAll(bd)?;
                            (Some(projDir), bd, true, benchRootSpec, Cons(selfPkgSpec, extSpecs0), tc)
                        },
                        None -> {
                            let bd = pathJoin(pathJoin(geishaHomeDir(), "cache"), "benches");
                            mkdirAll(bd)?;
                            let rootSpec = MkPkgSpec {
                                pkgId: "",
                                pkgName: "",
                                srcRoots: [searchRoot],
                                deps: Nil,
                            };
                            (None, bd, true, rootSpec, Nil, emptyBenchTargetCfg())
                        },
                    };
                runSingleBenchFile(
                    gsaFile, true, workDirOpt, buildDir, removeBinAfter,
                    rootSpec, extSpecs, benchTc, bOpts, rtOverrideOpt, cbs, jsonLinesRev, filesRunCell
                )?;
                if (bOpts.bJson) {
                    printLn("{\"ok\":true,\"benchmarks\":[" + strJoin(listRev(cellGet(jsonLinesRev)), ",") + "]}")
                } else if (cellGet(filesRunCell) == 0) {
                    printZeroBenchNotice(bOpts.bFilter)
                } else ();
                Ok(0)
            }
        },
        None -> {
            match findProjectRoot(".") {
                None -> Err("no geisha.toml found and no .gsa file specified (usage: geisha bench [file.gsa|filter] [--iters N] [--warmup N] [--rounds N] [--filter <pat>] [--json])"),
                Some(projDir) -> {
                    let (rootMf, rootSpec0, resolvedPkgs) = resolveProjectGraph(projDir, false, None, true)?;
                    let benchFiles = discoverProjectBenchFiles(projDir, rootMf)?;
                    let extSpecs0 = toLoaderPkgSpecs(resolvedPkgs);
                    let selfPkgId = "__self_" + sanitizeIdentAlias(rootMf.mfName);
                    let selfPkgSpec = MkPkgSpec {
                        pkgId: selfPkgId,
                        pkgName: rootMf.mfName,
                        srcRoots: rootSpec0.srcRoots,
                        deps: rootSpec0.deps,
                    };
                    let benchRootDeps =
                        if (rootMf.mfName != "") listAppend(rootSpec0.deps, [(rootMf.mfName, selfPkgId)])
                        else rootSpec0.deps;
                    let benchesDir = pathJoin(projDir, "benches");
                    let benchSrcRoots =
                        if (isDir(benchesDir)) listAppend([benchesDir], rootSpec0.srcRoots)
                        else rootSpec0.srcRoots;
                    let benchRootSpec = MkPkgSpec {
                        pkgId: "",
                        pkgName: "",
                        srcRoots: benchSrcRoots,
                        deps: benchRootDeps,
                    };
                    let allExtSpecs = Cons(selfPkgSpec, extSpecs0);
                    let mergedNative = mergeTargetConfigs(projDir, rootMf, resolvedPkgs, false, Nil, false, None);
                    let benchTc = MkTargetCfg {
                        tcCSources: if (mergedNative.tcOwnsMain) Nil else mergedNative.tcCSources,
                        tcCFlags: mergedNative.tcCFlags,
                        tcLinkFlags: if (mergedNative.tcOwnsMain) Nil else mergedNative.tcLinkFlags,
                        tcExtraUnits: if (mergedNative.tcOwnsMain) Nil else mergedNative.tcExtraUnits,
                        tcExports: Nil,
                        tcWebAssets: Nil,
                        tcOwnsMain: false,
                        tcBootSymbol: None,
                    };
                    let buildDir = pathJoin(projDir, "build/benches");
                    mkdirAll(buildDir)?;

                    runBenchFilesList(
                        benchFiles, false, Some(projDir), buildDir, true,
                        benchRootSpec, allExtSpecs, benchTc, bOpts, rtOverrideOpt, cbs, jsonLinesRev, filesRunCell
                    )?;
                    if (bOpts.bJson) {
                        printLn("{\"ok\":true,\"benchmarks\":[" + strJoin(listRev(cellGet(jsonLinesRev)), ",") + "]}")
                    } else {
                        let n = cellGet(filesRunCell);
                        if (n == 0) printZeroBenchNotice(bOpts.bFilter)
                        else printLn("Completed benchmarks across " + intToStr(n) + " file(s).")
                    };
                    Ok(0)
                },
            }
        },
    }
}

pub def cmdBench(
    subArgs: List String,
    jsonFromTop: Bool,
    rtOverrideOpt: Option String,
    cbs: CompileCallbacks
): Result Int String = {
    let wantJson = jsonFromTop || {
        let cur = cellNew(subArgs);
        let found = cellNew(false);
        while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> { if (a == "--json") cellSet(found, true) else (); cellSet(cur, r) },
                Nil -> (),
            }
        };
        cellGet(found)
    };
    let res = match parseBenchSubArgs(subArgs, jsonFromTop) {
        Err(e) -> Err(e),
        Ok(bOpts) -> cmdBenchInner(bOpts, rtOverrideOpt, cbs),
    };
    match res {
        Ok(code) -> Ok(code),
        Err(msg) ->
            if (wantJson) {
                printLn("{\"ok\":false,\"error\":" + stringify(VStr(msg)) + "}");
                Ok(1)
            } else {
                Err(msg)
            },
    }
}
