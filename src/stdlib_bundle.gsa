    else if (key == "std.control") Some("// Higher-Kinded Control Abstractions (`std.control`)\n// Requires self-hosted Geisha compiler (HKT, superclasses, multi-param concepts & FunDeps).\n\nuse std.option.{Option, Some, None}\nuse std.list.{listRev}\n\npub concept Functor f {\n    def fmap(g: a -> b, fa: f a): f b\n}\n\npub concept Applicative f : Functor f {\n    def pure(x: a): f a,\n    def ap(ff: f (a -> b), fa: f a): f b\n}\n\npub concept Monad m : Applicative m {\n    def (>>=)(ma: m a, k: a -> m b): m b\n}\n\npub concept MonadState s m : Monad m | m -> s {\n    def get(): m s,\n    def put(st: s): m Void\n}\n\npub concept MonadReader r m : Monad m | m -> r {\n    def ask(): m r\n}\n\npub concept MonadError e m : Monad m | m -> e {\n    def throwErr(err: e): m a\n}\n\n// ============================================================================\n// Standard Operators & Polymorphic Combinators\n// ============================================================================\n\npub def (<$>)(g: a -> b, fa: f a): f b = fmap(g, fa)\n\npub def (<*>)(ff: f (a -> b), fa: f a): f b = ap(ff, fa)\n\npub def (>>)(ma: m a, mb: m b): m b = ma >>= (_) -> mb\n\npub def voidM(fa: f a): f Void = fmap((_) -> (), fa)\n\npub def modify(f: s -> s): m Void =\n    get() >>= (s) -> put(f(s))\n\npub def mapM(f: a -> m b, xs: List a): m (List b) =\n    mapMRev(f, xs, pure(Nil)) >>= (rev) -> pure(listRev(rev))\n\ndef mapMRev(f: a -> m b, xs: List a, acc: m (List b)): m (List b) = match xs {\n    Nil -> acc,\n    Cons(h, t) ->\n        f(h) >>= (b) ->\n        acc >>= (bs) ->\n        mapMRev(f, t, pure(Cons(b, bs))),\n}\n\npub def sequenceM(ms: List (m a)): m (List a) = match ms {\n    Nil -> pure(Nil),\n    Cons(mh, mt) ->\n        mh >>= (x) ->\n        sequenceM(mt) >>= (xs) ->\n        pure(Cons(x, xs)),\n}\n\n// ============================================================================\n// Standard Instances for `Option` and `List`\n// ============================================================================\n\ninstance Functor Option {\n    def fmap(g, opt) = match opt {\n        None -> None,\n        Some(x) -> Some(g(x)),\n    }\n}\n\ninstance Applicative Option {\n    def pure(x) = Some(x)\n    def ap(ofn, oa) = match (ofn, oa) {\n        (Some(f), Some(a)) -> Some(f(a)),\n        _ -> None,\n    }\n}\n\ninstance Monad Option {\n    def (>>=)(ma, k) = match ma {\n        None -> None,\n        Some(x) -> k(x),\n    }\n}\n\ninstance Functor List {\n    def fmap(g, xs) = mapListRev(g, xs, Nil)\n}\n\ndef mapListRev(g: a -> b, xs: List a, acc: List b): List b = match xs {\n    Nil -> listRev(acc),\n    Cons(h, t) -> mapListRev(g, t, Cons(g(h), acc)),\n}\n\ninstance Applicative List {\n    def pure(x) = [x]\n    def ap(fs, xs) = match fs {\n        Nil -> Nil,\n        Cons(f, fr) -> appendLists(fmap(f, xs), ap(fr, xs)),\n    }\n}\n\ndef appendLists(xs: List a, ys: List a): List a = match xs {\n    Nil -> ys,\n    Cons(h, t) -> Cons(h, appendLists(t, ys)),\n}\n\ninstance Monad List {\n    def (>>=)(xs, k) = match xs {\n        Nil -> Nil,\n        Cons(h, t) -> appendLists(k(h), t >>= k),\n    }\n}\n")
