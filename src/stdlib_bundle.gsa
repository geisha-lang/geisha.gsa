tance SimdVec L8 U16 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L4 Int Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L4 U32 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L2 Int64 Int64 {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(intToI64(0))\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L2 U64 Int64 {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(intToI64(0))\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L4 Float32 Float32 {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0.0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L2 Float Float {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0.0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L32 I8 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L32 U8 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L16 I16 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L16 U16 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L8 Int Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L8 U32 Int {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L4 Int64 Int64 {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(intToI64(0))\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L4 U64 Int64 {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(intToI64(0))\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L8 Float32 Float32 {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0.0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\npub instance SimdVec L4 Float Float {\n    def splat(x) = __simdSplat(x)\n    def zero() = __simdSplat(0.0)\n    def iota() = __simdIota()\n    def extract(v, i) = __simdExtract(v, i)\n    def replace(v, i, x) = __simdReplace(v, i, x)\n}\n\n/// Number of lanes in `v`.\nlanes: forall n e. (SimdLane n e) => Simd n e -> Int\npub def lanes(v) = laneCount(v)\n\n/// Byte width of `v` (`16` or `32`).\nbyteWidth: forall n e. (SimdLane n e) => Simd n e -> Int\npub def byteWidth(v) = vectorBytes(v)\n\n// ============================================================================\n// 3. Prelude Arithmetic, Bitwise & Equality Instances (with Scalar Broadcast)\n// ============================================================================\n\npub instance (SimdLane n e) => Add (Simd n e)(Simd n e)(Simd n e) {\n    def (+)(a, b) = __simdBin(0, a, b)\n}\npub instance (SimdLane n e) => Add (Simd n e) Int (Simd n e) {\n    def (+)(a, s) = __simdBin(0, a, __simdSplat(s))\n}\npub instance (SimdLane n e) => Add Int (Simd n e)(Simd n e) {\n    def (+)(s, b) = __simdBin(0, __simdSplat(s), b)\n}\npub instance (SimdLane n Int64) => Add (Simd n Int64) Int64 (Simd n Int64) {\n    def (+)(a, s) = __simdBin(0, a, __simdSplat(s))\n}\npub instance (SimdLane n Int64) => Add Int64 (Simd n Int64)(Simd n Int64) {\n    def (+)(s, b) = __simdBin(0, __simdSplat(s), b)\n}\npub instance (SimdLane n U64) => Add (Simd n U64) Int64 (Simd n U64) {\n    def (+)(a, s) = __simdBin(0, a, __simdSplat(s))\n}\npub instance (SimdLane n U64) => Add Int64 (Simd n U64)(Simd n U64) {\n    def (+)(s, b) = __simdBin(0, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Add (Simd n Float32) Float32 (Simd n Float32) {\n    def (+)(a, s) = __simdBin(0, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Add Float32 (Simd n Float32)(Simd n Float32) {\n    def (+)(s, b) = __simdBin(0, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Add (Simd n Float32) Float (Simd n Float32) {\n    def (+)(a, s) = __simdBin(0, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Add Float (Simd n Float32)(Simd n Float32) {\n    def (+)(s, b) = __simdBin(0, __simdSplat(s), b)\n}\npub instance (SimdLane n Float) => Add (Simd n Float) Float (Simd n Float) {\n    def (+)(a, s) = __simdBin(0, a, __simdSplat(s))\n}\npub instance (SimdLane n Float) => Add Float (Simd n Float)(Simd n Float) {\n    def (+)(s, b) = __simdBin(0, __simdSplat(s), b)\n}\n\npub instance (SimdLane n e) => Sub (Simd n e)(Simd n e)(Simd n e) {\n    def (-)(a, b) = __simdBin(1, a, b)\n}\npub instance (SimdLane n e) => Sub (Simd n e) Int (Simd n e) {\n    def (-)(a, s) = __simdBin(1, a, __simdSplat(s))\n}\npub instance (SimdLane n e) => Sub Int (Simd n e)(Simd n e) {\n    def (-)(s, b) = __simdBin(1, __simdSplat(s), b)\n}\npub instance (SimdLane n Int64) => Sub (Simd n Int64) Int64 (Simd n Int64) {\n    def (-)(a, s) = __simdBin(1, a, __simdSplat(s))\n}\npub instance (SimdLane n Int64) => Sub Int64 (Simd n Int64)(Simd n Int64) {\n    def (-)(s, b) = __simdBin(1, __simdSplat(s), b)\n}\npub instance (SimdLane n U64) => Sub (Simd n U64) Int64 (Simd n U64) {\n    def (-)(a, s) = __simdBin(1, a, __simdSplat(s))\n}\npub instance (SimdLane n U64) => Sub Int64 (Simd n U64)(Simd n U64) {\n    def (-)(s, b) = __simdBin(1, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Sub (Simd n Float32) Float32 (Simd n Float32) {\n    def (-)(a, s) = __simdBin(1, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Sub Float32 (Simd n Float32)(Simd n Float32) {\n    def (-)(s, b) = __simdBin(1, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Sub (Simd n Float32) Float (Simd n Float32) {\n    def (-)(a, s) = __simdBin(1, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Sub Float (Simd n Float32)(Simd n Float32) {\n    def (-)(s, b) = __simdBin(1, __simdSplat(s), b)\n}\npub instance (SimdLane n Float) => Sub (Simd n Float) Float (Simd n Float) {\n    def (-)(a, s) = __simdBin(1, a, __simdSplat(s))\n}\npub instance (SimdLane n Float) => Sub Float (Simd n Float)(Simd n Float) {\n    def (-)(s, b) = __simdBin(1, __simdSplat(s), b)\n}\n\npub instance (SimdLane n e) => Mul (Simd n e)(Simd n e)(Simd n e) {\n    def (*)(a, b) = __simdBin(2, a, b)\n}\npub instance (SimdLane n e) => Mul (Simd n e) Int (Simd n e) {\n    def (*)(a, s) = __simdBin(2, a, __simdSplat(s))\n}\npub instance (SimdLane n e) => Mul Int (Simd n e)(Simd n e) {\n    def (*)(s, b) = __simdBin(2, __simdSplat(s), b)\n}\npub instance (SimdLane n Int64) => Mul (Simd n Int64) Int64 (Simd n Int64) {\n    def (*)(a, s) = __simdBin(2, a, __simdSplat(s))\n}\npub instance (SimdLane n Int64) => Mul Int64 (Simd n Int64)(Simd n Int64) {\n    def (*)(s, b) = __simdBin(2, __simdSplat(s), b)\n}\npub instance (SimdLane n U64) => Mul (Simd n U64) Int64 (Simd n U64) {\n    def (*)(a, s) = __simdBin(2, a, __simdSplat(s))\n}\npub instance (SimdLane n U64) => Mul Int64 (Simd n U64)(Simd n U64) {\n    def (*)(s, b) = __simdBin(2, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Mul (Simd n Float32) Float32 (Simd n Float32) {\n    def (*)(a, s) = __simdBin(2, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Mul Float32 (Simd n Float32)(Simd n Float32) {\n    def (*)(s, b) = __simdBin(2, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Mul (Simd n Float32) Float (Simd n Float32) {\n    def (*)(a, s) = __simdBin(2, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Mul Float (Simd n Float32)(Simd n Float32) {\n    def (*)(s, b) = __simdBin(2, __simdSplat(s), b)\n}\npub instance (SimdLane n Float) => Mul (Simd n Float) Float (Simd n Float) {\n    def (*)(a, s) = __simdBin(2, a, __simdSplat(s))\n}\npub instance (SimdLane n Float) => Mul Float (Simd n Float)(Simd n Float) {\n    def (*)(s, b) = __simdBin(2, __simdSplat(s), b)\n}\n\npub instance (SimdLane n e) => Div (Simd n e)(Simd n e)(Simd n e) {\n    def (/)(a, b) = __simdBin(3, a, b)\n}\npub instance (SimdLane n e) => Div (Simd n e) Int (Simd n e) {\n    def (/)(a, s) = __simdBin(3, a, __simdSplat(s))\n}\npub instance (SimdLane n e) => Div Int (Simd n e)(Simd n e) {\n    def (/)(s, b) = __simdBin(3, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Div (Simd n Float32) Float32 (Simd n Float32) {\n    def (/)(a, s) = __simdBin(3, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Div Float32 (Simd n Float32)(Simd n Float32) {\n    def (/)(s, b) = __simdBin(3, __simdSplat(s), b)\n}\npub instance (SimdLane n Float32) => Div (Simd n Float32) Float (Simd n Float32) {\n    def (/)(a, s) = __simdBin(3, a, __simdSplat(s))\n}\npub instance (SimdLane n Float32) => Div Float (Simd n Float32)(Simd n Float32) {\n    def (/)(s, b) = __simdBin(3, __simdSplat(s), b)\n}\npub instance (SimdLane n Float) => Div (Simd n Float) Float (Simd n Float) {\n    def (/)(a, s) = __simdBin(3, a, __simdSplat(s))\n}\npub instance (SimdLane n Float) => Div Float (Simd n Float)(Simd n Float) {\n    def (/)(s, b) = __simdBin(3, __simdSplat(s), b)\n}\n\n/// Integer SIMD lane trait carrying bit width and signedness (`SimdBits`).\npub concept SimdBits n e : SimdLane n e {\n    def laneBits(_: Simd n e): Int,\n    def shrOpcode(_: Simd n e): Int\n}\n\npub instance SimdBits L16 I8 { def laneBits(_) = 8; def shrOpcode(_) = 1 }\npub instance SimdBits L16 U8 { def laneBits(_) = 8; def shrOpcode(_) = 2 }\npub instance SimdBits L8 I16 { def laneBits(_) = 16; def shrOpcode(_) = 1 }\npub instance SimdBits L8 U16 { def laneBits(_) = 16; def shrOpcode(_) = 2 }\npub instance SimdBits L4 Int { def laneBits(_) = 32; def shrOpcode(_) = 1 }\npub instance SimdBits L4 U32 { def laneBits(_) = 32; def shrOpcode(_) = 2 }\npub instance SimdBits L2 Int64 { def laneBits(_) = 64; def shrOpcode(_) = 1 }\npub instance SimdBits L2 U64 { def laneBits(_) = 64; def shrOpcode(_) = 2 }\npub instance SimdBits L32 I8 { def laneBits(_) = 8; def shrOpcode(_) = 1 }\npub instance SimdBits L32 U8 { def laneBits(_) = 8; def shrOpcode(_) = 2 }\npub instance SimdBits L16 I16 { def laneBits(_) = 16; def shrOpcode(_) = 1 }\npub instance SimdBits L16 U16 { def laneBits(_) = 16; def shrOpcode(_) = 2 }\npub instance SimdBits L8 Int { def laneBits(_) = 32; def shrOpcode(_) = 1 }\npub instance SimdBits L8 U32 { def laneBits(_) = 32; def shrOpcode(_) = 2 }\npub instance SimdBits L4 Int64 { def laneBits(_) = 64; def shrOpcode(_) = 1 }\npub instance SimdBits L4 U64 { def laneBits(_) = 64; def shrOpcode(_) = 2 }\n\npub instance (SimdBits n e) => Rem (Simd n e) {\n    def (%)(a, b) = __simdBin(4, a, b)\n}\n\npub instance (SimdLane n e) => Neg (Simd n e) {\n    def neg(a) = __simdUnary(0, a)\n}\n\npub instance (SimdBits n e) => BitAnd (Simd n e) {\n    def (&)(a, b) = __simdBin(5, a, b)\n}\n\npub instance (SimdBits n e) => BitOr (Simd n e) {\n    def (|)(a, b) = __simdBin(6, a, b)\n}\n\npub instance (SimdBits n e) => BitXor (Simd n e) {\n    def (^)(a, b) = __simdBin(7, a, b)\n}\n\npub instance (SimdBits n e) => BitNot (Simd n e) {\n    def (~)(a) = __simdUnary(1, a)\n}\n\npub instance (SimdBits n e) => Shl (Simd n e) {\n    def (<<)(a, amt) = __simdShift(0, a, amt)\n}\n\npub instance (SimdBits n e) => Shr (Simd n e) {\n    def (>>)(a, amt) =\n        if (shrOpcode(a) == 2) __simdShift(2, a, amt)\n        else __simdShift(1, a, amt)\n}\n\npub instance (SimdBits n e) => Ushr (Simd n e) {\n    def (>>>)(a, amt) = __simdShift(2, a, amt)\n}\n\n/// Whole-vector structural equality (`true` iff all lanes are equal).\npub instance (SimdLane n e) => Eq (Simd n e) {\n    def eq(a, b) = {\n        let l = laneCount(a);\n        let m = __simdReduce(5, __simdCmp(0, a, b));\n        if (l == 32) m == -1 else m == ((1 << l) - 1)\n    }\n}\n\n// ============================================================================\n// 4. First-Class `Mask n e` Operations & Blending (`select`)\n// ============================================================================\n\n/// Unwrap the underlying all-ones/all-zeros raw `Simd n e` vector of `m`.\npub def maskRaw(m: Mask n e): Simd n e = match m {\n    Mask(raw) -> raw,\n}\n\npub instance (SimdLane n e) => BitAnd (Mask n e) {\n    def (&)(a, b) = match (a, b) {\n        (Mask(x), Mask(y)) -> Mask(__simdBin(5, x, y)),\n    }\n}\n\npub instance (SimdLane n e) => BitOr (Mask n e) {\n    def (|)(a, b) = match (a, b) {\n        (Mask(x), Mask(y)) -> Mask(__simdBin(6, x, y)),\n    }\n}\n\npub instance (SimdLane n e) => BitXor (Mask n e) {\n    def (^)(a, b) = match (a, b) {\n        (Mask(x), Mask(y)) -> Mask(__simdBin(7, x, y)),\n    }\n}\n\npub instance (SimdLane n e) => BitNot (Mask n e) {\n    def (~)(a) = match a {\n        Mask(x) -> Mask(__simdUnary(1, x)),\n    }\n}\n\npub instance (SimdLane n e) => Eq (Mask n e) {\n    def eq(a, b) = match (a, b) {\n        (Mask(x), Mask(y)) -> {\n            let mx: Int = __simdReduce(5, x);\n            let my: Int = __simdReduce(5, y);\n            mx == my\n        },\n    }\n}\n\n/// Pack the truth value of each lane in `m` into an `N`-bit `Int` bitmask (`bit k = lane k`).\n/// Compiles to `pmovmskb` on x86-64, `i8x16.bitmask` on Wasm SIMD128, and NEON bit-reduction on ARM64.\nbitmask: forall n e. (SimdLane n e) => Mask n e -> Int\npub def bitmask(m) = match m {\n    Mask(raw) -> __simdReduce(5, raw),\n}\n\n/// Return `true` if at least one lane in `m` is `true`.\nany: forall n e. (SimdLane n e) => Mask n e -> Bool\npub def any(m) = bitmask(m) != 0\n\n/// Return `true` if every lane in `m` is `true`.\nall: forall n e. (SimdLane n e) => Mask n e -> Bool\npub def all(m) = match m {\n    Mask(raw) -> {\n        let l = laneCount(raw);\n        let bm = __simdReduce(5, raw);\n        if (l == 32) bm == -1 else bm == ((1 << l) - 1)\n    },\n}\n\n/// Return `true` if every lane in `m` is `false`.\nnone: forall n e. (SimdLane n e) => Mask n e -> Bool\npub def none(m) = bitmask(m) == 0\n\n/// Count the number of `true` lanes in `m`.\ncountTrue: forall n e. (SimdLane n e) => Mask n e -> Int\npub def countTrue(m) = popCount(bitmask(m))\n\n/// Index (`0..lanes-1`) of the first `true` lane in `m`, or `lanes` if all lanes are `false`.\nfirstTrue: forall n e. (SimdLane n e) => Mask n e -> Int\npub def firstTrue(m) = match m {\n    Mask(raw) -> {\n        let l = laneCount(raw);\n        let tz = trailingZeros(__simdReduce(5, raw));\n        if (tz > l) l else tz\n    },\n}\n\n/// Index (`0..lanes-1`) of the last `true` lane in `m`, or `-1` if all lanes are `false`.\nlastTrue: forall n e. (SimdLane n e) => Mask n e -> Int\npub def lastTrue(m) = {\n    let bm = bitmask(m);\n    if (bm == 0) -1 else 31 - leadingZeros(bm)\n}\n\n/// Branchless lane-wise blend: selects `onTrue[i]` where `m[i]` is `true` and `onFalse[i]` otherwise.\n/// Compiles to single-instruction `bsl.16b` (NEON), `vpblendvb` (SSE4.1/AVX2), or `v128.bitselect` (Wasm).\nselect: forall n e. (SimdLane n e) => (Mask n e, Simd n e, Simd n e) -> Simd n e\npub def select(m, onTrue, onFalse) = match m {\n    Mask(raw) -> __simdBin(6, __simdBin(5, onTrue, raw), __simdBin(5, onFalse, __simdUnary(1, raw))),\n}\n\n// ============================================================================\n// 5. Lane-Wise Comparisons (`==~`, `!=~`, `<~`, `<=~`, `>~`, `>=~`)\n// ============================================================================\n\n/// Lane-wise SIMD equality comparison producing a `Mask` (`==~`, `!=~`, precedence 4).\npub concept SimdEq a b m | a b -> m {\n    def (==~)(x: a, y: b): m,\n    def (!=~)(x: a, y: b): m\n}\n\npub instance (SimdLane n e) => SimdEq (Simd n e)(Simd n e)(Mask n e) {\n    def (==~)(a, b) = Mask(__simdCmp(0, a, b))\n    def (!=~)(a, b) = Mask(__simdCmp(1, a, b))\n}\npub instance (SimdLane n e) => SimdEq (Simd n e) Int (Mask n e) {\n    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))\n    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))\n}\npub instance (SimdLane n e) => SimdEq Int (Simd n e)(Mask n e) {\n    def (==~)(s, b) = Mask(__simdCmp(0, __simdSplat(s), b))\n    def (!=~)(s, b) = Mask(__simdCmp(1, __simdSplat(s), b))\n}\npub instance (SimdLane n U8) => SimdEq (Simd n U8) Char (Mask n U8) {\n    def (==~)(a, c) = Mask(__simdCmp(0, a, __simdSplat(charToInt(c))))\n    def (!=~)(a, c) = Mask(__simdCmp(1, a, __simdSplat(charToInt(c))))\n}\npub instance (SimdLane n U8) => SimdEq Char (Simd n U8)(Mask n U8) {\n    def (==~)(c, b) = Mask(__simdCmp(0, __simdSplat(charToInt(c)), b))\n    def (!=~)(c, b) = Mask(__simdCmp(1, __simdSplat(charToInt(c)), b))\n}\npub instance (SimdLane n I8) => SimdEq (Simd n I8) Char (Mask n I8) {\n    def (==~)(a, c) = Mask(__simdCmp(0, a, __simdSplat(charToInt(c))))\n    def (!=~)(a, c) = Mask(__simdCmp(1, a, __simdSplat(charToInt(c))))\n}\npub instance (SimdLane n I8) => SimdEq Char (Simd n I8)(Mask n I8) {\n    def (==~)(c, b) = Mask(__simdCmp(0, __simdSplat(charToInt(c)), b))\n    def (!=~)(c, b) = Mask(__simdCmp(1, __simdSplat(charToInt(c)), b))\n}\npub instance (SimdLane n Int64) => SimdEq (Simd n Int64) Int64 (Mask n Int64) {\n    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))\n    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))\n}\npub instance (SimdLane n U64) => SimdEq (Simd n U64) Int64 (Mask n U64) {\n    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))\n    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))\n}\npub instance (SimdLane n Float32) => SimdEq (Simd n Float32) Float32 (Mask n Float32) {\n    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))\n    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))\n}\npub instance (SimdLane n Float32) => SimdEq (Simd n Float32) Float (Mask n Float32) {\n    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))\n    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))\n}\npub instance (SimdLane n Float) => SimdEq (Simd n Float) Float (Mask n Float) {\n    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))\n    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))\n}\n\n/// Lane-wise SIMD ordering comparison producing a `Mask` (`<~`, `<=~`, `>~`, `>=~`, precedence 5).\npub concept SimdOrd a b m | a b -> m {\n    def (<~)(x: a, y: b): m,\n    def (<=~)(x: a, y: b): m,\n    def (>~)(x: a, y: b): m,\n    def (>=~)(x: a, y: b): m\n}\n\npub instance (SimdLane n e) => SimdOrd (Simd n e)(Simd n e)(Mask n e) {\n    def (<~)(a, b) = Mask(__simdCmp(2, a, b))\n    def (<=~)(a, b) = Mask(__simdCmp(3, a, b))\n    def (>~)(a, b) = Mask(__simdCmp(4, a, b))\n    def (>=~)(a, b) = Mask(__simdCmp(5, a, b))\n}\npub instance (SimdLane n e) => SimdOrd (Simd n e) Int (Mask n e) {\n    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))\n    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))\n    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))\n    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))\n}\npub instance (SimdLane n e) => SimdOrd Int (Simd n e)(Mask n e) {\n    def (<~)(s, b) = Mask(__simdCmp(2, __simdSplat(s), b))\n    def (<=~)(s, b) = Mask(__simdCmp(3, __simdSplat(s), b))\n    def (>~)(s, b) = Mask(__simdCmp(4, __simdSplat(s), b))\n    def (>=~)(s, b) = Mask(__simdCmp(5, __simdSplat(s), b))\n}\npub instance (SimdLane n U8) => SimdOrd (Simd n U8) Char (Mask n U8) {\n    def (<~)(a, c) = Mask(__simdCmp(2, a, __simdSplat(charToInt(c))))\n    def (<=~)(a, c) = Mask(__simdCmp(3, a, __simdSplat(charToInt(c))))\n    def (>~)(a, c) = Mask(__simdCmp(4, a, __simdSplat(charToInt(c))))\n    def (>=~)(a, c) = Mask(__simdCmp(5, a, __simdSplat(charToInt(c))))\n}\npub instance (SimdLane n U8) => SimdOrd Char (Simd n U8)(Mask n U8) {\n    def (<~)(c, b) = Mask(__simdCmp(2, __simdSplat(charToInt(c)), b))\n    def (<=~)(c, b) = Mask(__simdCmp(3, __simdSplat(charToInt(c)), b))\n    def (>~)(c, b) = Mask(__simdCmp(4, __simdSplat(charToInt(c)), b))\n    def (>=~)(c, b) = Mask(__simdCmp(5, __simdSplat(charToInt(c)), b))\n}\npub instance (SimdLane n I8) => SimdOrd (Simd n I8) Char (Mask n I8) {\n    def (<~)(a, c) = Mask(__simdCmp(2, a, __simdSplat(charToInt(c))))\n    def (<=~)(a, c) = Mask(__simdCmp(3, a, __simdSplat(charToInt(c))))\n    def (>~)(a, c) = Mask(__simdCmp(4, a, __simdSplat(charToInt(c))))\n    def (>=~)(a, c) = Mask(__simdCmp(5, a, __simdSplat(charToInt(c))))\n}\npub instance (SimdLane n I8) => SimdOrd Char (Simd n I8)(Mask n I8) {\n    def (<~)(c, b) = Mask(__simdCmp(2, __simdSplat(charToInt(c)), b))\n    def (<=~)(c, b) = Mask(__simdCmp(3, __simdSplat(charToInt(c)), b))\n    def (>~)(c, b) = Mask(__simdCmp(4, __simdSplat(charToInt(c)), b))\n    def (>=~)(c, b) = Mask(__simdCmp(5, __simdSplat(charToInt(c)), b))\n}\npub instance (SimdLane n Int64) => SimdOrd (Simd n Int64) Int64 (Mask n Int64) {\n    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))\n    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))\n    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))\n    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))\n}\npub instance (SimdLane n U64) => SimdOrd (Simd n U64) Int64 (Mask n U64) {\n    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))\n    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))\n    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))\n    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))\n}\npub instance (SimdLane n Float32) => SimdOrd (Simd n Float32) Float32 (Mask n Float32) {\n    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))\n    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))\n    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))\n    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))\n}\npub instance (SimdLane n Float32) => SimdOrd (Simd n Float32) Float (Mask n Float32) {\n    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))\n    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))\n    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))\n    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))\n}\npub instance (SimdLane n Float) => SimdOrd (Simd n Float) Float (Mask n Float) {\n    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))\n    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))\n    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))\n    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))\n}\n\n// ============================================================================\n// 6. Min / Max / Clamp, Reductions, Saturating Int & IEEE Float SIMD Ops\n// ============================================================================\n\n/// Lane-wise minimum (signed/unsigned/IEEE minnum).\nsimdMin: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e\npub def simdMin(a, b) = __simdBin(8, a, b)\n\n/// Lane-wise maximum (signed/unsigned/IEEE maxnum).\nsimdMax: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e\npub def simdMax(a, b) = __simdBin(9, a, b)\n\n/// Lane-wise clamp of `v` into `[lo, hi]`.\nsimdClamp: forall n e. (SimdLane n e) => (Simd n e, Simd n e, Simd n e) -> Simd n e\npub def simdClamp(v, lo, hi) = simdMin(simdMax(v, lo), hi)\n\n/// Lane-wise absolute value.\nsimdAbs: forall n e. (SimdLane n e) => Simd n e -> Simd n e\npub def simdAbs(v) = __simdUnary(2, v)\n\n/// Horizontal sum across all lanes (wrapping for integers, pairwise halving tree for floats).\nreduceAdd: forall n e s. (SimdVec n e s) => Simd n e -> s\npub def reduceAdd(v) = __simdReduce(0, v)\n\n/// Horizontal minimum across all lanes.\nreduceMin: forall n e s. (SimdVec n e s) => Simd n e -> s\npub def reduceMin(v) = __simdReduce(1, v)\n\n/// Horizontal maximum across all lanes.\nreduceMax: forall n e s. (SimdVec n e s) => Simd n e -> s\npub def reduceMax(v) = __simdReduce(2, v)\n\n/// Horizontal bitwise OR across all integer lanes.\nreduceBitOr: forall n e s. (SimdVec n e s, SimdBits n e) => Simd n e -> s\npub def reduceBitOr(v) = __simdReduce(3, v)\n\n/// Horizontal bitwise AND across all integer lanes.\nreduceBitAnd: forall n e s. (SimdVec n e s, SimdBits n e) => Simd n e -> s\npub def reduceBitAnd(v) = __simdReduce(4, v)\n\n/// Saturating lane-wise addition (`sadd.sat` / `uadd.sat`).\naddSat: forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e\npub def addSat(a, b) = __simdBin(10, a, b)\n\n/// Saturating lane-wise addition operator (`+|`, precedence 11).\n(+|): forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e\npub def (+|)(a, b) = __simdBin(10, a, b)\n\n/// Saturating lane-wise subtraction (`ssub.sat` / `usub.sat`).\nsubSat: forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e\npub def subSat(a, b) = __simdBin(11, a, b)\n\n/// Saturating lane-wise subtraction operator (`-|`, precedence 11).\n(-|): forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e\npub def (-|)(a, b) = __simdBin(11, a, b)\n\n/// Lane-wise bit rotate-left by `amt` bits.\nrotl: forall n e. (SimdBits n e) => (Simd n e, Int) -> Simd n e\npub def rotl(v, amt) = {\n    let w = laneBits(v);\n    let k = amt & (w - 1);\n    if (k == 0) v else (v << k) | (v >>> (w - k))\n}\n\n/// Lane-wise bit rotate-right by `amt` bits.\nrotr: forall n e. (SimdBits n e) => (Simd n e, Int) -> Simd n e\npub def rotr(v, amt) = {\n    let w = laneBits(v);\n    let k = amt & (w - 1);\n    if (k == 0) v else (v >>> k) | (v << (w - k))\n}\n\n/// IEEE-754 floating-point SIMD operations (`Float32`, `Float`).\npub concept SimdFloat n e s : SimdVec n e s | e -> s {\n    def simdFma(a: Simd n e, b: Simd n e, c: Simd n e): Simd n e,\n    def simdSqrt(v: Simd n e): Simd n e,\n    def simdFloor(v: Simd n e): Simd n e,\n    def simdCeil(v: Simd n e): Simd n e,\n    def simdRound(v: Simd n e): Simd n e\n}\n\npub instance SimdFloat L4 Float32 Float32 {\n    def simdFma(a, b, c) = __simdFma(a, b, c)\n    def simdSqrt(v) = __simdUnary(3, v)\n    def simdFloor(v) = __simdUnary(4, v)\n    def simdCeil(v) = __simdUnary(5, v)\n    def simdRound(v) = __simdUnary(6, v)\n}\npub instance SimdFloat L8 Float32 Float32 {\n    def simdFma(a, b, c) = __simdFma(a, b, c)\n    def simdSqrt(v) = __simdUnary(3, v)\n    def simdFloor(v) = __simdUnary(4, v)\n    def simdCeil(v) = __simdUnary(5, v)\n    def simdRound(v) = __simdUnary(6, v)\n}\npub instance SimdFloat L2 Float Float {\n    def simdFma(a, b, c) = __simdFma(a, b, c)\n    def simdSqrt(v) = __simdUnary(3, v)\n    def simdFloor(v) = __simdUnary(4, v)\n    def simdCeil(v) = __simdUnary(5, v)\n    def simdRound(v) = __simdUnary(6, v)\n}\npub instance SimdFloat L4 Float Float {\n    def simdFma(a, b, c) = __simdFma(a, b, c)\n    def simdSqrt(v) = __simdUnary(3, v)\n    def simdFloor(v) = __simdUnary(4, v)\n    def simdCeil(v) = __simdUnary(5, v)\n    def simdRound(v) = __simdUnary(6, v)\n}\n\n/// Horizontal dot product `reduceAdd(a * b)`.\nsimdDot: forall n e s. (SimdFloat n e s) => (Simd n e, Simd n e) -> s\npub def simdDot(a, b) = {\n    let prod: Simd n e = __simdBin(2, a, b);\n    __simdReduce(0, prod)\n}\n\n// ============================================================================\n// 7. Permutations, Swizzles, Halves, Widening / Narrowing & Casts\n// ============================================================================\n\n/// Reverse all lanes of `v`.\nreverseLanes: forall n e. (SimdLane n e) => Simd n e -> Simd n e\npub def reverseLanes(v) = __simdPermute(0, v, v, 0)\n\n/// Interleave low halves of `a` and `b` (`[a0, b0, a1, b1, ...]`).\nzipLo: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e\npub def zipLo(a, b) = __simdPermute(1, a, b, 0)\n\n/// Interleave high halves of `a` and `b`.\nzipHi: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e\npub def zipHi(a, b) = __simdPermute(2, a, b, 0)\n\n/// De-interleave even-indexed lanes across `a` followed by `b` (`[a0, a2, ..., b0, b2, ...]`).\nunzipEven: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e\npub def unzipEven(a, b) = __simdPermute(3, a, b, 0)\n\n/// De-interleave odd-indexed lanes across `a` followed by `b` (`[a1, a3, ..., b1, b3, ...]`).\nunzipOdd: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e\npub def unzipOdd(a, b) = __simdPermute(4, a, b, 0)\n\n/// Dynamic 16-byte lookup table (`tbl.16b` / `pshufb` / `i8x16.swizzle`):\n/// selects `table[idx[i]]` when `0 <= idx[i] < 16` and `0` when `idx[i] >= 16`.\npub def swizzleZero(table: U8x16, idx: U8x16): U8x16 = __simdPermute(6, table, idx, 0)\n\n/// Parallel 32-byte lookup into a 16-byte table (`vpshufb` / dual `tbl.16b` / dual `i8x16.swizzle`):\n/// for each lane `i` in `0..31`, selects `table[idx[i]]` when `0 <= idx[i] < 16` and `0` otherwise.\npub def swizzle32(table: U8x16, idx: U8x32): U8x32 = {\n    let tbl32: U8x32 = __simdCombine(0, table, table);\n    __simdPermute(6, tbl32, idx, 0)\n}\n\n/// Shift `curr` right by 1 byte, shifting in the last byte `prev[15]` into lane 0 (`ext.16b` / `palignr`).\npub def prev1Byte16(curr: U8x16, prev: U8x16): U8x16 = __simdPermute(5, prev, curr, 15)\n\n/// Shift `curr` right by 1 byte across 32 lanes, shifting `prev[31]` into lane 0.\npub def prev1Byte32(curr: U8x32, prev: U8x32): U8x32 = __simdPermute(5, prev, curr, 31)\n\n/// Shift bytes of `v` toward lane 0 by `k` (`0..16`), filling vacated upper lanes with `0`.\npub def shiftBytesRightZero16(v: U8x16, k: Int): U8x16 =\n    if (k <= 0) v\n    else if (k >= 16) zero()\n    else {\n        let baseIdx: U8x16 = iota();\n        swizzleZero(v, baseIdx + k)\n    }\n\n/// Relates a 128-bit vector `Simd nHalf e` and its 256-bit counterpart `Simd nFull e`.\npub concept SimdHalves nHalf nFull e | nHalf -> nFull, nFull -> nHalf {\n    def splitHalves(v: Simd nFull e): (Simd nHalf e, Simd nHalf e),\n    def concatHalves(lo: Simd nHalf e, hi: Simd nHalf e): Simd nFull e\n}\n\npub instance SimdHalves L16 L32 I8 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L16 L32 U8 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L8 L16 I16 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L8 L16 U16 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L4 L8 Int {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L4 L8 U32 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L2 L4 Int64 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L2 L4 U64 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L4 L8 Float32 {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\npub instance SimdHalves L2 L4 Float {\n    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))\n    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)\n}\n\n/// Adjacent element-width widening & narrowing between `(nNarrow, eNarrow)` and `(nWide, eWide)`.\npub concept SimdWide nNarrow eNarrow nWide eWide | nNarrow eNarrow -> nWide eWide, nWide eWide -> nNarrow eNarrow {\n    def widenLo(v: Simd nNarrow eNarrow): Simd nWide eWide,\n    def widenHi(v: Simd nNarrow eNarrow): Simd nWide eWide,\n    def narrow(lo: Simd nWide eWide, hi: Simd nWide eWide): Simd nNarrow eNarrow,\n    def narrowSat(lo: Simd nWide eWide, hi: Simd nWide eWide): Simd nNarrow eNarrow\n}\n\npub instance SimdWide L16 I8 L8 I16 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L16 U8 L8 U16 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L32 I8 L16 I16 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L32 U8 L16 U16 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L8 I16 L4 Int {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L8 U16 L4 U32 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L16 I16 L8 Int {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L16 U16 L8 U32 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L4 Int L2 Int64 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L4 U32 L2 U64 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L8 Int L4 Int64 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L8 U32 L4 U64 {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(2, a, b)\n}\npub instance SimdWide L4 Float32 L2 Float {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(1, a, b)\n}\npub instance SimdWide L8 Float32 L4 Float {\n    def widenLo(v) = __simdConvert(2, v)\n    def widenHi(v) = __simdConvert(3, v)\n    def narrow(a, b) = __simdCombine(1, a, b)\n    def narrowSat(a, b) = __simdCombine(1, a, b)\n}\n\n/// Overflow-free widened horizontal sum (widens lanes to double width before summing).\nreduceAddWide: forall n1 e1 n2 e2 s2. (SimdWide n1 e1 n2 e2, SimdVec n2 e2 s2) => Simd n1 e1 -> s2\npub def reduceAddWide(v) = {\n    let lo: Simd n2 e2 = widenLo(v);\n    let hi: Simd n2 e2 = widenHi(v);\n    let sum: Simd n2 e2 = __simdBin(0, lo, hi);\n    __simdReduce(0, sum)\n}\n\n/// Same-lane-count numeric conversion (`castSimd`: int <-> float, signed <-> unsigned).\npub concept SimdCast n src dst {\n    def castSimd(v: Simd n src): Simd n dst\n}\n\npub instance (SimdLane n a, SimdLane n b) => SimdCast n a b {\n    def castSimd(v) = __simdConvert(1, v)\n}\n\n/// Zero-cost bit reinterpretation between equal-width (128-bit or 256-bit) SIMD vectors.\npub concept SimdWidth n e w | n e -> w {\n    def simdWidthBits(v: Simd n e): Int\n}\npub data W128 {}\npub data W256 {}\npub instance SimdWidth L16 I8 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L16 U8 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L8 I16 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L8 U16 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L4 Int W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L4 U32 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L2 Int64 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L2 U64 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L4 Float32 W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L2 Float W128 { def simdWidthBits(_) = 128 }\npub instance SimdWidth L32 I8 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L32 U8 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L16 I16 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L16 U16 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L8 Int W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L8 U32 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L4 Int64 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L4 U64 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L8 Float32 W256 { def simdWidthBits(_) = 256 }\npub instance SimdWidth L4 Float W256 { def simdWidthBits(_) = 256 }\n\n/// Reinterpret bits of a 128-bit or 256-bit vector as another vector of the same total bit width.\nbitcastSimd: forall n1 e1 n2 e2 w. (SimdWidth n1 e1 w, SimdWidth n2 e2 w) => Simd n1 e1 -> Simd n2 e2\npub def bitcastSimd(v) = __simdConvert(0, v)\n\n/// Reinterpret a `Mask n e1` as `Mask n e2` when both vectors have the same lane count and total width.\nmaskCast: forall n e1 e2 w. (SimdWidth n e1 w, SimdWidth n e2 w) => Mask n e1 -> Mask n e2\npub def maskCast(m) = match m {\n    Mask(raw) -> Mask(__simdConvert(0, raw)),\n}\n\n// ============================================================================\n// 8. Unaligned Memory & String Loads / Stores (with ASan-Safe Tail Loader)\n// ============================================================================\n\n/// Unaligned load of `Simd n e` from `ScopedPtr` at byte offset `byteOff`.\nsimdLoadScoped: forall n e. (SimdLane n e) => (ScopedPtr, Int64) -> Simd n e\npub def simdLoadScoped(p, byteOff) = __simdLoad(p, byteOff)\n\n/// Unaligned store of `Simd n e` to `ScopedPtr` at byte offset `byteOff`.\nsimdStoreScoped: forall n e. (SimdLane n e) => (ScopedPtr, Int64, Simd n e) -> Void\npub def simdStoreScoped(p, byteOff, v) = __simdStore(p, byteOff, v)\n\n/// Unaligned load of `Simd n e` from raw `Ptr` at byte offset `byteOff`.\nsimdLoadPtr: forall n e. (SimdLane n e) => (Ptr, Int64) -> Simd n e\npub def simdLoadPtr(p, byteOff) = __simdLoadRaw(p, byteOff)\n\n/// Unaligned store of `Simd n e` to raw `Ptr` at byte offset `byteOff`.\nsimdStorePtr: forall n e. (SimdLane n e) => (Ptr, Int64, Simd n e) -> Void\npub def simdStorePtr(p, byteOff, v) = __simdStoreRaw(p, byteOff, v)\n\n/// Zero-copy unaligned load of `Simd n e` from `s` at `byteOff`.\n/// Caller must ensure `0 <= byteOff` and `byteOff + byteWidth <= strLen(s)`.\nsimdLoadStr: forall n e. (SimdLane n e) => (String, Int) -> Simd n e\npub def simdLoadStr(s, byteOff) =\n    if (byteOff < 0) {\n        let _ = strByteAt(s, byteOff);\n        __simdSplat(0)\n    } else __simdLoadStr(s, intToI64(byteOff))\n\n/// Safe zero-padded partial load from `s[byteOff .. byteOff + remBytes)` when `remBytes < byteWidth`.\n/// Never reads past `byteOff + remBytes` (100% ASan and page-boundary safe), padding trailing bytes with `0`.\nsimdLoadStrTail: forall n e. (SimdLane n e) => (String, Int, Int) -> Simd n e\npub def simdLoadStrTail(s, byteOff, remBytes) = {\n    let z: Simd n e = __simdSplat(0);\n    let bw = vectorBytes(z);\n    if (remBytes <= 0) z\n    else if (remBytes >= bw) simdLoadStr(s, byteOff)\n    else if (byteOff < 0) {\n        let _ = strByteAt(s, byteOff);\n        z\n    } else withAlloca(32, (tmp) -> {\n        scopedPtrWriteI64Le(tmp, intToI64(0), intToI64(0));\n        scopedPtrWriteI64Le(tmp, intToI64(8), intToI64(0));\n        scopedPtrWriteI64Le(tmp, intToI64(16), intToI64(0));\n        scopedPtrWriteI64Le(tmp, intToI64(24), intToI64(0));\n        withStrPtr(s, (src) -> {\n            scopedPtrCopyBytes(tmp, intToI64(0), src, intToI64(byteOff), intToI64(remBytes))\n        });\n        __simdLoad(tmp, intToI64(0))\n    })\n}\n\n/// Load `Simd n e` from `MutArray s` starting at element index `off` (bounds-checked).\nfromArray: forall n e s. (SimdVec n e s) => (MutArray s, Int) -> Simd n e\npub def fromArray(arr, off) = {\n    let z = zero();\n    let n = lanes(z);\n    let _ = arrayGet(arr, off);\n    let _ = arrayGet(arr, off + n - 1);\n    let acc = cellNew(z);\n    let i = cellNew(0);\n    while (cellGet(i) < n) {\n        let k = cellGet(i);\n        cellSet(acc, replace(cellGet(acc), k, arrayGet(arr, off + k)));\n        cellSet(i, k + 1)\n    };\n    cellGet(acc)\n}\n\n/// Materialize all lanes of `v` into a fresh `MutArray s`.\ntoArray: forall n e s. (SimdVec n e s) => Simd n e -> MutArray s\npub def toArray(v) = {\n    let n = lanes(v);\n    let out = arrayNew(n, extract(v, 0));\n    let i = cellNew(1);\n    while (cellGet(i) < n) {\n        let k = cellGet(i);\n        arraySet(out, k, extract(v, k));\n        cellSet(i, k + 1)\n    };\n    out\n}\n\n// ============================================================================\n// 9. Exact 256-Byte Universal Nibble-LUT Classifier (`SimdByteSet`)\n// ============================================================================\n\n/// Exact SIMD byte-set lookup table supporting all \\(2^{256}\\) subsets of `0..255` with zero false positives.\n/// Pure-ASCII sets (`0..127`) execute a single 2-swizzle pass; sets with high bytes (`128..255`) add a 2nd pass.\npub data SimdByteSet {\n    loLut: U8x16,\n    hiLut: U8x16,\n    hasHigh: Bool,\n}\n\ndef bitTableLo16(): U8x16 = {\n    let z: U8x16 = zero();\n    let v0 = replace(z, 0, 1);\n    let v1 = replace(v0, 1, 2);\n    let v2 = replace(v1, 2, 4);\n    let v3 = replace(v2, 3, 8);\n    let v4 = replace(v3, 4, 16);\n    let v5 = replace(v4, 5, 32);\n    let v6 = replace(v5, 6, 64);\n    replace(v6, 7, 128)\n}\n\ndef bitTableHi16(): U8x16 = {\n    let z: U8x16 = zero();\n    let v0 = replace(z, 8, 1);\n    let v1 = replace(v0, 9, 2);\n    let v2 = replace(v1, 10, 4);\n    let v3 = replace(v2, 11, 8);\n    let v4 = replace(v3, 12, 16);\n    let v5 = replace(v4, 13, 32);\n    let v6 = replace(v5, 14, 64);\n    replace(v6, 15, 128)\n}\n\n/// Empty `SimdByteSet` matching no bytes.\npub def byteSetEmpty(): SimdByteSet = SimdByteSet {\n    loLut: zero(),\n    hiLut: zero(),\n    hasHigh: false,\n}\n\n/// Return a new `SimdByteSet` with byte `b & 255` added.\npub def byteSetAdd(bs: SimdByteSet, b: Int): SimdByteSet = {\n    let u = b & 255;\n    let lo = u & 15;\n    let hi = u >>> 4;\n    if (hi < 8) {\n        let cur = extract(bs.loLut, lo);\n        SimdByteSet {\n            loLut: replace(bs.loLut, lo, cur | (1 << hi)),\n            hiLut: bs.hiLut,\n            hasHigh: bs.hasHigh,\n        }\n    } else {\n        let cur = extract(bs.hiLut, lo);\n        SimdByteSet {\n            loLut: bs.loLut,\n            hiLut: replace(bs.hiLut, lo, cur | (1 << (hi - 8))),\n            hasHigh: true,\n        }\n    }\n}\n\n/// Return a new `SimdByteSet` with inclusive byte range `[loByte .. hiByte]` added.\npub def byteSetAddRange(bs: SimdByteSet, loByte: Int, hiByte: Int): SimdByteSet = {\n    let acc = cellNew(bs);\n    let b = cellNew(if (loByte < 0) 0 else loByte);\n    let lim = if (hiByte > 255) 255 else hiByte;\n    while (cellGet(b) <= lim) {\n        let cur = cellGet(b);\n        cellSet(acc, byteSetAdd(cellGet(acc), cur));\n        cellSet(b, cur + 1)\n    };\n    cellGet(acc)\n}\n\n/// Build a `SimdByteSet` matching every byte present in `chars`.\npub def byteSetFromStr(chars: String): SimdByteSet = {\n    let n = strLen(chars);\n    let acc = cellNew(byteSetEmpty());\n    let i = cellNew(0);\n    while (cellGet(i) < n) {\n        let k = cellGet(i);\n        cellSet(acc, byteSetAdd(cellGet(acc), strByteAt(chars, k)));\n        cellSet(i, k + 1)\n    };\n    cellGet(acc)\n}\n\n/// Union of two `SimdByteSet` classifiers.\npub def byteSetUnion(a: SimdByteSet, b: SimdByteSet): SimdByteSet = SimdByteSet {\n    loLut: a.loLut | b.loLut,\n    hiLut: a.hiLut | b.hiLut,\n    hasHigh: a.hasHigh || b.hasHigh,\n}\n\n/// Complement of `bs` over all 256 byte values `0..255`.\npub def byteSetInvert(bs: SimdByteSet): SimdByteSet = SimdByteSet {\n    loLut: ~bs.loLut,\n    hiLut: ~bs.hiLut,\n    hasHigh: true,\n}\n\n/// Scalar membership query on `bs` (`true` iff `b & 255` is in `bs`, for scalar tail loops).\npub def byteSetContains(bs: SimdByteSet, b: Int): Bool = {\n    let u = b & 255;\n    let lo = u & 15;\n    let hi = u >>> 4;\n    if (hi < 8) (extract(bs.loLut, lo) & (1 << hi)) != 0\n    else bs.hasHigh && ((extract(bs.hiLut, lo) & (1 << (hi - 8))) != 0)\n}\n\n/// Classify 16 bytes in parallel against `bs`, returning a `Mask8x16` of matching lanes.\npub def matchByteSet16(bs: SimdByteSet, v: U8x16): Mask8x16 = {\n    let mask15: U8x16 = splat(15);\n    let loNib = v & mask15;\n    let hiNib = v >>> 4;\n    let mLo = (swizzleZero(bs.loLut, loNib) & swizzleZero(bitTableLo16(), hiNib)) !=~ 0;\n    if (bs.hasHigh) {\n        let mHi = (swizzleZero(bs.hiLut, loNib) & swizzleZero(bitTableHi16(), hiNib)) !=~ 0;\n        mLo | mHi\n    } else mLo\n}\n\n/// Classify 32 bytes in parallel against `bs`, returning a `Mask8x32` of matching lanes.\npub def matchByteSet32(bs: SimdByteSet, v: U8x32): Mask8x32 = {\n    let mask15: U8x32 = splat(15);\n    let loNib = v & mask15;\n    let hiNib = v >>> 4;\n    let mLo = (swizzle32(bs.loLut, loNib) & swizzle32(bitTableLo16(), hiNib)) !=~ 0;\n    if (bs.hasHigh) {\n        let mHi = (swizzle32(bs.hiLut, loNib) & swizzle32(bitTableHi16(), hiNib)) !=~ 0;\n        mLo | mHi\n    } else mLo\n}\n")
    else if (key == "std.path") Some("// Portable POSIX & Windows path manipulation (`std.path`)\n//\n// Default functions follow the host OS path convention (POSIX `/` on macOS/Linux/Wasm;\n// `/` and `\\` + drive prefixes on Windows). Explicit `*Win` variants parse Windows paths\n// on any host.\n\nextern \"gs_sys_host_os\" def c_path_host_os(): Ptr\n\ndef isWinHost(): Bool = {\n    let p = c_path_host_os();\n    !ptrIsNull(p) && ptrToString(p) == \"windows\"\n}\n\ndef isSepByte(winStyle: Bool, b: Int): Bool =\n    b == 47 || (winStyle && b == 92)\n\ndef isAsciiAlpha(b: Int): Bool =\n    (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n\ndef hasDrivePrefix(winStyle: Bool, p: String): Bool =\n    winStyle && strLen(p) >= 2 && isAsciiAlpha(strByteAt(p, 0)) && strByteAt(p, 1) == 58\n\ndef rootPrefixLen(winStyle: Bool, p: String): Int =\n    if (hasDrivePrefix(winStyle, p)) {\n        if (strLen(p) >= 3 && isSepByte(winStyle, strByteAt(p, 2))) 3 else 2\n    } else if (strLen(p) > 0 && isSepByte(winStyle, strByteAt(p, 0))) {\n        1\n    } else {\n        0\n    }\n\ndef isAbsPathStyle(winStyle: Bool, p: String): Bool =\n    if (strLen(p) == 0) false\n    else if (isSepByte(winStyle, strByteAt(p, 0))) true\n    else hasDrivePrefix(winStyle, p) && strLen(p) >= 3 && isSepByte(winStyle, strByteAt(p, 2))\n\ndef trimTrailingSlashStyle(winStyle: Bool, p: String): String = {\n    let minLen = rootPrefixLen(winStyle, p);\n    let hi = cellNew(strLen(p));\n    while (cellGet(hi) > minLen && isSepByte(winStyle, strByteAt(p, cellGet(hi) - 1))) {\n        cellSet(hi, cellGet(hi) - 1)\n    };\n    strSlice(p, 0, cellGet(hi))\n}\n\ndef pathJoinStyle(winStyle: Bool, base: String, child: String): String =\n    if (strLen(base) == 0 || base == \".\") child\n    else if (strLen(child) == 0) base\n    else if (isAbsPathStyle(winStyle, child)) child\n    else {\n        let b = trimTrailingSlashStyle(winStyle, base);\n        let blen = strLen(b);\n        if (blen > 0 && isSepByte(winStyle, strByteAt(b, blen - 1))) b + child\n        else b + \"/\" + child\n    }\n\ndef lastSlashIndexStyle(winStyle: Bool, p: String): Int = {\n    let i = cellNew(strLen(p) - 1);\n    let found = cellNew(-1);\n    while (cellGet(i) >= 0 && cellGet(found) < 0) {\n        if (isSepByte(winStyle, strByteAt(p, cellGet(i)))) cellSet(found, cellGet(i))\n        else cellSet(i, cellGet(i) - 1)\n    };\n    cellGet(found)\n}\n\ndef pathDirnameStyle(winStyle: Bool, raw: String): String = {\n    let p = trimTrailingSlashStyle(winStyle, raw);\n    let rootLen = rootPrefixLen(winStyle, p);\n    if (rootLen > 0 && strLen(p) <= rootLen) p\n    else {\n        let idx = lastSlashIndexStyle(winStyle, p);\n        if (idx < 0) {\n            if (hasDrivePrefix(winStyle, p)) strSlice(p, 0, 2) else \".\"\n        } else if (idx == 0) {\n            strSlice(p, 0, 1)\n        } else if (hasDrivePrefix(winStyle, p) && idx == 2) {\n            strSlice(p, 0, 3)\n        } else {\n            strSlice(p, 0, idx)\n        }\n    }\n}\n\ndef pathBasenameStyle(winStyle: Bool, raw: String): String = {\n    let p = trimTrailingSlashStyle(winStyle, raw);\n    let rootLen = rootPrefixLen(winStyle, p);\n    if (rootLen > 0 && strLen(p) <= rootLen) p\n    else {\n        let idx = lastSlashIndexStyle(winStyle, p);\n        if (idx < 0) {\n            if (hasDrivePrefix(winStyle, p)) strSlice(p, 2, strLen(p)) else p\n        } else {\n            strSlice(p, idx + 1, strLen(p))\n        }\n    }\n}\n\ndef pathStemStyle(winStyle: Bool, raw: String): String = {\n    let base = pathBasenameStyle(winStyle, raw);\n    let i = cellNew(strLen(base) - 1);\n    let dotIdx = cellNew(-1);\n    while (cellGet(i) > 0 && cellGet(dotIdx) < 0) {\n        if (strByteAt(base, cellGet(i)) == 46) cellSet(dotIdx, cellGet(i))\n        else cellSet(i, cellGet(i) - 1)\n    };\n    if (cellGet(dotIdx) <= 0) base\n    else strSlice(base, 0, cellGet(dotIdx))\n}\n\ndef pathWithExtStyle(winStyle: Bool, raw: String, ext: String): String = {\n    let p = trimTrailingSlashStyle(winStyle, raw);\n    let slashIdx = lastSlashIndexStyle(winStyle, p);\n    let i = cellNew(strLen(p) - 1);\n    let dotIdx = cellNew(-1);\n    while (cellGet(i) > slashIdx + 1 && cellGet(dotIdx) < 0) {\n        if (strByteAt(p, cellGet(i)) == 46) cellSet(dotIdx, cellGet(i))\n        else cellSet(i, cellGet(i) - 1)\n    };\n    let stemPart = if (cellGet(dotIdx) < 0) p else strSlice(p, 0, cellGet(dotIdx));\n    if (strLen(ext) == 0) stemPart\n    else if (strByteAt(ext, 0) == 46) stemPart + ext\n    else stemPart + \".\" + ext\n}\n\n/// Return `true` if `p` is an absolute path under the host OS path convention.\npub def isAbsPath(p: String): Bool = isAbsPathStyle(isWinHost(), p)\n\n/// Join `base` and `child` using the host OS path convention.\npub def pathJoin(base: String, child: String): String = pathJoinStyle(isWinHost(), base, child)\n\n/// Return the parent directory of `raw` under the host OS path convention.\npub def pathDirname(raw: String): String = pathDirnameStyle(isWinHost(), raw)\n\n/// Return the final path component of `raw` under the host OS path convention.\npub def pathBasename(raw: String): String = pathBasenameStyle(isWinHost(), raw)\n\n/// Return the filename stem (without extension) of `raw` under the host OS path convention.\npub def pathStem(raw: String): String = pathStemStyle(isWinHost(), raw)\n\n/// Replace or append the extension of `raw` under the host OS path convention.\npub def pathWithExt(raw: String, ext: String): String = pathWithExtStyle(isWinHost(), raw, ext)\n\n/// Explicit Windows-style path helpers (recognize `/`, `\\`, and drive prefixes such as `C:\\` on any host).\npub def isAbsPathWin(p: String): Bool = isAbsPathStyle(true, p)\npub def pathJoinWin(base: String, child: String): String = pathJoinStyle(true, base, child)\npub def pathDirnameWin(raw: String): String = pathDirnameStyle(true, raw)\npub def pathBasenameWin(raw: String): String = pathBasenameStyle(true, raw)\npub def pathStemWin(raw: String): String = pathStemStyle(true, raw)\npub def pathWithExtWin(raw: String, ext: String): String = pathWithExtStyle(true, raw, ext)\n")
    else if (key == "std.char") Some("// ASCII / UTF-8 byte & character classification (`std.char`)\n\npub def isDigitByte(b: Int): Bool = b >= 48 && b <= 57\n\npub def isUpperByte(b: Int): Bool = b >= 65 && b <= 90\n\npub def isLowerByte(b: Int): Bool = b >= 97 && b <= 122\n\npub def isAlphaByte(b: Int): Bool = isUpperByte(b) || isLowerByte(b)\n\npub def isAlphaNumByte(b: Int): Bool = isAlphaByte(b) || isDigitByte(b)\n\npub def isIdentStartByte(b: Int): Bool = isAlphaByte(b) || b == 95\n\npub def isIdentContByte(b: Int): Bool = isAlphaNumByte(b) || b == 95\n\npub def isSpaceByte(b: Int): Bool =\n    b == 32 || b == 9 || b == 10 || b == 13\n\npub def isDigit(c: Char): Bool = isDigitByte(charToInt(c))\n\npub def isAlpha(c: Char): Bool = isAlphaByte(charToInt(c))\n\npub def isSpace(c: Char): Bool = isSpaceByte(charToInt(c))\n")
    else if (key == "std.buf") Some("// Amortized O(1) compact byte/string builder (`std.buf`) backed by raw GC-atomic byte buffers + bulk memcpy\n\npub data StringBuf {\n    MkStringBuf(Cell Ptr, Cell Int, Cell Int),\n}\n\npub def bufWithCap(cap: Int): StringBuf = {\n    let actual = if (cap < 32) 32 else cap;\n    MkStringBuf(cellNew(ptrAllocBytes(actual)), cellNew(0), cellNew(actual))\n}\n\npub def bufNew(): StringBuf = bufWithCap(32)\n\npub def bufLen(b: StringBuf): Int = match b {\n    MkStringBuf(_, lenCell, _) -> cellGet(lenCell),\n}\n\npub def bufClear(b: StringBuf): Void = match b {\n    MkStringBuf(_, lenCell, _) -> cellSet(lenCell, 0),\n}\n\ndef ensureExtra(b: StringBuf, needed: Int): Void = match b {\n    MkStringBuf(dataCell, lenCell, capCell) -> {\n        let curLen = cellGet(lenCell);\n        let curCap = cellGet(capCell);\n        if (curLen + needed > curCap) {\n            let newCap = cellNew(if (curCap < 32) 32 else curCap * 2);\n            while (cellGet(newCap) < curLen + needed) {\n                cellSet(newCap, cellGet(newCap) * 2)\n            };\n            let nc = cellGet(newCap);\n            let grown = ptrAllocBytes(nc);\n            if (curLen > 0) {\n                ptrCopyBytes(grown, 0, cellGet(dataCell), 0, curLen)\n            } else ();\n            cellSet(dataCell, grown);\n            cellSet(capCell, nc)\n        } else ()\n    },\n}\n\npub def bufPushByte(b: StringBuf, byte: Int): Void = {\n    ensureExtra(b, 1);\n    match b {\n        MkStringBuf(dataCell, lenCell, _) -> {\n            let idx = cellGet(lenCell);\n            ptrSetByte(cellGet(dataCell), idx, byte);\n            cellSet(lenCell, idx + 1)\n        },\n    }\n}\n\npub def bufPushChar(b: StringBuf, ch: Char): Void =\n    bufPushByte(b, charToInt(ch))\n\npub def bufPushStr(b: StringBuf, s: String): Void = {\n    let n = strLen(s);\n    if (n > 0) {\n        ensureExtra(b, n);\n        match b {\n            MkStringBuf(dataCell, lenCell, _) -> {\n                let base = cellGet(lenCell);\n                ptrCopyFromStr(cellGet(dataCell), base, s, n);\n                cellSet(lenCell, base + n)\n            },\n        }\n    } else ()\n}\n\npub def bufPushPtr(b: StringBuf, src: Ptr, len: Int): Void =\n    if (len > 0) {\n        ensureExtra(b, len);\n        match b {\n            MkStringBuf(dataCell, lenCell, _) -> {\n                let base = cellGet(lenCell);\n                ptrCopyBytes(cellGet(dataCell), base, src, 0, len);\n                cellSet(lenCell, base + len)\n            },\n        }\n    } else ()\n\npub def bufPushLine(b: StringBuf, s: String): Void = {\n    bufPushStr(b, s);\n    bufPushByte(b, 10)\n}\n\npub def bufPushBuf(dst: StringBuf, src: StringBuf): Void = match src {\n    MkStringBuf(srcDataCell, srcLenCell, _) -> {\n        let n = cellGet(srcLenCell);\n        if (n > 0) {\n            ensureExtra(dst, n);\n            match dst {\n                MkStringBuf(dstDataCell, dstLenCell, _) -> {\n                    let base = cellGet(dstLenCell);\n                    ptrCopyBytes(cellGet(dstDataCell), base, cellGet(srcDataCell), 0, n);\n                    cellSet(dstLenCell, base + n)\n                },\n            }\n        } else ()\n    },\n}\n\npub def bufPushInt(b: StringBuf, n: Int): Void =\n    if (n == 0) {\n        bufPushByte(b, 48)\n    } else if (n == -2147483647 - 1) {\n        bufPushStr(b, \"-2147483648\")\n    } else {\n        let v = cellNew(if (n < 0) { bufPushByte(b, 45); -n } else n);\n        let digits = ptrAllocBytes(12);\n        let dlen = cellNew(0);\n        while (cellGet(v) > 0) {\n            let cur = cellGet(v);\n            let idx = cellGet(dlen);\n            ptrSetByte(digits, idx, 48 + (cur % 10));\n            cellSet(dlen, idx + 1);\n            cellSet(v, cur / 10)\n        };\n        let count = cellGet(dlen);\n        ensureExtra(b, count);\n        match b {\n            MkStringBuf(dataCell, lenCell, _) -> {\n                let dst = cellGet(dataCell);\n                let pos = cellNew(cellGet(lenCell));\n                let k = cellNew(count - 1);\n                while (cellGet(k) >= 0) {\n                    let ki = cellGet(k);\n                    let pi = cellGet(pos);\n                    ptrSetByte(dst, pi, ptrByteAt(digits, ki));\n                    cellSet(pos, pi + 1);\n                    cellSet(k, ki - 1)\n                };\n                cellSet(lenCell, cellGet(pos))\n            },\n        }\n    }\n\npub def bufToString(b: StringBuf): String = match b {\n    MkStringBuf(dataCell, lenCell, _) -> ptrSliceToString(cellGet(dataCell), cellGet(lenCell)),\n}\n")
    else if (key == "std.str") Some("// String manipulation, numeric parsing/formatting, and FNV-1a hashing (`std.str`)\n\nuse std.option.{Option, Some, None}\nuse std.result.{Result, Ok, Err}\nuse std.char.{isSpaceByte, isDigitByte}\nuse std.list.listRev\nuse std.buf.{bufNew, bufPushByte, bufPushStr, bufPushInt, bufToString}\n\nextern \"strtod\" def c_strtod(s: String, endptr: Ptr): Float\nextern \"gs_fmt_f64\" def c_fmt_f64(f: Float, buf: Ptr, cap: Int): Int\n\npub def strIsEmpty(s: String): Bool = strLen(s) == 0\n\npub def intToStr(n: Int): String =\n    if (n == 0) \"0\"\n    else if (n == -2147483647 - 1) \"-2147483648\"\n    else {\n        let neg = n < 0;\n        let v = cellNew(if (neg) -n else n);\n        let rev = arrayNew(12, 0);\n        let dlen = cellNew(0);\n        while (cellGet(v) > 0) {\n            let cur = cellGet(v);\n            let idx = cellGet(dlen);\n            arraySet(rev, idx, 48 + (cur % 10));\n            cellSet(dlen, idx + 1);\n            cellSet(v, cur / 10)\n        };\n        let count = cellGet(dlen);\n        let total = if (neg) count + 1 else count;\n        let out = arrayNew(total, 0);\n        let pos = cellNew(0);\n        if (neg) {\n            arraySet(out, 0, 45);\n            cellSet(pos, 1)\n        } else ();\n        let k = cellNew(count - 1);\n        while (cellGet(k) >= 0) {\n            let ki = cellGet(k);\n            let pi = cellGet(pos);\n            arraySet(out, pi, arrayGet(rev, ki));\n            cellSet(pos, pi + 1);\n            cellSet(k, ki - 1)\n        };\n        strFromBytes(out, total)\n    }\n\npub def i64ToStr(n: Int64): String = {\n    let zero = intToI64(0);\n    let minI64 = intToI64(1) << 63;\n    if (n == zero) \"0\"\n    else if (n == minI64) \"-9223372036854775808\"\n    else {\n        let b = bufNew();\n        let ten = intToI64(10);\n        let v = cellNew(if (n < zero) { bufPushByte(b, 45); -n } else n);\n        let digits = arrayNew(24, 0);\n        let dlen = cellNew(0);\n        while (cellGet(v) > zero) {\n            let cur = cellGet(v);\n            let idx = cellGet(dlen);\n            arraySet(digits, idx, 48 + i64ToInt(cur % ten));\n            cellSet(dlen, idx + 1);\n            cellSet(v, cur / ten)\n        };\n        let k = cellNew(cellGet(dlen) - 1);\n        while (cellGet(k) >= 0) {\n            let idx = cellGet(k);\n            bufPushByte(b, arrayGet(digits, idx));\n            cellSet(k, idx - 1)\n        };\n        bufToString(b)\n    }\n}\n\ndef hexDigitByte(nib: Int): Int =\n    if (nib < 10) 48 + nib else 55 + nib\n\n/// Lossless 16-digit IEEE-754 / 64-bit hex representation (`0x0123456789ABCDEF`), ideal for LLVM IR `double` constants.\npub def i64ToHex16(bits: Int64): String = {\n    let b = bufNew();\n    bufPushStr(b, \"0x\");\n    let mask = intToI64(15);\n    let shift = cellNew(60);\n    while (cellGet(shift) >= 0) {\n        let s = cellGet(shift);\n        let nib = i64ToInt((bits >>> s) & mask);\n        bufPushByte(b, hexDigitByte(nib));\n        cellSet(shift, s - 4)\n    };\n    bufToString(b)\n}\n\npub def floatToHex16(f: Float): String = i64ToHex16(floatToBits64(f))\n\n/// Format IEEE-754 `Float` with lossless round-trip precision (`NaN`, `inf`, `-inf`, `-0.0`, scientific notation for tiny/huge magnitudes).\npub def floatToStr(f: Float): String = {\n    let scratch = ptrAllocBytes(64);\n    let n = c_fmt_f64(f, scratch, 64);\n    ptrSliceToString(scratch, n)\n}\n\npub def boolToStr(v: Bool): String = if (v) \"true\" else \"false\"\n\npub def strStartsWith(s: String, prefix: String): Bool = {\n    let sl = strLen(s);\n    let pl = strLen(prefix);\n    if (pl > sl) false\n    else {\n        let i = cellNew(0);\n        let ok = cellNew(true);\n        while (cellGet(i) < pl && cellGet(ok)) {\n            let idx = cellGet(i);\n            if (strByteAt(s, idx) != strByteAt(prefix, idx)) cellSet(ok, false) else ();\n            cellSet(i, idx + 1)\n        };\n        cellGet(ok)\n    }\n}\n\npub def strEndsWith(s: String, suffix: String): Bool = {\n    let sl = strLen(s);\n    let xl = strLen(suffix);\n    if (xl > sl) false\n    else {\n        let base = sl - xl;\n        let i = cellNew(0);\n        let ok = cellNew(true);\n        while (cellGet(i) < xl && cellGet(ok)) {\n            let idx = cellGet(i);\n            if (strByteAt(s, base + idx) != strByteAt(suffix, idx)) cellSet(ok, false) else ();\n            cellSet(i, idx + 1)\n        };\n        cellGet(ok)\n    }\n}\n\n/// Return `true` if `needle` occurs as a contiguous byte substring of `hay`.\npub def strContains(hay: String, needle: String): Bool = {\n    let hl = strLen(hay);\n    let nl = strLen(needle);\n    if (nl == 0) true\n    else if (nl > hl) false\n    else {\n        let i = cellNew(0);\n        let found = cellNew(false);\n        let limit = hl - nl;\n        while (cellGet(i) <= limit && !cellGet(found)) {\n            let start = cellGet(i);\n            let j = cellNew(0);\n            let ok = cellNew(true);\n            while (cellGet(j) < nl && cellGet(ok)) {\n                if (strByteAt(hay, start + cellGet(j)) != strByteAt(needle, cellGet(j))) {\n                    cellSet(ok, false)\n                } else ();\n                cellSet(j, cellGet(j) + 1)\n            };\n            if (cellGet(ok)) cellSet(found, true) else cellSet(i, start + 1)\n        };\n        cellGet(found)\n    }\n}\n\npub def strIndexOfByte(s: String, targetByte: Int, startIdx: Int): Option Int = {\n    let len = strLen(s);\n    let i = cellNew(if (startIdx < 0) 0 else startIdx);\n    let found = cellNew(-1);\n    while (cellGet(i) < len && cellGet(found) < 0) {\n        let cur = cellGet(i);\n        if (strByteAt(s, cur) == targetByte) {\n            cellSet(found, cur)\n        } else {\n            cellSet(i, cur + 1)\n        }\n    };\n    if (cellGet(found) >= 0) Some(cellGet(found)) else None\n}\n\npub def strTrim(s: String): String = {\n    let len = strLen(s);\n    let lo = cellNew(0);\n    while (cellGet(lo) < len && isSpaceByte(strByteAt(s, cellGet(lo)))) {\n        cellSet(lo, cellGet(lo) + 1)\n    };\n    let hi = cellNew(len);\n    while (cellGet(hi) > cellGet(lo) && isSpaceByte(strByteAt(s, cellGet(hi) - 1))) {\n        cellSet(hi, cellGet(hi) - 1)\n    };\n    strSlice(s, cellGet(lo), cellGet(hi))\n}\n\n/// Parse a signed 64-bit decimal integer with strict range checking (`[-9223372036854775808, 9223372036854775807]`).\npub def parseInt64(raw: String): Result Int64 String = {\n    let s = strTrim(raw);\n    let len = strLen(s);\n    if (len == 0) Err(\"empty integer string\")\n    else {\n        let first = strByteAt(s, 0);\n        let neg = first == 45;\n        let start = if (first == 45 || first == 43) 1 else 0;\n        if (start >= len) Err(\"invalid integer: \" + raw)\n        else {\n            let acc = cellNew(intToI64(0));\n            let i = cellNew(start);\n            let invalid = cellNew(false);\n            let overflow = cellNew(false);\n            let ten = intToI64(10);\n            let maxI64 = (intToI64(2147483647) << 32) | ((intToI64(65535) << 16) | intToI64(65535));\n            let maxDiv10 = maxI64 / ten;\n            let minDiv10 = intToI64(0) - maxDiv10;\n            let seven64 = intToI64(7);\n            let eight64 = intToI64(8);\n            while (cellGet(i) < len && !cellGet(invalid)) {\n                let b = strByteAt(s, cellGet(i));\n                if (!isDigitByte(b)) {\n                    cellSet(invalid, true)\n                } else {\n                    if (!cellGet(overflow)) {\n                        let digit = intToI64(b - 48);\n                        let cur = cellGet(acc);\n                        if (neg) {\n                            if (cur < minDiv10 || (cur == minDiv10 && digit > eight64)) {\n                                cellSet(overflow, true)\n                            } else {\n                                cellSet(acc, cur * ten - digit)\n                            }\n                        } else {\n                            if (cur > maxDiv10 || (cur == maxDiv10 && digit > seven64)) {\n                                cellSet(overflow, true)\n                            } else {\n                                cellSet(acc, cur * ten + digit)\n                            }\n                        }\n                    } else ();\n                    cellSet(i, cellGet(i) + 1)\n                }\n            };\n            if (cellGet(invalid)) Err(\"invalid integer: \" + raw)\n            else if (cellGet(overflow)) Err(\"integer overflow: \" + raw)\n            else Ok(cellGet(acc))\n        }\n    }\n}\n\npub def parseInt(raw: String): Result Int String = match parseInt64(raw) {\n    Err(e) -> Err(e),\n    Ok(v64) -> {\n        let min32 = intToI64(-2147483647 - 1);\n        let max32 = intToI64(2147483647);\n        if (v64 < min32 || v64 > max32) Err(\"integer overflow: \" + raw)\n        else Ok(i64ToInt(v64))\n    },\n}\n\npub def parseFloat(raw: String): Result Float String = {\n    let s = strTrim(raw);\n    let len = strLen(s);\n    if (len == 0) Err(\"empty float string\")\n    else {\n        let i = cellNew(0);\n        let b0 = strByteAt(s, 0);\n        if (b0 == 45 || b0 == 43) cellSet(i, 1) else ();\n        let intDigits = cellNew(0);\n        while (cellGet(i) < len && isDigitByte(strByteAt(s, cellGet(i)))) {\n            cellSet(intDigits, cellGet(intDigits) + 1);\n            cellSet(i, cellGet(i) + 1)\n        };\n        let fracDigits = cellNew(0);\n        let hasDot = if (cellGet(i) < len && strByteAt(s, cellGet(i)) == 46) {\n            cellSet(i, cellGet(i) + 1);\n            while (cellGet(i) < len && isDigitByte(strByteAt(s, cellGet(i)))) {\n                cellSet(fracDigits, cellGet(fracDigits) + 1);\n                cellSet(i, cellGet(i) + 1)\n            };\n            true\n        } else false;\n        let expOk = if (cellGet(i) < len && (strByteAt(s, cellGet(i)) == 101 || strByteAt(s, cellGet(i)) == 69)) {\n            cellSet(i, cellGet(i) + 1);\n            if (cellGet(i) < len && (strByteAt(s, cellGet(i)) == 45 || strByteAt(s, cellGet(i)) == 43)) {\n                cellSet(i, cellGet(i) + 1)\n            } else ();\n            let ed = cellNew(0);\n            while (cellGet(i) < len && isDigitByte(strByteAt(s, cellGet(i)))) {\n                cellSet(ed, cellGet(ed) + 1);\n                cellSet(i, cellGet(i) + 1)\n            };\n            cellGet(ed) > 0\n        } else true;\n\n        let valid =\n            cellGet(i) == len\n            && (cellGet(intDigits) > 0 || (hasDot && cellGet(fracDigits) > 0))\n            && (!hasDot || cellGet(fracDigits) > 0 || cellGet(intDigits) > 0)\n            && expOk;\n        if (valid) Ok(c_strtod(s, ptrNull()))\n        else Err(\"invalid float: \" + raw)\n    }\n}\n\npub def strSplitChar(s: String, sep: Char): List String = {\n    let sepByte = charToInt(sep);\n    let len = strLen(s);\n    let start = cellNew(0);\n    let i = cellNew(0);\n    let acc = cellNew(Nil);\n    while (cellGet(i) <= len) {\n        let cur = cellGet(i);\n        let isEnd = if (cur == len) true else strByteAt(s, cur) == sepByte;\n        if (isEnd) {\n            let st = cellGet(start);\n            let part = ptrSliceFromStr(s, st, cur - st);\n            cellSet(acc, Cons(part, cellGet(acc)));\n            cellSet(start, cur + 1)\n        } else ();\n        cellSet(i, cur + 1)\n    };\n    listRev(cellGet(acc))\n}\n\npub def strJoin(parts: List String, sep: String): String = {\n    let b = bufNew();\n    let cur = cellNew(parts);\n    let first = cellNew(true);\n    let keepGoing = cellNew(true);\n    while (cellGet(keepGoing)) {\n        match cellGet(cur) {\n            Nil -> cellSet(keepGoing, false),\n            Cons(h, t) -> {\n                if (!cellGet(first)) bufPushStr(b, sep) else cellSet(first, false);\n                bufPushStr(b, h);\n                cellSet(cur, t)\n            },\n        }\n    };\n    bufToString(b)\n}\n\n// Non-negative 31-bit FNV-1a hash\npub def strHash(s: String): Int = {\n    let len = strLen(s);\n    let h = cellNew(5381);\n    let i = cellNew(0);\n    while (cellGet(i) < len) {\n        let idx = cellGet(i);\n        let mixed = (cellGet(h) * 33) ^ strByteAt(s, idx);\n        cellSet(h, mixed & 2147483647);\n        cellSet(i, idx + 1)\n    };\n    cellGet(h) & 2147483647\n}\n")
    else if (key == "std.vec") Some("// Unboxed dynamic growable array (`std.vec`), backed directly by `MutArray a` (zero `Option` boxing!)\n\nuse std.option.{Option, Some, None}\n\npub data Vec a {\n    MkVec(Cell (MutArray a), Cell Int),\n}\n\npub def vecWithCap(cap: Int): Vec a = {\n    let actual = if (cap < 8) 8 else cap;\n    MkVec(cellNew(arrayNewZeroed(actual)), cellNew(0))\n}\n\npub def vecNew(): Vec a = vecWithCap(8)\n\npub def vecLen(v: Vec a): Int = match v {\n    MkVec(_, lenCell) -> cellGet(lenCell),\n}\n\npub def vecIsEmpty(v: Vec a): Bool = vecLen(v) == 0\n\npub def vecPush(v: Vec a, item: a): Void = match v {\n    MkVec(arrCell, lenCell) -> {\n        let curArr = cellGet(arrCell);\n        let curLen = cellGet(lenCell);\n        let curCap = arrayLen(curArr);\n        if (curLen >= curCap) {\n            let newCap = if (curCap < 8) 8 else curCap * 2;\n            let grown = arrayNewZeroed(newCap);\n            let i = cellNew(0);\n            while (cellGet(i) < curLen) {\n                let idx = cellGet(i);\n                arraySet(grown, idx, arrayGet(curArr, idx));\n                cellSet(i, idx + 1)\n            };\n            cellSet(arrCell, grown)\n        } else ();\n        arraySet(cellGet(arrCell), curLen, item);\n        cellSet(lenCell, curLen + 1)\n    },\n}\n\npub def vecPop(v: Vec a): Option a = match v {\n    MkVec(arrCell, lenCell) -> {\n        let curLen = cellGet(lenCell);\n        if (curLen <= 0) None\n        else {\n            let lastIdx = curLen - 1;\n            let arr = cellGet(arrCell);\n            let out = arrayGet(arr, lastIdx);\n            // Clear popped slot so dead heap references are not retained!\n            arrayClearSlot(arr, lastIdx);\n            cellSet(lenCell, lastIdx);\n            Some(out)\n        }\n    },\n}\n\npub def vecGet(v: Vec a, idx: Int): Option a = match v {\n    MkVec(arrCell, lenCell) -> {\n        let curLen = cellGet(lenCell);\n        if (idx < 0 || idx >= curLen) None\n        else Some(arrayGet(cellGet(arrCell), idx))\n    },\n}\n\npub def vecGetOr(v: Vec a, idx: Int, fallback: a): a = match v {\n    MkVec(arrCell, lenCell) -> {\n        let curLen = cellGet(lenCell);\n        if (idx < 0 || idx >= curLen) fallback\n        else arrayGet(cellGet(arrCell), idx)\n    },\n}\n\npub def vecSet(v: Vec a, idx: Int, item: a): Void = match v {\n    MkVec(arrCell, lenCell) -> {\n        let curLen = cellGet(lenCell);\n        let arr = cellGet(arrCell);\n        // Trigger standard bounds failure if out of logical range `0..curLen`\n        if (idx < 0 || idx >= curLen) {\n            let _ = arrayGet(arrayNew(curLen, 0), idx);\n            ()\n        } else {\n            arraySet(arr, idx, item)\n        }\n    },\n}\n\npub def vecClear(v: Vec a): Void = match v {\n    MkVec(arrCell, lenCell) -> {\n        let arr = cellGet(arrCell);\n        let n = cellGet(lenCell);\n        let i = cellNew(0);\n        while (cellGet(i) < n) {\n            let idx = cellGet(i);\n            arrayClearSlot(arr, idx);\n            cellSet(i, idx + 1)\n        };\n        cellSet(lenCell, 0)\n    },\n}\n\npub def vecToList(v: Vec a): List a = match v {\n    MkVec(arrCell, lenCell) -> {\n        let arr = cellGet(arrCell);\n        let acc = cellNew(Nil);\n        let i = cellNew(cellGet(lenCell) - 1);\n        while (cellGet(i) >= 0) {\n            let idx = cellGet(i);\n            cellSet(acc, Cons(arrayGet(arr, idx), cellGet(acc)));\n            cellSet(i, idx - 1)\n        };\n        cellGet(acc)\n    },\n}\n")
    else if (key == "std.map") Some("// Resizable hash maps (`StrMap v`, `IntMap v`) and compiler symbol `Interner` (`std.map`)\n\nuse std.option.{Option, Some, None}\nuse std.str.strHash\nuse std.vec.{Vec, vecNew, vecLen, vecPush, vecGetOr}\n\npub data StrMap v {\n    MkStrMap(Cell (MutArray (List (String, v))), Cell Int),\n}\n\npub def strMapNew(): StrMap v =\n    MkStrMap(cellNew(arrayNew(16, Nil)), cellNew(0))\n\npub def strMapLen(m: StrMap v): Int = match m {\n    MkStrMap(_, sz) -> cellGet(sz),\n}\n\ndef bucketLookupStr(chain: List (String, v), key: String): Option v = match chain {\n    Nil -> None,\n    Cons((k, val), rest) -> if (k == key) Some(val) else bucketLookupStr(rest, key),\n}\n\ndef bucketUpsertStr(chain: List (String, v), key: String, val: v): (List (String, v), Bool) = match chain {\n    Nil -> (Cons((key, val), Nil), true),\n    Cons((k, old), rest) ->\n        if (k == key) (Cons((key, val), rest), false)\n        else {\n            let (updatedRest, added) = bucketUpsertStr(rest, key, val);\n            (Cons((k, old), updatedRest), added)\n        },\n}\n\ndef bucketRemoveStr(chain: List (String, v), key: String): (List (String, v), Bool) = match chain {\n    Nil -> (Nil, false),\n    Cons((k, old), rest) ->\n        if (k == key) (rest, true)\n        else {\n            let (updatedRest, removed) = bucketRemoveStr(rest, key);\n            (Cons((k, old), updatedRest), removed)\n        },\n}\n\ndef rehashStrMap(m: StrMap v): Void = match m {\n    MkStrMap(bucketsCell, _) -> {\n        let oldBuckets = cellGet(bucketsCell);\n        let oldCap = arrayLen(oldBuckets);\n        let newCap = oldCap * 2;\n        let mask = newCap - 1;\n        let newBuckets = arrayNew(newCap, Nil);\n        let i = cellNew(0);\n        while (cellGet(i) < oldCap) {\n            let bidx = cellGet(i);\n            let cur = cellNew(arrayGet(oldBuckets, bidx));\n            let looping = cellNew(true);\n            while (cellGet(looping)) {\n                match cellGet(cur) {\n                    Nil -> cellSet(looping, false),\n                    Cons((k, val), rest) -> {\n                        let target = strHash(k) & mask;\n                        arraySet(newBuckets, target, Cons((k, val), arrayGet(newBuckets, target)));\n                        cellSet(cur, rest)\n                    },\n                }\n            };\n            cellSet(i, bidx + 1)\n        };\n        cellSet(bucketsCell, newBuckets)\n    },\n}\n\npub def strMapGet(m: StrMap v, key: String): Option v = match m {\n    MkStrMap(bucketsCell, _) -> {\n        let buckets = cellGet(bucketsCell);\n        let idx = strHash(key) & (arrayLen(buckets) - 1);\n        bucketLookupStr(arrayGet(buckets, idx), key)\n    },\n}\n\npub def strMapContains(m: StrMap v, key: String): Bool = match strMapGet(m, key) {\n    Some(_) -> true,\n    None -> false,\n}\n\npub def strMapInsert(m: StrMap v, key: String, val: v): Void = match m {\n    MkStrMap(bucketsCell, szCell) -> {\n        if ((cellGet(szCell) + 1) * 4 > arrayLen(cellGet(bucketsCell)) * 3) {\n            rehashStrMap(m)\n        } else ();\n        let buckets = cellGet(bucketsCell);\n        let idx = strHash(key) & (arrayLen(buckets) - 1);\n        let (newChain, added) = bucketUpsertStr(arrayGet(buckets, idx), key, val);\n        arraySet(buckets, idx, newChain);\n        if (added) cellSet(szCell, cellGet(szCell) + 1) else ()\n    },\n}\n\npub def strMapRemove(m: StrMap v, key: String): Bool = match m {\n    MkStrMap(bucketsCell, szCell) -> {\n        let buckets = cellGet(bucketsCell);\n        let idx = strHash(key) & (arrayLen(buckets) - 1);\n        let (newChain, removed) = bucketRemoveStr(arrayGet(buckets, idx), key);\n        arraySet(buckets, idx, newChain);\n        if (removed) cellSet(szCell, cellGet(szCell) - 1) else ();\n        removed\n    },\n}\n\n// ============================================================================\n// Integer-keyed Hash Map (`IntMap v`)\n// ============================================================================\n\npub data IntMap v {\n    MkIntMap(Cell (MutArray (List (Int, v))), Cell Int),\n}\n\ndef hashIntKey(k: Int): Int = {\n    let h1 = (k ^ (k >>> 16)) * 73244475;\n    let h2 = (h1 ^ (h1 >>> 16)) * 73244475;\n    (h2 ^ (h2 >>> 16)) & 2147483647\n}\n\npub def intMapNew(): IntMap v =\n    MkIntMap(cellNew(arrayNew(16, Nil)), cellNew(0))\n\npub def intMapLen(m: IntMap v): Int = match m {\n    MkIntMap(_, sz) -> cellGet(sz),\n}\n\ndef bucketLookupInt(chain: List (Int, v), key: Int): Option v = match chain {\n    Nil -> None,\n    Cons((k, val), rest) -> if (k == key) Some(val) else bucketLookupInt(rest, key),\n}\n\ndef bucketUpsertInt(chain: List (Int, v), key: Int, val: v): (List (Int, v), Bool) = match chain {\n    Nil -> (Cons((key, val), Nil), true),\n    Cons((k, old), rest) ->\n        if (k == key) (Cons((key, val), rest), false)\n        else {\n            let (updatedRest, added) = bucketUpsertInt(rest, key, val);\n            (Cons((k, old), updatedRest), added)\n        },\n}\n\ndef rehashIntMap(m: IntMap v): Void = match m {\n    MkIntMap(bucketsCell, _) -> {\n        let oldBuckets = cellGet(bucketsCell);\n        let oldCap = arrayLen(oldBuckets);\n        let newCap = oldCap * 2;\n        let mask = newCap - 1;\n        let newBuckets = arrayNew(newCap, Nil);\n        let i = cellNew(0);\n        while (cellGet(i) < oldCap) {\n            let bidx = cellGet(i);\n            let cur = cellNew(arrayGet(oldBuckets, bidx));\n            let looping = cellNew(true);\n            while (cellGet(looping)) {\n                match cellGet(cur) {\n                    Nil -> cellSet(looping, false),\n                    Cons((k, val), rest) -> {\n                        let target = hashIntKey(k) & mask;\n                        arraySet(newBuckets, target, Cons((k, val), arrayGet(newBuckets, target)));\n                        cellSet(cur, rest)\n                    },\n                }\n            };\n            cellSet(i, bidx + 1)\n        };\n        cellSet(bucketsCell, newBuckets)\n    },\n}\n\npub def intMapGet(m: IntMap v, key: Int): Option v = match m {\n    MkIntMap(bucketsCell, _) -> {\n        let buckets = cellGet(bucketsCell);\n        let idx = hashIntKey(key) & (arrayLen(buckets) - 1);\n        bucketLookupInt(arrayGet(buckets, idx), key)\n    },\n}\n\npub def intMapInsert(m: IntMap v, key: Int, val: v): Void = match m {\n    MkIntMap(bucketsCell, szCell) -> {\n        if ((cellGet(szCell) + 1) * 4 > arrayLen(cellGet(bucketsCell)) * 3) {\n            rehashIntMap(m)\n        } else ();\n        let buckets = cellGet(bucketsCell);\n        let idx = hashIntKey(key) & (arrayLen(buckets) - 1);\n        let (newChain, added) = bucketUpsertInt(arrayGet(buckets, idx), key, val);\n        arraySet(buckets, idx, newChain);\n        if (added) cellSet(szCell, cellGet(szCell) + 1) else ()\n    },\n}\n\n// ============================================================================\n// Bidirectional String Symbol Interner (`Interner`) for Compiler ASTs\n// ============================================================================\n\npub data Interner {\n    MkInterner(StrMap Int, Vec String),\n}\n\npub def internerNew(): Interner =\n    MkInterner(strMapNew(), vecNew())\n\npub def intern(pool: Interner, s: String): Int = match pool {\n    MkInterner(toId, toStr) -> match strMapGet(toId, s) {\n        Some(existing) -> existing,\n        None -> {\n            let nextId = vecLen(toStr);\n            vecPush(toStr, s);\n            strMapInsert(toId, s, nextId);\n            nextId\n        },\n    },\n}\n\npub def internerResolve(pool: Interner, id: Int): String = match pool {\n    MkInterner(_, toStr) -> vecGetOr(toStr, id, \"\"),\n}\n\npub def internerCount(pool: Interner): Int = match pool {\n    MkInterner(_, toStr) -> vecLen(toStr),\n}\n")
    else if (key == "std.sync") Some("// Shared-memory synchronization primitives (`std.sync`):\n// - `AtomicInt`: lock-free sequentially consistent 32-bit atomic integer\n// - `MVar a`: single-slot synchronized box (empty or full)\n// - `Chan a`: bounded & unbounded MPMC typed channel\n\nuse std.option.{Option, Some, None}\n\n// ============================================================================\n// AtomicInt\n// ============================================================================\n\npub def atomicNew(init: Int): AtomicInt = __concAtomicNew(init)\n\npub def atomicLoad(a: AtomicInt): Int = __concAtomicLoad(a)\n\npub def atomicStore(a: AtomicInt, val: Int): Void = __concAtomicStore(a, val)\n\npub def atomicAdd(a: AtomicInt, delta: Int): Int = __concAtomicAdd(a, delta)\n\npub def atomicCas(a: AtomicInt, expected: Int, desired: Int): Bool =\n    __concAtomicCas(a, expected, desired)\n\n// ============================================================================\n// MVar a\n// ============================================================================\n\npub def mvarNew(init: a): MVar a = __concMVarNew(init)\n\npub def mvarEmpty(): MVar a = __concMVarEmpty()\n\npub def mvarTake(m: MVar a): a = __concMVarTake(m)\n\npub def mvarPut(m: MVar a, val: a): Void = __concMVarPut(m, val)\n\npub def mvarRead(m: MVar a): a = __concMVarRead(m)\n\npub def mvarTryTake(m: MVar a): Option a = match __concMVarTryTake(m) {\n    (ok, val) -> if (ok) Some(val) else None,\n}\n\n// ============================================================================\n// Chan a\n// ============================================================================\n\npub def chanNew(capacity: Int): Chan a = __concChanNew(capacity)\n\npub def chanUnbounded(): Chan a = __concChanNew(0)\n\npub def chanSend(ch: Chan a, val: a): Bool = __concChanSend(ch, val)\n\npub def chanRecv(ch: Chan a): Option a = match __concChanRecv(ch) {\n    (ok, val) -> if (ok) Some(val) else None,\n}\n\npub def chanTryRecv(ch: Chan a): Option a = match __concChanTryRecv(ch) {\n    (ok, val) -> if (ok) Some(val) else None,\n}\n\npub def chanClose(ch: Chan a): Void = __concChanClose(ch)\n\npub def chanIsClosed(ch: Chan a): Bool = __concChanIsClosed(ch)\n")
    else if (key == "std.task") Some("// Multicore futures & data-parallel combinators (`std.task`)\n\nuse std.list.{listLen, listRev, listAppend}\n\npub def spawn(f: () -> a): Task a = __concTaskSpawn(f)\n\npub def await(t: Task a): a = __concTaskAwait(t)\n\npub def isReady(t: Task a): Bool = __concTaskIsReady(t)\n\npub def numCpu(): Int = __concNumCpu()\n\npub def sleepMs(ms: Int): Void = __concSleepMs(ms)\n\npub def par(f: () -> a, g: () -> b): (a, b) = {\n    let rightTask = spawn(g);\n    let leftVal = f();\n    let rightVal = await(rightTask);\n    (leftVal, rightVal)\n}\n\ndef waitAllLoop(ts: List (Task a), acc: List a): List a = match ts {\n    Nil -> listRev(acc),\n    Cons(t, rest) -> waitAllLoop(rest, Cons(await(t), acc)),\n}\n\npub def waitAll(tasks: List (Task a)): List a = waitAllLoop(tasks, Nil)\n\ndef spawnMapLoop(xs: List a, f: a -> b, acc: List (Task b)): List (Task b) = match xs {\n    Nil -> listRev(acc),\n    Cons(x, rest) -> spawnMapLoop(rest, f, Cons(spawn(() -> f(x)), acc)),\n}\n\npub def parMap(xs: List a, f: a -> b): List b = {\n    let tasks = spawnMapLoop(xs, f, Nil);\n    waitAll(tasks)\n}\n\ndef fillTaskArray(ts: List (Task a), arr: MutArray (Task a), idx: Int): Void = match ts {\n    Nil -> (),\n    Cons(t, rest) -> {\n        arraySet(arr, idx, t);\n        fillTaskArray(rest, arr, idx + 1)\n    },\n}\n\ndef partitionReady(\n    ts: List (Task a),\n    readyAcc: List (Task a),\n    pendingAcc: List (Task a)\n): (List (Task a), List (Task a)) = match ts {\n    Nil -> (listRev(readyAcc), listRev(pendingAcc)),\n    Cons(t, rest) ->\n        if (isReady(t)) partitionReady(rest, Cons(t, readyAcc), pendingAcc)\n        else partitionReady(rest, readyAcc, Cons(t, pendingAcc)),\n}\n\npub def waitAny(\n    tasks: List (Task a),\n    count: Int,\n    timeoutMs: Int\n): (List (Task a), List (Task a)) = match tasks {\n    Nil -> (Nil, Nil),\n    Cons(first, _) -> {\n        let n = listLen(tasks);\n        let arr = arrayNew(n, first);\n        fillTaskArray(tasks, arr, 0);\n        __concTaskWaitAny(arr, count, timeoutMs);\n        partitionReady(tasks, Nil, Nil)\n    },\n}\n\ndef runChunk(lo: Int, hi: Int, f: Int -> Void): Void = {\n    let i = cellNew(lo);\n    while (cellGet(i) < hi) {\n        let cur = cellGet(i);\n        f(cur);\n        cellSet(i, cur + 1)\n    }\n}\n\ndef spawnChunks(\n    start: Int,\n    end: Int,\n    step: Int,\n    f: Int -> Void,\n    acc: List (Task Void)\n): List (Task Void) =\n    if (start >= end) acc\n    else {\n        let next = if (start + step > end) end else start + step;\n        let t = spawn(() -> runChunk(start, next, f));\n        spawnChunks(next, end, step, f, Cons(t, acc))\n    }\n\npub def parFor(start: Int, end: Int, f: Int -> Void): Void = {\n    let total = end - start;\n    if (total <= 0) ()\n    else {\n        let workers = numCpu();\n        let step = if (total <= workers) 1 else (total + workers - 1) / workers;\n        let tasks = spawnChunks(start, end, step, f, Nil);\n        let _ = waitAll(tasks);\n        ()\n    }\n}\n\ndef mapChunk(lo: Int, hi: Int, f: Int -> a): List a = {\n    let acc = cellNew(Nil);\n    let i = cellNew(hi - 1);\n    while (cellGet(i) >= lo) {\n        let cur = cellGet(i);\n        cellSet(acc, Cons(f(cur), cellGet(acc)));\n        cellSet(i, cur - 1)\n    };\n    cellGet(acc)\n}\n\ndef spawnRangeChunks(\n    start: Int,\n    end: Int,\n    step: Int,\n    f: Int -> a,\n    acc: List (Task (List a))\n): List (Task (List a)) =\n    if (start >= end) listRev(acc)\n    else {\n        let next = if (start + step > end) end else start + step;\n        let t = spawn(() -> mapChunk(start, next, f));\n        spawnRangeChunks(next, end, step, f, Cons(t, acc))\n    }\n\ndef concatChunkLists(chunks: List (List a)): List a = match chunks {\n    Nil -> Nil,\n    Cons(c, rest) -> listAppend(c, concatChunkLists(rest)),\n}\n\npub def parRange(start: Int, end: Int, f: Int -> a): List a = {\n    let total = end - start;\n    if (total <= 0) Nil\n    else {\n        let workers = numCpu();\n        let step = if (total <= workers) 1 else (total + workers - 1) / workers;\n        let tasks = spawnRangeChunks(start, end, step, f, Nil);\n        concatChunkLists(waitAll(tasks))\n    }\n}\n")
    else if (key == "std.actor") Some("// Thread-pinned sequential actors (`std.actor`):\n// Encapsulate `!Send` local mutable state (`Cell`, `MutArray`, `Vec`, `StrMap`, `Ptr`)\n// behind a sequential mailbox on a dedicated OS thread.\n\nuse std.task.{Task, await}\n\npub def actorSpawn(init: () -> s): Actor s = __concActorSpawn(init)\n\npub def actorCall(actor: Actor s, handler: s -> r): Task r =\n    __concActorCall(actor, handler)\n\npub def actorAsk(actor: Actor s, handler: s -> r): r =\n    await(__concActorCall(actor, handler))\n\npub def actorSend(actor: Actor s, handler: s -> Void): Void =\n    __concActorSend(actor, handler)\n\npub def actorStop(actor: Actor s): Void = __concActorStop(actor)\n")
    else if (key == "std.rand") Some("// Deterministic pure-functional PRNG (SplitMix64) + OS entropy seeding (`std.rand`)\n\nextern \"gs_sys_rand_seed\" def c_rand_seed(): Int64\n\npub data Rng {\n    Rng(Int64),\n}\n\ndef u64FromHalves(hi: Int, lo: Int): Int64 = {\n    let loMask = (intToI64(1) << 32) - intToI64(1);\n    (intToI64(hi) << 32) | (intToI64(lo) & loMask)\n}\n\npub def fromSeed(seed: Int64): Rng = Rng(seed)\n\npub def fromIntSeed(seed: Int): Rng = Rng(intToI64(seed))\n\npub def fromEntropy(): Rng = Rng(c_rand_seed())\n\npub def nextI64(rng: Rng): (Int64, Rng) = match rng {\n    Rng(state) -> {\n        let gamma = u64FromHalves(-1640531527, 2135587861);\n        let mul1 = u64FromHalves(-1084733587, 484763065);\n        let mul2 = u64FromHalves(-1798288965, 321982955);\n        let nextState = state + gamma;\n        let z1 = (nextState ^ (nextState >>> 30)) * mul1;\n        let z2 = (z1 ^ (z1 >>> 27)) * mul2;\n        let out = z2 ^ (z2 >>> 31);\n        (out, Rng(nextState))\n    },\n}\n\npub def nextInt(rng: Rng, bound: Int): (Int, Rng) =\n    if (bound <= 1) {\n        let (_, r2) = nextI64(rng);\n        (0, r2)\n    } else {\n        let (v, r2) = nextI64(rng);\n        let pos = v >>> 1;\n        let rem = pos % intToI64(bound);\n        (i64ToInt(rem), r2)\n    }\n\npub def nextRange(rng: Rng, lo: Int, hi: Int): (Int, Rng) =\n    if (hi <= lo) {\n        let (_, r2) = nextI64(rng);\n        (lo, r2)\n    } else {\n        let (off, r2) = nextInt(rng, hi - lo + 1);\n        (lo + off, r2)\n    }\n\npub def nextBool(rng: Rng): (Bool, Rng) = {\n    let (v, r2) = nextI64(rng);\n    ((v & intToI64(1)) != intToI64(0), r2)\n}\n\npub def nextFloat(rng: Rng): (Float, Rng) = {\n    let (v, r2) = nextI64(rng);\n    // Use 30 uniform bits -> [0.0, 1.0)\n    let bits = i64ToInt(v >>> 34);\n    let f = intToFloat(bits) / 1073741824.0;\n    (f, r2)\n}\n")
    else if (key == "std.math") Some("// Mathematical functions backed by LLVM intrinsics (`std.math`)\n\npub def pi(): Float = 3.141592653589793\npub def e(): Float = 2.718281828459045\n\npub def exp(x: Float): Float = mathExp(x)\npub def log(x: Float): Float = mathLog(x)\npub def sqrt(x: Float): Float = mathSqrt(x)\npub def sin(x: Float): Float = mathSin(x)\npub def cos(x: Float): Float = mathCos(x)\npub def tanh(x: Float): Float = mathTanh(x)\npub def pow(a: Float, b: Float): Float = mathPow(a, b)\npub def abs(x: Float): Float = mathAbs(x)\npub def floor(x: Float): Float = mathFloor(x)\npub def ceil(x: Float): Float = mathCeil(x)\npub def fma(a: Float, b: Float, c: Float): Float = mathFma(a, b, c)\n\npub def expF32(x: Float32): Float32 = mathExpF32(x)\npub def logF32(x: Float32): Float32 = mathLogF32(x)\npub def sqrtF32(x: Float32): Float32 = mathSqrtF32(x)\npub def sinF32(x: Float32): Float32 = mathSinF32(x)\npub def cosF32(x: Float32): Float32 = mathCosF32(x)\npub def tanhF32(x: Float32): Float32 = mathTanhF32(x)\npub def powF32(a: Float32, b: Float32): Float32 = mathPowF32(a, b)\npub def absF32(x: Float32): Float32 = mathAbsF32(x)\npub def floorF32(x: Float32): Float32 = mathFloorF32(x)\npub def ceilF32(x: Float32): Float32 = mathCeilF32(x)\npub def fmaF32(a: Float32, b: Float32, c: Float32): Float32 = mathFmaF32(a, b, c)\n")
    else if (key == "std.generic") Some("// Built-in `Eq` and `Ord` instances over structural Generic representations\n// (`Unit`, `Named`, `Prod`, `Sum` are built-in ADTs in the prelude).\n// Importing `std.generic` enables zero-boilerplate `data T : Eq, Ord { ... }` deriving.\n\ninstance Eq Unit {\n    def eq(_, _) = true\n}\n\ninstance (Eq a) => Eq (Named a) {\n    def eq(x, y) = match (x, y) {\n        (Named(_, a), Named(_, b)) -> eq(a, b),\n    }\n}\n\ninstance (Eq a, Eq b) => Eq (Prod a b) {\n    def eq(x, y) = match (x, y) {\n        (Prod(a1, b1), Prod(a2, b2)) -> eq(a1, a2) && eq(b1, b2),\n    }\n}\n\ninstance (Eq a, Eq b) => Eq (Sum a b) {\n    def eq(x, y) = match (x, y) {\n        (InL(a1), InL(a2)) -> eq(a1, a2),\n        (InR(b1), InR(b2)) -> eq(b1, b2),\n        _ -> false,\n    }\n}\n\ninstance Ord Unit {\n    def compare(_, _) = 0\n}\n\ninstance (Ord a) => Ord (Named a) {\n    def compare(x, y) = match (x, y) {\n        (Named(_, a), Named(_, b)) -> compare(a, b),\n    }\n}\n\ninstance (Ord a, Ord b) => Ord (Prod a b) {\n    def compare(x, y) = match (x, y) {\n        (Prod(a1, b1), Prod(a2, b2)) -> {\n            let c = compare(a1, a2);\n            if (c != 0) c else compare(b1, b2)\n        },\n    }\n}\n\ninstance (Ord a, Ord b) => Ord (Sum a b) {\n    def compare(x, y) = match (x, y) {\n        (InL(a1), InL(a2)) -> compare(a1, a2),\n        (InL(_), InR(_)) -> -1,\n        (InR(_), InL(_)) -> 1,\n        (InR(b1), InR(b2)) -> compare(b1, b2),\n    }\n}\n")
    else if (key == "std.codec") Some("// Format-agnostic structured values, Encode Concept, and first-class Decoder combinators (`std.codec`)\n\nuse std.option.{Option, Some, None}\nuse std.result.{Result, Ok, Err}\nuse std.list.{listRev, listMap}\nuse std.vec.{Vec, vecToList}\nuse std.str.intToStr\n\npub data Value {\n    VNull,\n    VBool(Bool),\n    VInt(Int64),\n    VFloat(Float),\n    VStr(String),\n    VArr(List Value),\n    VObj(List (String, Value)),\n}\n\npub data DecodeErr {\n    DecodeErr { path: String, message: String },\n}\n\npub def makeErr(path: String, message: String): DecodeErr =\n    DecodeErr { path: path, message: message }\n\npub def formatErr(e: DecodeErr): String = e.path + \": \" + e.message\n\ndef prefixPath(prefix: String, e: DecodeErr): DecodeErr =\n    if (e.path == \"$\" || strLen(e.path) == 0) {\n        DecodeErr { path: prefix, message: e.message }\n    } else if (strLen(e.path) > 0 && strByteAt(e.path, 0) == 36) {\n        // Strip leading `$` from child path so `$` + `.a` + `.b` => `$.a.b`\n        DecodeErr { path: prefix + strSlice(e.path, 1, strLen(e.path)), message: e.message }\n    } else {\n        DecodeErr { path: prefix + \".\" + e.path, message: e.message }\n    }\n\n// ---- Clean Value constructors ----\n\npub def null(): Value = VNull\npub def boolVal(b: Bool): Value = VBool(b)\npub def intVal(n: Int): Value = VInt(intToI64(n))\npub def i64Val(n: Int64): Value = VInt(n)\npub def floatVal(f: Float): Value = VFloat(f)\npub def strVal(s: String): Value = VStr(s)\npub def array(xs: List Value): Value = VArr(xs)\npub def object(fields: List (String, Value)): Value = VObj(fields)\n\n// ---- Encode Concept & `:=` field pair operator ----\n\npub concept Encode a {\n    encode: a -> Value\n}\n\ninstance Encode Value {\n    def encode(v) = v\n}\n\ninstance Encode Bool {\n    def encode(b) = VBool(b)\n}\n\ninstance Encode Int {\n    def encode(n) = VInt(intToI64(n))\n}\n\ninstance Encode Int64 {\n    def encode(n) = VInt(n)\n}\n\ninstance Encode Float {\n    def encode(f) = VFloat(f)\n}\n\ninstance Encode String {\n    def encode(s) = VStr(s)\n}\n\ninstance (Encode a) => Encode (Option a) {\n    def encode(opt) = match opt {\n        Some(x) -> encode(x),\n        None -> VNull,\n    }\n}\n\ninstance (Encode a) => Encode (List a) {\n    def encode(xs) = VArr(listMap(xs, (x) -> encode(x)))\n}\n\ninstance (Encode a) => Encode (Vec a) {\n    def encode(v) = encode(vecToList(v))\n}\n\npub def (:=)(key, val): forall a. (Encode a) => (String, a) -> (String, Value) =\n    (key, encode(val))\n\n// ---- First-class Decoder combinators (Functor / Applicative / Monad / Alternative) ----\n\npub data Decoder a {\n    Decoder(Value -> Result a DecodeErr),\n}\n\npub def run(dec: Decoder a, v: Value): Result a DecodeErr = match dec {\n    Decoder(f) -> f(v),\n}\n\npub def (|>)(x: a, f: a -> b): b = f(x)\n\npub def succeed(x: a): Decoder a =\n    Decoder((_) -> Ok(x))\n\npub def fail(msg: String): Decoder a =\n    Decoder((_) -> Err(makeErr(\"$\", msg)))\n\npub def map(f: a -> b, dec: Decoder a): Decoder b =\n    Decoder((v) -> match run(dec, v) {\n        Ok(a) -> Ok(f(a)),\n        Err(e) -> Err(e),\n    })\n\npub def apply(df: Decoder (a -> b), da: Decoder a): Decoder b =\n    Decoder((v) -> match run(df, v) {\n        Err(e) -> Err(e),\n        Ok(f) -> match run(da, v) {\n            Err(e2) -> Err(e2),\n            Ok(a) -> Ok(f(a)),\n        },\n    })\n\npub def andThen(f: a -> Decoder b, dec: Decoder a): Decoder b =\n    Decoder((v) -> match run(dec, v) {\n        Err(e) -> Err(e),\n        Ok(a) -> run(f(a), v),\n    })\n\npub def (<$>)(f: a -> b, dec: Decoder a): Decoder b = map(f, dec)\npub def (<*>)(df: Decoder (a -> b), da: Decoder a): Decoder b = apply(df, da)\npub def (>>=)(dec: Decoder a, f: a -> Decoder b): Decoder b = andThen(f, dec)\n\npub def (<|>)(d1: Decoder a, d2: Decoder a): Decoder a =\n    Decoder((v) -> match run(d1, v) {\n        Ok(x) -> Ok(x),\n        Err(_) -> run(d2, v),\n    })\n\n// ---- Primitive decoders ----\n\npub def value: Decoder Value =\n    Decoder((v) -> Ok(v))\n\npub def valueTypeName(v: Value): String = match v {\n    VNull -> \"null\",\n    VBool(_) -> \"bool\",\n    VInt(_) -> \"int\",\n    VFloat(_) -> \"float\",\n    VStr(_) -> \"string\",\n    VArr(_) -> \"array\",\n    VObj(_) -> \"object\",\n}\n\npub def isNull: Decoder Void =\n    Decoder((v) -> match v {\n        VNull -> Ok(()),\n        _ -> Err(makeErr(\"$\", \"expected null, got \" + valueTypeName(v))),\n    })\n\npub def bool: Decoder Bool =\n    Decoder((v) -> match v {\n        VBool(b) -> Ok(b),\n        _ -> Err(makeErr(\"$\", \"expected bool, got \" + valueTypeName(v))),\n    })\n\npub def i64: Decoder Int64 =\n    Decoder((v) -> match v {\n        VInt(n) -> Ok(n),\n        _ -> Err(makeErr(\"$\", \"expected int, got \" + valueTypeName(v))),\n    })\n\npub def int: Decoder Int =\n    Decoder((v) -> match v {\n        VInt(n) -> Ok(i64ToInt(n)),\n        _ -> Err(makeErr(\"$\", \"expected int, got \" + valueTypeName(v))),\n    })\n\npub def float: Decoder Float =\n    Decoder((v) -> match v {\n        VFloat(f) -> Ok(f),\n        VInt(n) -> Ok(intToFloat(i64ToInt(n))),\n        _ -> Err(makeErr(\"$\", \"expected number, got \" + valueTypeName(v))),\n    })\n\npub def str: Decoder String =\n    Decoder((v) -> match v {\n        VStr(s) -> Ok(s),\n        _ -> Err(makeErr(\"$\", \"expected string, got \" + valueTypeName(v))),\n    })\n\n// ---- Container & Object combinators ----\n\npub def nullable(inner: Decoder a): Decoder (Option a) =\n    Decoder((v) -> match v {\n        VNull -> Ok(None),\n        _ -> match run(inner, v) {\n            Ok(x) -> Ok(Some(x)),\n            Err(e) -> Err(e),\n        },\n    })\n\ndef decodeListLoop(xs: List Value, elem: Decoder a, idx: Int, acc: List a): Result (List a) DecodeErr =\n    match xs {\n        Nil -> Ok(listRev(acc)),\n        Cons(h, t) -> match run(elem, h) {\n            Ok(item) -> decodeListLoop(t, elem, idx + 1, Cons(item, acc)),\n            Err(e) -> Err(prefixPath(\"$[\" + intToStr(idx) + \"]\", e)),\n        },\n    }\n\npub def list(elem: Decoder a): Decoder (List a) =\n    Decoder((v) -> match v {\n        VArr(xs) -> decodeListLoop(xs, elem, 0, Nil),\n        _ -> Err(makeErr(\"$\", \"expected array, got \" + valueTypeName(v))),\n    })\n\ndef lookupField(fields: List (String, Value), key: String): Option Value = match fields {\n    Nil -> None,\n    Cons((k, v), rest) -> if (k == key) Some(v) else lookupField(rest, key),\n}\n\npub def at(key: String, dec: Decoder a): Decoder a =\n    Decoder((v) -> match v {\n        VObj(fields) -> match lookupField(fields, key) {\n            None -> Err(makeErr(\"$.\" + key, \"missing required field\")),\n            Some(fv) -> match run(dec, fv) {\n                Ok(x) -> Ok(x),\n                Err(e) -> Err(prefixPath(\"$.\" + key, e)),\n            },\n        },\n        _ -> Err(makeErr(\"$\", \"expected object for field '\" + key + \"', got \" + valueTypeName(v))),\n    })\n\npub def atOpt(key: String, dec: Decoder a): Decoder (Option a) =\n    Decoder((v) -> match v {\n        VObj(fields) -> match lookupField(fields, key) {\n            None -> Ok(None),\n            Some(VNull) -> Ok(None),\n            Some(fv) -> match run(dec, fv) {\n                Ok(x) -> Ok(Some(x)),\n                Err(e) -> Err(prefixPath(\"$.\" + key, e)),\n            },\n        },\n        _ -> Err(makeErr(\"$\", \"expected object for optional field '\" + key + \"', got \" + valueTypeName(v))),\n    })\n\npub def atOr(key: String, dec: Decoder a, fallback: a): Decoder a =\n    map((opt) -> match opt { Some(x) -> x, None -> fallback }, atOpt(key, dec))\n\n// ---- Pipeline combinators (`succeed(ctor) |> req(...) |> opt(...) |> withDefault(...)`) ----\n\npub def req(key: String, dec: Decoder a): Decoder (a -> b) -> Decoder b =\n    (df) -> apply(df, at(key, dec))\n\npub def opt(key: String, dec: Decoder a): Decoder (Option a -> b) -> Decoder b =\n    (df) -> apply(df, atOpt(key, dec))\n\npub def withDefault(key: String, dec: Decoder a, fallback: a): Decoder (a -> b) -> Decoder b =\n    (df) -> apply(df, atOr(key, dec, fallback))\n\npub def hardcoded(val: a): Decoder (a -> b) -> Decoder b =\n    (df) -> apply(df, succeed(val))\n\n// ---- Sum-type / ADT combinators ----\n\ndef oneOfLoop(decs: List (Decoder a), v: Value): Result a DecodeErr = match decs {\n    Nil -> Err(makeErr(\"$\", \"no decoder in oneOf matched\")),\n    Cons(d, Nil) -> run(d, v),\n    Cons(d, rest) -> match run(d, v) {\n        Ok(x) -> Ok(x),\n        Err(_) -> oneOfLoop(rest, v),\n    },\n}\n\npub def oneOf(decs: List (Decoder a)): Decoder a =\n    Decoder((v) -> oneOfLoop(decs, v))\n\ndef lookupVariant(variants: List (String, Decoder a), tag: String): Option (Decoder a) = match variants {\n    Nil -> None,\n    Cons((name, dec), rest) -> if (name == tag) Some(dec) else lookupVariant(rest, tag),\n}\n\npub def tagged(tagField: String, variants: List (String, Decoder a)): Decoder a =\n    andThen(\n        (tag) -> match lookupVariant(variants, tag) {\n            Some(dec) -> dec,\n            None -> fail(\"unknown tag '\" + tag + \"' in field '\" + tagField + \"'\"),\n        },\n        at(tagField, str)\n    )\n")
    else if (key == "std.json") Some("// Pure-Geisha RFC 8259 JSON parser and serializer (`std.json`)\n\nuse std.option.{Option, Some, None}\nuse std.result.{Result, Ok, Err}\nuse std.buf.{StringBuf, bufNew, bufPushByte, bufPushStr, bufToString}\nuse std.str.{intToStr, i64ToStr, floatToStr, parseInt64, parseFloat}\nuse std.list.listRev\nuse std.codec.{\n    Value, VNull, VBool, VInt, VFloat, VStr, VArr, VObj,\n    DecodeErr, makeErr, Decoder, run, Encode, encode\n}\n\n// ---- Recursive-descent JSON parser ----\n\ndata Parser {\n    Parser { src: String, len: Int, pos: Cell Int },\n}\n\ndef peek(p: Parser): Int = {\n    let i = cellGet(p.pos);\n    if (i >= p.len) -1 else strByteAt(p.src, i)\n}\n\ndef bump(p: Parser): Int = {\n    let i = cellGet(p.pos);\n    if (i >= p.len) -1\n    else {\n        cellSet(p.pos, i + 1);\n        strByteAt(p.src, i)\n    }\n}\n\ndef skipWs(p: Parser): Void = {\n    let looping = cellNew(true);\n    while (cellGet(looping)) {\n        let c = peek(p);\n        if (c == 32 || c == 9 || c == 10 || c == 13) {\n            let _ = bump(p);\n            ()\n        } else {\n            cellSet(looping, false)\n        }\n    }\n}\n\ndef hexVal(b: Int): Int =\n    if (b >= 48 && b <= 57) b - 48\n    else if (b >= 65 && b <= 70) b - 55\n    else if (b >= 97 && b <= 102) b - 87\n    else -1\n\ndef readHex4(p: Parser): Result Int String = {\n    let b0 = hexVal(bump(p));\n    let b1 = hexVal(bump(p));\n    let b2 = hexVal(bump(p));\n    let b3 = hexVal(bump(p));\n    if (b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0) {\n        Err(\"invalid \\\\uXXXX hex escape at byte \" + intToStr(cellGet(p.pos)))\n    } else {\n        Ok((b0 << 12) | (b1 << 8) | (b2 << 4) | b3)\n    }\n}\n\ndef pushUtf8(buf: StringBuf, cp: Int): Void =\n    if (cp < 128) {\n        bufPushByte(buf, cp)\n    } else if (cp < 2048) {\n        bufPushByte(buf, 192 | (cp >>> 6));\n        bufPushByte(buf, 128 | (cp & 63))\n    } else if (cp < 65536) {\n        bufPushByte(buf, 224 | (cp >>> 12));\n        bufPushByte(buf, 128 | ((cp >>> 6) & 63));\n        bufPushByte(buf, 128 | (cp & 63))\n    } else {\n        bufPushByte(buf, 240 | (cp >>> 18));\n        bufPushByte(buf, 128 | ((cp >>> 12) & 63));\n        bufPushByte(buf, 128 | ((cp >>> 6) & 63));\n        bufPushByte(buf, 128 | (cp & 63))\n    }\n\ndef parseStringRaw(p: Parser): Result String String = {\n    let openQuote = bump(p);\n    if (openQuote != 34) {\n        Err(\"expected '\\\"' at byte \" + intToStr(cellGet(p.pos)))\n    } else {\n        // Fast path: scan unescaped string directly without allocating a StringBuf\n        let start = cellGet(p.pos);\n        let cur = cellNew(start);\n        let fastDone = cellNew(false);\n        let fastOk = cellNew(false);\n        let fastErr = cellNew(\"\");\n        while (!cellGet(fastDone)) {\n            let idx = cellGet(cur);\n            if (idx >= p.len) {\n                cellSet(fastErr, \"unterminated JSON string\");\n                cellSet(fastDone, true)\n            } else {\n                let c = strByteAt(p.src, idx);\n                if (c == 34) {\n                    cellSet(p.pos, idx + 1);\n                    cellSet(fastOk, true);\n                    cellSet(fastDone, true)\n                } else if (c == 92) {\n                    cellSet(fastDone, true)\n                } else if (c < 32) {\n                    cellSet(fastErr, \"unescaped control character in JSON string\");\n                    cellSet(fastDone, true)\n                } else {\n                    cellSet(cur, idx + 1)\n                }\n            }\n        };\n        if (cellGet(fastOk)) {\n            Ok(ptrSliceFromStr(p.src, start, cellGet(cur) - start))\n        } else if (strLen(cellGet(fastErr)) > 0) {\n            Err(cellGet(fastErr))\n        } else {\n            // Slow path: string contains escape sequences; copy unescaped prefix then decode escapes\n            let out = bufNew();\n            let prefixLen = cellGet(cur) - start;\n            if (prefixLen > 0) {\n                bufPushStr(out, ptrSliceFromStr(p.src, start, prefixLen))\n            } else ();\n            cellSet(p.pos, cellGet(cur));\n            let done = cellNew(false);\n            let failed = cellNew(false);\n            let err = cellNew(\"\");\n            while (!cellGet(done) && !cellGet(failed)) {\n                let c = bump(p);\n                if (c < 0) {\n                    cellSet(err, \"unterminated JSON string\");\n                    cellSet(failed, true)\n                } else if (c == 34) {\n                    cellSet(done, true)\n                } else if (c == 92) {\n                    let esc = bump(p);\n                    if (esc == 34) bufPushByte(out, 34)\n                    else if (esc == 92) bufPushByte(out, 92)\n                    else if (esc == 47) bufPushByte(out, 47)\n                    else if (esc == 98) bufPushByte(out, 8)\n                    else if (esc == 102) bufPushByte(out, 12)\n                    else if (esc == 110) bufPushByte(out, 10)\n                    else if (esc == 114) bufPushByte(out, 13)\n                    else if (esc == 116) bufPushByte(out, 9)\n                    else if (esc == 117) {\n                        match readHex4(p) {\n                            Err(e) -> { cellSet(err, e); cellSet(failed, true) },\n                            Ok(u1) ->\n                                if (u1 >= 55296 && u1 <= 56319) {\n                                    // High surrogate: expect `\\u` + low surrogate\n                                    let s1 = bump(p);\n                                    let s2 = bump(p);\n                                    if (s1 != 92 || s2 != 117) {\n                                        cellSet(err, \"expected low surrogate after high surrogate\");\n                                        cellSet(failed, true)\n                                    } else {\n                                        match readHex4(p) {\n                                            Err(e2) -> { cellSet(err, e2); cellSet(failed, true) },\n                                            Ok(u2) ->\n                                                if (u2 >= 56320 && u2 <= 57343) {\n                                                    let cp = 65536 + ((u1 - 55296) << 10) + (u2 - 56320);\n                                                    pushUtf8(out, cp)\n                                                } else {\n                                                    cellSet(err, \"invalid low surrogate escape\");\n                                                    cellSet(failed, true)\n                                                },\n                                        }\n                                    }\n                                } else {\n                                    pushUtf8(out, u1)\n                                },\n                        }\n                    } else {\n                        cellSet(err, \"invalid escape sequence in JSON string\");\n                        cellSet(failed, true)\n                    }\n                } else if (c < 32) {\n                    cellSet(err, \"unescaped control character in JSON string\");\n                    cellSet(failed, true)\n                } else {\n                    bufPushByte(out, c)\n                }\n            };\n            if (cellGet(failed)) Err(cellGet(err))\n            else Ok(bufToString(out))\n        }\n    }\n}\n\ndef expectLiteral(p: Parser, lit: String): Result Void String = {\n    let n = strLen(lit);\n    let start = cellGet(p.pos);\n    if (start + n > p.len) {\n        Err(\"unexpected EOF while expecting '\" + lit + \"'\")\n    } else {\n        let i = cellNew(0);\n        let ok = cellNew(true);\n        while (cellGet(i) < n && cellGet(ok)) {\n            let idx = cellGet(i);\n            if (strByteAt(p.src, start + idx) != strByteAt(lit, idx)) cellSet(ok, false) else ();\n            cellSet(i, idx + 1)\n        };\n        if (cellGet(ok)) {\n            cellSet(p.pos, start + n);\n            Ok(())\n        } else {\n            Err(\"expected '\" + lit + \"' at byte \" + intToStr(start))\n        }\n    }\n}\n\ndef parseNumber(p: Parser): Result Value String = {\n    let start = cellGet(p.pos);\n    let isFloat = cellNew(false);\n    if (peek(p) == 45) {\n        let _ = bump(p);\n        ()\n    } else ();\n    let dStart = cellGet(p.pos);\n    let firstDigit = peek(p);\n    if (firstDigit == 48) {\n        let _ = bump(p);\n        if (peek(p) >= 48 && peek(p) <= 57) {\n            cellSet(p.pos, dStart)\n        } else ()\n    } else {\n        while (peek(p) >= 48 && peek(p) <= 57) {\n            let _ = bump(p);\n            ()\n        }\n    };\n    if (cellGet(p.pos) == dStart) {\n        Err(\"invalid JSON number at byte \" + intToStr(start))\n    } else {\n        if (peek(p) == 46) {\n            cellSet(isFloat, true);\n            let _ = bump(p);\n            let fStart = cellGet(p.pos);\n            while (peek(p) >= 48 && peek(p) <= 57) {\n                let _ = bump(p);\n                ()\n            };\n            if (cellGet(p.pos) == fStart) {\n                cellSet(p.pos, start)\n            } else ()\n        } else ();\n        let ec = peek(p);\n        if (ec == 101 || ec == 69) {\n            cellSet(isFloat, true);\n            let _ = bump(p);\n            let sc = peek(p);\n            if (sc == 43 || sc == 45) {\n                let _ = bump(p);\n                ()\n            } else ();\n            let eStart = cellGet(p.pos);\n            while (peek(p) >= 48 && peek(p) <= 57) {\n                let _ = bump(p);\n                ()\n            };\n            if (cellGet(p.pos) == eStart) {\n                cellSet(p.pos, start)\n            } else ()\n        } else ();\n        let endIdx = cellGet(p.pos);\n        if (endIdx <= start) {\n            Err(\"invalid JSON number at byte \" + intToStr(start))\n        } else {\n            let raw = ptrSliceFromStr(p.src, start, endIdx - start);\n            if (cellGet(isFloat)) {\n                match parseFloat(raw) {\n                    Ok(f) -> {\n                        let expMask = (intToI64(2047)) << 52;\n                        if ((floatToBits64(f) & expMask) == expMask) {\n                            Err(\"JSON number overflow: \" + raw)\n                        } else {\n                            Ok(VFloat(f))\n                        }\n                    },\n                    Err(e) -> Err(e),\n                }\n            } else {\n                match parseInt64(raw) {\n                    Ok(n) -> Ok(VInt(n)),\n                    Err(e) -> Err(e),\n                }\n            }\n        }\n    }\n}\n\ndef parseValue(p: Parser, depth: Int): Result Value String =\n    if (depth > 128) {\n        Err(\"JSON nesting depth exceeded 128\")\n    } else {\n        skipWs(p);\n        let c = peek(p);\n        if (c < 0) Err(\"unexpected EOF in JSON\")\n        else if (c == 110) {\n            let _ = expectLiteral(p, \"null\")?;\n            Ok(VNull)\n        } else if (c == 116) {\n            let _ = expectLiteral(p, \"true\")?;\n            Ok(VBool(true))\n        } else if (c == 102) {\n            let _ = expectLiteral(p, \"false\")?;\n            Ok(VBool(false))\n        } else if (c == 34) {\n            let s = parseStringRaw(p)?;\n            Ok(VStr(s))\n        } else if (c == 91) {\n            parseArray(p, depth + 1)\n        } else if (c == 123) {\n            parseObject(p, depth + 1)\n        } else if (c == 45 || (c >= 48 && c <= 57)) {\n            parseNumber(p)\n        } else {\n            Err(\"unexpected character in JSON at byte \" + intToStr(cellGet(p.pos)))\n        }\n    }\n\ndef parseArray(p: Parser, depth: Int): Result Value String = {\n    let _ = bump(p);\n    skipWs(p);\n    if (peek(p) == 93) {\n        let _ = bump(p);\n        Ok(VArr(Nil))\n    } else {\n        let acc = cellNew(Nil);\n        let done = cellNew(false);\n        let err = cellNew(\"\");\n        while (!cellGet(done) && strLen(cellGet(err)) == 0) {\n            match parseValue(p, depth) {\n                Err(e) -> cellSet(err, e),\n                Ok(item) -> {\n                    cellSet(acc, Cons(item, cellGet(acc)));\n                    skipWs(p);\n                    let next = peek(p);\n                    if (next == 44) {\n                        let _ = bump(p);\n                        ()\n                    } else if (next == 93) {\n                        let _ = bump(p);\n                        cellSet(done, true)\n                    } else {\n                        cellSet(err, \"expected ',' or ']' in JSON array at byte \" + intToStr(cellGet(p.pos)))\n                    }\n                },\n            }\n        };\n        if (strLen(cellGet(err)) > 0) Err(cellGet(err))\n        else Ok(VArr(listRev(cellGet(acc))))\n    }\n}\n\ndef parseObject(p: Parser, depth: Int): Result Value String = {\n    let _ = bump(p);\n    skipWs(p);\n    if (peek(p) == 125) {\n        let _ = bump(p);\n        Ok(VObj(Nil))\n    } else {\n        let acc = cellNew(Nil);\n        let done = cellNew(false);\n        let err = cellNew(\"\");\n        while (!cellGet(done) && strLen(cellGet(err)) == 0) {\n            skipWs(p);\n            match parseStringRaw(p) {\n                Err(e) -> cellSet(err, e),\n                Ok(key) -> {\n                    skipWs(p);\n                    if (peek(p) != 58) {\n                        cellSet(err, \"expected ':' after object key at byte \" + intToStr(cellGet(p.pos)))\n                    } else {\n                        let _ = bump(p);\n                        match parseValue(p, depth) {\n                            Err(e2) -> cellSet(err, e2),\n                            Ok(val) -> {\n                                cellSet(acc, Cons((key, val), cellGet(acc)));\n                                skipWs(p);\n                                let next = peek(p);\n                                if (next == 44) {\n                                    let _ = bump(p);\n                                    ()\n                                } else if (next == 125) {\n                                    let _ = bump(p);\n                                    cellSet(done, true)\n                                } else {\n                                    cellSet(err, \"expected ',' or '}' in JSON object at byte \" + intToStr(cellGet(p.pos)))\n                                }\n                            },\n                        }\n                    }\n                },\n            }\n        };\n        if (strLen(cellGet(err)) > 0) Err(cellGet(err))\n        else Ok(VObj(listRev(cellGet(acc))))\n    }\n}\n\npub def parse(input: String): Result Value String = {\n    let p = Parser { src: input, len: strLen(input), pos: cellNew(0) };\n    let val = parseValue(p, 0)?;\n    skipWs(p);\n    if (cellGet(p.pos) != p.len) {\n        Err(\"trailing characters after JSON value at byte \" + intToStr(cellGet(p.pos)))\n    } else {\n        Ok(val)\n    }\n}\n\n// ---- JSON serializer ----\n\ndef hexDigitByte(n: Int): Int =\n    if (n < 10) 48 + n else 87 + n\n\ndef emitJsonString(b: StringBuf, s: String): Void = {\n    bufPushByte(b, 34);\n    let n = strLen(s);\n    // Fast path: check if any byte needs JSON escaping; if not, bulk memcpy whole string\n    let needsEsc = cellNew(false);\n    let k = cellNew(0);\n    while (cellGet(k) < n && !cellGet(needsEsc)) {\n        let idx = cellGet(k);\n        let c = strByteAt(s, idx);\n        if (c == 34 || c == 92 || c < 32) cellSet(needsEsc, true) else ();\n        cellSet(k, idx + 1)\n    };\n    if (!cellGet(needsEsc)) {\n        bufPushStr(b, s)\n    } else {\n        let i = cellNew(0);\n        while (cellGet(i) < n) {\n            let idx = cellGet(i);\n            let c = strByteAt(s, idx);\n            if (c == 34) bufPushStr(b, \"\\\\\\\"\")\n            else if (c == 92) bufPushStr(b, \"\\\\\\\\\")\n            else if (c == 8) bufPushStr(b, \"\\\\b\")\n            else if (c == 12) bufPushStr(b, \"\\\\f\")\n            else if (c == 10) bufPushStr(b, \"\\\\n\")\n            else if (c == 13) bufPushStr(b, \"\\\\r\")\n            else if (c == 9) bufPushStr(b, \"\\\\t\")\n            else if (c < 32) {\n                bufPushStr(b, \"\\\\u00\");\n                bufPushByte(b, hexDigitByte((c >>> 4) & 15));\n                bufPushByte(b, hexDigitByte(c & 15))\n            } else {\n                bufPushByte(b, c)\n            };\n            cellSet(i, idx + 1)\n        }\n    };\n    bufPushByte(b, 34)\n}\n\ndef emitIndent(b: StringBuf, spaces: Int): Void = {\n    let i = cellNew(0);\n    while (cellGet(i) < spaces) {\n        bufPushByte(b, 32);\n        cellSet(i, cellGet(i) + 1)\n    }\n}\n\ndef emitValue(b: StringBuf, v: Value, pretty: Bool, indent: Int): Void = match v {\n    VNull -> bufPushStr(b, \"null\"),\n    VBool(true) -> bufPushStr(b, \"true\"),\n    VBool(false) -> bufPushStr(b, \"false\"),\n    VInt(n) -> bufPushStr(b, i64ToStr(n)),\n    VFloat(f) -> {\n        let expMask = (intToI64(2047)) << 52;\n        if ((floatToBits64(f) & expMask) == expMask) bufPushStr(b, \"null\")\n        else bufPushStr(b, floatToStr(f))\n    },\n    VStr(s) -> emitJsonString(b, s),\n    VArr(Nil) -> bufPushStr(b, \"[]\"),\n    VArr(xs) -> {\n        bufPushByte(b, 91);\n        let cur = cellNew(xs);\n        let first = cellNew(true);\n        while (match cellGet(cur) { Nil -> false, _ -> true }) {\n            match cellGet(cur) {\n                Cons(h, t) -> {\n                    if (!cellGet(first)) bufPushByte(b, 44) else ();\n                    cellSet(first, false);\n                    if (pretty) {\n                        bufPushByte(b, 10);\n                        emitIndent(b, indent + 2)\n                    } else ();\n                    emitValue(b, h, pretty, indent + 2);\n                    cellSet(cur, t)\n                },\n                Nil -> (),\n            }\n        };\n        if (pretty) {\n            bufPushByte(b, 10);\n            emitIndent(b, indent)\n        } else ();\n        bufPushByte(b, 93)\n    },\n    VObj(Nil) -> bufPushStr(b, \"{}\"),\n    VObj(fields) -> {\n        bufPushByte(b, 123);\n        let cur = cellNew(fields);\n        let first = cellNew(true);\n        while (match cellGet(cur) { Nil -> false, _ -> true }) {\n            match cellGet(cur) {\n                Cons((k, val), t) -> {\n                    if (!cellGet(first)) bufPushByte(b, 44) else ();\n                    cellSet(first, false);\n                    if (pretty) {\n                        bufPushByte(b, 10);\n                        emitIndent(b, indent + 2)\n                    } else ();\n                    emitJsonString(b, k);\n                    if (pretty) bufPushStr(b, \": \") else bufPushByte(b, 58);\n                    emitValue(b, val, pretty, indent + 2);\n                    cellSet(cur, t)\n                },\n                Nil -> (),\n            }\n        };\n        if (pretty) {\n            bufPushByte(b, 10);\n            emitIndent(b, indent)\n        } else ();\n        bufPushByte(b, 125)\n    },\n}\n\npub def stringify(v: Value): String = {\n    let b = bufNew();\n    emitValue(b, v, false, 0);\n    bufToString(b)\n}\n\npub def stringifyPretty(v: Value): String = {\n    let b = bufNew();\n    emitValue(b, v, true, 0);\n    bufToString(b)\n}\n\npub def toJson(x): forall a. (Encode a) => a -> String =\n    stringify(encode(x))\n\npub def toJsonPretty(x): forall a. (Encode a) => a -> String =\n    stringifyPretty(encode(x))\n\npub def decodeString(dec: Decoder a, raw: String): Result a DecodeErr =\n    match parse(raw) {\n        Err(msg) -> Err(makeErr(\"$\", msg)),\n        Ok(v) -> run(dec, v),\n    }\n")
    else if (key == "std.toml") Some("// Pure-Geisha TOML v1.0 parser and canonical serializer (`std.toml`),\n// bridging directly into `std.codec.Value` and `std.codec.Decoder`.\n\nuse std.option.{Option, Some, None}\nuse std.result.{Result, Ok, Err}\nuse std.buf.{StringBuf, bufNew, bufPushByte, bufPushStr, bufToString}\nuse std.str.{intToStr, i64ToStr, floatToStr, parseInt64, parseFloat, strJoin}\nuse std.list.{listRev, listAppend, listLen}\nuse std.codec.{\n    Value, VNull, VBool, VInt, VFloat, VStr, VArr, VObj,\n    DecodeErr, makeErr, Decoder, run, Encode, encode\n}\n\ndata TomlParser {\n    MkTomlParser { tpSrc: String, tpLen: Int, tpPos: Cell Int, tpLine: Cell Int },\n}\n\ndef newTomlParser(src: String): TomlParser =\n    MkTomlParser { tpSrc: src, tpLen: strLen(src), tpPos: cellNew(0), tpLine: cellNew(1) }\n\ndef peek(p: TomlParser): Int = {\n    let i = cellGet(p.tpPos);\n    if (i >= p.tpLen) -1 else strByteAt(p.tpSrc, i)\n}\n\ndef peekAt(p: TomlParser, off: Int): Int = {\n    let i = cellGet(p.tpPos) + off;\n    if (i < 0 || i >= p.tpLen) -1 else strByteAt(p.tpSrc, i)\n}\n\ndef bump(p: TomlParser): Int = {\n    let i = cellGet(p.tpPos);\n    if (i >= p.tpLen) -1\n    else {\n        let b = strByteAt(p.tpSrc, i);\n        cellSet(p.tpPos, i + 1);\n        if (b == 10) cellSet(p.tpLine, cellGet(p.tpLine) + 1) else ();\n        b\n    }\n}\n\ndef tomlErr(p: TomlParser, msg: String): String =\n    \"TOML error at line \" + intToStr(cellGet(p.tpLine)) + \": \" + msg\n\ndef isHorizWs(b: Int): Bool = b == 32 || b == 9\n\ndef skipInlineWs(p: TomlParser): Void = {\n    while (isHorizWs(peek(p))) {\n        let _ = bump(p);\n        ()\n    }\n}\n\ndef skipComment(p: TomlParser): Void = {\n    if (peek(p) == 35) {\n        while ({\n            let c = peek(p);\n            c >= 0 && c != 10\n        }) {\n            let _ = bump(p);\n            ()\n        }\n    } else ()\n}\n\ndef skipWsAndComments(p: TomlParser): Void = {\n    let going = cellNew(true);\n    while (cellGet(going)) {\n        let c = peek(p);\n        if (c == 32 || c == 9 || c == 10 || c == 13) {\n            let _ = bump(p);\n            ()\n        } else if (c == 35) {\n            skipComment(p)\n        } else {\n            cellSet(going, false)\n        }\n    }\n}\n\ndef expectLineEndOrEof(p: TomlParser): Result Void String = {\n    skipInlineWs(p);\n    skipComment(p);\n    let c = peek(p);\n    if (c < 0) Ok(())\n    else if (c == 10) {\n        let _ = bump(p);\n        Ok(())\n    } else if (c == 13 && peekAt(p, 1) == 10) {\n        let _ = bump(p);\n        let _ = bump(p);\n        Ok(())\n    } else {\n        Err(tomlErr(p, \"expected newline or end of file\"))\n    }\n}\n\ndef isBareKeyByte(b: Int): Bool =\n    (b >= 65 && b <= 90)\n    || (b >= 97 && b <= 122)\n    || (b >= 48 && b <= 57)\n    || b == 95\n    || b == 45\n\ndef hexVal(b: Int): Int =\n    if (b >= 48 && b <= 57) b - 48\n    else if (b >= 65 && b <= 70) b - 55\n    else if (b >= 97 && b <= 102) b - 87\n    else -1\n\ndef readHexN(p: TomlParser, count: Int): Result Int String = {\n    let acc = cellNew(0);\n    let i = cellNew(0);\n    let ok = cellNew(true);\n    while (cellGet(i) < count && cellGet(ok)) {\n        let hv = hexVal(bump(p));\n        if (hv < 0) cellSet(ok, false)\n        else {\n            cellSet(acc, (cellGet(acc) << 4) | hv);\n            cellSet(i, cellGet(i) + 1)\n        }\n    };\n    if (cellGet(ok)) Ok(cellGet(acc))\n    else Err(tomlErr(p, \"invalid Unicode hex escape\"))\n}\n\ndef pushUtf8(buf: StringBuf, cp: Int): Void =\n    if (cp < 128) {\n        bufPushByte(buf, cp)\n    } else if (cp < 2048) {\n        bufPushByte(buf, 192 | (cp >>> 6));\n        bufPushByte(buf, 128 | (cp & 63))\n    } else if (cp < 65536) {\n        bufPushByte(buf, 224 | (cp >>> 12));\n        bufPushByte(buf, 128 | ((cp >>> 6) & 63));\n        bufPushByte(buf, 128 | (cp & 63))\n    } else {\n        bufPushByte(buf, 240 | (cp >>> 18));\n        bufPushByte(buf, 128 | ((cp >>> 12) & 63));\n        bufPushByte(buf, 128 | ((cp >>> 6) & 63));\n        bufPushByte(buf, 128 | (cp & 63))\n    }\n\ndef decodeEscape(p: TomlParser, out: StringBuf, allowMultilineTrim: Bool): Result Void String = {\n    let esc = bump(p);\n    if (esc == 34) { bufPushByte(out, 34); Ok(()) }\n    else if (esc == 92) { bufPushByte(out, 92); Ok(()) }\n    else if (esc == 98) { bufPushByte(out, 8); Ok(()) }\n    else if (esc == 102) { bufPushByte(out, 12); Ok(()) }\n    else if (esc == 110) { bufPushByte(out, 10); Ok(()) }\n    else if (esc == 114) { bufPushByte(out, 13); Ok(()) }\n    else if (esc == 116) { bufPushByte(out, 9); Ok(()) }\n    else if (esc == 117) {\n        let cp = readHexN(p, 4)?;\n        pushUtf8(out, cp);\n        Ok(())\n    } else if (esc == 85) {\n        let cp = readHexN(p, 8)?;\n        pushUtf8(out, cp);\n        Ok(())\n    } else if (allowMultilineTrim && (esc == 32 || esc == 9 || esc == 10 || esc == 13)) {\n        let sawNl = cellNew(esc == 10);\n        if (esc == 13 && peek(p) == 10) {\n            let _ = bump(p);\n            cellSet(sawNl, true)\n        } else ();\n        while (!cellGet(sawNl) && isHorizWs(peek(p))) {\n            let _ = bump(p);\n            ()\n        };\n        if (!cellGet(sawNl)) {\n            if (peek(p) == 10) {\n                let _ = bump(p);\n                cellSet(sawNl, true)\n            } else if (peek(p) == 13 && peekAt(p, 1) == 10) {\n                let _ = bump(p);\n                let _ = bump(p);\n                cellSet(sawNl, true)\n            } else ()\n        } else ();\n        if (!cellGet(sawNl)) Err(tomlErr(p, \"invalid line-ending backslash in multiline string\"))\n        else {\n            while ({\n                let c = peek(p);\n                c == 32 || c == 9 || c == 10 || c == 13\n            }) {\n                let _ = bump(p);\n                ()\n            };\n            Ok(())\n        }\n    } else {\n        Err(tomlErr(p, \"invalid string escape sequence\"))\n    }\n}\n\ndef parseBasicString(p: TomlParser): Result String String = {\n    if (peek(p) == 34 && peekAt(p, 1) == 34 && peekAt(p, 2) == 34) {\n        let _ = bump(p);\n        let _ = bump(p);\n        let _ = bump(p);\n        if (peek(p) == 10) { let _ = bump(p); () }\n        else if (peek(p) == 13 && peekAt(p, 1) == 10) { let _ = bump(p); let _ = bump(p); () }\n        else ();\n        let out = bufNew();\n        let done = cellNew(false);\n        let errOpt: Cell (Option String) = cellNew(None);\n        while (!cellGet(done) && match cellGet(errOpt) { None -> true, Some(_) -> false }) {\n            let c = peek(p);\n            if (c < 0) {\n                cellSet(errOpt, Some(tomlErr(p, \"unterminated multiline basic string\")))\n            } else if (c == 34 && peekAt(p, 1) == 34 && peekAt(p, 2) == 34) {\n                let _ = bump(p);\n                let _ = bump(p);\n                let _ = bump(p);\n                while (peek(p) == 34 && !(peekAt(p, 1) == 34 && peekAt(p, 2) == 34)) {\n                    let _ = bump(p);\n                    bufPushByte(out, 34)\n                };\n                cellSet(done, true)\n            } else if (c == 92) {\n                let _ = bump(p);\n                match decodeEscape(p, out, true) {\n                    Ok(_) -> (),\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                }\n            } else {\n                bufPushByte(out, bump(p))\n            }\n        };\n        match cellGet(errOpt) {\n            Some(e) -> Err(e),\n            None -> Ok(bufToString(out)),\n        }\n    } else {\n        let _ = bump(p);\n        let out = bufNew();\n        let done = cellNew(false);\n        let errOpt: Cell (Option String) = cellNew(None);\n        while (!cellGet(done) && match cellGet(errOpt) { None -> true, Some(_) -> false }) {\n            let c = peek(p);\n            if (c < 0 || c == 10 || c == 13) {\n                cellSet(errOpt, Some(tomlErr(p, \"unterminated basic string\")))\n            } else if (c == 34) {\n                let _ = bump(p);\n                cellSet(done, true)\n            } else if (c == 92) {\n                let _ = bump(p);\n                match decodeEscape(p, out, false) {\n                    Ok(_) -> (),\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                }\n            } else {\n                bufPushByte(out, bump(p))\n            }\n        };\n        match cellGet(errOpt) {\n            Some(e) -> Err(e),\n            None -> Ok(bufToString(out)),\n        }\n    }\n}\n\ndef parseLiteralString(p: TomlParser): Result String String = {\n    if (peek(p) == 39 && peekAt(p, 1) == 39 && peekAt(p, 2) == 39) {\n        let _ = bump(p);\n        let _ = bump(p);\n        let _ = bump(p);\n        if (peek(p) == 10) { let _ = bump(p); () }\n        else if (peek(p) == 13 && peekAt(p, 1) == 10) { let _ = bump(p); let _ = bump(p); () }\n        else ();\n        let out = bufNew();\n        let done = cellNew(false);\n        let errOpt: Cell (Option String) = cellNew(None);\n        while (!cellGet(done) && match cellGet(errOpt) { None -> true, Some(_) -> false }) {\n            let c = peek(p);\n            if (c < 0) {\n                cellSet(errOpt, Some(tomlErr(p, \"unterminated multiline literal string\")))\n            } else if (c == 39 && peekAt(p, 1) == 39 && peekAt(p, 2) == 39) {\n                let _ = bump(p);\n                let _ = bump(p);\n                let _ = bump(p);\n                while (peek(p) == 39 && !(peekAt(p, 1) == 39 && peekAt(p, 2) == 39)) {\n                    let _ = bump(p);\n                    bufPushByte(out, 39)\n                };\n                cellSet(done, true)\n            } else {\n                bufPushByte(out, bump(p))\n            }\n        };\n        match cellGet(errOpt) {\n            Some(e) -> Err(e),\n            None -> Ok(bufToString(out)),\n        }\n    } else {\n        let _ = bump(p);\n        let start = cellGet(p.tpPos);\n        while ({\n            let c = peek(p);\n            c >= 0 && c != 39 && c != 10 && c != 13\n        }) {\n            let _ = bump(p);\n            ()\n        };\n        if (peek(p) != 39) Err(tomlErr(p, \"unterminated literal string\"))\n        else {\n            let end = cellGet(p.tpPos);\n            let _ = bump(p);\n            Ok(ptrSliceFromStr(p.tpSrc, start, end - start))\n        }\n    }\n}\n\ndef parseKeySegment(p: TomlParser): Result String String = {\n    skipInlineWs(p);\n    let c = peek(p);\n    if (c == 34) {\n        if (peekAt(p, 1) == 34 && peekAt(p, 2) == 34) {\n            Err(tomlErr(p, \"multiline strings cannot be used as TOML keys\"))\n        } else parseBasicString(p)\n    } else if (c == 39) {\n        if (peekAt(p, 1) == 39 && peekAt(p, 2) == 39) {\n            Err(tomlErr(p, \"multiline strings cannot be used as TOML keys\"))\n        } else parseLiteralString(p)\n    } else if (isBareKeyByte(c)) {\n        let start = cellGet(p.tpPos);\n        while (isBareKeyByte(peek(p))) {\n            let _ = bump(p);\n            ()\n        };\n        Ok(ptrSliceFromStr(p.tpSrc, start, cellGet(p.tpPos) - start))\n    } else {\n        Err(tomlErr(p, \"expected key identifier or quoted key\"))\n    }\n}\n\ndef parseDottedKey(p: TomlParser): Result (List String) String = {\n    let first = parseKeySegment(p)?;\n    let segs = cellNew([first]);\n    let errOpt: Cell (Option String) = cellNew(None);\n    while ({\n        skipInlineWs(p);\n        peek(p) == 46 && match cellGet(errOpt) { None -> true, Some(_) -> false }\n    }) {\n        let _ = bump(p);\n        match parseKeySegment(p) {\n            Ok(s) -> cellSet(segs, listAppend(cellGet(segs), [s])),\n            Err(e) -> cellSet(errOpt, Some(e)),\n        }\n    };\n    match cellGet(errOpt) {\n        Some(e) -> Err(e),\n        None -> Ok(cellGet(segs)),\n    }\n}\n\ndef stripUnderscores(raw: String): String = {\n    let n = strLen(raw);\n    let b = bufNew();\n    let i = cellNew(0);\n    while (cellGet(i) < n) {\n        let c = strByteAt(raw, cellGet(i));\n        if (c != 95) bufPushByte(b, c) else ();\n        cellSet(i, cellGet(i) + 1)\n    };\n    bufToString(b)\n}\n\ndef parseRadixInt64(digits: String, radix: Int): Result Int64 String = {\n    let n = strLen(digits);\n    if (n == 0) Err(\"empty radix integer\")\n    else {\n        let acc = cellNew(intToI64(0));\n        let rad64 = intToI64(radix);\n        let maxI64 = (intToI64(2147483647) << 32) | ((intToI64(65535) << 16) | intToI64(65535));\n        let maxDiv = maxI64 / rad64;\n        let maxMod = maxI64 % rad64;\n        let i = cellNew(0);\n        let invalid = cellNew(false);\n        let overflow = cellNew(false);\n        while (cellGet(i) < n && !cellGet(invalid)) {\n            let hv = hexVal(strByteAt(digits, cellGet(i)));\n            if (hv < 0 || hv >= radix) cellSet(invalid, true)\n            else {\n                if (!cellGet(overflow)) {\n                    let d64 = intToI64(hv);\n                    let cur = cellGet(acc);\n                    if (cur > maxDiv || (cur == maxDiv && d64 > maxMod)) {\n                        cellSet(overflow, true)\n                    } else {\n                        cellSet(acc, cur * rad64 + d64)\n                    }\n                } else ();\n                cellSet(i, cellGet(i) + 1)\n            }\n        };\n        if (cellGet(invalid)) Err(\"invalid radix integer: \" + digits)\n        else if (cellGet(overflow)) Err(\"integer overflow: \" + digits)\n        else Ok(cellGet(acc))\n    }\n}\n\ndef isScalarStopByte(c: Int): Bool =\n    c < 0 || c == 32 || c == 9 || c == 10 || c == 13 || c == 35 || c == 44 || c == 93 || c == 125\n\ndef parseBareValue(p: TomlParser): Result Value String = {\n    let start = cellGet(p.tpPos);\n    while (!isScalarStopByte(peek(p))) {\n        let _ = bump(p);\n        ()\n    };\n    let raw = ptrSliceFromStr(p.tpSrc, start, cellGet(p.tpPos) - start);\n    if (strLen(raw) == 0) {\n        Err(tomlErr(p, \"expected value\"))\n    } else if (raw == \"true\") {\n        Ok(VBool(true))\n    } else if (raw == \"false\") {\n        Ok(VBool(false))\n    } else {\n        let clean = stripUnderscores(raw);\n        let clen = strLen(clean);\n        if (clen >= 3 && strByteAt(clean, 0) == 48 && (strByteAt(clean, 1) == 120 || strByteAt(clean, 1) == 88)) {\n            match parseRadixInt64(strSlice(clean, 2, clen), 16) {\n                Ok(v) -> Ok(VInt(v)),\n                Err(e) -> Err(tomlErr(p, e)),\n            }\n        } else if (clen >= 3 && strByteAt(clean, 0) == 48 && (strByteAt(clean, 1) == 111 || strByteAt(clean, 1) == 79)) {\n            match parseRadixInt64(strSlice(clean, 2, clen), 8) {\n                Ok(v) -> Ok(VInt(v)),\n                Err(e) -> Err(tomlErr(p, e)),\n            }\n        } else if (clen >= 3 && strByteAt(clean, 0) == 48 && (strByteAt(clean, 1) == 98 || strByteAt(clean, 1) == 66)) {\n            match parseRadixInt64(strSlice(clean, 2, clen), 2) {\n                Ok(v) -> Ok(VInt(v)),\n                Err(e) -> Err(tomlErr(p, e)),\n            }\n        } else if (clean == \"inf\" || clean == \"+inf\") {\n            Ok(VFloat(1.0 / 0.0))\n        } else if (clean == \"-inf\") {\n            Ok(VFloat(-1.0 / 0.0))\n        } else if (clean == \"nan\" || clean == \"+nan\" || clean == \"-nan\") {\n            Ok(VFloat(0.0 / 0.0))\n        } else {\n            let hasFloatMarker = {\n                let i = cellNew(0);\n                let found = cellNew(false);\n                while (cellGet(i) < clen && !cellGet(found)) {\n                    let b = strByteAt(clean, cellGet(i));\n                    if (b == 46 || b == 101 || b == 69) cellSet(found, true) else ();\n                    cellSet(i, cellGet(i) + 1)\n                };\n                cellGet(found)\n            };\n            let hasDateDashOrColon = {\n                let i = cellNew(1);\n                let found = cellNew(false);\n                while (cellGet(i) < clen && !cellGet(found)) {\n                    let b = strByteAt(clean, cellGet(i));\n                    if (b == 58 || (b == 45 && strByteAt(clean, cellGet(i) - 1) != 101 && strByteAt(clean, cellGet(i) - 1) != 69)) {\n                        cellSet(found, true)\n                    } else ();\n                    cellSet(i, cellGet(i) + 1)\n                };\n                cellGet(found)\n            };\n            if (hasDateDashOrColon) {\n                Ok(VStr(raw))\n            } else if (hasFloatMarker) {\n                match parseFloat(clean) {\n                    Ok(f) -> Ok(VFloat(f)),\n                    Err(_) -> Err(tomlErr(p, \"invalid float value '\" + raw + \"'\")),\n                }\n            } else {\n                match parseInt64(clean) {\n                    Ok(n) -> Ok(VInt(n)),\n                    Err(_) -> Err(tomlErr(p, \"invalid value '\" + raw + \"'\")),\n                }\n            }\n        }\n    }\n}\n\n// ---- Functional Value Tree Insertion Helpers ----\n\ndef objGet(fields: List (String, Value), key: String): Option Value = match fields {\n    Nil -> None,\n    Cons((k, v), r) -> if (k == key) Some(v) else objGet(r, key),\n}\n\ndef objSet(fields: List (String, Value), key: String, val: Value): List (String, Value) = match fields {\n    Nil -> [(key, val)],\n    Cons((k, v), r) ->\n        if (k == key) Cons((key, val), r)\n        else Cons((k, v), objSet(r, key, val)),\n}\n\ndef replaceLastValue(xs: List Value, newLast: Value): List Value = match xs {\n    Nil -> [newLast],\n    Cons(_, Nil) -> [newLast],\n    Cons(h, t) -> Cons(h, replaceLastValue(t, newLast)),\n}\n\ndef lastObjFields(xs: List Value): Option (List (String, Value)) = match xs {\n    Nil -> None,\n    Cons(VObj(fs), Nil) -> Some(fs),\n    Cons(_, Nil) -> None,\n    Cons(_, t) -> lastObjFields(t),\n}\n\ndef insertAtPath(\n    fields: List (String, Value),\n    path: List String,\n    leafVal: Value\n): Result (List (String, Value)) String = match path {\n    Nil -> Err(\"empty key path\"),\n    Cons(k, Nil) -> match objGet(fields, k) {\n        Some(_) -> Err(\"duplicate key '\" + k + \"'\"),\n        None -> Ok(objSet(fields, k, leafVal)),\n    },\n    Cons(k, rest) -> match objGet(fields, k) {\n        None -> {\n            let sub = insertAtPath(Nil, rest, leafVal)?;\n            Ok(objSet(fields, k, VObj(sub)))\n        },\n        Some(VObj(subFields)) -> {\n            let sub = insertAtPath(subFields, rest, leafVal)?;\n            Ok(objSet(fields, k, VObj(sub)))\n        },\n        Some(VArr(items)) -> match lastObjFields(items) {\n            Some(lastFs) -> {\n                let updatedLast = insertAtPath(lastFs, rest, leafVal)?;\n                Ok(objSet(fields, k, VArr(replaceLastValue(items, VObj(updatedLast)))))\n            },\n            None -> Err(\"key '\" + k + \"' conflicts with existing array\"),\n        },\n        Some(_) -> Err(\"key '\" + k + \"' conflicts with existing scalar value\"),\n    },\n}\n\ndef ensureTablePath(\n    fields: List (String, Value),\n    path: List String\n): Result (List (String, Value)) String = match path {\n    Nil -> Ok(fields),\n    Cons(k, rest) -> match objGet(fields, k) {\n        None -> {\n            let sub = ensureTablePath(Nil, rest)?;\n            Ok(objSet(fields, k, VObj(sub)))\n        },\n        Some(VObj(subFields)) -> {\n            let sub = ensureTablePath(subFields, rest)?;\n            Ok(objSet(fields, k, VObj(sub)))\n        },\n        Some(VArr(items)) -> match rest {\n            Nil -> Err(\"table '[\" + k + \"]' conflicts with array of tables\"),\n            _ -> match lastObjFields(items) {\n                Some(lastFs) -> {\n                    let sub = ensureTablePath(lastFs, rest)?;\n                    Ok(objSet(fields, k, VArr(replaceLastValue(items, VObj(sub)))))\n                },\n                None -> Err(\"key '\" + k + \"' is an array, not a table\"),\n            },\n        },\n        Some(_) -> Err(\"table key '\" + k + \"' conflicts with existing scalar\"),\n    },\n}\n\ndef appendArrayTablePath(\n    fields: List (String, Value),\n    path: List String\n): Result (List (String, Value)) String = match path {\n    Nil -> Err(\"empty array-of-tables header\"),\n    Cons(k, Nil) -> match objGet(fields, k) {\n        None -> Ok(objSet(fields, k, VArr([VObj(Nil)]))),\n        Some(VArr(items)) -> Ok(objSet(fields, k, VArr(listAppend(items, [VObj(Nil)])))),\n        Some(_) -> Err(\"array-of-tables '[[\" + k + \"]]' conflicts with existing non-array key\"),\n    },\n    Cons(k, rest) -> match objGet(fields, k) {\n        None -> {\n            let sub = appendArrayTablePath(Nil, rest)?;\n            Ok(objSet(fields, k, VObj(sub)))\n        },\n        Some(VObj(subFields)) -> {\n            let sub = appendArrayTablePath(subFields, rest)?;\n            Ok(objSet(fields, k, VObj(sub)))\n        },\n        Some(VArr(items)) -> match lastObjFields(items) {\n            Some(lastFs) -> {\n                let sub = appendArrayTablePath(lastFs, rest)?;\n                Ok(objSet(fields, k, VArr(replaceLastValue(items, VObj(sub)))))\n            },\n            None -> Err(\"key '\" + k + \"' conflicts with non-table array\"),\n        },\n        Some(_) -> Err(\"key '\" + k + \"' conflicts with existing scalar\"),\n    },\n}\n\ndef parseTomlValue(p: TomlParser): Result Value String = {\n    skipInlineWs(p);\n    let c = peek(p);\n    if (c == 34) {\n        Ok(VStr(parseBasicString(p)?))\n    } else if (c == 39) {\n        Ok(VStr(parseLiteralString(p)?))\n    } else if (c == 91) {\n        let _ = bump(p);\n        let elems = cellNew(Nil);\n        let done = cellNew(false);\n        let errOpt: Cell (Option String) = cellNew(None);\n        while (!cellGet(done) && match cellGet(errOpt) { None -> true, Some(_) -> false }) {\n            skipWsAndComments(p);\n            if (peek(p) == 93) {\n                let _ = bump(p);\n                cellSet(done, true)\n            } else {\n                match parseTomlValue(p) {\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                    Ok(v) -> {\n                        cellSet(elems, Cons(v, cellGet(elems)));\n                        skipWsAndComments(p);\n                        if (peek(p) == 44) {\n                            let _ = bump(p);\n                            ()\n                        } else if (peek(p) == 93) {\n                            let _ = bump(p);\n                            cellSet(done, true)\n                        } else {\n                            cellSet(errOpt, Some(tomlErr(p, \"expected ',' or ']' in array\")))\n                        }\n                    },\n                }\n            }\n        };\n        match cellGet(errOpt) {\n            Some(e) -> Err(e),\n            None -> Ok(VArr(listRev(cellGet(elems)))),\n        }\n    } else if (c == 123) {\n        let _ = bump(p);\n        let fields = cellNew(Nil);\n        let done = cellNew(false);\n        let errOpt: Cell (Option String) = cellNew(None);\n        while (!cellGet(done) && match cellGet(errOpt) { None -> true, Some(_) -> false }) {\n            skipWsAndComments(p);\n            if (peek(p) == 125) {\n                let _ = bump(p);\n                cellSet(done, true)\n            } else {\n                match parseDottedKey(p) {\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                    Ok(kpath) -> {\n                        skipInlineWs(p);\n                        if (peek(p) != 61) {\n                            cellSet(errOpt, Some(tomlErr(p, \"expected '=' in inline table\")))\n                        } else {\n                            let _ = bump(p);\n                            match parseTomlValue(p) {\n                                Err(e2) -> cellSet(errOpt, Some(e2)),\n                                Ok(val) -> match insertAtPath(cellGet(fields), kpath, val) {\n                                    Err(ie) -> cellSet(errOpt, Some(tomlErr(p, ie))),\n                                    Ok(nf) -> {\n                                        cellSet(fields, nf);\n                                        skipWsAndComments(p);\n                                        if (peek(p) == 44) {\n                                            let _ = bump(p);\n                                            ()\n                                        } else if (peek(p) == 125) {\n                                            let _ = bump(p);\n                                            cellSet(done, true)\n                                        } else {\n                                            cellSet(errOpt, Some(tomlErr(p, \"expected ',' or '}' in inline table\")))\n                                        }\n                                    },\n                                },\n                            }\n                        }\n                    },\n                }\n            }\n        };\n        match cellGet(errOpt) {\n            Some(e) -> Err(e),\n            None -> Ok(VObj(cellGet(fields))),\n        }\n    } else {\n        parseBareValue(p)\n    }\n}\n\n/// Parse a TOML v1.0 document string into a `std.codec.Value` (`VObj`).\npub def parse(raw: String): Result Value String = {\n    let p = newTomlParser(raw);\n    if (p.tpLen >= 3 && strByteAt(raw, 0) == 239 && strByteAt(raw, 1) == 187 && strByteAt(raw, 2) == 191) {\n        cellSet(p.tpPos, 3)\n    } else ();\n\n    let rootFields: Cell (List (String, Value)) = cellNew(Nil);\n    let curPrefix: Cell (List String) = cellNew(Nil);\n    let errOpt: Cell (Option String) = cellNew(None);\n\n    while ({\n        skipWsAndComments(p);\n        peek(p) >= 0 && match cellGet(errOpt) { None -> true, Some(_) -> false }\n    }) {\n        if (peek(p) == 91) {\n            if (peekAt(p, 1) == 91) {\n                let _ = bump(p);\n                let _ = bump(p);\n                match parseDottedKey(p) {\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                    Ok(hdr) -> {\n                        skipInlineWs(p);\n                        if (peek(p) == 93 && peekAt(p, 1) == 93) {\n                            let _ = bump(p);\n                            let _ = bump(p);\n                            match expectLineEndOrEof(p) {\n                                Err(le) -> cellSet(errOpt, Some(le)),\n                                Ok(_) -> match appendArrayTablePath(cellGet(rootFields), hdr) {\n                                    Err(ae) -> cellSet(errOpt, Some(tomlErr(p, ae))),\n                                    Ok(nf) -> {\n                                        cellSet(rootFields, nf);\n                                        cellSet(curPrefix, hdr)\n                                    },\n                                },\n                            }\n                        } else {\n                            cellSet(errOpt, Some(tomlErr(p, \"expected ']]' after array-of-tables header\")))\n                        }\n                    },\n                }\n            } else {\n                let _ = bump(p);\n                match parseDottedKey(p) {\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                    Ok(hdr) -> {\n                        skipInlineWs(p);\n                        if (peek(p) == 93) {\n                            let _ = bump(p);\n                            match expectLineEndOrEof(p) {\n                                Err(le) -> cellSet(errOpt, Some(le)),\n                                Ok(_) -> match ensureTablePath(cellGet(rootFields), hdr) {\n                                    Err(te) -> cellSet(errOpt, Some(tomlErr(p, te))),\n                                    Ok(nf) -> {\n                                        cellSet(rootFields, nf);\n                                        cellSet(curPrefix, hdr)\n                                    },\n                                },\n                            }\n                        } else {\n                            cellSet(errOpt, Some(tomlErr(p, \"expected ']' after table header\")))\n                        }\n                    },\n                }\n            }\n        } else {\n            match parseDottedKey(p) {\n                Err(e) -> cellSet(errOpt, Some(e)),\n                Ok(relKey) -> {\n                    skipInlineWs(p);\n                    if (peek(p) != 61) {\n                        cellSet(errOpt, Some(tomlErr(p, \"expected '=' after key\")))\n                    } else {\n                        let _ = bump(p);\n                        match parseTomlValue(p) {\n                            Err(ve) -> cellSet(errOpt, Some(ve)),\n                            Ok(val) -> match expectLineEndOrEof(p) {\n                                Err(le) -> cellSet(errOpt, Some(le)),\n                                Ok(_) -> {\n                                    let fullPath = listAppend(cellGet(curPrefix), relKey);\n                                    match insertAtPath(cellGet(rootFields), fullPath, val) {\n                                        Err(ie) -> cellSet(errOpt, Some(tomlErr(p, ie))),\n                                        Ok(nf) -> cellSet(rootFields, nf),\n                                    }\n                                },\n                            },\n                        }\n                    }\n                },\n            }\n        }\n    };\n\n    match cellGet(errOpt) {\n        Some(e) -> Err(e),\n        None -> Ok(VObj(cellGet(rootFields))),\n    }\n}\n\n/// Parse `raw` as TOML and run typed `std.codec.Decoder` `dec` on the resulting value.\npub def decodeString(dec: Decoder a, raw: String): Result a DecodeErr =\n    match parse(raw) {\n        Err(msg) -> Err(makeErr(\"$\", msg)),\n        Ok(v) -> run(dec, v),\n    }\n\n// ---- Canonical TOML Serializer ----\n\ndef isValidBareKey(k: String): Bool = {\n    let n = strLen(k);\n    if (n == 0) false\n    else {\n        let i = cellNew(0);\n        let ok = cellNew(true);\n        while (cellGet(i) < n && cellGet(ok)) {\n            if (!isBareKeyByte(strByteAt(k, cellGet(i)))) cellSet(ok, false) else ();\n            cellSet(i, cellGet(i) + 1)\n        };\n        cellGet(ok)\n    }\n}\n\ndef hexUpperByte(nib: Int): Int =\n    if (nib < 10) 48 + nib else 55 + nib\n\ndef emitTomlString(b: StringBuf, s: String): Void = {\n    bufPushByte(b, 34);\n    let n = strLen(s);\n    let i = cellNew(0);\n    while (cellGet(i) < n) {\n        let idx = cellGet(i);\n        let c = strByteAt(s, idx);\n        if (c == 34) bufPushStr(b, \"\\\\\\\"\")\n        else if (c == 92) bufPushStr(b, \"\\\\\\\\\")\n        else if (c == 8) bufPushStr(b, \"\\\\b\")\n        else if (c == 12) bufPushStr(b, \"\\\\f\")\n        else if (c == 10) bufPushStr(b, \"\\\\n\")\n        else if (c == 13) bufPushStr(b, \"\\\\r\")\n        else if (c == 9) bufPushStr(b, \"\\\\t\")\n        else if (c < 32) {\n            bufPushStr(b, \"\\\\u00\");\n            bufPushByte(b, hexUpperByte((c >>> 4) & 15));\n            bufPushByte(b, hexUpperByte(c & 15))\n        } else {\n            bufPushByte(b, c)\n        };\n        cellSet(i, idx + 1)\n    };\n    bufPushByte(b, 34)\n}\n\ndef formatTomlKey(k: String): String =\n    if (isValidBareKey(k)) k\n    else {\n        let b = bufNew();\n        emitTomlString(b, k);\n        bufToString(b)\n    }\n\ndef formatKeyPath(path: List String): String = {\n    let parts = cellNew(Nil);\n    let cur = cellNew(path);\n    while (match cellGet(cur) { Nil -> false, _ -> true }) {\n        match cellGet(cur) {\n            Cons(h, t) -> {\n                cellSet(parts, listAppend(cellGet(parts), [formatTomlKey(h)]));\n                cellSet(cur, t)\n            },\n            Nil -> (),\n        }\n    };\n    strJoin(cellGet(parts), \".\")\n}\n\ndef isArrayOfNonEmptyObjs(xs: List Value): Bool = match xs {\n    Nil -> false,\n    _ -> {\n        let cur = cellNew(xs);\n        let allObj = cellNew(true);\n        while (match cellGet(cur) { Nil -> false, _ -> cellGet(allObj) }) {\n            match cellGet(cur) {\n                Cons(VObj(_), r) -> cellSet(cur, r),\n                _ -> cellSet(allObj, false),\n            }\n        };\n        cellGet(allObj)\n    },\n}\n\ndef emitInlineValue(b: StringBuf, v: Value): Void = match v {\n    VNull -> bufPushStr(b, \"\\\"\\\"\"),\n    VBool(true) -> bufPushStr(b, \"true\"),\n    VBool(false) -> bufPushStr(b, \"false\"),\n    VInt(n) -> bufPushStr(b, i64ToStr(n)),\n    VFloat(f) -> {\n        let bits = floatToBits64(f);\n        let expMask = (intToI64(2047)) << 52;\n        let fracMask = (intToI64(1) << 52) - intToI64(1);\n        if ((bits & expMask) == expMask && (bits & fracMask) != intToI64(0)) {\n            bufPushStr(b, \"nan\")\n        } else {\n            bufPushStr(b, floatToStr(f))\n        }\n    },\n    VStr(s) -> emitTomlString(b, s),\n    VArr(xs) -> {\n        bufPushByte(b, 91);\n        let cur = cellNew(xs);\n        let first = cellNew(true);\n        while (match cellGet(cur) { Nil -> false, _ -> true }) {\n            match cellGet(cur) {\n                Cons(h, t) -> {\n                    if (!cellGet(first)) bufPushStr(b, \", \") else cellSet(first, false);\n                    emitInlineValue(b, h);\n                    cellSet(cur, t)\n                },\n                Nil -> (),\n            }\n        };\n        bufPushByte(b, 93)\n    },\n    VObj(fs) -> {\n        bufPushStr(b, \"{ \");\n        let cur = cellNew(fs);\n        let first = cellNew(true);\n        while (match cellGet(cur) { Nil -> false, _ -> true }) {\n            match cellGet(cur) {\n                Cons((k, val), t) -> {\n                    match val {\n                        VNull -> (),\n                        _ -> {\n                            if (!cellGet(first)) bufPushStr(b, \", \") else cellSet(first, false);\n                            bufPushStr(b, formatTomlKey(k));\n                            bufPushStr(b, \" = \");\n                            emitInlineValue(b, val)\n                        },\n                    };\n                    cellSet(cur, t)\n                },\n                Nil -> (),\n            }\n        };\n        bufPushStr(b, \" }\")\n    },\n}\n\ndef isInlineLeaf(v: Value): Bool = match v {\n    VNull -> false,\n    VObj(_) -> false,\n    VArr(xs) -> !isArrayOfNonEmptyObjs(xs),\n    _ -> true,\n}\n\ndef objHasNestedTables(fs: List (String, Value)): Bool = match fs {\n    Nil -> false,\n    Cons((_, VObj(_)), _) -> true,\n    Cons((_, VArr(xs)), r) -> if (isArrayOfNonEmptyObjs(xs)) true else objHasNestedTables(r),\n    Cons(_, r) -> objHasNestedTables(r),\n}\n\ndef isCompactInlineTableParent(prefix: List String): Bool = match listRev(prefix) {\n    Cons(lastSeg, _) -> lastSeg == \"deps\" || lastSeg == \"overrides\",\n    Nil -> false,\n}\n\ndef isInlineInTable(prefix: List String, v: Value): Bool = match v {\n    VNull -> false,\n    VObj(subFs) -> isCompactInlineTableParent(prefix) && !objHasNestedTables(subFs),\n    VArr(xs) -> !isArrayOfNonEmptyObjs(xs),\n    _ -> true,\n}\n\ndef emitTableBody(b: StringBuf, prefix: List String, fields: List (String, Value), needBlank: Cell Bool): Void = {\n    let hasInline = {\n        let c = cellNew(fields);\n        let found = cellNew(false);\n        while (match cellGet(c) { Nil -> false, _ -> !cellGet(found) }) {\n            match cellGet(c) {\n                Cons((_, val), r) -> {\n                    if (isInlineInTable(prefix, val)) cellSet(found, true) else ();\n                    cellSet(c, r)\n                },\n                Nil -> (),\n            }\n        };\n        cellGet(found)\n    };\n\n    let isEmptyTable = match fields { Nil -> true, _ -> false };\n    if (listLen(prefix) > 0 && (hasInline || isEmptyTable)) {\n        if (cellGet(needBlank)) bufPushByte(b, 10) else ();\n        bufPushByte(b, 91);\n        bufPushStr(b, formatKeyPath(prefix));\n        bufPushStr(b, \"]\\n\");\n        cellSet(needBlank, true)\n    } else ();\n\n    let c1 = cellNew(fields);\n    while (match cellGet(c1) { Nil -> false, _ -> true }) {\n        match cellGet(c1) {\n            Cons((k, val), r) -> {\n                if (isInlineInTable(prefix, val)) {\n                    bufPushStr(b, formatTomlKey(k));\n                    bufPushStr(b, \" = \");\n                    emitInlineValue(b, val);\n                    bufPushByte(b, 10);\n                    cellSet(needBlank, true)\n                } else ();\n                cellSet(c1, r)\n            },\n            Nil -> (),\n        }\n    };\n\n    let c2 = cellNew(fields);\n    while (match cellGet(c2) { Nil -> false, _ -> true }) {\n        match cellGet(c2) {\n            Cons((k, VObj(subFs)), r) -> {\n                if (!isInlineInTable(prefix, VObj(subFs))) {\n                    emitTableBody(b, listAppend(prefix, [k]), subFs, needBlank)\n                } else ();\n                cellSet(c2, r)\n            },\n            Cons((k, VArr(xs)), r) -> {\n                if (isArrayOfNonEmptyObjs(xs)) {\n                    let hdrPath = listAppend(prefix, [k]);\n                    let ci = cellNew(xs);\n                    while (match cellGet(ci) { Nil -> false, _ -> true }) {\n                        match cellGet(ci) {\n                            Cons(VObj(itemFs), ri) -> {\n                                if (cellGet(needBlank)) bufPushByte(b, 10) else ();\n                                bufPushStr(b, \"[[\");\n                                bufPushStr(b, formatKeyPath(hdrPath));\n                                bufPushStr(b, \"]]\\n\");\n                                cellSet(needBlank, true);\n                                let cf = cellNew(itemFs);\n                                while (match cellGet(cf) { Nil -> false, _ -> true }) {\n                                    match cellGet(cf) {\n                                        Cons((ik, iv), rf) -> {\n                                            match iv {\n                                                VNull -> (),\n                                                _ -> {\n                                                    bufPushStr(b, formatTomlKey(ik));\n                                                    bufPushStr(b, \" = \");\n                                                    emitInlineValue(b, iv);\n                                                    bufPushByte(b, 10)\n                                                },\n                                            };\n                                            cellSet(cf, rf)\n                                        },\n                                        Nil -> (),\n                                    }\n                                };\n                                cellSet(ci, ri)\n                            },\n                            Cons(_, ri) -> cellSet(ci, ri),\n                            Nil -> (),\n                        }\n                    }\n                } else ();\n                cellSet(c2, r)\n            },\n            Cons(_, r) -> cellSet(c2, r),\n            Nil -> (),\n        }\n    }\n}\n\n/// Serialize a `std.codec.Value` into canonical TOML text.\npub def stringify(v: Value): String = {\n    let b = bufNew();\n    match v {\n        VObj(fs) -> emitTableBody(b, Nil, fs, cellNew(false)),\n        _ -> {\n            emitInlineValue(b, v);\n            bufPushByte(b, 10)\n        },\n    };\n    bufToString(b)\n}\n\n/// Encode `x` via `Encode` and serialize it to canonical TOML text.\npub def toToml(x): forall a. (Encode a) => a -> String =\n    stringify(encode(x))\n\n// ---- Span-Based Comment-Preserving Patcher (`patch`) ----\n\ndata SecKind {\n    SecRoot,\n    SecTable(List String),\n    SecArrTable(List String, Int),\n}\n\ndata KvSpan {\n    MkKvSpan {\n        relKey: List String,\n        oldVal: Value,\n        lineStart: Int,\n        valStart: Int,\n        valEnd: Int,\n        lineEnd: Int,\n    },\n}\n\ndata TomlSec {\n    MkTomlSec {\n        kind: SecKind,\n        secStart: Int,\n        bodyStart: Int,\n        secEnd: Int,\n        kvs: List KvSpan,\n    },\n}\n\ndef pathEq(a: List String, b: List String): Bool = match (a, b) {\n    (Nil, Nil) -> true,\n    (Cons(ha, ta), Cons(hb, tb)) -> ha == hb && pathEq(ta, tb),\n    _ -> false,\n}\n\ndef pathHasPrefix(path: List String, prefix: List String): Bool = match prefix {\n    Nil -> true,\n    Cons(hp, tp) -> match path {\n        Cons(h, t) -> h == hp && pathHasPrefix(t, tp),\n        Nil -> false,\n    },\n}\n\ndef cleanValueOpt(v: Value): Option Value = match v {\n    VNull -> None,\n    VObj(fs) -> Some(VObj(cleanObjFields(fs))),\n    VArr(xs) -> {\n        let out = cellNew(Nil);\n        let cur = cellNew(xs);\n        while (match cellGet(cur) { Nil -> false, _ -> true }) {\n            match cellGet(cur) {\n                Cons(h, r) -> {\n                    match cleanValueOpt(h) {\n                        Some(ch) -> cellSet(out, Cons(ch, cellGet(out))),\n                        None -> (),\n                    };\n                    cellSet(cur, r)\n                },\n                Nil -> (),\n            }\n        };\n        Some(VArr(listRev(cellGet(out))))\n    },\n    other -> Some(other),\n}\n\ndef cleanObjFields(fs: List (String, Value)): List (String, Value) = {\n    let out = cellNew(Nil);\n    let cur = cellNew(fs);\n    while (match cellGet(cur) { Nil -> false, _ -> true }) {\n        match cellGet(cur) {\n            Cons((k, v), r) -> {\n                match cleanValueOpt(v) {\n                    Some(cv) -> cellSet(out, Cons((k, cv), cellGet(out))),\n                    None -> (),\n                };\n                cellSet(cur, r)\n            },\n            Nil -> (),\n        }\n    };\n    listRev(cellGet(out))\n}\n\ndef tomlValEq(a: Value, b: Value): Bool = match (a, b) {\n    (VNull, VNull) -> true,\n    (VBool(x), VBool(y)) -> x == y,\n    (VInt(x), VInt(y)) -> x == y,\n    (VFloat(x), VFloat(y)) -> floatToBits64(x) == floatToBits64(y),\n    (VStr(x), VStr(y)) -> x == y,\n    (VArr(xs), VArr(ys)) -> tomlListEq(xs, ys),\n    (VObj(fa), VObj(fb)) -> {\n        let ca = cleanObjFields(fa);\n        let cb = cleanObjFields(fb);\n        listLen(ca) == listLen(cb) && tomlFieldsSubset(ca, cb)\n    },\n    _ -> false,\n}\n\ndef tomlListEq(xs: List Value, ys: List Value): Bool = match (xs, ys) {\n    (Nil, Nil) -> true,\n    (Cons(hx, tx), Cons(hy, ty)) -> tomlValEq(hx, hy) && tomlListEq(tx, ty),\n    _ -> false,\n}\n\ndef tomlFieldsSubset(fa: List (String, Value), fb: List (String, Value)): Bool = match fa {\n    Nil -> true,\n    Cons((k, va), r) -> match objGet(fb, k) {\n        Some(vb) -> tomlValEq(va, vb) && tomlFieldsSubset(r, fb),\n        None -> false,\n    },\n}\n\ndef lookupAtPath(fs: List (String, Value), path: List String): Option Value = match path {\n    Nil -> Some(VObj(fs)),\n    Cons(k, Nil) -> objGet(fs, k),\n    Cons(k, rest) -> match objGet(fs, k) {\n        Some(VObj(sub)) -> lookupAtPath(sub, rest),\n        _ -> None,\n    },\n}\n\ndef objDeleteKey(fs: List (String, Value), key: String): List (String, Value) = match fs {\n    Nil -> Nil,\n    Cons((k, v), r) ->\n        if (k == key) objDeleteKey(r, key)\n        else Cons((k, v), objDeleteKey(r, key)),\n}\n\ndef deleteAtPath(fs: List (String, Value), path: List String): List (String, Value) = match path {\n    Nil -> Nil,\n    Cons(k, Nil) -> objDeleteKey(fs, k),\n    Cons(k, rest) -> match objGet(fs, k) {\n        Some(VObj(sub)) -> {\n            let sub2 = deleteAtPath(sub, rest);\n            match sub2 {\n                Nil -> objDeleteKey(fs, k),\n                _ -> objSet(fs, k, VObj(sub2)),\n            }\n        },\n        _ -> fs,\n    },\n}\n\ndef nthValue(xs: List Value, idx: Int): Option Value = match xs {\n    Nil -> None,\n    Cons(h, t) -> if (idx <= 0) Some(h) else nthValue(t, idx - 1),\n}\n\ndef isArrayOfAnyObjs(xs: List Value): Bool = match xs {\n    Nil -> false,\n    _ -> {\n        let cur = cellNew(xs);\n        let ok = cellNew(true);\n        while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {\n            match cellGet(cur) {\n                Cons(VObj(_), r) -> cellSet(cur, r),\n                _ -> cellSet(ok, false),\n            }\n        };\n        cellGet(ok)\n    },\n}\n\ndef findLineStart(raw: String, pos: Int): Int = {\n    let i = cellNew(pos);\n    while (cellGet(i) > 0 && isHorizWs(strByteAt(raw, cellGet(i) - 1))) {\n        cellSet(i, cellGet(i) - 1)\n    };\n    cellGet(i)\n}\n\ndef bumpArrCount(counts: List (List String, Int), hdr: List String): (Int, List (List String, Int)) = match counts {\n    Nil -> (0, [(hdr, 1)]),\n    Cons((p, c), r) ->\n        if (pathEq(p, hdr)) (c, Cons((p, c + 1), r))\n        else {\n            let (idx, r2) = bumpArrCount(r, hdr);\n            (idx, Cons((p, c), r2))\n        },\n}\n\ndef lookupArrCount(counts: List (List String, Int), hdr: List String): Int = match counts {\n    Nil -> 0,\n    Cons((p, c), r) -> if (pathEq(p, hdr)) c else lookupArrCount(r, hdr),\n}\n\ndef scanTomlSections(raw: String): Result (List TomlSec, List (List String, Int)) String = {\n    let p = newTomlParser(raw);\n    if (p.tpLen >= 3 && strByteAt(raw, 0) == 239 && strByteAt(raw, 1) == 187 && strByteAt(raw, 2) == 191) {\n        cellSet(p.tpPos, 3)\n    } else ();\n\n    let secsRev: Cell (List TomlSec) = cellNew(Nil);\n    let curKind: Cell SecKind = cellNew(SecRoot);\n    let curSecStart = cellNew(0);\n    let curBodyStart = cellNew(cellGet(p.tpPos));\n    let curKvs: Cell (List KvSpan) = cellNew(Nil);\n    let arrCounts: Cell (List (List String, Int)) = cellNew(Nil);\n    let errOpt: Cell (Option String) = cellNew(None);\n\n    while ({\n        skipWsAndComments(p);\n        peek(p) >= 0 && match cellGet(errOpt) { None -> true, Some(_) -> false }\n    }) {\n        let tokPos = cellGet(p.tpPos);\n        let lStart = findLineStart(raw, tokPos);\n        if (peek(p) == 91) {\n            cellSet(secsRev, Cons(MkTomlSec {\n                kind: cellGet(curKind),\n                secStart: cellGet(curSecStart),\n                bodyStart: cellGet(curBodyStart),\n                secEnd: lStart,\n                kvs: listRev(cellGet(curKvs)),\n            }, cellGet(secsRev)));\n            cellSet(curKvs, Nil);\n\n            if (peekAt(p, 1) == 91) {\n                let _ = bump(p);\n                let _ = bump(p);\n                match parseDottedKey(p) {\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                    Ok(hdr) -> {\n                        skipInlineWs(p);\n                        if (peek(p) == 93 && peekAt(p, 1) == 93) {\n                            let _ = bump(p);\n                            let _ = bump(p);\n                            match expectLineEndOrEof(p) {\n                                Err(le) -> cellSet(errOpt, Some(le)),\n                                Ok(_) -> {\n                                    let (idx, nc) = bumpArrCount(cellGet(arrCounts), hdr);\n                                    cellSet(arrCounts, nc);\n                                    cellSet(curKind, SecArrTable(hdr, idx));\n                                    cellSet(curSecStart, lStart);\n                                    cellSet(curBodyStart, cellGet(p.tpPos))\n                                },\n                            }\n                        } else {\n                            cellSet(errOpt, Some(tomlErr(p, \"expected ']]'\")))\n                        }\n                    },\n                }\n            } else {\n                let _ = bump(p);\n                match parseDottedKey(p) {\n                    Err(e) -> cellSet(errOpt, Some(e)),\n                    Ok(hdr) -> {\n                        skipInlineWs(p);\n                        if (peek(p) == 93) {\n                            let _ = bump(p);\n                            match expectLineEndOrEof(p) {\n                                Err(le) -> cellSet(errOpt, Some(le)),\n                                Ok(_) -> {\n                                    cellSet(curKind, SecTable(hdr));\n                                    cellSet(curSecStart, lStart);\n                                    cellSet(curBodyStart, cellGet(p.tpPos))\n                                },\n                            }\n                        } else {\n                            cellSet(errOpt, Some(tomlErr(p, \"expected ']'\")))\n                        }\n                    },\n                }\n            }\n        } else {\n            match parseDottedKey(p) {\n                Err(e) -> cellSet(errOpt, Some(e)),\n                Ok(relKey) -> {\n                    skipInlineWs(p);\n                    if (peek(p) != 61) {\n                        cellSet(errOpt, Some(tomlErr(p, \"expected '='\")))\n                    } else {\n                        let _ = bump(p);\n                        skipInlineWs(p);\n                        let vStart = cellGet(p.tpPos);\n                        match parseTomlValue(p) {\n                            Err(ve) -> cellSet(errOpt, Some(ve)),\n                            Ok(oldV) -> {\n                                let vEnd = cellGet(p.tpPos);\n                                match expectLineEndOrEof(p) {\n                                    Err(le) -> cellSet(errOpt, Some(le)),\n                                    Ok(_) -> {\n                                        let lEnd = cellGet(p.tpPos);\n                                        cellSet(curKvs, Cons(MkKvSpan {\n                                            relKey: relKey,\n                                            oldVal: oldV,\n                                            lineStart: lStart,\n                                            valStart: vStart,\n                                            valEnd: vEnd,\n                                            lineEnd: lEnd,\n                                        }, cellGet(curKvs)))\n                                    },\n                                }\n                            },\n                        }\n                    }\n                },\n            }\n        }\n    };\n\n    match cellGet(errOpt) {\n        Some(e) -> Err(e),\n        None -> {\n            let finalSecs = listRev(Cons(MkTomlSec {\n                kind: cellGet(curKind),\n                secStart: cellGet(curSecStart),\n                bodyStart: cellGet(curBodyStart),\n                secEnd: p.tpLen,\n                kvs: listRev(cellGet(curKvs)),\n            }, cellGet(secsRev)));\n            Ok((finalSecs, cellGet(arrCounts)))\n        },\n    }\n}\n\ndef rawMentionsPrefix(secs: List TomlSec, targetPrefix: List String): Bool = match secs {\n    Nil -> false,\n    Cons(s, rest) -> {\n        let hit = match s.kind {\n            SecRoot -> kvsMentionPrefix(Nil, s.kvs, targetPrefix),\n            SecTable(tp) ->\n                pathHasPrefix(tp, targetPrefix) || kvsMentionPrefix(tp, s.kvs, targetPrefix),\n            SecArrTable(ap, _) ->\n                pathHasPrefix(ap, targetPrefix),\n        };\n        if (hit) true else rawMentionsPrefix(rest, targetPrefix)\n    },\n}\n\ndef kvsMentionPrefix(secPrefix: List String, kvs: List KvSpan, targetPrefix: List String): Bool = match kvs {\n    Nil -> false,\n    Cons(kv, r) -> {\n        let fp = listAppend(secPrefix, kv.relKey);\n        if (pathHasPrefix(fp, targetPrefix)) true\n        else kvsMentionPrefix(secPrefix, r, targetPrefix)\n    },\n}\n\ndef secHasInlineObjKv(kvs: List KvSpan): Bool = match kvs {\n    Nil -> false,\n    Cons(kv, r) -> match kv.oldVal {\n        VObj(_) -> true,\n        _ -> secHasInlineObjKv(r),\n    },\n}\n\ndef canPatchValueInline(oldVal: Value, newVal: Value): Bool = match newVal {\n    VNull -> false,\n    VObj(subFs) -> match oldVal {\n        VObj(_) -> !objHasNestedTables(subFs),\n        _ -> false,\n    },\n    VArr(xs) -> !isArrayOfNonEmptyObjs(xs),\n    _ -> true,\n}\n\ndef ensureEndsWithNewline(b: StringBuf, lastEmittedNl: Cell Bool): Void =\n    if (!cellGet(lastEmittedNl)) {\n        bufPushByte(b, 10);\n        cellSet(lastEmittedNl, true)\n    } else ()\n\ndef pushRawSlice(b: StringBuf, raw: String, start: Int, end: Int, lastEmittedNl: Cell Bool): Void =\n    if (end > start) {\n        bufPushStr(b, ptrSliceFromStr(raw, start, end - start));\n        cellSet(lastEmittedNl, strByteAt(raw, end - 1) == 10)\n    } else ()\n\ndef emitArrTableBlock(b: StringBuf, hdrPath: List String, itemFs: List (String, Value), lastEmittedNl: Cell Bool): Void = {\n    ensureEndsWithNewline(b, lastEmittedNl);\n    bufPushStr(b, \"\\n[[\");\n    bufPushStr(b, formatKeyPath(hdrPath));\n    bufPushStr(b, \"]]\\n\");\n    cellSet(lastEmittedNl, true);\n    let cf = cellNew(itemFs);\n    while (match cellGet(cf) { Nil -> false, _ -> true }) {\n        match cellGet(cf) {\n            Cons((ik, iv), rf) -> {\n                bufPushStr(b, formatTomlKey(ik));\n                bufPushStr(b, \" = \");\n                emitInlineValue(b, iv);\n                bufPushByte(b, 10);\n                cellSet(lastEmittedNl, true);\n                cellSet(cf, rf)\n            },\n            Nil -> (),\n        }\n    }\n}\n\n/// Update `raw` TOML document to match `next` (`VObj`) while preserving comments,\n/// blank lines, key order, and unmodified literal formatting.\npub def patch(raw: String, next: Value): Result String String = {\n    let origVal = parse(raw)?;\n    let nextRootFs = match next {\n        VObj(fs) -> cleanObjFields(fs),\n        _ -> returnPatchErr(\"TOML patch target must be a table (VObj)\")?,\n    };\n    if (tomlValEq(origVal, VObj(nextRootFs))) {\n        Ok(raw)\n    } else {\n        let (allSecs, arrCounts) = scanTomlSections(raw)?;\n        let remRoot: Cell (List (String, Value)) = cellNew(nextRootFs);\n        let out = bufNew();\n        let lastNl = cellNew(true);\n\n        let cs = cellNew(allSecs);\n        while (match cellGet(cs) { Nil -> false, _ -> true }) {\n            match cellGet(cs) {\n                Cons(sec, restSecs) -> {\n                    match sec.kind {\n                        SecArrTable(hdrPath, idx) -> {\n                            let nextArrOpt = lookupAtPath(nextRootFs, hdrPath);\n                            let totalOrig = lookupArrCount(arrCounts, hdrPath);\n                            match nextArrOpt {\n                                Some(VArr(items)) if (isArrayOfAnyObjs(items)) -> {\n                                    let newLen = listLen(items);\n                                    if (idx < newLen) {\n                                        let itemFs = match nthValue(items, idx) {\n                                            Some(VObj(ifs)) -> ifs,\n                                            _ -> Nil,\n                                        };\n                                        let remItem: Cell (List (String, Value)) = cellNew(itemFs);\n                                        pushRawSlice(out, raw, sec.secStart, sec.bodyStart, lastNl);\n                                        let cursor = cellNew(sec.bodyStart);\n                                        let ckv = cellNew(sec.kvs);\n                                        while (match cellGet(ckv) { Nil -> false, _ -> true }) {\n                                            match cellGet(ckv) {\n                                                Cons(kv, rkv) -> {\n                                                    pushRawSlice(out, raw, cellGet(cursor), kv.lineStart, lastNl);\n                                                    match lookupAtPath(itemFs, kv.relKey) {\n                                                        Some(nv) -> {\n                                                            if (tomlValEq(kv.oldVal, nv)) {\n                                                                pushRawSlice(out, raw, kv.lineStart, kv.lineEnd, lastNl)\n                                                            } else {\n                                                                pushRawSlice(out, raw, kv.lineStart, kv.valStart, lastNl);\n                                                                emitInlineValue(out, nv);\n                                                                cellSet(lastNl, false);\n                                                                pushRawSlice(out, raw, kv.valEnd, kv.lineEnd, lastNl)\n                                                            };\n                                                            cellSet(remItem, deleteAtPath(cellGet(remItem), kv.relKey))\n                                                        },\n                                                        None -> (),\n                                                    };\n                                                    cellSet(cursor, kv.lineEnd);\n                                                    cellSet(ckv, rkv)\n                                                },\n                                                Nil -> (),\n                                            }\n                                        };\n                                        // Append any newly added fields in this array-table element\n                                        let extraItemFs = cellGet(remItem);\n                                        match extraItemFs {\n                                            Cons(_, _) -> {\n                                                ensureEndsWithNewline(out, lastNl);\n                                                let ce = cellNew(extraItemFs);\n                                                while (match cellGet(ce) { Nil -> false, _ -> true }) {\n                                                    match cellGet(ce) {\n                                                        Cons((ek, ev), re) -> {\n                                                            bufPushStr(out, formatTomlKey(ek));\n                                                            bufPushStr(out, \" = \");\n                                                            emitInlineValue(out, ev);\n                                                            bufPushByte(out, 10);\n                                                            cellSet(lastNl, true);\n                                                            cellSet(ce, re)\n                                                        },\n                                                        Nil -> (),\n                                                    }\n                                                }\n                                            },\n                                            Nil -> (),\n                                        };\n                                        pushRawSlice(out, raw, cellGet(cursor), sec.secEnd, lastNl)\n                                    } else ();\n\n                                    // After the last original `[[hdrPath]]` block, emit any newly appended blocks\n                                    if (idx + 1 == totalOrig) {\n                                        let appIdx = cellNew(totalOrig);\n                                        while (cellGet(appIdx) < newLen) {\n                                            let ai = cellGet(appIdx);\n                                            match nthValue(items, ai) {\n                                                Some(VObj(afs)) -> emitArrTableBlock(out, hdrPath, afs, lastNl),\n                                                _ -> (),\n                                            };\n                                            cellSet(appIdx, ai + 1)\n                                        };\n                                        cellSet(remRoot, deleteAtPath(cellGet(remRoot), hdrPath))\n                                    } else ()\n                                },\n                                _ -> (),\n                            }\n                        },\n                        _ -> {\n                            let tblPath = match sec.kind {\n                                SecTable(tp) -> tp,\n                                _ -> Nil,\n                            };\n                            let isRoot = match sec.kind { SecRoot -> true, _ -> false };\n                            let tblTargetOpt = lookupAtPath(nextRootFs, tblPath);\n                            let keepSection = isRoot || (match tblTargetOpt { Some(VObj(_)) -> true, _ -> false });\n                            if (keepSection) {\n                                let tblFs = match tblTargetOpt {\n                                    Some(VObj(tfs)) -> tfs,\n                                    _ -> Nil,\n                                };\n                                pushRawSlice(out, raw, sec.secStart, sec.bodyStart, lastNl);\n                                let cursor = cellNew(sec.bodyStart);\n                                let ckv = cellNew(sec.kvs);\n                                while (match cellGet(ckv) { Nil -> false, _ -> true }) {\n                                    match cellGet(ckv) {\n                                        Cons(kv, rkv) -> {\n                                            pushRawSlice(out, raw, cellGet(cursor), kv.lineStart, lastNl);\n                                            let fullKvPath = listAppend(tblPath, kv.relKey);\n                                            match lookupAtPath(tblFs, kv.relKey) {\n                                                Some(nv) if (canPatchValueInline(kv.oldVal, nv)) -> {\n                                                    if (tomlValEq(kv.oldVal, nv)) {\n                                                        pushRawSlice(out, raw, kv.lineStart, kv.lineEnd, lastNl)\n                                                    } else {\n                                                        pushRawSlice(out, raw, kv.lineStart, kv.valStart, lastNl);\n                                                        emitInlineValue(out, nv);\n                                                        cellSet(lastNl, false);\n                                                        pushRawSlice(out, raw, kv.valEnd, kv.lineEnd, lastNl)\n                                                    };\n                                                    cellSet(remRoot, deleteAtPath(cellGet(remRoot), fullKvPath))\n                                                },\n                                                _ -> (),\n                                            };\n                                            cellSet(cursor, kv.lineEnd);\n                                            cellSet(ckv, rkv)\n                                        },\n                                        Nil -> (),\n                                    }\n                                };\n\n                                // Append brand-new inline keys belonging directly to `tblPath`\n                                let hasInlineObjs = isCompactInlineTableParent(tblPath) || secHasInlineObjKv(sec.kvs);\n                                let remTblFs = match lookupAtPath(cellGet(remRoot), tblPath) {\n                                    Some(VObj(rfs)) -> rfs,\n                                    _ -> Nil,\n                                };\n                                let cf = cellNew(remTblFs);\n                                while (match cellGet(cf) { Nil -> false, _ -> true }) {\n                                    match cellGet(cf) {\n                                        Cons((fk, fv), rf) -> {\n                                            let childPath = listAppend(tblPath, [fk]);\n                                            if (!rawMentionsPrefix(allSecs, childPath)) {\n                                                let emitHere = match fv {\n                                                    VNull -> false,\n                                                    VObj(subFs) -> hasInlineObjs && !objHasNestedTables(subFs),\n                                                    VArr(xs) -> !isArrayOfNonEmptyObjs(xs),\n                                                    _ -> true,\n                                                };\n                                                if (emitHere) {\n                                                    if (!isRoot || strLen(bufToString(out)) > 0) {\n                                                        ensureEndsWithNewline(out, lastNl)\n                                                    } else ();\n                                                    bufPushStr(out, formatTomlKey(fk));\n                                                    bufPushStr(out, \" = \");\n                                                    emitInlineValue(out, fv);\n                                                    bufPushByte(out, 10);\n                                                    cellSet(lastNl, true);\n                                                    cellSet(remRoot, deleteAtPath(cellGet(remRoot), childPath))\n                                                } else ()\n                                            } else ();\n                                            cellSet(cf, rf)\n                                        },\n                                        Nil -> (),\n                                    }\n                                };\n\n                                // If `[tblPath]` was an explicit empty table in `next`, mark it emitted\n                                if (!isRoot) {\n                                    match lookupAtPath(cellGet(remRoot), tblPath) {\n                                        Some(VObj(Nil)) -> cellSet(remRoot, deleteAtPath(cellGet(remRoot), tblPath)),\n                                        _ -> (),\n                                    }\n                                } else ();\n\n                                pushRawSlice(out, raw, cellGet(cursor), sec.secEnd, lastNl)\n                            } else ()\n                        },\n                    };\n                    cellSet(cs, restSecs)\n                },\n                Nil -> (),\n            }\n        };\n\n        // Emit any remaining brand-new tables / array-of-tables at EOF\n        let leftover = cellGet(remRoot);\n        match leftover {\n            Cons(_, _) -> {\n                let curText = bufToString(out);\n                let hadContent = strLen(curText) > 0;\n                if (hadContent) ensureEndsWithNewline(out, lastNl) else ();\n                emitTableBody(out, Nil, leftover, cellNew(hadContent))\n            },\n            Nil -> (),\n        };\n\n        Ok(bufToString(out))\n    }\n}\n\ndef returnPatchErr(msg: String): Result (List (String, Value)) String = Err(msg)\n")
    else if (key == "std.sha256") Some("// Pure-Geisha FIPS 180-4 SHA-256 cryptographic hash (`std.sha256`).\n// Portable across both `native` and `wasm32` targets with zero C FFI dependencies.\n\nuse std.buf.{bufNew, bufPushByte, bufToString}\n\npub data Sha256 {\n    MkSha256 {\n        shState: MutArray Int,\n        shBlock: MutArray Int,\n        shBlockLen: Cell Int,\n        shTotalBytes: Cell Int64,\n        shWBuf: MutArray Int,\n    },\n}\n\ndef rotr32(x: Int, n: Int): Int =\n    (x >>> n) | (x << (32 - n))\n\ndef sha256KTable(): MutArray Int = {\n    let ks = [\n        1116352408, 1899447441, -1245643825, -373957723, 961987163, 1508970993, -1841331548, -1424204075,\n        -670586216, 310598401, 607225278, 1426881987, 1925078388, -2132889090, -1680079193, -1046744716,\n        -459576895, -272742522, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,\n        -1740746414, -1473132947, -1341970488, -1084653625, -958395405, -710438585, 113926993, 338241895,\n        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, -2117940946, -1838011259,\n        -1564481375, -1474664885, -1035236496, -949202525, -778901479, -694614492, -200395387, 275423344,\n        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,\n        1955562222, 2024104815, -2067236844, -1933114872, -1866530822, -1538233109, -1090935817, -965641998\n    ];\n    let arr = arrayNew(64, 0);\n    let cur = cellNew(ks);\n    let idx = cellNew(0);\n    while (match cellGet(cur) { Nil -> false, _ -> true }) {\n        match cellGet(cur) {\n            Cons(v, r) -> {\n                let i = cellGet(idx);\n                arraySet(arr, i, v);\n                cellSet(idx, i + 1);\n                cellSet(cur, r)\n            },\n            Nil -> (),\n        }\n    };\n    arr\n}\n\ndef kTable: MutArray Int = sha256KTable()\n\ndef compressBlock(st: MutArray Int, blk: MutArray Int, w: MutArray Int): Void = {\n    let i = cellNew(0);\n    while (cellGet(i) < 16) {\n        let j = cellGet(i);\n        let b = j * 4;\n        let word = ((arrayGet(blk, b) & 255) << 24)\n                 | ((arrayGet(blk, b + 1) & 255) << 16)\n                 | ((arrayGet(blk, b + 2) & 255) << 8)\n                 | (arrayGet(blk, b + 3) & 255);\n        arraySet(w, j, word);\n        cellSet(i, j + 1)\n    };\n    while (cellGet(i) < 64) {\n        let j = cellGet(i);\n        let w15 = arrayGet(w, j - 15);\n        let w2 = arrayGet(w, j - 2);\n        let s0 = rotr32(w15, 7) ^ rotr32(w15, 18) ^ (w15 >>> 3);\n        let s1 = rotr32(w2, 17) ^ rotr32(w2, 19) ^ (w2 >>> 10);\n        arraySet(w, j, arrayGet(w, j - 16) + s0 + arrayGet(w, j - 7) + s1);\n        cellSet(i, j + 1)\n    };\n\n    let a = cellNew(arrayGet(st, 0));\n    let b = cellNew(arrayGet(st, 1));\n    let c = cellNew(arrayGet(st, 2));\n    let d = cellNew(arrayGet(st, 3));\n    let e = cellNew(arrayGet(st, 4));\n    let f = cellNew(arrayGet(st, 5));\n    let g = cellNew(arrayGet(st, 6));\n    let h = cellNew(arrayGet(st, 7));\n\n    let r = cellNew(0);\n    while (cellGet(r) < 64) {\n        let idx = cellGet(r);\n        let av = cellGet(a);\n        let bv = cellGet(b);\n        let cv = cellGet(c);\n        let dv = cellGet(d);\n        let ev = cellGet(e);\n        let fv = cellGet(f);\n        let gv = cellGet(g);\n        let hv = cellGet(h);\n\n        let bigS1 = rotr32(ev, 6) ^ rotr32(ev, 11) ^ rotr32(ev, 25);\n        let ch = (ev & fv) ^ ((~ev) & gv);\n        let temp1 = hv + bigS1 + ch + arrayGet(kTable, idx) + arrayGet(w, idx);\n        let bigS0 = rotr32(av, 2) ^ rotr32(av, 13) ^ rotr32(av, 22);\n        let maj = (av & bv) ^ (av & cv) ^ (bv & cv);\n        let temp2 = bigS0 + maj;\n\n        cellSet(h, gv);\n        cellSet(g, fv);\n        cellSet(f, ev);\n        cellSet(e, dv + temp1);\n        cellSet(d, cv);\n        cellSet(c, bv);\n        cellSet(b, av);\n        cellSet(a, temp1 + temp2);\n        cellSet(r, idx + 1)\n    };\n\n    arraySet(st, 0, arrayGet(st, 0) + cellGet(a));\n    arraySet(st, 1, arrayGet(st, 1) + cellGet(b));\n    arraySet(st, 2, arrayGet(st, 2) + cellGet(c));\n    arraySet(st, 3, arrayGet(st, 3) + cellGet(d));\n    arraySet(st, 4, arrayGet(st, 4) + cellGet(e));\n    arraySet(st, 5, arrayGet(st, 5) + cellGet(f));\n    arraySet(st, 6, arrayGet(st, 6) + cellGet(g));\n    arraySet(st, 7, arrayGet(st, 7) + cellGet(h))\n}\n\npub def sha256New(): Sha256 = {\n    let st = arrayNew(8, 0);\n    arraySet(st, 0, 1779033703);\n    arraySet(st, 1, -1150833019);\n    arraySet(st, 2, 1013904242);\n    arraySet(st, 3, -1521486534);\n    arraySet(st, 4, 1359893119);\n    arraySet(st, 5, -1694144372);\n    arraySet(st, 6, 528734635);\n    arraySet(st, 7, 1541459225);\n    MkSha256 {\n        shState: st,\n        shBlock: arrayNew(64, 0),\n        shBlockLen: cellNew(0),\n        shTotalBytes: cellNew(intToI64(0)),\n        shWBuf: arrayNew(64, 0),\n    }\n}\n\npub def sha256UpdateByte(ctx: Sha256, byteVal: Int): Void = {\n    let bl = cellGet(ctx.shBlockLen);\n    arraySet(ctx.shBlock, bl, byteVal & 255);\n    cellSet(ctx.shTotalBytes, cellGet(ctx.shTotalBytes) + intToI64(1));\n    if (bl + 1 == 64) {\n        compressBlock(ctx.shState, ctx.shBlock, ctx.shWBuf);\n        cellSet(ctx.shBlockLen, 0)\n    } else {\n        cellSet(ctx.shBlockLen, bl + 1)\n    }\n}\n\npub def sha256Update(ctx: Sha256, input: String): Void = {\n    let n = strLen(input);\n    let i = cellNew(0);\n    while (cellGet(i) < n) {\n        let idx = cellGet(i);\n        sha256UpdateByte(ctx, strByteAt(input, idx));\n        cellSet(i, idx + 1)\n    }\n}\n\ndef hexLowerByte(nib: Int): Int =\n    if (nib < 10) 48 + nib else 87 + nib\n\npub def sha256FinishHex(ctx: Sha256): String = {\n    let bitLen = cellGet(ctx.shTotalBytes) * intToI64(8);\n    let bl0 = cellGet(ctx.shBlockLen);\n    arraySet(ctx.shBlock, bl0, 128);\n    let bl = cellNew(bl0 + 1);\n\n    if (cellGet(bl) > 56) {\n        while (cellGet(bl) < 64) {\n            let p = cellGet(bl);\n            arraySet(ctx.shBlock, p, 0);\n            cellSet(bl, p + 1)\n        };\n        compressBlock(ctx.shState, ctx.shBlock, ctx.shWBuf);\n        cellSet(bl, 0)\n    } else ();\n\n    while (cellGet(bl) < 56) {\n        let p = cellGet(bl);\n        arraySet(ctx.shBlock, p, 0);\n        cellSet(bl, p + 1)\n    };\n\n    let mask8 = intToI64(255);\n    arraySet(ctx.shBlock, 56, i64ToInt((bitLen >>> 56) & mask8));\n    arraySet(ctx.shBlock, 57, i64ToInt((bitLen >>> 48) & mask8));\n    arraySet(ctx.shBlock, 58, i64ToInt((bitLen >>> 40) & mask8));\n    arraySet(ctx.shBlock, 59, i64ToInt((bitLen >>> 32) & mask8));\n    arraySet(ctx.shBlock, 60, i64ToInt((bitLen >>> 24) & mask8));\n    arraySet(ctx.shBlock, 61, i64ToInt((bitLen >>> 16) & mask8));\n    arraySet(ctx.shBlock, 62, i64ToInt((bitLen >>> 8) & mask8));\n    arraySet(ctx.shBlock, 63, i64ToInt(bitLen & mask8));\n    compressBlock(ctx.shState, ctx.shBlock, ctx.shWBuf);\n\n    let out = bufNew();\n    let wi = cellNew(0);\n    while (cellGet(wi) < 8) {\n        let w = arrayGet(ctx.shState, cellGet(wi));\n        let shift = cellNew(28);\n        while (cellGet(shift) >= 0) {\n            let s = cellGet(shift);\n            bufPushByte(out, hexLowerByte((w >>> s) & 15));\n            cellSet(shift, s - 4)\n        };\n        cellSet(wi, cellGet(wi) + 1)\n    };\n    bufToString(out)\n}\n\npub def sha256Hex(input: String): String = {\n    let ctx = sha256New();\n    sha256Update(ctx, input);\n    sha256FinishHex(ctx)\n}\n")
    else if (key == "std.bench") Some("/// Microbenchmarking primitives, dead-code elimination barriers, and statistics (`std.bench`).\n\nuse std.option.{Option, Some, None}\nuse std.result.{Result, Ok, Err}\nuse std.list.listRev\nuse std.buf.{bufNew, bufPushByte, bufPushStr, bufToString}\nuse std.str.{intToStr, i64ToStr, floatToStr, parseInt, strContains}\nuse std.codec.VStr\nuse std.json.stringify\nuse sys.time.monotonicNanos\nuse sys.env.getEnv\n\n/// Prevents the compiler and LLVM optimizer from constant-folding or eliminating a value of any type.\npub def blackBox(x: a): a = __blackBox(x)\n\n/// Compiler optimization barrier that prevents reordering or eliminating surrounding work.\npub def blackBoxBarrier(): Void = __blackBox(())\n\n/// Configuration for benchmark warmup and sampling.\n/// Set `sampleIters` to `0` for automatic per-round iteration calibration.\npub data BenchConfig {\n    warmupIters: Int,\n    sampleIters: Int,\n    rounds: Int,\n}\n\n/// Summary statistics produced by measuring a benchmark function.\npub data BenchStats {\n    name: String,\n    iters: Int,\n    rounds: Int,\n    totalNs: Int64,\n    meanNs: Float,\n    medianNs: Float,\n    minNs: Float,\n    maxNs: Float,\n    opsPerSec: Float,\n}\n\n/// Default benchmark configuration (5 warmup iterations, auto-calibrated sample iterations, 11 rounds).\npub def defaultConfig(): BenchConfig = BenchConfig {\n    warmupIters: 5,\n    sampleIters: 0,\n    rounds: 11,\n}\n\ndef readEnvInt(key: String, fallback: Int, minVal: Int): Int = match getEnv(key) {\n    None -> fallback,\n    Some(raw) -> match parseInt(raw) {\n        Ok(v) if (v >= minVal) -> v,\n        _ -> fallback,\n    },\n}\n\n/// Read benchmark configuration from `GEISHA_BENCH_WARMUP`, `GEISHA_BENCH_ITERS`, and `GEISHA_BENCH_ROUNDS`.\npub def envConfig(): BenchConfig = {\n    let d = defaultConfig();\n    BenchConfig {\n        warmupIters: readEnvInt(\"GEISHA_BENCH_WARMUP\", d.warmupIters, 0),\n        sampleIters: readEnvInt(\"GEISHA_BENCH_ITERS\", d.sampleIters, 0),\n        rounds: readEnvInt(\"GEISHA_BENCH_ROUNDS\", d.rounds, 1),\n    }\n}\n\ndef i64ToFloat(v: Int64): Float = {\n    let neg = v < intToI64(0);\n    let absV = if (neg) -v else v;\n    let chunk = intToI64(1000000000);\n    let hi = absV / chunk;\n    let lo = i64ToInt(absV % chunk);\n    let f = if (hi == intToI64(0)) {\n        intToFloat(lo)\n    } else {\n        let hi2 = hi / chunk;\n        let mid = i64ToInt(hi % chunk);\n        if (hi2 == intToI64(0)) {\n            intToFloat(mid) * 1000000000.0 + intToFloat(lo)\n        } else {\n            intToFloat(i64ToInt(hi2)) * 1000000000000000000.0\n            + intToFloat(mid) * 1000000000.0\n            + intToFloat(lo)\n        }\n    };\n    if (neg) -f else f\n}\n\ndef runLoop(n: Int, f: () -> Void): Void = {\n    let i = cellNew(0);\n    while (cellGet(i) < n) {\n        f();\n        cellSet(i, cellGet(i) + 1)\n    }\n}\n\ndef calibrateBatchIters(f: () -> Void): Int = {\n    let targetNs = intToI64(1000000);\n    let batch = cellNew(1);\n    let done = cellNew(false);\n    while (!cellGet(done)) {\n        let n = cellGet(batch);\n        let t0 = monotonicNanos();\n        runLoop(n, f);\n        let dt = monotonicNanos() - t0;\n        if (dt >= targetNs || n >= 1000000) {\n            cellSet(done, true)\n        } else {\n            let next = n * 2;\n            cellSet(batch, if (next > 1000000) 1000000 else next)\n        }\n    };\n    cellGet(batch)\n}\n\ndef sortFloatsInPlace(arr: MutArray Float, n: Int): Void = {\n    let i = cellNew(1);\n    while (cellGet(i) < n) {\n        let key = arrayGet(arr, cellGet(i));\n        let j = cellNew(cellGet(i) - 1);\n        while (cellGet(j) >= 0 && arrayGet(arr, cellGet(j)) > key) {\n            let jj = cellGet(j);\n            arraySet(arr, jj + 1, arrayGet(arr, jj));\n            cellSet(j, jj - 1)\n        };\n        arraySet(arr, cellGet(j) + 1, key);\n        cellSet(i, cellGet(i) + 1)\n    }\n}\n\n/// Measure `f` using `cfg` (warmup + multi-round sampling) and return statistical results.\npub def measure(name: String, cfg: BenchConfig, f: () -> Void): BenchStats = {\n    if (cfg.warmupIters > 0) {\n        runLoop(cfg.warmupIters, f)\n    } else ();\n\n    let batchIters =\n        if (cfg.sampleIters > 0) cfg.sampleIters\n        else calibrateBatchIters(f);\n    let numRounds = if (cfg.rounds > 0) cfg.rounds else 1;\n\n    let samples = arrayNew(numRounds, 0.0);\n    let totalNsCell = cellNew(intToI64(0));\n    let sumNsCell = cellNew(0.0);\n    let batchF = intToFloat(batchIters);\n\n    let r = cellNew(0);\n    while (cellGet(r) < numRounds) {\n        let t0 = monotonicNanos();\n        runLoop(batchIters, f);\n        let dt = monotonicNanos() - t0;\n        let clampedDt = if (dt < intToI64(0)) intToI64(0) else dt;\n        cellSet(totalNsCell, cellGet(totalNsCell) + clampedDt);\n        let nsPerIter = i64ToFloat(clampedDt) / batchF;\n        arraySet(samples, cellGet(r), nsPerIter);\n        cellSet(sumNsCell, cellGet(sumNsCell) + nsPerIter);\n        cellSet(r, cellGet(r) + 1)\n    };\n\n    sortFloatsInPlace(samples, numRounds);\n    let minNs = arrayGet(samples, 0);\n    let maxNs = arrayGet(samples, numRounds - 1);\n    let medianNs =\n        if (numRounds % 2 == 1) arrayGet(samples, numRounds / 2)\n        else (arrayGet(samples, numRounds / 2 - 1) + arrayGet(samples, numRounds / 2)) / 2.0;\n    let meanNs = cellGet(sumNsCell) / intToFloat(numRounds);\n    let opsPerSec = if (meanNs > 0.0) 1000000000.0 / meanNs else 0.0;\n\n    BenchStats {\n        name: name,\n        iters: batchIters,\n        rounds: numRounds,\n        totalNs: cellGet(totalNsCell),\n        meanNs: meanNs,\n        medianNs: medianNs,\n        minNs: minNs,\n        maxNs: maxNs,\n        opsPerSec: opsPerSec,\n    }\n}\n\ndef isNonFiniteFloat(f: Float): Bool = {\n    let bits = floatToBits64(f);\n    let expMask = (intToI64(2047)) << 52;\n    (bits & expMask) == expMask\n}\n\ndef formatLargeFloat2(v: Float): String = {\n    let billion = 1000000000.0;\n    let rounded = v + 0.005;\n    if (rounded >= 1000000000000000000.0) {\n        \"999999999999999999.00\"\n    } else {\n        let b = bufNew();\n        let hi = floatToInt(rounded / billion);\n        let rem = rounded - intToFloat(hi) * billion;\n        let lo = floatToInt(rem);\n        let frac = floatToInt((rem - intToFloat(lo)) * 100.0);\n        let cFrac = if (frac < 0) 0 else if (frac > 99) 99 else frac;\n        bufPushStr(b, intToStr(hi));\n        let loStr = intToStr(if (lo < 0) 0 else lo);\n        let pad = cellNew(9 - strLen(loStr));\n        while (cellGet(pad) > 0) {\n            bufPushByte(b, 48);\n            cellSet(pad, cellGet(pad) - 1)\n        };\n        bufPushStr(b, loStr);\n        bufPushByte(b, 46);\n        if (cFrac < 10) bufPushByte(b, 48) else ();\n        bufPushStr(b, intToStr(cFrac));\n        bufToString(b)\n    }\n}\n\ndef formatFloat2(f: Float): String =\n    if (isNonFiniteFloat(f)) \"0.00\"\n    else {\n        let neg = f < 0.0;\n        let v = if (neg) -f else f;\n        let pfx = if (neg) \"-\" else \"\";\n        if (v + 0.005 < 1000000000.0) {\n            let rounded = v + 0.005;\n            let whole = floatToInt(rounded);\n            let frac = floatToInt((rounded - intToFloat(whole)) * 100.0);\n            let cFrac = if (frac < 0) 0 else if (frac > 99) 99 else frac;\n            pfx + intToStr(whole) + \".\" + (if (cFrac < 10) \"0\" else \"\") + intToStr(cFrac)\n        } else {\n            pfx + formatLargeFloat2(v)\n        }\n    }\n\ndef formatJsonFloat(f: Float): String =\n    if (isNonFiniteFloat(f)) \"0.0\"\n    else {\n        let neg = f < 0.0;\n        let v = if (neg) -f else f;\n        if (v < 1000000000.0) floatToStr(f)\n        else (if (neg) \"-\" else \"\") + formatLargeFloat2(v)\n    }\n\n/// Format a duration in nanoseconds with automatic unit scaling (`ns`, `us`, `ms`, `s`).\npub def formatDurationNs(ns: Float): String =\n    if (ns < 1000.0) formatFloat2(ns) + \" ns\"\n    else if (ns < 1000000.0) formatFloat2(ns / 1000.0) + \" us\"\n    else if (ns < 1000000000.0) formatFloat2(ns / 1000000.0) + \" ms\"\n    else formatFloat2(ns / 1000000000.0) + \" s\"\n\n/// Format throughput in operations per second (`ops/s`, `K ops/s`, `M ops/s`, `G ops/s`).\npub def formatOpsPerSec(ops: Float): String =\n    if (ops >= 1000000000.0) formatFloat2(ops / 1000000000.0) + \" G ops/s\"\n    else if (ops >= 1000000.0) formatFloat2(ops / 1000000.0) + \" M ops/s\"\n    else if (ops >= 1000.0) formatFloat2(ops / 1000.0) + \" K ops/s\"\n    else formatFloat2(ops) + \" ops/s\"\n\n/// Format `BenchStats` as a human-readable single-line summary.\npub def formatStatsText(s: BenchStats): String =\n    s.name\n    + \" | mean: \" + formatDurationNs(s.meanNs)\n    + \" | median: \" + formatDurationNs(s.medianNs)\n    + \" | min: \" + formatDurationNs(s.minNs)\n    + \" | max: \" + formatDurationNs(s.maxNs)\n    + \" | \" + formatOpsPerSec(s.opsPerSec)\n    + \" (\" + intToStr(s.iters) + \" iters x \" + intToStr(s.rounds) + \" rounds)\"\n\n/// Format `BenchStats` as a compact JSON object string with an optional `\"file\"` field.\npub def formatStatsJsonInFile(s: BenchStats, fileOpt: Option String): String = {\n    let fileField = match fileOpt {\n        Some(f) if (strLen(f) > 0) -> \",\\\"file\\\":\" + stringify(VStr(f)),\n        _ -> \"\",\n    };\n    \"{\\\"name\\\":\" + stringify(VStr(s.name))\n    + fileField\n    + \",\\\"iters\\\":\" + intToStr(s.iters)\n    + \",\\\"rounds\\\":\" + intToStr(s.rounds)\n    + \",\\\"total_ns\\\":\" + i64ToStr(s.totalNs)\n    + \",\\\"mean_ns\\\":\" + formatJsonFloat(s.meanNs)\n    + \",\\\"median_ns\\\":\" + formatJsonFloat(s.medianNs)\n    + \",\\\"min_ns\\\":\" + formatJsonFloat(s.minNs)\n    + \",\\\"max_ns\\\":\" + formatJsonFloat(s.maxNs)\n    + \",\\\"ops_per_sec\\\":\" + formatJsonFloat(s.opsPerSec)\n    + \"}\"\n}\n\n/// Format `BenchStats` as a pure, compact JSON object string.\npub def formatStatsJson(s: BenchStats): String =\n    formatStatsJsonInFile(s, None)\n\ndef matchesBenchFilter(name: String): Bool = match getEnv(\"GEISHA_BENCH_FILTER\") {\n    None -> true,\n    Some(pat) if (strLen(pat) == 0) -> true,\n    Some(pat) -> strContains(name, pat),\n}\n\ndef isJsonOutputMode(): Bool = match getEnv(\"GEISHA_BENCH_JSON\") {\n    Some(v) -> v == \"1\" || v == \"true\",\n    None -> false,\n}\n\n/// Run a benchmark with explicit `BenchConfig`, printing text or JSON based on `GEISHA_BENCH_JSON`.\npub def benchWith(name: String, cfg: BenchConfig, f: () -> Void): BenchStats = {\n    if (!matchesBenchFilter(name)) {\n        BenchStats {\n            name: name,\n            iters: 0,\n            rounds: 0,\n            totalNs: intToI64(0),\n            meanNs: 0.0,\n            medianNs: 0.0,\n            minNs: 0.0,\n            maxNs: 0.0,\n            opsPerSec: 0.0,\n        }\n    } else {\n        let s = measure(name, cfg, f);\n        if (isJsonOutputMode()) {\n            printLn(formatStatsJsonInFile(s, getEnv(\"GEISHA_BENCH_FILE\")))\n        } else {\n            printLn(formatStatsText(s))\n        };\n        s\n    }\n}\n\n/// Run a benchmark using `envConfig()` (respecting `geisha bench` flags `--iters`, `--warmup`, `--rounds`, `--filter`, `--json`).\npub def bench(name: String, f: () -> Void): BenchStats =\n    benchWith(name, envConfig(), f)\n\n/// Run a named group of benchmarks, prefixing each entry as `<groupName>/<itemName>`.\npub def benchGroup(groupName: String, items: List (String, () -> Void)): List BenchStats = {\n    let cfg = envConfig();\n    let acc = cellNew(Nil);\n    let cur = cellNew(items);\n    while (match cellGet(cur) { Nil -> false, _ -> true }) {\n        match cellGet(cur) {\n            Cons((nm, fn), rest) -> {\n                let fullName = if (strLen(groupName) > 0) groupName + \"/\" + nm else nm;\n                let s = benchWith(fullName, cfg, fn);\n                if (s.rounds > 0) cellSet(acc, Cons(s, cellGet(acc))) else ();\n                cellSet(cur, rest)\n            },\n            Nil -> (),\n        }\n    };\n    listRev(cellGet(acc))\n}\n")
    else if (key == "sys.io") Some("// Standard stream I/O via portable runtime ABI (`sys.io`)\n\nextern \"gs_sys_fd_write\" def c_fd_write(fd: Int, buf: String, count: Int64): Int64\n\npub def print(s: String): Void = {\n    let _ = c_fd_write(1, s, intToI64(strLen(s)));\n    ()\n}\n\npub def eprint(s: String): Void = {\n    let _ = c_fd_write(2, s, intToI64(strLen(s)));\n    ()\n}\n\npub def eprintLn(s: String): Void = {\n    eprint(s);\n    eprint(\"\\n\")\n}\n")
    else if (key == "sys.fs") Some("// File system operations via portable POSIX / ANSI C ABI (`sys.fs`),\n// including single-shot `fstat` `readFile` and zero-copy read-only `Mmap` views.\n\nuse std.result.{Result, Ok, Err}\nuse std.buf.{bufNew, bufPushPtr, bufToString}\nuse std.list.listRev\n\nextern \"gs_sys_fopen\" def c_fopen(path: String, mode: String): Ptr\nextern \"fclose\" def c_fclose(fp: Ptr): Int\nextern \"fread\" def c_fread(buf: Ptr, size: Int64, nitems: Int64, fp: Ptr): Int64\nextern \"fwrite\" def c_fwrite(buf: String, size: Int64, nitems: Int64, fp: Ptr): Int64\nextern \"gs_sys_file_exists\" def c_file_exists(path: String): Int\nextern \"gs_sys_remove\" def c_remove(path: String): Int\nextern \"gs_sys_rmdir\" def c_rmdir(path: String): Int\nextern \"gs_sys_lstat_kind\" def c_lstat_kind(path: String): Int\nextern \"gs_sys_host_os\" def c_fs_host_os(): Ptr\nextern \"gs_sys_is_dir\" def c_is_dir(path: String): Int\nextern \"gs_sys_mkdir\" def c_mkdir(path: String): Int\nextern \"gs_sys_dir_open\" def c_dir_open(path: String): Ptr\nextern \"gs_sys_dir_next\" def c_dir_next(dir: Ptr): Ptr\nextern \"gs_sys_dir_close\" def c_dir_close(dir: Ptr): Int\nextern \"gs_sys_file_size\" def c_file_size(path: String): Int64\nextern \"gs_sys_mmap_open\" def c_mmap_open(path: String): Ptr\nextern \"gs_sys_mmap_close\" def c_mmap_close(ptr: Ptr, len: Int64): Int\nextern \"gs_sys_write_atomic\" def c_write_atomic(path: String, buf: String, len: Int64, mode: Int): Int\nextern \"gs_sys_rename\" def c_rename(src: String, dst: String): Int\nextern \"gs_sys_chmod\" def c_chmod(path: String, mode: Int): Int\nextern \"gs_sys_file_mtime_ms\" def c_file_mtime_ms(path: String): Int64\n\npub def fileExists(path: String): Bool =\n    c_file_exists(path) != 0\n\npub def isDir(path: String): Bool =\n    c_is_dir(path) != 0\n\npub def mkdir(path: String): Result Void String =\n    if (c_mkdir(path) == 0) Ok(())\n    else Err(\"failed to create directory: \" + path)\n\ndef isWinHost(): Bool = {\n    let p = c_fs_host_os();\n    !ptrIsNull(p) && ptrToString(p) == \"windows\"\n}\n\ndef isHostPathSepByte(winHost: Bool, b: Int): Bool =\n    b == 47 || (winHost && b == 92)\n\ndef isAsciiLetterByte(b: Int): Bool =\n    (b >= 65 && b <= 90) || (b >= 97 && b <= 122)\n\ndef hasWinDrivePrefix(p: String): Bool =\n    strLen(p) >= 2 && isAsciiLetterByte(strByteAt(p, 0)) && strByteAt(p, 1) == 58\n\npub def mkdirAll(path: String): Result Void String = {\n    let n = strLen(path);\n    if (n == 0) Err(\"empty directory path\")\n    else {\n        let winHost = isWinHost();\n        let startIdx = if (winHost && hasWinDrivePrefix(path)) 3 else 1;\n        let i = cellNew(startIdx);\n        let failed = cellNew(false);\n        while (cellGet(i) < n && !cellGet(failed)) {\n            let idx = cellGet(i);\n            if (isHostPathSepByte(winHost, strByteAt(path, idx))) {\n                let prefix = ptrSliceFromStr(path, 0, idx);\n                if (strLen(prefix) > 0 && !isDir(prefix)) {\n                    if (c_mkdir(prefix) != 0) cellSet(failed, true) else ()\n                } else ()\n            } else ();\n            cellSet(i, idx + 1)\n        };\n        if (cellGet(failed)) Err(\"failed to create parent directories for: \" + path)\n        else if (isDir(path)) Ok(())\n        else mkdir(path)\n    }\n}\n\npub def readDir(path: String): Result (List String) String = {\n    let dir = c_dir_open(path);\n    if (ptrIsNull(dir)) {\n        Err(\"failed to open directory: \" + path)\n    } else {\n        let acc = cellNew(Nil);\n        let running = cellNew(true);\n        while (cellGet(running)) {\n            let namePtr = c_dir_next(dir);\n            if (ptrIsNull(namePtr)) {\n                cellSet(running, false)\n            } else {\n                cellSet(acc, Cons(ptrToString(namePtr), cellGet(acc)))\n            }\n        };\n        let _ = c_dir_close(dir);\n        Ok(listRev(cellGet(acc)))\n    }\n}\n\npub def readFile(path: String): Result String String = {\n    let fp = c_fopen(path, \"rb\");\n    if (ptrIsNull(fp)) {\n        Err(strConcat(\"failed to open file for reading: \", path))\n    } else {\n        let sz64 = c_file_size(path);\n        let maxSingle = intToI64(2147483640);\n        if (sz64 == intToI64(0)) {\n            let _ = c_fclose(fp);\n            Ok(\"\")\n        } else if (sz64 > intToI64(0) && sz64 <= maxSingle) {\n            // Fast path: regular file — single-shot read + single bulk copy\n            let sz = i64ToInt(sz64);\n            let raw = ptrAllocBytes(sz + 1);\n            let got = i64ToInt(c_fread(raw, intToI64(1), sz64, fp));\n            let _ = c_fclose(fp);\n            Ok(ptrSliceToString(raw, if (got < 0) 0 else got))\n        } else {\n            // Fallback for pipes / non-regular files: 64 KiB chunked bulk-memcpy reads\n            let chunkCap = 65536;\n            let chunk = ptrAllocBytes(chunkCap);\n            let out = bufNew();\n            let reading = cellNew(true);\n            while (cellGet(reading)) {\n                let got = i64ToInt(c_fread(chunk, intToI64(1), intToI64(chunkCap), fp));\n                if (got <= 0) {\n                    cellSet(reading, false)\n                } else {\n                    bufPushPtr(out, chunk, got)\n                }\n            };\n            let _ = c_fclose(fp);\n            Ok(bufToString(out))\n        }\n    }\n}\n\npub def writeFile(path: String, content: String): Result Void String = {\n    let fp = c_fopen(path, \"wb\");\n    if (ptrIsNull(fp)) {\n        Err(strConcat(\"failed to open file for writing: \", path))\n    } else {\n        let total = strLen(content);\n        let written = i64ToInt(c_fwrite(content, intToI64(1), intToI64(total), fp));\n        let closeRc = c_fclose(fp);\n        if (written == total && closeRc == 0) Ok(())\n        else Err(strConcat(\"failed to write full contents to: \", path))\n    }\n}\n\npub def removeFile(path: String): Bool =\n    c_remove(path) == 0\n\n/// Remove an empty directory at `path`.\npub def removeDir(path: String): Bool =\n    c_rmdir(path) == 0\n\ndef trimTrailingHostSep(winHost: Bool, path: String): String = {\n    let minLen =\n        if (winHost && hasWinDrivePrefix(path)) {\n            if (strLen(path) >= 3 && isHostPathSepByte(winHost, strByteAt(path, 2))) 3 else 2\n        } else if (strLen(path) > 0 && isHostPathSepByte(winHost, strByteAt(path, 0))) {\n            1\n        } else {\n            0\n        };\n    let hi = cellNew(strLen(path));\n    while (cellGet(hi) > minLen && isHostPathSepByte(winHost, strByteAt(path, cellGet(hi) - 1))) {\n        cellSet(hi, cellGet(hi) - 1)\n    };\n    ptrSliceFromStr(path, 0, cellGet(hi))\n}\n\n/// Recursively remove a file or directory tree at `path` without following symlinks.\n/// Symbolic links (including directory symlinks with trailing slashes and dangling symlinks)\n/// are unlinked as leaf entries. Returns `true` if `path` no longer exists on disk.\npub def removeDirAll(path: String): Bool = {\n    let winHost = isWinHost();\n    let target = trimTrailingHostSep(winHost, path);\n    let kind = c_lstat_kind(target);\n    if (kind == 0) true\n    else if (kind < 0) false\n    else if (kind == 4) removeDir(target)\n    else if (kind != 2) removeFile(target)\n    else match readDir(target) {\n        Err(_) -> false,\n        Ok(entries) -> {\n            let cur = cellNew(entries);\n            let ok = cellNew(true);\n            while (match cellGet(cur) { Nil -> false, _ -> true }) {\n                match cellGet(cur) {\n                    Cons(name, rest) -> {\n                        let sep =\n                            if (strLen(target) > 0 && isHostPathSepByte(winHost, strByteAt(target, strLen(target) - 1))) \"\"\n                            else \"/\";\n                        let child = strConcat(strConcat(target, sep), name);\n                        if (!removeDirAll(child)) cellSet(ok, false) else ();\n                        cellSet(cur, rest)\n                    },\n                    Nil -> (),\n                }\n            };\n            if (cellGet(ok)) removeDir(target) else false\n        },\n    }\n}\n\n/// Atomically write `content` to `path` via a same-directory temporary file (`fsync` + `rename`).\n/// Preserves existing permissions when `path` already exists, or creates with `0o666 & ~umask`.\npub def writeFileAtomic(path: String, content: String): Result Void String =\n    if (c_write_atomic(path, content, intToI64(strLen(content)), -1) == 0) Ok(())\n    else Err(\"failed to atomically write file: \" + path)\n\n/// Atomically write `content` to `path` with explicit POSIX permissions (e.g. `0o600`),\n/// applied via `fchmod` before `rename` so the file is never exposed with wider permissions.\npub def writeFileAtomicMode(path: String, content: String, mode: Int): Result Void String =\n    if (mode < 0) Err(\"invalid negative file mode for: \" + path)\n    else if (c_write_atomic(path, content, intToI64(strLen(content)), mode) == 0) Ok(())\n    else Err(\"failed to atomically write file with mode: \" + path)\n\n/// Atomically rename or move a filesystem entry from `src` to `dst`.\npub def renameFile(src: String, dst: String): Result Void String =\n    if (c_rename(src, dst) == 0) Ok(())\n    else Err(\"failed to rename '\" + src + \"' to '\" + dst + \"'\")\n\n/// Set POSIX permission bits on `path` (e.g. `chmod(path, 0o755)`).\npub def chmod(path: String, mode: Int): Result Void String =\n    if (mode < 0) Err(\"invalid negative file mode for: \" + path)\n    else if (c_chmod(path, mode) == 0) Ok(())\n    else Err(\"failed to chmod file: \" + path)\n\n/// Return the last-modification timestamp of `path` in milliseconds since the Unix epoch.\npub def fileMtimeMs(path: String): Result Int64 String = {\n    let ts = c_file_mtime_ms(path);\n    if (ts < intToI64(0)) Err(\"failed to stat mtime for: \" + path)\n    else Ok(ts)\n}\n\n// ---- Zero-copy read-only memory-mapped file handle (`Mmap`) ----\n\npub data Mmap {\n    Mmap { ptr: Ptr, len: Int64 },\n}\n\npub def mmapOpen(path: String): Result Mmap String = {\n    let sz = c_file_size(path);\n    if (sz < intToI64(0)) {\n        Err(\"failed to stat file for mmap: \" + path)\n    } else if (sz == intToI64(0)) {\n        Ok(Mmap { ptr: ptrNull(), len: intToI64(0) })\n    } else {\n        let p = c_mmap_open(path);\n        if (ptrIsNull(p)) Err(\"failed to mmap file: \" + path)\n        else Ok(Mmap { ptr: p, len: sz })\n    }\n}\n\npub def mmapLen(m: Mmap): Int64 = m.len\n\npub def mmapByteAt(m: Mmap, idx: Int): Int =\n    if (idx < 0 || intToI64(idx) >= m.len) {\n        let _ = arrayGet(arrayNew(i64ToInt(m.len), 0), idx);\n        0\n    } else {\n        ptrByteAt(m.ptr, idx)\n    }\n\npub def mmapClose(m: Mmap): Void = {\n    let _ = c_mmap_close(m.ptr, m.len);\n    ()\n}\n\npub def withMmap(path: String, f: Mmap -> a): Result a String = {\n    let m = mmapOpen(path)?;\n    let res = f(m);\n    mmapClose(m);\n    Ok(res)\n}\n")
    else if (key == "sys.env") Some("// Command-line arguments, environment variables & host platform (`sys.env`)\n\nuse std.option.{Option, Some, None}\n\nextern \"gs_sys_getenv\" def c_getenv(name: String): Ptr\nextern \"gs_sys_host_os\" def c_host_os(): Ptr\nextern \"gs_sys_host_arch\" def c_host_arch(): Ptr\nextern \"gs_sys_exe_path\" def c_exe_path(): Ptr\n\npub def argCount(): Int = sysArgc()\n\npub def argAt(idx: Int): String = sysArgv(idx)\n\npub def args(): List String = {\n    let acc = cellNew(Nil);\n    let i = cellNew(sysArgc() - 1);\n    while (cellGet(i) >= 0) {\n        let idx = cellGet(i);\n        cellSet(acc, Cons(sysArgv(idx), cellGet(acc)));\n        cellSet(i, idx - 1)\n    };\n    cellGet(acc)\n}\n\npub def getEnv(name: String): Option String = {\n    let p = c_getenv(name);\n    if (ptrIsNull(p)) None\n    else Some(ptrToString(p))\n}\n\npub def hostOs(): String = {\n    let p = c_host_os();\n    if (ptrIsNull(p)) \"posix\" else ptrToString(p)\n}\n\npub def hostArch(): String = {\n    let p = c_host_arch();\n    if (ptrIsNull(p)) \"unknown\" else ptrToString(p)\n}\n\npub def exePath(): Option String = {\n    let p = c_exe_path();\n    if (ptrIsNull(p)) None else Some(ptrToString(p))\n}\n")
    else if (key == "sys.proc") Some("/// Process management, streaming pipes, and timeout-bounded command execution (`sys.proc`).\n///\n/// Built on thread-safe `posix_spawnp` and single-thread `poll` multiplexing without\n/// modifying global `SIGCHLD` handlers or spawning background runtime worker threads.\n\nuse std.option.{Option, Some, None}\nuse std.result.{Result, Ok, Err}\nuse std.buf.{StringBuf, bufNew, bufPushByte, bufPushStr, bufPushPtr, bufToString}\nuse std.generic\nuse sys.time.monotonicMs\n\nextern \"exit\" def c_exit(code: Int): Void\nextern \"gs_sys_shell\" def c_shell(cmd: String): Int\nextern \"gs_proc_spawn\" def c_proc_spawn(\n    program: String,\n    argBlob: String,\n    argc: Int,\n    cwd: String,\n    envMode: Int,\n    envBlob: String,\n    envc: Int,\n    stdioPacked: Int,\n    ownGroup: Int,\n    outInts: Ptr\n): Int\nextern \"gs_proc_wait\" def c_proc_wait(pid: Int, nohang: Int): Int64\nextern \"gs_proc_wait_timeout\" def c_proc_wait_timeout(pid: Int, timeoutMs: Int): Int64\nextern \"gs_proc_signal\" def c_proc_signal(pid: Int, sigKind: Int, ownGroup: Int): Int\nextern \"gs_pipe_read\" def c_pipe_read(fd: Int, buf: Ptr, cap: Int): Int\nextern \"gs_pipe_write\" def c_pipe_write(fd: Int, buf: String, len: Int): Int\nextern \"gs_pipe_close\" def c_pipe_close(fd: Int): Int\nextern \"gs_pipe_poll2\" def c_pipe_poll2(fd0: Int, fd1: Int, timeoutMs: Int): Int\n\n/// Standard stream redirection mode for child processes.\npub data Stdio : Eq {\n    Inherit,\n    Null,\n    Piped,\n}\n\n/// Environment variable policy for child processes.\npub data EnvMode {\n    InheritEnv,\n    OverrideEnv(List (String, String)),\n    ReplaceEnv(List (String, String)),\n}\n\n/// Portable POSIX process signals.\npub data Signal : Eq {\n    SigTerm,\n    SigKill,\n    SigInt,\n}\n\n/// Child process launch specification.\npub data Command {\n    program: String,\n    args: List String,\n    cwd: Option String,\n    env: EnvMode,\n    stdin: Stdio,\n    stdout: Stdio,\n    stderr: Stdio,\n    ownGroup: Bool,\n}\n\n/// OS pipe file descriptor handle (`Send`-safe value wrapper).\npub data Pipe(Int) : Eq\n\n/// Running child process handle (`Send`-safe value wrapper).\npub data Child {\n    pid: Int,\n    ownGroup: Bool,\n    stdin: Option Pipe,\n    stdout: Option Pipe,\n    stderr: Option Pipe,\n}\n\n/// Child termination status.\npub data ExitStatus : Eq {\n    Exited(Int),\n    Signaled(Int),\n}\n\n/// Captured output and exit status of a completed child process.\npub data Output : Eq {\n    status: ExitStatus,\n    stdout: String,\n    stderr: String,\n}\n\n/// Terminate the current process immediately with exit status `code`.\npub def exit(code: Int): Void = c_exit(code)\n\n/// Execute a command line through the host shell (`/bin/sh -c` on POSIX, `cmd.exe` on Windows),\n/// returning the decoded exit status (`0..255`, `128 + signal`, or `-1` on launch error).\npub def shell(cmd: String): Int = c_shell(cmd)\n\n/// Construct a `Command` for `program` and `args` (inheriting cwd, env, and stdio by default).\npub def command(program: String, args: List String): Command = Command {\n    program: program,\n    args: args,\n    cwd: None,\n    env: InheritEnv,\n    stdin: Inherit,\n    stdout: Inherit,\n    stderr: Inherit,\n    ownGroup: false,\n}\n\n/// Return a copy of `cmd` with working directory `dir`.\npub def cmdCwd(cmd: Command, dir: String): Command = Command {\n    program: cmd.program,\n    args: cmd.args,\n    cwd: Some(dir),\n    env: cmd.env,\n    stdin: cmd.stdin,\n    stdout: cmd.stdout,\n    stderr: cmd.stderr,\n    ownGroup: cmd.ownGroup,\n}\n\n/// Return a copy of `cmd` overriding `vars` on top of the current process environment.\npub def cmdEnv(cmd: Command, vars: List (String, String)): Command = Command {\n    program: cmd.program,\n    args: cmd.args,\n    cwd: cmd.cwd,\n    env: OverrideEnv(vars),\n    stdin: cmd.stdin,\n    stdout: cmd.stdout,\n    stderr: cmd.stderr,\n    ownGroup: cmd.ownGroup,\n}\n\n/// Return a copy of `cmd` with explicit environment policy `mode`.\npub def cmdEnvMode(cmd: Command, mode: EnvMode): Command = Command {\n    program: cmd.program,\n    args: cmd.args,\n    cwd: cmd.cwd,\n    env: mode,\n    stdin: cmd.stdin,\n    stdout: cmd.stdout,\n    stderr: cmd.stderr,\n    ownGroup: cmd.ownGroup,\n}\n\n/// Return a copy of `cmd` with explicit `stdin`, `stdout`, and `stderr` redirection modes.\npub def cmdStdio(cmd: Command, stdin: Stdio, stdout: Stdio, stderr: Stdio): Command = Command {\n    program: cmd.program,\n    args: cmd.args,\n    cwd: cmd.cwd,\n    env: cmd.env,\n    stdin: stdin,\n    stdout: stdout,\n    stderr: stderr,\n    ownGroup: cmd.ownGroup,\n}\n\n/// Return a copy of `cmd` configured to start in its own process group (`setpgid(0, 0)`),\n/// allowing `childSignal` and `runTimeout` to terminate the entire child process tree.\npub def cmdOwnGroup(cmd: Command, enabled: Bool): Command = Command {\n    program: cmd.program,\n    args: cmd.args,\n    cwd: cmd.cwd,\n    env: cmd.env,\n    stdin: cmd.stdin,\n    stdout: cmd.stdout,\n    stderr: cmd.stderr,\n    ownGroup: enabled,\n}\n\ndef stdioCode(s: Stdio): Int = match s {\n    Inherit -> 0,\n    Null -> 1,\n    Piped -> 2,\n}\n\ndef signalCode(s: Signal): Int = match s {\n    SigTerm -> 0,\n    SigKill -> 1,\n    SigInt -> 2,\n}\n\ndef packArgBlob(prog: String, args: List String): (String, Int) = {\n    let b = bufNew();\n    bufPushStr(b, prog);\n    bufPushByte(b, 0);\n    let count = cellNew(1);\n    let cur = cellNew(args);\n    while (match cellGet(cur) { Nil -> false, _ -> true }) {\n        match cellGet(cur) {\n            Cons(a, r) -> {\n                bufPushStr(b, a);\n                bufPushByte(b, 0);\n                cellSet(count, cellGet(count) + 1);\n                cellSet(cur, r)\n            },\n            Nil -> (),\n        }\n    };\n    (bufToString(b), cellGet(count))\n}\n\ndef packEnvBlob(pairs: List (String, String)): (String, Int) = {\n    let b = bufNew();\n    let count = cellNew(0);\n    let cur = cellNew(pairs);\n    while (match cellGet(cur) { Nil -> false, _ -> true }) {\n        match cellGet(cur) {\n            Cons((k, v), r) -> {\n                bufPushStr(b, k);\n                bufPushByte(b, 61);\n                bufPushStr(b, v);\n                bufPushByte(b, 0);\n                cellSet(count, cellGet(count) + 1);\n                cellSet(cur, r)\n            },\n            Nil -> (),\n        }\n    };\n    (bufToString(b), cellGet(count))\n}\n\ndef optPipeFromFd(fd: Int): Option Pipe =\n    if (fd < 0) None else Some(Pipe(fd))\n\n/// Spawn `cmd` without invoking a shell (`posix_spawnp`).\npub def spawn(cmd: Command): Result Child String =\n    if (strLen(cmd.program) == 0) Err(\"cannot spawn empty program name\")\n    else {\n        let (argBlob, argc) = packArgBlob(cmd.program, cmd.args);\n        let (envModeInt, envBlob, envc) = match cmd.env {\n            InheritEnv -> (0, \"\", 0),\n            OverrideEnv(vs) -> {\n                let (eb, ec) = packEnvBlob(vs);\n                (1, eb, ec)\n            },\n            ReplaceEnv(vs) -> {\n                let (eb, ec) = packEnvBlob(vs);\n                (2, eb, ec)\n            },\n        };\n        let cwdStr = match cmd.cwd { Some(d) -> d, None -> \"\" };\n        let stdioPacked = stdioCode(cmd.stdin) | (stdioCode(cmd.stdout) << 2) | (stdioCode(cmd.stderr) << 4);\n        let outInts = ptrAllocBytes(16);\n        let rc = c_proc_spawn(\n            cmd.program, argBlob, argc, cwdStr,\n            envModeInt, envBlob, envc, stdioPacked,\n            if (cmd.ownGroup) 1 else 0, outInts\n        );\n        if (rc != 0) Err(\"failed to spawn process: \" + cmd.program)\n        else {\n            let pid = ptrReadU32Le(outInts, 0);\n            let inFd = ptrReadU32Le(outInts, 4);\n            let outFd = ptrReadU32Le(outInts, 8);\n            let errFd = ptrReadU32Le(outInts, 12);\n            Ok(Child {\n                pid: pid,\n                ownGroup: cmd.ownGroup,\n                stdin: optPipeFromFd(inFd),\n                stdout: optPipeFromFd(outFd),\n                stderr: optPipeFromFd(errFd),\n            })\n        }\n    }\n\ndef decodeWaitResult(raw: Int64): Result (Option ExitStatus) String =\n    if (raw < intToI64(0)) Err(\"waitpid failed\")\n    else if (raw == intToI64(0)) Ok(None)\n    else {\n        let tag = i64ToInt(raw >>> 32);\n        let lowMask = (intToI64(0xFFFF) << 16) | intToI64(0xFFFF);\n        let code = i64ToInt(raw & lowMask);\n        if (tag == 2) Ok(Some(Signaled(code)))\n        else Ok(Some(Exited(code)))\n    }\n\n/// Poll whether `c` has exited without blocking (`WNOHANG`).\npub def childTryWait(c: Child): Result (Option ExitStatus) String =\n    decodeWaitResult(c_proc_wait(c.pid, 1))\n\n/// Block until `c` terminates and reap its exit status.\npub def childWait(c: Child): Result ExitStatus String =\n    match decodeWaitResult(c_proc_wait(c.pid, 0))? {\n        Some(st) -> Ok(st),\n        None -> Err(\"unexpected empty waitpid result\"),\n    }\n\n/// Wait up to `timeoutMs` milliseconds for `c` to exit (`Ok(None)` on timeout).\npub def childWaitTimeout(c: Child, timeoutMs: Int): Result (Option ExitStatus) String =\n    decodeWaitResult(c_proc_wait_timeout(c.pid, timeoutMs))\n\n/// Send `sig` to `c` (targets the entire process group `-c.pid` when `c.ownGroup` is `true`).\npub def childSignal(c: Child, sig: Signal): Result Void String =\n    if (c_proc_signal(c.pid, signalCode(sig), if (c.ownGroup) 1 else 0) == 0) Ok(())\n    else Err(\"failed to send signal to process\")\n\n/// Read up to `cap` raw bytes from `p` into `buf` (`Ok(0)` on EOF).\npub def pipeReadPtr(p: Pipe, buf: Ptr, cap: Int): Result Int String = match p {\n    Pipe(fd) -> {\n        let n = c_pipe_read(fd, buf, cap);\n        if (n < 0) Err(\"pipe read failed\")\n        else Ok(n)\n    },\n}\n\n/// Read up to `maxBytes` bytes from `p` as a `String` (`Ok(\"\")` on EOF).\npub def pipeRead(p: Pipe, maxBytes: Int): Result String String = {\n    let cap = if (maxBytes <= 0) 1 else maxBytes;\n    let buf = ptrAllocBytes(cap);\n    let n = pipeReadPtr(p, buf, cap)?;\n    Ok(ptrSliceToString(buf, n))\n}\n\n/// Read `p` until EOF into a `String` and close `p`.\npub def pipeReadAll(p: Pipe): Result String String = {\n    let chunkCap = 16384;\n    let chunk = ptrAllocBytes(chunkCap);\n    let out = bufNew();\n    let reading = cellNew(true);\n    let errOpt: Cell (Option String) = cellNew(None);\n    while (cellGet(reading) && match cellGet(errOpt) { None -> true, Some(_) -> false }) {\n        match pipeReadPtr(p, chunk, chunkCap) {\n            Err(e) -> cellSet(errOpt, Some(e)),\n            Ok(0) -> cellSet(reading, false),\n            Ok(n) -> bufPushPtr(out, chunk, n),\n        }\n    };\n    pipeClose(p);\n    match cellGet(errOpt) {\n        Some(e) -> Err(e),\n        None -> Ok(bufToString(out)),\n    }\n}\n\n/// Write all bytes of `payload` to `p`.\npub def pipeWrite(p: Pipe, payload: String): Result Void String = match p {\n    Pipe(fd) -> {\n        let total = strLen(payload);\n        if (total == 0) Ok(())\n        else if (c_pipe_write(fd, payload, total) == total) Ok(())\n        else Err(\"pipe write failed\")\n    },\n}\n\n/// Close pipe handle `p`.\npub def pipeClose(p: Pipe): Void = match p {\n    Pipe(fd) -> {\n        let _ = c_pipe_close(fd);\n        ()\n    },\n}\n\ndef pipeFdOrNeg1(opt: Option Pipe): Int = match opt {\n    Some(Pipe(fd)) -> fd,\n    None -> -1,\n}\n\ndef closeOptPipe(opt: Option Pipe): Void = match opt {\n    Some(p) -> pipeClose(p),\n    None -> (),\n}\n\ndef prepareRunCommand(cmd: Command, forceGroup: Bool): Command = Command {\n    program: cmd.program,\n    args: cmd.args,\n    cwd: cmd.cwd,\n    env: cmd.env,\n    stdin: match cmd.stdin { Inherit -> Null, s -> s },\n    stdout: match cmd.stdout { Null -> Null, _ -> Piped },\n    stderr: match cmd.stderr { Null -> Null, _ -> Piped },\n    ownGroup: cmd.ownGroup || forceGroup,\n}\n\ndef collectChildOutput(c: Child, timeoutOpt: Option Int): Result (Option Output) String = {\n    closeOptPipe(c.stdin);\n    let outFd = cellNew(pipeFdOrNeg1(c.stdout));\n    let errFd = cellNew(pipeFdOrNeg1(c.stderr));\n    let outBuf = bufNew();\n    let errBuf = bufNew();\n    let scratch = ptrAllocBytes(16384);\n    let timedOut = cellNew(false);\n    let ioErr: Cell (Option String) = cellNew(None);\n\n    let deadlineOpt: Option Int64 = match timeoutOpt {\n        Some(ms) -> Some(monotonicMs() + intToI64(if (ms < 0) 0 else ms)),\n        None -> None,\n    };\n\n    while ((cellGet(outFd) >= 0 || cellGet(errFd) >= 0) && !cellGet(timedOut) && match cellGet(ioErr) { None -> true, Some(_) -> false }) {\n        let waitMs = match deadlineOpt {\n            None -> -1,\n            Some(dl) -> {\n                let rem = i64ToInt(dl - monotonicMs());\n                if (rem <= 0) 0 else rem\n            },\n        };\n        if (waitMs == 0 && match deadlineOpt { Some(_) -> true, None -> false }) {\n            // Drain any immediately ready bytes once before declaring timeout\n            let readyNow = c_pipe_poll2(cellGet(outFd), cellGet(errFd), 0);\n            if (readyNow <= 0) {\n                cellSet(timedOut, true)\n            } else {\n                if ((readyNow & 1) != 0 && cellGet(outFd) >= 0) {\n                    let n = c_pipe_read(cellGet(outFd), scratch, 16384);\n                    if (n <= 0) { let _ = c_pipe_close(cellGet(outFd)); cellSet(outFd, -1) }\n                    else bufPushPtr(outBuf, scratch, n)\n                } else ();\n                if ((readyNow & 2) != 0 && cellGet(errFd) >= 0) {\n                    let n = c_pipe_read(cellGet(errFd), scratch, 16384);\n                    if (n <= 0) { let _ = c_pipe_close(cellGet(errFd)); cellSet(errFd, -1) }\n                    else bufPushPtr(errBuf, scratch, n)\n                } else ()\n            }\n        } else {\n            let mask = c_pipe_poll2(cellGet(outFd), cellGet(errFd), waitMs);\n            if (mask < 0) {\n                cellSet(ioErr, Some(\"poll failed while reading process pipes\"))\n            } else if (mask == 0) {\n                cellSet(timedOut, true)\n            } else {\n                if ((mask & 1) != 0 && cellGet(outFd) >= 0) {\n                    let n = c_pipe_read(cellGet(outFd), scratch, 16384);\n                    if (n < 0) cellSet(ioErr, Some(\"failed reading child stdout\"))\n                    else if (n == 0) { let _ = c_pipe_close(cellGet(outFd)); cellSet(outFd, -1) }\n                    else bufPushPtr(outBuf, scratch, n)\n                } else ();\n                if ((mask & 2) != 0 && cellGet(errFd) >= 0) {\n                    let n = c_pipe_read(cellGet(errFd), scratch, 16384);\n                    if (n < 0) cellSet(ioErr, Some(\"failed reading child stderr\"))\n                    else if (n == 0) { let _ = c_pipe_close(cellGet(errFd)); cellSet(errFd, -1) }\n                    else bufPushPtr(errBuf, scratch, n)\n                } else ()\n            }\n        }\n    };\n\n    if (cellGet(outFd) >= 0) { let _ = c_pipe_close(cellGet(outFd)); cellSet(outFd, -1) } else ();\n    if (cellGet(errFd) >= 0) { let _ = c_pipe_close(cellGet(errFd)); cellSet(errFd, -1) } else ();\n\n    match cellGet(ioErr) {\n        Some(e) -> {\n            let _ = childSignal(c, SigKill);\n            let _ = childWait(c);\n            Err(e)\n        },\n        None ->\n            if (cellGet(timedOut)) {\n                let _ = childSignal(c, SigKill);\n                let _ = childWait(c);\n                Ok(None)\n            } else {\n                match deadlineOpt {\n                    None -> {\n                        let st = childWait(c)?;\n                        Ok(Some(Output {\n                            status: st,\n                            stdout: bufToString(outBuf),\n                            stderr: bufToString(errBuf),\n                        }))\n                    },\n                    Some(dl) -> {\n                        let rem = i64ToInt(dl - monotonicMs());\n                        let stOpt = childWaitTimeout(c, if (rem < 0) 0 else rem)?;\n                        match stOpt {\n                            Some(st) -> Ok(Some(Output {\n                                status: st,\n                                stdout: bufToString(outBuf),\n                                stderr: bufToString(errBuf),\n                            })),\n                            None -> {\n                                let _ = childSignal(c, SigKill);\n                                let _ = childWait(c);\n                                Ok(None)\n                            },\n                        }\n                    },\n                }\n            },\n    }\n}\n\n/// Spawn `cmd`, capture `stdout` and `stderr` concurrently without deadlocking, and wait for exit.\npub def run(cmd: Command): Result Output String = {\n    let child = spawn(prepareRunCommand(cmd, false))?;\n    match collectChildOutput(child, None)? {\n        Some(out) -> Ok(out),\n        None -> Err(\"unexpected timeout in blocking run\"),\n    }\n}\n\n/// Spawn `cmd` in its own process group and wait up to `timeoutMs` ms.\n/// Returns `Ok(None)` if the process exceeds `timeoutMs` (killing and reaping the entire group).\npub def runTimeout(cmd: Command, timeoutMs: Int): Result (Option Output) String = {\n    let child = spawn(prepareRunCommand(cmd, true))?;\n    collectChildOutput(child, Some(timeoutMs))\n}\n")
    else if (key == "sys.time") Some("// Wall-clock and monotonic clocks (`sys.time`)\n\nextern \"gs_sys_time_now_ms\" def c_now_ms(): Int64\nextern \"gs_sys_time_mono_ms\" def c_mono_ms(): Int64\nextern \"gs_sys_time_mono_ns\" def c_mono_ns(): Int64\n\npub def nowMs(): Int64 = c_now_ms()\n\npub def monotonicMs(): Int64 = c_mono_ms()\n\npub def monotonicNanos(): Int64 = c_mono_ns()\n")
    else if (key == "sys.net") Some("// Blocking-safe POSIX TCP sockets (`sys.net`)\n// Every `extern` call runs inside the runtime GC blocking region so concurrent\n// `accept` / `read` / `write` calls never stall multicore STW collection.\n\nuse std.result.{Result, Ok, Err}\nuse std.buf.{bufNew, bufPushByte, bufToString}\n\nextern \"gs_net_tcp_listen\" def c_tcp_listen(host: String, port: Int, backlog: Int): Int\nextern \"gs_net_tcp_local_port\" def c_tcp_local_port(fd: Int): Int\nextern \"gs_net_tcp_accept\" def c_tcp_accept(fd: Int): Int\nextern \"gs_net_tcp_connect\" def c_tcp_connect(host: String, port: Int): Int\nextern \"gs_net_tcp_read\" def c_tcp_read(fd: Int, buf: Ptr, cap: Int): Int\nextern \"gs_net_tcp_peek\" def c_tcp_peek(fd: Int, buf: Ptr, cap: Int): Int\nextern \"gs_net_tcp_write\" def c_tcp_write(fd: Int, buf: Ptr, len: Int): Int\nextern \"gs_net_tcp_write\" def c_tcp_write_str(fd: Int, buf: String, len: Int): Int\nextern \"gs_net_tcp_close\" def c_tcp_close(fd: Int): Int\n\npub data TcpListener {\n    TcpListener(Int),\n}\n\npub data TcpStream {\n    TcpStream(Int),\n}\n\npub def tcpListen(host: String, port: Int): Result TcpListener String = {\n    let fd = c_tcp_listen(host, port, 128);\n    if (fd < 0) Err(\"failed to listen on \" + host)\n    else Ok(TcpListener(fd))\n}\n\npub def tcpLocalPort(listener: TcpListener): Int = match listener {\n    TcpListener(fd) -> c_tcp_local_port(fd),\n}\n\npub def tcpAccept(listener: TcpListener): Result TcpStream String = match listener {\n    TcpListener(fd) -> {\n        let client = c_tcp_accept(fd);\n        if (client < 0) Err(\"tcp accept failed\")\n        else Ok(TcpStream(client))\n    },\n}\n\npub def tcpCloseListener(listener: TcpListener): Void = match listener {\n    TcpListener(fd) -> {\n        let _ = c_tcp_close(fd);\n        ()\n    },\n}\n\npub def tcpConnect(host: String, port: Int): Result TcpStream String = {\n    let fd = c_tcp_connect(host, port);\n    if (fd < 0) Err(\"failed to connect to \" + host)\n    else Ok(TcpStream(fd))\n}\n\npub def tcpClose(stream: TcpStream): Void = match stream {\n    TcpStream(fd) -> {\n        let _ = c_tcp_close(fd);\n        ()\n    },\n}\n\npub def tcpReadPtr(stream: TcpStream, buf: Ptr, cap: Int): Result Int String = match stream {\n    TcpStream(fd) -> {\n        let n = c_tcp_read(fd, buf, cap);\n        if (n < 0) Err(\"tcp read failed\")\n        else Ok(n)\n    },\n}\n\npub def tcpPeekPtr(stream: TcpStream, buf: Ptr, cap: Int): Result Int String = match stream {\n    TcpStream(fd) -> {\n        let n = c_tcp_peek(fd, buf, cap);\n        if (n < 0) Err(\"tcp peek failed\")\n        else Ok(n)\n    },\n}\n\npub def tcpReadExactPtr(stream: TcpStream, buf: Ptr, count: Int): Result Void String =\n    if (count <= 0) Ok(())\n    else {\n        let first = tcpReadPtr(stream, buf, count)?;\n        if (first == 0) {\n            Err(\"unexpected EOF on tcp stream\")\n        } else if (first >= count) {\n            Ok(())\n        } else {\n            let got = cellNew(first);\n            let tmp = ptrAllocBytes(count - first);\n            let failed = cellNew(false);\n            let err = cellNew(\"\");\n            while (cellGet(got) < count && !cellGet(failed)) {\n                let base = cellGet(got);\n                let rem = count - base;\n                match tcpReadPtr(stream, tmp, rem) {\n                    Err(e) -> { cellSet(err, e); cellSet(failed, true) },\n                    Ok(n) ->\n                        if (n == 0) {\n                            cellSet(err, \"unexpected EOF on tcp stream\");\n                            cellSet(failed, true)\n                        } else {\n                            ptrCopyBytes(buf, base, tmp, 0, n);\n                            cellSet(got, base + n)\n                        },\n                }\n            };\n            if (cellGet(failed)) Err(cellGet(err))\n            else Ok(())\n        }\n    }\n\npub def tcpRead(stream: TcpStream, maxBytes: Int): Result String String = {\n    let cap = if (maxBytes <= 0) 1 else maxBytes;\n    let buf = ptrAllocBytes(cap);\n    let n = tcpReadPtr(stream, buf, cap)?;\n    Ok(ptrSliceToString(buf, n))\n}\n\npub def tcpWritePtr(stream: TcpStream, buf: Ptr, len: Int): Result Void String = match stream {\n    TcpStream(fd) ->\n        if (len <= 0) Ok(())\n        else {\n            let first = c_tcp_write(fd, buf, len);\n            if (first <= 0) Err(\"tcp write failed\")\n            else if (first >= len) Ok(())\n            else {\n                let sent = cellNew(first);\n                let failed = cellNew(false);\n                let scratch = ptrAllocBytes(len - first);\n                while (cellGet(sent) < len && !cellGet(failed)) {\n                    let off = cellGet(sent);\n                    let rem = len - off;\n                    ptrCopyBytes(scratch, 0, buf, off, rem);\n                    let n = c_tcp_write(fd, scratch, rem);\n                    if (n <= 0) cellSet(failed, true)\n                    else cellSet(sent, off + n)\n                };\n                if (cellGet(failed)) Err(\"tcp write failed\")\n                else Ok(())\n            }\n        },\n}\n\npub def tcpWrite(stream: TcpStream, payload: String): Result Void String = match stream {\n    TcpStream(fd) -> {\n        let total = strLen(payload);\n        let sent = cellNew(0);\n        let err = cellNew(\"\");\n        while (cellGet(sent) < total && strLen(cellGet(err)) == 0) {\n            let off = cellGet(sent);\n            let slice = if (off == 0) payload else strSlice(payload, off, total);\n            let n = c_tcp_write_str(fd, slice, total - off);\n            if (n <= 0) cellSet(err, \"tcp write failed\")\n            else cellSet(sent, off + n)\n        };\n        if (strLen(cellGet(err)) > 0) Err(cellGet(err))\n        else Ok(())\n    },\n}\n")
    else if (key == "sys.ffi") Some("/// Low-level C FFI utilities: dynamic library loading (`dlopen`/`dlsym`),\n/// C string conversions, and scoped foreign pointer helpers.\n\nuse std.option.{Option, Some, None}\n\nextern \"gs_dlopen\" def c_dlopen(path: String): Ptr\nextern \"gs_dlsym\" def c_dlsym(handle: Ptr, sym: String): Ptr\nextern \"gs_dlclose\" def c_dlclose(handle: Ptr): Int\n\n/// Open a shared library or framework by path (e.g. `\"/System/Library/Frameworks/AppKit.framework/AppKit\"`).\n/// Returns `None` if loading fails.\npub def dlOpen(path: String): Option Ptr = {\n    let h = c_dlopen(path);\n    if (ptrIsNull(h)) None else Some(h)\n}\n\n/// Open the current process image (`dlopen(NULL, ...)`), useful for resolving already-linked symbols.\npub def dlOpenSelf(): Ptr = c_dlopen(\"\")\n\n/// Resolve a C symbol address from a library handle (or pass `ptrNull()` for `RTLD_DEFAULT`).\npub def dlSym(handle: Ptr, symbol: String): Option Ptr = {\n    let p = c_dlsym(handle, symbol);\n    if (ptrIsNull(p)) None else Some(p)\n}\n\n/// Close a handle previously returned by `dlOpen`.\npub def dlClose(handle: Ptr): Void = {\n    let _ = c_dlclose(handle);\n    ()\n}\n\n/// Convert a nullable C `const char *` pointer into `Option String`.\npub def ptrToStrOpt(p: Ptr): Option String =\n    if (ptrIsNull(p)) None else Some(ptrToString(p))\n")
    else None
