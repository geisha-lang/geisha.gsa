def buildPreludeBaseMap(): StrMap Scheme = {
    let m: StrMap Scheme = strMapNew();
    let cur = cellNew(preludePrimSpecs());
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((nm, sig), r) -> {
                strMapInsert(m, nm, finalizePreludeScheme(nm, parseTypeSchemeFromStr(sig)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    m
}

// ============================================================================
// Scheme Instantiation, Concept Constraint Solving & `Send` Verification
// ============================================================================

def instantiateScheme(ctx: InferCtx, scm: Scheme, sp: Span): Type = match scm {
    ScmMono(t) -> t,
    ScmPoly(tvs, t) -> {
        let freshVars = cellNew(Nil);
        let cur = cellNew(tvs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(tv, r) -> {
                    let fv = if (isModeVarName(tv)) freshModeVar(ctx) else freshVar(ctx);
                    cellSet(freshVars, listAppend(cellGet(freshVars), [fv]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let sub = buildPairMap(tvs, cellGet(freshVars));
        applyExplicitSubst(t, sub)
    },
    ScmPolyConstrained(tvs, cs, t) -> {
        let freshVars = cellNew(Nil);
        let cur = cellNew(tvs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(tv, r) -> {
                    let fv = if (isModeVarName(tv)) freshModeVar(ctx) else freshVar(ctx);
                    cellSet(freshVars, listAppend(cellGet(freshVars), [fv]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let sub = buildPairMap(tvs, cellGet(freshVars));
        let curC = cellNew(cs);
        while (match cellGet(curC) { Nil -> false, _ -> true }) {
            match cellGet(curC) {
                Cons(c, r) -> {
                    let argTys = applyExplicitSubstList(c.typeArgs, sub);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: c.conceptName, wcArgs: argTys, wcSpan: sp }]));
                    cellSet(curC, r)
                },
                Nil -> (),
            }
        };
        applyExplicitSubst(t, sub)
    },
    ScmSlot -> freshVar(ctx),
}

pub def decomposeAdtType(adtReg: StrMap AdtInfo, ty: Type): Option (String, List Type) = {
    let args = cellNew(Nil);
    let curr = cellNew(ty);
    let looping = cellNew(true);
    while (cellGet(looping)) {
        match cellGet(curr) {
            TyComp(b, a) -> {
                cellSet(args, Cons(a, cellGet(args)));
                cellSet(curr, b)
            },
            _ -> cellSet(looping, false),
        }
    };
    match cellGet(curr) {
        TyCon(name) -> if (strMapContains(adtReg, name)) Some((name, cellGet(args))) else None,
        _ -> None,
    }
}

pub def matchInstancePattern(pat: Type, concrete: Type, sub: StrMap Type): Bool = match (pat, concrete) {
    (TyVar(v), t) -> match strMapGet(sub, v) {
        Some(existing) -> typesEqual(existing, t),
        None -> { strMapInsert(sub, v, t); true },
    },
    (TyVoid, TyVoid) -> true,
    (TyCon(a), TyCon(b)) -> a == b,
    (TyCon(mPat), TyVar(mv)) if ((mPat == "$Local" || mPat == "$Shared" || mPat == "$Scoped") && isModeVarName(mv)) -> true,
    (TyComp(b1, a1), TyComp(b2, a2)) -> matchInstancePattern(b1, b2, sub) && matchInstancePattern(a1, a2, sub),
    (TyTuple(es1), TyTuple(es2)) -> matchInstancePatList(es1, es2, sub),
    (TyArr(m1, ps1, r1), TyArr(m2, ps2, r2)) -> matchInstancePattern(m1, m2, sub) && matchInstancePatList(ps1, ps2, sub) && matchInstancePattern(r1, r2, sub),
    _ -> false,
}

pub def matchInstancePatList(xs: List Type, ys: List Type, sub: StrMap Type): Bool = match (xs, ys) {
    (Nil, Nil) -> true,
    (Cons(x, xr), Cons(y, yr)) -> matchInstancePattern(x, y, sub) && matchInstancePatList(xr, yr, sub),
    _ -> false,
}

pub def isConcreteTypeSend(adtReg: StrMap AdtInfo, ty: Type): Bool =
    checkTypeSendRec(adtReg, ty, Nil)

def checkTypeSendRec(adtReg: StrMap AdtInfo, ty: Type, visiting: List String): Bool = match ty {
    TyVoid -> true,
    TyVar(_) -> false,
    TyArr(m, _, _) -> match m {
        TyCon(mn) -> mn == "$Shared" || mn == "Void",
        TyVoid -> true,
        _ -> false,
    },
    TyTuple(es) -> {
        let cur = cellNew(es);
        let ok = cellNew(true);
        while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    if (!checkTypeSendRec(adtReg, e, visiting)) cellSet(ok, false) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(ok)
    },
    TyCon(name) ->
        if (name == "Ptr" || name == "Cell" || name == "MutArray" || name == "ForeignPtr" || name == "ScopedPtr" || name == "Arena" || name == "$Local" || name == "$Scoped") false
        else if (name == "Int" || name == "Int64" || name == "Float" || name == "Float32" || name == "Bool" || name == "Char" || name == "String" || name == "Void" || name == "AtomicInt" || name == "$Shared") true
        else match strMapGet(adtReg, name) {
            Some(ainfo) ->
                if (listContainsStr(visiting, name)) true
                else checkAdtVariantsSend(adtReg, ainfo, Nil, Cons(name, visiting)),
            None -> true,
        },
    TyComp(_, _) -> {
        let args = cellNew(Nil);
        let curr = cellNew(ty);
        let looping = cellNew(true);
        while (cellGet(looping)) {
            match cellGet(curr) {
                TyComp(b, a) -> { cellSet(args, Cons(a, cellGet(args))); cellSet(curr, b) },
                _ -> cellSet(looping, false),
            }
        };
        let targs = cellGet(args);
        match cellGet(curr) {
            TyCon(baseName) ->
                if (baseName == "Cell" || baseName == "MutArray") false
                else if (baseName == "Actor" || baseName == "Simd") true
                else if (baseName == "MVar" || baseName == "Chan" || baseName == "Task" || baseName == "ImmArray") {
                    match targs {
                        Cons(elem, Nil) -> checkTypeSendRec(adtReg, elem, visiting),
                        _ -> false,
                    }
                } else match strMapGet(adtReg, baseName) {
                    Some(ainfo) -> {
                        let key = mangleType(ty);
                        if (listContainsStr(visiting, key)) true
                        else checkAdtVariantsSend(adtReg, ainfo, targs, Cons(key, visiting))
                    },
                    None -> false,
                },
            _ -> false,
        }
    },
}

def checkAdtVariantsSend(adtReg: StrMap AdtInfo, ainfo: AdtInfo, targs: List Type, visiting: List String): Bool = {
    let sub = buildPairMap(ainfo.typeParams, targs);
    let curV = cellNew(ainfo.variants);
    let ok = cellNew(true);
    while (match cellGet(curV) { Nil -> false, _ -> cellGet(ok) }) {
        match cellGet(curV) {
            Cons(v, rV) -> {
                let curF = cellNew(v.fieldTypes);
                while (match cellGet(curF) { Nil -> false, _ -> cellGet(ok) }) {
                    match cellGet(curF) {
                        Cons(ft, rF) -> {
                            let instFt = applyExplicitSubst(ft, sub);
                            if (!checkTypeSendRec(adtReg, instFt, visiting)) cellSet(ok, false) else ();
                            cellSet(curF, rF)
                        },
                        Nil -> (),
                    }
                };
                cellSet(curV, rV)
            },
            Nil -> (),
        }
    };
    cellGet(ok)
}

def constraintSpecEqual(a: ConstraintSpec, b: ConstraintSpec): Bool =
    a.conceptName == b.conceptName && typeListsEqual(a.typeArgs, b.typeArgs)

def constraintListContains(cs: List ConstraintSpec, cname: String, args: List Type): Bool = match cs {
    Nil -> false,
    Cons(c, r) ->
        if (c.conceptName == cname && typeListsEqual(c.typeArgs, args)) true
        else constraintListContains(r, cname, args),
}

def expandGivenClosure(ctx: InferCtx, given: List ConstraintSpec): List ConstraintSpec = {
    let result = cellNew(Nil);
    let queue = cellNew(given);
    let steps = cellNew(0);
    while (match cellGet(queue) { Nil -> false, _ -> cellGet(steps) < 128 }) {
        match cellGet(queue) {
            Cons(c, rest) -> {
                cellSet(queue, rest);
                cellSet(steps, cellGet(steps) + 1);
                if (!constraintListContains(cellGet(result), c.conceptName, c.typeArgs)) {
                    cellSet(result, listAppend(cellGet(result), [c]));
                    match strMapGet(ctx.conceptReg, c.conceptName) {
                        Some(cinfo) -> {
                            let sub = buildPairMap(cinfo.typeParams, c.typeArgs);
                            let cs = cellNew(cinfo.superclasses);
                            while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                match cellGet(cs) {
                                    Cons(sc, rsc) -> {
                                        let supArgs = applyExplicitSubstList(sc.typeArgs, sub);
                                        cellSet(queue, listAppend(cellGet(queue), [MkConstraint { conceptName: sc.conceptName, typeArgs: supArgs }]));
                                        cellSet(cs, rsc)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    }
                } else ()
            },
            Nil -> (),
        }
    };
    cellGet(result)
}

def hasGivenConstraint(ctx: InferCtx, given: List ConstraintSpec, cname: String, args: List Type): Bool = {
    let closure = expandGivenClosure(ctx, given);
    constraintListContains(closure, cname, args)
}

def hasResidualWanted(ws: List WantedConstraint, cname: String, args: List Type): Bool = match ws {
    Nil -> false,
    Cons(w, r) ->
        if (w.wcConcept == cname && typeListsEqual(w.wcArgs, args)) true
        else hasResidualWanted(r, cname, args),
}

def pushResidualWanted(residual: Cell (List WantedConstraint), cname: String, args: List Type, sp: Span): Void = {
    let cur = cellGet(residual);
    if (!hasResidualWanted(cur, cname, args)) {
        cellSet(residual, Cons(MkWanted { wcConcept: cname, wcArgs: args, wcSpan: sp }, cur))
    } else ()
}

def hasAnyTyVar(ty: Type): Bool = match ftvOrdered(ty) {
    Nil -> false,
    _ -> true,
}

def hasAnyTyVarInList(ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> hasAnyTyVar(h) || hasAnyTyVarInList(t),
}

def hasNonVarInList(ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> match h {
        TyVar(_) -> hasNonVarInList(t),
        _ -> true,
    },
}

def findStrIndex(xs: List String, target: String, idx: Int): Option Int = match xs {
    Nil -> None,
    Cons(h, t) -> if (h == target) Some(idx) else findStrIndex(t, target, idx + 1),
}

def nthTypeOpt(ts: List Type, idx: Int): Option Type = match ts {
    Nil -> None,
    Cons(h, t) -> if (idx == 0) Some(h) else nthTypeOpt(t, idx - 1),
}

def joinTypeListStr(ts: List Type): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> typeToString(h),
    Cons(h, t) -> typeToString(h) + ", " + joinTypeListStr(t),
}

def selectTypesByNames(tparams: List String, names: List String, args: List Type): List Type = {
    let out = cellNew(Nil);
    let cn = cellNew(names);
    while (match cellGet(cn) { Nil -> false, _ -> true }) {
        match cellGet(cn) {
            Cons(nm, rn) -> {
                match findStrIndex(tparams, nm, 0) {
                    Some(idx) -> match nthTypeOpt(args, idx) {
                        Some(t) -> cellSet(out, listAppend(cellGet(out), [t])),
                        None -> (),
                    },
                    None -> (),
                };
                cellSet(cn, rn)
            },
            Nil -> (),
        }
    };
    cellGet(out)
}

def applyFunDeps(
    ctx: InferCtx,
    cname: String,
    zArgs0: List Type,
    givenClosure: List ConstraintSpec,
    sp: Span
): Result (List Type) String = match strMapGet(ctx.conceptReg, cname) {
    None -> Ok(zArgs0),
    Some(cinfo) -> match cinfo.fundeps {
        Nil -> Ok(zArgs0),
        fds -> {
            let curArgs = cellNew(zArgs0);
            let changed = cellNew(true);
            let rounds = cellNew(0);
            while (cellGet(changed) && cellGet(rounds) < 16) {
                cellSet(changed, false);
                cellSet(rounds, cellGet(rounds) + 1);
                let cfd = cellNew(fds);
                while (match cellGet(cfd) { Nil -> false, _ -> true }) {
                    match cellGet(cfd) {
                        Cons(fd, rfd) -> {
                            let zArgs = zonkTypeList(ctx.subst, cellGet(curArgs));
                            let wLhs = selectTypesByNames(cinfo.typeParams, fd.fdLhs, zArgs);
                            let wRhs = selectTypesByNames(cinfo.typeParams, fd.fdRhs, zArgs);

                            // Step A: improve from given constraints (including superclasses)
                            let cg = cellNew(givenClosure);
                            while (match cellGet(cg) { Nil -> false, _ -> true }) {
                                match cellGet(cg) {
                                    Cons(g, rg) -> {
                                        if (g.conceptName == cname) {
                                            let gLhs = selectTypesByNames(cinfo.typeParams, fd.fdLhs, g.typeArgs);
                                            if (typeListsEqual(wLhs, gLhs)) {
                                                let gRhs = selectTypesByNames(cinfo.typeParams, fd.fdRhs, g.typeArgs);
                                                let cwr = cellNew(wRhs);
                                                let cgr = cellNew(gRhs);
                                                while (match cellGet(cwr) { Nil -> false, _ -> true }) {
                                                    match (cellGet(cwr), cellGet(cgr)) {
                                                        (Cons(wr, r1), Cons(gr, r2)) -> {
                                                            let z1 = zonkType(ctx.subst, wr);
                                                            let z2 = zonkType(ctx.subst, gr);
                                                            if (!typesEqual(z1, z2)) {
                                                                unifyTypes(ctx.subst, z1, z2, sp)?;
                                                                cellSet(changed, true)
                                                            } else ();
                                                            cellSet(cwr, r1);
                                                            cellSet(cgr, r2)
                                                        },
                                                        _ -> cellSet(cwr, Nil),
                                                    }
                                                }
                                            } else ()
                                        } else ();
                                        cellSet(cg, rg)
                                    },
                                    Nil -> (),
                                }
                            };

                            // Step B: improve from unique matching instance on LHS when LHS has concrete structure
                            let zArgs2 = zonkTypeList(ctx.subst, cellGet(curArgs));
                            let wLhs2 = selectTypesByNames(cinfo.typeParams, fd.fdLhs, zArgs2);
                            if (hasNonVarInList(wLhs2)) {
                                let matches = cellNew(Nil);
                                let ci = cellNew(cellGet(ctx.instanceReg));
                                while (match cellGet(ci) { Nil -> false, _ -> true }) {
                                    match cellGet(ci) {
                                        Cons(inst, ri) -> {
                                            if (inst.conceptName == cname) {
                                                let iLhs = selectTypesByNames(cinfo.typeParams, fd.fdLhs, inst.targetTypes);
                                                let sub: StrMap Type = strMapNew();
                                                if (matchInstancePatList(iLhs, wLhs2, sub)) {
                                                    cellSet(matches, listAppend(cellGet(matches), [(inst, sub)]))
                                                } else ()
                                            } else ();
                                            cellSet(ci, ri)
                                        },
                                        Nil -> (),
                                    }
                                };
                                match cellGet(matches) {
                                    Cons((inst, sub), Nil) -> {
                                        let wRhs2 = selectTypesByNames(cinfo.typeParams, fd.fdRhs, zArgs2);
                                        let iRhs = selectTypesByNames(cinfo.typeParams, fd.fdRhs, inst.targetTypes);
                                        let cwr = cellNew(wRhs2);
                                        let cir = cellNew(iRhs);
                                        while (match cellGet(cwr) { Nil -> false, _ -> true }) {
                                            match (cellGet(cwr), cellGet(cir)) {
                                                (Cons(wr, r1), Cons(ir, r2)) -> {
                                                    let expIr = applyExplicitSubst(ir, sub);
                                                    if (!hasAnyTyVar(expIr)) {
                                                        let z1 = zonkType(ctx.subst, wr);
                                                        if (!typesEqual(z1, expIr)) {
                                                            unifyTypes(ctx.subst, z1, expIr, sp)?;
                                                            cellSet(changed, true)
                                                        } else ()
                                                    } else ();
                                                    cellSet(cwr, r1);
                                                    cellSet(cir, r2)
                                                },
                                                _ -> cellSet(cwr, Nil),
                                            }
                                        }
                                    },
                                    _ -> (),
                                }
                            } else ();

                            cellSet(curArgs, zonkTypeList(ctx.subst, cellGet(curArgs)));
                            cellSet(cfd, rfd)
                        },
                        Nil -> (),
                    }
                }
            };
            Ok(zonkTypeList(ctx.subst, cellGet(curArgs)))
        },
    },
}

def bindMatchedModes(subst: StrMap Type, pat: Type, conc: Type, sp: Span): Result Void String = {
    let zp = zonkType(subst, pat);
    let zc = zonkType(subst, conc);
    match (zp, zc) {
        (TyCon(mPat), TyVar(mv)) ->
            if ((mPat == "$Local" || mPat == "$Shared" || mPat == "$Scoped") && isModeVarName(mv)) {
                unifyTypes(subst, TyVar(mv), TyCon(mPat), sp)
            } else Ok(()),
        (TyComp(b1, a1), TyComp(b2, a2)) -> {
            bindMatchedModes(subst, b1, b2, sp)?;
            bindMatchedModes(subst, a1, a2, sp)
        },
        (TyTuple(es1), TyTuple(es2)) -> bindMatchedModesList(subst, es1, es2, sp),
        (TyArr(m1, ps1, r1), TyArr(m2, ps2, r2)) -> {
            bindMatchedModes(subst, m1, m2, sp)?;
            bindMatchedModesList(subst, ps1, ps2, sp)?;
            bindMatchedModes(subst, r1, r2, sp)
        },
        _ -> Ok(()),
    }
}

def bindMatchedModesList(subst: StrMap Type, pats: List Type, concs: List Type, sp: Span): Result Void String = match (pats, concs) {
    (Cons(p, pr), Cons(c, cr)) -> {
        bindMatchedModes(subst, p, c, sp)?;
        bindMatchedModesList(subst, pr, cr, sp)
    },
    _ -> Ok(()),
}

def dischargeConstraint(
    ctx: InferCtx,
    wc: WantedConstraint,
    given: List ConstraintSpec,
    residual: Cell (List WantedConstraint),
    depth: Int
): Result Void String =
    if (depth > 32) Err(typeErr(wc.wcSpan, "Constraint resolution exceeded recursion limit for '" + wc.wcConcept + "'"))
    else {
        let zArgs0 = zonkTypeList(ctx.subst, wc.wcArgs);
        if (wc.wcConcept == "Send") {
            match zArgs0 {
                Cons(zty, _) -> match zty {
                    TyVar(v) -> {
                        if (!hasGivenConstraint(ctx, given, "Send", [TyVar(v)])) {
                            pushResidualWanted(residual, "Send", [TyVar(v)], wc.wcSpan)
                        } else ();
                        Ok(())
                    },
                    _ -> dischargeSendConstraint(ctx, zty, wc.wcSpan, given, residual, Nil, depth),
                },
                Nil -> Ok(()),
            }
        } else if (wc.wcConcept == "SendIf") {
            match zArgs0 {
                Cons(mTy, Cons(targetTy, _)) ->
                    dischargeSendIf(ctx, mTy, targetTy, wc.wcSpan, given, residual, depth),
                _ -> Ok(()),
            }
        } else if (wc.wcConcept == "NoScoped") {
            match zArgs0 {
                Cons(targetTy, _) -> {
                    let zt = zonkType(ctx.subst, targetTy);
                    if (typeContainsScoped(ctx.adtReg, ctx.subst, zt, Nil)) {
                        Err(typeErr(wc.wcSpan, "Scoped value ('ScopedPtr' / 'Arena' / '$Scoped' closure) cannot escape its scope or be stored in a mutable container: '" + typeToString(zt) + "'"))
                    } else Ok(())
                },
                Nil -> Ok(()),
            }
        } else {
            let givenClosure = expandGivenClosure(ctx, given);
            let zArgs = applyFunDeps(ctx, wc.wcConcept, zArgs0, givenClosure, wc.wcSpan)?;
            if (constraintListContains(givenClosure, wc.wcConcept, zArgs)) Ok(())
            else {
                let matchedInst: Cell (Option (InstanceInfo, StrMap Type)) = cellNew(None);
                let curI = cellNew(cellGet(ctx.instanceReg));
                while (match cellGet(curI) { Nil -> false, _ -> match cellGet(matchedInst) { None -> true, Some(_) -> false } }) {
                    match cellGet(curI) {
                        Cons(inst, rI) -> {
                            if (inst.conceptName == wc.wcConcept && listLen(inst.targetTypes) == listLen(zArgs)) {
                                let sub: StrMap Type = strMapNew();
                                if (matchInstancePatList(inst.targetTypes, zArgs, sub)) {
                                    cellSet(matchedInst, Some((inst, sub)))
                                } else ()
                            } else ();
                            cellSet(curI, rI)
                        },
                        Nil -> (),
                    }
                };
                match cellGet(matchedInst) {
                    Some((inst, sub)) -> {
                        bindMatchedModesList(ctx.subst, applyExplicitSubstList(inst.targetTypes, sub), zArgs, wc.wcSpan)?;
                        dischargeSubConstraints(ctx, inst.constraints, sub, wc.wcSpan, given, residual, depth + 1)
                    },
                    None ->
                        if (hasAnyTyVarInList(zArgs)) {
                            pushResidualWanted(residual, wc.wcConcept, zArgs, wc.wcSpan);
                            Ok(())
                        } else {
                            Err(typeErr(wc.wcSpan, "No instance of '" + wc.wcConcept + "' for (" + joinTypeListStr(zArgs) + ")"))
                        },
                }
            }
        }
    }

def dischargeSubConstraints(
    ctx: InferCtx,
    cs: List ConstraintSpec,
    sub: StrMap Type,
    sp: Span,
    given: List ConstraintSpec,
    residual: Cell (List WantedConstraint),
    depth: Int
): Result Void String = match cs {
    Nil -> Ok(()),
    Cons(c, r) -> {
        let subArgs = applyExplicitSubstList(c.typeArgs, sub);
        dischargeConstraint(ctx, MkWanted { wcConcept: c.conceptName, wcArgs: subArgs, wcSpan: sp }, given, residual, depth)?;
        dischargeSubConstraints(ctx, r, sub, sp, given, residual, depth)
    },
}

data SendStatus {
    SendYes,
    SendNo,
    SendUnknown,
}

def combineSendStatus(a: SendStatus, b: SendStatus): SendStatus = match (a, b) {
    (SendNo, _) -> SendNo,
    (_, SendNo) -> SendNo,
    (SendYes, SendYes) -> SendYes,
    _ -> SendUnknown,
}

def evalSendStatus(ctx: InferCtx, rawTy: Type, assumeSharedVarOpt: Option String, visiting: List String): SendStatus = {
    let ty = zonkType(ctx.subst, rawTy);
    match ty {
        TyVoid -> SendYes,
        TyVar(v) -> match assumeSharedVarOpt {
            Some(av) -> if (v == av) SendYes else SendUnknown,
            None -> SendUnknown,
        },
        TyArr(m0, _, _) -> {
            let m = zonkType(ctx.subst, m0);
            match m {
                TyCon(mn) ->
                    if (mn == "$Shared") SendYes
                    else if (mn == "$Local" || mn == "$Scoped") SendNo
                    else SendUnknown,
                TyVar(mv) -> match assumeSharedVarOpt {
                    Some(av) -> if (mv == av) SendYes else SendUnknown,
                    None -> SendUnknown,
                },
                _ -> SendUnknown,
            }
        },
        TyTuple(es) -> evalSendStatusList(ctx, es, assumeSharedVarOpt, visiting),
        TyCon(name) ->
            if (name == "Ptr" || name == "Cell" || name == "MutArray" || name == "ForeignPtr" || name == "ScopedPtr" || name == "Arena" || name == "$Local" || name == "$Scoped") SendNo
            else if (name == "Int" || name == "Int64" || name == "Float" || name == "Float32" || name == "Bool" || name == "Char" || name == "String" || name == "Void" || name == "AtomicInt" || name == "$Shared") SendYes
            else if (listContainsStr(visiting, name)) SendYes
            else match strMapGet(ctx.adtReg, name) {
                Some(ainfo) -> {
                    let emptySub: StrMap Type = strMapNew();
                    evalSendStatusVariants(ctx, ainfo.variants, emptySub, assumeSharedVarOpt, Cons(name, visiting))
                },
                None -> SendYes,
            },
        TyComp(_, _) -> {
            let key = mangleType(ty);
            if (listContainsStr(visiting, key)) SendYes
            else {
                let args = cellNew(Nil);
                let curr = cellNew(ty);
                let looping = cellNew(true);
                while (cellGet(looping)) {
                    match cellGet(curr) {
                        TyComp(b, a) -> { cellSet(args, Cons(a, cellGet(args))); cellSet(curr, b) },
                        _ -> cellSet(looping, false),
                    }
                };
                let targs = cellGet(args);
                match cellGet(curr) {
                    TyCon(baseName) ->
                        if (baseName == "Cell" || baseName == "MutArray") SendNo
                        else if (baseName == "Actor" || baseName == "Simd") SendYes
                        else if (baseName == "MVar" || baseName == "Chan" || baseName == "Task" || baseName == "ImmArray") {
                            evalSendStatusList(ctx, targs, assumeSharedVarOpt, Cons(key, visiting))
                        } else match strMapGet(ctx.adtReg, baseName) {
                            Some(ainfo) -> {
                                let sub = buildPairMap(ainfo.typeParams, targs);
                                evalSendStatusVariants(ctx, ainfo.variants, sub, assumeSharedVarOpt, Cons(key, visiting))
                            },
                            None -> SendNo,
                        },
                    _ -> SendUnknown,
                }
            }
        },
    }
}

def evalSendStatusList(ctx: InferCtx, ts: List Type, assumeSharedVarOpt: Option String, visiting: List String): SendStatus = match ts {
    Nil -> SendYes,
    Cons(h, r) -> {
        let sh = evalSendStatus(ctx, h, assumeSharedVarOpt, visiting);
        match sh {
            SendNo -> SendNo,
            _ -> combineSendStatus(sh, evalSendStatusList(ctx, r, assumeSharedVarOpt, visiting)),
        }
    },
}

def evalSendStatusVariants(ctx: InferCtx, vs: List VariantInfo, sub: StrMap Type, assumeSharedVarOpt: Option String, visiting: List String): SendStatus = match vs {
    Nil -> SendYes,
    Cons(v, r) -> {
        let ftys = fmap((ft) -> applyExplicitSubst(ft, sub), v.fieldTypes);
        let sv = evalSendStatusList(ctx, ftys, assumeSharedVarOpt, visiting);
        match sv {
            SendNo -> SendNo,
            _ -> combineSendStatus(sv, evalSendStatusVariants(ctx, r, sub, assumeSharedVarOpt, visiting)),
        }
    },
}

def dischargeSendIf(
    ctx: InferCtx,
    rawMode: Type,
    rawTarget: Type,
    sp: Span,
    given: List ConstraintSpec,
    residual: Cell (List WantedConstraint),
    depth: Int
): Result Void String =
    if (depth > 32) Ok(())
    else {
        let m = zonkType(ctx.subst, rawMode);
        let t = zonkType(ctx.subst, rawTarget);
        match m {
            TyCon(mn) ->
                if (mn == "$Local" || mn == "$Scoped") Ok(())
                else if (mn == "$Shared") dischargeSendConstraint(ctx, t, sp, given, residual, Nil, depth + 1)
                else Ok(()),
            _ -> {
                let assumeOpt = match m {
                    TyVar(mv) -> Some(mv),
                    _ -> None,
                };
                match evalSendStatus(ctx, t, assumeOpt, Nil) {
                    SendYes -> Ok(()),
                    SendNo -> unifyTypes(ctx.subst, m, TyCon("$Local"), sp),
                    SendUnknown -> {
                        if (!(hasGivenConstraint(ctx, given, "SendIf", [m, t]) || hasGivenConstraint(ctx, given, "Send", [t]))) {
                            pushResidualWanted(residual, "SendIf", [m, t], sp)
                        } else ();
                        Ok(())
                    },
                }
            },
        }
    }

def dischargeSendConstraint(
    ctx: InferCtx,
    rawTy: Type,
    sp: Span,
    given: List ConstraintSpec,
    residual: Cell (List WantedConstraint),
    visiting: List String,
    depth: Int
): Result Void String =
    if (depth > 32) Ok(())
    else {
        let ty = zonkType(ctx.subst, rawTy);
        match ty {
            TyVoid -> Ok(()),
            TyArr(m, _, _) -> unifyTypes(ctx.subst, m, TyCon("$Shared"), sp),
            TyVar(v) -> {
                if (!hasGivenConstraint(ctx, given, "Send", [TyVar(v)])) {
                    pushResidualWanted(residual, "Send", [TyVar(v)], sp)
                } else ();
                Ok(())
            },
            TyTuple(es) -> dischargeSendList(ctx, es, sp, given, residual, visiting, depth + 1),
            TyCon(name) ->
                if (name == "Ptr" || name == "Cell" || name == "MutArray" || name == "ForeignPtr" || name == "ScopedPtr" || name == "Arena" || name == "$Local" || name == "$Scoped") {
                    Err(typeErr(sp, "No instance of 'Send' for non-thread-safe type '" + name + "'"))
                } else if (name == "Int" || name == "Int64" || name == "Float" || name == "Float32" || name == "Bool" || name == "Char" || name == "String" || name == "Void" || name == "AtomicInt" || name == "$Shared") {
                    Ok(())
                } else if (listContainsStr(visiting, name)) {
                    Ok(())
                } else match strMapGet(ctx.adtReg, name) {
                    Some(ainfo) -> {
                        let emptySub: StrMap Type = strMapNew();
                        dischargeAdtFieldsSend(ctx, ainfo.variants, emptySub, sp, given, residual, Cons(name, visiting), depth + 1)
                    },
                    None -> Ok(()),
                },
            TyComp(_, _) -> {
                let key = mangleType(ty);
                if (listContainsStr(visiting, key)) Ok(())
                else {
                    let args = cellNew(Nil);
                    let curr = cellNew(ty);
                    let looping = cellNew(true);
                    while (cellGet(looping)) {
                        match cellGet(curr) {
                            TyComp(b, a) -> { cellSet(args, Cons(a, cellGet(args))); cellSet(curr, b) },
                            _ -> cellSet(looping, false),
                        }
                    };
                    let targs = cellGet(args);
                    match cellGet(curr) {
                        TyCon(baseName) ->
                            if (baseName == "Cell" || baseName == "MutArray") {
                                Err(typeErr(sp, "No instance of 'Send' for mutable container '" + typeToString(ty) + "'"))
                            } else if (baseName == "Actor" || baseName == "Simd") Ok(())
                            else if (baseName == "MVar" || baseName == "Chan" || baseName == "Task" || baseName == "ImmArray") {
                                dischargeSendList(ctx, targs, sp, given, residual, Cons(key, visiting), depth + 1)
                            } else match strMapGet(ctx.adtReg, baseName) {
                                Some(ainfo) -> {
                                    let sub = buildPairMap(ainfo.typeParams, targs);
                                    dischargeAdtFieldsSend(ctx, ainfo.variants, sub, sp, given, residual, Cons(key, visiting), depth + 1)
                                },
                                None -> Err(typeErr(sp, "No instance of 'Send' for '" + typeToString(ty) + "'")),
                            },
                        TyVar(_) -> {
                            if (!hasGivenConstraint(ctx, given, "Send", [ty])) {
                                pushResidualWanted(residual, "Send", [ty], sp)
                            } else ();
                            Ok(())
                        },
                        _ -> Err(typeErr(sp, "No instance of 'Send' for '" + typeToString(ty) + "'")),
                    }
                }
            },
        }
    }

def dischargeSendList(
    ctx: InferCtx,
    ts: List Type,
    sp: Span,
    given: List ConstraintSpec,
    residual: Cell (List WantedConstraint),
    visiting: List String,
    depth: Int
): Result Void String = match ts {
    Nil -> Ok(()),
    Cons(h, t) -> {
        dischargeSendConstraint(ctx, h, sp, given, residual, visiting, depth)?;
        dischargeSendList(ctx, t, sp, given, residual, visiting, depth)
    },
}

def dischargeAdtFieldsSend(
    ctx: InferCtx,
    vs: List VariantInfo,
    sub: StrMap Type,
    sp: Span,
    given: List ConstraintSpec,
    residual: Cell (List WantedConstraint),
    visiting: List String,
    depth: Int
): Result Void String = match vs {
    Nil -> Ok(()),
    Cons(v, rest) -> {
        let instFieldsRev = cellNew(Nil);
        let cur = cellNew(v.fieldTypes);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(ft, r) -> {
                    cellSet(instFieldsRev, Cons(applyExplicitSubst(ft, sub), cellGet(instFieldsRev)));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        dischargeSendList(ctx, listRev(cellGet(instFieldsRev)), sp, given, residual, visiting, depth)?;
        dischargeAdtFieldsSend(ctx, rest, sub, sp, given, residual, visiting, depth)
    },
}

// ============================================================================
// Pattern & Expression HM Inference
// ============================================================================

def listIndexStr(xs: List String, target: String, idx: Int): Option Int = match xs {
    Nil -> None,
    Cons(h, t) -> if (h == target) Some(idx) else listIndexStr(t, target, idx + 1),
}

def listNthType(ts: List Type, idx: Int): Type = match ts {
    Nil -> TyVoid,
    Cons(h, t) -> if (idx == 0) h else listNthType(t, idx - 1),
}

def inferPatternInner(
    ctx: InferCtx,
    pat: Pattern,
    seenVars: Cell (List String),
    sp: Span
): Result (Type, List (String, Scheme)) String = match pat {
    PatWild -> Ok((freshVar(ctx), Nil)),
    PatLit(l) -> Ok((litType(l), Nil)),
    PatVar(v, _) ->
        if (listContainsStr(cellGet(seenVars), v)) {
            Err(typeErr(sp, "Duplicate variable '" + v + "' in pattern"))
        } else {
            cellSet(seenVars, Cons(v, cellGet(seenVars)));
            let fv = freshVar(ctx);
            Ok((fv, [(v, ScmMono(fv))]))
        },
    PatTuple(ps) -> {
        let elemTys = cellNew(Nil);
        let binds = cellNew(Nil);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    let (t, b) = inferPatternInner(ctx, p, seenVars, sp)?;
                    cellSet(elemTys, listAppend(cellGet(elemTys), [t]));
                    cellSet(binds, listAppend(cellGet(binds), b));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        Ok((TyTuple(cellGet(elemTys)), cellGet(binds)))
    },
    PatCtor(cname, subPats) -> {
        match strMapGet(ctx.ctorToAdt, cname) {
            None -> Err(typeErr(sp, "Unknown constructor '" + cname + "' in pattern")),
            Some(adtName) -> match strMapGet(ctx.adtReg, adtName) {
                None -> Err(typeErr(sp, "Unknown ADT '" + adtName + "'")),
                Some(ainfo) -> {
                    let vOpt = findVariantByName(ainfo.variants, cname);
                    match vOpt {
                        None -> Err(typeErr(sp, "Unknown variant '" + cname + "'")),
                        Some(vinfo) -> {
                            let ctorTy = instantiateScheme(ctx, vinfo.ctorScm, sp);
                            match subPats {
                                Nil ->
                                    if (listLen(vinfo.fieldTypes) != 0) {
                                        Err(typeErr(sp, "Constructor '" + cname + "' expects arguments"))
                                    } else Ok((ctorTy, Nil)),
                                _ -> match ctorTy {
                                    TyArr(_, expectedTys, resTy) ->
                                        if (listLen(expectedTys) != listLen(subPats)) {
                                            Err(typeErr(sp, "Constructor '" + cname + "' arity mismatch"))
                                        } else {
                                            let binds = cellNew(Nil);
                                            let cp = cellNew(subPats);
                                            let ct = cellNew(expectedTys);
                                            while (match (cellGet(cp), cellGet(ct)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                                match (cellGet(cp), cellGet(ct)) {
                                                    (Cons(sp0, pr), Cons(et0, tr)) -> {
                                                        let (pt, pb) = inferPatternInner(ctx, sp0, seenVars, sp)?;
                                                        unifyTypes(ctx.subst, pt, et0, sp)?;
                                                        cellSet(binds, listAppend(cellGet(binds), pb));
                                                        cellSet(cp, pr);
                                                        cellSet(ct, tr)
                                                    },
                                                    _ -> (),
                                                }
                                            };
                                            Ok((resTy, cellGet(binds)))
                                        },
                                    _ -> Err(typeErr(sp, "Unit constructor '" + cname + "' takes no arguments")),
                                },
                            }
                        },
                    }
                },
            },
        }
    },
    PatStruct(cname, namedPats) -> {
        match strMapGet(ctx.ctorToAdt, cname) {
            None -> Err(typeErr(sp, "Unknown struct constructor '" + cname + "'")),
            Some(adtName) -> match strMapGet(ctx.adtReg, adtName) {
                None -> Err(typeErr(sp, "Unknown ADT '" + adtName + "'")),
                Some(ainfo) -> match findVariantByName(ainfo.variants, cname) {
                    None -> Err(typeErr(sp, "Unknown variant '" + cname + "'")),
                    Some(vinfo) -> match vinfo.fieldNames {
                        None -> Err(typeErr(sp, "Variant '" + cname + "' is not a struct variant")),
                        Some(declNames) -> {
                            let ctorTy = instantiateScheme(ctx, vinfo.ctorScm, sp);
                            match ctorTy {
                                TyArr(_, expectedTys, resTy) -> {
                                    let binds = cellNew(Nil);
                                    let cur = cellNew(namedPats);
                                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                                        match cellGet(cur) {
                                            Cons((fnm, fpat, _, _), r) -> {
                                                match listIndexStr(declNames, fnm, 0) {
                                                    None -> returnPatErr(sp, "Variant '" + cname + "' has no field '" + fnm + "'")?,
                                                    Some(idx) -> {
                                                        let (pt, pb) = inferPatternInner(ctx, fpat, seenVars, sp)?;
                                                        unifyTypes(ctx.subst, pt, listNthType(expectedTys, idx), sp)?;
                                                        cellSet(binds, listAppend(cellGet(binds), pb))
                                                    },
                                                };
                                                cellSet(cur, r)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    Ok((resTy, cellGet(binds)))
                                },
                                _ -> Err(typeErr(sp, "Variant '" + cname + "' has no fields")),
                            }
                        },
                    },
                },
            },
        }
    },
}

def returnPatErr(sp: Span, msg: String): Result Void String = Err(typeErr(sp, msg))

def checkCFnPtrCall(ctx: InferCtx, sp: Span, iargs: List Form): Result Void String =
    match iargs {
        Cons(argF, Nil) -> match argF.node {
            ExVar(_) -> {
                let zArg = zonkType(ctx.subst, schemeBody(argF.ty));
                match zArg {
                    TyArr(_, _, _) -> Ok(()),
                    _ -> Err(typeErr(argF.pos, "cFnPtr expects a top-level or extern function, got '" + typeToString(zArg) + "'")),
                }
            },
            _ -> Err(typeErr(argF.pos, "cFnPtr requires a direct top-level or extern function reference (closures are not allowed)")),
        },
        _ -> Err(typeErr(sp, "cFnPtr expects exactly 1 function argument")),
    }

pub def findVariantByName(vs: List VariantInfo, cname: String): Option VariantInfo = match vs {
    Nil -> None,
    Cons(v, r) -> if (v.vname == cname) Some(v) else findVariantByName(r, cname),
}

def collectEnvFtv(ctx: InferCtx, env: TypeEnv): List String = {
    let out = cellNew(Nil);
    let cur = cellNew(env.locals);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((_, scm), r) -> {
                let zscm = zonkScheme(ctx.subst, scm);
                let bound = schemeTypeParams(zscm);
                let fvs = ftvOrdered(schemeBody(zscm));
                let curF = cellNew(fvs);
                while (match cellGet(curF) { Nil -> false, _ -> true }) {
                    match cellGet(curF) {
                        Cons(fv, rf) -> {
                            if (!listContainsStr(bound, fv)) {
                                cellSet(out, addUniqueStr(cellGet(out), fv))
                            } else ();
                            cellSet(curF, rf)
                        },
                        Nil -> (),
                    }
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(out)
}

def addUniqueConstraint(cs: List ConstraintSpec, c: ConstraintSpec): List ConstraintSpec = {
    if (constraintListContains(cs, c.conceptName, c.typeArgs)) cs
    else listAppend(cs, [c])
}

def allVarsInList(vs: List String, allowed: List String): Bool = match vs {
    Nil -> true,
    Cons(v, r) -> listContainsStr(allowed, v) && allVarsInList(r, allowed),
}

def anyVarInList(vs: List String, allowed: List String): Bool = match vs {
    Nil -> false,
    Cons(v, r) -> listContainsStr(allowed, v) || anyVarInList(r, allowed),
}

def collectFtvsInTypeList(ts: List Type): List String = {
    let acc = cellNew(Nil);
    let cur = cellNew(ts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(t, r) -> {
                let cf = cellNew(ftvOrdered(t));
                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                    match cellGet(cf) {
                        Cons(v, rv) -> { cellSet(acc, addUniqueStr(cellGet(acc), v)); cellSet(cf, rv) },
                        Nil -> (),
                    }
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(acc)
}

def dischargeWantedPass(
    ctx: InferCtx,
    ws: List WantedConstraint,
    given: List ConstraintSpec
): Result (List WantedConstraint) String = {
    let residual: Cell (List WantedConstraint) = cellNew(Nil);
    let cur = cellNew(ws);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(wc, r) -> {
                dischargeConstraint(ctx, wc, given, residual, 0)?;
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    Ok(listRev(cellGet(residual)))
}

def hasUipVar(ty: Type): Bool = match ty {
    TyVoid -> false,
    TyCon(_) -> false,
    TyVar(v) -> strLen(v) >= 5 && strSlice(v, 0, 5) == ".uip_",
    TyArr(m, ps, r) -> hasUipVar(m) || hasUipVarList(ps) || hasUipVar(r),
    TyTuple(es) -> hasUipVarList(es),
    TyComp(b, a) -> hasUipVar(b) || hasUipVar(a),
}

def hasUipVarList(ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> if (hasUipVar(h)) true else hasUipVarList(t),
}

def hasAmbigUnifVar(fvs: List String, liveFtvs: List String): Bool = match fvs {
    Nil -> false,
    Cons(v, r) ->
        if (strLen(v) > 0 && strByteAt(v, 0) == 46 && !isModeVarName(v) && !listContainsStr(liveFtvs, v)) true
        else hasAmbigUnifVar(r, liveFtvs),
}

def tryUniqueInstanceImprove(
    ctx: InferCtx,
    ws: List WantedConstraint,
    given: List ConstraintSpec,
    liveFtvs: List String
): Result Bool String = match given {
    Cons(_, _) -> Ok(false),
    Nil -> {
        let improved = cellNew(false);
        let cur = cellNew(ws);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(rw, rest) -> {
                    if (rw.wcConcept != "Send" && rw.wcConcept != "SendIf" && rw.wcConcept != "NoScoped") {
                        let zArgs = zonkTypeList(ctx.subst, rw.wcArgs);
                        let fvs = collectFtvsInTypeList(zArgs);
                        if (hasNonVarInList(zArgs) && hasAmbigUnifVar(fvs, liveFtvs)) {
                            let matchCount = cellNew(0);
                            let bestTrial: Cell (Option (StrMap Type)) = cellNew(None);
                            let ci = cellNew(cellGet(ctx.instanceReg));
                            while (match cellGet(ci) { Nil -> false, _ -> cellGet(matchCount) <= 1 }) {
                                match cellGet(ci) {
                                    Cons(inst, ri) -> {
                                        if (inst.conceptName == rw.wcConcept && listLen(inst.targetTypes) == listLen(zArgs)) {
                                            let patMap: StrMap Type = strMapNew();
                                            let ctp = cellNew(inst.typeParams);
                                            while (match cellGet(ctp) { Nil -> false, _ -> true }) {
                                                match cellGet(ctp) {
                                                    Cons(tp, rtp) -> {
                                                        strMapInsert(patMap, tp, TyVar(".uip_" + tp));
                                                        cellSet(ctp, rtp)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            let patArgs = applyExplicitSubstList(inst.targetTypes, patMap);
                                            let trial: StrMap Type = strMapNew();
                                            match unifyTypeLists(trial, patArgs, zArgs, rw.wcSpan) {
                                                Ok(()) -> {
                                                    cellSet(matchCount, cellGet(matchCount) + 1);
                                                    cellSet(bestTrial, Some(trial))
                                                },
                                                Err(_) -> (),
                                            }
                                        } else ();
                                        cellSet(ci, ri)
                                    },
                                    Nil -> (),
                                }
                            };
                            if (cellGet(matchCount) == 1) {
                                match cellGet(bestTrial) {
                                    Some(trial) -> {
                                        let cf = cellNew(fvs);
                                        while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                            match cellGet(cf) {
                                                Cons(fv, rf) -> {
                                                    if (strLen(fv) > 0 && strByteAt(fv, 0) == 46 && !isModeVarName(fv)) {
                                                        let resolved = zonkType(trial, TyVar(fv));
                                                        if (!hasUipVar(resolved)) {
                                                            let curZ = zonkType(ctx.subst, TyVar(fv));
                                                            if (!typesEqual(curZ, resolved)) {
                                                                unifyTypes(ctx.subst, curZ, resolved, rw.wcSpan)?;
                                                                cellSet(improved, true)
                                                            } else ()
                                                        } else ()
                                                    } else ();
                                                    cellSet(cf, rf)
                                                },
                                                Nil -> (),
                                            }
                                        }
                                    },
                                    None -> (),
                                }
                            } else ()
                        } else ()
                    } else ();
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        };
        Ok(cellGet(improved))
    },
}

def dischargeWantedFixedPoint(
    ctx: InferCtx,
    wantedList: List WantedConstraint,
    given: List ConstraintSpec,
    liveFtvs: List String
): Result (List WantedConstraint) String = {
    let r1 = dischargeWantedPass(ctx, wantedList, given)?;
    let r2 = cellNew(dischargeWantedPass(ctx, r1, given)?);
    let uRound = cellNew(0);
    let uLoop = cellNew(true);
    while (cellGet(uLoop) && cellGet(uRound) < 4) {
        cellSet(uRound, cellGet(uRound) + 1);
        let didImprove = tryUniqueInstanceImprove(ctx, cellGet(r2), given, liveFtvs)?;
        if (didImprove) {
            let nextR = dischargeWantedPass(ctx, cellGet(r2), given)?;
            cellSet(r2, dischargeWantedPass(ctx, nextR, given)?)
        } else {
            cellSet(uLoop, false)
        }
    };
    let r2Final = cellGet(r2);
    // Any internal mode variable in `SendIf(m, t)` that does not escape into `liveFtvs`
    // belongs to a purely local closure call and safely defaults to `$Local`.
    let defaultedAny = cellNew(false);
    let cur = cellNew(r2Final);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(rw, rest) -> {
                if (rw.wcConcept == "SendIf") {
                    match rw.wcArgs {
                        Cons(mArg, _) -> match zonkType(ctx.subst, mArg) {
                            TyVar(mv) ->
                                if (isModeVarName(mv) && !listContainsStr(liveFtvs, mv)) {
                                    strMapInsert(ctx.subst, mv, TyCon("$Local"));
                                    cellSet(defaultedAny, true)
                                } else (),
                            _ -> (),
                        },
                        Nil -> (),
                    }
                } else ();
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    if (cellGet(defaultedAny)) dischargeWantedPass(ctx, r2Final, given)
    else Ok(r2Final)
}

def generalizeType(
    ctx: InferCtx,
    envFtvs: List String,
    rawTy: Type,
    wantedList: List WantedConstraint,
    given: List ConstraintSpec
): Result (Scheme, List WantedConstraint) String = {
    let ty0 = zonkType(ctx.subst, rawTy);
    let liveFtvs = listAppend(ftvOrdered(ty0), envFtvs);
    let remRes = dischargeWantedFixedPoint(ctx, wantedList, given, liveFtvs)?;
    let ty = zonkType(ctx.subst, ty0);

    let genVars = cellNew(Nil);
    let curFv = cellNew(ftvOrdered(ty));
    while (match cellGet(curFv) { Nil -> false, _ -> true }) {
        match cellGet(curFv) {
            Cons(fv, r) -> {
                if (!listContainsStr(envFtvs, fv)) {
                    cellSet(genVars, addUniqueStr(cellGet(genVars), fv))
                } else ();
                cellSet(curFv, r)
            },
            Nil -> (),
        }
    };

    // FunDep-closed generalization: any type variable on the RHS of a functional dependency
    // whose LHS free variables are already in `genVars` is uniquely determined (not ambiguous).
    let grewGen = cellNew(true);
    while (cellGet(grewGen)) {
        cellSet(grewGen, false);
        let cFd = cellNew(remRes);
        while (match cellGet(cFd) { Nil -> false, _ -> true }) {
            match cellGet(cFd) {
                Cons(rw, rr) -> {
                    match strMapGet(ctx.conceptReg, rw.wcConcept) {
                        Some(cinfo) -> {
                            let zArgs = zonkTypeList(ctx.subst, rw.wcArgs);
                            let cfds = cellNew(cinfo.fundeps);
                            while (match cellGet(cfds) { Nil -> false, _ -> true }) {
                                match cellGet(cfds) {
                                    Cons(fd, rfd) -> {
                                        let lhsFvs = collectFtvsInTypeList(selectTypesByNames(cinfo.typeParams, fd.fdLhs, zArgs));
                                        if (allVarsInList(lhsFvs, cellGet(genVars))) {
                                            let rhsFvs = collectFtvsInTypeList(selectTypesByNames(cinfo.typeParams, fd.fdRhs, zArgs));
                                            let crf = cellNew(rhsFvs);
                                            while (match cellGet(crf) { Nil -> false, _ -> true }) {
                                                match cellGet(crf) {
                                                    Cons(rv, rrv) -> {
                                                        if (!listContainsStr(envFtvs, rv) && !listContainsStr(cellGet(genVars), rv)) {
                                                            cellSet(genVars, addUniqueStr(cellGet(genVars), rv));
                                                            cellSet(grewGen, true)
                                                        } else ();
                                                        cellSet(crf, rrv)
                                                    },
                                                    Nil -> (),
                                                }
                                            }
                                        } else ();
                                        cellSet(cfds, rfd)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    };
                    cellSet(cFd, rr)
                },
                Nil -> (),
            }
        }
    };

    let gvs = cellGet(genVars);
    // Compute transitive closure of type variables reachable from `envFtvs` through residual constraints
    // (handles chained multi-parameter fundep constraints inside mutual recursion, e.g. `Add String .a .b` + `Add .b String String`).
    let outerFtvs = cellNew(envFtvs);
    let grewOuter = cellNew(true);
    while (cellGet(grewOuter)) {
        cellSet(grewOuter, false);
        let cScan = cellNew(remRes);
        while (match cellGet(cScan) { Nil -> false, _ -> true }) {
            match cellGet(cScan) {
                Cons(rw, r) -> {
                    let zArgs = zonkTypeList(ctx.subst, rw.wcArgs);
                    let fvs = collectFtvsInTypeList(zArgs);
                    if (anyVarInList(fvs, cellGet(outerFtvs))) {
                        let cf = cellNew(fvs);
                        while (match cellGet(cf) { Nil -> false, _ -> true }) {
                            match cellGet(cf) {
                                Cons(fv, rf) -> {
                                    if (!listContainsStr(cellGet(outerFtvs), fv)) {
                                        cellSet(outerFtvs, Cons(fv, cellGet(outerFtvs)));
                                        cellSet(grewOuter, true)
                                    } else ();
                                    cellSet(cf, rf)
                                },
                                Nil -> (),
                            }
                        }
                    } else ();
                    cellSet(cScan, r)
                },
                Nil -> (),
            }
        }
    };
    let reachableOuterFtvs = cellGet(outerFtvs);

    let localCs = cellNew(Nil);
    let outerWanted = cellNew(Nil);
    let curRes = cellNew(remRes);
    while (match cellGet(curRes) { Nil -> false, _ -> true }) {
        match cellGet(curRes) {
            Cons(rw, r) -> {
                let zArgs = zonkTypeList(ctx.subst, rw.wcArgs);
                let fvs = collectFtvsInTypeList(zArgs);
                let isQuantifiedSendIf =
                    if (rw.wcConcept == "SendIf") {
                        match zArgs {
                            Cons(TyVar(mv), _) -> listContainsStr(gvs, mv),
                            _ -> false,
                        }
                    } else false;
                match fvs {
                    Nil -> (),
                    _ ->
                        if (allVarsInList(fvs, gvs) || isQuantifiedSendIf) {
                            cellSet(localCs, addUniqueConstraint(cellGet(localCs), MkConstraint { conceptName: rw.wcConcept, typeArgs: zArgs }))
                        } else if (anyVarInList(fvs, reachableOuterFtvs)) {
                            cellSet(outerWanted, listAppend(cellGet(outerWanted), [MkWanted { wcConcept: rw.wcConcept, wcArgs: zArgs, wcSpan: rw.wcSpan }]))
                        } else {
                            returnPatErr(rw.wcSpan, "Ambiguous constraint '" + rw.wcConcept + "' for (" + joinTypeListStr(zArgs) + ")")?
                        },
                };
                cellSet(curRes, r)
            },
            Nil -> (),
        }
    };

    let scm = match gvs {
        Nil -> ScmMono(ty),
        _ -> match cellGet(localCs) {
            Nil -> ScmPoly(gvs, ty),
            lcs -> ScmPolyConstrained(gvs, lcs, ty),
        },
    };
    Ok((scm, cellGet(outerWanted)))
}

def inferForm(ctx: InferCtx, env: TypeEnv, f: Form): Result Form String = {
    let sp = f.pos;
    match f.node {
        ExLit(lit) -> Ok(MkForm { pos: sp, ty: ScmMono(litType(lit)), annot: f.annot, node: ExLit(lit) }),
        ExVar(name) -> match envLookup(env, name) {
            Some(scm) -> {
                let instTy = instantiateScheme(ctx, scm, sp);
                Ok(MkForm { pos: sp, ty: ScmMono(instTy), annot: f.annot, node: ExVar(name) })
            },
            None -> match pitfallNameHint(name) {
                Some(h) -> Err(typeErrHint(sp, "undefined name `" + name + "`", h)),
                None -> Err(typeErr(sp, "undefined name `" + name + "`")),
            },
        },
        ExTuple(elems) -> {
            let newElems = cellNew(Nil);
            let elemTys = cellNew(Nil);
            let cur = cellNew(elems);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(el, r) -> {
                        let iel = inferForm(ctx, env, el)?;
                        cellSet(newElems, listAppend(cellGet(newElems), [iel]));
                        cellSet(elemTys, listAppend(cellGet(elemTys), [schemeBody(iel.ty)]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            Ok(MkForm { pos: sp, ty: ScmMono(TyTuple(cellGet(elemTys))), annot: f.annot, node: ExTuple(cellGet(newElems)) })
        },
        ExList(elems) -> {
            let elemTy = freshVar(ctx);
            let newElems = cellNew(Nil);
            let cur = cellNew(elems);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(el, r) -> {
                        let iel = inferForm(ctx, env, el)?;
                        unifyTypes(ctx.subst, elemTy, schemeBody(iel.ty), iel.pos)?;
                        cellSet(newElems, listAppend(cellGet(newElems), [iel]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let listTy = TyComp(TyCon("List"), zonkType(ctx.subst, elemTy));
            Ok(MkForm { pos: sp, ty: ScmMono(listTy), annot: f.annot, node: ExList(cellGet(newElems)) })
        },
        ExStructInit(cname, fieldInits) -> match strMapGet(ctx.ctorToAdt, cname) {
            None -> Err(typeErr(sp, "Unknown struct constructor '" + cname + "'")),
            Some(adtName) -> match strMapGet(ctx.adtReg, adtName) {
                None -> Err(typeErr(sp, "Unknown ADT '" + adtName + "'")),
                Some(ainfo) -> match findVariantByName(ainfo.variants, cname) {
                    None -> Err(typeErr(sp, "Unknown variant '" + cname + "'")),
                    Some(vinfo) -> match vinfo.fieldNames {
                        None -> Err(typeErr(sp, "Variant '" + cname + "' is not a struct variant")),
                        Some(declNames) -> {
                            if (listLen(fieldInits) != listLen(declNames)) {
                                Err(typeErrHint(
                                    sp,
                                    "struct `" + cname + "` expects " + intToStr(listLen(declNames)) + " field(s), found " + intToStr(listLen(fieldInits)),
                                    "expected fields: " + strJoin(declNames, ", ")
                                ))
                            } else {
                                let ctorTy = instantiateScheme(ctx, vinfo.ctorScm, sp);
                                match ctorTy {
                                    TyArr(_, expectedTys, resTy) -> {
                                        let seen = cellNew(Nil);
                                        let newFs = cellNew(Nil);
                                        let cur = cellNew(fieldInits);
                                        while (match cellGet(cur) { Nil -> false, _ -> true }) {
                                            match cellGet(cur) {
                                                Cons((fnm, fexpr), r) -> {
                                                    if (listContainsStr(cellGet(seen), fnm)) {
                                                        returnPatErr(sp, "Duplicate field '" + fnm + "' in '" + cname + "'")?
                                                    } else cellSet(seen, Cons(fnm, cellGet(seen)));
                                                    match listIndexStr(declNames, fnm, 0) {
                                                        None -> returnPatErr(sp, "Variant '" + cname + "' has no field '" + fnm + "'")?,
                                                        Some(idx) -> {
                                                            let infVal = inferForm(ctx, env, fexpr)?;
                                                            unifyTypes(ctx.subst, listNthType(expectedTys, idx), schemeBody(infVal.ty), infVal.pos)?;
                                                            cellSet(newFs, listAppend(cellGet(newFs), [(fnm, infVal)]))
                                                        },
                                                    };
                                                    cellSet(cur, r)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        Ok(MkForm { pos: sp, ty: ScmMono(zonkType(ctx.subst, resTy)), annot: f.annot, node: ExStructInit(cname, cellGet(newFs)) })
                                    },
                                    _ -> Err(typeErr(sp, "Variant '" + cname + "' has no fields")),
                                }
                            }
                        },
                    },
                },
            },
        },
        ExAbs(params, retAnnOpt, body) -> {
            let newParams = cellNew(Nil);
            let paramTys = cellNew(Nil);
            let binds = cellNew(Nil);
            let paramNames = cellNew(Nil);
            let cur = cellNew(params);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(vd, r) -> {
                        let pscm = match vd.vscm {
                            ScmSlot -> ScmMono(freshVar(ctx)),
                            existing -> expandScheme(ctx, existing, sp)?,
                        };
                        cellSet(newParams, listAppend(cellGet(newParams), [MkVarDecl { vname: vd.vname, vscm: pscm }]));
                        cellSet(paramTys, listAppend(cellGet(paramTys), [schemeBody(pscm)]));
                        cellSet(binds, listAppend(cellGet(binds), [(vd.vname, pscm)]));
                        cellSet(paramNames, Cons(vd.vname, cellGet(paramNames)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let innerEnv = envExtendMany(env, cellGet(binds));
            let infBody = inferForm(ctx, innerEnv, body)?;
            let newRetAnn = match retAnnOpt {
                Some(rt) -> {
                    let ert = expandType(ctx, rt, sp)?;
                    unifyTypes(ctx.subst, ert, schemeBody(infBody.ty), infBody.pos)?;
                    Some(ert)
                },
                None -> None,
            };
            let modeVar = freshModeVar(ctx);
            if (closureCapturesScoped(ctx, env, infBody, cellGet(paramNames))) {
                unifyTypes(ctx.subst, modeVar, TyCon("$Scoped"), sp)?
            } else ();
            checkClosureCaptures(ctx, env, infBody, cellGet(paramNames), modeVar, sp)?;
            let fnTy = TyArr(
                zonkType(ctx.subst, modeVar),
                zonkTypeList(ctx.subst, cellGet(paramTys)),
                zonkType(ctx.subst, schemeBody(infBody.ty))
            );
            Ok(MkForm { pos: sp, ty: ScmMono(fnTy), annot: f.annot, node: ExAbs(cellGet(newParams), newRetAnn, infBody) })
        },
        ExApply(callee, args) -> {
            let ic = inferForm(ctx, env, callee)?;
            let iargs = cellNew(Nil);
            let argTys = cellNew(Nil);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ia = inferForm(ctx, env, a)?;
                        cellSet(iargs, listAppend(cellGet(iargs), [ia]));
                        cellSet(argTys, listAppend(cellGet(argTys), [schemeBody(ia.ty)]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let callMode = freshModeVar(ctx);
            let retVar = freshVar(ctx);
            let isExtCall = match ic.node {
                ExVar(fnNm) -> strMapContains(ctx.externSet, fnNm),
                _ -> false,
            };
            let unifyArgTys =
                if (isExtCall) {
                    match zonkType(ctx.subst, schemeBody(ic.ty)) {
                        TyArr(_, extPs, _) ->
                            if (listLen(extPs) == listLen(cellGet(argTys))) {
                                let outRev = cellNew(Nil);
                                let cp = cellNew(extPs);
                                let ca = cellNew(cellGet(argTys));
                                while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                    match (cellGet(cp), cellGet(ca)) {
                                        (Cons(ep, rp), Cons(at, ra)) -> {
                                            let zep = zonkType(ctx.subst, ep);
                                            let zat = zonkType(ctx.subst, at);
                                            let adj = match (zep, zat) {
                                                (TyCon("ScopedPtr"), TyCon("ForeignPtr")) -> TyCon("ScopedPtr"),
                                                _ -> at,
                                            };
                                            cellSet(outRev, Cons(adj, cellGet(outRev)));
                                            cellSet(cp, rp);
                                            cellSet(ca, ra)
                                        },
                                        _ -> (),
                                    }
                                };
                                listRev(cellGet(outRev))
                            } else cellGet(argTys),
                        _ -> cellGet(argTys),
                    }
                } else cellGet(argTys);
            match zonkType(ctx.subst, schemeBody(ic.ty)) {
                TyArr(fnMode, fnParamTys, fnRetTy) if (listLen(fnParamTys) == listLen(unifyArgTys)) -> {
                    unifyTypes(ctx.subst, fnMode, callMode, sp)?;
                    let cp = cellNew(fnParamTys);
                    let ca = cellNew(unifyArgTys);
                    let cf = cellNew(cellGet(iargs));
                    while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                        match (cellGet(cp), cellGet(ca), cellGet(cf)) {
                            (Cons(pt, rp), Cons(at, ra), Cons(af, rf)) -> {
                                unifyTypes(ctx.subst, pt, at, af.pos)?;
                                cellSet(cp, rp);
                                cellSet(ca, ra);
                                cellSet(cf, rf)
                            },
                            _ -> { cellSet(cp, Nil); cellSet(ca, Nil) },
                        }
                    };
                    unifyTypes(ctx.subst, fnRetTy, retVar, sp)?
                },
                _ -> unifyTypes(ctx.subst, schemeBody(ic.ty), TyArr(callMode, unifyArgTys, retVar), sp)?,
            };
            let resZ = zonkType(ctx.subst, retVar);
            let _ = match ic.node {
                ExVar(fnNm) if (fnNm == "cFnPtr") -> checkCFnPtrCall(ctx, sp, cellGet(iargs)),
                _ -> Ok(()),
            }?;
            match ic.node {
                ExVar(fnNm) -> {
                    if (fnNm == "withForeignPtr" || fnNm == "withStrPtr" || fnNm == "withAlloca" || fnNm == "withArena") {
                        cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "NoScoped", wcArgs: [resZ], wcSpan: sp }]))
                    } else if (fnNm == "cellNew") {
                        match cellGet(argTys) {
                            Cons(et, _) -> cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "NoScoped", wcArgs: [et], wcSpan: sp }])),
                            _ -> (),
                        }
                    } else if (fnNm == "cellSet" || fnNm == "arrayNew") {
                        match cellGet(argTys) {
                            Cons(_, Cons(et, _)) -> cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "NoScoped", wcArgs: [et], wcSpan: sp }])),
                            _ -> (),
                        }
                    } else if (fnNm == "arrayNewZeroed") {
                        match resZ {
                            TyComp(_, et) -> cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "NoScoped", wcArgs: [et], wcSpan: sp }])),
                            _ -> (),
                        }
                    } else if (fnNm == "arraySet") {
                        match cellGet(argTys) {
                            Cons(_, Cons(_, Cons(et, _))) -> cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "NoScoped", wcArgs: [et], wcSpan: sp }])),
                            _ -> (),
                        }
                    } else ()
                },
                _ -> (),
            };
            Ok(MkForm { pos: sp, ty: ScmMono(resZ), annot: f.annot, node: ExApply(ic, cellGet(iargs)) })
        },
        ExBin(op, left, right) -> {
            let il = inferForm(ctx, env, left)?;
            let ir = inferForm(ctx, env, right)?;
            let tl = schemeBody(il.ty);
            let tr = schemeBody(ir.ty);
            let resTy = match op {
                OpAnd -> {
                    unifyTypes(ctx.subst, tl, TyCon("Bool"), il.pos)?;
                    unifyTypes(ctx.subst, tr, TyCon("Bool"), ir.pos)?;
                    TyCon("Bool")
                },
                OpOr -> {
                    unifyTypes(ctx.subst, tl, TyCon("Bool"), il.pos)?;
                    unifyTypes(ctx.subst, tr, TyCon("Bool"), ir.pos)?;
                    TyCon("Bool")
                },
                OpEq -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Eq", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    TyCon("Bool")
                },
                OpNe -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Eq", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    TyCon("Bool")
                },
                OpLt -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Ord", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    TyCon("Bool")
                },
                OpLe -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Ord", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    TyCon("Bool")
                },
                OpGt -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Ord", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    TyCon("Bool")
                },
                OpGe -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Ord", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    TyCon("Bool")
                },
                OpShl -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Shl", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, TyCon("Int"), ir.pos)?;
                    zonkType(ctx.subst, a)
                },
                OpShr -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Shr", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, TyCon("Int"), ir.pos)?;
                    zonkType(ctx.subst, a)
                },
                OpUshr -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Ushr", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, TyCon("Int"), ir.pos)?;
                    zonkType(ctx.subst, a)
                },
                OpAdd -> {
                    let a = freshVar(ctx);
                    let b = freshVar(ctx);
                    let c = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Add", wcArgs: [a, b, c], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, b, ir.pos)?;
                    let _ = applyFunDeps(ctx, "Add", [a, b, c], Nil, sp)?;
                    zonkType(ctx.subst, c)
                },
                OpSub -> {
                    let a = freshVar(ctx);
                    let b = freshVar(ctx);
                    let c = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Sub", wcArgs: [a, b, c], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, b, ir.pos)?;
                    let _ = applyFunDeps(ctx, "Sub", [a, b, c], Nil, sp)?;
                    zonkType(ctx.subst, c)
                },
                OpMul -> {
                    let a = freshVar(ctx);
                    let b = freshVar(ctx);
                    let c = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Mul", wcArgs: [a, b, c], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, b, ir.pos)?;
                    let _ = applyFunDeps(ctx, "Mul", [a, b, c], Nil, sp)?;
                    zonkType(ctx.subst, c)
                },
                OpDiv -> {
                    let a = freshVar(ctx);
                    let b = freshVar(ctx);
                    let c = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Div", wcArgs: [a, b, c], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, b, ir.pos)?;
                    let _ = applyFunDeps(ctx, "Div", [a, b, c], Nil, sp)?;
                    zonkType(ctx.subst, c)
                },
                _ -> {
                    let cname = match op {
                        OpRem -> "Rem",
                        OpBitAnd -> "BitAnd",
                        OpBitOr -> "BitOr",
                        OpBitXor -> "BitXor",
                        _ -> "Rem",
                    };
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: cname, wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, tl, a, il.pos)?;
                    unifyTypes(ctx.subst, tr, a, ir.pos)?;
                    zonkType(ctx.subst, a)
                },
            };
            Ok(MkForm { pos: sp, ty: ScmMono(resTy), annot: f.annot, node: ExBin(op, il, ir) })
        },
        ExUn(op, operand) -> {
            let io = inferForm(ctx, env, operand)?;
            let to = schemeBody(io.ty);
            let resTy = match op {
                UnNot -> {
                    unifyTypes(ctx.subst, to, TyCon("Bool"), io.pos)?;
                    TyCon("Bool")
                },
                UnNeg -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "Neg", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, to, a, io.pos)?;
                    zonkType(ctx.subst, a)
                },
                UnBitNot -> {
                    let a = freshVar(ctx);
                    cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [MkWanted { wcConcept: "BitNot", wcArgs: [a], wcSpan: sp }]));
                    unifyTypes(ctx.subst, to, a, io.pos)?;
                    zonkType(ctx.subst, a)
                },
            };
            Ok(MkForm { pos: sp, ty: ScmMono(resTy), annot: f.annot, node: ExUn(op, io) })
        },
        ExField(base, fieldName) -> {
            let ib0 = inferForm(ctx, env, base)?;
            let ib = zonkForm(ctx.subst, ib0);
            let resolvedBase = zonkType(ctx.subst, schemeBody(ib.ty));
            match decomposeAdtType(ctx.adtReg, resolvedBase) {
                Some((adtName, typeArgs)) -> match strMapGet(ctx.adtReg, adtName) {
                    None -> Err(typeErr(sp, "Unknown struct type '" + adtName + "'")),
                    Some(ainfo) ->
                        if (listLen(ainfo.variants) != 1) {
                            Err(typeErr(sp, "Dot field access '." + fieldName + "' requires a single-variant struct, got '" + adtName + "'"))
                        } else match ainfo.variants {
                            Cons(vinfo, _) -> match vinfo.fieldNames {
                                None -> Err(typeErr(sp, "Type '" + adtName + "' is not a struct variant")),
                                Some(declNames) -> match listIndexStr(declNames, fieldName, 0) {
                                    None -> Err(typeErrHint(sp, "struct `" + adtName + "` has no field `" + fieldName + "`", "available fields: " + strJoin(declNames, ", "))),
                                    Some(idx) -> {
                                        let sub = buildPairMap(ainfo.typeParams, typeArgs);
                                        let fty = zonkType(ctx.subst, applyExplicitSubst(listNthType(vinfo.fieldTypes, idx), sub));
                                        Ok(MkForm { pos: sp, ty: ScmMono(fty), annot: f.annot, node: ExField(ib, fieldName) })
                                    },
                                },
                            },
                            Nil -> Err(typeErr(sp, "Empty ADT '" + adtName + "'")),
                        },
                },
                None -> match resolvedBase {
                    TyVar(_) -> {
                        // Unique single-variant struct field inference
                        let matches: Cell (List (AdtInfo, VariantInfo, Int)) = cellNew(Nil);
                        let k = cellNew(0);
                        while (cellGet(k) < vecLen(ctx.adtNames)) {
                            let anm = vecGetOr(ctx.adtNames, cellGet(k), "");
                            match strMapGet(ctx.adtReg, anm) {
                                Some(ai) ->
                                    if (listLen(ai.variants) == 1) {
                                        match ai.variants {
                                            Cons(vi, _) -> match vi.fieldNames {
                                                Some(fns) -> match listIndexStr(fns, fieldName, 0) {
                                                    Some(idx) -> cellSet(matches, listAppend(cellGet(matches), [(ai, vi, idx)])),
                                                    None -> (),
                                                },
                                                None -> (),
                                            },
                                            Nil -> (),
                                        }
                                    } else (),
                                None -> (),
                            };
                            cellSet(k, cellGet(k) + 1)
                        };
                        match cellGet(matches) {
                            Cons((ai, vi, idx), Nil) -> {
                                let freshArgs = cellNew(Nil);
                                let curP = cellNew(ai.typeParams);
                                while (match cellGet(curP) { Nil -> false, _ -> true }) {
                                    match cellGet(curP) {
                                        Cons(tp, r) -> {
                                            let fv = if (isModeVarName(tp)) freshModeVar(ctx) else freshVar(ctx);
                                            cellSet(freshArgs, listAppend(cellGet(freshArgs), [fv]));
                                            cellSet(curP, r)
                                        },
                                        Nil -> (),
                                    }
                                };
                                let fargs = cellGet(freshArgs);
                                let targetAdt = composeTypes(Cons(TyCon(ai.adtName), fargs));
                                unifyTypes(ctx.subst, resolvedBase, targetAdt, ib.pos)?;
                                let sub = buildPairMap(ai.typeParams, fargs);
                                let fty = zonkType(ctx.subst, applyExplicitSubst(listNthType(vi.fieldTypes, idx), sub));
                                let ibZonked = zonkForm(ctx.subst, ib);
                                Ok(MkForm { pos: sp, ty: ScmMono(fty), annot: f.annot, node: ExField(ibZonked, fieldName) })
                            },
                            _ -> Err(typeErr(sp, "Cannot infer struct type for field '." + fieldName + "'; add a type annotation")),
                        }
                    },
                    _ -> Err(typeErr(sp, "Cannot access field '." + fieldName + "' on non-struct type '" + typeToString(resolvedBase) + "'")),
                },
            }
        },
        ExLet(vd, val, body) -> {
            let expandedVarScm = match vd.vscm {
                ScmSlot -> ScmSlot,
                s -> expandScheme(ctx, s, sp)?,
            };
            let placeholderTy = match expandedVarScm {
                ScmSlot -> freshVar(ctx),
                s -> instantiateScheme(ctx, s, sp),
            };
            match val.node {
                ExAbs(_, _, _) -> {
                    let savedWanted = cellGet(ctx.wanted);
                    cellSet(ctx.wanted, Nil);
                    let recEnv = envExtend(env, vd.vname, ScmMono(placeholderTy));
                    let infVal0 = inferForm(ctx, recEnv, val)?;
                    unifyTypes(ctx.subst, placeholderTy, schemeBody(infVal0.ty), infVal0.pos)?;
                    let infVal = zonkForm(ctx.subst, infVal0);
                    let envFtvs = collectEnvFtv(ctx, env);
                    let valWanted = cellGet(ctx.wanted);
                    let (genScm, remWanted) = generalizeType(ctx, envFtvs, placeholderTy, valWanted, Nil)?;
                    cellSet(ctx.wanted, listAppend(savedWanted, remWanted));
                    let infValTyped = MkForm { pos: infVal.pos, ty: genScm, annot: infVal.annot, node: infVal.node };
                    let bodyEnv = envExtend(env, vd.vname, genScm);
                    let infBody = inferForm(ctx, bodyEnv, body)?;
                    Ok(MkForm {
                        pos: sp,
                        ty: infBody.ty,
                        annot: f.annot,
                        node: ExLet(MkVarDecl { vname: vd.vname, vscm: genScm }, infValTyped, infBody),
                    })
                },
                _ -> {
                    let infVal0 = inferForm(ctx, env, val)?;
                    unifyTypes(ctx.subst, placeholderTy, schemeBody(infVal0.ty), infVal0.pos)?;
                    let monoTy = zonkType(ctx.subst, placeholderTy);
                    let monoScm = ScmMono(monoTy);
                    let infVal = zonkForm(ctx.subst, infVal0);
                    let bodyEnv = envExtend(env, vd.vname, monoScm);
                    let infBody = inferForm(ctx, bodyEnv, body)?;
                    Ok(MkForm {
                        pos: sp,
                        ty: infBody.ty,
                        annot: f.annot,
                        node: ExLet(MkVarDecl { vname: vd.vname, vscm: monoScm }, infVal, infBody),
                    })
                },
            }
        },
        ExIf(cond, thenE, elseE) -> {
            let ic = inferForm(ctx, env, cond)?;
            let it = inferForm(ctx, env, thenE)?;
            let ie = inferForm(ctx, env, elseE)?;
            unifyTypes(ctx.subst, TyCon("Bool"), schemeBody(ic.ty), ic.pos)?;
            unifyTypes(ctx.subst, schemeBody(it.ty), schemeBody(ie.ty), ie.pos)?;
            Ok(MkForm { pos: sp, ty: ScmMono(zonkType(ctx.subst, schemeBody(it.ty))), annot: f.annot, node: ExIf(ic, it, ie) })
        },
        ExWhile(cond, body) -> {
            let ic = inferForm(ctx, env, cond)?;
            let ib = inferForm(ctx, env, body)?;
            unifyTypes(ctx.subst, TyCon("Bool"), schemeBody(ic.ty), ic.pos)?;
            unifyTypes(ctx.subst, TyVoid, schemeBody(ib.ty), ib.pos)?;
            Ok(MkForm { pos: sp, ty: ScmMono(TyVoid), annot: f.annot, node: ExWhile(ic, ib) })
        },
        ExContract(fc, body) -> {
            let infReqsRev: Cell (List (Span, Form)) = cellNew(Nil);
            let cr = cellNew(fc.fcRequires);
            while (match cellGet(cr) { Nil -> false, _ -> true }) {
                match cellGet(cr) {
                    Cons((csp, ce), r) -> {
                        let ie = inferForm(ctx, env, ce)?;
                        unifyTypes(ctx.subst, TyCon("Bool"), schemeBody(ie.ty), ie.pos)?;
                        cellSet(infReqsRev, Cons((csp, ie), cellGet(infReqsRev)));
                        cellSet(cr, r)
                    },
                    Nil -> (),
                }
            };
            let infDecsRev: Cell (List (Span, Form)) = cellNew(Nil);
            let cd = cellNew(fc.fcDecreases);
            while (match cellGet(cd) { Nil -> false, _ -> true }) {
                match cellGet(cd) {
                    Cons((csp, ce), r) -> {
                        let ie = inferForm(ctx, env, ce)?;
                        unifyTypes(ctx.subst, TyCon("Int"), schemeBody(ie.ty), ie.pos)?;
                        cellSet(infDecsRev, Cons((csp, ie), cellGet(infDecsRev)));
                        cellSet(cd, r)
                    },
                    Nil -> (),
                }
            };
            let infBody = inferForm(ctx, env, body)?;
            let retTy = zonkType(ctx.subst, schemeBody(infBody.ty));
            let infEnsRev: Cell (List EnsuresClause) = cellNew(Nil);
            let ce = cellNew(fc.fcEnsures);
            while (match cellGet(ce) { Nil -> false, _ -> true }) {
                match cellGet(ce) {
                    Cons(ec, r) -> {
                        let ensEnv = match ec.ecBind {
                            Some(bname) -> envExtend(env, bname, ScmMono(retTy)),
                            None -> env,
                        };
                        let ie = inferForm(ctx, ensEnv, ec.ecExpr)?;
                        unifyTypes(ctx.subst, TyCon("Bool"), schemeBody(ie.ty), ie.pos)?;
                        cellSet(infEnsRev, Cons(MkEnsuresClause { ecBind: ec.ecBind, ecSpan: ec.ecSpan, ecExpr: ie }, cellGet(infEnsRev)));
                        cellSet(ce, r)
                    },
                    Nil -> (),
                }
            };
            let infFc = MkFnContract {
                fcRequires: listRev(cellGet(infReqsRev)),
                fcEnsures: listRev(cellGet(infEnsRev)),
                fcDecreases: listRev(cellGet(infDecsRev)),
            };
            Ok(MkForm { pos: sp, ty: infBody.ty, annot: f.annot, node: ExContract(infFc, infBody) })
        },
        ExLoopContract(invs, decs, body) -> {
            let infInvsRev: Cell (List (Span, Form)) = cellNew(Nil);
            let ci = cellNew(invs);
            while (match cellGet(ci) { Nil -> false, _ -> true }) {
                match cellGet(ci) {
                    Cons((csp, ce), r) -> {
                        let ie = inferForm(ctx, env, ce)?;
                        unifyTypes(ctx.subst, TyCon("Bool"), schemeBody(ie.ty), ie.pos)?;
                        cellSet(infInvsRev, Cons((csp, ie), cellGet(infInvsRev)));
                        cellSet(ci, r)
                    },
                    Nil -> (),
                }
            };
            let infDecsRev: Cell (List (Span, Form)) = cellNew(Nil);
            let cd = cellNew(decs);
            while (match cellGet(cd) { Nil -> false, _ -> true }) {
                match cellGet(cd) {
                    Cons((csp, ce), r) -> {
                        let ie = inferForm(ctx, env, ce)?;
                        unifyTypes(ctx.subst, TyCon("Int"), schemeBody(ie.ty), ie.pos)?;
                        cellSet(infDecsRev, Cons((csp, ie), cellGet(infDecsRev)));
                        cellSet(cd, r)
                    },
                    Nil -> (),
                }
            };
            let infBody = inferForm(ctx, env, body)?;
            Ok(MkForm { pos: sp, ty: infBody.ty, annot: f.annot, node: ExLoopContract(listRev(cellGet(infInvsRev)), listRev(cellGet(infDecsRev)), infBody) })
        },
        ExBlock(items) -> {
            let total = listLen(items);
            let idx = cellNew(0);
            let newItems = cellNew(Nil);
            let lastTy = cellNew(TyVoid);
            let cur = cellNew(items);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(it, r) -> {
                        let i = cellGet(idx);
                        let infIt = inferForm(ctx, env, it)?;
                        if (i + 1 < total) {
                            unifyTypes(ctx.subst, TyVoid, schemeBody(infIt.ty), infIt.pos)?
                        } else {
                            cellSet(lastTy, zonkType(ctx.subst, schemeBody(infIt.ty)))
                        };
                        cellSet(newItems, listAppend(cellGet(newItems), [infIt]));
                        cellSet(idx, i + 1);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            Ok(MkForm { pos: sp, ty: ScmMono(cellGet(lastTy)), annot: f.annot, node: ExBlock(cellGet(newItems)) })
        },
        ExMatch(scrut, arms) -> {
            let is = inferForm(ctx, env, scrut)?;
            let scrutTy = schemeBody(is.ty);
            let resTy = freshVar(ctx);
            let newArms = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arm, r) -> {
                        let seenVars = cellNew(Nil);
                        let (patTy, patBinds) = inferPatternInner(ctx, arm.pat, seenVars, sp)?;
                        unifyTypes(ctx.subst, scrutTy, patTy, sp)?;
                        let armEnv = envExtendMany(env, patBinds);
                        let ng = match arm.guard {
                            Some(g) -> {
                                let ig = inferForm(ctx, armEnv, g)?;
                                unifyTypes(ctx.subst, schemeBody(ig.ty), TyCon("Bool"), ig.pos)?;
                                Some(ig)
                            },
                            None -> None,
                        };
                        let ib = inferForm(ctx, armEnv, arm.body)?;
                        unifyTypes(ctx.subst, resTy, schemeBody(ib.ty), ib.pos)?;
                        cellSet(newArms, listAppend(cellGet(newArms), [MkMatchArm { pat: arm.pat, guard: ng, body: ib }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            Ok(MkForm { pos: sp, ty: ScmMono(zonkType(ctx.subst, resTy)), annot: f.annot, node: ExMatch(is, cellGet(newArms)) })
        },
        ExTry(_) -> Err(typeErr(sp, "'?' operator is only valid inside a Result-returning expression")),
    }
}

def hasEnvLocal(locals: List (String, Scheme), name: String): Bool = match locals {
    Nil -> false,
    Cons((k, _), r) -> if (k == name) true else hasEnvLocal(r, name),
}

def extendBoundWithVarDecls(ps: List VarDecl, bound: List String): List String = match ps {
    Nil -> bound,
    Cons(vd, r) -> extendBoundWithVarDecls(r, Cons(vd.vname, bound)),
}

def extendBoundWithPattern(pat: Pattern, bound: List String): List String = match pat {
    PatWild -> bound,
    PatLit(_) -> bound,
    PatVar(v, _) -> Cons(v, bound),
    PatTuple(ps) -> extendBoundWithPatList(ps, bound),
    PatCtor(_, ps) -> extendBoundWithPatList(ps, bound),
    PatStruct(_, fs) -> extendBoundWithNamedPats(fs, bound),
}

def extendBoundWithPatList(ps: List Pattern, bound: List String): List String = match ps {
    Nil -> bound,
    Cons(p, r) -> extendBoundWithPatList(r, extendBoundWithPattern(p, bound)),
}

def extendBoundWithNamedPats(fs: List (String, Pattern, Span, Bool), bound: List String): List String = match fs {
    Nil -> bound,
    Cons((_, p, _, _), r) -> extendBoundWithNamedPats(r, extendBoundWithPattern(p, bound)),
}

def typeContainsScopedList(adtReg: StrMap AdtInfo, subst: StrMap Type, ts: List Type, visiting: List String): Bool = match ts {
    Nil -> false,
    Cons(h, r) ->
        if (typeContainsScoped(adtReg, subst, h, visiting)) true
        else typeContainsScopedList(adtReg, subst, r, visiting),
}

def typeContainsScopedVariants(adtReg: StrMap AdtInfo, subst: StrMap Type, vs: List VariantInfo, sub: StrMap Type, visiting: List String): Bool = match vs {
    Nil -> false,
    Cons(v, rv) -> {
        let curF = cellNew(v.fieldTypes);
        let hit = cellNew(false);
        while (match cellGet(curF) { Nil -> false, _ -> !cellGet(hit) }) {
            match cellGet(curF) {
                Cons(ft, rF) -> {
                    let instFt = applyExplicitSubst(ft, sub);
                    if (typeContainsScoped(adtReg, subst, instFt, visiting)) cellSet(hit, true) else ();
                    cellSet(curF, rF)
                },
                Nil -> (),
            }
        };
        if (cellGet(hit)) true else typeContainsScopedVariants(adtReg, subst, rv, sub, visiting)
    },
}

def typeContainsScoped(adtReg: StrMap AdtInfo, subst: StrMap Type, rawTy: Type, visiting: List String): Bool = {
    let ty = zonkType(subst, rawTy);
    match ty {
        TyVoid -> false,
        TyVar(_) -> false,
        TyArr(m, _, _) -> match zonkType(subst, m) {
            TyCon(mn) -> mn == "$Scoped",
            _ -> false,
        },
        TyTuple(es) -> typeContainsScopedList(adtReg, subst, es, visiting),
        TyCon(name) ->
            if (name == "ScopedPtr" || name == "Arena" || name == "$Scoped") true
            else if (listContainsStr(visiting, name)) false
            else match strMapGet(adtReg, name) {
                Some(ainfo) -> {
                    let emptySub: StrMap Type = strMapNew();
                    typeContainsScopedVariants(adtReg, subst, ainfo.variants, emptySub, Cons(name, visiting))
                },
                None -> false,
            },
        TyComp(_, _) -> {
            let key = mangleType(ty);
            if (listContainsStr(visiting, key)) false
            else {
                let args = cellNew(Nil);
                let curr = cellNew(ty);
                let looping = cellNew(true);
                while (cellGet(looping)) {
                    match cellGet(curr) {
                        TyComp(b, a) -> { cellSet(args, Cons(a, cellGet(args))); cellSet(curr, b) },
                        _ -> cellSet(looping, false),
                    }
                };
                let targs = cellGet(args);
                if (typeContainsScopedList(adtReg, subst, targs, Cons(key, visiting))) true
                else match cellGet(curr) {
                    TyCon(baseName) ->
                        if (baseName == "Simd") false
                        else match strMapGet(adtReg, baseName) {
                            Some(ainfo) -> {
                                let sub = buildPairMap(ainfo.typeParams, targs);
                                typeContainsScopedVariants(adtReg, subst, ainfo.variants, sub, Cons(key, visiting))
                            },
                            None -> false,
                        },
                    _ -> false,
                }
            }
        },
    }
}

def closureCapturesScopedList(ctx: InferCtx, env: TypeEnv, fs: List Form, boundNames: List String): Bool = match fs {
    Nil -> false,
    Cons(h, r) ->
        if (closureCapturesScoped(ctx, env, h, boundNames)) true
        else closureCapturesScopedList(ctx, env, r, boundNames),
}

def closureCapturesScopedNamed(ctx: InferCtx, env: TypeEnv, fs: List (String, Form), boundNames: List String): Bool = match fs {
    Nil -> false,
    Cons((_, h), r) ->
        if (closureCapturesScoped(ctx, env, h, boundNames)) true
        else closureCapturesScopedNamed(ctx, env, r, boundNames),
}

def closureCapturesScopedArms(ctx: InferCtx, env: TypeEnv, arms: List MatchArm, boundNames: List String): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let nb = extendBoundWithPattern(a.pat, boundNames);
        let gHit = match a.guard {
            Some(g) -> closureCapturesScoped(ctx, env, g, nb),
            None -> false,
        };
        if (gHit || closureCapturesScoped(ctx, env, a.body, nb)) true
        else closureCapturesScopedArms(ctx, env, r, boundNames)
    },
}

def closureCapturesScoped(ctx: InferCtx, env: TypeEnv, f: Form, boundNames: List String): Bool = match f.node {
    ExLit(_) -> false,
    ExVar(vname) ->
        if (listContainsStr(boundNames, vname)) false
        else if (hasEnvLocal(env.locals, vname) || strMapContains(ctx.globalValSet, vname)) {
            typeContainsScoped(ctx.adtReg, ctx.subst, schemeBody(f.ty), Nil)
        } else false,
    ExTuple(es) -> closureCapturesScopedList(ctx, env, es, boundNames),
    ExList(es) -> closureCapturesScopedList(ctx, env, es, boundNames),
    ExBlock(es) -> closureCapturesScopedList(ctx, env, es, boundNames),
    ExStructInit(_, fs) -> closureCapturesScopedNamed(ctx, env, fs, boundNames),
    ExApply(c, args) ->
        closureCapturesScoped(ctx, env, c, boundNames) || closureCapturesScopedList(ctx, env, args, boundNames),
    ExAbs(ps2, _, b2) ->
        closureCapturesScoped(ctx, env, b2, extendBoundWithVarDecls(ps2, boundNames)),
    ExBin(_, l, r) ->
        closureCapturesScoped(ctx, env, l, boundNames) || closureCapturesScoped(ctx, env, r, boundNames),
    ExUn(_, e) -> closureCapturesScoped(ctx, env, e, boundNames),
    ExField(e, _) -> closureCapturesScoped(ctx, env, e, boundNames),
    ExTry(e) -> closureCapturesScoped(ctx, env, e, boundNames),
    ExIf(c, t, e) ->
        closureCapturesScoped(ctx, env, c, boundNames)
        || closureCapturesScoped(ctx, env, t, boundNames)
        || closureCapturesScoped(ctx, env, e, boundNames),
    ExWhile(c, b) ->
        closureCapturesScoped(ctx, env, c, boundNames) || closureCapturesScoped(ctx, env, b, boundNames),
    ExContract(_, b) -> closureCapturesScoped(ctx, env, b, boundNames),
    ExLoopContract(_, _, b) -> closureCapturesScoped(ctx, env, b, boundNames),
    ExLet(vd, val, body) ->
        closureCapturesScoped(ctx, env, val, boundNames)
        || closureCapturesScoped(ctx, env, body, Cons(vd.vname, boundNames)),
    ExMatch(s, arms) ->
        closureCapturesScoped(ctx, env, s, boundNames) || closureCapturesScopedArms(ctx, env, arms, boundNames),
}

def checkClosureCaptures(
    ctx: InferCtx,
    env: TypeEnv,
    f: Form,
    boundNames: List String,
    modeVar: Type,
    lamSpan: Span
): Result Void String = match f.node {
    ExLit(_) -> Ok(()),
    ExVar(vname) ->
        if (listContainsStr(boundNames, vname)) Ok(())
        else if (strMapContains(ctx.taintedTopSet, vname)) {
            unifyTypes(ctx.subst, modeVar, TyCon("$Local"), lamSpan)
        } else if (hasEnvLocal(env.locals, vname) || strMapContains(ctx.globalValSet, vname)) {
            let vty = zonkType(ctx.subst, schemeBody(f.ty));
            let resTmp: Cell (List WantedConstraint) = cellNew(Nil);
            dischargeSendIf(ctx, modeVar, vty, lamSpan, Nil, resTmp, 0)?;
            let cur = cellNew(cellGet(resTmp));
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(w, r) -> {
                        cellSet(ctx.wanted, listAppend(cellGet(ctx.wanted), [w]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            Ok(())
        } else Ok(()),
    ExTuple(es) -> checkClosureCapturesList(ctx, env, es, boundNames, modeVar, lamSpan),
    ExList(es) -> checkClosureCapturesList(ctx, env, es, boundNames, modeVar, lamSpan),
    ExBlock(es) -> checkClosureCapturesList(ctx, env, es, boundNames, modeVar, lamSpan),
    ExStructInit(_, fs) -> checkClosureCapturesNamed(ctx, env, fs, boundNames, modeVar, lamSpan),
    ExApply(c, args) -> {
        checkClosureCaptures(ctx, env, c, boundNames, modeVar, lamSpan)?;
        checkClosureCapturesList(ctx, env, args, boundNames, modeVar, lamSpan)
    },
    ExAbs(ps2, _, b2) ->
        checkClosureCaptures(ctx, env, b2, extendBoundWithVarDecls(ps2, boundNames), modeVar, lamSpan),
    ExBin(_, l, r) -> {
        checkClosureCaptures(ctx, env, l, boundNames, modeVar, lamSpan)?;
        checkClosureCaptures(ctx, env, r, boundNames, modeVar, lamSpan)
    },
    ExUn(_, e) -> checkClosureCaptures(ctx, env, e, boundNames, modeVar, lamSpan),
    ExField(e, _) -> checkClosureCaptures(ctx, env, e, boundNames, modeVar, lamSpan),
    ExTry(e) -> checkClosureCaptures(ctx, env, e, boundNames, modeVar, lamSpan),
    ExIf(c, t, e) -> {
        checkClosureCaptures(ctx, env, c, boundNames, modeVar, lamSpan)?;
        checkClosureCaptures(ctx, env, t, boundNames, modeVar, lamSpan)?;
        checkClosureCaptures(ctx, env, e, boundNames, modeVar, lamSpan)
    },
    ExWhile(c, b) -> {
        checkClosureCaptures(ctx, env, c, boundNames, modeVar, lamSpan)?;
        checkClosureCaptures(ctx, env, b, boundNames, modeVar, lamSpan)
    },
    ExContract(_, b) -> checkClosureCaptures(ctx, env, b, boundNames, modeVar, lamSpan),
    ExLoopContract(_, _, b) -> checkClosureCaptures(ctx, env, b, boundNames, modeVar, lamSpan),
    ExLet(vd, val, b) -> {
        checkClosureCaptures(ctx, env, val, boundNames, modeVar, lamSpan)?;
        checkClosureCaptures(ctx, env, b, Cons(vd.vname, boundNames), modeVar, lamSpan)
    },
    ExMatch(s, arms) -> {
        checkClosureCaptures(ctx, env, s, boundNames, modeVar, lamSpan)?;
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let armBound = extendBoundWithPattern(a.pat, boundNames);
                    match a.guard {
                        Some(g) -> checkClosureCaptures(ctx, env, g, armBound, modeVar, lamSpan)?,
                        None -> (),
                    };
                    checkClosureCaptures(ctx, env, a.body, armBound, modeVar, lamSpan)?;
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        Ok(())
    },
}

def checkClosureCapturesList(
    ctx: InferCtx,
    env: TypeEnv,
    es: List Form,
    boundNames: List String,
    modeVar: Type,
    lamSpan: Span
): Result Void String = match es {
    Nil -> Ok(()),
    Cons(h, r) -> {
        checkClosureCaptures(ctx, env, h, boundNames, modeVar, lamSpan)?;
        checkClosureCapturesList(ctx, env, r, boundNames, modeVar, lamSpan)
    },
}

def checkClosureCapturesNamed(
    ctx: InferCtx,
    env: TypeEnv,
    fs: List (String, Form),
    boundNames: List String,
    modeVar: Type,
    lamSpan: Span
): Result Void String = match fs {
    Nil -> Ok(()),
    Cons((_, v), r) -> {
        checkClosureCaptures(ctx, env, v, boundNames, modeVar, lamSpan)?;
        checkClosureCapturesNamed(ctx, env, r, boundNames, modeVar, lamSpan)
    },
}

// ============================================================================
// Maranget Pattern Exhaustiveness Checking
// ============================================================================

def isWildPat(p: Pattern): Bool = match p {
    PatWild -> true,
    PatVar(_, _) -> true,
    _ -> false,
}

def normalizeStructPat(ctx: InferCtx, pat: Pattern): Pattern = match pat {
    PatStruct(cname, named) -> match strMapGet(ctx.ctorToAdt, cname) {
        Some(adtName) -> match strMapGet(ctx.adtReg, adtName) {
            Some(ainfo) -> match findVariantByName(ainfo.variants, cname) {
                Some(vinfo) -> match vinfo.fieldNames {
                    Some(fnames) -> {
                        let ordered = cellNew(Nil);
                        let cur = cellNew(fnames);
                        while (match cellGet(cur) { Nil -> false, _ -> true }) {
                            match cellGet(cur) {
                                Cons(fnm, r) -> {
                                    let subp = lookupNamedPat(named, fnm);
                                    cellSet(ordered, listAppend(cellGet(ordered), [normalizeStructPat(ctx, subp)]));
                                    cellSet(cur, r)
                                },
                                Nil -> (),
                            }
                        };
                        PatCtor(cname, cellGet(ordered))
                    },
                    None -> pat,
                },
                None -> pat,
            },
            None -> pat,
        },
        None -> pat,
    },
    PatTuple(ps) -> PatTuple(normalizeStructPatList(ctx, ps)),
    PatCtor(c, ps) -> PatCtor(c, normalizeStructPatList(ctx, ps)),
    _ -> pat,
}

def normalizeStructPatList(ctx: InferCtx, ps: List Pattern): List Pattern = match ps {
    Nil -> Nil,
    Cons(h, t) -> Cons(normalizeStructPat(ctx, h), normalizeStructPatList(ctx, t)),
}

def lookupNamedPat(named: List (String, Pattern, Span, Bool), target: String): Pattern = match named {
    Nil -> PatWild,
    Cons((k, p, _, _), r) -> if (k == target) p else lookupNamedPat(r, target),
}

def repeatWilds(n: Int): List Pattern =
    if (n <= 0) Nil else Cons(PatWild, repeatWilds(n - 1))

def allFirstColWild(matrix: List (List Pattern)): Bool = match matrix {
    Nil -> true,
    Cons(Cons(p0, _), r) -> if (isWildPat(p0)) allFirstColWild(r) else false,
    Cons(Nil, r) -> allFirstColWild(r),
}

def peelFirstCol(matrix: List (List Pattern)): List (List Pattern) = match matrix {
    Nil -> Nil,
    Cons(Cons(_, restRow), r) -> Cons(restRow, peelFirstCol(r)),
    Cons(Nil, r) -> peelFirstCol(r),
}

def findMissingPattern(ctx: InferCtx, matrix: List (List Pattern), tys: List Type): Option String = match tys {
    Nil -> match matrix {
        Nil -> Some("_"),
        _ -> None,
    },
    Cons(firstTy, restTys) -> match matrix {
        Nil -> Some("_"),
        _ ->
            if (allFirstColWild(matrix)) findMissingPattern(ctx, peelFirstCol(matrix), restTys)
            else match firstTy {
                TyVoid -> {
                    let subM = cellNew(Nil);
                    let cur = cellNew(matrix);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(Cons(p0, rRow), rM) -> {
                                let matchesUnit = match p0 {
                                    PatLit(LitUnit) -> true,
                                    _ -> isWildPat(p0),
                                };
                                if (matchesUnit) cellSet(subM, listAppend(cellGet(subM), [rRow])) else ();
                                cellSet(cur, rM)
                            },
                            Cons(Nil, rM) -> cellSet(cur, rM),
                            Nil -> (),
                        }
                    };
                    match findMissingPattern(ctx, cellGet(subM), restTys) {
                        Some(_) -> Some("()"),
                        None -> None,
                    }
                },
                TyTuple(elemTys) -> {
                    let k = listLen(elemTys);
                    let subM = cellNew(Nil);
                    let cur = cellNew(matrix);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(Cons(PatTuple(ps), rRow), rM) -> {
                                if (listLen(ps) == k) cellSet(subM, listAppend(cellGet(subM), [listAppend(ps, rRow)])) else ();
                                cellSet(cur, rM)
                            },
                            Cons(Cons(p0, rRow), rM) -> {
                                if (isWildPat(p0)) cellSet(subM, listAppend(cellGet(subM), [listAppend(repeatWilds(k), rRow)])) else ();
                                cellSet(cur, rM)
                            },
                            Cons(Nil, rM) -> cellSet(cur, rM),
                            Nil -> (),
                        }
                    };
                    findMissingPattern(ctx, cellGet(subM), listAppend(elemTys, restTys))
                },
                TyCon("Bool") -> {
                    let missTrue = checkBoolBranch(ctx, matrix, true, restTys);
                    match missTrue {
                        Some(w) -> Some(w),
                        None -> checkBoolBranch(ctx, matrix, false, restTys),
                    }
                },
                _ -> match decomposeAdtType(ctx.adtReg, firstTy) {
                    Some((adtName, typeArgs)) -> match strMapGet(ctx.adtReg, adtName) {
                        Some(ainfo) -> {
                            let sub = buildPairMap(ainfo.typeParams, typeArgs);
                            checkAdtExhaustive(ctx, matrix, ainfo.variants, sub, restTys)
                        },
                        None -> checkWildFallback(ctx, matrix, restTys),
                    },
                    None -> checkWildFallback(ctx, matrix, restTys),
                },
            },
    },
}

def checkBoolBranch(ctx: InferCtx, matrix: List (List Pattern), bval: Bool, restTys: List Type): Option String = {
    let subM = cellNew(Nil);
    let cur = cellNew(matrix);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(Cons(PatLit(LitBool(v)), rRow), rM) -> {
                if (v == bval) cellSet(subM, listAppend(cellGet(subM), [rRow])) else ();
                cellSet(cur, rM)
            },
            Cons(Cons(p0, rRow), rM) -> {
                if (isWildPat(p0)) cellSet(subM, listAppend(cellGet(subM), [rRow])) else ();
                cellSet(cur, rM)
            },
            Cons(Nil, rM) -> cellSet(cur, rM),
            Nil -> (),
        }
    };
    match findMissingPattern(ctx, cellGet(subM), restTys) {
        Some(_) -> Some(if (bval) "true" else "false"),
        None -> None,
    }
}

def checkAdtExhaustive(
    ctx: InferCtx,
    matrix: List (List Pattern),
    variants: List VariantInfo,
    sub: StrMap Type,
    restTys: List Type
): Option String = match variants {
    Nil -> None,
    Cons(v, rV) -> {
        let arity = listLen(v.fieldTypes);
        let fieldTys = applyExplicitSubstList(v.fieldTypes, sub);
        let subM = cellNew(Nil);
        let cur = cellNew(matrix);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(Cons(PatCtor(cn, subPats), rRow), rM) -> {
                    if (cn == v.vname && listLen(subPats) == arity) {
                        cellSet(subM, listAppend(cellGet(subM), [listAppend(subPats, rRow)]))
                    } else ();
                    cellSet(cur, rM)
                },
                Cons(Cons(p0, rRow), rM) -> {
                    if (isWildPat(p0)) {
                        cellSet(subM, listAppend(cellGet(subM), [listAppend(repeatWilds(arity), rRow)]))
                    } else ();
                    cellSet(cur, rM)
                },
                Cons(Nil, rM) -> cellSet(cur, rM),
                Nil -> (),
            }
        };
        match findMissingPattern(ctx, cellGet(subM), listAppend(fieldTys, restTys)) {
            Some(innerW) ->
                if (arity == 0) Some(v.vname)
                else Some(v.vname + "(" + innerW + ")"),
            None -> checkAdtExhaustive(ctx, matrix, rV, sub, restTys),
        }
    },
}

def checkWildFallback(ctx: InferCtx, matrix: List (List Pattern), restTys: List Type): Option String = {
    let wildM = cellNew(Nil);
    let cur = cellNew(matrix);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(Cons(p0, rRow), rM) -> {
                if (isWildPat(p0)) cellSet(wildM, listAppend(cellGet(wildM), [rRow])) else ();
                cellSet(cur, rM)
            },
            Cons(Nil, rM) -> cellSet(cur, rM),
            Nil -> (),
        }
    };
    findMissingPattern(ctx, cellGet(wildM), restTys)
}

def checkExhaustivenessInForm(ctx: InferCtx, f: Form): Result Void String = match f.node {
    ExMatch(scrut, arms) -> {
        checkExhaustivenessInForm(ctx, scrut)?;
        let matrix = cellNew(Nil);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.guard {
                        Some(g) -> checkExhaustivenessInForm(ctx, g)?,
                        None -> cellSet(matrix, listAppend(cellGet(matrix), [[normalizeStructPat(ctx, a.pat)]])),
                    };
                    checkExhaustivenessInForm(ctx, a.body)?;
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        match findMissingPattern(ctx, cellGet(matrix), [schemeBody(scrut.ty)]) {
            Some(missing) -> Err(typeErr(f.pos, "Non-exhaustive pattern match; missing case: " + missing)),
            None -> Ok(()),
        }
    },
    ExTuple(es) -> checkExhaustivenessInList(ctx, es),
    ExList(es) -> checkExhaustivenessInList(ctx, es),
    ExBlock(es) -> checkExhaustivenessInList(ctx, es),
    ExStructInit(_, fs) -> checkExhaustivenessInNamed(ctx, fs),
    ExApply(c, args) -> {
        checkExhaustivenessInForm(ctx, c)?;
        checkExhaustivenessInList(ctx, args)
    },
    ExAbs(_, _, b) -> checkExhaustivenessInForm(ctx, b),
    ExBin(_, l, r) -> { checkExhaustivenessInForm(ctx, l)?; checkExhaustivenessInForm(ctx, r) },
    ExUn(_, e) -> checkExhaustivenessInForm(ctx, e),
    ExField(e, _) -> checkExhaustivenessInForm(ctx, e),
    ExTry(e) -> checkExhaustivenessInForm(ctx, e),
    ExLet(_, v, b) -> { checkExhaustivenessInForm(ctx, v)?; checkExhaustivenessInForm(ctx, b) },
    ExIf(c, t, e) -> {
        checkExhaustivenessInForm(ctx, c)?;
        checkExhaustivenessInForm(ctx, t)?;
        checkExhaustivenessInForm(ctx, e)
    },
    ExWhile(c, b) -> { checkExhaustivenessInForm(ctx, c)?; checkExhaustivenessInForm(ctx, b) },
    ExContract(fc, b) -> {
        let cr = cellNew(fc.fcRequires);
        while (match cellGet(cr) { Nil -> false, _ -> true }) {
            match cellGet(cr) { Cons((_, e), r) -> { checkExhaustivenessInForm(ctx, e)?; cellSet(cr, r) }, Nil -> () }
        };
        let cd = cellNew(fc.fcDecreases);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) { Cons((_, e), r) -> { checkExhaustivenessInForm(ctx, e)?; cellSet(cd, r) }, Nil -> () }
        };
        let ce = cellNew(fc.fcEnsures);
        while (match cellGet(ce) { Nil -> false, _ -> true }) {
            match cellGet(ce) { Cons(ec, r) -> { checkExhaustivenessInForm(ctx, ec.ecExpr)?; cellSet(ce, r) }, Nil -> () }
        };
        checkExhaustivenessInForm(ctx, b)
    },
    ExLoopContract(invs, decs, b) -> {
        let ci = cellNew(invs);
        while (match cellGet(ci) { Nil -> false, _ -> true }) {
            match cellGet(ci) { Cons((_, e), r) -> { checkExhaustivenessInForm(ctx, e)?; cellSet(ci, r) }, Nil -> () }
        };
        let cd = cellNew(decs);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) { Cons((_, e), r) -> { checkExhaustivenessInForm(ctx, e)?; cellSet(cd, r) }, Nil -> () }
        };
        checkExhaustivenessInForm(ctx, b)
    },
    _ -> Ok(()),
}

def checkExhaustivenessInList(ctx: InferCtx, es: List Form): Result Void String = match es {
    Nil -> Ok(()),
    Cons(h, t) -> { checkExhaustivenessInForm(ctx, h)?; checkExhaustivenessInList(ctx, t) },
}

def isImpureContractPrim(nm: String): Bool =
    nm == "cellNew" || nm == "cellSet"
    || nm == "arrayNew" || nm == "arrayNewZeroed" || nm == "arraySet" || nm == "arrayClearSlot" || nm == "arrayFreeze"
    || nm == "printLn" || nm == "putNumber" || nm == "putFloat" || nm == "putF32" || nm == "putChar"
    || nm == "ptrAllocBytes" || nm == "ptrAllocBytes64" || nm == "ptrSetByte"
    || nm == "ptrWriteU16Le" || nm == "ptrWriteU32Le" || nm == "ptrWriteI64Le" || nm == "ptrWriteF32Le" || nm == "ptrWriteF64Le"
    || nm == "ptrWriteI64Le64" || nm == "ptrWriteF32Le64" || nm == "ptrWriteF64Le64"
    || nm == "ptrCopyBytes" || nm == "ptrCopyBytes64" || nm == "ptrCopyFromStr"
    || nm == "foreignPtrAlloc" || nm == "arenaAlloc"
    || nm == "scopedPtrSetByte" || nm == "scopedPtrWriteI32Le" || nm == "scopedPtrWriteI64Le"
    || nm == "scopedPtrWriteF32Le" || nm == "scopedPtrWriteF64Le" || nm == "scopedPtrCopyBytes"
    || nm == "taskSpawn" || nm == "actorSpawn" || nm == "actorSend" || nm == "actorCall"
    || nm == "chanSend" || nm == "chanRecv" || nm == "mvarPut" || nm == "mvarTake"
    || nm == "atomicStore" || nm == "atomicAdd" || nm == "atomicCas"
    || nm == "gcHandleNew" || nm == "gcHandleFree" || nm == "gcTrim" || nm == "gcSetThresholds"
    || nm == "assert" || nm == "assume"

def collectDirectImpurityAndCalls(
    f: Form,
    bound: List String,
    isImpure: Cell Bool,
    callees: Cell (List String)
): Void = match f.node {
    ExWhile(_, _) -> cellSet(isImpure, true),
    ExApply(callee, args) -> {
        let handledQuant = match callee.node {
            ExVar(qnm) if (qnm == "$gs$forall" || qnm == "$gs$exists") -> match args {
                Cons(lamF, Nil) -> match lamF.node {
                    ExAbs(ps, _, qb) -> {
                        collectDirectImpurityAndCalls(qb, extendBoundWithVarDecls(ps, bound), isImpure, callees);
                        true
                    },
                    _ -> false,
                },
                _ -> false,
            },
            _ -> false,
        };
        if (!handledQuant) {
            match callee.node {
                ExVar(nm) ->
                    if (isImpureContractPrim(nm)) cellSet(isImpure, true)
                    else if (listContainsStr(bound, nm)) cellSet(isImpure, true)
                    else if (nm == "old") ()
                    else cellSet(callees, addUniqueStr(cellGet(callees), nm)),
                _ -> {
                    cellSet(isImpure, true);
                    collectDirectImpurityAndCalls(callee, bound, isImpure, callees)
                },
            };
            let ca = cellNew(args);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(a, r) -> { collectDirectImpurityAndCalls(a, bound, isImpure, callees); cellSet(ca, r) },
                    Nil -> (),
                }
            }
        } else ()
    },
    ExTuple(es) -> collectDirectList(es, bound, isImpure, callees),
    ExList(es) -> collectDirectList(es, bound, isImpure, callees),
    ExBlock(es) -> collectDirectList(es, bound, isImpure, callees),
    ExStructInit(_, fs) -> {
        let cf = cellNew(fs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons((_, v), r) -> { collectDirectImpurityAndCalls(v, bound, isImpure, callees); cellSet(cf, r) },
                Nil -> (),
            }
        }
    },
    ExAbs(ps, _, b) -> collectDirectImpurityAndCalls(b, extendBoundWithVarDecls(ps, bound), isImpure, callees),
    ExBin(_, l, r) -> {
        collectDirectImpurityAndCalls(l, bound, isImpure, callees);
        collectDirectImpurityAndCalls(r, bound, isImpure, callees)
    },
    ExUn(_, e) -> collectDirectImpurityAndCalls(e, bound, isImpure, callees),
    ExField(e, _) -> collectDirectImpurityAndCalls(e, bound, isImpure, callees),
    ExTry(e) -> collectDirectImpurityAndCalls(e, bound, isImpure, callees),
    ExLet(vd, v, b) -> {
        collectDirectImpurityAndCalls(v, bound, isImpure, callees);
        collectDirectImpurityAndCalls(b, Cons(vd.vname, bound), isImpure, callees)
    },
    ExIf(c, t, e) -> {
        collectDirectImpurityAndCalls(c, bound, isImpure, callees);
        collectDirectImpurityAndCalls(t, bound, isImpure, callees);
        collectDirectImpurityAndCalls(e, bound, isImpure, callees)
    },
    ExMatch(scrut, arms) -> {
        collectDirectImpurityAndCalls(scrut, bound, isImpure, callees);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let ab = extendBoundWithPattern(a.pat, bound);
                    match a.guard { Some(g) -> collectDirectImpurityAndCalls(g, ab, isImpure, callees), None -> () };
                    collectDirectImpurityAndCalls(a.body, ab, isImpure, callees);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    ExContract(_, b) -> collectDirectImpurityAndCalls(b, bound, isImpure, callees),
    ExLoopContract(_, _, b) -> collectDirectImpurityAndCalls(b, bound, isImpure, callees),
    _ -> (),
}

def collectDirectList(es: List Form, bound: List String, isImpure: Cell Bool, callees: Cell (List String)): Void = {
    let cur = cellNew(es);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> { collectDirectImpurityAndCalls(h, bound, isImpure, callees); cellSet(cur, r) },
            Nil -> (),
        }
    }
}

def buildImpureFnSet(ctx: InferCtx, defs: List Def): StrMap Bool = {
    let impure: StrMap Bool = strMapNew();
    let fnNamesRev: Cell (List String) = cellNew(Nil);
    let callGraph: StrMap (List String) = strMapNew();
    let cd = cellNew(defs);
    while (match cellGet(cd) { Nil -> false, _ -> true }) {
        match cellGet(cd) {
            Cons(d, r) -> {
                match d.item {
                    ItExtern(_, _, _, _) -> strMapInsert(impure, d.ident, true),
                    ItForm(f) -> {
                        let imp = cellNew(false);
                        let cs: Cell (List String) = cellNew(Nil);
                        collectDirectImpurityAndCalls(f, Nil, imp, cs);
                        if (cellGet(imp)) strMapInsert(impure, d.ident, true) else ();
                        strMapInsert(callGraph, d.ident, cellGet(cs));
                        cellSet(fnNamesRev, Cons(d.ident, cellGet(fnNamesRev)))
                    },
                    _ -> (),
                };
                cellSet(cd, r)
            },
            Nil -> (),
        }
    };
    // Connect every Concept method name to all registered instance implementations so
    // any impure instance method taints the Concept method during transitive closure.
    let ci = cellNew(cellGet(ctx.instanceReg));
    while (match cellGet(ci) { Nil -> false, _ -> true }) {
        match cellGet(ci) {
            Cons(inst, ri) -> {
                match strMapGet(ctx.conceptReg, inst.conceptName) {
                    Some(cinfo) -> {
                        let cm = cellNew(cinfo.methods);
                        while (match cellGet(cm) { Nil -> false, _ -> true }) {
                            match cellGet(cm) {
                                Cons((mname, _), rm) -> {
                                    match strMapGet(inst.methodImpls, mname) {
                                        Some(implFn) -> {
                                            let prev = match strMapGet(callGraph, mname) { Some(xs) -> xs, None -> Nil };
                                            strMapInsert(callGraph, mname, addUniqueStr(prev, implFn));
                                            cellSet(fnNamesRev, addUniqueStr(cellGet(fnNamesRev), mname))
                                        },
                                        None -> (),
                                    };
                                    cellSet(cm, rm)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                };
                cellSet(ci, ri)
            },
            Nil -> (),
        }
    };
    // Transitive closure fixed point
    let fnNames = listRev(cellGet(fnNamesRev));
    let changed = cellNew(true);
    while (cellGet(changed)) {
        cellSet(changed, false);
        let cf = cellNew(fnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(nm, r) -> {
                    if (!strMapContains(impure, nm)) {
                        match strMapGet(callGraph, nm) {
                            Some(cs) -> {
                                let cc = cellNew(cs);
                                let hit = cellNew(false);
                                while (match cellGet(cc) { Nil -> false, _ -> !cellGet(hit) }) {
                                    match cellGet(cc) {
                                        Cons(callee, rc) -> {
                                            if (strMapContains(impure, callee)) cellSet(hit, true) else ();
                                            cellSet(cc, rc)
                                        },
                                        Nil -> (),
                                    }
                                };
                                if (cellGet(hit)) {
                                    strMapInsert(impure, nm, true);
                                    cellSet(changed, true)
                                } else ()
                            },
                            None -> (),
                        }
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    };
    impure
}

data PurityCtx {
    MkPurityCtx {
        pcImpure: StrMap Bool,
        pcUserDefs: StrMap Bool,
        pcFnTypeParams: List String,
        pcEntryVars: List String,
        pcEnsBind: Option String,
        pcInSpec: Bool,
        pcAllowQuant: Bool,
        pcInEnsures: Bool,
        pcInOld: Bool,
    },
}

def isUnshadowedSpecPrim(pctx: PurityCtx, bound: List String, nm: String): Bool =
    !listContainsStr(bound, nm) && !strMapContains(pctx.pcUserDefs, nm)

def exprRefsNonEntryVar(
    f: Form,
    entryVars: List String,
    outerBound: List String,
    innerBound: List String,
    ensBindOpt: Option String
): (Bool, Bool) = match f.node {
    ExVar(v) ->
        if (listContainsStr(innerBound, v)) (false, false)
        else {
            let hitEnsBind = match ensBindOpt {
                Some(eb) -> v == eb,
                None -> false,
            };
            let hitLocal = listContainsStr(outerBound, v) && !listContainsStr(entryVars, v);
            (hitEnsBind, hitLocal)
        },
    ExTuple(es) -> exprListRefsNonEntryVar(es, entryVars, outerBound, innerBound, ensBindOpt),
    ExList(es) -> exprListRefsNonEntryVar(es, entryVars, outerBound, innerBound, ensBindOpt),
    ExBlock(es) -> exprListRefsNonEntryVar(es, entryVars, outerBound, innerBound, ensBindOpt),
    ExStructInit(_, fs) -> {
        let eb = cellNew(false);
        let loc = cellNew(false);
        let cur = cellNew(fs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, vf), r) -> {
                    let (b1, b2) = exprRefsNonEntryVar(vf, entryVars, outerBound, innerBound, ensBindOpt);
                    if (b1) cellSet(eb, true) else ();
                    if (b2) cellSet(loc, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        (cellGet(eb), cellGet(loc))
    },
    ExApply(c, args) -> {
        let (c1, c2) = exprRefsNonEntryVar(c, entryVars, outerBound, innerBound, ensBindOpt);
        let (a1, a2) = exprListRefsNonEntryVar(args, entryVars, outerBound, innerBound, ensBindOpt);
        (c1 || a1, c2 || a2)
    },
    ExAbs(ps, _, b) ->
        exprRefsNonEntryVar(b, entryVars, outerBound, extendBoundWithVarDecls(ps, innerBound), ensBindOpt),
    ExBin(_, l, r) -> {
        let (l1, l2) = exprRefsNonEntryVar(l, entryVars, outerBound, innerBound, ensBindOpt);
        let (r1, r2) = exprRefsNonEntryVar(r, entryVars, outerBound, innerBound, ensBindOpt);
        (l1 || r1, l2 || r2)
    },
    ExUn(_, e) -> exprRefsNonEntryVar(e, entryVars, outerBound, innerBound, ensBindOpt),
    ExField(e, _) -> exprRefsNonEntryVar(e, entryVars, outerBound, innerBound, ensBindOpt),
    ExTry(e) -> exprRefsNonEntryVar(e, entryVars, outerBound, innerBound, ensBindOpt),
    ExLet(vd, v, b) -> {
        let (v1, v2) = exprRefsNonEntryVar(v, entryVars, outerBound, innerBound, ensBindOpt);
        let (b1, b2) = exprRefsNonEntryVar(b, entryVars, outerBound, Cons(vd.vname, innerBound), ensBindOpt);
        (v1 || b1, v2 || b2)
    },
    ExIf(c, t, e) -> {
        let (c1, c2) = exprRefsNonEntryVar(c, entryVars, outerBound, innerBound, ensBindOpt);
        let (t1, t2) = exprRefsNonEntryVar(t, entryVars, outerBound, innerBound, ensBindOpt);
        let (e1, e2) = exprRefsNonEntryVar(e, entryVars, outerBound, innerBound, ensBindOpt);
        (c1 || t1 || e1, c2 || t2 || e2)
    },
    ExMatch(s, arms) -> {
        let (s1, s2) = exprRefsNonEntryVar(s, entryVars, outerBound, innerBound, ensBindOpt);
        let eb = cellNew(s1);
        let loc = cellNew(s2);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let nextInner = extendBoundWithPattern(a.pat, innerBound);
                    match a.guard {
                        Some(g) -> {
                            let (g1, g2) = exprRefsNonEntryVar(g, entryVars, outerBound, nextInner, ensBindOpt);
                            if (g1) cellSet(eb, true) else ();
                            if (g2) cellSet(loc, true) else ()
                        },
                        None -> (),
                    };
                    let (b1, b2) = exprRefsNonEntryVar(a.body, entryVars, outerBound, nextInner, ensBindOpt);
                    if (b1) cellSet(eb, true) else ();
                    if (b2) cellSet(loc, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        (cellGet(eb), cellGet(loc))
    },
    _ -> (false, false),
}

def exprListRefsNonEntryVar(
    es: List Form,
    entryVars: List String,
    outerBound: List String,
    innerBound: List String,
    ensBindOpt: Option String
): (Bool, Bool) = match es {
    Nil -> (false, false),
    Cons(h, t) -> {
        let (h1, h2) = exprRefsNonEntryVar(h, entryVars, outerBound, innerBound, ensBindOpt);
        let (t1, t2) = exprListRefsNonEntryVar(t, entryVars, outerBound, innerBound, ensBindOpt);
        (h1 || t1, h2 || t2)
    },
}

def checkOldArgScope(pctx: PurityCtx, bound: List String, callSp: Span, arg0: Form): Result Void String = {
    let (usesEnsBind, usesEnsLocal) = exprRefsNonEntryVar(arg0, pctx.pcEntryVars, bound, Nil, pctx.pcEnsBind);
    if (usesEnsBind) {
        let rname = match pctx.pcEnsBind { Some(rn) -> rn, None -> "result" };
        Err(formatSpanDiagHint(
            "Contract error", callSp,
            "`old(...)` evaluates in the pre-state before the function body runs and cannot reference the `ensures` return binding `" + rname + "`",
            "use `" + rname + "` outside `old(...)` to compare post-state results against `old(...)` pre-state values"
        ))
    } else if (!usesEnsLocal) {
        Ok(())
    } else {
        // Allow `old(arrayGet(arrExpr, idxExpr))` when `arrExpr` depends only on entry-scope variables!
        let okArrIdx = match arg0.node {
            ExApply(cF, Cons(arrF, Cons(_, Nil))) -> match cF.node {
                ExVar(anm) if ((anm == "arrayGet" || anm == "immArrayGet") && isUnshadowedSpecPrim(pctx, bound, anm)) -> {
                    let (ab1, ab2) = exprRefsNonEntryVar(arrF, pctx.pcEntryVars, bound, Nil, pctx.pcEnsBind);
                    !ab1 && !ab2
                },
                _ -> false,
            },
            _ -> false,
        };
        if (okArrIdx) Ok(())
        else Err(formatSpanDiagHint(
            "Contract error", callSp,
            "`old(...)` cannot depend on `ensures`-local bindings (except indexing a pre-state array via `old(arrayGet(arr, i))`)",
            "wrap only the pre-state container/value read in `old(...)`, e.g. `old(cellGet(c))`"
        ))
    }
}

def checkContractExprCtx(pctx: PurityCtx, bound: List String, f: Form): Result Void String = match f.node {
    ExVar(nm) ->
        if (nm == "old" && isUnshadowedSpecPrim(pctx, bound, "old")) {
            Err(formatSpanDiagHint(
                "Contract error", f.pos,
                "`old` cannot be used as a first-class value; call `old(expr)` inside an `ensures` postcondition",
                "example: `ensures cellGet(c) == old(cellGet(c)) + 1`"
            ))
        } else Ok(()),
    ExWhile(c, b) ->
        if (pctx.pcInSpec) {
            Err(formatSpanDiagHint("Purity error", f.pos, "`while` loop is not allowed inside a contract specification", "contracts (`requires`, `ensures`, `invariant`, `decreases`) must be pure and terminating"))
        } else {
            checkContractExprCtx(pctx, bound, c)?;
            checkContractExprCtx(pctx, bound, b)
        },
    ExApply(callee, args) -> {
        let isQuant = match callee.node {
            ExVar(qnm) -> qnm == "$gs$forall" || qnm == "$gs$exists",
            _ -> false,
        };
        let isOldCall = match callee.node {
            ExVar(onm) -> onm == "old" && isUnshadowedSpecPrim(pctx, bound, "old"),
            _ -> false,
        };
        let isAssertOrAssume = match callee.node {
            ExVar(anm) -> (anm == "assert" || anm == "assume") && isUnshadowedSpecPrim(pctx, bound, anm),
            _ -> false,
        };
        if (isQuant) {
            if (!pctx.pcAllowQuant) {
                Err(formatSpanDiagHint(
                    "Contract error", f.pos,
                    "quantifier expressions (`forall` / `exists`) are only allowed inside contract specifications (`requires`, `ensures`, `invariant`) and `assert`/`assume`",
                    "move the quantified property into a `requires`, `ensures`, `invariant`, or `assert(...)` clause"
                ))
            } else match args {
                Cons(lamF, Nil) -> match lamF.node {
                    ExAbs(Cons(vd, Nil), _, qbody) -> {
                        let fvs = ftvOrdered(schemeBody(vd.vscm));
                        let cf = cellNew(fvs);
                        while (match cellGet(cf) { Nil -> false, _ -> true }) {
                            match cellGet(cf) {
                                Cons(tv, rf) -> {
                                    if (!isModeVarName(tv) && !listContainsStr(pctx.pcFnTypeParams, tv)) {
                                        Err(formatSpanDiagHint(
                                            "Type error", f.pos,
                                            "cannot infer concrete type for quantified variable `" + vd.vname + "`",
                                            "add an explicit type annotation, e.g. `forall (" + vd.vname + ": Int) -> ...`"
                                        ))?
                                    } else ();
                                    cellSet(cf, rf)
                                },
                                Nil -> (),
                            }
                        };
                        let qCtx = MkPurityCtx {
                            pcImpure: pctx.pcImpure,
                            pcUserDefs: pctx.pcUserDefs,
                            pcFnTypeParams: pctx.pcFnTypeParams,
                            pcEntryVars: pctx.pcEntryVars,
                            pcEnsBind: pctx.pcEnsBind,
                            pcInSpec: true,
                            pcAllowQuant: true,
                            pcInEnsures: pctx.pcInEnsures,
                            pcInOld: pctx.pcInOld,
                        };
                        checkContractExprCtx(qCtx, Cons(vd.vname, bound), qbody)
                    },
                    _ -> Err(formatSpanDiag("Contract error", f.pos, "malformed quantifier binder")),
                },
                _ -> Err(formatSpanDiag("Contract error", f.pos, "malformed quantifier expression")),
            }
        } else if (isOldCall) {
            if (!pctx.pcInEnsures) {
                Err(formatSpanDiagHint(
                    "Contract error", f.pos,
                    "`old(expr)` is only allowed inside an `ensures` postcondition",
                    "move `old(...)` into an `ensures` clause"
                ))
            } else if (pctx.pcInOld) {
                Err(formatSpanDiagHint(
                    "Contract error", f.pos,
                    "nested `old(old(...))` is not allowed",
                    "use a single `old(...)` around the pre-state expression"
                ))
            } else match args {
                Cons(arg0, Nil) -> {
                    checkOldArgScope(pctx, bound, f.pos, arg0)?;
                    let oldCtx = MkPurityCtx {
                        pcImpure: pctx.pcImpure,
                        pcUserDefs: pctx.pcUserDefs,
                        pcFnTypeParams: pctx.pcFnTypeParams,
                        pcEntryVars: pctx.pcEntryVars,
                        pcEnsBind: pctx.pcEnsBind,
                        pcInSpec: true,
                        pcAllowQuant: false,
                        pcInEnsures: true,
                        pcInOld: true,
                    };
                    checkContractExprCtx(oldCtx, bound, arg0)
                },
                _ -> Err(formatSpanDiag("Contract error", f.pos, "`old(...)` expects exactly 1 argument")),
            }
        } else if (pctx.pcInSpec) {
            let calleeChk: Result Void String = match callee.node {
                ExVar(nm) ->
                    if (isImpureContractPrim(nm)) {
                        Err(formatSpanDiagHint("Purity error", f.pos, "side-effecting primitive `" + nm + "` is not allowed inside a contract specification", "only pure expressions and read-only lookups (`cellGet`, `arrayLen`, `arrayGet`, `immArrayLen`, `immArrayGet`) are permitted in contracts"))
                    } else if (listContainsStr(bound, nm)) {
                        Err(formatSpanDiagHint("Purity error", f.pos, "calling higher-order local function `" + nm + "` is not allowed inside a contract specification", "contract specifications cannot invoke arbitrary closures with unknown side effects"))
                    } else if (strMapContains(pctx.pcImpure, nm)) {
                        Err(formatSpanDiagHint("Purity error", f.pos, "impure function `" + nm + "` is not allowed inside a contract specification", "`" + nm + "` directly or transitively performs mutation, I/O, extern FFI, or looping"))
                    } else Ok(()),
                _ -> Err(formatSpanDiagHint("Purity error", f.pos, "indirect function call is not allowed inside a contract specification", "only calls to statically known pure functions are permitted in contracts")),
            };
            calleeChk?;
            checkContractExprCtxList(pctx, bound, args)
        } else if (isAssertOrAssume) {
            let aaCtx = MkPurityCtx {
                pcImpure: pctx.pcImpure,
                pcUserDefs: pctx.pcUserDefs,
                pcFnTypeParams: pctx.pcFnTypeParams,
                pcEntryVars: pctx.pcEntryVars,
                pcEnsBind: None,
                pcInSpec: false,
                pcAllowQuant: true,
                pcInEnsures: false,
                pcInOld: false,
            };
            checkContractExprCtxList(aaCtx, bound, args)
        } else {
            checkContractExprCtx(pctx, bound, callee)?;
            checkContractExprCtxList(pctx, bound, args)
        }
    },
    ExTuple(es) -> checkContractExprCtxList(pctx, bound, es),
    ExList(es) -> checkContractExprCtxList(pctx, bound, es),
    ExBlock(es) -> checkContractExprCtxList(pctx, bound, es),
    ExStructInit(_, fs) -> checkContractExprCtxNamed(pctx, bound, fs),
    ExAbs(ps, _, b) -> {
        let nextBound = extendBoundWithVarDecls(ps, bound);
        let subCtx = match b.node {
            ExContract(_, _) -> MkPurityCtx {
                pcImpure: pctx.pcImpure,
                pcUserDefs: pctx.pcUserDefs,
                pcFnTypeParams: pctx.pcFnTypeParams,
                pcEntryVars: nextBound,
                pcEnsBind: None,
                pcInSpec: pctx.pcInSpec,
                pcAllowQuant: pctx.pcAllowQuant,
                pcInEnsures: false,
                pcInOld: false,
            },
            _ -> pctx,
        };
        checkContractExprCtx(subCtx, nextBound, b)
    },
    ExBin(_, l, r) -> { checkContractExprCtx(pctx, bound, l)?; checkContractExprCtx(pctx, bound, r) },
    ExUn(_, e) -> checkContractExprCtx(pctx, bound, e),
    ExField(e, _) -> checkContractExprCtx(pctx, bound, e),
    ExTry(e) -> checkContractExprCtx(pctx, bound, e),
    ExLet(vd, v, b) -> {
        checkContractExprCtx(pctx, bound, v)?;
        checkContractExprCtx(pctx, Cons(vd.vname, bound), b)
    },
    ExIf(c, t, e) -> {
        checkContractExprCtx(pctx, bound, c)?;
        checkContractExprCtx(pctx, bound, t)?;
        checkContractExprCtx(pctx, bound, e)
    },
    ExMatch(scrut, arms) -> {
        checkContractExprCtx(pctx, bound, scrut)?;
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let ab = extendBoundWithPattern(a.pat, bound);
                    match a.guard { Some(g) -> checkContractExprCtx(pctx, ab, g)?, None -> () };
                    checkContractExprCtx(pctx, ab, a.body)?;
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        Ok(())
    },
    ExContract(fc, b) -> {
        let reqCtx = MkPurityCtx {
            pcImpure: pctx.pcImpure,
            pcUserDefs: pctx.pcUserDefs,
            pcFnTypeParams: pctx.pcFnTypeParams,
            pcEntryVars: bound,
            pcEnsBind: None,
            pcInSpec: true,
            pcAllowQuant: true,
            pcInEnsures: false,
            pcInOld: false,
        };
        let decCtx = MkPurityCtx {
            pcImpure: pctx.pcImpure,
            pcUserDefs: pctx.pcUserDefs,
            pcFnTypeParams: pctx.pcFnTypeParams,
            pcEntryVars: bound,
            pcEnsBind: None,
            pcInSpec: true,
            pcAllowQuant: false,
            pcInEnsures: false,
            pcInOld: false,
        };
        let cr = cellNew(fc.fcRequires);
        while (match cellGet(cr) { Nil -> false, _ -> true }) {
            match cellGet(cr) { Cons((_, e), r) -> { checkContractExprCtx(reqCtx, bound, e)?; cellSet(cr, r) }, Nil -> () }
        };
        let cd = cellNew(fc.fcDecreases);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) { Cons((_, e), r) -> { checkContractExprCtx(decCtx, bound, e)?; cellSet(cd, r) }, Nil -> () }
        };
        let ce = cellNew(fc.fcEnsures);
        while (match cellGet(ce) { Nil -> false, _ -> true }) {
            match cellGet(ce) {
                Cons(ec, r) -> {
                    let eb = match ec.ecBind { Some(bn) -> Cons(bn, bound), None -> bound };
                    let ensCtx = MkPurityCtx {
                        pcImpure: pctx.pcImpure,
                        pcUserDefs: pctx.pcUserDefs,
                        pcFnTypeParams: pctx.pcFnTypeParams,
                        pcEntryVars: bound,
                        pcEnsBind: ec.ecBind,
                        pcInSpec: true,
                        pcAllowQuant: true,
                        pcInEnsures: true,
                        pcInOld: false,
                    };
                    checkContractExprCtx(ensCtx, eb, ec.ecExpr)?;
                    cellSet(ce, r)
                },
                Nil -> (),
            }
        };
        checkContractExprCtx(pctx, bound, b)
    },
    ExLoopContract(invs, decs, b) -> {
        let invCtx = MkPurityCtx {
            pcImpure: pctx.pcImpure,
            pcUserDefs: pctx.pcUserDefs,
            pcFnTypeParams: pctx.pcFnTypeParams,
            pcEntryVars: pctx.pcEntryVars,
            pcEnsBind: None,
            pcInSpec: true,
            pcAllowQuant: true,
            pcInEnsures: false,
            pcInOld: false,
        };
        let decCtx = MkPurityCtx {
            pcImpure: pctx.pcImpure,
            pcUserDefs: pctx.pcUserDefs,
            pcFnTypeParams: pctx.pcFnTypeParams,
            pcEntryVars: pctx.pcEntryVars,
            pcEnsBind: None,
            pcInSpec: true,
            pcAllowQuant: false,
            pcInEnsures: false,
            pcInOld: false,
        };
        let ci = cellNew(invs);
        while (match cellGet(ci) { Nil -> false, _ -> true }) {
            match cellGet(ci) { Cons((_, e), r) -> { checkContractExprCtx(invCtx, bound, e)?; cellSet(ci, r) }, Nil -> () }
        };
        let cd = cellNew(decs);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) { Cons((_, e), r) -> { checkContractExprCtx(decCtx, bound, e)?; cellSet(cd, r) }, Nil -> () }
        };
        checkContractExprCtx(pctx, bound, b)
    },
    _ -> Ok(()),
}

def checkContractExprCtxList(pctx: PurityCtx, bound: List String, es: List Form): Result Void String = match es {
    Nil -> Ok(()),
    Cons(h, t) -> { checkContractExprCtx(pctx, bound, h)?; checkContractExprCtxList(pctx, bound, t) },
}

def checkContractExprCtxNamed(pctx: PurityCtx, bound: List String, fs: List (String, Form)): Result Void String = match fs {
    Nil -> Ok(()),
    Cons((_, v), t) -> { checkContractExprCtx(pctx, bound, v)?; checkContractExprCtxNamed(pctx, bound, t) },
}

def checkAllContractPurity(ctx: InferCtx, defs: List Def): Result Void String = {
    let impure = buildImpureFnSet(ctx, defs);
    let userDefs: StrMap Bool = strMapNew();
    let cd0 = cellNew(defs);
    while (match cellGet(cd0) { Nil -> false, _ -> true }) {
        match cellGet(cd0) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(_) -> strMapInsert(userDefs, d.ident, true),
                    ItExtern(_, _, _, _) -> strMapInsert(userDefs, d.ident, true),
                    _ -> (),
                };
                cellSet(cd0, r)
            },
            Nil -> (),
        }
    };
    let cd = cellNew(defs);
    while (match cellGet(cd) { Nil -> false, _ -> true }) {
        match cellGet(cd) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        let pctx = MkPurityCtx {
                            pcImpure: impure,
                            pcUserDefs: userDefs,
                            pcFnTypeParams: schemeTypeParams(f.ty),
                            pcEntryVars: Nil,
                            pcEnsBind: None,
                            pcInSpec: false,
                            pcAllowQuant: false,
                            pcInEnsures: false,
                            pcInOld: false,
                        };
                        checkContractExprCtx(pctx, Nil, f)?
                    },
                    _ -> (),
                };
                cellSet(cd, r)
            },
            Nil -> (),
        }
    };
    Ok(())
}

def checkExhaustivenessInNamed(ctx: InferCtx, fs: List (String, Form)): Result Void String = match fs {
    Nil -> Ok(()),
    Cons((_, v), t) -> { checkExhaustivenessInForm(ctx, v)?; checkExhaustivenessInNamed(ctx, t) },
}

// ============================================================================
// Top-Level Module Inference Driver (`inferProgram`)
// ============================================================================

def methodNamesMatch(expected: String, actual: String): Bool =
    if (expected == actual) true
    else if ((expected == "$op$plus" && actual == "add") || (expected == "add" && actual == "$op$plus")) true
    else if ((expected == "$op$minus" && actual == "sub") || (expected == "sub" && actual == "$op$minus")) true
    else if ((expected == "$op$star" && actual == "mul") || (expected == "mul" && actual == "$op$star")) true
    else if ((expected == "$op$slash" && actual == "div") || (expected == "div" && actual == "$op$slash")) true
    else if ((expected == "$op$rem" && actual == "rem") || (expected == "rem" && actual == "$op$rem")) true
    else if (expected == "neg" && actual == "$op$minus") true
    else if ((expected == "$op$amp" && actual == "bitAnd") || (expected == "bitAnd" && actual == "$op$amp")) true
    else if ((expected == "$op$bar" && actual == "bitOr") || (expected == "bitOr" && actual == "$op$bar")) true
    else if ((expected == "$op$caret" && actual == "bitXor") || (expected == "bitXor" && actual == "$op$caret")) true
    else if ((expected == "$op$tilde" && actual == "bitNot") || (expected == "bitNot" && actual == "$op$tilde")) true
    else if ((expected == "$op$lt_lt" && (actual == "shl" || actual == "bitShl")) || (expected == "shl" && actual == "$op$lt_lt")) true
    else if ((expected == "$op$gt_gt" && (actual == "shr" || actual == "bitShr")) || (expected == "shr" && actual == "$op$gt_gt")) true
    else if ((expected == "$op$gt_gt_gt" && (actual == "ushr" || actual == "bitUshr")) || (expected == "ushr" && actual == "$op$gt_gt_gt")) true
    else if ((expected == "eq" && actual == "$op$eq_eq") || (expected == "$op$eq_eq" && actual == "eq")) true
    else false

def findMatchingMethodImpl(impls: List MethodImpl, expectedName: String): Option MethodImpl = match impls {
    Nil -> None,
    Cons(mi, r) -> if (methodNamesMatch(expectedName, mi.implName)) Some(mi) else findMatchingMethodImpl(r, expectedName),
}

def extractFieldDecls(fs: List FieldDecl, ctx: InferCtx, sp: Span, named: Bool, fixedModeOpt: Option Type): Result (Option (List String), List Type) String = {
    let names = cellNew(Nil);
    let tys = cellNew(Nil);
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(fd, r) -> {
                let et = expandTypeWithMode(ctx, fd.fty, Nil, sp, fixedModeOpt)?;
                cellSet(tys, listAppend(cellGet(tys), [et]));
                if (named) {
                    match fd.fname {
                        Some(nm) -> cellSet(names, listAppend(cellGet(names), [nm])),
                        None -> (),
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    Ok((if (named) Some(cellGet(names)) else None, cellGet(tys)))
}

def rawTypeNeedsMode(ctx: InferCtx, ty: Type, visiting: List String): Bool = match ty {
    TyVoid -> false,
    TyVar(_) -> false,
    TyArr(_, _, _) -> true,
    TyTuple(es) -> rawTypeListNeedsMode(ctx, es, visiting),
    TyCon(name) ->
        if (strMapContains(ctx.modeAdtSet, name)) true
        else match strMapGet(ctx.aliasReg, name) {
            Some((params, target)) ->
                if (listLen(params) == 0 && !listContainsStr(visiting, name)) {
                    rawTypeNeedsMode(ctx, target, Cons(name, visiting))
                } else false,
            None -> false,
        },
    TyComp(_, _) -> {
        let args = cellNew(Nil);
        let curr = cellNew(ty);
        let looping = cellNew(true);
        while (cellGet(looping)) {
            match cellGet(curr) {
                TyComp(b, a) -> { cellSet(args, Cons(a, cellGet(args))); cellSet(curr, b) },
                _ -> cellSet(looping, false),
            }
        };
        let argList = cellGet(args);
        let head = cellGet(curr);
        if (rawTypeListNeedsMode(ctx, argList, visiting)) true
        else match head {
            TyCon(name) ->
                if (strMapContains(ctx.modeAdtSet, name)) true
                else match strMapGet(ctx.aliasReg, name) {
                    Some((params, target)) ->
                        if (listLen(params) == listLen(argList) && !listContainsStr(visiting, name)) {
                            let sub = buildPairMap(params, argList);
                            rawTypeNeedsMode(ctx, applyExplicitSubst(target, sub), Cons(name, visiting))
                        } else false,
                    None -> false,
                },
            _ -> rawTypeNeedsMode(ctx, head, visiting),
        }
    },
}

def rawTypeListNeedsMode(ctx: InferCtx, ts: List Type, visiting: List String): Bool = match ts {
    Nil -> false,
    Cons(h, r) -> if (rawTypeNeedsMode(ctx, h, visiting)) true else rawTypeListNeedsMode(ctx, r, visiting),
}

def variantsNeedMode(ctx: InferCtx, vs: List VariantDef): Bool = match vs {
    Nil -> false,
    Cons(vd, r) -> {
        let fds = match vd.vbody {
            VarUnit -> Nil,
            VarTuple(fs) -> fs,
            VarStruct(fs) -> fs,
        };
        let hit = cellNew(false);
        let cf = cellNew(fds);
        while (match cellGet(cf) { Nil -> false, _ -> !cellGet(hit) }) {
            match cellGet(cf) {
                Cons(fd, rf) -> {
                    if (rawTypeNeedsMode(ctx, fd.fty, Nil)) cellSet(hit, true) else ();
                    cellSet(cf, rf)
                },
                Nil -> (),
            }
        };
        if (cellGet(hit)) true else variantsNeedMode(ctx, r)
    },
}

def computeModeAdts(ctx: InferCtx, rawDefs: List Def): Void = {
    let changed = cellNew(true);
    while (cellGet(changed)) {
        cellSet(changed, false);
        let cur = cellNew(rawDefs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(d, r) -> {
                    match d.item {
                        ItAlg(_, variants) ->
                            if (!strMapContains(ctx.modeAdtSet, d.ident) && variantsNeedMode(ctx, variants)) {
                                strMapInsert(ctx.modeAdtSet, d.ident, true);
                                cellSet(changed, true)
                            } else (),
                        _ -> (),
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    }
}

def inferPass1Aliases(ctx: InferCtx, rawDefs: List Def): Result Void String = {
    // Pass 1: Register & validate type aliases (+ provisional kinds)
    let aliasNames = cellNew(Nil);
    let aliasParamKindMaps: StrMap (List (String, Kind)) = strMapNew();
    let cur1 = cellNew(rawDefs);
    while (match cellGet(cur1) { Nil -> false, _ -> true }) {
        match cellGet(cur1) {
            Cons(d, r) -> {
                match d.item {
                    ItAlias(ps, scm) -> {
                        strMapInsert(ctx.aliasReg, d.ident, (ps, schemeBody(scm)));
                        let pks = cellNew(Nil);
                        let pPairs = cellNew(Nil);
                        let cp = cellNew(ps);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(p, rp) -> {
                                    let kv = freshKindVar(ctx);
                                    cellSet(pks, listAppend(cellGet(pks), [kv]));
                                    cellSet(pPairs, listAppend(cellGet(pPairs), [(p, kv)]));
                                    cellSet(cp, rp)
                                },
                                Nil -> (),
                            }
                        };
                        strMapInsert(ctx.tyConKinds, d.ident, buildArrowKind(cellGet(pks), KStar));
                        strMapInsert(aliasParamKindMaps, d.ident, cellGet(pPairs));
                        cellSet(aliasNames, listAppend(cellGet(aliasNames), [(d.ident, ps, d.dpos)]))
                    },
                    ItAlg(ps, _) -> {
                        let pks = cellNew(Nil);
                        let cp = cellNew(ps);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(_, rp) -> {
                                    cellSet(pks, listAppend(cellGet(pks), [freshKindVar(ctx)]));
                                    cellSet(cp, rp)
                                },
                                Nil -> (),
                            }
                        };
                        strMapInsert(ctx.tyConKinds, d.ident, buildArrowKind(cellGet(pks), KStar))
                    },
                    _ -> (),
                };
                cellSet(cur1, r)
            },
            Nil -> (),
        }
    };
    let cur1b = cellNew(cellGet(aliasNames));
    while (match cellGet(cur1b) { Nil -> false, _ -> true }) {
        match cellGet(cur1b) {
            Cons((anm, ps, sp), r) -> {
                let tvArgs = cellNew(Nil);
                let cp = cellNew(ps);
                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                    match cellGet(cp) {
                        Cons(p, rp) -> { cellSet(tvArgs, listAppend(cellGet(tvArgs), [TyVar(p)])); cellSet(cp, rp) },
                        Nil -> (),
                    }
                };
                let checkTy = match cellGet(tvArgs) {
                    Nil -> TyCon(anm),
                    args -> composeTypes(Cons(TyCon(anm), args)),
                };
                let expanded = expandType(ctx, checkTy, sp)?;
                match strMapGet(aliasParamKindMaps, anm) {
                    Some(pairs) -> {
                        let tvKinds: StrMap Kind = strMapNew();
                        let curP = cellNew(pairs);
                        while (match cellGet(curP) { Nil -> false, _ -> true }) {
                            match cellGet(curP) {
                                Cons((pn, pk), rp) -> { strMapInsert(tvKinds, pn, pk); cellSet(curP, rp) },
                                Nil -> (),
                            }
                        };
                        let resK = inferTypeKind(ctx, expanded, tvKinds, sp)?;
                        let pksFinal = cellNew(Nil);
                        let curP2 = cellNew(pairs);
                        while (match cellGet(curP2) { Nil -> false, _ -> true }) {
                            match cellGet(curP2) {
                                Cons((_, pk), rp) -> {
                                    cellSet(pksFinal, listAppend(cellGet(pksFinal), [defaultKindToStar(ctx.kindSubst, pk)]));
                                    cellSet(curP2, rp)
                                },
                                Nil -> (),
                            }
                        };
                        strMapInsert(ctx.tyConKinds, anm, buildArrowKind(cellGet(pksFinal), defaultKindToStar(ctx.kindSubst, resK)))
                    },
                    None -> (),
                };
                cellSet(cur1b, r)
            },
            Nil -> (),
        }
    };

    Ok(())
}

def inferPass2Adts(ctx: InferCtx, baseMap: StrMap Scheme, rawDefs: List Def): Result Void String = {
    // Seed default built-in ADT constructors (`List`, `Unit`, `Named`, `Prod`, `Sum`) in baseMap
    let builtinAdts = cellNew(["List", "Unit", "Named", "Prod", "Sum"]);
    while (match cellGet(builtinAdts) { Nil -> false, _ -> true }) {
        match cellGet(builtinAdts) {
            Cons(anm, ra) -> {
                match strMapGet(ctx.adtReg, anm) {
                    Some(defAdt) -> {
                        let cv = cellNew(defAdt.variants);
                        while (match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(vi, r) -> { strMapInsert(baseMap, vi.vname, vi.ctorScm); cellSet(cv, r) },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                };
                cellSet(builtinAdts, ra)
            },
            Nil -> (),
        }
    };

    // Compute which ADTs directly or transitively store function closures (`modeAdtSet`)
    computeModeAdts(ctx, rawDefs);

    // Pass 2: Process ADT declarations (pre-seed kinds for recursive/mutually recursive ADTs)
    let adtParamKindMaps: StrMap (List (String, Kind)) = strMapNew();
    let cur2Pre = cellNew(rawDefs);
    while (match cellGet(cur2Pre) { Nil -> false, _ -> true }) {
        match cellGet(cur2Pre) {
            Cons(d, r) -> {
                match d.item {
                    ItAlg(userTparams, _) -> {
                        let hasMode = strMapContains(ctx.modeAdtSet, d.ident);
                        let pks = cellNew(if (hasMode) [KStar] else Nil);
                        let pPairs = cellNew(if (hasMode) [(".$m_adt", KStar)] else Nil);
                        let cp = cellNew(userTparams);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(p, rp) -> {
                                    let kv = freshKindVar(ctx);
                                    cellSet(pks, listAppend(cellGet(pks), [kv]));
                                    cellSet(pPairs, listAppend(cellGet(pPairs), [(p, kv)]));
                                    cellSet(cp, rp)
                                },
                                Nil -> (),
                            }
                        };
                        strMapInsert(ctx.tyConKinds, d.ident, buildArrowKind(cellGet(pks), KStar));
                        strMapInsert(adtParamKindMaps, d.ident, cellGet(pPairs))
                    },
                    _ -> (),
                };
                cellSet(cur2Pre, r)
            },
            Nil -> (),
        }
    };
    let cur2 = cellNew(rawDefs);
    while (match cellGet(cur2) { Nil -> false, _ -> true }) {
        match cellGet(cur2) {
            Cons(d, r) -> {
                match d.item {
                    ItAlg(userTparams, variants) -> {
                        let hasMode = strMapContains(ctx.modeAdtSet, d.ident);
                        let tparams = if (hasMode) Cons(".$m_adt", userTparams) else userTparams;
                        let fixedModeOpt: Option Type = if (hasMode) Some(TyVar(".$m_adt")) else None;
                        let tvKinds: StrMap Kind = strMapNew();
                        match strMapGet(adtParamKindMaps, d.ident) {
                            Some(pairs) -> {
                                let cp0 = cellNew(pairs);
                                while (match cellGet(cp0) { Nil -> false, _ -> true }) {
                                    match cellGet(cp0) {
                                        Cons((pn, pk), rp) -> { strMapInsert(tvKinds, pn, pk); cellSet(cp0, rp) },
                                        Nil -> (),
                                    }
                                }
                            },
                            None -> (),
                        };
                        let paramVars = cellNew(Nil);
                        let cp = cellNew(tparams);
                        while (match cellGet(cp) { Nil -> false, _ -> true }) {
                            match cellGet(cp) {
                                Cons(p, rp) -> { cellSet(paramVars, listAppend(cellGet(paramVars), [TyVar(p)])); cellSet(cp, rp) },
                                Nil -> (),
                            }
                        };
                        let resTy = composeTypes(Cons(TyCon(d.ident), cellGet(paramVars)));
                        let vinfos = cellNew(Nil);
                        let tagIdx = cellNew(0);
                        let cv = cellNew(variants);
                        while (match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(vd, rv) -> {
                                    let (fnames, ftys) = match vd.vbody {
                                        VarUnit -> (None, Nil),
                                        VarTuple(fs) -> extractFieldDecls(fs, ctx, d.dpos, false, fixedModeOpt)?,
                                        VarStruct(fs) -> extractFieldDecls(fs, ctx, d.dpos, true, fixedModeOpt)?,
                                    };
                                    let cft = cellNew(ftys);
                                    while (match cellGet(cft) { Nil -> false, _ -> true }) {
                                        match cellGet(cft) {
                                            Cons(ft, rft) -> {
                                                checkTypeKindStar(ctx, ft, tvKinds, d.dpos)?;
                                                cellSet(cft, rft)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    let ctorBody = match ftys {
                                        Nil -> resTy,
                                        _ -> TyArr(TyVar(".$m_ctor"), ftys, resTy),
                                    };
                                    let ctorParams = match ftys {
                                        Nil -> tparams,
                                        _ -> Cons(".$m_ctor", tparams),
                                    };
                                    let cscm = match ctorParams {
                                        Nil -> ScmMono(ctorBody),
                                        _ -> ScmPoly(ctorParams, ctorBody),
                                    };
                                    strMapInsert(baseMap, vd.vname, cscm);
                                    strMapInsert(ctx.ctorToAdt, vd.vname, d.ident);
                                    let tg = cellGet(tagIdx);
                                    cellSet(tagIdx, tg + 1);
                                    cellSet(vinfos, listAppend(cellGet(vinfos), [MkVariantInfo {
                                        vname: vd.vname,
                                        tag: tg,
                                        fieldNames: fnames,
                                        fieldTypes: ftys,
                                        ctorScm: cscm,
                                    }]));
                                    cellSet(cv, rv)
                                },
                                Nil -> (),
                            }
                        };
                        match strMapGet(adtParamKindMaps, d.ident) {
                            Some(pairs) -> {
                                let pksFinal = cellNew(Nil);
                                let cp2 = cellNew(pairs);
                                while (match cellGet(cp2) { Nil -> false, _ -> true }) {
                                    match cellGet(cp2) {
                                        Cons((_, pk), rp) -> {
                                            cellSet(pksFinal, listAppend(cellGet(pksFinal), [defaultKindToStar(ctx.kindSubst, pk)]));
                                            cellSet(cp2, rp)
                                        },
                                        Nil -> (),
                                    }
                                };
                                strMapInsert(ctx.tyConKinds, d.ident, buildArrowKind(cellGet(pksFinal), KStar))
                            },
                            None -> (),
                        };
                        let isCS = hasAttrCStruct(d.attrs);
                        if (isCS) {
                            match userTparams {
                                Cons(_, _) -> returnPatErr(d.dpos, "'extern data' type '" + d.ident + "' cannot have type parameters")?,
                                Nil -> (),
                            };
                            match cellGet(vinfos) {
                                Cons(vi0, Nil) -> match vi0.fieldTypes {
                                    Nil -> returnPatErr(d.dpos, "'extern data' type '" + d.ident + "' must have at least one field")?,
                                    _ -> (),
                                },
                                _ -> returnPatErr(d.dpos, "'extern data' type '" + d.ident + "' must have exactly one constructor")?,
                            }
                        } else ();
                        if (!strMapContains(ctx.adtReg, d.ident)) vecPush(ctx.adtNames, d.ident) else ();
                        strMapInsert(ctx.adtReg, d.ident, MkAdtInfo {
                            adtName: d.ident,
                            typeParams: tparams,
                            variants: cellGet(vinfos),
                            isCStruct: isCS,
                        })
                    },
                    _ -> (),
                };
                cellSet(cur2, r)
            },
            Nil -> (),
        }
    };
    validateAllCStructs(ctx, rawDefs)?;

    // Seed built-in concept methods into `baseMap`
    let builtinConcepts = [
        "Add", "Sub", "Mul", "Div", "Rem", "Neg",
        "BitAnd", "BitOr", "BitXor", "BitNot", "Shl", "Shr", "Ushr",
        "Eq", "Ord"
    ];
    let cbc = cellNew(builtinConcepts);
    while (match cellGet(cbc) { Nil -> false, _ -> true }) {
        match cellGet(cbc) {
            Cons(cn, r) -> {
                match strMapGet(ctx.conceptReg, cn) {
                    Some(ci) -> match ci.methods {
                        Cons((mn, ms), _) -> strMapInsert(baseMap, mn, ms),
                        Nil -> (),
                    },
                    None -> (),
                };
                cellSet(cbc, r)
            },
            Nil -> (),
        }
    };

    Ok(())
}

def inferPass3Concepts(ctx: InferCtx, baseMap: StrMap Scheme, rawDefs: List Def): Result Void String = {
    // Pass 3: Process user Concept declarations (3a: register concepts & infer kinds; 3b: validate superclasses)
    let conceptTvKindMaps: StrMap (StrMap Kind) = strMapNew();
    let cur3 = cellNew(rawDefs);
    while (match cellGet(cur3) { Nil -> false, _ -> true }) {
        match cellGet(cur3) {
            Cons(d, r) -> {
                match d.item {
                    ItConcept(tparams, supers, fundeps, methods) -> {
                        match tparams {
                            Nil -> { returnPatErr(d.dpos, "Concept '" + d.ident + "' must have at least one type parameter")?; () },
                            _ -> (),
                        };
                        // Validate FunDeps refer to declared concept type parameters
                        let cfd = cellNew(fundeps);
                        while (match cellGet(cfd) { Nil -> false, _ -> true }) {
                            match cellGet(cfd) {
                                Cons(fd, rfd) -> {
                                    let cl = cellNew(fd.fdLhs);
                                    while (match cellGet(cl) { Nil -> false, _ -> true }) {
                                        match cellGet(cl) {
                                            Cons(v, rv) -> {
                                                if (!listContainsStr(tparams, v)) {
                                                    returnPatErr(d.dpos, "Unknown type parameter '" + v + "' in functional dependency of '" + d.ident + "'")?
                                                } else ();
                                                cellSet(cl, rv)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    let cr = cellNew(fd.fdRhs);
                                    while (match cellGet(cr) { Nil -> false, _ -> true }) {
                                        match cellGet(cr) {
                                            Cons(v, rv) -> {
                                                if (!listContainsStr(tparams, v)) {
                                                    returnPatErr(d.dpos, "Unknown type parameter '" + v + "' in functional dependency of '" + d.ident + "'")?
                                                } else ();
                                                cellSet(cr, rv)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    cellSet(cfd, rfd)
                                },
                                Nil -> (),
                            }
                        };
                        let tvKinds: StrMap Kind = strMapNew();
                        let selfTypeArgs = cellNew(Nil);
                        let pKindVars = cellNew(Nil);
                        let ctp = cellNew(tparams);
                        while (match cellGet(ctp) { Nil -> false, _ -> true }) {
                            match cellGet(ctp) {
                                Cons(tp, rtp) -> {
                                    let kv = freshKindVar(ctx);
                                    strMapInsert(tvKinds, tp, kv);
                                    cellSet(pKindVars, listAppend(cellGet(pKindVars), [kv]));
                                    cellSet(selfTypeArgs, listAppend(cellGet(selfTypeArgs), [TyVar(tp)]));
                                    cellSet(ctp, rtp)
                                },
                                Nil -> (),
                            }
                        };
                        let mInfos = cellNew(Nil);
                        let cm = cellNew(methods);
                        while (match cellGet(cm) { Nil -> false, _ -> true }) {
                            match cellGet(cm) {
                                Cons(md, rm) -> {
                                    let escm = expandScheme(ctx, md.mty, d.dpos)?;
                                    let bty = schemeBody(escm);
                                    checkConstraintsKinds(ctx, schemeConstraints(escm), tvKinds, d.dpos)?;
                                    checkTypeKindStar(ctx, bty, tvKinds, d.dpos)?;
                                    let binders = cellNew(tparams);
                                    let cfv = cellNew(ftvOrdered(bty));
                                    while (match cellGet(cfv) { Nil -> false, _ -> true }) {
                                        match cellGet(cfv) {
                                            Cons(fv, rfv) -> {
                                                cellSet(binders, addUniqueStr(cellGet(binders), fv));
                                                cellSet(cfv, rfv)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    let cs = cellNew([MkConstraint { conceptName: d.ident, typeArgs: cellGet(selfTypeArgs) }]);
                                    let cec = cellNew(schemeConstraints(escm));
                                    while (match cellGet(cec) { Nil -> false, _ -> true }) {
                                        match cellGet(cec) {
                                            Cons(ec, rec) -> {
                                                cellSet(cs, addUniqueConstraint(cellGet(cs), ec));
                                                cellSet(cec, rec)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    let fullScm = ScmPolyConstrained(cellGet(binders), cellGet(cs), bty);
                                    strMapInsert(baseMap, md.mname, fullScm);
                                    strMapInsert(ctx.conceptMethods, md.mname, (d.ident, 0));
                                    cellSet(mInfos, listAppend(cellGet(mInfos), [(md.mname, fullScm)]));
                                    cellSet(cm, rm)
                                },
                                Nil -> (),
                            }
                        };
                        let finalParamKinds = cellNew(Nil);
                        let cpk = cellNew(cellGet(pKindVars));
                        while (match cellGet(cpk) { Nil -> false, _ -> true }) {
                            match cellGet(cpk) {
                                Cons(kv, rkv) -> {
                                    cellSet(finalParamKinds, listAppend(cellGet(finalParamKinds), [defaultKindToStar(ctx.kindSubst, kv)]));
                                    cellSet(cpk, rkv)
                                },
                                Nil -> (),
                            }
                        };
                        let expSupers = cellNew(Nil);
                        let cs0 = cellNew(supers);
                        while (match cellGet(cs0) { Nil -> false, _ -> true }) {
                            match cellGet(cs0) {
                                Cons(sc, rsc) -> {
                                    let expSArgs = expandTypeListInner(ctx, sc.typeArgs, Nil, d.dpos)?;
                                    cellSet(expSupers, listAppend(cellGet(expSupers), [MkConstraint { conceptName: sc.conceptName, typeArgs: expSArgs }]));
                                    cellSet(cs0, rsc)
                                },
                                Nil -> (),
                            }
                        };
                        strMapInsert(conceptTvKindMaps, d.ident, tvKinds);
                        strMapInsert(ctx.conceptReg, d.ident, MkConceptInfo {
                            conceptName: d.ident,
                            typeParams: tparams,
                            paramKinds: cellGet(finalParamKinds),
                            superclasses: cellGet(expSupers),
                            fundeps: fundeps,
                            methods: cellGet(mInfos),
                        })
                    },
                    _ -> (),
                };
                cellSet(cur3, r)
            },
            Nil -> (),
        }
    };
    // Pass 3b: Validate superclass constraints & kinds after all concepts are registered
    let cur3b = cellNew(rawDefs);
    while (match cellGet(cur3b) { Nil -> false, _ -> true }) {
        match cellGet(cur3b) {
            Cons(d, r) -> {
                match d.item {
                    ItConcept(_, _, _, _) -> match strMapGet(ctx.conceptReg, d.ident) {
                        Some(cinfo) -> match strMapGet(conceptTvKindMaps, d.ident) {
                            Some(tvKinds) -> checkConstraintsKinds(ctx, cinfo.superclasses, tvKinds, d.dpos)?,
                            None -> (),
                        },
                        None -> (),
                    },
                    _ -> (),
                };
                cellSet(cur3b, r)
            },
            Nil -> (),
        }
    };

    Ok(())
}

def mkSynthForm(sp: Span, node: Expr): Form =
    MkForm { pos: sp, ty: ScmSlot, annot: None, node: node }

def nthStrOr(xs: List String, idx: Int, fallback: String): String = match xs {
    Nil -> fallback,
    Cons(h, t) -> if (idx == 0) h else nthStrOr(t, idx - 1, fallback),
}

def variantFieldLabel(v: VariantInfo, idx: Int): String = match v.fieldNames {
    Some(ns) -> nthStrOr(ns, idx, intToStr(idx)),
    None -> intToStr(idx),
}

def buildFieldProdExpr(v: VariantInfo, idx: Int, total: Int, sp: Span): Form =
    if (total <= 0) mkSynthForm(sp, ExVar("Unit"))
    else {
        let lbl = variantFieldLabel(v, idx);
        let named = mkSynthForm(sp, ExApply(
            mkSynthForm(sp, ExVar("Named")),
            [mkSynthForm(sp, ExLit(LitStr(lbl))), mkSynthForm(sp, ExVar("$df" + intToStr(idx)))]
        ));
        if (idx + 1 >= total) named
        else mkSynthForm(sp, ExApply(
            mkSynthForm(sp, ExVar("Prod")),
            [named, buildFieldProdExpr(v, idx + 1, total, sp)]
        ))
    }

def buildFieldProdPat(idx: Int, total: Int): Pattern =
    if (total <= 0) PatCtor("Unit", Nil)
    else {
        let namedPat = PatCtor("Named", [PatWild, PatVar("$df" + intToStr(idx), emptySpan())]);
        if (idx + 1 >= total) namedPat
        else PatCtor("Prod", [namedPat, buildFieldProdPat(idx + 1, total)])
    }

def buildVariantCtorPat(v: VariantInfo): Pattern = {
    let n = listLen(v.fieldTypes);
    let psRev = cellNew(Nil);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        cellSet(psRev, Cons(PatVar("$df" + intToStr(cellGet(i)), emptySpan()), cellGet(psRev)));
        cellSet(i, cellGet(i) + 1)
    };
    PatCtor(v.vname, listRev(cellGet(psRev)))
}

def buildVariantCtorExpr(v: VariantInfo, sp: Span): Form = {
    let n = listLen(v.fieldTypes);
    if (n <= 0) mkSynthForm(sp, ExVar(v.vname))
    else {
        let argsRev = cellNew(Nil);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            cellSet(argsRev, Cons(mkSynthForm(sp, ExVar("$df" + intToStr(cellGet(i)))), cellGet(argsRev)));
            cellSet(i, cellGet(i) + 1)
        };
        mkSynthForm(sp, ExApply(mkSynthForm(sp, ExVar(v.vname)), listRev(cellGet(argsRev))))
    }
}

def wrapInSumExpr(expr: Form, idx: Int, isLast: Bool, sp: Span): Form = {
    let inner = if (isLast) expr else mkSynthForm(sp, ExApply(mkSynthForm(sp, ExVar("InL")), [expr]));
    let cur = cellNew(inner);
    let k = cellNew(0);
    while (cellGet(k) < idx) {
        cellSet(cur, mkSynthForm(sp, ExApply(mkSynthForm(sp, ExVar("InR")), [cellGet(cur)])));
        cellSet(k, cellGet(k) + 1)
    };
    cellGet(cur)
}

def wrapInSumPat(pat: Pattern, idx: Int, isLast: Bool): Pattern = {
    let inner = if (isLast) pat else PatCtor("InL", [pat]);
    let cur = cellNew(inner);
    let k = cellNew(0);
    while (cellGet(k) < idx) {
        cellSet(cur, PatCtor("InR", [cellGet(cur)]));
        cellSet(k, cellGet(k) + 1)
    };
    cellGet(cur)
}

def buildAdtToRepForm(ainfo: AdtInfo, scrut: Form, sp: Span): Form = {
    let numVars = listLen(ainfo.variants);
    let armsRev = cellNew(Nil);
    let cv = cellNew(ainfo.variants);
    let vIdx = cellNew(0);
    while (match cellGet(cv) { Nil -> false, _ -> true }) {
        match cellGet(cv) {
            Cons(v, rv) -> {
                let idx = cellGet(vIdx);
                let fieldsExpr = buildFieldProdExpr(v, 0, listLen(v.fieldTypes), sp);
                let bodyExpr =
                    if (numVars == 1) fieldsExpr
                    else {
                        let namedVar = mkSynthForm(sp, ExApply(
                            mkSynthForm(sp, ExVar("Named")),
                            [mkSynthForm(sp, ExLit(LitStr(v.vname))), fieldsExpr]
                        ));
                        wrapInSumExpr(namedVar, idx, idx + 1 >= numVars, sp)
                    };
                cellSet(armsRev, Cons(MkMatchArm { pat: buildVariantCtorPat(v), guard: None, body: bodyExpr }, cellGet(armsRev)));
                cellSet(vIdx, idx + 1);
                cellSet(cv, rv)
            },
            Nil -> (),
        }
    };
    mkSynthForm(sp, ExMatch(scrut, listRev(cellGet(armsRev))))
}

def buildAdtFromRepForm(ainfo: AdtInfo, scrut: Form, sp: Span): Form = {
    let numVars = listLen(ainfo.variants);
    let armsRev = cellNew(Nil);
    let cv = cellNew(ainfo.variants);
    let vIdx = cellNew(0);
    while (match cellGet(cv) { Nil -> false, _ -> true }) {
        match cellGet(cv) {
            Cons(v, rv) -> {
                let idx = cellGet(vIdx);
                let fieldsPat = buildFieldProdPat(0, listLen(v.fieldTypes));
                let armPat =
                    if (numVars == 1) fieldsPat
                    else {
                        let namedPat = PatCtor("Named", [PatWild, fieldsPat]);
                        wrapInSumPat(namedPat, idx, idx + 1 >= numVars)
                    };
                let bodyExpr = buildVariantCtorExpr(v, sp);
                cellSet(armsRev, Cons(MkMatchArm { pat: armPat, guard: None, body: bodyExpr }, cellGet(armsRev)));
                cellSet(vIdx, idx + 1);
                cellSet(cv, rv)
            },
            Nil -> (),
        }
    };
    mkSynthForm(sp, ExMatch(scrut, listRev(cellGet(armsRev))))
}

def isSelfTypeParam(ty: Type, selfTv: String): Bool = match ty {
    TyVar(v) -> v == selfTv,
    _ -> false,
}

def synthesizeDerivedMethodImpls(
    ctx: InferCtx,
    cname: String,
    cinfo: ConceptInfo,
    expArgsFinal: List Type,
    sp: Span
): Result (List MethodImpl) String = match (cinfo.typeParams, expArgsFinal) {
    (Cons(selfTv, Nil), Cons(targetTy, Nil)) -> match decomposeAdtType(ctx.adtReg, targetTy) {
        None -> Err(typeErr(sp, "Cannot derive concept '" + cname + "' for non-ADT type '" + typeToString(targetTy) + "'")),
        Some((adtName, _)) -> match strMapGet(ctx.adtReg, adtName) {
            None -> Err(typeErr(sp, "Unknown ADT '" + adtName + "' when deriving '" + cname + "'")),
            Some(ainfo) -> {
                let implsRev = cellNew(Nil);
                let cm = cellNew(cinfo.methods);
                while (match cellGet(cm) { Nil -> false, _ -> true }) {
                    match cellGet(cm) {
                        Cons((mname, mscm), rm) -> {
                            match schemeBody(mscm) {
                                TyArr(_, paramTys, retTy) -> {
                                    let pDeclsRev = cellNew(Nil);
                                    let callArgsRev = cellNew(Nil);
                                    let cp = cellNew(paramTys);
                                    let idx = cellNew(0);
                                    while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                        match cellGet(cp) {
                                            Cons(pt, rp) -> {
                                                let pName = "$dp" + intToStr(cellGet(idx));
                                                cellSet(pDeclsRev, Cons(MkVarDecl { vname: pName, vscm: ScmSlot }, cellGet(pDeclsRev)));
                                                let pVar = mkSynthForm(sp, ExVar(pName));
                                                let argExpr =
                                                    if (isSelfTypeParam(pt, selfTv)) buildAdtToRepForm(ainfo, pVar, sp)
                                                    else pVar;
                                                cellSet(callArgsRev, Cons(argExpr, cellGet(callArgsRev)));
                                                cellSet(idx, cellGet(idx) + 1);
                                                cellSet(cp, rp)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    let callForm = mkSynthForm(sp, ExApply(mkSynthForm(sp, ExVar(mname)), listRev(cellGet(callArgsRev))));
                                    let bodyForm =
                                        if (isSelfTypeParam(retTy, selfTv)) buildAdtFromRepForm(ainfo, callForm, sp)
                                        else callForm;
                                    let lamForm = mkSynthForm(sp, ExAbs(listRev(cellGet(pDeclsRev)), None, bodyForm));
                                    cellSet(implsRev, Cons(MkMethodImpl { implName: mname, implBody: lamForm }, cellGet(implsRev)))
                                },
                                _ -> (),
                            };
                            cellSet(cm, rm)
                        },
                        Nil -> (),
                    }
                };
                Ok(listRev(cellGet(implsRev)))
            },
        },
    },
    _ -> Err(typeErr(sp, "Generic deriving currently supports single-parameter concepts, got '" + cname + "'")),
}

def inferPass4Instances(ctx: InferCtx, rawDefs: List Def): Result (List Def) String = {
    // Pass 4: Process Instance declarations & synthesize concrete/generic method `Def`s
    let synthDefsRev = cellNew(Nil);
    let userInstListRev = cellNew(Nil);
    let cur4 = cellNew(rawDefs);
    while (match cellGet(cur4) { Nil -> false, _ -> true }) {
        match cellGet(cur4) {
            Cons(d, r) -> {
                match d.item {
                    ItInstance(cname, rawArgs, constraints, impls) -> match strMapGet(ctx.conceptReg, cname) {
                        None -> returnPatErr(d.dpos, "Unknown concept '" + cname + "' in instance")?,
                        Some(cinfo) -> {
                            if (listLen(rawArgs) != listLen(cinfo.typeParams)) {
                                returnPatErr(d.dpos, "Concept '" + cname + "' arity mismatch")?
                            } else ();
                            let expArgs = expandTypeListInner(ctx, rawArgs, Nil, d.dpos)?;
                            let expConstraints = cellNew(Nil);
                            let cc0 = cellNew(constraints);
                            while (match cellGet(cc0) { Nil -> false, _ -> true }) {
                                match cellGet(cc0) {
                                    Cons(c, rc) -> {
                                        let ecArgs = expandTypeListInner(ctx, c.typeArgs, Nil, d.dpos)?;
                                        cellSet(expConstraints, listAppend(cellGet(expConstraints), [MkConstraint { conceptName: c.conceptName, typeArgs: ecArgs }]));
                                        cellSet(cc0, rc)
                                    },
                                    Nil -> (),
                                }
                            };
                            let instCs = cellGet(expConstraints);

                            // Kind-check instance target arguments & constraints
                            let instTvKinds: StrMap Kind = strMapNew();
                            checkConstraintsKinds(ctx, instCs, instTvKinds, d.dpos)?;
                            let pinnedArgs = cellNew(Nil);
                            let caKind = cellNew(expArgs);
                            let cpkKind = cellNew(cinfo.paramKinds);
                            while (match cellGet(caKind) { Nil -> false, _ -> true }) {
                                match (cellGet(caKind), cellGet(cpkKind)) {
                                    (Cons(ta, ra), Cons(pk, rk)) -> {
                                        let ak = inferTypeKind(ctx, ta, instTvKinds, d.dpos)?;
                                        unifyKinds(ctx.kindSubst, ak, pk, d.dpos)?;
                                        let zpk = zonkKind(ctx.kindSubst, pk);
                                        let fixedTa = match zpk {
                                            KArr(_, _) -> pinHeadAdtModeToLocal(ctx.modeAdtSet, ta),
                                            _ -> ta,
                                        };
                                        cellSet(pinnedArgs, listAppend(cellGet(pinnedArgs), [fixedTa]));
                                        cellSet(caKind, ra);
                                        cellSet(cpkKind, rk)
                                    },
                                    _ -> cellSet(caKind, Nil),
                                }
                            };
                            let expArgsFinal = cellGet(pinnedArgs);

                            let instTvs = cellNew(Nil);
                            let ca = cellNew(expArgsFinal);
                            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                                match cellGet(ca) {
                                    Cons(ta, ra) -> {
                                        let cf = cellNew(ftvOrdered(ta));
                                        while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                            match cellGet(cf) {
                                                Cons(fv, rf) -> { cellSet(instTvs, addUniqueStr(cellGet(instTvs), fv)); cellSet(cf, rf) },
                                                Nil -> (),
                                            }
                                        };
                                        cellSet(ca, ra)
                                    },
                                    Nil -> (),
                                }
                            };
                            let cc = cellNew(instCs);
                            while (match cellGet(cc) { Nil -> false, _ -> true }) {
                                match cellGet(cc) {
                                    Cons(c, rc) -> {
                                        let cf = cellNew(collectFtvsInTypeList(c.typeArgs));
                                        while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                            match cellGet(cf) {
                                                Cons(fv, rf) -> { cellSet(instTvs, addUniqueStr(cellGet(instTvs), fv)); cellSet(cf, rf) },
                                                Nil -> (),
                                            }
                                        };
                                        cellSet(cc, rc)
                                    },
                                    Nil -> (),
                                }
                            };

                            let mangledArgs = joinMangledTypes(expArgsFinal, "_");
                            let paramSub = buildPairMap(cinfo.typeParams, expArgsFinal);
                            let implMap: StrMap String = strMapNew();

                            let effectiveImpls = match impls {
                                Nil -> synthesizeDerivedMethodImpls(ctx, cname, cinfo, expArgsFinal, d.dpos)?,
                                _ -> impls,
                            };
                            let cm = cellNew(cinfo.methods);
                            while (match cellGet(cm) { Nil -> false, _ -> true }) {
                                match cellGet(cm) {
                                    Cons((expectedName, expectedScm), rm) -> {
                                        match findMatchingMethodImpl(effectiveImpls, expectedName) {
                                            None -> returnPatErr(d.dpos, "Instance of '" + cname + "' missing method '" + expectedName + "'")?,
                                            Some(mi) -> {
                                                let mangledFn = "__inst_" + replaceDots(cname) + "_" + mangledArgs + "_" + expectedName;
                                                strMapInsert(implMap, expectedName, mangledFn);
                                                let instBodyTy = applyExplicitSubst(schemeBody(expectedScm), paramSub);
                                                let mTvs = cellNew(cellGet(instTvs));
                                                let cf = cellNew(ftvOrdered(instBodyTy));
                                                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                                    match cellGet(cf) {
                                                        Cons(fv, rf) -> { cellSet(mTvs, addUniqueStr(cellGet(mTvs), fv)); cellSet(cf, rf) },
                                                        Nil -> (),
                                                    }
                                                };
                                                let tvList = cellGet(mTvs);
                                                let mScm = match tvList {
                                                    Nil -> ScmMono(instBodyTy),
                                                    _ -> match instCs {
                                                        Nil -> ScmPoly(tvList, instBodyTy),
                                                        _ -> ScmPolyConstrained(tvList, instCs, instBodyTy),
                                                    },
                                                };
                                                let bform = MkForm {
                                                    pos: mi.implBody.pos,
                                                    ty: mi.implBody.ty,
                                                    annot: Some(mScm),
                                                    node: mi.implBody.node,
                                                };
                                                cellSet(synthDefsRev, Cons(MkDef {
                                                    ident: mangledFn,
                                                    dpos: d.dpos,
                                                    vis: VisPublic,
                                                    attrs: Nil,
                                                    item: ItForm(bform),
                                                }, cellGet(synthDefsRev)))
                                            },
                                        };
                                        cellSet(cm, rm)
                                    },
                                    Nil -> (),
                                }
                            };

                            // Prepend user instance so it takes priority over built-in placeholders!
                            let instInfo = MkInstanceInfo {
                                conceptName: cname,
                                typeParams: cellGet(instTvs),
                                constraints: instCs,
                                targetTypes: expArgsFinal,
                                methodImpls: implMap,
                            };
                            cellSet(ctx.instanceReg, Cons(instInfo, cellGet(ctx.instanceReg)));
                            cellSet(userInstListRev, Cons((instInfo, d.dpos), cellGet(userInstListRev)))
                        },
                    },
                    _ -> (),
                };
                cellSet(cur4, r)
            },
            Nil -> (),
        }
    };

    // Pass 4.5: Verify every user instance satisfies all superclass instances
    let cur4b = cellNew(listRev(cellGet(userInstListRev)));
    while (match cellGet(cur4b) { Nil -> false, _ -> true }) {
        match cellGet(cur4b) {
            Cons((instInfo, sp), r) -> {
                match strMapGet(ctx.conceptReg, instInfo.conceptName) {
                    Some(cinfo) -> match cinfo.superclasses {
                        Nil -> (),
                        supers -> {
                            let paramSub = buildPairMap(cinfo.typeParams, instInfo.targetTypes);
                            let supRes: Cell (List WantedConstraint) = cellNew(Nil);
                            dischargeSubConstraints(ctx, supers, paramSub, sp, instInfo.constraints, supRes, 0)?;
                            match cellGet(supRes) {
                                Cons(unmet, _) -> {
                                    returnPatErr(sp, "Instance '" + instInfo.conceptName + "' is missing superclass instance '" + unmet.wcConcept + "' for (" + joinTypeListStr(unmet.wcArgs) + ")")?;
                                    ()
                                },
                                Nil -> (),
                            }
                        },
                    },
                    None -> (),
                };
                cellSet(cur4b, r)
            },
            Nil -> (),
        }
    };

    Ok(listRev(cellGet(synthDefsRev)))
}

def pinHeadAdtModeToLocal(modeAdtSet: StrMap Bool, ty: Type): Type = match ty {
    TyComp(_, _) -> {
        let args = cellNew(Nil);
        let curr = cellNew(ty);
        let looping = cellNew(true);
        while (cellGet(looping)) {
            match cellGet(curr) {
                TyComp(b, a) -> { cellSet(args, Cons(a, cellGet(args))); cellSet(curr, b) },
                _ -> cellSet(looping, false),
            }
        };
        match (cellGet(curr), cellGet(args)) {
            (TyCon(nm), Cons(TyVar(mv), rest)) ->
                if (strMapContains(modeAdtSet, nm) && isModeVarName(mv)) {
                    composeTypes(Cons(TyCon(nm), Cons(TyCon("$Local"), rest)))
                } else ty,
            _ -> ty,
        }
    },
    _ -> ty,
}

def isMutableAllocCallee(nm: String): Bool =
    nm == "cellNew" || nm == "arrayNew" || nm == "arrayNewZeroed" || nm == "ptrAllocBytes"
    || nm == "std.vec.vecNew" || nm == "std.vec.vecWithCap" || nm == "vecNew" || nm == "vecWithCap"
    || nm == "std.map.strMapNew" || nm == "std.map.intMapNew" || nm == "strMapNew" || nm == "intMapNew"
    || nm == "std.buf.bufNew" || nm == "bufNew"

def formCallsMutableAlloc(f: Form): Bool = match f.node {
    ExLit(_) -> false,
    ExVar(_) -> false,
    ExAbs(_, _, _) -> false,
    ExTuple(es) -> formListCallsMutableAlloc(es),
    ExList(es) -> formListCallsMutableAlloc(es),
    ExBlock(es) -> formListCallsMutableAlloc(es),
    ExStructInit(_, fs) -> namedFormsCallMutableAlloc(fs),
    ExApply(c, args) -> {
        let directHit = match c.node {
            ExVar(nm) -> isMutableAllocCallee(nm),
            _ -> false,
        };
        directHit || formCallsMutableAlloc(c) || formListCallsMutableAlloc(args)
    },
    ExBin(_, l, r) -> formCallsMutableAlloc(l) || formCallsMutableAlloc(r),
    ExUn(_, e) -> formCallsMutableAlloc(e),
    ExField(e, _) -> formCallsMutableAlloc(e),
    ExTry(e) -> formCallsMutableAlloc(e),
    ExIf(c, t, e) -> formCallsMutableAlloc(c) || formCallsMutableAlloc(t) || formCallsMutableAlloc(e),
    ExWhile(c, b) -> formCallsMutableAlloc(c) || formCallsMutableAlloc(b),
    ExContract(_, b) -> formCallsMutableAlloc(b),
    ExLoopContract(_, _, b) -> formCallsMutableAlloc(b),
    ExLet(_, v, b) -> formCallsMutableAlloc(v) || formCallsMutableAlloc(b),
    ExMatch(s, arms) -> {
        if (formCallsMutableAlloc(s)) true
        else {
            let hit = cellNew(false);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let gHit = match a.guard { Some(g) -> formCallsMutableAlloc(g), None -> false };
                        if (gHit || formCallsMutableAlloc(a.body)) cellSet(hit, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        }
    },
}

def formListCallsMutableAlloc(es: List Form): Bool = match es {
    Nil -> false,
    Cons(h, r) -> formCallsMutableAlloc(h) || formListCallsMutableAlloc(r),
}

def namedFormsCallMutableAlloc(fs: List (String, Form)): Bool = match fs {
    Nil -> false,
    Cons((_, v), r) -> formCallsMutableAlloc(v) || namedFormsCallMutableAlloc(r),
}

def formRefsAnySet(f: Form, bound: List String, targetSet: StrMap Bool): Bool = match f.node {
    ExLit(_) -> false,
    ExVar(nm) -> !listContainsStr(bound, nm) && strMapContains(targetSet, nm),
    ExTuple(es) -> formListRefsAnySet(es, bound, targetSet),
    ExList(es) -> formListRefsAnySet(es, bound, targetSet),
    ExBlock(es) -> formListRefsAnySet(es, bound, targetSet),
    ExStructInit(_, fs) -> namedFormsRefAnySet(fs, bound, targetSet),
    ExApply(c, args) -> formRefsAnySet(c, bound, targetSet) || formListRefsAnySet(args, bound, targetSet),
    ExAbs(ps, _, b) -> formRefsAnySet(b, extendBoundWithVarDecls(ps, bound), targetSet),
    ExBin(_, l, r) -> formRefsAnySet(l, bound, targetSet) || formRefsAnySet(r, bound, targetSet),
    ExUn(_, e) -> formRefsAnySet(e, bound, targetSet),
    ExField(e, _) -> formRefsAnySet(e, bound, targetSet),
    ExTry(e) -> formRefsAnySet(e, bound, targetSet),
    ExIf(c, t, e) -> formRefsAnySet(c, bound, targetSet) || formRefsAnySet(t, bound, targetSet) || formRefsAnySet(e, bound, targetSet),
    ExWhile(c, b) -> formRefsAnySet(c, bound, targetSet) || formRefsAnySet(b, bound, targetSet),
    ExContract(_, b) -> formRefsAnySet(b, bound, targetSet),
    ExLoopContract(_, _, b) -> formRefsAnySet(b, bound, targetSet),
    ExLet(vd, v, b) -> formRefsAnySet(v, bound, targetSet) || formRefsAnySet(b, Cons(vd.vname, bound), targetSet),
    ExMatch(s, arms) -> {
        if (formRefsAnySet(s, bound, targetSet)) true
        else {
            let hit = cellNew(false);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ab = extendBoundWithPattern(a.pat, bound);
                        let gHit = match a.guard { Some(g) -> formRefsAnySet(g, ab, targetSet), None -> false };
                        if (gHit || formRefsAnySet(a.body, ab, targetSet)) cellSet(hit, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        }
    },
}

def formListRefsAnySet(es: List Form, bound: List String, targetSet: StrMap Bool): Bool = match es {
    Nil -> false,
    Cons(h, r) -> formRefsAnySet(h, bound, targetSet) || formListRefsAnySet(r, bound, targetSet),
}

def namedFormsRefAnySet(fs: List (String, Form), bound: List String, targetSet: StrMap Bool): Bool = match fs {
    Nil -> false,
    Cons((_, v), r) -> formRefsAnySet(v, bound, targetSet) || namedFormsRefAnySet(r, bound, targetSet),
}

def precomputeTopTaint(ctx: InferCtx, allDefs: List Def, expandedAnnots: StrMap Scheme): Void = {
    let cur0 = cellNew(allDefs);
    while (match cellGet(cur0) { Nil -> false, _ -> true }) {
        match cellGet(cur0) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        let isAbs = match f.node { ExAbs(_, _, _) -> true, _ -> false };
                        if (!isAbs) {
                            strMapInsert(ctx.globalValSet, d.ident, true);
                            let annotNonSend = match strMapGet(expandedAnnots, d.ident) {
                                Some(escm) -> match evalSendStatus(ctx, schemeBody(escm), None, Nil) {
                                    SendNo -> true,
                                    _ -> false,
                                },
                                None -> false,
                            };
                            if (annotNonSend || formCallsMutableAlloc(f)) {
                                strMapInsert(ctx.taintedTopSet, d.ident, true)
                            } else ()
                        } else ()
                    },
                    _ -> (),
                };
                cellSet(cur0, r)
            },
            Nil -> (),
        }
    };
    let changed = cellNew(true);
    while (cellGet(changed)) {
        cellSet(changed, false);
        let cur = cellNew(allDefs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(d, r) -> {
                    match d.item {
                        ItForm(f) ->
                            if (!strMapContains(ctx.taintedTopSet, d.ident) && formRefsAnySet(f, Nil, ctx.taintedTopSet)) {
                                strMapInsert(ctx.taintedTopSet, d.ident, true);
                                cellSet(changed, true)
                            } else (),
                        _ -> (),
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    }
}

def pinOuterSchemeLocal(scm: Scheme): Scheme = match scm {
    ScmMono(TyArr(_, ps, r)) -> ScmMono(TyArr(TyCon("$Local"), ps, r)),
    ScmPoly(vs, TyArr(_, ps, r)) -> ScmPoly(vs, TyArr(TyCon("$Local"), ps, r)),
    ScmPolyConstrained(vs, cs, TyArr(_, ps, r)) -> ScmPolyConstrained(vs, cs, TyArr(TyCon("$Local"), ps, r)),
    other -> other,
}

def instOnlyModeVars(ctx: InferCtx, scm: Scheme): (List String, List ConstraintSpec, Type) = match scm {
    ScmSlot -> (Nil, Nil, freshVar(ctx)),
    ScmMono(t) -> (Nil, Nil, t),
    ScmPoly(vs, t) -> {
        let userVs = cellNew(Nil);
        let sub: StrMap Type = strMapNew();
        let cur = cellNew(vs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    if (isModeVarName(v)) strMapInsert(sub, v, freshModeVar(ctx))
                    else cellSet(userVs, listAppend(cellGet(userVs), [v]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        (cellGet(userVs), Nil, applyExplicitSubst(t, sub))
    },
    ScmPolyConstrained(vs, cs, t) -> {
        let userVs = cellNew(Nil);
        let sub: StrMap Type = strMapNew();
        let cur = cellNew(vs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(v, r) -> {
                    if (isModeVarName(v)) strMapInsert(sub, v, freshModeVar(ctx))
                    else cellSet(userVs, listAppend(cellGet(userVs), [v]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let ncs = fmap((c: ConstraintSpec) -> MkConstraint { conceptName: c.conceptName, typeArgs: applyExplicitSubstList(c.typeArgs, sub) }, cs);
        (cellGet(userVs), ncs, applyExplicitSubst(t, sub))
    },
}

// ============================================================================
// Phantom Capture-Mode Erasure (Zero Monomorphization / Codegen Overhead)
// ============================================================================

def filterNonModeStrings(xs: List String): List String = match xs {
    Nil -> Nil,
    Cons(h, r) -> if (isModeVarName(h)) filterNonModeStrings(r) else Cons(h, filterNonModeStrings(r)),
}

def eraseTypeModes(modeAdtSet: StrMap Bool, ty: Type): Type = match ty {
    TyVoid -> TyVoid,
    TyCon(n) -> if (n == "$Local" || n == "$Shared" || n == "$Scoped") TyVoid else ty,
    TyVar(v) -> if (isModeVarName(v)) TyVoid else ty,
    TyArr(_, ps, r) -> TyArr(TyVoid, eraseTypeListModes(modeAdtSet, ps), eraseTypeModes(modeAdtSet, r)),
    TyTuple(es) -> TyTuple(eraseTypeListModes(modeAdtSet, es)),
    TyComp(_, _) -> {
        let args = cellNew(Nil);
        let curr = cellNew(ty);
        let looping = cellNew(true);
        while (cellGet(looping)) {
            match cellGet(curr) {
                TyComp(b, a) -> {
                    cellSet(args, Cons(eraseTypeModes(modeAdtSet, a), cellGet(args)));
                    cellSet(curr, b)
                },
                _ -> cellSet(looping, false),
            }
        };
        let head = cellGet(curr);
        let rawArgs = cellGet(args);
        match head {
            TyCon(nm) ->
                if (strMapContains(modeAdtSet, nm)) {
                    let restArgs = match rawArgs {
                        Cons(_, r) -> r,
                        Nil -> Nil,
                    };
                    composeTypes(Cons(TyCon(nm), restArgs))
                } else composeTypes(Cons(TyCon(nm), rawArgs)),
            _ -> composeTypes(Cons(eraseTypeModes(modeAdtSet, head), rawArgs)),
        }
    },
}

def eraseTypeListModes(modeAdtSet: StrMap Bool, ts: List Type): List Type =
    fmap((t) -> eraseTypeModes(modeAdtSet, t), ts)

def eraseConstraintsModes(modeAdtSet: StrMap Bool, cs: List ConstraintSpec): List ConstraintSpec = match cs {
    Nil -> Nil,
    Cons(c, r) ->
        if (c.conceptName == "SendIf" || c.conceptName == "NoScoped") eraseConstraintsModes(modeAdtSet, r)
        else Cons(
            MkConstraint { conceptName: c.conceptName, typeArgs: eraseTypeListModes(modeAdtSet, c.typeArgs) },
            eraseConstraintsModes(modeAdtSet, r)
        ),
}

def eraseSchemeModes(modeAdtSet: StrMap Bool, scm: Scheme): Scheme = match scm {
    ScmSlot -> ScmSlot,
    ScmMono(t) -> ScmMono(eraseTypeModes(modeAdtSet, t)),
    ScmPoly(vs, t) -> {
        let nvs = filterNonModeStrings(vs);
        let nt = eraseTypeModes(modeAdtSet, t);
        match nvs {
            Nil -> ScmMono(nt),
            _ -> ScmPoly(nvs, nt),
        }
    },
    ScmPolyConstrained(vs, cs, t) -> {
        let nvs = filterNonModeStrings(vs);
        let ncs = eraseConstraintsModes(modeAdtSet, cs);
        let nt = eraseTypeModes(modeAdtSet, t);
        match (nvs, ncs) {
            (Nil, Nil) -> ScmMono(nt),
            (_, Nil) -> ScmPoly(nvs, nt),
            _ -> ScmPolyConstrained(nvs, ncs, nt),
        }
    },
}

def eraseFormModes(modeAdtSet: StrMap Bool, f: Form): Form = {
    let nty = eraseSchemeModes(modeAdtSet, f.ty);
    let nann = fmap((s) -> eraseSchemeModes(modeAdtSet, s), f.annot);
    let nnode = match f.node {
        ExLit(_) -> f.node,
        ExVar(_) -> f.node,
        ExTuple(es) -> ExTuple(fmap((e) -> eraseFormModes(modeAdtSet, e), es)),
        ExList(es) -> ExList(fmap((e) -> eraseFormModes(modeAdtSet, e), es)),
        ExBlock(es) -> ExBlock(fmap((e) -> eraseFormModes(modeAdtSet, e), es)),
        ExStructInit(c, fs) -> ExStructInit(c, fmap((p) -> match p { (k, v) -> (k, eraseFormModes(modeAdtSet, v)) }, fs)),
        ExApply(c, args) -> ExApply(eraseFormModes(modeAdtSet, c), fmap((a) -> eraseFormModes(modeAdtSet, a), args)),
        ExBin(op, l, r) -> ExBin(op, eraseFormModes(modeAdtSet, l), eraseFormModes(modeAdtSet, r)),
        ExUn(op, e) -> ExUn(op, eraseFormModes(modeAdtSet, e)),
        ExField(e, nm) -> ExField(eraseFormModes(modeAdtSet, e), nm),
        ExTry(e) -> ExTry(eraseFormModes(modeAdtSet, e)),
        ExIf(c, t, e) -> ExIf(eraseFormModes(modeAdtSet, c), eraseFormModes(modeAdtSet, t), eraseFormModes(modeAdtSet, e)),
        ExWhile(c, b) -> ExWhile(eraseFormModes(modeAdtSet, c), eraseFormModes(modeAdtSet, b)),
        ExContract(fc, b) -> {
            let nReqs = fmap((p) -> match p { (sp, e) -> (sp, eraseFormModes(modeAdtSet, e)) }, fc.fcRequires);
            let nDecs = fmap((p) -> match p { (sp, e) -> (sp, eraseFormModes(modeAdtSet, e)) }, fc.fcDecreases);
            let nEns = fmap((ec: EnsuresClause) -> MkEnsuresClause {
                ecBind: ec.ecBind, ecSpan: ec.ecSpan, ecExpr: eraseFormModes(modeAdtSet, ec.ecExpr),
            }, fc.fcEnsures);
            ExContract(MkFnContract { fcRequires: nReqs, fcEnsures: nEns, fcDecreases: nDecs }, eraseFormModes(modeAdtSet, b))
        },
        ExLoopContract(invs, decs, b) -> {
            let nInvs = fmap((p) -> match p { (sp, e) -> (sp, eraseFormModes(modeAdtSet, e)) }, invs);
            let nDecs = fmap((p) -> match p { (sp, e) -> (sp, eraseFormModes(modeAdtSet, e)) }, decs);
            ExLoopContract(nInvs, nDecs, eraseFormModes(modeAdtSet, b))
        },
        ExAbs(ps, rt, b) -> {
            let nps = fmap((vd: VarDecl) -> MkVarDecl { vname: vd.vname, vscm: eraseSchemeModes(modeAdtSet, vd.vscm) }, ps);
            let nrt = fmap((t: Type) -> eraseTypeModes(modeAdtSet, t), rt);
            ExAbs(nps, nrt, eraseFormModes(modeAdtSet, b))
        },
        ExLet(vd, val, b) -> ExLet(
            MkVarDecl { vname: vd.vname, vscm: eraseSchemeModes(modeAdtSet, vd.vscm) },
            eraseFormModes(modeAdtSet, val),
            eraseFormModes(modeAdtSet, b)
        ),
        ExMatch(s, arms) -> {
            let narms = fmap((a: MatchArm) -> MkMatchArm {
                pat: a.pat,
                guard: fmap((g: Form) -> eraseFormModes(modeAdtSet, g), a.guard),
                body: eraseFormModes(modeAdtSet, a.body),
            }, arms);
            ExMatch(eraseFormModes(modeAdtSet, s), narms)
        },
    };
    MkForm { pos: f.pos, ty: nty, annot: nann, node: nnode }
}

def hasAttrCStruct(attrs: List DefAttr): Bool = match attrs {
    Nil -> false,
    Cons(AttrCStruct, _) -> true,
    Cons(_, r) -> hasAttrCStruct(r),
}

def hasAttrExport(attrs: List DefAttr): Bool = match attrs {
    Nil -> false,
    Cons(AttrExport(_), _) -> true,
    Cons(_, r) -> hasAttrExport(r),
}

def hasAttrCtor(attrs: List DefAttr): Bool = match attrs {
    Nil -> false,
    Cons(AttrCtor(_), _) -> true,
    Cons(_, r) -> hasAttrCtor(r),
}

def checkCStructFieldType(ctx: InferCtx, ty: Type, visiting: List String, sp: Span, ownerName: String): Result Void String =
    match ty {
        TyCon(n) ->
            if (n == "Int" || n == "Int64" || n == "Float" || n == "Float32" || n == "Char" || n == "Bool" || n == "Ptr" || n == "ScopedPtr") Ok(())
            else if (listContainsStr(visiting, n)) {
                Err(formatSpanDiag("Type error", sp, "'extern data' '" + ownerName + "' cannot be recursive through '" + n + "'"))
            } else match strMapGet(ctx.adtReg, n) {
                Some(ai) if (ai.isCStruct) -> match ai.variants {
                    Cons(vi, Nil) -> checkCStructFieldList(ctx, vi.fieldTypes, Cons(n, visiting), sp, ownerName),
                    _ -> Ok(()),
                },
                _ -> Err(formatSpanDiag("Type error", sp, "'extern data' '" + ownerName + "' field type '" + n + "' is not a C ABI scalar, Ptr, or extern data")),
            },
        _ -> Err(formatSpanDiag("Type error", sp, "'extern data' '" + ownerName + "' field type '" + typeToString(ty) + "' is not a valid C ABI type")),
    }

def checkCStructFieldList(ctx: InferCtx, ts: List Type, visiting: List String, sp: Span, ownerName: String): Result Void String =
    match ts {
        Nil -> Ok(()),
        Cons(h, t) -> {
            checkCStructFieldType(ctx, h, visiting, sp, ownerName)?;
            checkCStructFieldList(ctx, t, visiting, sp, ownerName)
        },
    }

def validateAllCStructs(ctx: InferCtx, defs: List Def): Result Void String = {
    let cur = cellNew(defs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(d, r) -> {
                match d.item {
                    ItAlg(_, _) ->
                        if (hasAttrCStruct(d.attrs)) {
                            match strMapGet(ctx.adtReg, d.ident) {
                                Some(ai) -> match ai.variants {
                                    Cons(vi, Nil) -> checkCStructFieldList(ctx, vi.fieldTypes, [d.ident], d.dpos, d.ident)?,
                                    _ -> (),
                                },
                                None -> (),
                            }
                        } else (),
                    _ ->
                        if (hasAttrCStruct(d.attrs)) {
                            returnPatErr(d.dpos, "'extern data' is only valid on 'data' declarations")?
                        } else (),
                };
                match d.item {
                    ItForm(f) ->
                        if (hasAttrVerified(d.attrs)) {
                            match f.node {
                                ExAbs(_, _, _) -> (),
                                _ -> returnPatErr(d.dpos, "'verified' is only valid on top-level 'def' functions")?,
                            }
                        } else (),
                    _ -> {
                        if (hasAttrExport(d.attrs)) returnPatErr(d.dpos, "'extern' export is only valid on top-level 'def' functions")? else ();
                        if (hasAttrCtor(d.attrs)) returnPatErr(d.dpos, "'extern init' is only valid on top-level 'def' functions")? else ();
                        if (hasAttrVerified(d.attrs)) returnPatErr(d.dpos, "'verified' is only valid on top-level 'def' functions")? else ()
                    },
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    Ok(())
}

def eraseInferOutput(ctx: InferCtx, rawOutDefs: List Def): InferOutput = {
    let mset = ctx.modeAdtSet;
    let edefs = fmap((d: Def) -> match d.item {
        ItForm(f) -> MkDef { ident: d.ident, dpos: d.dpos, vis: d.vis, attrs: d.attrs, item: ItForm(eraseFormModes(mset, f)) },
        ItExtern(lnk, scm, noAlloc, isFnPtr) -> MkDef { ident: d.ident, dpos: d.dpos, vis: d.vis, attrs: d.attrs, item: ItExtern(lnk, eraseSchemeModes(mset, scm), noAlloc, isFnPtr) },
        _ -> d,
    }, rawOutDefs);

    let eAdtReg: StrMap AdtInfo = strMapNew();
    let i = cellNew(0);
    while (cellGet(i) < vecLen(ctx.adtNames)) {
        let anm = vecGetOr(ctx.adtNames, cellGet(i), "");
        match strMapGet(ctx.adtReg, anm) {
            Some(ai) -> {
                let evs = fmap((vi: VariantInfo) -> MkVariantInfo {
                    vname: vi.vname,
                    tag: vi.tag,
                    fieldNames: vi.fieldNames,
                    fieldTypes: eraseTypeListModes(mset, vi.fieldTypes),
                    ctorScm: eraseSchemeModes(mset, vi.ctorScm),
                }, ai.variants);
                strMapInsert(eAdtReg, anm, MkAdtInfo {
                    adtName: ai.adtName,
                    typeParams: filterNonModeStrings(ai.typeParams),
                    variants: evs,
                    isCStruct: ai.isCStruct,
                })
            },
            None -> (),
        };
        cellSet(i, cellGet(i) + 1)
    };

    let eInsts = fmap((inst: InstanceInfo) -> MkInstanceInfo {
        conceptName: inst.conceptName,
        typeParams: filterNonModeStrings(inst.typeParams),
        constraints: eraseConstraintsModes(mset, inst.constraints),
        targetTypes: eraseTypeListModes(mset, inst.targetTypes),
        methodImpls: inst.methodImpls,
    }, cellGet(ctx.instanceReg));

    let eConceptReg: StrMap ConceptInfo = strMapNew();
    // Copy conceptReg with erased method schemes (iterate via defs + builtins)
    let builtinNames = [
        "Add", "Sub", "Mul", "Div", "Rem", "Neg",
        "BitAnd", "BitOr", "BitXor", "BitNot", "Shl", "Shr", "Ushr",
        "Eq", "Ord", "Send"
    ];
    let cb = cellNew(builtinNames);
    while (match cellGet(cb) { Nil -> false, _ -> true }) {
        match cellGet(cb) {
            Cons(cn, r) -> {
                match strMapGet(ctx.conceptReg, cn) {
                    Some(ci) -> {
                        let ems = fmap((pair) -> match pair { (mn, ms) -> (mn, eraseSchemeModes(mset, ms)) }, ci.methods);
                        strMapInsert(eConceptReg, cn, MkConceptInfo {
                            conceptName: ci.conceptName,
                            typeParams: filterNonModeStrings(ci.typeParams),
                            paramKinds: ci.paramKinds,
                            superclasses: eraseConstraintsModes(mset, ci.superclasses),
                            fundeps: ci.fundeps,
                            methods: ems,
                        })
                    },
                    None -> (),
                };
                cellSet(cb, r)
            },
            Nil -> (),
        }
    };
    let cd = cellNew(rawOutDefs);
    while (match cellGet(cd) { Nil -> false, _ -> true }) {
        match cellGet(cd) {
            Cons(d, r) -> {
                match d.item {
                    ItConcept(_, _, _, _) -> match strMapGet(ctx.conceptReg, d.ident) {
                        Some(ci) -> {
                            let ems = fmap((pair) -> match pair { (mn, ms) -> (mn, eraseSchemeModes(mset, ms)) }, ci.methods);
                            strMapInsert(eConceptReg, d.ident, MkConceptInfo {
                                conceptName: ci.conceptName,
                                typeParams: filterNonModeStrings(ci.typeParams),
                                paramKinds: ci.paramKinds,
                                superclasses: eraseConstraintsModes(mset, ci.superclasses),
                                fundeps: ci.fundeps,
                                methods: ems,
                            })
                        },
                        None -> (),
                    },
                    _ -> (),
                };
                cellSet(cd, r)
            },
            Nil -> (),
        }
    };

    MkInferOutput {
        defs: edefs,
        adtReg: eAdtReg,
        adtNames: ctx.adtNames,
        conceptReg: eConceptReg,
        instanceReg: eInsts,
        conceptMethods: ctx.conceptMethods,
    }
}

pub def inferProgram(rawDefs: List Def): Result InferOutput String = {
    let ctx = initInferCtx();
    let baseMap = buildPreludeBaseMap();

    inferPass1Aliases(ctx, rawDefs)?;
    inferPass2Adts(ctx, baseMap, rawDefs)?;

    // Seed built-in concept methods into `baseMap`
    let builtinConcepts = [
        "Add", "Sub", "Mul", "Div", "Rem", "Neg",
        "BitAnd", "BitOr", "BitXor", "BitNot", "Shl", "Shr", "Ushr",
        "Eq", "Ord"
    ];
    let cbc = cellNew(builtinConcepts);
    while (match cellGet(cbc) { Nil -> false, _ -> true }) {
        match cellGet(cbc) {
            Cons(cn, r) -> {
                match strMapGet(ctx.conceptReg, cn) {
                    Some(ci) -> match ci.methods {
                        Cons((mn, ms), _) -> strMapInsert(baseMap, mn, ms),
                        Nil -> (),
                    },
                    None -> (),
                };
                cellSet(cbc, r)
            },
            Nil -> (),
        }
    };

    inferPass3Concepts(ctx, baseMap, rawDefs)?;
    let synth = inferPass4Instances(ctx, rawDefs)?;
    let allDefs = listAppend(rawDefs, synth);

    // Pass 5: Expand annotations, precompute transitive `!Send` global taint, and seed `baseMap`
    let expandedAnnots: StrMap Scheme = strMapNew();
    let cur5Pre = cellNew(allDefs);
    while (match cellGet(cur5Pre) { Nil -> false, _ -> true }) {
        match cellGet(cur5Pre) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> match f.annot {
                        Some(ann) -> {
                            let expAnn = expandPolyScheme(ctx, ann, d.dpos)?;
                            checkSchemeKinds(ctx, expAnn, d.dpos)?;
                            strMapInsert(expandedAnnots, d.ident, expAnn)
                        },
                        None -> (),
                    },
                    _ -> (),
                };
                cellSet(cur5Pre, r)
            },
            Nil -> (),
        }
    };
    precomputeTopTaint(ctx, allDefs, expandedAnnots);

    let placeholders: StrMap Type = strMapNew();
    let unannotatedNames = cellNew(Nil);
    let cur5 = cellNew(allDefs);
    while (match cellGet(cur5) { Nil -> false, _ -> true }) {
        match cellGet(cur5) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        match strMapGet(expandedAnnots, d.ident) {
                            Some(expAnn0) -> {
                                let expAnn = if (strMapContains(ctx.taintedTopSet, d.ident)) pinOuterSchemeLocal(expAnn0) else expAnn0;
                                strMapInsert(expandedAnnots, d.ident, expAnn);
                                strMapInsert(baseMap, d.ident, expAnn)
                            },
                            None -> {
                                let ph = freshVar(ctx);
                                strMapInsert(placeholders, d.ident, ph);
                                strMapInsert(baseMap, d.ident, ScmMono(ph));
                                cellSet(unannotatedNames, Cons(d.ident, cellGet(unannotatedNames)))
                            },
                        }
                    },
                    ItExtern(_, scm, _, isFnPtr) -> {
                        let expScm = expandPolyScheme(ctx, scm, d.dpos)?;
                        checkSchemeKinds(ctx, expScm, d.dpos)?;
                        if (isFnPtr) {
                            match schemeBody(expScm) {
                                TyArr(_, Cons(TyCon("Ptr"), _), _) -> (),
                                _ -> returnPatErr(d.dpos, "'extern ptr' declaration '" + d.ident + "' must take 'Ptr' as its first parameter")?,
                            }
                        } else ();
                        strMapInsert(ctx.externSet, d.ident, true);
                        strMapInsert(baseMap, d.ident, expScm)
                    },
                    _ -> (),
                };
                cellSet(cur5, r)
            },
            Nil -> (),
        }
    };

    // Pass 6: Infer each top-level `ItForm` definition
    let inferredRev = cellNew(Nil);
    let deferredTopWanted: Cell (List WantedConstraint) = cellNew(Nil);
    let cur6 = cellNew(allDefs);
    while (match cellGet(cur6) { Nil -> false, _ -> true }) {
        match cellGet(cur6) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        let expAnnot = strMapGet(expandedAnnots, d.ident);
                        let (userAnnotVs, givenCs, annotBodyOpt) = match expAnnot {
                            Some(escm) -> {
                                let (uvs, gcs, abody) = instOnlyModeVars(ctx, escm);
                                (uvs, gcs, Some(abody))
                            },
                            None -> (Nil, Nil, None),
                        };
                        cellSet(ctx.wanted, Nil);
                        let unannotatedForm = MkForm { pos: f.pos, ty: f.ty, annot: None, node: f.node };
                        let env0 = MkTypeEnv { locals: Nil, base: baseMap };
                        let inf0 = inferForm(ctx, env0, unannotatedForm)?;

                        if (strMapContains(ctx.taintedTopSet, d.ident)) {
                            match zonkType(ctx.subst, schemeBody(inf0.ty)) {
                                TyArr(m, _, _) -> unifyTypes(ctx.subst, m, TyCon("$Local"), d.dpos)?,
                                _ -> (),
                            }
                        } else ();

                        match strMapGet(placeholders, d.ident) {
                            Some(ph) -> unifyTypes(ctx.subst, ph, schemeBody(inf0.ty), d.dpos)?,
                            None -> (),
                        };
                        match annotBodyOpt {
                            Some(abody) -> unifyTypes(ctx.subst, abody, schemeBody(inf0.ty), d.dpos)?,
                            None -> (),
                        };

                        let infZonked0 = zonkForm(ctx.subst, inf0);
                        let finalBodyTy0 = zonkType(ctx.subst, schemeBody(infZonked0.ty));
                        let defWanted = cellGet(ctx.wanted);

                        let generalScm = match annotBodyOpt {
                            Some(abody) -> {
                                let zAbody0 = zonkType(ctx.subst, abody);
                                let remRes = dischargeWantedFixedPoint(ctx, defWanted, givenCs, ftvOrdered(zAbody0))?;
                                let zAbody = zonkType(ctx.subst, zAbody0);
                                let allVs = collectModeFtvsInType(zAbody, userAnnotVs);
                                let allCs = cellNew(zonkConstraintsExcept(ctx.subst, allVs, givenCs));
                                let cr = cellNew(remRes);
                                while (match cellGet(cr) { Nil -> false, _ -> true }) {
                                    match cellGet(cr) {
                                        Cons(unmet, rr) -> {
                                            let zArgs = zonkTypeList(ctx.subst, unmet.wcArgs);
                                            let canKeepSendIf =
                                                if (unmet.wcConcept == "SendIf") {
                                                    match zArgs {
                                                        Cons(TyVar(mv), _) -> listContainsStr(allVs, mv),
                                                        _ -> false,
                                                    }
                                                } else false;
                                            if (canKeepSendIf) {
                                                cellSet(allCs, addUniqueConstraint(cellGet(allCs), MkConstraint { conceptName: "SendIf", typeArgs: zArgs }))
                                            } else {
                                                returnPatErr(unmet.wcSpan, "Unsatisfied constraint '" + unmet.wcConcept + "' for (" + joinTypeListStr(zArgs) + ")")?
                                            };
                                            cellSet(cr, rr)
                                        },
                                        Nil -> (),
                                    }
                                };
                                match (allVs, cellGet(allCs)) {
                                    (Nil, Nil) -> ScmMono(zAbody),
                                    (_, Nil) -> ScmPoly(allVs, zAbody),
                                    _ -> ScmPolyConstrained(allVs, cellGet(allCs), zAbody),
                                }
                            },
                            None -> match infZonked0.node {
                                ExAbs(_, _, _) -> {
                                    // Collect free type vars ONLY from unannotated top-level forms not yet generalized!
                                    let seenFtv: StrMap Bool = strMapNew();
                                    let otherFtvs = cellNew(Nil);
                                    let nextUnann = cellNew(Nil);
                                    let co = cellNew(cellGet(unannotatedNames));
                                    while (match cellGet(co) { Nil -> false, _ -> true }) {
                                        match cellGet(co) {
                                            Cons(onm, ro) -> {
                                                if (onm != d.ident) {
                                                    cellSet(nextUnann, Cons(onm, cellGet(nextUnann)));
                                                    match strMapGet(baseMap, onm) {
                                                        Some(oscm) -> {
                                                            let zos = zonkScheme(ctx.subst, oscm);
                                                            let obound = schemeTypeParams(zos);
                                                            let ofvs = ftvOrdered(schemeBody(zos));
                                                            let cf = cellNew(ofvs);
                                                            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                                                match cellGet(cf) {
                                                                    Cons(fv, rf) -> {
                                                                        if (!listContainsStr(obound, fv) && !strMapContains(seenFtv, fv)) {
                                                                            strMapInsert(seenFtv, fv, true);
                                                                            cellSet(otherFtvs, Cons(fv, cellGet(otherFtvs)))
                                                                        } else ();
                                                                        cellSet(cf, rf)
                                                                    },
                                                                    Nil -> (),
                                                                }
                                                            }
                                                        },
                                                        None -> (),
                                                    }
                                                } else ();
                                                cellSet(co, ro)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    cellSet(unannotatedNames, cellGet(nextUnann));
                                    let (gscm, ow) = generalizeType(ctx, cellGet(otherFtvs), finalBodyTy0, defWanted, Nil)?;
                                    cellSet(deferredTopWanted, listAppend(cellGet(deferredTopWanted), ow));
                                    gscm
                                },
                                _ -> {
                                    let remRes = dischargeWantedFixedPoint(ctx, defWanted, Nil, ftvOrdered(finalBodyTy0))?;
                                    let zBody = zonkType(ctx.subst, finalBodyTy0);
                                    match remRes {
                                        Cons(unmet, _) -> {
                                            returnPatErr(unmet.wcSpan, "Unsatisfied constraint '" + unmet.wcConcept + "'")?;
                                            ScmMono(zBody)
                                        },
                                        Nil ->
                                            if (strMapContains(ctx.taintedTopSet, d.ident)) ScmMono(zBody)
                                            else quantifyModeVarsInScheme(ScmMono(zBody)),
                                    }
                                },
                            },
                        };

                        let infZonked = zonkForm(ctx.subst, infZonked0);
                        strMapInsert(baseMap, d.ident, generalScm);
                        let finalForm = MkForm {
                            pos: infZonked.pos,
                            ty: generalScm,
                            annot: f.annot,
                            node: infZonked.node,
                        };
                        cellSet(inferredRev, Cons(MkDef {
                            ident: d.ident,
                            dpos: d.dpos,
                            vis: d.vis,
                            attrs: d.attrs,
                            item: ItForm(finalForm),
                        }, cellGet(inferredRev)))
                    },
                    _ -> cellSet(inferredRev, Cons(d, cellGet(inferredRev))),
                };
                cellSet(cur6, r)
            },
            Nil -> (),
        }
    };

    // Discharge any top-level constraints deferred across mutually recursive definitions
    let _ = dischargeWantedFixedPoint(ctx, cellGet(deferredTopWanted), Nil, Nil)?;

    // Final pass: backfill mutual-recursion substitutions across all earlier definitions & check exhaustiveness!
    let finalRev = cellNew(Nil);
    let cur7 = cellNew(listRev(cellGet(inferredRev)));
    while (match cellGet(cur7) { Nil -> false, _ -> true }) {
        match cellGet(cur7) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        let zf = zonkForm(ctx.subst, f);
                        checkExhaustivenessInForm(ctx, zf)?;
                        if (hasAttrExport(d.attrs) || hasAttrCtor(d.attrs)) {
                            let bodyTy = schemeBody(zf.ty);
                            let nonModeTps = filterNonModeStrings(schemeTypeParams(zf.ty));
                            match nonModeTps {
                                Cons(_, _) -> returnPatErr(d.dpos, "'extern' export/init function '" + d.ident + "' must be monomorphic (no type parameters)")?,
                                Nil -> (),
                            };
                            match bodyTy {
                                TyArr(_, ps, rt) ->
                                    if (hasAttrCtor(d.attrs)) {
                                        let retIsVoid = match rt { TyVoid -> true, TyCon("Void") -> true, _ -> false };
                                        match ps {
                                            Nil if (retIsVoid) -> (),
                                            _ -> returnPatErr(d.dpos, "'extern init' function '" + d.ident + "' must have signature () -> Void")?,
                                        }
                                    } else (),
                                _ -> returnPatErr(d.dpos, "'extern' export/init on '" + d.ident + "' requires a function definition")?,
                            }
                        } else ();
                        cellSet(finalRev, Cons(MkDef {
                            ident: d.ident,
                            dpos: d.dpos,
                            vis: d.vis,
                            attrs: d.attrs,
                            item: ItForm(zf),
                        }, cellGet(finalRev)))
                    },
                    _ -> cellSet(finalRev, Cons(d, cellGet(finalRev))),
                };
                cellSet(cur7, r)
            },
            Nil -> (),
        }
    };

    let finalDefs = listRev(cellGet(finalRev));
    checkAllContractPurity(ctx, finalDefs)?;
    Ok(eraseInferOutput(ctx, finalDefs))
}
