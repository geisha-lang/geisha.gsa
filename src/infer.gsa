pub data VariantInfo {
    MkVariantInfo {
        vname: String,
        tag: Int,
        fieldNames: Option (List String),
        fieldTypes: List Type,
        ctorScm: Scheme,
    },
}

pub data AdtInfo {
    MkAdtInfo {
        adtName: String,
        typeParams: List String,
        variants: List VariantInfo,
        isCStruct: Bool,
    },
}

data Kind {
    KStar,
    KArr(Kind, Kind),
    KVar(String),
}

pub data ConceptInfo {
    MkConceptInfo {
        conceptName: String,
        typeParams: List String,
        paramKinds: List Kind,
        superclasses: List ConstraintSpec,
        fundeps: List FunDep,
        methods: List (String, Scheme),
    },
}

pub data InstanceInfo {
    MkInstanceInfo {
        conceptName: String,
        typeParams: List String,
        constraints: List ConstraintSpec,
        targetTypes: List Type,
        methodImpls: StrMap String,
    },
}

data WantedConstraint {
    MkWanted { wcConcept: String, wcArgs: List Type, wcSpan: Span },
}

pub data InferOutput {
    MkInferOutput {
        defs: List Def,
        adtReg: StrMap AdtInfo,
        adtNames: Vec String,
        conceptReg: StrMap ConceptInfo,
        instanceReg: List InstanceInfo,
        conceptMethods: StrMap (String, Int),
    },
}

data InferCtx {
    MkInferCtx {
        unique: Cell Int,
        subst: StrMap Type,
        kindUnique: Cell Int,
        kindSubst: StrMap Kind,
        tyConKinds: StrMap Kind,
        wanted: Cell (List WantedConstraint),
        aliasReg: StrMap (List String, Type),
        adtReg: StrMap AdtInfo,
        adtNames: Vec String,
        ctorToAdt: StrMap String,
        modeAdtSet: StrMap Bool,
        taintedTopSet: StrMap Bool,
        globalValSet: StrMap Bool,
        externSet: StrMap Bool,
        conceptReg: StrMap ConceptInfo,
        instanceReg: Cell (List InstanceInfo),
        conceptMethods: StrMap (String, Int),
    },
}

// Lexical type environment: chained list of `(name, Scheme)` frames + base `StrMap Scheme`
data TypeEnv {
    MkTypeEnv { locals: List (String, Scheme), base: StrMap Scheme },
}

def envLookup(env: TypeEnv, name: String): Option Scheme = {
    let cur = cellNew(env.locals);
    let found: Cell (Option Scheme) = cellNew(None);
    while (match cellGet(cur) { Nil -> false, _ -> match cellGet(found) { None -> true, Some(_) -> false } }) {
        match cellGet(cur) {
            Cons((k, v), r) ->
                if (k == name) cellSet(found, Some(v))
                else cellSet(cur, r),
            Nil -> (),
        }
    };
    match cellGet(found) {
        Some(s) -> Some(s),
        None -> strMapGet(env.base, name),
    }
}

def envExtend(env: TypeEnv, name: String, scm: Scheme): TypeEnv =
    MkTypeEnv { locals: Cons((name, scm), env.locals), base: env.base }

def envExtendMany(env: TypeEnv, bindings: List (String, Scheme)): TypeEnv =
    MkTypeEnv { locals: listAppend(bindings, env.locals), base: env.base }

pub def mangleType(ty: Type): String = match ty {
    TyCon(n) ->
        if (n == "$Local") "Local"
        else if (n == "$Shared") "Shared"
        else if (n == "$Scoped") "Scoped"
        else replaceDots(n),
    TyVar(v) -> "T" + stripLeadingDot(v),
    TyVoid -> "Void",
    TyComp(b, a) -> mangleType(b) + "Of" + mangleType(a),
    TyTuple(es) -> "Tup" + joinMangledTypes(es, "And"),
    TyArr(_, ps, r) -> match ps {
        Nil -> "FnUnitTo" + mangleType(r),
        _ -> "Fn" + joinMangledTypes(ps, "And") + "To" + mangleType(r),
    },
}

def stripLeadingDot(s: String): String =
    if (strLen(s) > 0 && strByteAt(s, 0) == 46) strSlice(s, 1, strLen(s))
    else s

def replaceDots(s: String): String = {
    let n = strLen(s);
    let i = cellNew(0);
    let hasDot = cellNew(false);
    while (cellGet(i) < n && !cellGet(hasDot)) {
        if (strByteAt(s, cellGet(i)) == 46) cellSet(hasDot, true) else ();
        cellSet(i, cellGet(i) + 1)
    };
    if (!cellGet(hasDot)) s
    else {
        let out = arrayNew(n, 0);
        let k = cellNew(0);
        while (cellGet(k) < n) {
            let idx = cellGet(k);
            let b = strByteAt(s, idx);
            arraySet(out, idx, if (b == 46) 36 else b);
            cellSet(k, idx + 1)
        };
        strFromBytes(out, n)
    }
}

def joinMangledTypes(ts: List Type, sep: String): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> mangleType(h),
    Cons(h, t) -> mangleType(h) + sep + joinMangledTypes(t, sep),
}

def freshVar(ctx: InferCtx): Type
    requires cellGet(ctx.unique) >= 0
    ensures r -> cellGet(ctx.unique) > 0 && match r { TyVar(nm) -> strLen(nm) > 1, _ -> false }
= {
    let n = cellGet(ctx.unique) + 1;
    cellSet(ctx.unique, n);
    TyVar("." + intToStr(n))
}

def freshModeVar(ctx: InferCtx): Type
    requires cellGet(ctx.unique) >= 0
    ensures r -> cellGet(ctx.unique) > 0 && match r { TyVar(nm) -> strLen(nm) > 3, _ -> false }
= {
    let n = cellGet(ctx.unique) + 1;
    cellSet(ctx.unique, n);
    TyVar(".$m" + intToStr(n))
}

def typeErr(sp: Span, msg: String): String =
    formatSpanDiag("Type error", sp, msg)

def typeErrHint(sp: Span, msg: String, hint: String): String =
    formatSpanDiagHint("Type error", sp, msg, hint)

def typeMismatchErr(sp: Span, expected: String, found: String): String =
    match diagSpanTerm(sp) {
        Some(term) -> formatSpanDiagNoNear("Type error", sp, "`" + term + "` has type `" + found + "`, expected `" + expected + "`"),
        None -> typeErr(sp, "expected `" + expected + "`, found `" + found + "`"),
    }

def pitfallNameHint(name: String): Option String =
    if (name == "Some" || name == "None") Some("import with `use std.option.{Option, Some, None}`")
    else if (name == "Ok" || name == "Err") Some("import with `use std.result.{Result, Ok, Err}`")
    else if (name == "println" || name == "print_ln") Some("use `printLn` (capital L)")
    else if (name == "len") Some("use `strLen`, `listLen`, `vecLen`, or `arrayLen`")
    else if (name == "mut") Some("Geisha uses `cellNew` / `cellGet` / `cellSet` instead of `mut`")
    else None

// ============================================================================
// Union-Find Style Type Substitution (`zonkType` / `unifyTypes`)
// ============================================================================

pub def applyExplicitSubst(ty: Type, map: StrMap Type): Type = match ty {
    TyVoid -> TyVoid,
    TyCon(_) -> ty,
    TyVar(v) -> match strMapGet(map, v) {
        Some(target) -> target,
        None -> ty,
    },
    TyArr(m, ps, r) -> TyArr(applyExplicitSubst(m, map), applyExplicitSubstList(ps, map), applyExplicitSubst(r, map)),
    TyTuple(es) -> TyTuple(applyExplicitSubstList(es, map)),
    TyComp(b, a) -> TyComp(applyExplicitSubst(b, map), applyExplicitSubst(a, map)),
}

def applyExplicitSubstList(ts: List Type, map: StrMap Type): List Type =
    fmap((t) -> applyExplicitSubst(t, map), ts)

def zonkType(subst: StrMap Type, ty: Type): Type = match ty {
    TyVoid -> TyVoid,
    TyCon(_) -> ty,
    TyVar(v) -> match strMapGet(subst, v) {
        Some(next) -> {
            let resolved = zonkType(subst, next);
            strMapInsert(subst, v, resolved);
            resolved
        },
        None -> ty,
    },
    TyArr(m, ps, r) -> TyArr(zonkType(subst, m), zonkTypeList(subst, ps), zonkType(subst, r)),
    TyTuple(es) -> TyTuple(zonkTypeList(subst, es)),
    TyComp(b, a) -> TyComp(zonkType(subst, b), zonkType(subst, a)),
}

def zonkTypeList(subst: StrMap Type, ts: List Type): List Type =
    fmap((t) -> zonkType(subst, t), ts)

def zonkConstraintsExcept(subst: StrMap Type, bound: List String, cs: List ConstraintSpec): List ConstraintSpec = match cs {
    Nil -> Nil,
    Cons(c, r) -> Cons(
        MkConstraint { conceptName: c.conceptName, typeArgs: zonkTypeListExcept(subst, bound, c.typeArgs) },
        zonkConstraintsExcept(subst, bound, r)
    ),
}

def zonkScheme(subst: StrMap Type, scm: Scheme): Scheme = match scm {
    ScmMono(t) -> ScmMono(zonkType(subst, t)),
    ScmPoly(vs, t) -> ScmPoly(vs, zonkTypeExcept(subst, vs, t)),
    ScmPolyConstrained(vs, cs, t) -> ScmPolyConstrained(vs, zonkConstraintsExcept(subst, vs, cs), zonkTypeExcept(subst, vs, t)),
    ScmSlot -> ScmSlot,
}

def zonkTypeExcept(subst: StrMap Type, bound: List String, ty: Type): Type = match ty {
    TyVoid -> TyVoid,
    TyCon(_) -> ty,
    TyVar(v) ->
        if (listContainsStr(bound, v)) ty
        else zonkType(subst, ty),
    TyArr(m, ps, r) -> TyArr(zonkTypeExcept(subst, bound, m), zonkTypeListExcept(subst, bound, ps), zonkTypeExcept(subst, bound, r)),
    TyTuple(es) -> TyTuple(zonkTypeListExcept(subst, bound, es)),
    TyComp(b, a) -> TyComp(zonkTypeExcept(subst, bound, b), zonkTypeExcept(subst, bound, a)),
}

def zonkTypeListExcept(subst: StrMap Type, bound: List String, ts: List Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(zonkTypeExcept(subst, bound, h), zonkTypeListExcept(subst, bound, t)),
}

def zonkFormList(subst: StrMap Type, es: List Form): List Form = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(zonkForm(subst, h), zonkFormList(subst, t)),
}

def zonkNamedForms(subst: StrMap Type, fs: List (String, Form)): List (String, Form) = match fs {
    Nil -> Nil,
    Cons((k, v), t) -> Cons((k, zonkForm(subst, v)), zonkNamedForms(subst, t)),
}

def zonkForm(subst: StrMap Type, f: Form): Form = {
    let nty = zonkScheme(subst, f.ty);
    let nnode = match f.node {
        ExLit(_) -> f.node,
        ExVar(_) -> f.node,
        ExTuple(es) -> ExTuple(zonkFormList(subst, es)),
        ExList(es) -> ExList(zonkFormList(subst, es)),
        ExBlock(es) -> ExBlock(zonkFormList(subst, es)),
        ExStructInit(c, fs) -> ExStructInit(c, zonkNamedForms(subst, fs)),
        ExApply(c, args) -> ExApply(zonkForm(subst, c), zonkFormList(subst, args)),
        ExBin(op, l, r) -> ExBin(op, zonkForm(subst, l), zonkForm(subst, r)),
        ExUn(op, e) -> ExUn(op, zonkForm(subst, e)),
        ExField(e, nm) -> ExField(zonkForm(subst, e), nm),
        ExTry(e) -> ExTry(zonkForm(subst, e)),
        ExIf(c, t, e) -> ExIf(zonkForm(subst, c), zonkForm(subst, t), zonkForm(subst, e)),
        ExWhile(c, b) -> ExWhile(zonkForm(subst, c), zonkForm(subst, b)),
        ExContract(fc, b) -> {
            let zReqs = fmap((p) -> match p { (sp, e) -> (sp, zonkForm(subst, e)) }, fc.fcRequires);
            let zDecs = fmap((p) -> match p { (sp, e) -> (sp, zonkForm(subst, e)) }, fc.fcDecreases);
            let zEns = fmap((ec: EnsuresClause) -> MkEnsuresClause {
                ecBind: ec.ecBind, ecSpan: ec.ecSpan, ecExpr: zonkForm(subst, ec.ecExpr),
            }, fc.fcEnsures);
            ExContract(MkFnContract { fcRequires: zReqs, fcEnsures: zEns, fcDecreases: zDecs }, zonkForm(subst, b))
        },
        ExLoopContract(invs, decs, b) -> {
            let zInvs = fmap((p) -> match p { (sp, e) -> (sp, zonkForm(subst, e)) }, invs);
            let zDecs = fmap((p) -> match p { (sp, e) -> (sp, zonkForm(subst, e)) }, decs);
            ExLoopContract(zInvs, zDecs, zonkForm(subst, b))
        },
        ExAbs(ps, rt, body) -> {
            let nps = cellNew(Nil);
            let cur = cellNew(ps);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(vd, r) -> {
                        cellSet(nps, listAppend(cellGet(nps), [MkVarDecl { vname: vd.vname, vscm: zonkScheme(subst, vd.vscm) }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let nrt = fmap((t) -> zonkType(subst, t), rt);
            ExAbs(cellGet(nps), nrt, zonkForm(subst, body))
        },
        ExLet(vd, val, body) ->
            ExLet(
                MkVarDecl { vname: vd.vname, vscm: zonkScheme(subst, vd.vscm) },
                zonkForm(subst, val),
                zonkForm(subst, body)
            ),
        ExMatch(scrut, arms) -> {
            let nArms = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ng = fmap((g) -> zonkForm(subst, g), a.guard);
                        cellSet(nArms, listAppend(cellGet(nArms), [MkMatchArm { pat: a.pat, guard: ng, body: zonkForm(subst, a.body) }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            ExMatch(zonkForm(subst, scrut), cellGet(nArms))
        },
    };
    MkForm { pos: f.pos, ty: nty, annot: f.annot, node: nnode }
}

def occursIn(v: String, ty: Type): Bool = match ty {
    TyVoid -> false,
    TyCon(_) -> false,
    TyVar(x) -> x == v,
    TyArr(m, ps, r) -> occursIn(v, m) || occursInList(v, ps) || occursIn(v, r),
    TyTuple(es) -> occursInList(v, es),
    TyComp(b, a) -> occursIn(v, b) || occursIn(v, a),
}

def occursInList(v: String, ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> if (occursIn(v, h)) true else occursInList(v, t),
}

def bindTypeVar(subst: StrMap Type, v: String, ty: Type, sp: Span): Result Void String = {
    let z = zonkType(subst, ty);
    match z {
        TyVar(v2) -> if (v == v2) Ok(()) else { strMapInsert(subst, v, z); Ok(()) },
        _ ->
            if (occursIn(v, z)) Err(typeErr(sp, "Infinite type: '" + v + "' occurs in '" + typeToString(z) + "'"))
            else {
                strMapInsert(subst, v, z);
                Ok(())
            },
    }
}

def unifyTypeLists(subst: StrMap Type, xs: List Type, ys: List Type, sp: Span): Result Void String
    ensures res -> match res { Ok(_) -> listLen(xs) == listLen(ys), Err(_) -> true }
= match (xs, ys) {
    (Nil, Nil) -> Ok(()),
    (Cons(x, xr), Cons(y, yr)) -> {
        unifyTypes(subst, x, y, sp)?;
        unifyTypeLists(subst, xr, yr, sp)
    },
    _ -> Err(typeErr(sp, "Arity mismatch in function or tuple types")),
}

def unifyTypes(subst: StrMap Type, a0: Type, b0: Type, sp: Span): Result Void String = {
    let a = zonkType(subst, a0);
    let b = zonkType(subst, b0);
    match (a, b) {
        (TyVoid, TyVoid) -> Ok(()),
        (TyCon(voidA), TyVoid) -> if (voidA == "Void") Ok(()) else Err(typeMismatchErr(sp, voidA, "Void")),
        (TyVoid, TyCon(voidB)) -> if (voidB == "Void") Ok(()) else Err(typeMismatchErr(sp, "Void", voidB)),
        (TyCon(na), TyCon(nb)) ->
            if (na == nb) Ok(())
            else if ((na == "$Local" && nb == "$Shared") || (na == "$Shared" && nb == "$Local")) {
                Err(typeErr(sp, "cannot pass non-Send closure (captures local mutable state) where a thread-safe `Send` function is required"))
            } else if ((na == "$Scoped" && nb == "$Shared") || (na == "$Shared" && nb == "$Scoped")) {
                Err(typeErr(sp, "cannot pass scoped closure (captures ScopedPtr/Arena) where a thread-safe `Send` function is required"))
            } else if ((na == "$Scoped" && nb == "$Local") || (na == "$Local" && nb == "$Scoped")) {
                Err(typeErr(sp, "cannot pass scoped closure (captures ScopedPtr/Arena) where an escaping closure is required"))
            } else Err(typeMismatchErr(sp, na, nb)),
        (TyVar(va), TyVar(vb)) ->
            if (va == vb) Ok(())
            else if (strLen(va) > 0 && strByteAt(va, 0) != 46 && strLen(vb) > 0 && strByteAt(vb, 0) == 46) {
                bindTypeVar(subst, vb, a, sp)
            } else {
                bindTypeVar(subst, va, b, sp)
            },
        (TyVar(va), _) -> bindTypeVar(subst, va, b, sp),
        (_, TyVar(vb)) -> bindTypeVar(subst, vb, a, sp),
        (TyArr(m1, ps1, r1), TyArr(m2, ps2, r2)) -> {
            if (listLen(ps1) != listLen(ps2)) {
                Err(typeErr(sp, "expected " + intToStr(listLen(ps1)) + " argument(s), found " + intToStr(listLen(ps2))))
            } else {
                unifyTypes(subst, m1, m2, sp)?;
                unifyTypeLists(subst, ps1, ps2, sp)?;
                unifyTypes(subst, r1, r2, sp)
            }
        },
        (TyTuple(es1), TyTuple(es2)) -> {
            if (listLen(es1) != listLen(es2)) {
                Err(typeErr(sp, "tuple has " + intToStr(listLen(es2)) + " element(s), expected " + intToStr(listLen(es1))))
            } else unifyTypeLists(subst, es1, es2, sp)
        },
        (TyComp(b1, a1), TyComp(b2, a2)) -> {
            unifyTypes(subst, b1, b2, sp)?;
            unifyTypes(subst, a1, a2, sp)
        },
        _ -> Err(typeMismatchErr(sp, typeToString(a), typeToString(b))),
    }
}

// ============================================================================
// Type Alias Expansion & Built-in Concepts / Prelude
// ============================================================================

def isModeTypeArg(ty: Type): Bool = match ty {
    TyCon(n) -> n == "$Local" || n == "$Shared" || n == "$Scoped",
    TyVar(v) -> isModeVarName(v),
    _ -> false,
}

def pickExpandedMode(ctx: InferCtx, fixedModeOpt: Option Type): Type = match fixedModeOpt {
    Some(m) -> m,
    None -> freshModeVar(ctx),
}

def expandTypeWithMode(ctx: InferCtx, ty: Type, visiting: List String, sp: Span, fixedModeOpt: Option Type): Result Type String = match ty {
    TyVoid -> Ok(TyVoid),
    TyVar(_) -> Ok(ty),
    TyCon(name) -> match strMapGet(ctx.aliasReg, name) {
        None ->
            if (strMapContains(ctx.modeAdtSet, name)) {
                Ok(TyComp(TyCon(name), pickExpandedMode(ctx, fixedModeOpt)))
            } else Ok(ty),
        Some((params, target)) ->
            if (listLen(params) != 0) Err(typeErr(sp, "Type alias '" + name + "' expects arguments"))
            else if (listContainsStr(visiting, name)) Err(typeErr(sp, "Cyclic type alias involving '" + name + "'"))
            else expandTypeWithMode(ctx, target, Cons(name, visiting), sp, fixedModeOpt),
    },
    TyArr(m, ps, r) -> {
        let em = match m {
            TyVoid -> pickExpandedMode(ctx, fixedModeOpt),
            _ -> expandTypeWithMode(ctx, m, visiting, sp, fixedModeOpt)?,
        };
        let eps = expandTypeListWithMode(ctx, ps, visiting, sp, fixedModeOpt)?;
        let er = expandTypeWithMode(ctx, r, visiting, sp, fixedModeOpt)?;
        Ok(TyArr(em, eps, er))
    },
    TyTuple(es) -> Ok(TyTuple(expandTypeListWithMode(ctx, es, visiting, sp, fixedModeOpt)?)),
    TyComp(_, _) -> {
        let args = cellNew(Nil);
        let curr = cellNew(ty);
        let unwrapping = cellNew(true);
        while (cellGet(unwrapping)) {
            match cellGet(curr) {
                TyComp(base, arg) -> {
                    let ea = expandTypeWithMode(ctx, arg, visiting, sp, fixedModeOpt)?;
                    cellSet(args, Cons(ea, cellGet(args)));
                    cellSet(curr, base)
                },
                _ -> cellSet(unwrapping, false),
            }
        };
        let head = cellGet(curr);
        let argList = cellGet(args);
        match head {
            TyCon(name) -> match strMapGet(ctx.aliasReg, name) {
                Some((params, target)) ->
                    if (listLen(params) != listLen(argList)) {
                        Err(typeErr(sp, "Type alias '" + name + "' arity mismatch"))
                    } else if (listContainsStr(visiting, name)) {
                        Err(typeErr(sp, "Cyclic type alias involving '" + name + "'"))
                    } else {
                        let sub = buildPairMap(params, argList);
                        let applied = applyExplicitSubst(target, sub);
                        expandTypeWithMode(ctx, applied, Cons(name, visiting), sp, fixedModeOpt)
                    },
                None ->
                    if (strMapContains(ctx.modeAdtSet, name)) {
                        let alreadyHasMode = match argList {
                            Cons(a0, _) -> isModeTypeArg(a0),
                            Nil -> false,
                        };
                        if (alreadyHasMode) {
                            Ok(composeTypes(Cons(TyCon(name), argList)))
                        } else {
                            Ok(composeTypes(Cons(TyCon(name), Cons(pickExpandedMode(ctx, fixedModeOpt), argList))))
                        }
                    } else if (name == "Simd") {
                        if (listLen(argList) != 2) {
                            Err(typeErr(sp, "Type 'Simd' expects 2 type arguments (lane marker and element type)"))
                        } else {
                            let comp = composeTypes(Cons(TyCon("Simd"), argList));
                            validateSimdAppIfConcrete(comp, sp)?;
                            Ok(comp)
                        }
                    } else {
                        let eh = expandTypeWithMode(ctx, head, visiting, sp, fixedModeOpt)?;
                        Ok(composeTypes(Cons(eh, argList)))
                    },
            },
            _ -> {
                let eh = expandTypeWithMode(ctx, head, visiting, sp, fixedModeOpt)?;
                Ok(composeTypes(Cons(eh, argList)))
            },
        }
    },
}

def expandTypeListWithMode(ctx: InferCtx, ts: List Type, visiting: List String, sp: Span, fixedModeOpt: Option Type): Result (List Type) String = match ts {
    Nil -> Ok(Nil),
    Cons(h, t) -> {
        let eh = expandTypeWithMode(ctx, h, visiting, sp, fixedModeOpt)?;
        let et = expandTypeListWithMode(ctx, t, visiting, sp, fixedModeOpt)?;
        Ok(Cons(eh, et))
    },
}

def expandTypeInner(ctx: InferCtx, ty: Type, visiting: List String, sp: Span): Result Type String =
    expandTypeWithMode(ctx, ty, visiting, sp, None)

def expandTypeListInner(ctx: InferCtx, ts: List Type, visiting: List String, sp: Span): Result (List Type) String =
    expandTypeListWithMode(ctx, ts, visiting, sp, None)

def expandType(ctx: InferCtx, ty: Type, sp: Span): Result Type String =
    expandTypeWithMode(ctx, ty, Nil, sp, None)

def expandScheme(ctx: InferCtx, scm: Scheme, sp: Span): Result Scheme String = match scm {
    ScmMono(t) -> Ok(ScmMono(expandType(ctx, t, sp)?)),
    ScmPoly(vs, t) -> Ok(ScmPoly(vs, expandType(ctx, t, sp)?)),
    ScmPolyConstrained(vs, cs, t) -> {
        let ecs = cellNew(Nil);
        let cur = cellNew(cs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(c, r) -> {
                    let eargs = expandTypeListInner(ctx, c.typeArgs, Nil, sp)?;
                    cellSet(ecs, listAppend(cellGet(ecs), [MkConstraint { conceptName: c.conceptName, typeArgs: eargs }]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        Ok(ScmPolyConstrained(vs, cellGet(ecs), expandType(ctx, t, sp)?))
    },
    ScmSlot -> Ok(ScmSlot),
}

def collectModeFtvsInType(ty: Type, acc: List String): List String = {
    let cur = cellNew(ftvOrdered(ty));
    let out = cellNew(acc);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(fv, r) -> {
                if (isModeVarName(fv)) cellSet(out, addUniqueStr(cellGet(out), fv)) else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(out)
}

def quantifyModeVarsInScheme(scm: Scheme): Scheme = match scm {
    ScmSlot -> ScmSlot,
    ScmMono(t) -> {
        let mvs = collectModeFtvsInType(t, Nil);
        match mvs {
            Nil -> ScmMono(t),
            _ -> ScmPoly(mvs, t),
        }
    },
    ScmPoly(vs, t) -> ScmPoly(collectModeFtvsInType(t, vs), t),
    ScmPolyConstrained(vs, cs, t) -> {
        let acc = cellNew(vs);
        let cur = cellNew(cs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(c, r) -> {
                    let ca = cellNew(c.typeArgs);
                    while (match cellGet(ca) { Nil -> false, _ -> true }) {
                        match cellGet(ca) {
                            Cons(ta, ra) -> {
                                cellSet(acc, collectModeFtvsInType(ta, cellGet(acc)));
                                cellSet(ca, ra)
                            },
                            Nil -> (),
                        }
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        ScmPolyConstrained(collectModeFtvsInType(t, cellGet(acc)), cs, t)
    },
}

def expandPolyScheme(ctx: InferCtx, scm: Scheme, sp: Span): Result Scheme String = {
    let escm = expandScheme(ctx, scm, sp)?;
    Ok(quantifyModeVarsInScheme(escm))
}

pub def buildPairMap(ks: List String, vs: List Type): StrMap Type = {
    let m: StrMap Type = strMapNew();
    let ck = cellNew(ks);
    let cv = cellNew(vs);
    while (match (cellGet(ck), cellGet(cv)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
        match (cellGet(ck), cellGet(cv)) {
            (Cons(k, kr), Cons(v, vr)) -> {
                strMapInsert(m, k, v);
                cellSet(ck, kr);
                cellSet(cv, vr)
            },
            _ -> (),
        }
    };
    m
}

// ============================================================================
// Kind Inference & Checking (`*`, `* -> *`, ...)
// ============================================================================

def freshKindVar(ctx: InferCtx): Kind = {
    let n = cellGet(ctx.kindUnique);
    cellSet(ctx.kindUnique, n + 1);
    KVar("k" + intToStr(n))
}

def zonkKind(subst: StrMap Kind, k: Kind): Kind = match k {
    KStar -> KStar,
    KArr(a, b) -> KArr(zonkKind(subst, a), zonkKind(subst, b)),
    KVar(v) -> match strMapGet(subst, v) {
        None -> k,
        Some(t) -> {
            let zt = zonkKind(subst, t);
            strMapInsert(subst, v, zt);
            zt
        },
    },
}

def kindToString(k: Kind): String = match k {
    KStar -> "*",
    KArr(a, b) -> match a {
        KArr(_, _) -> "(" + kindToString(a) + ") -> " + kindToString(b),
        _ -> kindToString(a) + " -> " + kindToString(b),
    },
    KVar(v) -> v,
}

def kindOccurs(v: String, k: Kind): Bool = match k {
    KStar -> false,
    KVar(w) -> v == w,
    KArr(a, b) -> kindOccurs(v, a) || kindOccurs(v, b),
}

def unifyKinds(subst: StrMap Kind, a0: Kind, b0: Kind, sp: Span): Result Void String = {
    let a = zonkKind(subst, a0);
    let b = zonkKind(subst, b0);
    match (a, b) {
        (KStar, KStar) -> Ok(()),
        (KVar(va), KVar(vb)) ->
            if (va == vb) Ok(())
            else { strMapInsert(subst, va, b); Ok(()) },
        (KVar(va), _) ->
            if (kindOccurs(va, b)) Err(typeErr(sp, "Infinite kind involving '" + va + "'"))
            else { strMapInsert(subst, va, b); Ok(()) },
        (_, KVar(vb)) ->
            if (kindOccurs(vb, a)) Err(typeErr(sp, "Infinite kind involving '" + vb + "'"))
            else { strMapInsert(subst, vb, a); Ok(()) },
        (KArr(a1, a2), KArr(b1, b2)) -> {
            unifyKinds(subst, a1, b1, sp)?;
            unifyKinds(subst, a2, b2, sp)
        },
        _ -> Err(typeErr(sp, "Kind mismatch: expected '" + kindToString(a) + "', got '" + kindToString(b) + "'")),
    }
}

def defaultKindToStar(subst: StrMap Kind, k: Kind): Kind = match zonkKind(subst, k) {
    KStar -> KStar,
    KVar(_) -> KStar,
    KArr(a, b) -> KArr(defaultKindToStar(subst, a), defaultKindToStar(subst, b)),
}

def buildArrowKind(paramKinds: List Kind, retKind: Kind): Kind = match paramKinds {
    Nil -> retKind,
    Cons(k, r) -> KArr(k, buildArrowKind(r, retKind)),
}

def stripSimdMarkerMod(s: String): String = {
    let n = strLen(s);
    let lastDot = cellNew(-1);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        if (strByteAt(s, cellGet(i)) == 46) cellSet(lastDot, cellGet(i)) else ();
        cellSet(i, cellGet(i) + 1)
    };
    let d = cellGet(lastDot);
    if (d >= 0) strSlice(s, d + 1, n) else s
}

def simdMarkerLanes(ln: String): Int = {
    let b = stripSimdMarkerMod(ln);
    if (b == "L2") 2
    else if (b == "L4") 4
    else if (b == "L8") 8
    else if (b == "L16") 16
    else if (b == "L32") 32
    else 0
}

def simdMarkerElemBytes(en: String): Int = {
    let b = stripSimdMarkerMod(en);
    if (b == "I8" || b == "U8") 1
    else if (b == "I16" || b == "U16") 2
    else if (b == "Int" || b == "I32" || b == "U32" || b == "Float32" || b == "F32") 4
    else if (b == "Int64" || b == "I64" || b == "U64" || b == "Float" || b == "F64") 8
    else 0
}

def validateSimdAppIfConcrete(ty: Type, sp: Span): Result Void String = match ty {
    TyComp(TyComp(TyCon("Simd"), laneTy), elemTy) -> match (laneTy, elemTy) {
        (TyVar(_), _) -> Ok(()),
        (_, TyVar(_)) -> Ok(()),
        (TyCon(ln), TyCon(en)) -> {
            let lanes = simdMarkerLanes(ln);
            let ebytes = simdMarkerElemBytes(en);
            let total = lanes * ebytes;
            if (lanes > 0 && ebytes > 0 && (total == 16 || total == 32)) Ok(())
            else Err(typeErr(sp, "Invalid SIMD vector type '" + typeToString(ty) + "': expected 128-bit or 256-bit vector over (L2..L32) and (I8/U8/I16/U16/Int/U32/Int64/U64/Float32/Float)"))
        },
        _ -> Err(typeErr(sp, "Invalid SIMD vector type '" + typeToString(ty) + "': expected concrete lane marker (L2..L32) and scalar/element marker")),
    },
    _ -> Ok(()),
}

def inferTypeKind(ctx: InferCtx, ty: Type, tvKinds: StrMap Kind, sp: Span): Result Kind String = match ty {
    TyVoid -> Ok(KStar),
    TyCon(name) -> match strMapGet(ctx.tyConKinds, name) {
        Some(k) -> Ok(k),
        None -> Ok(KStar),
    },
    TyVar(v) -> match strMapGet(tvKinds, v) {
        Some(k) -> Ok(k),
        None -> {
            let k = freshKindVar(ctx);
            strMapInsert(tvKinds, v, k);
            Ok(k)
        },
    },
    TyArr(m, ps, r) -> {
        let km = inferTypeKind(ctx, m, tvKinds, sp)?;
        unifyKinds(ctx.kindSubst, km, KStar, sp)?;
        let cp = cellNew(ps);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(p, rp) -> {
                    let kp = inferTypeKind(ctx, p, tvKinds, sp)?;
                    unifyKinds(ctx.kindSubst, kp, KStar, sp)?;
                    cellSet(cp, rp)
                },
                Nil -> (),
            }
        };
        let kr = inferTypeKind(ctx, r, tvKinds, sp)?;
        unifyKinds(ctx.kindSubst, kr, KStar, sp)?;
        Ok(KStar)
    },
    TyTuple(es) -> {
        let ce = cellNew(es);
        while (match cellGet(ce) { Nil -> false, _ -> true }) {
            match cellGet(ce) {
                Cons(e, re) -> {
                    let ke = inferTypeKind(ctx, e, tvKinds, sp)?;
                    unifyKinds(ctx.kindSubst, ke, KStar, sp)?;
                    cellSet(ce, re)
                },
                Nil -> (),
            }
        };
        Ok(KStar)
    },
    TyComp(b, a) -> {
        let kb = inferTypeKind(ctx, b, tvKinds, sp)?;
        let ka = inferTypeKind(ctx, a, tvKinds, sp)?;
        let kres = freshKindVar(ctx);
        unifyKinds(ctx.kindSubst, kb, KArr(ka, kres), sp)?;
        validateSimdAppIfConcrete(ty, sp)?;
        Ok(zonkKind(ctx.kindSubst, kres))
    },
}

def checkTypeKindStar(ctx: InferCtx, ty: Type, tvKinds: StrMap Kind, sp: Span): Result Void String = {
    let k = inferTypeKind(ctx, ty, tvKinds, sp)?;
    unifyKinds(ctx.kindSubst, k, KStar, sp)
}

def checkConstraintsKinds(ctx: InferCtx, cs: List ConstraintSpec, tvKinds: StrMap Kind, sp: Span): Result Void String = {
    let cur = cellNew(cs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(c, r) -> {
                match strMapGet(ctx.conceptReg, c.conceptName) {
                    None -> returnPatErr(sp, "Unknown concept '" + c.conceptName + "' in constraint")?,
                    Some(cinfo) -> {
                        if (listLen(c.typeArgs) != listLen(cinfo.paramKinds)) {
                            returnPatErr(sp, "Concept '" + c.conceptName + "' arity mismatch in constraint")?
                        } else ();
                        let ca = cellNew(c.typeArgs);
                        let ck = cellNew(cinfo.paramKinds);
                        while (match cellGet(ca) { Nil -> false, _ -> true }) {
                            match (cellGet(ca), cellGet(ck)) {
                                (Cons(ta, ra), Cons(pk, rk)) -> {
                                    let ak = inferTypeKind(ctx, ta, tvKinds, sp)?;
                                    unifyKinds(ctx.kindSubst, ak, pk, sp)?;
                                    cellSet(ca, ra);
                                    cellSet(ck, rk)
                                },
                                _ -> cellSet(ca, Nil),
                            }
                        }
                    },
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    Ok(())
}

def checkSchemeKinds(ctx: InferCtx, scm: Scheme, sp: Span): Result Void String = {
    let tvKinds: StrMap Kind = strMapNew();
    checkConstraintsKinds(ctx, schemeConstraints(scm), tvKinds, sp)?;
    checkTypeKindStar(ctx, schemeBody(scm), tvKinds, sp)
}

def registerBuiltinArithConceptSpec(
    ctx: InferCtx,
    conceptName: String,
    methodName: String,
    primNames: List String
): Void = {
    let tvA = TyVar("a");
    let tvB = TyVar("b");
    let tvC = TyVar("c");
    let tvM = TyVar(".$m_op");
    let methodTy = TyArr(tvM, [tvA, tvB], tvC);
    let scm = ScmPolyConstrained(
        ["a", "b", "c", ".$m_op"],
        [MkConstraint { conceptName: conceptName, typeArgs: [tvA, tvB, tvC] }],
        methodTy
    );
    strMapInsert(ctx.conceptMethods, methodName, (conceptName, 0));
    strMapInsert(ctx.conceptReg, conceptName, MkConceptInfo {
        conceptName: conceptName,
        typeParams: ["a", "b", "c"],
        paramKinds: [KStar, KStar, KStar],
        superclasses: Nil,
        fundeps: [MkFunDep { fdLhs: ["a", "b"], fdRhs: ["c"] }],
        methods: [(methodName, scm)],
    });
    let cur = cellNew(primNames);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(p, r) -> {
                let pt = TyCon(p);
                let inst = MkInstanceInfo {
                    conceptName: conceptName,
                    typeParams: Nil,
                    constraints: Nil,
                    targetTypes: [pt, pt, pt],
                    methodImpls: strMapNew(),
                };
                cellSet(ctx.instanceReg, listAppend(cellGet(ctx.instanceReg), [inst]));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def registerBuiltinConceptSpec(
    ctx: InferCtx,
    conceptName: String,
    methodName: String,
    methodTy: Type,
    primNames: List String
): Void = {
    let scm = ScmPolyConstrained(
        ["a", ".$m_op"],
        [MkConstraint { conceptName: conceptName, typeArgs: [TyVar("a")] }],
        methodTy
    );
    strMapInsert(ctx.conceptMethods, methodName, (conceptName, 0));
    strMapInsert(ctx.conceptReg, conceptName, MkConceptInfo {
        conceptName: conceptName,
        typeParams: ["a"],
        paramKinds: [KStar],
        superclasses: Nil,
        fundeps: Nil,
        methods: [(methodName, scm)],
    });
    let cur = cellNew(primNames);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(p, r) -> {
                let inst = MkInstanceInfo {
                    conceptName: conceptName,
                    typeParams: Nil,
                    constraints: Nil,
                    targetTypes: [TyCon(p)],
                    methodImpls: strMapNew(),
                };
                cellSet(ctx.instanceReg, listAppend(cellGet(ctx.instanceReg), [inst]));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def initInferCtx(): InferCtx = {
    let ctx = MkInferCtx {
        unique: cellNew(0),
        subst: strMapNew(),
        kindUnique: cellNew(0),
        kindSubst: strMapNew(),
        tyConKinds: strMapNew(),
        wanted: cellNew(Nil),
        aliasReg: strMapNew(),
        adtReg: strMapNew(),
        adtNames: vecNew(),
        ctorToAdt: strMapNew(),
        modeAdtSet: strMapNew(),
        taintedTopSet: strMapNew(),
        globalValSet: strMapNew(),
        externSet: strMapNew(),
        conceptReg: strMapNew(),
        instanceReg: cellNew(Nil),
        conceptMethods: strMapNew(),
    };
    let kStarNames = ["Int", "Int64", "Float", "Float32", "Char", "String", "Bool", "Void", "Ptr", "ForeignPtr", "ScopedPtr", "Arena", "AtomicInt", "Unit", "$Local", "$Shared", "$Scoped"];
    let ck0 = cellNew(kStarNames);
    while (match cellGet(ck0) { Nil -> false, _ -> true }) {
        match cellGet(ck0) {
            Cons(n, r) -> { strMapInsert(ctx.tyConKinds, n, KStar); cellSet(ck0, r) },
            Nil -> (),
        }
    };
    let kUnaryNames = ["List", "Cell", "MutArray", "ImmArray", "MVar", "Chan", "Task", "Actor", "Named"];
    let ck1 = cellNew(kUnaryNames);
    while (match cellGet(ck1) { Nil -> false, _ -> true }) {
        match cellGet(ck1) {
            Cons(n, r) -> { strMapInsert(ctx.tyConKinds, n, KArr(KStar, KStar)); cellSet(ck1, r) },
            Nil -> (),
        }
    };
    strMapInsert(ctx.tyConKinds, "Prod", KArr(KStar, KArr(KStar, KStar)));
    strMapInsert(ctx.tyConKinds, "Sum", KArr(KStar, KArr(KStar, KStar)));
    strMapInsert(ctx.tyConKinds, "Simd", KArr(KStar, KArr(KStar, KStar)));
    let tvA = TyVar("a");
    let tvM = TyVar(".$m_op");
    let binSame = TyArr(tvM, [tvA, tvA], tvA);
    let unSame = TyArr(tvM, [tvA], tvA);
    let binBool = TyArr(tvM, [tvA, tvA], TyCon("Bool"));
    let binInt = TyArr(tvM, [tvA, tvA], TyCon("Int"));
    let binShift = TyArr(tvM, [tvA, TyCon("Int")], tvA);

    registerBuiltinArithConceptSpec(ctx, "Add", "$op$plus", ["Int", "Int64", "Float", "Float32", "String"]);
    registerBuiltinArithConceptSpec(ctx, "Sub", "$op$minus", ["Int", "Int64", "Float", "Float32"]);
    registerBuiltinArithConceptSpec(ctx, "Mul", "$op$star", ["Int", "Int64", "Float", "Float32"]);
    registerBuiltinArithConceptSpec(ctx, "Div", "$op$slash", ["Int", "Int64", "Float", "Float32"]);
    registerBuiltinConceptSpec(ctx, "Rem", "$op$rem", binSame, ["Int", "Int64"]);
    registerBuiltinConceptSpec(ctx, "Neg", "neg", unSame, ["Int", "Int64", "Float", "Float32"]);
    registerBuiltinConceptSpec(ctx, "BitAnd", "$op$amp", binSame, ["Int", "Int64", "Bool"]);
    registerBuiltinConceptSpec(ctx, "BitOr", "$op$bar", binSame, ["Int", "Int64", "Bool"]);
    registerBuiltinConceptSpec(ctx, "BitXor", "$op$caret", binSame, ["Int", "Int64", "Bool"]);
    registerBuiltinConceptSpec(ctx, "BitNot", "$op$tilde", unSame, ["Int", "Int64"]);
    registerBuiltinConceptSpec(ctx, "Shl", "$op$lt_lt", binShift, ["Int", "Int64"]);
    registerBuiltinConceptSpec(ctx, "Shr", "$op$gt_gt", binShift, ["Int", "Int64"]);
    registerBuiltinConceptSpec(ctx, "Ushr", "$op$gt_gt_gt", binShift, ["Int", "Int64"]);
    registerBuiltinConceptSpec(ctx, "Eq", "eq", binBool, ["Int", "Int64", "Float", "Float32", "Bool", "Char", "String"]);
    registerBuiltinConceptSpec(ctx, "Ord", "compare", binInt, ["Int", "Int64", "Float", "Float32", "Char", "String"]);

    strMapInsert(ctx.conceptReg, "Send", MkConceptInfo {
        conceptName: "Send",
        typeParams: ["a"],
        paramKinds: [KStar],
        superclasses: Nil,
        fundeps: Nil,
        methods: Nil,
    });
    strMapInsert(ctx.conceptReg, "SendIf", MkConceptInfo {
        conceptName: "SendIf",
        typeParams: ["m", "a"],
        paramKinds: [KStar, KStar],
        superclasses: Nil,
        fundeps: Nil,
        methods: Nil,
    });

    // Default `List a { Nil, Cons(a, List a) }`
    let listTy = TyComp(TyCon("List"), tvA);
    let nilScm = ScmPoly(["a"], listTy);
    let consScm = ScmPoly([".$m_cons", "a"], TyArr(TyVar(".$m_cons"), [tvA, listTy], listTy));
    strMapInsert(ctx.adtReg, "List", MkAdtInfo {
        adtName: "List",
        typeParams: ["a"],
        variants: [
            MkVariantInfo { vname: "Nil", tag: 0, fieldNames: None, fieldTypes: Nil, ctorScm: nilScm },
            MkVariantInfo { vname: "Cons", tag: 1, fieldNames: None, fieldTypes: [tvA, listTy], ctorScm: consScm },
        ],
        isCStruct: false,
    });
    vecPush(ctx.adtNames, "List");
    strMapInsert(ctx.ctorToAdt, "Nil", "List");
    strMapInsert(ctx.ctorToAdt, "Cons", "List");

    // Built-in structural Generic representation ADTs (`Unit`, `Named`, `Prod`, `Sum`)
    let tvB = TyVar("b");
    let unitTy = TyCon("Unit");
    let mkUnitScm = ScmMono(unitTy);
    strMapInsert(ctx.adtReg, "Unit", MkAdtInfo {
        adtName: "Unit",
        typeParams: Nil,
        variants: [
            MkVariantInfo { vname: "Unit", tag: 0, fieldNames: None, fieldTypes: Nil, ctorScm: mkUnitScm },
        ],
        isCStruct: false,
    });
    vecPush(ctx.adtNames, "Unit");
    strMapInsert(ctx.ctorToAdt, "Unit", "Unit");

    let namedTy = TyComp(TyCon("Named"), tvA);
    let mkNamedScm = ScmPoly([".$m_named", "a"], TyArr(TyVar(".$m_named"), [TyCon("String"), tvA], namedTy));
    strMapInsert(ctx.adtReg, "Named", MkAdtInfo {
        adtName: "Named",
        typeParams: ["a"],
        variants: [
            MkVariantInfo { vname: "Named", tag: 0, fieldNames: None, fieldTypes: [TyCon("String"), tvA], ctorScm: mkNamedScm },
        ],
        isCStruct: false,
    });
    vecPush(ctx.adtNames, "Named");
    strMapInsert(ctx.ctorToAdt, "Named", "Named");

    let prodTy = TyComp(TyComp(TyCon("Prod"), tvA), tvB);
    let mkProdScm = ScmPoly([".$m_prod", "a", "b"], TyArr(TyVar(".$m_prod"), [tvA, tvB], prodTy));
    strMapInsert(ctx.adtReg, "Prod", MkAdtInfo {
        adtName: "Prod",
        typeParams: ["a", "b"],
        variants: [
            MkVariantInfo { vname: "Prod", tag: 0, fieldNames: None, fieldTypes: [tvA, tvB], ctorScm: mkProdScm },
        ],
        isCStruct: false,
    });
    vecPush(ctx.adtNames, "Prod");
    strMapInsert(ctx.ctorToAdt, "Prod", "Prod");

    let sumTy = TyComp(TyComp(TyCon("Sum"), tvA), tvB);
    let inLScm = ScmPoly([".$m_inl", "a", "b"], TyArr(TyVar(".$m_inl"), [tvA], sumTy));
    let inRScm = ScmPoly([".$m_inr", "a", "b"], TyArr(TyVar(".$m_inr"), [tvB], sumTy));
    strMapInsert(ctx.adtReg, "Sum", MkAdtInfo {
        adtName: "Sum",
        typeParams: ["a", "b"],
        variants: [
            MkVariantInfo { vname: "InL", tag: 0, fieldNames: None, fieldTypes: [tvA], ctorScm: inLScm },
            MkVariantInfo { vname: "InR", tag: 1, fieldNames: None, fieldTypes: [tvB], ctorScm: inRScm },
        ],
        isCStruct: false,
    });
    vecPush(ctx.adtNames, "Sum");
    strMapInsert(ctx.ctorToAdt, "InL", "Sum");
    strMapInsert(ctx.ctorToAdt, "InR", "Sum");
    ctx
}

def fillPreludeModes(ty: Type, counter: Cell Int, sharedParamIdxOpt: Option Int): Type = match ty {
    TyArr(m, ps, r) -> {
        let idx = cellGet(counter);
        cellSet(counter, idx + 1);
        let nm = match m {
            TyVoid -> TyVar(".$mp" + intToStr(idx)),
            _ -> m,
        };
        let nps = cellNew(Nil);
        let pIdx = cellNew(0);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(pt, rest) -> {
                    let curPi = cellGet(pIdx);
                    let ept = match sharedParamIdxOpt {
                        Some(targetIdx) ->
                            if (curPi == targetIdx) {
                                match pt {
                                    TyArr(_, cPs, cRet) -> TyArr(TyCon("$Shared"), fillPreludeModesList(cPs, counter), fillPreludeModes(cRet, counter, None)),
                                    _ -> fillPreludeModes(pt, counter, None),
                                }
                            } else fillPreludeModes(pt, counter, None),
                        None -> fillPreludeModes(pt, counter, None),
                    };
                    cellSet(nps, listAppend(cellGet(nps), [ept]));
                    cellSet(pIdx, curPi + 1);
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        };
        TyArr(nm, cellGet(nps), fillPreludeModes(r, counter, None))
    },
    TyTuple(es) -> TyTuple(fillPreludeModesList(es, counter)),
    TyComp(b, a) -> TyComp(fillPreludeModes(b, counter, None), fillPreludeModes(a, counter, None)),
    _ -> ty,
}

def fillPreludeModesList(ts: List Type, counter: Cell Int): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(fillPreludeModes(h, counter, None), fillPreludeModesList(t, counter)),
}

def finalizePreludeScheme(nm: String, rawScm: Scheme): Scheme = {
    let sharedIdx: Option Int =
        if (nm == "__concTaskSpawn" || nm == "__concActorSpawn") Some(0)
        else if (nm == "__concActorCall" || nm == "__concActorSend" || nm == "parTabulate") Some(1)
        else None;
    let cnt = cellNew(0);
    let updated = match rawScm {
        ScmMono(t) -> ScmMono(fillPreludeModes(t, cnt, sharedIdx)),
        ScmPoly(vs, t) -> ScmPoly(vs, fillPreludeModes(t, cnt, sharedIdx)),
        ScmPolyConstrained(vs, cs, t) -> ScmPolyConstrained(vs, cs, fillPreludeModes(t, cnt, sharedIdx)),
        ScmSlot -> ScmSlot,
    };
    quantifyModeVarsInScheme(updated)
}

