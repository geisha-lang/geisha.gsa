// Multi-file, Demand-Driven Path Module, and Package-Scoped Loader (`loader`).
//
// Supports:
// 1. Path-as-module on-demand loading via `use` / `open` (no `mod.gsa` or `mod foo` needed),
//    including sibling umbrella modules (`stage.gsa` + `stage/*.gsa`).
// 2. Hermetic package-scoped dependency graphs (`PkgSpec`: explicit `[deps]` aliases,
//    own-package `use <pkg>.<sub>` & relative `use <sub>`, phantom-dependency blocking).
// 3. Cross-package Concept/Instance Orphan Rule enforcement on library packages.
// 4. Full backward compatibility with inline `mod Name { ... }`, `mod foo`, `mod.gsa`, and `-L`.

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend, listLen}
use std.control.{fmap}
use std.str.{strJoin, strSplitChar, strStartsWith, strEndsWith}
use std.path.{pathJoin, pathStem, pathDirname, pathBasename}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains, strMapRemove}
use std.buf.{bufNew, bufPushByte, bufPushStr, bufToString}
use std.vec.{Vec, vecNew, vecPush, vecLen, vecGetOr}
use sys.fs.{fileExists, readFile}
use std.char.isUpperByte
use ast.{
    Span, Visibility, VisPublic, isPublicVis,
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    ConstraintSpec, MkConstraint,
    Scheme, ScmMono, ScmPoly, ScmPolyConstrained, ScmSlot,
    VarDecl, MkVarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct,
    MatchArm, MkMatchArm,
    Form, MkForm, mkForm,
    Expr, ExLit, ExVar, ExTuple, ExStructInit, ExList, ExBlock, ExApply,
    ExAbs, ExBin, ExUn, ExLet, ExIf, ExWhile, ExMatch, ExField, ExTry,
    FieldDecl, MkFieldDecl, VariantBody, VarUnit, VarTuple, VarStruct,
    VariantDef, MkVariantDef, MethodDecl, MkMethodDecl, MethodImpl, MkMethodImpl,
    Item, ItForm, ItExtern, ItAlias, ItAlg, ItConcept, ItInstance,
    Def, MkDef, UseSpec, useSpecLocalName,
    UseItem, UseSingle, UseMulti, UseGlob, UseAlias,
    ModuleItem, ModDef, ModUse, ModSub, ModDecl,
    listContainsStr, addUniqueStr
}
use parser.{parseFileModuleInFile, defContainsTry, desugarTryInDef}
use diag.diagRegisterFile
use stdlib_bundle.builtinModuleSource

pub data PkgSpec {
    MkPkgSpec {
        pkgId: String,
        pkgName: String,
        srcRoots: List String,
        deps: List (String, String),
    },
}

pub data LoadedMod {
    MkLoadedMod {
        key: String,
        pkgOwner: String,
        modPath: List String,
        defs: List (Visibility, Def),
        imports: List (Visibility, UseItem),
        submodules: List String,
    },
}

pub data NameInfo {
    MkNameInfo { qualifiedName: String, isPublic: Bool, definedInMod: String },
}

def defaultRootPkg(srcRoots: List String): PkgSpec = MkPkgSpec {
    pkgId: "",
    pkgName: "",
    srcRoots: srcRoots,
    deps: Nil,
}

// ============================================================================
// Optional In-Memory Source Overlays (used by `geisha lsp` for unsaved buffers)
// ============================================================================

extern "gs_sys_realpath" def c_loader_realpath(path: String): Ptr
extern "free" def c_loader_free(p: Ptr): Void

def gLoaderOverlays: Cell (StrMap String) = cellNew(strMapNew())

def normalizeOverlayPath(path: String): String = {
    let n = strLen(path);
    let b = bufNew();
    let i = cellNew(0);
    let prevSlash = cellNew(false);
    // Preserve leading `//` for UNC paths
    if (n >= 2 && (strByteAt(path, 0) == 47 || strByteAt(path, 0) == 92) && (strByteAt(path, 1) == 47 || strByteAt(path, 1) == 92)) {
        bufPushStr(b, "//");
        cellSet(i, 2);
        cellSet(prevSlash, true)
    } else ();
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let ch0 = strByteAt(path, idx);
        let ch = if (ch0 == 92) 47 else ch0;
        if (ch == 47) {
            if (!cellGet(prevSlash)) {
                bufPushByte(b, 47);
                cellSet(prevSlash, true)
            } else ();
            cellSet(i, idx + 1)
        } else if (ch == 46 && idx + 1 < n && (strByteAt(path, idx + 1) == 47 || strByteAt(path, idx + 1) == 92) && (idx == 0 || cellGet(prevSlash))) {
            // Skip `./` segments
            cellSet(i, idx + 2)
        } else {
            bufPushByte(b, ch);
            cellSet(prevSlash, false);
            cellSet(i, idx + 1)
        }
    };
    bufToString(b)
}

def resolveRealPathRec(p: String): String = {
    let rp = c_loader_realpath(p);
    if (!ptrIsNull(rp)) {
        let b = bufNew();
        bufPushStr(b, ptrToString(rp));
        let res = bufToString(b);
        c_loader_free(rp);
        res
    } else {
        let parent = pathDirname(p);
        let base = pathBasename(p);
        if (parent != p && parent != "" && parent != "." && parent != "/") {
            pathJoin(resolveRealPathRec(parent), base)
        } else p
    }
}

pub def loaderCanonicalPath(path: String): String =
    normalizeOverlayPath(resolveRealPathRec(path))

pub def loaderClearOverlays(): Void =
    cellSet(gLoaderOverlays, strMapNew())

pub def loaderSetOverlay(path: String, src: String): Void =
    strMapInsert(cellGet(gLoaderOverlays), loaderCanonicalPath(path), src)

pub def loaderRemoveOverlay(path: String): Void = {
    let _ = strMapRemove(cellGet(gLoaderOverlays), loaderCanonicalPath(path));
    ()
}

def overlayFileExists(path: String): Bool =
    strMapContains(cellGet(gLoaderOverlays), loaderCanonicalPath(path)) || fileExists(path)

def overlayReadFile(path: String): Result String String =
    match strMapGet(cellGet(gLoaderOverlays), loaderCanonicalPath(path)) {
        Some(src) -> Ok(src),
        None -> readFile(path),
    }

def lookupAssocStr(pairs: List (String, String), key: String): Option String = match pairs {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else lookupAssocStr(r, key),
}

def listInit(xs: List String): List String = match xs {
    Nil -> Nil,
    Cons(_, Nil) -> Nil,
    Cons(h, t) -> Cons(h, listInit(t)),
}

def listLastOr(xs: List String, fallback: String): String = match xs {
    Nil -> fallback,
    Cons(h, Nil) -> h,
    Cons(_, t) -> listLastOr(t, fallback),
}

def joinKeyPrefix(prefix: String, suffix: String): String =
    if (prefix == "") suffix
    else if (suffix == "") prefix
    else prefix + "." + suffix

def extractModuleItems(
    pkgOwner: String,
    modPath: List String,
    items: List ModuleItem,
    inlineOut: Cell (List LoadedMod)
): (List (Visibility, Def), List (Visibility, UseItem), List String) = {
    let defsRev = cellNew(Nil);
    let impsRev = cellNew(Nil);
    let subs = cellNew(Nil);
    let cur = cellNew(items);
    let curKey = strJoin(modPath, ".");

    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(vis, d), r) -> {
                cellSet(defsRev, Cons((vis, d), cellGet(defsRev)));
                cellSet(cur, r)
            },
            Cons(ModUse(vis, u), r) -> {
                cellSet(impsRev, Cons((vis, u), cellGet(impsRev)));
                cellSet(cur, r)
            },
            Cons(ModDecl(_, childName), r) -> {
                let childKey = joinKeyPrefix(curKey, childName);
                cellSet(subs, addUniqueStr(cellGet(subs), childKey));
                cellSet(cur, r)
            },
            Cons(ModSub(_, subName, subItems, _), r) -> {
                let subPath = listAppend(modPath, [subName]);
                let subKey = strJoin(subPath, ".");
                let (sDefs, sImps, sSubs) = extractModuleItems(pkgOwner, subPath, subItems, inlineOut);
                let subLoaded = MkLoadedMod {
                    key: subKey,
                    pkgOwner: pkgOwner,
                    modPath: subPath,
                    defs: sDefs,
                    imports: sImps,
                    submodules: sSubs,
                };
                cellSet(inlineOut, listAppend(cellGet(inlineOut), [subLoaded]));
                cellSet(subs, addUniqueStr(cellGet(subs), subKey));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (listRev(cellGet(defsRev)), listRev(cellGet(impsRev)), cellGet(subs))
}

def resolveModFilePathInDir(srcRoot: String, segs: List String): Option String = match segs {
    Nil -> {
        let modFile = pathJoin(srcRoot, "mod.gsa");
        if (overlayFileExists(modFile)) Some(modFile) else None
    },
    _ -> {
        let cur = cellNew(segs);
        let p = cellNew(srcRoot);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(s, r) -> {
                    cellSet(p, pathJoin(cellGet(p), s));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let directFile = cellGet(p) + ".gsa";
        if (overlayFileExists(directFile)) Some(directFile)
        else {
            let modFile = pathJoin(cellGet(p), "mod.gsa");
            if (overlayFileExists(modFile)) Some(modFile) else None
        }
    },
}

def resolveModFilePathInDirs(roots: List String, segs: List String): Option String = match roots {
    Nil -> None,
    Cons(r, rest) -> match resolveModFilePathInDir(r, segs) {
        Some(fp) -> Some(fp),
        None -> resolveModFilePathInDirs(rest, segs),
    },
}

def resolvePkgRelModFile(pkg: PkgSpec, relSegs: List String): Option String = match relSegs {
    Nil -> {
        let namedOpt = if (pkg.pkgName != "") resolveModFilePathInDirs(pkg.srcRoots, [pkg.pkgName]) else None;
        match namedOpt {
            Some(fp) -> Some(fp),
            None -> resolveModFilePathInDirs(pkg.srcRoots, Nil),
        }
    },
    _ -> match resolveModFilePathInDirs(pkg.srcRoots, relSegs) {
        Some(fp) -> Some(fp),
        None ->
            if (pkg.pkgName != "") resolveModFilePathInDirs(pkg.srcRoots, Cons(pkg.pkgName, relSegs))
            else None,
    },
}

def findLibRootForMod(libPaths: List String, segs: List String): Option String = match libPaths {
    Nil -> None,
    Cons(root, rest) -> match resolveModFilePathInDir(root, segs) {
        Some(_) -> Some(root),
        None -> findLibRootForMod(rest, segs),
    },
}

def stripPkgPrefixSegs(pkgId: String, fullKey: String): List String =
    if (pkgId == "") {
        if (fullKey == "") Nil else strSplitChar(fullKey, '.')
    } else if (fullKey == pkgId) {
        Nil
    } else if (strStartsWith(fullKey, pkgId + ".")) {
        strSplitChar(strSlice(fullKey, strLen(pkgId) + 1, strLen(fullKey)), '.')
    } else {
        strSplitChar(fullKey, '.')
    }

def loadCanonicalFileModRec(
    pkg: PkgSpec,
    canonicalKey: String,
    fpath: String,
    pkgMap: StrMap PkgSpec,
    cache: StrMap LoadedMod,
    orderKeys: Vec String,
    loadingStack: List String
): Result Void String =
    if (strMapContains(cache, canonicalKey)) Ok(())
    else if (listContainsStr(loadingStack, canonicalKey)) {
        Err("Circular module dependency involving '" + canonicalKey + "'")
    } else {
        let src = overlayReadFile(fpath)?;
        let fid = diagRegisterFile(fpath, src);
        let keySegs = if (canonicalKey == "") Nil else strSplitChar(canonicalKey, '.');
        let fm = parseFileModuleInFile(src, keySegs, fid)?;
        let inlines: Cell (List LoadedMod) = cellNew(Nil);
        let (defs, imps, subs) = extractModuleItems(pkg.pkgId, keySegs, fm.items, inlines);
        let loaded = MkLoadedMod {
            key: canonicalKey,
            pkgOwner: pkg.pkgId,
            modPath: keySegs,
            defs: defs,
            imports: imps,
            submodules: subs,
        };
        strMapInsert(cache, canonicalKey, loaded);
        vecPush(orderKeys, canonicalKey);

        let curInl = cellNew(cellGet(inlines));
        while (match cellGet(curInl) { Nil -> false, _ -> true }) {
            match cellGet(curInl) {
                Cons(im, r) -> {
                    strMapInsert(cache, im.key, im);
                    vecPush(orderKeys, im.key);
                    cellSet(curInl, r)
                },
                Nil -> (),
            }
        };

        loadExplicitSubmodules(pkg, subs, pkgMap, cache, orderKeys, Cons(canonicalKey, loadingStack))
    }

def loadExplicitSubmodules(
    pkg: PkgSpec,
    subs: List String,
    pkgMap: StrMap PkgSpec,
    cache: StrMap LoadedMod,
    orderKeys: Vec String,
    loadingStack: List String
): Result Void String = match subs {
    Nil -> Ok(()),
    Cons(childKey, rest) -> {
        if (!strMapContains(cache, childKey)) {
            let relSegs = stripPkgPrefixSegs(pkg.pkgId, childKey);
            match resolvePkgRelModFile(pkg, relSegs) {
                Some(fp) -> loadCanonicalFileModRec(pkg, childKey, fp, pkgMap, cache, orderKeys, loadingStack)?,
                None -> returnLoadErr("Module '" + childKey + "' not found for package '" + (if (pkg.pkgName == "") "<root>" else pkg.pkgName) + "'")?,
            };
            loadExplicitSubmodules(pkg, rest, pkgMap, cache, orderKeys, loadingStack)
        } else {
            loadExplicitSubmodules(pkg, rest, pkgMap, cache, orderKeys, loadingStack)
        }
    },
}

def returnLoadErr(msg: String): Result Void String = Err(msg)

def moduleUsesTry(defs: List (Visibility, Def)): Bool = match defs {
    Nil -> false,
    Cons((_, d), r) -> if (defContainsTry(d)) true else moduleUsesTry(r),
}

def collectExprChainsInForm(f: Form, bound: List String, out: Cell (List (List String))): Void = match f.node {
    ExField(base, fname) -> match flattenFieldChainPlain(base) {
        Some((root, segs0)) -> {
            if (!listContainsStr(bound, root)) {
                let fullChain = Cons(root, listAppend(segs0, [fname]));
                let modPrefix = listInit(fullChain);
                match modPrefix {
                    Nil -> (),
                    _ -> cellSet(out, Cons(modPrefix, cellGet(out))),
                }
            } else ()
        },
        None -> collectExprChainsInForm(base, bound, out),
    },
    ExTuple(es) -> collectExprChainsInList(es, bound, out),
    ExList(es) -> collectExprChainsInList(es, bound, out),
    ExBlock(es) -> collectExprChainsInList(es, bound, out),
    ExStructInit(_, fs) -> {
        let cur = cellNew(fs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, vf), r) -> { collectExprChainsInForm(vf, bound, out); cellSet(cur, r) },
                Nil -> (),
            }
        }
    },
    ExApply(c, args) -> {
        collectExprChainsInForm(c, bound, out);
        collectExprChainsInList(args, bound, out)
    },
    ExBin(_, l, r) -> {
        collectExprChainsInForm(l, bound, out);
        collectExprChainsInForm(r, bound, out)
    },
    ExUn(_, e) -> collectExprChainsInForm(e, bound, out),
    ExTry(e) -> collectExprChainsInForm(e, bound, out),
    ExIf(c, t, e) -> {
        collectExprChainsInForm(c, bound, out);
        collectExprChainsInForm(t, bound, out);
        collectExprChainsInForm(e, bound, out)
    },
    ExWhile(c, b) -> {
        collectExprChainsInForm(c, bound, out);
        collectExprChainsInForm(b, bound, out)
    },
    ExAbs(ps, _, body) -> {
        let nb = cellNew(bound);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(vd, r) -> { cellSet(nb, addUniqueStr(cellGet(nb), vd.vname)); cellSet(cur, r) },
                Nil -> (),
            }
        };
        collectExprChainsInForm(body, cellGet(nb), out)
    },
    ExLet(vd, val, body) -> {
        collectExprChainsInForm(val, bound, out);
        collectExprChainsInForm(body, addUniqueStr(bound, vd.vname), out)
    },
    ExMatch(scrut, arms) -> {
        collectExprChainsInForm(scrut, bound, out);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let ab = cellNew(bound);
                    collectPatVars(a.pat, ab);
                    match a.guard {
                        Some(g) -> collectExprChainsInForm(g, cellGet(ab), out),
                        None -> (),
                    };
                    collectExprChainsInForm(a.body, cellGet(ab), out);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    _ -> (),
}

def collectExprChainsInList(es: List Form, bound: List String, out: Cell (List (List String))): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectExprChainsInForm(h, bound, out);
        collectExprChainsInList(t, bound, out)
    },
}

def collectPatVars(p: Pattern, bound: Cell (List String)): Void = match p {
    PatVar(v) -> cellSet(bound, addUniqueStr(cellGet(bound), v)),
    PatTuple(ps) -> {
        let c = cellNew(ps);
        while (match cellGet(c) { Nil -> false, _ -> true }) {
            match cellGet(c) { Cons(h, r) -> { collectPatVars(h, bound); cellSet(c, r) }, Nil -> () }
        }
    },
    PatCtor(_, ps) -> {
        let c = cellNew(ps);
        while (match cellGet(c) { Nil -> false, _ -> true }) {
            match cellGet(c) { Cons(h, r) -> { collectPatVars(h, bound); cellSet(c, r) }, Nil -> () }
        }
    },
    PatStruct(_, fs) -> {
        let c = cellNew(fs);
        while (match cellGet(c) { Nil -> false, _ -> true }) {
            match cellGet(c) { Cons((_, sp), r) -> { collectPatVars(sp, bound); cellSet(c, r) }, Nil -> () }
        }
    },
    _ -> (),
}

def flattenFieldChainPlain(f: Form): Option (String, List String) = match f.node {
    ExVar(root) -> Some((root, Nil)),
    ExField(inner, fname) -> match flattenFieldChainPlain(inner) {
        Some((root, segs)) -> Some((root, listAppend(segs, [fname]))),
        None -> None,
    },
    _ -> None,
}

def collectCandidateModPathsFromMod(m: LoadedMod): List (List String) = {
    let seen: StrMap Bool = strMapNew();
    let acc: Cell (List (List String)) = cellNew(Nil);

    let pushCand = (segs: List String) -> match segs {
        Nil -> (),
        _ -> {
            let k = strJoin(segs, ".");
            if (!strMapContains(seen, k)) {
                strMapInsert(seen, k, true);
                cellSet(acc, Cons(segs, cellGet(acc)))
            } else ()
        },
    };

    let curImp = cellNew(m.imports);
    while (match cellGet(curImp) { Nil -> false, _ -> true }) {
        match cellGet(curImp) {
            Cons((_, u), r) -> {
                match u {
                    UseMulti(p, _) -> pushCand(p),
                    UseGlob(p) -> pushCand(p),
                    UseSingle(p) -> {
                        if (listLen(p) >= 2) pushCand(listInit(p)) else ();
                        pushCand(p)
                    },
                    UseAlias(p, _) -> {
                        if (listLen(p) >= 2) pushCand(listInit(p)) else ();
                        pushCand(p)
                    },
                };
                cellSet(curImp, r)
            },
            Nil -> (),
        }
    };

    let exprChains: Cell (List (List String)) = cellNew(Nil);
    let curDef = cellNew(m.defs);
    while (match cellGet(curDef) { Nil -> false, _ -> true }) {
        match cellGet(curDef) {
            Cons((_, d), r) -> {
                match d.item {
                    ItForm(f) -> collectExprChainsInForm(f, Nil, exprChains),
                    ItInstance(_, _, _, ms) -> {
                        let cm = cellNew(ms);
                        while (match cellGet(cm) { Nil -> false, _ -> true }) {
                            match cellGet(cm) {
                                Cons(mi, rm) -> { collectExprChainsInForm(mi.implBody, Nil, exprChains); cellSet(cm, rm) },
                                Nil -> (),
                            }
                        }
                    },
                    _ -> (),
                };
                cellSet(curDef, r)
            },
            Nil -> (),
        }
    };

    let curCh = cellNew(cellGet(exprChains));
    while (match cellGet(curCh) { Nil -> false, _ -> true }) {
        match cellGet(curCh) {
            Cons(segs, r) -> {
                let pre = cellNew(Nil);
                let cs = cellNew(segs);
                while (match cellGet(cs) { Nil -> false, _ -> true }) {
                    match cellGet(cs) {
                        Cons(s, rs) -> {
                            let nextPre = listAppend(cellGet(pre), [s]);
                            cellSet(pre, nextPre);
                            pushCand(nextPre);
                            cellSet(cs, rs)
                        },
                        Nil -> (),
                    }
                };
                cellSet(curCh, r)
            },
            Nil -> (),
        }
    };

    listRev(cellGet(acc))
}

data PendingLoad {
    LoadBuiltin(String),
    LoadPkgFile(PkgSpec, String, String),
    LoadLegacyLib(String, List String, String),
}

def resolveDemandImportForPkg(
    curPkg: PkgSpec,
    curModKey: String,
    segs: List String,
    pkgMap: StrMap PkgSpec,
    cache: StrMap LoadedMod,
    libPaths: List String
): Option PendingLoad = match segs {
    Nil -> None,
    Cons(s0, rest) -> {
        let joined = strJoin(segs, ".");
        if (s0 == "std" || s0 == "sys") {
            if (strMapContains(cache, joined)) None
            else match builtinModuleSource(joined) {
                Some(_) -> Some(LoadBuiltin(joined)),
                None -> None,
            }
        } else {
            match lookupAssocStr(curPkg.deps, s0) {
                Some(targetPkgId) -> match strMapGet(pkgMap, targetPkgId) {
                    Some(targetPkg) -> {
                        let targetKey = joinKeyPrefix(targetPkg.pkgId, strJoin(rest, "."));
                        if (strMapContains(cache, targetKey)) None
                        else match resolvePkgRelModFile(targetPkg, rest) {
                            Some(fp) -> Some(LoadPkgFile(targetPkg, targetKey, fp)),
                            None -> None,
                        }
                    },
                    None -> None,
                },
                None -> {
                    let ownExplicitOpt: Option PendingLoad =
                        if (curPkg.pkgName != "" && s0 == curPkg.pkgName) {
                            let ownKey = joinKeyPrefix(curPkg.pkgId, strJoin(rest, "."));
                            if (strMapContains(cache, ownKey)) None
                            else match resolvePkgRelModFile(curPkg, rest) {
                                Some(fp) -> Some(LoadPkgFile(curPkg, ownKey, fp)),
                                None -> None,
                            }
                        } else None;

                    match ownExplicitOpt {
                        Some(pl) -> Some(pl),
                        None -> {
                            let childKey = joinKeyPrefix(curModKey, joined);
                            let relChildSegs = stripPkgPrefixSegs(curPkg.pkgId, childKey);
                            let childOpt: Option PendingLoad =
                                if (curModKey != "" && curModKey != curPkg.pkgId && !strMapContains(cache, childKey)) {
                                    match resolvePkgRelModFile(curPkg, relChildSegs) {
                                        Some(fp) -> Some(LoadPkgFile(curPkg, childKey, fp)),
                                        None -> None,
                                    }
                                } else None;

                            match childOpt {
                                Some(pl) -> Some(pl),
                                None -> {
                                    let pkgRelKey = joinKeyPrefix(curPkg.pkgId, joined);
                                    if (strMapContains(cache, pkgRelKey)) None
                                    else match resolvePkgRelModFile(curPkg, segs) {
                                        Some(fp) -> Some(LoadPkgFile(curPkg, pkgRelKey, fp)),
                                        None -> {
                                            if (!strMapContains(cache, joined)) {
                                                match findLibRootForMod(libPaths, segs) {
                                                    Some(lroot) -> Some(LoadLegacyLib(joined, segs, lroot)),
                                                    None -> None,
                                                }
                                            } else None
                                        },
                                    }
                                },
                            }
                        },
                    }
                },
            }
        }
    },
}

def loadAllReachableModules(
    pkgMap: StrMap PkgSpec,
    cache: StrMap LoadedMod,
    orderKeys: Vec String,
    libPaths: List String,
    legacyLibRoots: StrMap Bool
): Result Void String = {
    let keepGoing = cellNew(true);
    let errCell: Cell (Option String) = cellNew(None);
    let fallbackRoot = match strMapGet(pkgMap, "") {
        Some(rp) -> rp,
        None -> defaultRootPkg(Nil),
    };

    while (cellGet(keepGoing) && match cellGet(errCell) { None -> true, Some(_) -> false }) {
        let pendingRev: Cell (List PendingLoad) = cellNew(Nil);
        let queuedKeys: StrMap Bool = strMapNew();
        let n = vecLen(orderKeys);
        let i = cellNew(0);

        while (cellGet(i) < n) {
            let k = vecGetOr(orderKeys, cellGet(i), "");
            match strMapGet(cache, k) {
                Some(m) -> {
                    if (!strMapContains(cache, "std.result") && !strMapContains(queuedKeys, "std.result") && moduleUsesTry(m.defs)) {
                        strMapInsert(queuedKeys, "std.result", true);
                        cellSet(pendingRev, Cons(LoadBuiltin("std.result"), cellGet(pendingRev)))
                    } else ();

                    let curPkg = match strMapGet(pkgMap, m.pkgOwner) {
                        Some(p) -> p,
                        None -> fallbackRoot,
                    };
                    let cands = collectCandidateModPathsFromMod(m);
                    let cc = cellNew(cands);
                    while (match cellGet(cc) { Nil -> false, _ -> true }) {
                        match cellGet(cc) {
                            Cons(segs, rc) -> {
                                match resolveDemandImportForPkg(curPkg, m.key, segs, pkgMap, cache, libPaths) {
                                    Some(LoadBuiltin(bk)) ->
                                        if (!strMapContains(queuedKeys, bk)) {
                                            strMapInsert(queuedKeys, bk, true);
                                            cellSet(pendingRev, Cons(LoadBuiltin(bk), cellGet(pendingRev)))
                                        } else (),
                                    Some(LoadPkgFile(tp, tk, fp)) ->
                                        if (!strMapContains(queuedKeys, tk)) {
                                            strMapInsert(queuedKeys, tk, true);
                                            cellSet(pendingRev, Cons(LoadPkgFile(tp, tk, fp), cellGet(pendingRev)))
                                        } else (),
                                    Some(LoadLegacyLib(lk, lsegs, lroot)) ->
                                        if (!strMapContains(queuedKeys, lk)) {
                                            strMapInsert(queuedKeys, lk, true);
                                            cellSet(pendingRev, Cons(LoadLegacyLib(lk, lsegs, lroot), cellGet(pendingRev)))
                                        } else (),
                                    None -> (),
                                };
                                cellSet(cc, rc)
                            },
                            Nil -> (),
                        }
                    }
                },
                None -> (),
            };
            cellSet(i, cellGet(i) + 1)
        };

        let pending = listRev(cellGet(pendingRev));
        match pending {
            Nil -> cellSet(keepGoing, false),
            _ -> {
                let cp = cellNew(pending);
                while (match cellGet(cp) { Nil -> false, _ -> match cellGet(errCell) { None -> true, Some(_) -> false } }) {
                    match cellGet(cp) {
                        Cons(LoadBuiltin(bkey), rp) -> {
                            if (!strMapContains(cache, bkey)) {
                                match builtinModuleSource(bkey) {
                                    Some(bsrc) -> {
                                        let bfid = diagRegisterFile("<builtin>/" + bkey, bsrc);
                                        let bsegs = strSplitChar(bkey, '.');
                                        match parseFileModuleInFile(bsrc, bsegs, bfid) {
                                            Ok(fm) -> {
                                                let inlines: Cell (List LoadedMod) = cellNew(Nil);
                                                let (defs, imps, subs) = extractModuleItems("__stdlib", bsegs, fm.items, inlines);
                                                strMapInsert(cache, bkey, MkLoadedMod {
                                                    key: bkey,
                                                    pkgOwner: "__stdlib",
                                                    modPath: bsegs,
                                                    defs: defs,
                                                    imports: imps,
                                                    submodules: subs,
                                                });
                                                vecPush(orderKeys, bkey);
                                                let ci = cellNew(cellGet(inlines));
                                                while (match cellGet(ci) { Nil -> false, _ -> true }) {
                                                    match cellGet(ci) {
                                                        Cons(im, ri) -> {
                                                            strMapInsert(cache, im.key, im);
                                                            vecPush(orderKeys, im.key);
                                                            cellSet(ci, ri)
                                                        },
                                                        Nil -> (),
                                                    }
                                                }
                                            },
                                            Err(e) -> cellSet(errCell, Some("Stdlib '" + bkey + "': " + e)),
                                        }
                                    },
                                    None -> (),
                                }
                            } else ();
                            cellSet(cp, rp)
                        },
                        Cons(LoadPkgFile(tpkg, tkey, fp), rp) -> {
                            match loadCanonicalFileModRec(tpkg, tkey, fp, pkgMap, cache, orderKeys, Nil) {
                                Ok(_) -> (),
                                Err(e) -> cellSet(errCell, Some(e)),
                            };
                            cellSet(cp, rp)
                        },
                        Cons(LoadLegacyLib(lkey, lsegs, lroot), rp) -> {
                            let rootSeg = match lsegs { Cons(h, _) -> h, Nil -> lkey };
                            strMapInsert(legacyLibRoots, rootSeg, true);
                            let legacyPkg = MkPkgSpec {
                                pkgId: "",
                                pkgName: "",
                                srcRoots: [lroot],
                                deps: Nil,
                            };
                            match resolveModFilePathInDir(lroot, lsegs) {
                                Some(fp) -> match loadCanonicalFileModRec(legacyPkg, lkey, fp, pkgMap, cache, orderKeys, Nil) {
                                    Ok(_) -> (),
                                    Err(e) -> cellSet(errCell, Some(e)),
                                },
                                None -> (),
                            };
                            cellSet(cp, rp)
                        },
                        Nil -> (),
                    }
                }
            },
        }
    };

    match cellGet(errCell) {
        Some(e) -> Err(e),
        None -> Ok(()),
    }
}

def cacheModOwnedBy(cache: StrMap LoadedMod, key: String, expectedOwner: String): Bool =
    match strMapGet(cache, key) {
        Some(m) -> m.pkgOwner == expectedOwner,
        None -> false,
    }

def translateModSegsForPkg(
    curPkg: PkgSpec,
    curModKey: String,
    segs: List String,
    cache: StrMap LoadedMod,
    legacyLibRoots: StrMap Bool
): Option String = match segs {
    Nil -> if (strMapContains(cache, curModKey)) Some(curModKey) else None,
    Cons(s0, rest) -> {
        let joined = strJoin(segs, ".");
        let relChild = joinKeyPrefix(curModKey, joined);
        if (curModKey != "" && cacheModOwnedBy(cache, relChild, curPkg.pkgId)) {
            Some(relChild)
        } else if (s0 == "std" || s0 == "sys") {
            if (strMapContains(cache, joined)) Some(joined) else None
        } else {
            match lookupAssocStr(curPkg.deps, s0) {
                Some(targetPkgId) -> {
                    let depKey = joinKeyPrefix(targetPkgId, strJoin(rest, "."));
                    if (cacheModOwnedBy(cache, depKey, targetPkgId)) Some(depKey) else None
                },
                None -> {
                    let ownExplicit: Option String =
                        if (curPkg.pkgName != "" && s0 == curPkg.pkgName) {
                            let ok1 = joinKeyPrefix(curPkg.pkgId, strJoin(rest, "."));
                            if (cacheModOwnedBy(cache, ok1, curPkg.pkgId)) Some(ok1) else None
                        } else None;
                    match ownExplicit {
                        Some(k) -> Some(k),
                        None -> {
                            let pkgRel = joinKeyPrefix(curPkg.pkgId, joined);
                            if (cacheModOwnedBy(cache, pkgRel, curPkg.pkgId)) Some(pkgRel)
                            else if (strMapContains(legacyLibRoots, s0) && cacheModOwnedBy(cache, joined, "")) {
                                Some(joined)
                            } else None
                        },
                    }
                },
            }
        }
    },
}

def lookupScopedItem(
    curPkg: PkgSpec,
    curModKey: String,
    modSegs: List String,
    itemName: String,
    cache: StrMap LoadedMod,
    legacyLibRoots: StrMap Bool,
    avail: StrMap NameInfo
): Option NameInfo = match modSegs {
    Nil -> {
        let localKey = joinKeyPrefix(curModKey, itemName);
        match strMapGet(avail, localKey) {
            Some(info) -> Some(info),
            None ->
                if (curPkg.pkgId == "") strMapGet(avail, itemName)
                else strMapGet(avail, joinKeyPrefix(curPkg.pkgId, itemName)),
        }
    },
    _ -> match translateModSegsForPkg(curPkg, curModKey, modSegs, cache, legacyLibRoots) {
        Some(canonMod) -> strMapGet(avail, joinKeyPrefix(canonMod, itemName)),
        None -> None,
    },
}

def topoVisit(
    key: String,
    depsMap: StrMap (List String),
    stateMap: StrMap Int,
    outOrder: Cell (List String)
): Result Void String = {
    let st = match strMapGet(stateMap, key) { Some(v) -> v, None -> 0 };
    if (st == 2) Ok(())
    else if (st == 1) Err("Circular dependency detected involving module '" + key + "'")
    else {
        strMapInsert(stateMap, key, 1);
        let deps = match strMapGet(depsMap, key) { Some(ds) -> ds, None -> Nil };
        topoVisitList(deps, depsMap, stateMap, outOrder)?;
        strMapInsert(stateMap, key, 2);
        cellSet(outOrder, listAppend(cellGet(outOrder), [key]));
        Ok(())
    }
}

def topoVisitList(
    keys: List String,
    depsMap: StrMap (List String),
    stateMap: StrMap Int,
    outOrder: Cell (List String)
): Result Void String = match keys {
    Nil -> Ok(()),
    Cons(k, r) -> {
        topoVisit(k, depsMap, stateMap, outOrder)?;
        topoVisitList(r, depsMap, stateMap, outOrder)
    },
}

def resolveModuleImports(
    imports: List (Visibility, UseItem),
    curPkg: PkgSpec,
    curMod: String,
    cache: StrMap LoadedMod,
    legacyLibRoots: StrMap Bool,
    avail: StrMap NameInfo,
    allExportKeys: Vec String
): Result (List (String, String), List (String, String)) String = {
    let mappingsRev: Cell (List (String, String)) = cellNew(Nil);
    let modAliasesRev: Cell (List (String, String)) = cellNew(Nil);
    let errCell: Cell (Option String) = cellNew(None);
    let cur = cellNew(imports);

    while (match cellGet(cur) { Nil -> false, _ -> match cellGet(errCell) { None -> true, Some(_) -> false } }) {
        match cellGet(cur) {
            Cons((_, UseSingle(path)), r) -> {
                let modSegs = listInit(path);
                let itemName = listLastOr(path, "");
                let modStr = strJoin(modSegs, ".");
                match lookupScopedItem(curPkg, curMod, modSegs, itemName, cache, legacyLibRoots, avail) {
                    Some(info) ->
                        if (info.isPublic || info.definedInMod == curMod) {
                            cellSet(mappingsRev, Cons((itemName, info.qualifiedName), cellGet(mappingsRev)))
                        } else cellSet(errCell, Some("cannot import private item '" + itemName + "' from module '" + modStr + "'")),
                    None -> {
                        match translateModSegsForPkg(curPkg, curMod, path, cache, legacyLibRoots) {
                            Some(canonMod) ->
                                cellSet(modAliasesRev, Cons((itemName, canonMod), cellGet(modAliasesRev))),
                            None ->
                                cellSet(errCell, Some("item '" + itemName + "' not found in module '" + modStr + "'")),
                        }
                    },
                };
                cellSet(cur, r)
            },
            Cons((_, UseAlias(path, alias)), r) -> {
                let modSegs = listInit(path);
                let itemName = listLastOr(path, "");
                let modStr = strJoin(modSegs, ".");
                match lookupScopedItem(curPkg, curMod, modSegs, itemName, cache, legacyLibRoots, avail) {
                    Some(info) ->
                        if (info.isPublic || info.definedInMod == curMod) {
                            cellSet(mappingsRev, Cons((alias, info.qualifiedName), cellGet(mappingsRev)))
                        } else cellSet(errCell, Some("cannot import private item '" + itemName + "' from module '" + modStr + "'")),
                    None -> {
                        match translateModSegsForPkg(curPkg, curMod, path, cache, legacyLibRoots) {
                            Some(canonMod) ->
                                cellSet(modAliasesRev, Cons((alias, canonMod), cellGet(modAliasesRev))),
                            None ->
                                cellSet(errCell, Some("item '" + itemName + "' not found in module '" + modStr + "'")),
                        }
                    },
                };
                cellSet(cur, r)
            },
            Cons((_, UseMulti(basePath, specs)), r) -> {
                let baseStr = strJoin(basePath, ".");
                match translateModSegsForPkg(curPkg, curMod, basePath, cache, legacyLibRoots) {
                    None -> cellSet(errCell, Some("module '" + baseStr + "' not found or not declared in [deps]")),
                    Some(canonBase) -> {
                        let curSp = cellNew(specs);
                        while (match cellGet(curSp) { Nil -> false, _ -> match cellGet(errCell) { None -> true, Some(_) -> false } }) {
                            match cellGet(curSp) {
                                Cons(sp, sr) -> {
                                    let fullKey = joinKeyPrefix(canonBase, sp.orig);
                                    match strMapGet(avail, fullKey) {
                                        Some(info) ->
                                            if (info.isPublic || info.definedInMod == curMod) {
                                                cellSet(mappingsRev, Cons((useSpecLocalName(sp), info.qualifiedName), cellGet(mappingsRev)))
                                            } else cellSet(errCell, Some("cannot import private item '" + sp.orig + "' from module '" + baseStr + "'")),
                                        None -> cellSet(errCell, Some("item '" + sp.orig + "' not found in module '" + baseStr + "'")),
                                    };
                                    cellSet(curSp, sr)
                                },
                                Nil -> (),
                            }
                        }
                    },
                };
                cellSet(cur, r)
            },
            Cons((_, UseGlob(basePath)), r) -> {
                let baseStr = strJoin(basePath, ".");
                match translateModSegsForPkg(curPkg, curMod, basePath, cache, legacyLibRoots) {
                    None -> cellSet(errCell, Some("module '" + baseStr + "' not found or not declared in [deps]")),
                    Some(canonBase) -> {
                        let pref = if (canonBase == "") "" else canonBase + ".";
                        let i = cellNew(0);
                        while (cellGet(i) < vecLen(allExportKeys)) {
                            let k = vecGetOr(allExportKeys, cellGet(i), "");
                            if (pref == "") {
                                if (listLen(strSplitChar(k, '.')) == 1) {
                                    match strMapGet(avail, k) {
                                        Some(info) ->
                                            if (info.isPublic && info.definedInMod == "") {
                                                cellSet(mappingsRev, Cons((k, info.qualifiedName), cellGet(mappingsRev)))
                                            } else (),
                                        None -> (),
                                    }
                                } else ()
                            } else if (strStartsWith(k, pref)) {
                                let rem = strSlice(k, strLen(pref), strLen(k));
                                if (rem != "" && listLen(strSplitChar(rem, '.')) == 1) {
                                    match strMapGet(avail, k) {
                                        Some(info) ->
                                            if (info.isPublic) {
                                                cellSet(mappingsRev, Cons((rem, info.qualifiedName), cellGet(mappingsRev)))
                                            } else (),
                                        None -> (),
                                    }
                                } else ()
                            } else ();
                            cellSet(i, cellGet(i) + 1)
                        }
                    },
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };

    match cellGet(errCell) {
        Some(e) -> Err(e),
        None -> Ok((listRev(cellGet(mappingsRev)), listRev(cellGet(modAliasesRev)))),
    }
}

data ModRewriteCtx {
    MkModRewriteCtx {
        curPkg: PkgSpec,
        curPrefix: String,
        valMap: StrMap String,
        tyMap: StrMap String,
        ctorMap: StrMap String,
        modAliasMap: StrMap String,
        cache: StrMap LoadedMod,
        legacyLibRoots: StrMap Bool,
        avail: StrMap NameInfo,
        allExportKeys: Vec String,
        errors: Cell (List String),
    },
}

def rewriteTypeInMod(ctx: ModRewriteCtx, ty: Type): Type = match ty {
    TyVoid -> TyVoid,
    TyVar(_) -> ty,
    TyCon(n) -> match strMapGet(ctx.tyMap, n) {
        Some(qn) -> TyCon(qn),
        None -> ty,
    },
    TyArr(m, ps, r) -> TyArr(rewriteTypeInMod(ctx, m), rewriteTypeListInMod(ctx, ps), rewriteTypeInMod(ctx, r)),
    TyTuple(es) -> TyTuple(rewriteTypeListInMod(ctx, es)),
    TyComp(b, a) -> TyComp(rewriteTypeInMod(ctx, b), rewriteTypeInMod(ctx, a)),
}

def rewriteTypeListInMod(ctx: ModRewriteCtx, ts: List Type): List Type =
    fmap((t) -> rewriteTypeInMod(ctx, t), ts)

def rewriteConstraintsInMod(ctx: ModRewriteCtx, cs: List ConstraintSpec): List ConstraintSpec = match cs {
    Nil -> Nil,
    Cons(c, r) -> {
        let qc = match strMapGet(ctx.tyMap, c.conceptName) {
            Some(q) -> q,
            None -> c.conceptName,
        };
        Cons(MkConstraint { conceptName: qc, typeArgs: rewriteTypeListInMod(ctx, c.typeArgs) }, rewriteConstraintsInMod(ctx, r))
    },
}

def rewriteSchemeInMod(ctx: ModRewriteCtx, scm: Scheme): Scheme = match scm {
    ScmMono(t) -> ScmMono(rewriteTypeInMod(ctx, t)),
    ScmPoly(vs, t) -> ScmPoly(vs, rewriteTypeInMod(ctx, t)),
    ScmPolyConstrained(vs, cs, t) -> ScmPolyConstrained(vs, rewriteConstraintsInMod(ctx, cs), rewriteTypeInMod(ctx, t)),
    ScmSlot -> ScmSlot,
}

def rewritePatInMod(ctx: ModRewriteCtx, pat: Pattern, bound: Cell (List String)): Pattern = match pat {
    PatVar(v) -> {
        cellSet(bound, addUniqueStr(cellGet(bound), v));
        PatVar(v)
    },
    PatWild -> PatWild,
    PatLit(_) -> pat,
    PatTuple(ps) -> PatTuple(rewritePatListInMod(ctx, ps, bound)),
    PatCtor(cn, ps) -> {
        let qcn = match strMapGet(ctx.ctorMap, cn) { Some(q) -> q, None -> cn };
        PatCtor(qcn, rewritePatListInMod(ctx, ps, bound))
    },
    PatStruct(cn, fs) -> {
        let qcn = match strMapGet(ctx.ctorMap, cn) { Some(q) -> q, None -> cn };
        PatStruct(qcn, rewritePatStructFields(ctx, fs, bound))
    },
}

def rewritePatListInMod(ctx: ModRewriteCtx, ps: List Pattern, bound: Cell (List String)): List Pattern = match ps {
    Nil -> Nil,
    Cons(h, t) -> {
        let nh = rewritePatInMod(ctx, h, bound);
        Cons(nh, rewritePatListInMod(ctx, t, bound))
    },
}

def rewritePatStructFields(ctx: ModRewriteCtx, fs: List (String, Pattern), bound: Cell (List String)): List (String, Pattern) = match fs {
    Nil -> Nil,
    Cons((k, p), t) -> {
        let np = rewritePatInMod(ctx, p, bound);
        Cons((k, np), rewritePatStructFields(ctx, t, bound))
    },
}

def flattenFieldChain(f: Form): Option (String, List (Span, String)) = match f.node {
    ExVar(root) -> Some((root, Nil)),
    ExField(inner, fname) -> match flattenFieldChain(inner) {
        Some((root, segs)) -> Some((root, listAppend(segs, [(f.pos, fname)]))),
        None -> None,
    },
    _ -> None,
}

def rewriteFormListInMod(ctx: ModRewriteCtx, es: List Form, bound: List String): List Form = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(rewriteFormInMod(ctx, h, bound), rewriteFormListInMod(ctx, t, bound)),
}

def rewriteNamedFormsInMod(ctx: ModRewriteCtx, fs: List (String, Form), bound: List String): List (String, Form) = match fs {
    Nil -> Nil,
    Cons((k, v), t) -> Cons((k, rewriteFormInMod(ctx, v, bound)), rewriteNamedFormsInMod(ctx, t, bound)),
}

def resolveChainInMod(
    ctx: ModRewriteCtx,
    root: String,
    segVec: Vec (Span, String),
    k: Int,
    fallbackPos: Span
): Option NameInfo = {
    let (_, itemName) = vecGetOr(segVec, k, (fallbackPos, ""));
    match strMapGet(ctx.modAliasMap, root) {
        Some(aliasedMod) -> {
            let subModParts = cellNew(strSplitChar(aliasedMod, '.'));
            let j = cellNew(0);
            while (cellGet(j) < k) {
                let (_, sn) = vecGetOr(segVec, cellGet(j), (fallbackPos, ""));
                cellSet(subModParts, listAppend(cellGet(subModParts), [sn]));
                cellSet(j, cellGet(j) + 1)
            };
            let canonMod = strJoin(cellGet(subModParts), ".");
            if (strMapContains(ctx.cache, canonMod)) {
                strMapGet(ctx.avail, joinKeyPrefix(canonMod, itemName))
            } else None
        },
        None -> {
            let modSegs = cellNew([root]);
            let j = cellNew(0);
            while (cellGet(j) < k) {
                let (_, sn) = vecGetOr(segVec, cellGet(j), (fallbackPos, ""));
                cellSet(modSegs, listAppend(cellGet(modSegs), [sn]));
                cellSet(j, cellGet(j) + 1)
            };
            lookupScopedItem(ctx.curPkg, ctx.curPrefix, cellGet(modSegs), itemName, ctx.cache, ctx.legacyLibRoots, ctx.avail)
        },
    }
}

def resolveChainModKeyInMod(
    ctx: ModRewriteCtx,
    root: String,
    segVec: Vec (Span, String),
    modSegCount: Int,
    fallbackPos: Span
): Option String =
    match strMapGet(ctx.modAliasMap, root) {
        Some(aliasedMod) -> {
            let subParts = cellNew(strSplitChar(aliasedMod, '.'));
            let j = cellNew(0);
            while (cellGet(j) < modSegCount) {
                let (_, sn) = vecGetOr(segVec, cellGet(j), (fallbackPos, ""));
                cellSet(subParts, listAppend(cellGet(subParts), [sn]));
                cellSet(j, cellGet(j) + 1)
            };
            let cm = strJoin(cellGet(subParts), ".");
            if (strMapContains(ctx.cache, cm)) Some(cm) else None
        },
        None -> {
            let modSegs = cellNew([root]);
            let j = cellNew(0);
            while (cellGet(j) < modSegCount) {
                let (_, sn) = vecGetOr(segVec, cellGet(j), (fallbackPos, ""));
                cellSet(modSegs, listAppend(cellGet(modSegs), [sn]));
                cellSet(j, cellGet(j) + 1)
            };
            translateModSegsForPkg(ctx.curPkg, ctx.curPrefix, cellGet(modSegs), ctx.cache, ctx.legacyLibRoots)
        },
    }

def rewriteFormInMod(ctx: ModRewriteCtx, f: Form, bound: List String): Form = {
    let newAnn = match f.annot {
        Some(a) -> Some(rewriteSchemeInMod(ctx, a)),
        None -> None,
    };
    let newNode = match f.node {
        ExLit(_) -> f.node,
        ExVar(name) ->
            if (listContainsStr(bound, name)) ExVar(name)
            else match strMapGet(ctx.valMap, name) {
                Some(qn) -> ExVar(qn),
                None -> ExVar(name),
            },
        ExField(base, fname) -> {
            let resolvedChain: Option Expr = match flattenFieldChain(base) {
                Some((root, segs0)) -> {
                    let segs = listAppend(segs0, [(f.pos, fname)]);
                    let rootIsVal =
                        listContainsStr(bound, root)
                        || strMapContains(ctx.valMap, root)
                        || (ctx.curPrefix == "" && strMapContains(ctx.avail, root));
                    if (rootIsVal) {
                        None
                    } else {
                        let segVec: Vec (Span, String) = vecNew();
                        let curS = cellNew(segs);
                        while (match cellGet(curS) { Nil -> false, _ -> true }) {
                            match cellGet(curS) {
                                Cons(pair, r) -> { vecPush(segVec, pair); cellSet(curS, r) },
                                Nil -> (),
                            }
                        };
                        let totalSegs = vecLen(segVec);
                        let matchedK = cellNew(-1);
                        let matchedInfo: Cell (Option NameInfo) = cellNew(None);
                        let k = cellNew(totalSegs - 1);
                        while (cellGet(k) >= 0 && cellGet(matchedK) < 0) {
                            match resolveChainInMod(ctx, root, segVec, cellGet(k), f.pos) {
                                Some(info) -> {
                                    cellSet(matchedK, cellGet(k));
                                    cellSet(matchedInfo, Some(info))
                                },
                                None -> cellSet(k, cellGet(k) - 1),
                            }
                        };

                        match cellGet(matchedInfo) {
                            Some(info) -> {
                                let mk = cellGet(matchedK);
                                let (mkSp, mkName) = vecGetOr(segVec, mk, (f.pos, fname));
                                if (!info.isPublic && info.definedInMod != ctx.curPrefix) {
                                    cellSet(ctx.errors, listAppend(cellGet(ctx.errors), [
                                        "cannot access private item '" + mkName + "' from module '" + info.definedInMod + "'"
                                    ]))
                                } else ();
                                let rebuilt = cellNew(mkForm(mkSp, ExVar(info.qualifiedName)));
                                let remIdx = cellNew(mk + 1);
                                while (cellGet(remIdx) < totalSegs) {
                                    let (rsp, rname) = vecGetOr(segVec, cellGet(remIdx), (f.pos, ""));
                                    cellSet(rebuilt, mkForm(rsp, ExField(cellGet(rebuilt), rname)));
                                    cellSet(remIdx, cellGet(remIdx) + 1)
                                };
                                Some(cellGet(rebuilt).node)
                            },
                            None -> {
                                match resolveChainModKeyInMod(ctx, root, segVec, totalSegs - 1, f.pos) {
                                    Some(modCand) -> {
                                        cellSet(ctx.errors, listAppend(cellGet(ctx.errors), [
                                            "item '" + fname + "' not found in module '" + modCand + "'"
                                        ]));
                                        Some(ExVar(fname))
                                    },
                                    None -> None,
                                }
                            },
                        }
                    }
                },
                None -> None,
            };
            match resolvedChain {
                Some(en) -> en,
                None -> ExField(rewriteFormInMod(ctx, base, bound), fname),
            }
        },
        ExStructInit(cname, fs) -> {
            let qcn = match strMapGet(ctx.ctorMap, cname) { Some(q) -> q, None -> cname };
            ExStructInit(qcn, rewriteNamedFormsInMod(ctx, fs, bound))
        },
        ExTuple(es) -> ExTuple(rewriteFormListInMod(ctx, es, bound)),
        ExList(es) -> ExList(rewriteFormListInMod(ctx, es, bound)),
        ExBlock(es) -> ExBlock(rewriteFormListInMod(ctx, es, bound)),
        ExApply(c, args) -> ExApply(rewriteFormInMod(ctx, c, bound), rewriteFormListInMod(ctx, args, bound)),
        ExBin(op, l, r) -> ExBin(op, rewriteFormInMod(ctx, l, bound), rewriteFormInMod(ctx, r, bound)),
        ExUn(op, e) -> ExUn(op, rewriteFormInMod(ctx, e, bound)),
        ExTry(e) -> ExTry(rewriteFormInMod(ctx, e, bound)),
        ExIf(c, t, e) -> ExIf(rewriteFormInMod(ctx, c, bound), rewriteFormInMod(ctx, t, bound), rewriteFormInMod(ctx, e, bound)),
        ExWhile(c, b) -> ExWhile(rewriteFormInMod(ctx, c, bound), rewriteFormInMod(ctx, b, bound)),
        ExAbs(ps, rt, body) -> {
            let innerBound = cellNew(bound);
            let newPs = cellNew(Nil);
            let cur = cellNew(ps);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(vd, r) -> {
                        cellSet(innerBound, addUniqueStr(cellGet(innerBound), vd.vname));
                        cellSet(newPs, listAppend(cellGet(newPs), [MkVarDecl { vname: vd.vname, vscm: rewriteSchemeInMod(ctx, vd.vscm) }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let newRt = fmap((t) -> rewriteTypeInMod(ctx, t), rt);
            ExAbs(cellGet(newPs), newRt, rewriteFormInMod(ctx, body, cellGet(innerBound)))
        },
        ExLet(vd, val, body) -> {
            let nvd = MkVarDecl { vname: vd.vname, vscm: rewriteSchemeInMod(ctx, vd.vscm) };
            let valBound = match val.node {
                ExAbs(_, _, _) -> addUniqueStr(bound, vd.vname),
                _ -> bound,
            };
            let bodyBound = addUniqueStr(bound, vd.vname);
            ExLet(nvd, rewriteFormInMod(ctx, val, valBound), rewriteFormInMod(ctx, body, bodyBound))
        },
        ExMatch(scrut, arms) -> {
            let cs = rewriteFormInMod(ctx, scrut, bound);
            let newArms = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let armBound = cellNew(bound);
                        let np = rewritePatInMod(ctx, a.pat, armBound);
                        let ng = match a.guard {
                            Some(g) -> Some(rewriteFormInMod(ctx, g, cellGet(armBound))),
                            None -> None,
                        };
                        let nb = rewriteFormInMod(ctx, a.body, cellGet(armBound));
                        cellSet(newArms, listAppend(cellGet(newArms), [MkMatchArm { pat: np, guard: ng, body: nb }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            ExMatch(cs, cellGet(newArms))
        },
    };
    MkForm { pos: f.pos, ty: f.ty, annot: newAnn, node: newNode }
}

def rewriteFieldsInMod(ctx: ModRewriteCtx, fs: List FieldDecl): List FieldDecl = match fs {
    Nil -> Nil,
    Cons(f, r) -> Cons(MkFieldDecl { fname: f.fname, fty: rewriteTypeInMod(ctx, f.fty) }, rewriteFieldsInMod(ctx, r)),
}

def rewriteDefInMod(ctx: ModRewriteCtx, d: Def): Def = {
    let qIdent = match strMapGet(ctx.valMap, d.ident) {
        Some(q) -> q,
        None -> d.ident,
    };
    let newItem = match d.item {
        ItForm(f) -> ItForm(rewriteFormInMod(ctx, f, Nil)),
        ItExtern(sym, scm, noAlloc, isFnPtr) -> ItExtern(sym, rewriteSchemeInMod(ctx, scm), noAlloc, isFnPtr),
        ItAlias(ps, scm) -> ItAlias(ps, rewriteSchemeInMod(ctx, scm)),
        ItAlg(ps, vs) -> {
            let newVs = cellNew(Nil);
            let cur = cellNew(vs);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(v, r) -> {
                        let qvn = match strMapGet(ctx.ctorMap, v.vname) { Some(q) -> q, None -> v.vname };
                        let nvb = match v.vbody {
                            VarUnit -> VarUnit,
                            VarTuple(fs) -> VarTuple(rewriteFieldsInMod(ctx, fs)),
                            VarStruct(fs) -> VarStruct(rewriteFieldsInMod(ctx, fs)),
                        };
                        cellSet(newVs, listAppend(cellGet(newVs), [MkVariantDef { vname: qvn, vbody: nvb }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            ItAlg(ps, cellGet(newVs))
        },
        ItConcept(ps, supers, fundeps, ms) -> {
            let newMs = cellNew(Nil);
            let cur = cellNew(ms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(m, r) -> {
                        let qmn = match strMapGet(ctx.valMap, m.mname) { Some(q) -> q, None -> m.mname };
                        cellSet(newMs, listAppend(cellGet(newMs), [MkMethodDecl { mname: qmn, mty: rewriteSchemeInMod(ctx, m.mty) }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            ItConcept(ps, rewriteConstraintsInMod(ctx, supers), fundeps, cellGet(newMs))
        },
        ItInstance(cname, targs, cs, impls) -> {
            let qcn = match strMapGet(ctx.tyMap, cname) { Some(q) -> q, None -> cname };
            let qcnPrefix = {
                let n = strLen(qcn);
                let lastDot = cellNew(-1);
                let idx = cellNew(0);
                while (cellGet(idx) < n) {
                    let k = cellGet(idx);
                    if (strByteAt(qcn, k) == 46) cellSet(lastDot, k) else ();
                    cellSet(idx, k + 1)
                };
                if (cellGet(lastDot) > 0) strSlice(qcn, 0, cellGet(lastDot)) else ""
            };
            let newImpls = cellNew(Nil);
            let cur = cellNew(impls);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(mi, r) -> {
                        let qImplName = match strMapGet(ctx.valMap, mi.implName) {
                            Some(q) -> q,
                            None ->
                                if (strLen(qcnPrefix) > 0) qcnPrefix + "." + mi.implName
                                else mi.implName,
                        };
                        let nmi = MkMethodImpl { implName: qImplName, implBody: rewriteFormInMod(ctx, mi.implBody, Nil) };
                        cellSet(newImpls, listAppend(cellGet(newImpls), [nmi]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            ItInstance(qcn, rewriteTypeListInMod(ctx, targs), rewriteConstraintsInMod(ctx, cs), cellGet(newImpls))
        },
    };
    MkDef { ident: qIdent, dpos: d.dpos, vis: d.vis, attrs: d.attrs, item: newItem }
}

def collectTyConsExpanded(
    ty: Type,
    aliasBodies: StrMap Type,
    depth: Int,
    acc: Cell (List String)
): Void = match ty {
    TyVoid -> (),
    TyVar(_) -> (),
    TyCon(tn) -> {
        if (depth < 8) {
            match strMapGet(aliasBodies, tn) {
                Some(bodyTy) -> collectTyConsExpanded(bodyTy, aliasBodies, depth + 1, acc),
                None -> cellSet(acc, addUniqueStr(cellGet(acc), tn)),
            }
        } else cellSet(acc, addUniqueStr(cellGet(acc), tn))
    },
    TyArr(m, ps, r) -> {
        collectTyConsExpanded(m, aliasBodies, depth, acc);
        collectTyConsList(ps, aliasBodies, depth, acc);
        collectTyConsExpanded(r, aliasBodies, depth, acc)
    },
    TyTuple(es) -> collectTyConsList(es, aliasBodies, depth, acc),
    TyComp(b, a) -> {
        collectTyConsExpanded(b, aliasBodies, depth, acc);
        collectTyConsExpanded(a, aliasBodies, depth, acc)
    },
}

def collectTyConsList(
    ts: List Type,
    aliasBodies: StrMap Type,
    depth: Int,
    acc: Cell (List String)
): Void = match ts {
    Nil -> (),
    Cons(h, r) -> {
        collectTyConsExpanded(h, aliasBodies, depth, acc);
        collectTyConsList(r, aliasBodies, depth, acc)
    },
}

def checkOrphanInstance(
    pkgOwner: String,
    conceptName: String,
    typeArgs: List Type,
    conceptOwners: StrMap String,
    typeOwners: StrMap String,
    aliasBodies: StrMap Type
): Option String =
    if (pkgOwner == "" || pkgOwner == "__stdlib") None
    else {
        let ownsConcept = match strMapGet(conceptOwners, conceptName) {
            Some(co) -> co == pkgOwner,
            None -> false,
        };
        if (ownsConcept) None
        else {
            let tyCons: Cell (List String) = cellNew(Nil);
            collectTyConsList(typeArgs, aliasBodies, 0, tyCons);
            let cur = cellNew(cellGet(tyCons));
            let ownsAnyType = cellNew(false);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(ownsAnyType) }) {
                match cellGet(cur) {
                    Cons(tn, r) -> {
                        match strMapGet(typeOwners, tn) {
                            Some(to) -> if (to == pkgOwner) cellSet(ownsAnyType, true) else (),
                            None -> (),
                        };
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            if (cellGet(ownsAnyType)) None
            else Some(
                "Orphan instance in package '" + pkgOwner + "': cannot implement foreign concept '"
                + conceptName + "' for foreign types (define the instance in the package owning the concept or one of its target types)"
            )
        }
    }

def registerExport(
    avail: StrMap NameInfo,
    allExportKeys: Vec String,
    key: String,
    info: NameInfo
): Void = {
    if (!strMapContains(avail, key)) vecPush(allExportKeys, key) else ();
    strMapInsert(avail, key, info)
}

def compileLoadedCache(
    pkgMap: StrMap PkgSpec,
    cache: StrMap LoadedMod,
    orderKeys: Vec String,
    legacyLibRoots: StrMap Bool
): Result (List Def) String = {
    let fallbackRoot = match strMapGet(pkgMap, "") {
        Some(rp) -> rp,
        None -> defaultRootPkg(Nil),
    };
    let totalMods = vecLen(orderKeys);

    let depsMap: StrMap (List String) = strMapNew();
    let i1 = cellNew(0);
    while (cellGet(i1) < totalMods) {
        let mk = vecGetOr(orderKeys, cellGet(i1), "");
        let deps = cellNew(Nil);
        match strMapGet(cache, mk) {
            Some(m) -> {
                let curPkg = match strMapGet(pkgMap, m.pkgOwner) {
                    Some(p) -> p,
                    None -> fallbackRoot,
                };
                if (strMapContains(cache, "std.result") && mk != "std.result" && moduleUsesTry(m.defs)) {
                    cellSet(deps, addUniqueStr(cellGet(deps), "std.result"))
                } else ();

                let curSub = cellNew(m.submodules);
                while (match cellGet(curSub) { Nil -> false, _ -> true }) {
                    match cellGet(curSub) {
                        Cons(ck, r) -> {
                            if (ck != mk && strMapContains(cache, ck)) cellSet(deps, addUniqueStr(cellGet(deps), ck)) else ();
                            cellSet(curSub, r)
                        },
                        Nil -> (),
                    }
                };

                let cands = collectCandidateModPathsFromMod(m);
                let cc = cellNew(cands);
                while (match cellGet(cc) { Nil -> false, _ -> true }) {
                    match cellGet(cc) {
                        Cons(segs, rc) -> {
                            match translateModSegsForPkg(curPkg, mk, segs, cache, legacyLibRoots) {
                                Some(tk) -> if (tk != mk) cellSet(deps, addUniqueStr(cellGet(deps), tk)) else (),
                                None -> (),
                            };
                            cellSet(cc, rc)
                        },
                        Nil -> (),
                    }
                }
            },
            None -> (),
        };
        strMapInsert(depsMap, mk, cellGet(deps));
        cellSet(i1, cellGet(i1) + 1)
    };

    let stateMap: StrMap Int = strMapNew();
    let topoOut: Cell (List String) = cellNew(Nil);
    let allKeyListRev = cellNew(Nil);
    let i2 = cellNew(0);
    while (cellGet(i2) < totalMods) {
        cellSet(allKeyListRev, Cons(vecGetOr(orderKeys, cellGet(i2), ""), cellGet(allKeyListRev)));
        cellSet(i2, cellGet(i2) + 1)
    };
    topoVisitList(listRev(cellGet(allKeyListRev)), depsMap, stateMap, topoOut)?;
    let topoKeys = cellGet(topoOut);

    let avail: StrMap NameInfo = strMapNew();
    let allExportKeys: Vec String = vecNew();
    let modOwnVals: StrMap (List (String, String)) = strMapNew();
    let modOwnTys: StrMap (List (String, String)) = strMapNew();
    let modOwnCtors: StrMap (List (String, String)) = strMapNew();
    let conceptOwners: StrMap String = strMapNew();
    let typeOwners: StrMap String = strMapNew();
    let aliasBodies: StrMap Type = strMapNew();

    let curT = cellNew(topoKeys);
    while (match cellGet(curT) { Nil -> false, _ -> true }) {
        match cellGet(curT) {
            Cons(mk, rT) -> {
                let pref = mk;
                let ownVRev = cellNew(Nil);
                let ownTRev = cellNew(Nil);
                let ownCRev = cellNew(Nil);
                match strMapGet(cache, mk) {
                    Some(m) -> {
                        let curD = cellNew(m.defs);
                        while (match cellGet(curD) { Nil -> false, _ -> true }) {
                            match cellGet(curD) {
                                Cons((vis, d), rD) -> {
                                    let orig = d.ident;
                                    let qname = joinKeyPrefix(pref, orig);
                                    registerExport(avail, allExportKeys, qname, MkNameInfo {
                                        qualifiedName: qname,
                                        isPublic: isPublicVis(vis),
                                        definedInMod: pref,
                                    });
                                    match d.item {
                                        ItAlg(_, _) -> strMapInsert(typeOwners, qname, m.pkgOwner),
                                        ItConcept(_, _, _, _) -> strMapInsert(conceptOwners, qname, m.pkgOwner),
                                        _ -> (),
                                    };
                                    if (pref != "") {
                                        cellSet(ownVRev, Cons((orig, qname), cellGet(ownVRev)));
                                        match d.item {
                                            ItAlg(_, _) -> cellSet(ownTRev, Cons((orig, qname), cellGet(ownTRev))),
                                            ItAlias(_, _) -> cellSet(ownTRev, Cons((orig, qname), cellGet(ownTRev))),
                                            ItConcept(_, _, _, _) -> cellSet(ownTRev, Cons((orig, qname), cellGet(ownTRev))),
                                            _ -> (),
                                        }
                                    } else ();

                                    match d.item {
                                        ItAlg(_, vs) -> {
                                            let curV = cellNew(vs);
                                            while (match cellGet(curV) { Nil -> false, _ -> true }) {
                                                match cellGet(curV) {
                                                    Cons(vd, rV) -> {
                                                        let qctor = joinKeyPrefix(pref, vd.vname);
                                                        registerExport(avail, allExportKeys, qctor, MkNameInfo {
                                                            qualifiedName: qctor,
                                                            isPublic: isPublicVis(vis),
                                                            definedInMod: pref,
                                                        });
                                                        if (pref != "") {
                                                            cellSet(ownVRev, Cons((vd.vname, qctor), cellGet(ownVRev)));
                                                            cellSet(ownCRev, Cons((vd.vname, qctor), cellGet(ownCRev)))
                                                        } else ();
                                                        cellSet(curV, rV)
                                                    },
                                                    Nil -> (),
                                                }
                                            }
                                        },
                                        ItConcept(_, _, _, ms) -> {
                                            let curM = cellNew(ms);
                                            while (match cellGet(curM) { Nil -> false, _ -> true }) {
                                                match cellGet(curM) {
                                                    Cons(md, rM) -> {
                                                        let qm = joinKeyPrefix(pref, md.mname);
                                                        registerExport(avail, allExportKeys, qm, MkNameInfo {
                                                            qualifiedName: qm,
                                                            isPublic: isPublicVis(vis),
                                                            definedInMod: pref,
                                                        });
                                                        if (pref != "") {
                                                            cellSet(ownVRev, Cons((md.mname, qm), cellGet(ownVRev)))
                                                        } else ();
                                                        cellSet(curM, rM)
                                                    },
                                                    Nil -> (),
                                                }
                                            }
                                        },
                                        _ -> (),
                                    };
                                    cellSet(curD, rD)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                };
                strMapInsert(modOwnVals, mk, listRev(cellGet(ownVRev)));
                strMapInsert(modOwnTys, mk, listRev(cellGet(ownTRev)));
                strMapInsert(modOwnCtors, mk, listRev(cellGet(ownCRev)));
                cellSet(curT, rT)
            },
            Nil -> (),
        }
    };

    if (strMapContains(cache, "std.sync")) {
        registerExport(avail, allExportKeys, "std.sync.AtomicInt", MkNameInfo { qualifiedName: "AtomicInt", isPublic: true, definedInMod: "std.sync" });
        registerExport(avail, allExportKeys, "std.sync.MVar", MkNameInfo { qualifiedName: "MVar", isPublic: true, definedInMod: "std.sync" });
        registerExport(avail, allExportKeys, "std.sync.Chan", MkNameInfo { qualifiedName: "Chan", isPublic: true, definedInMod: "std.sync" })
    } else ();
    if (strMapContains(cache, "std.task")) {
        registerExport(avail, allExportKeys, "std.task.Task", MkNameInfo { qualifiedName: "Task", isPublic: true, definedInMod: "std.task" })
    } else ();
    if (strMapContains(cache, "std.actor")) {
        registerExport(avail, allExportKeys, "std.actor.Actor", MkNameInfo { qualifiedName: "Actor", isPublic: true, definedInMod: "std.actor" })
    } else ();

    let outDefsRev: Cell (List Def) = cellNew(Nil);
    let curM2 = cellNew(topoKeys);
    let errFinal: Cell (Option String) = cellNew(None);

    while (match cellGet(curM2) { Nil -> false, _ -> match cellGet(errFinal) { None -> true, Some(_) -> false } }) {
        match cellGet(curM2) {
            Cons(mk, rM2) -> {
                match strMapGet(cache, mk) {
                    Some(m) -> {
                        let pref = mk;
                        let curPkg = match strMapGet(pkgMap, m.pkgOwner) {
                            Some(p) -> p,
                            None -> fallbackRoot,
                        };
                        match resolveModuleImports(m.imports, curPkg, pref, cache, legacyLibRoots, avail, allExportKeys) {
                            Err(e) -> cellSet(errFinal, Some(e)),
                            Ok((impPairs, modAliasPairs)) -> {
                                let imapLookup: StrMap String = strMapNew();
                                let curIP = cellNew(impPairs);
                                while (match cellGet(curIP) { Nil -> false, _ -> true }) {
                                    match cellGet(curIP) {
                                        Cons((ln, qn), rIP) -> {
                                            strMapInsert(imapLookup, ln, qn);
                                            cellSet(curIP, rIP)
                                        },
                                        Nil -> (),
                                    }
                                };

                                let curPU = cellNew(m.imports);
                                while (match cellGet(curPU) { Nil -> false, _ -> true }) {
                                    match cellGet(curPU) {
                                        Cons((VisPublic, u), rPU) -> {
                                            match u {
                                                UseSingle(p) -> {
                                                    let nm = listLastOr(p, "");
                                                    match strMapGet(imapLookup, nm) {
                                                        Some(tq) -> {
                                                            let ek = joinKeyPrefix(pref, nm);
                                                            registerExport(avail, allExportKeys, ek, MkNameInfo { qualifiedName: tq, isPublic: true, definedInMod: pref })
                                                        },
                                                        None -> (),
                                                    }
                                                },
                                                UseAlias(_, al) -> match strMapGet(imapLookup, al) {
                                                    Some(tq) -> {
                                                        let ek = joinKeyPrefix(pref, al);
                                                        registerExport(avail, allExportKeys, ek, MkNameInfo { qualifiedName: tq, isPublic: true, definedInMod: pref })
                                                    },
                                                    None -> (),
                                                },
                                                UseMulti(_, sps) -> {
                                                    let curS = cellNew(sps);
                                                    while (match cellGet(curS) { Nil -> false, _ -> true }) {
                                                        match cellGet(curS) {
                                                            Cons(sp, rS) -> {
                                                                let ln = useSpecLocalName(sp);
                                                                match strMapGet(imapLookup, ln) {
                                                                    Some(tq) -> {
                                                                        let ek = joinKeyPrefix(pref, ln);
                                                                        registerExport(avail, allExportKeys, ek, MkNameInfo { qualifiedName: tq, isPublic: true, definedInMod: pref })
                                                                    },
                                                                    None -> (),
                                                                };
                                                                cellSet(curS, rS)
                                                            },
                                                            Nil -> (),
                                                        }
                                                    }
                                                },
                                                UseGlob(_) -> {
                                                    let curG = cellNew(impPairs);
                                                    while (match cellGet(curG) { Nil -> false, _ -> true }) {
                                                        match cellGet(curG) {
                                                            Cons((ln, tq), rG) -> {
                                                                let ek = joinKeyPrefix(pref, ln);
                                                                if (!strMapContains(avail, ek)) {
                                                                    registerExport(avail, allExportKeys, ek, MkNameInfo { qualifiedName: tq, isPublic: true, definedInMod: pref })
                                                                } else ();
                                                                cellSet(curG, rG)
                                                            },
                                                            Nil -> (),
                                                        }
                                                    }
                                                },
                                            };
                                            cellSet(curPU, rPU)
                                        },
                                        Cons(_, rPU) -> cellSet(curPU, rPU),
                                        Nil -> (),
                                    }
                                };

                                let valMap: StrMap String = strMapNew();
                                let tyMap: StrMap String = strMapNew();
                                let ctorMap: StrMap String = strMapNew();
                                let modAliasMap: StrMap String = strMapNew();

                                let curMA = cellNew(modAliasPairs);
                                while (match cellGet(curMA) { Nil -> false, _ -> true }) {
                                    match cellGet(curMA) {
                                        Cons((al, cm), rMA) -> {
                                            strMapInsert(modAliasMap, al, cm);
                                            cellSet(curMA, rMA)
                                        },
                                        Nil -> (),
                                    }
                                };

                                let curP = cellNew(impPairs);
                                while (match cellGet(curP) { Nil -> false, _ -> true }) {
                                    match cellGet(curP) {
                                        Cons((ln, qn), rP) -> {
                                            strMapInsert(valMap, ln, qn);
                                            if (strLen(ln) > 0 && isUpperByte(strByteAt(ln, 0))) {
                                                strMapInsert(tyMap, ln, qn);
                                                strMapInsert(ctorMap, ln, qn)
                                            } else ();
                                            cellSet(curP, rP)
                                        },
                                        Nil -> (),
                                    }
                                };

                                match strMapGet(modOwnVals, mk) {
                                    Some(ovs) -> {
                                        let c = cellNew(ovs);
                                        while (match cellGet(c) { Nil -> false, _ -> true }) {
                                            match cellGet(c) { Cons((k, v), r) -> { strMapInsert(valMap, k, v); cellSet(c, r) }, Nil -> () }
                                        }
                                    },
                                    None -> (),
                                };
                                match strMapGet(modOwnTys, mk) {
                                    Some(ots) -> {
                                        let c = cellNew(ots);
                                        while (match cellGet(c) { Nil -> false, _ -> true }) {
                                            match cellGet(c) { Cons((k, v), r) -> { strMapInsert(tyMap, k, v); cellSet(c, r) }, Nil -> () }
                                        }
                                    },
                                    None -> (),
                                };
                                match strMapGet(modOwnCtors, mk) {
                                    Some(ocs) -> {
                                        let c = cellNew(ocs);
                                        while (match cellGet(c) { Nil -> false, _ -> true }) {
                                            match cellGet(c) { Cons((k, v), r) -> { strMapInsert(ctorMap, k, v); cellSet(c, r) }, Nil -> () }
                                        }
                                    },
                                    None -> (),
                                };

                                let okCtor = match strMapGet(ctorMap, "Ok") {
                                    Some(q) -> q,
                                    None -> if (strMapContains(avail, "std.result.Ok") && !strMapContains(avail, "Ok")) "std.result.Ok" else "Ok",
                                };
                                let errCtor = match strMapGet(ctorMap, "Err") {
                                    Some(q) -> q,
                                    None -> if (strMapContains(avail, "std.result.Err") && !strMapContains(avail, "Err")) "std.result.Err" else "Err",
                                };

                                let errsCell: Cell (List String) = cellNew(Nil);
                                let rctx = MkModRewriteCtx {
                                    curPkg: curPkg,
                                    curPrefix: pref,
                                    valMap: valMap,
                                    tyMap: tyMap,
                                    ctorMap: ctorMap,
                                    modAliasMap: modAliasMap,
                                    cache: cache,
                                    legacyLibRoots: legacyLibRoots,
                                    avail: avail,
                                    allExportKeys: allExportKeys,
                                    errors: errsCell,
                                };

                                let curDefs = cellNew(m.defs);
                                while (match cellGet(curDefs) { Nil -> false, _ -> true }) {
                                    match cellGet(curDefs) {
                                        Cons((_, rawDef), rDef) -> {
                                            let desugared = desugarTryInDef(rawDef, okCtor, errCtor);
                                            let rw = rewriteDefInMod(rctx, desugared);
                                            match rw.item {
                                                ItAlias(_, ScmMono(bodyTy)) -> strMapInsert(aliasBodies, rw.ident, bodyTy),
                                                ItAlias(_, ScmPoly(_, bodyTy)) -> strMapInsert(aliasBodies, rw.ident, bodyTy),
                                                ItInstance(qcn, qtargs, _, _) -> {
                                                    match checkOrphanInstance(m.pkgOwner, qcn, qtargs, conceptOwners, typeOwners, aliasBodies) {
                                                        Some(oerr) -> cellSet(errsCell, listAppend(cellGet(errsCell), [oerr])),
                                                        None -> (),
                                                    }
                                                },
                                                _ -> (),
                                            };
                                            cellSet(outDefsRev, Cons(rw, cellGet(outDefsRev)));
                                            cellSet(curDefs, rDef)
                                        },
                                        Nil -> (),
                                    }
                                };

                                match cellGet(errsCell) {
                                    Nil -> (),
                                    es -> cellSet(errFinal, Some(strJoin(es, "\n"))),
                                }
                            },
                        }
                    },
                    None -> (),
                };
                cellSet(curM2, rM2)
            },
            Nil -> (),
        }
    };

    match cellGet(errFinal) {
        Some(e) -> Err(e),
        None -> Ok(listRev(cellGet(outDefsRev))),
    }
}

def buildPkgMap(rootPkg: PkgSpec, extPkgs: List PkgSpec): StrMap PkgSpec = {
    let mp: StrMap PkgSpec = strMapNew();
    strMapInsert(mp, "", rootPkg);
    let cur = cellNew(extPkgs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(p, r) -> {
                strMapInsert(mp, p.pkgId, p);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    mp
}

def computeRootSrcDirs(entryFile: String, srcRoot: String): List String = {
    let entryDir = pathDirname(entryFile);
    let dirs = cellNew(Nil);
    if (entryDir != "" && entryDir != ".") {
        cellSet(dirs, addUniqueStr(cellGet(dirs), entryDir))
    } else ();
    if (srcRoot != "") {
        cellSet(dirs, addUniqueStr(cellGet(dirs), srcRoot))
    } else ();
    match cellGet(dirs) {
        Nil -> ["."],
        ds -> ds,
    }
}

pub def loadSingleSourceProgramWithPkgs(
    src: String,
    rootPkg: PkgSpec,
    extPkgs: List PkgSpec,
    libPaths: List String
): Result (List Def) String =
    loadSingleSourceProgramWithPkgsNamed("<input>", src, rootPkg, extPkgs, libPaths)

pub def loadSingleSourceProgramWithPkgsNamed(
    entryName: String,
    src: String,
    rootPkg: PkgSpec,
    extPkgs: List PkgSpec,
    libPaths: List String
): Result (List Def) String = {
    let pkgMap = buildPkgMap(rootPkg, extPkgs);
    let cache: StrMap LoadedMod = strMapNew();
    let orderKeys: Vec String = vecNew();
    let legacyLibRoots: StrMap Bool = strMapNew();

    let fid = diagRegisterFile(entryName, src);
    let fm = parseFileModuleInFile(src, Nil, fid)?;
    let inlines: Cell (List LoadedMod) = cellNew(Nil);
    let (defs, imps, subs) = extractModuleItems("", Nil, fm.items, inlines);
    strMapInsert(cache, "", MkLoadedMod {
        key: "",
        pkgOwner: "",
        modPath: Nil,
        defs: defs,
        imports: imps,
        submodules: subs,
    });
    vecPush(orderKeys, "");

    let curInl = cellNew(cellGet(inlines));
    while (match cellGet(curInl) { Nil -> false, _ -> true }) {
        match cellGet(curInl) {
            Cons(im, r) -> {
                strMapInsert(cache, im.key, im);
                vecPush(orderKeys, im.key);
                cellSet(curInl, r)
            },
            Nil -> (),
        }
    };

    loadExplicitSubmodules(rootPkg, subs, pkgMap, cache, orderKeys, [""])?;
    loadAllReachableModules(pkgMap, cache, orderKeys, libPaths, legacyLibRoots)?;
    compileLoadedCache(pkgMap, cache, orderKeys, legacyLibRoots)
}

pub def loadProjectProgramWithPkgs(
    entryFile: String,
    rootPkg: PkgSpec,
    extPkgs: List PkgSpec,
    libPaths: List String
): Result (List Def) String = {
    let pkgMap = buildPkgMap(rootPkg, extPkgs);
    let cache: StrMap LoadedMod = strMapNew();
    let orderKeys: Vec String = vecNew();
    let legacyLibRoots: StrMap Bool = strMapNew();

    loadCanonicalFileModRec(rootPkg, "", entryFile, pkgMap, cache, orderKeys, Nil)?;
    loadAllReachableModules(pkgMap, cache, orderKeys, libPaths, legacyLibRoots)?;
    compileLoadedCache(pkgMap, cache, orderKeys, legacyLibRoots)
}

pub def loadSingleSourceProgramWithLibs(src: String, libPaths: List String): Result (List Def) String =
    loadSingleSourceProgramWithPkgs(src, defaultRootPkg(Nil), Nil, libPaths)

pub def loadSingleSourceProgram(src: String): Result (List Def) String =
    loadSingleSourceProgramWithLibs(src, Nil)

pub def loadProjectProgramWithLibs(entryFile: String, srcRoot: String, libPaths: List String): Result (List Def) String = {
    let rootDirs = computeRootSrcDirs(entryFile, srcRoot);
    loadProjectProgramWithPkgs(entryFile, defaultRootPkg(rootDirs), Nil, libPaths)
}

pub def loadProjectProgram(entryFile: String, srcRoot: String): Result (List Def) String =
    loadProjectProgramWithLibs(entryFile, srcRoot, Nil)
