// SMT-based Static Contract & Safety Verifier (`verify`)
//
// Translates monomorphized Core IR (with preserved contract markers) into
// SMT-LIB2 verification conditions using exact 32-bit/64-bit two's-complement
// BitVectors (`(_ BitVec 32)` / `(_ BitVec 64)`) and truncating-toward-zero
// signed division/remainder (`bvsdiv`/`bvsrem`), matching Geisha/LLVM semantics.

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend, listLen}
use std.buf.{bufNew, bufPushStr, bufPushByte, bufToString}
use std.str.{intToStr, i64ToStr, strStartsWith, strIndexOfByte, strSplitChar}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.path.{pathJoin, pathBasename}
use std.codec.{Value, VBool, VInt, VStr, VArr, VObj}
use std.json.stringify
use sys.fs.{writeFile, removeFile, mkdirAll}
use sys.proc.{command, runTimeout, ExitStatus, Exited}
use pkg.geishaHomeDir
use verified_kernels.hexNibbleVal
use ast.{
    Span, emptySpan,
    Type, TyVoid, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmMono, schemeBody,
    Lit, LitInt, LitChar, LitBool, LitUnit,
    BinOp, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpAnd, OpOr,
    OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, OpUshr,
    OpEq, OpNe, OpLt, OpLe, OpGt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct
}
use infer.{AdtInfo, VariantInfo, applyExplicitSubst}
use core.{
    TaggedTerm, MkTerm, Term, CoreArm,
    TmLit, TmVar, TmGlobalVar, TmTuple, TmBlock, TmMakeCls, TmApplyCls, TmApplyDir,
    TmBin, TmUn, TmLet, TmIf, TmWhile, TmMatch, TmMakeData, TmGetTag,
    FunDef, ExternDef, CoreProgram
}
use diag.{
    diagGetFile, diagSpanLineCol, formatSpanDiag, formatSpanDiagHint
}

extern "gs_sys_getpid" def c_verify_getpid(): Int

// ============================================================================
// Verification Data Structures
// ============================================================================

data EnsClause {
    MkEnsClause {
        ecBind: Option String,
        ecSpan: Span,
        ecExpr: TaggedTerm,
    },
}

data FnSpec {
    MkFnSpec {
        fsName: String,
        fsSpan: Span,
        fsParams: List VarDecl,
        fsRetTy: Type,
        fsRequires: List (Span, TaggedTerm),
        fsDecreases: Option (Span, TaggedTerm),
        fsEnsures: List EnsClause,
        fsBody: TaggedTerm,
    },
}

data ObResult {
    MkObResult {
        obFn: String,
        obKind: String,
        obStatus: String,
        obSpan: Span,
        obMsg: String,
        obHint: Option String,
        obModel: List (String, String),
    },
}

data SymState {
    MkSymState {
        stDecls: List String,
        // Source variable name -> SMT symbol (for scalars/ADTs) OR unique locId (for Cell/Array)
        stVars: List (String, String),
        // locId -> current SMT value of Cell
        stCells: List (String, String),
        // locId -> SMT sort of Cell or Array element
        stLocSorts: List (String, String),
        // locId -> SMT BitVec32 length of Array
        stArrLens: List (String, String),
        // locId -> SMT (Array (_ BitVec 32) ElemSort) memory of Array
        stArrMems: List (String, String),
        // ADT/Tuple symbol -> tag SMT BitVec32
        stDataTags: List (String, String),
        // ADT/Tuple symbol -> field SMT values
        stDataFields: List (String, List (Option String)),
        // Path conditions (conjunction)
        stPath: List String,
        // (displayName, smtSymbol) for counterexample decoding
        stUserVars: List (String, String),
    },
}

data VerifyCtx {
    MkVerifyCtx {
        vcSpecs: StrMap FnSpec,
        vcExterns: StrMap ExternDef,
        vcCtorTags: StrMap Int,
        vcCtorAdt: StrMap String,
        vcCtorFieldTypes: StrMap (List Type),
        vcAdtVariantCount: StrMap Int,
        vcAdtTypeParams: StrMap (List String),
        vcAdtReg: StrMap AdtInfo,
        vcCallGraph: StrMap (List String),
        vcAmbientMutFns: StrMap Bool,
        vcCurFn: String,
        vcCurDecExpr: Option TaggedTerm,
        vcCurDecVal: Option String,
        vcSolver: String,
        vcTimeoutMs: Int,
        vcCheckImplicit: Bool,
        vcNextSym: Cell Int,
        vcResultsRev: Cell (List ObResult),
        vcSolverErr: Cell (Option String),
    },
}

// ============================================================================
// Persistent Association List & BitVec Helpers
// ============================================================================

def assocGet(xs: List (String, String), key: String): Option String = match xs {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else assocGet(r, key),
}

def assocGetFields(xs: List (String, List (Option String)), key: String): Option (List (Option String)) = match xs {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else assocGetFields(r, key),
}

def assocSet(xs: List (String, String), key: String, val: String): List (String, String) =
    Cons((key, val), xs)

def assocRemove(xs: List (String, String), key: String): List (String, String) = match xs {
    Nil -> Nil,
    Cons((k, v), r) ->
        if (k == key) assocRemove(r, key)
        else Cons((k, v), assocRemove(r, key)),
}

def listHasStr(xs: List String, s: String): Bool = match xs {
    Nil -> false,
    Cons(h, r) -> if (h == s) true else listHasStr(r, s),
}

def addUnique(xs: List String, s: String): List String =
    if (listHasStr(xs, s)) xs else Cons(s, xs)

def assocKeysUnique(xs: List (String, String)): List String = {
    let acc = cellNew(Nil);
    let cur = cellNew(xs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((k, _), r) -> { cellSet(acc, addUnique(cellGet(acc), k)); cellSet(cur, r) },
            Nil -> (),
        }
    };
    cellGet(acc)
}

def sanitizeSmtIdent(s: String): String = {
    let b = bufNew();
    let n = strLen(s);
    if (n == 0) "v"
    else {
        bufPushStr(b, "v_");
        let i = cellNew(0);
        while (cellGet(i) < n) {
            let ch = strByteAt(s, cellGet(i));
            let ok = (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95;
            if (ok) bufPushByte(b, ch) else bufPushByte(b, 95);
            cellSet(i, cellGet(i) + 1)
        };
        bufToString(b)
    }
}

def freshSym(ctx: VerifyCtx, base: String): String = {
    let id = cellGet(ctx.vcNextSym);
    cellSet(ctx.vcNextSym, id + 1);
    sanitizeSmtIdent(base) + "_" + intToStr(id)
}

def freshLoc(ctx: VerifyCtx, base: String): String = {
    let id = cellGet(ctx.vcNextSym);
    cellSet(ctx.vcNextSym, id + 1);
    "__hloc_" + sanitizeSmtIdent(base) + "_" + intToStr(id)
}

def bvLitForBits(n: Int, bits: Int): String =
    if (bits == 64) {
        if (n == -2147483648) "(bvneg (_ bv2147483648 64))"
        else if (n < 0) "(bvneg (_ bv" + intToStr(0 - n) + " 64))"
        else "(_ bv" + intToStr(n) + " 64)"
    } else {
        if (n == -2147483648) "#x80000000"
        else if (n < 0) "(bvneg (_ bv" + intToStr(0 - n) + " 32))"
        else "(_ bv" + intToStr(n) + " 32)"
    }

def bvZero(bits: Int): String =
    if (bits == 64) "#x0000000000000000" else "#x00000000"

def typeBitWidth(ty: Type): Int = match ty {
    TyCon("Int64") -> 64,
    _ -> 32,
}

def typeToSmtSort(ty: Type): Option String = match ty {
    TyCon("Int") -> Some("(_ BitVec 32)"),
    TyCon("Int64") -> Some("(_ BitVec 64)"),
    TyCon("Bool") -> Some("Bool"),
    TyCon("Char") -> Some("(_ BitVec 32)"),
    TyVoid -> Some("(_ BitVec 32)"),
    _ -> None,
}

def isArrayType(ty: Type): Bool = match ty {
    TyComp(TyCon("MutArray"), _) -> true,
    TyComp(TyCon("ImmArray"), _) -> true,
    _ -> false,
}

def isMutArrayType(ty: Type): Bool = match ty {
    TyComp(TyCon("MutArray"), _) -> true,
    _ -> false,
}

def isCellType(ty: Type): Bool = match ty {
    TyComp(TyCon("Cell"), _) -> true,
    _ -> false,
}

def elemTypeOf(ty: Type): Type = match ty {
    TyComp(_, elemTy) -> elemTy,
    _ -> TyCon("Int"),
}

def elemSortOf(ty: Type): String = match ty {
    TyComp(_, elemTy) -> match typeToSmtSort(elemTy) {
        Some(s) -> s,
        None -> "(_ BitVec 32)",
    },
    _ -> "(_ BitVec 32)",
}

def elemSortForContainer(ctx: VerifyCtx, ty: Type): String = {
    let eTy = elemTypeOf(ty);
    if (!isPureSmtIteType(ctx, eTy)) "__nonscalar"
    else match typeToSmtSort(eTy) {
        Some(s) -> s,
        None -> "(_ BitVec 32)",
    }
}

def zeroValForElemTy(ctx: VerifyCtx, ty: Type): Option String = {
    let eTy = elemTypeOf(ty);
    if (!isPureSmtIteType(ctx, eTy)) None
    else match eTy {
        TyCon("Bool") -> Some("false"),
        TyCon("Int64") -> Some("#x0000000000000000"),
        _ -> Some("#x00000000"),
    }
}

def stRestoreVars(st: SymState, savedVars: List (String, String)): SymState = MkSymState {
    stDecls: st.stDecls,
    stVars: savedVars,
    stCells: st.stCells,
    stLocSorts: st.stLocSorts,
    stArrLens: st.stArrLens,
    stArrMems: st.stArrMems,
    stDataTags: st.stDataTags,
    stDataFields: st.stDataFields,
    stPath: st.stPath,
    stUserVars: st.stUserVars,
}

def stWithPath(st: SymState, cond: String): SymState = MkSymState {
    stDecls: st.stDecls,
    stVars: st.stVars,
    stCells: st.stCells,
    stLocSorts: st.stLocSorts,
    stArrLens: st.stArrLens,
    stArrMems: st.stArrMems,
    stDataTags: st.stDataTags,
    stDataFields: st.stDataFields,
    stPath: Cons(cond, st.stPath),
    stUserVars: st.stUserVars,
}

def havocLocs(ctx: VerifyCtx, st: SymState, cellLocs: List String, arrLocs: List String, tag: String): SymState = {
    let dAcc = cellNew(st.stDecls);
    let cAcc = cellNew(st.stCells);
    let mAcc = cellNew(st.stArrMems);
    let uAcc = cellNew(st.stUserVars);

    let cc = cellNew(cellLocs);
    while (match cellGet(cc) { Nil -> false, _ -> true }) {
        match cellGet(cc) {
            Cons(loc, r) -> {
                let srt = match assocGet(st.stLocSorts, loc) { Some(s) -> s, None -> "(_ BitVec 32)" };
                if (srt == "__nonscalar") {
                    cellSet(cAcc, assocSet(cellGet(cAcc), loc, "__unknown_nonscalar"))
                } else {
                    let sym = freshSym(ctx, loc + "_" + tag);
                    cellSet(dAcc, Cons("(declare-const " + sym + " " + srt + ")", cellGet(dAcc)));
                    cellSet(cAcc, assocSet(cellGet(cAcc), loc, sym));
                    cellSet(uAcc, assocSet(cellGet(uAcc), loc, sym))
                };
                cellSet(cc, r)
            },
            Nil -> (),
        }
    };

    let ca = cellNew(arrLocs);
    while (match cellGet(ca) { Nil -> false, _ -> true }) {
        match cellGet(ca) {
            Cons(loc, r) -> {
                let eSrt = match assocGet(st.stLocSorts, loc) { Some(s) -> s, None -> "(_ BitVec 32)" };
                if (eSrt == "__nonscalar") {
                    cellSet(mAcc, assocSet(cellGet(mAcc), loc, "__nonscalar_arr"))
                } else {
                    let sym = freshSym(ctx, loc + "_mem_" + tag);
                    cellSet(dAcc, Cons("(declare-const " + sym + " (Array (_ BitVec 32) " + eSrt + "))", cellGet(dAcc)));
                    cellSet(mAcc, assocSet(cellGet(mAcc), loc, sym))
                };
                cellSet(ca, r)
            },
            Nil -> (),
        }
    };

    MkSymState {
        stDecls: cellGet(dAcc),
        stVars: st.stVars,
        stCells: cellGet(cAcc),
        stLocSorts: st.stLocSorts,
        stArrLens: st.stArrLens,
        stArrMems: cellGet(mAcc),
        stDataTags: st.stDataTags,
        stDataFields: st.stDataFields,
        stPath: st.stPath,
        stUserVars: cellGet(uAcc),
    }
}

// ============================================================================
// Extracting Structured Function Contracts & Call Graph from Core IR
// ============================================================================

def extractEnsuresFromBlock(stmts: List TaggedTerm): List EnsClause = {
    let outRev: Cell (List EnsClause) = cellNew(Nil);
    let cur = cellNew(stmts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(st, r) -> {
                match st.tnode {
                    TmApplyDir(vd, args) if (vd.vname == "__gs_ensures") -> match args {
                        Cons(e, _) -> cellSet(outRev, Cons(MkEnsClause { ecBind: None, ecSpan: st.tspan, ecExpr: e }, cellGet(outRev))),
                        Nil -> (),
                    },
                    TmLet(vd, valT, bodyT) -> match valT.tnode {
                        TmVar("__gs_res") -> match bodyT.tnode {
                            TmApplyDir(evd, args) if (evd.vname == "__gs_ensures") -> match args {
                                Cons(e, _) -> cellSet(outRev, Cons(MkEnsClause { ecBind: Some(vd.vname), ecSpan: st.tspan, ecExpr: e }, cellGet(outRev))),
                                Nil -> (),
                            },
                            _ -> (),
                        },
                        _ -> (),
                    },
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(outRev))
}

def extractFnSpec(fd: FunDef): FnSpec = {
    let reqsRev: Cell (List (Span, TaggedTerm)) = cellNew(Nil);
    let decOpt: Cell (Option (Span, TaggedTerm)) = cellNew(None);
    let ensList: Cell (List EnsClause) = cellNew(Nil);
    let coreBody: Cell TaggedTerm = cellNew(fd.fnBody);

    match fd.fnBody.tnode {
        TmBlock(stmts) -> {
            let restRev: Cell (List TaggedTerm) = cellNew(Nil);
            let cur = cellNew(stmts);
            let inHeader = cellNew(true);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(st, r) -> {
                        let handled =
                            if (cellGet(inHeader)) {
                                match st.tnode {
                                    TmApplyDir(vd, args) if (vd.vname == "__gs_requires") -> {
                                        match args {
                                            Cons(e, _) -> cellSet(reqsRev, Cons((st.tspan, e), cellGet(reqsRev))),
                                            Nil -> (),
                                        };
                                        true
                                    },
                                    TmApplyDir(vd, args) if (vd.vname == "__gs_decreases") -> {
                                        match args {
                                            Cons(e, _) -> cellSet(decOpt, Some((st.tspan, e))),
                                            Nil -> (),
                                        };
                                        true
                                    },
                                    _ -> { cellSet(inHeader, false); false },
                                }
                            } else false;
                        if (!handled) cellSet(restRev, Cons(st, cellGet(restRev))) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let rest = listRev(cellGet(restRev));
            match rest {
                Cons(single, Nil) -> match single.tnode {
                    TmLet(vd, valT, bodyT) if (vd.vname == "__gs_res") -> match bodyT.tnode {
                        TmBlock(ensStmts) -> {
                            let es = extractEnsuresFromBlock(ensStmts);
                            match es {
                                Cons(_, _) -> {
                                    cellSet(ensList, es);
                                    cellSet(coreBody, valT)
                                },
                                Nil -> cellSet(coreBody, single),
                            }
                        },
                        _ -> cellSet(coreBody, single),
                    },
                    _ -> cellSet(coreBody, single),
                },
                _ -> cellSet(coreBody, MkTerm { tspan: fd.fnBody.tspan, tscm: fd.fnBody.tscm, tnode: TmBlock(rest) }),
            }
        },
        _ -> (),
    };

    let retTy = match schemeBody(fd.fnScm) {
        TyArr(_, _, rt) -> rt,
        other -> other,
    };

    MkFnSpec {
        fsName: fd.fnName,
        fsSpan: fd.fnSpan,
        fsParams: fd.fnParams,
        fsRetTy: retTy,
        fsRequires: listRev(cellGet(reqsRev)),
        fsDecreases: cellGet(decOpt),
        fsEnsures: cellGet(ensList),
        fsBody: cellGet(coreBody),
    }
}

def collectDirectCallees(t: TaggedTerm, acc: List String): List String = match t.tnode {
    TmApplyDir(vd, args) -> collectDirectCalleesList(args, addUnique(acc, vd.vname)),
    TmApplyCls(c, args) -> collectDirectCalleesList(args, collectDirectCallees(c, acc)),
    TmMakeCls(_, _, b) -> collectDirectCallees(b, acc),
    TmTuple(es) -> collectDirectCalleesList(es, acc),
    TmBlock(es) -> collectDirectCalleesList(es, acc),
    TmBin(_, l, r) -> collectDirectCallees(r, collectDirectCallees(l, acc)),
    TmUn(_, e) -> collectDirectCallees(e, acc),
    TmLet(_, v, b) -> collectDirectCallees(b, collectDirectCallees(v, acc)),
    TmIf(c, th, el) -> collectDirectCallees(el, collectDirectCallees(th, collectDirectCallees(c, acc))),
    TmWhile(c, b) -> collectDirectCallees(b, collectDirectCallees(c, acc)),
    TmMatch(s, arms) -> {
        let res = cellNew(collectDirectCallees(s, acc));
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> cellSet(res, collectDirectCallees(g, cellGet(res))), None -> () };
                    cellSet(res, collectDirectCallees(a.caBody, cellGet(res)));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(res)
    },
    TmMakeData(_, _, fs, _, _) -> collectDirectCalleesList(fs, acc),
    TmGetTag(e) -> collectDirectCallees(e, acc),
    _ -> acc,
}

def collectDirectCalleesList(ts: List TaggedTerm, acc: List String): List String = match ts {
    Nil -> acc,
    Cons(h, r) -> collectDirectCalleesList(r, collectDirectCallees(h, acc)),
}

def canReachFn(graph: StrMap (List String), start: String, target: String): Bool = {
    let visited: StrMap Bool = strMapNew();
    let stack: Cell (List String) = cellNew([start]);
    let found = cellNew(false);
    while (!cellGet(found) && match cellGet(stack) { Nil -> false, _ -> true }) {
        match cellGet(stack) {
            Cons(cur, rest) -> {
                cellSet(stack, rest);
                if (cur == target) {
                    cellSet(found, true)
                } else if (!strMapContains(visited, cur)) {
                    strMapInsert(visited, cur, true);
                    match strMapGet(graph, cur) {
                        Some(nexts) -> {
                            let cn = cellNew(nexts);
                            while (match cellGet(cn) { Nil -> false, _ -> true }) {
                                match cellGet(cn) {
                                    Cons(nx, rn) -> {
                                        if (!strMapContains(visited, nx)) cellSet(stack, Cons(nx, cellGet(stack))) else ();
                                        cellSet(cn, rn)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    }
                } else ()
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

// ============================================================================
// Scanning Modified Cells, Arrays, and Impure Calls in Loops / Branches
// ============================================================================

def bindPatEffectVars(pat: Pattern, stVars: List (String, String)): List (String, String) = match pat {
    PatVar(vn, _) -> assocSet(stVars, vn, "__may_alias"),
    PatCtor(_, subPats) -> bindPatEffectVarsList(subPats, stVars),
    PatStruct(_, namedPats) -> {
        let cur = cellNew(namedPats);
        let acc = cellNew(stVars);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, p, _, _), r) -> { cellSet(acc, bindPatEffectVars(p, cellGet(acc))); cellSet(cur, r) },
                Nil -> (),
            }
        };
        cellGet(acc)
    },
    PatTuple(subPats) -> bindPatEffectVarsList(subPats, stVars),
    _ -> stVars,
}

def bindPatEffectVarsList(pats: List Pattern, stVars: List (String, String)): List (String, String) = match pats {
    Nil -> stVars,
    Cons(p, r) -> bindPatEffectVarsList(r, bindPatEffectVars(p, stVars)),
}

def isShadowedByDecl(specs: StrMap FnSpec, externs: StrMap ExternDef, nm: String): Bool =
    !strStartsWith(nm, "__gs_") && (strMapContains(externs, nm) || strMapContains(specs, nm))

def isKnownLocalOnlyIntrinsic(specs: StrMap FnSpec, externs: StrMap ExternDef, nm: String): Bool =
    if (isShadowedByDecl(specs, externs, nm)) false
    else
        // Core mutable/pure container & string & verification intrinsics
        nm == "cellNew" || nm == "cellGet" || nm == "cellSet"
        || nm == "arrayNew" || nm == "arrayNewZeroed"
        || nm == "arrayLen" || nm == "immArrayLen"
        || nm == "arrayGet" || nm == "immArrayGet"
        || nm == "arraySet" || nm == "arrayClearSlot" || nm == "arrayFreeze"
        || nm == "strLen" || nm == "strByteAt" || nm == "strSlice" || nm == "strConcat"
        || nm == "__blackBox" || nm == "assert" || nm == "assume"
        || nm == "__gs_requires" || nm == "__gs_ensures" || nm == "__gs_invariant" || nm == "__gs_decreases"
        // Exact bitwise intrinsics (matching codegen.gsa:tryEmitIntrinsic)
        || nm == "bitAnd" || nm == "bitAnd64" || nm == "bitOr" || nm == "bitOr64"
        || nm == "bitXor" || nm == "bitXor64" || nm == "bitNot" || nm == "bitNot64"
        || nm == "bitShl" || nm == "bitShr" || nm == "bitUshr"
        || nm == "bitShl64" || nm == "bitShr64" || nm == "bitUshr64"
        || nm == "bitPopCount" || nm == "bitPopCount64"
        || nm == "bitCtz" || nm == "bitCtz64" || nm == "bitClz" || nm == "bitClz64"
        // Exact scalar conversion intrinsics (matching codegen.gsa:tryEmitIntrinsic)
        || nm == "charToInt" || nm == "intToChar" || nm == "intToI64" || nm == "i64ToInt"
        || nm == "floatToBits64" || nm == "bits64ToFloat" || nm == "floatToBits32" || nm == "bits32ToFloat"
        || nm == "intToFloat" || nm == "floatToInt" || nm == "floatToF32" || nm == "f32ToFloat"
        || nm == "intToF32" || nm == "f32ToInt" || nm == "f32ToBits32" || nm == "bits32ToF32"
        // Exact math intrinsics (matching codegen.gsa:tryEmitIntrinsic)
        || nm == "mathExp" || nm == "mathLog" || nm == "mathSqrt" || nm == "mathSin"
        || nm == "mathCos" || nm == "mathTanh" || nm == "mathPow" || nm == "mathAbs"
        || nm == "mathFloor" || nm == "mathCeil" || nm == "mathFma"
        || nm == "mathExpF32" || nm == "mathLogF32" || nm == "mathSqrtF32" || nm == "mathSinF32"
        || nm == "mathCosF32" || nm == "mathTanhF32" || nm == "mathPowF32" || nm == "mathAbsF32"
        || nm == "mathFloorF32" || nm == "mathCeilF32" || nm == "mathFmaF32"

def termListHasDirectAmbientEffect(ts: List TaggedTerm, specs: StrMap FnSpec, externs: StrMap ExternDef): Bool = match ts {
    Nil -> false,
    Cons(t, r) -> if (termHasDirectAmbientEffect(t, specs, externs)) true else termListHasDirectAmbientEffect(r, specs, externs),
}

def armListHasDirectAmbientEffect(arms: List CoreArm, specs: StrMap FnSpec, externs: StrMap ExternDef): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let gHas = match a.caGuard { Some(g) -> termHasDirectAmbientEffect(g, specs, externs), None -> false };
        if (gHas || termHasDirectAmbientEffect(a.caBody, specs, externs)) true else armListHasDirectAmbientEffect(r, specs, externs)
    },
}

def termHasDirectAmbientEffect(t: TaggedTerm, specs: StrMap FnSpec, externs: StrMap ExternDef): Bool = match t.tnode {
    TmGlobalVar(_) -> true,
    TmApplyCls(_, _) -> true,
    TmApplyDir(vd, args) -> {
        let nm = vd.vname;
        if (strMapContains(externs, nm) || (!strMapContains(specs, nm) && !isKnownLocalOnlyIntrinsic(specs, externs, nm))) true
        else termListHasDirectAmbientEffect(args, specs, externs)
    },
    TmMakeCls(_, _, b) -> termHasDirectAmbientEffect(b, specs, externs),
    TmTuple(es) -> termListHasDirectAmbientEffect(es, specs, externs),
    TmBlock(es) -> termListHasDirectAmbientEffect(es, specs, externs),
    TmMakeData(_, _, fs, _, _) -> termListHasDirectAmbientEffect(fs, specs, externs),
    TmBin(_, l, r) -> termHasDirectAmbientEffect(l, specs, externs) || termHasDirectAmbientEffect(r, specs, externs),
    TmUn(_, e) -> termHasDirectAmbientEffect(e, specs, externs),
    TmLet(_, v, b) -> termHasDirectAmbientEffect(v, specs, externs) || termHasDirectAmbientEffect(b, specs, externs),
    TmIf(c, th, el) -> termHasDirectAmbientEffect(c, specs, externs) || termHasDirectAmbientEffect(th, specs, externs) || termHasDirectAmbientEffect(el, specs, externs),
    TmWhile(c, b) -> termHasDirectAmbientEffect(c, specs, externs) || termHasDirectAmbientEffect(b, specs, externs),
    TmMatch(s, arms) -> termHasDirectAmbientEffect(s, specs, externs) || armListHasDirectAmbientEffect(arms, specs, externs),
    TmGetTag(e) -> termHasDirectAmbientEffect(e, specs, externs),
    _ -> false,
}

def computeAmbientHeapEffectFns(
    prog: CoreProgram,
    specs: StrMap FnSpec,
    callGraph: StrMap (List String)
): StrMap Bool = {
    let ambient: StrMap Bool = strMapNew();
    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(nm, r) -> {
                match strMapGet(prog.coreFns, nm) {
                    Some(fd) -> {
                        let hasFvs = match fd.fnFvs { Nil -> false, _ -> true };
                        if (hasFvs || termHasDirectAmbientEffect(fd.fnBody, specs, prog.coreExterns)) {
                            strMapInsert(ambient, nm, true)
                        } else ()
                    },
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };
    let changed = cellNew(true);
    while (cellGet(changed)) {
        cellSet(changed, false);
        let cf2 = cellNew(prog.coreFnNames);
        while (match cellGet(cf2) { Nil -> false, _ -> true }) {
            match cellGet(cf2) {
                Cons(nm, r) -> {
                    if (!strMapContains(ambient, nm)) {
                        let callees = match strMapGet(callGraph, nm) { Some(xs) -> xs, None -> Nil };
                        let cc = cellNew(callees);
                        let hit = cellNew(false);
                        while (!cellGet(hit) && match cellGet(cc) { Nil -> false, _ -> true }) {
                            match cellGet(cc) {
                                Cons(calleeNm, rc) -> {
                                    if (strMapContains(ambient, calleeNm)) cellSet(hit, true) else ();
                                    cellSet(cc, rc)
                                },
                                Nil -> (),
                            }
                        };
                        if (cellGet(hit)) {
                            strMapInsert(ambient, nm, true);
                            cellSet(changed, true)
                        } else ()
                    } else ();
                    cellSet(cf2, r)
                },
                Nil -> (),
            }
        }
    };
    ambient
}

def scanEffectsInTerm(
    ctx: VerifyCtx,
    t: TaggedTerm,
    stVars: List (String, String),
    modCells: Cell (List String),
    modArrs: Cell (List String),
    hasOpaqueCall: Cell Bool
): Void = match t.tnode {
    TmGlobalVar(_) -> cellSet(hasOpaqueCall, true),
    TmApplyDir(vd, args) -> {
        let nm = vd.vname;
        let shadowed = isShadowedByDecl(ctx.vcSpecs, ctx.vcExterns, nm);
        if (strMapContains(ctx.vcExterns, nm)) {
            cellSet(hasOpaqueCall, true)
        } else if (!shadowed && nm == "cellSet") {
            match args {
                Cons(cArg, _) -> match cArg.tnode {
                    TmVar(cn) -> match assocGet(stVars, cn) {
                        Some("__may_alias") -> cellSet(hasOpaqueCall, true),
                        Some(loc) -> cellSet(modCells, addUnique(cellGet(modCells), loc)),
                        None -> cellSet(hasOpaqueCall, true),
                    },
                    _ -> cellSet(hasOpaqueCall, true),
                },
                Nil -> (),
            }
        } else if (!shadowed && nm == "arraySet") {
            match args {
                Cons(aArg, _) -> match aArg.tnode {
                    TmVar(an) -> match assocGet(stVars, an) {
                        Some("__may_alias") -> cellSet(hasOpaqueCall, true),
                        Some(loc) -> cellSet(modArrs, addUnique(cellGet(modArrs), loc)),
                        None -> cellSet(hasOpaqueCall, true),
                    },
                    _ -> cellSet(hasOpaqueCall, true),
                },
                Nil -> (),
            }
        } else if (strMapContains(ctx.vcAmbientMutFns, nm) || (!strMapContains(ctx.vcSpecs, nm) && !isKnownLocalOnlyIntrinsic(ctx.vcSpecs, ctx.vcExterns, nm))) {
            cellSet(hasOpaqueCall, true)
        } else if (shadowed || (nm != "cellGet" && nm != "cellNew" && nm != "arrayLen" && nm != "immArrayLen"
            && nm != "arrayGet" && nm != "immArrayGet" && nm != "arrayNew" && nm != "arrayNewZeroed"
            && nm != "assert" && nm != "assume"
            && nm != "__gs_requires" && nm != "__gs_ensures" && nm != "__gs_invariant" && nm != "__gs_decreases")) {
            // Any user/extern call inside a loop may mutate Cell/MutArray (directly or wrapped in Tuple/ADT)
            let ca = cellNew(args);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(a, ra) -> {
                        let aty = schemeBody(a.tscm);
                        let isPureScalar = match aty {
                            TyCon("Int") -> true,
                            TyCon("Int64") -> true,
                            TyCon("Bool") -> true,
                            TyCon("Char") -> true,
                            TyCon("Float") -> true,
                            TyCon("Float32") -> true,
                            TyCon("String") -> true,
                            TyCon("Void") -> true,
                            _ -> false,
                        };
                        if (!isPureScalar) cellSet(hasOpaqueCall, true) else ();
                        cellSet(ca, ra)
                    },
                    Nil -> (),
                }
            }
        } else ();
        scanEffectsInList(ctx, args, stVars, modCells, modArrs, hasOpaqueCall)
    },
    TmApplyCls(c, args) -> {
        cellSet(hasOpaqueCall, true);
        scanEffectsInTerm(ctx, c, stVars, modCells, modArrs, hasOpaqueCall);
        scanEffectsInList(ctx, args, stVars, modCells, modArrs, hasOpaqueCall)
    },
    TmMakeCls(_, _, b) -> scanEffectsInTerm(ctx, b, stVars, modCells, modArrs, hasOpaqueCall),
    TmTuple(es) -> scanEffectsInList(ctx, es, stVars, modCells, modArrs, hasOpaqueCall),
    TmBlock(es) -> scanEffectsInList(ctx, es, stVars, modCells, modArrs, hasOpaqueCall),
    TmBin(_, l, r) -> {
        scanEffectsInTerm(ctx, l, stVars, modCells, modArrs, hasOpaqueCall);
        scanEffectsInTerm(ctx, r, stVars, modCells, modArrs, hasOpaqueCall)
    },
    TmUn(_, e) -> scanEffectsInTerm(ctx, e, stVars, modCells, modArrs, hasOpaqueCall),
    TmLet(vd, v, b) -> {
        scanEffectsInTerm(ctx, v, stVars, modCells, modArrs, hasOpaqueCall);
        // S4 & R3: Propagate direct `TmVar` alias; only fresh `cellNew`/`arrayNew`/`arrayNewZeroed`
        // allocations are disjoint (`__fresh_`); any other expression (e.g. `if (b) c1 else c2`)
        // may alias an outer mutable location and is bound to `__may_alias`.
        let innerVars = match v.tnode {
            TmVar(srcName) -> match assocGet(stVars, srcName) {
                Some(loc) -> assocSet(stVars, vd.vname, loc),
                None -> assocSet(stVars, vd.vname, "__may_alias"),
            },
            TmApplyDir(avd, _) if (avd.vname == "cellNew" || avd.vname == "arrayNew" || avd.vname == "arrayNewZeroed") ->
                assocSet(stVars, vd.vname, "__fresh_" + vd.vname),
            _ -> assocSet(stVars, vd.vname, "__may_alias"),
        };
        scanEffectsInTerm(ctx, b, innerVars, modCells, modArrs, hasOpaqueCall)
    },
    TmIf(c, th, el) -> {
        scanEffectsInTerm(ctx, c, stVars, modCells, modArrs, hasOpaqueCall);
        scanEffectsInTerm(ctx, th, stVars, modCells, modArrs, hasOpaqueCall);
        scanEffectsInTerm(ctx, el, stVars, modCells, modArrs, hasOpaqueCall)
    },
    TmWhile(c, b) -> {
        scanEffectsInTerm(ctx, c, stVars, modCells, modArrs, hasOpaqueCall);
        scanEffectsInTerm(ctx, b, stVars, modCells, modArrs, hasOpaqueCall)
    },
    TmMatch(s, arms) -> {
        scanEffectsInTerm(ctx, s, stVars, modCells, modArrs, hasOpaqueCall);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let armVars = bindPatEffectVars(a.caPat, stVars);
                    match a.caGuard { Some(g) -> scanEffectsInTerm(ctx, g, armVars, modCells, modArrs, hasOpaqueCall), None -> () };
                    scanEffectsInTerm(ctx, a.caBody, armVars, modCells, modArrs, hasOpaqueCall);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, fs, _, _) -> scanEffectsInList(ctx, fs, stVars, modCells, modArrs, hasOpaqueCall),
    TmGetTag(e) -> scanEffectsInTerm(ctx, e, stVars, modCells, modArrs, hasOpaqueCall),
    _ -> (),
}

def scanEffectsInList(
    ctx: VerifyCtx,
    ts: List TaggedTerm,
    stVars: List (String, String),
    modCells: Cell (List String),
    modArrs: Cell (List String),
    hasOpaqueCall: Cell Bool
): Void = match ts {
    Nil -> (),
    Cons(h, r) -> {
        scanEffectsInTerm(ctx, h, stVars, modCells, modArrs, hasOpaqueCall);
        scanEffectsInList(ctx, r, stVars, modCells, modArrs, hasOpaqueCall)
    },
}

// ============================================================================
// SMT-LIB2 Generation, Portable Solver Invocation & BitVec Model Decoding
// ============================================================================

def buildSmtScript(st: SymState, goalExpr: String): String = {
    let b = bufNew();
    bufPushStr(b, "(set-logic ALL)\n");
    let ds = cellNew(listRev(st.stDecls));
    while (match cellGet(ds) { Nil -> false, _ -> true }) {
        match cellGet(ds) {
            Cons(d, r) -> { bufPushStr(b, d); bufPushByte(b, 10); cellSet(ds, r) },
            Nil -> (),
        }
    };
    let ps = cellNew(listRev(st.stPath));
    while (match cellGet(ps) { Nil -> false, _ -> true }) {
        match cellGet(ps) {
            Cons(p, r) -> {
                bufPushStr(b, "(assert ");
                bufPushStr(b, p);
                bufPushStr(b, ")\n");
                cellSet(ps, r)
            },
            Nil -> (),
        }
    };
    bufPushStr(b, "(assert (not ");
    bufPushStr(b, goalExpr);
    bufPushStr(b, "))\n(check-sat)\n(get-model)\n");
    bufToString(b)
}

def trimLine(s: String): String = {
    let n = strLen(s);
    let lo = cellNew(0);
    let hi = cellNew(n);
    while (cellGet(lo) < cellGet(hi) && (strByteAt(s, cellGet(lo)) == 32 || strByteAt(s, cellGet(lo)) == 9 || strByteAt(s, cellGet(lo)) == 13)) {
        cellSet(lo, cellGet(lo) + 1)
    };
    while (cellGet(hi) > cellGet(lo) && (strByteAt(s, cellGet(hi) - 1) == 32 || strByteAt(s, cellGet(hi) - 1) == 9 || strByteAt(s, cellGet(hi) - 1) == 13)) {
        cellSet(hi, cellGet(hi) - 1)
    };
    strSlice(s, cellGet(lo), cellGet(hi))
}

def hexDigitVal(b: Int): Int =
    hexNibbleVal(b)

def decodeBvLiteral(s: String): String =
    if (strStartsWith(s, "#x")) {
        let hex = strSlice(s, 2, strLen(s));
        let n = strLen(hex);
        if (n == 8) {
            let acc: Cell Int64 = cellNew(intToI64(0));
            let i = cellNew(0);
            let ok = cellNew(true);
            while (cellGet(i) < 8 && cellGet(ok)) {
                let d = hexDigitVal(strByteAt(hex, cellGet(i)));
                if (d < 0) cellSet(ok, false)
                else {
                    cellSet(acc, cellGet(acc) * intToI64(16) + intToI64(d));
                    cellSet(i, cellGet(i) + 1)
                }
            };
            if (cellGet(ok)) {
                let u = cellGet(acc);
                let half = intToI64(2147483647) + intToI64(1);
                let full = half + half;
                let signed = if (u >= half) u - full else u;
                i64ToStr(signed)
            } else s
        } else s
    } else if (strStartsWith(s, "#b")) {
        let bin = strSlice(s, 2, strLen(s));
        let n = strLen(bin);
        if (n == 32) {
            let acc: Cell Int64 = cellNew(intToI64(0));
            let i = cellNew(0);
            let ok = cellNew(true);
            while (cellGet(i) < 32 && cellGet(ok)) {
                let ch = strByteAt(bin, cellGet(i));
                if (ch == 48 || ch == 49) {
                    cellSet(acc, cellGet(acc) * intToI64(2) + intToI64(ch - 48));
                    cellSet(i, cellGet(i) + 1)
                } else cellSet(ok, false)
            };
            if (cellGet(ok)) {
                let u = cellGet(acc);
                let half = intToI64(2147483647) + intToI64(1);
                let full = half + half;
                let signed = if (u >= half) u - full else u;
                i64ToStr(signed)
            } else s
        } else s
    } else if (strStartsWith(s, "(_ bv")) {
        let rest = trimLine(strSlice(s, 5, strLen(s)));
        match strIndexOfByte(rest, 32, 0) {
            Some(spIdx) -> {
                let decStr = strSlice(rest, 0, spIdx);
                let wStr = trimLine(strSlice(rest, spIdx + 1, strLen(rest)));
                let acc: Cell Int64 = cellNew(intToI64(0));
                let i = cellNew(0);
                let ok = cellNew(strLen(decStr) > 0);
                while (cellGet(i) < strLen(decStr) && cellGet(ok)) {
                    let ch = strByteAt(decStr, cellGet(i));
                    if (ch >= 48 && ch <= 57) {
                        cellSet(acc, cellGet(acc) * intToI64(10) + intToI64(ch - 48));
                        cellSet(i, cellGet(i) + 1)
                    } else cellSet(ok, false)
                };
                if (cellGet(ok)) {
                    let u = cellGet(acc);
                    if (wStr == "32") {
                        let half = intToI64(2147483647) + intToI64(1);
                        let full = half + half;
                        let signed = if (u >= half) u - full else u;
                        i64ToStr(signed)
                    } else i64ToStr(u)
                } else s
            },
            None -> s,
        }
    } else s

def cleanSmtVal(raw: String): String = {
    let t = trimLine(raw);
    let n = strLen(t);
    let end = cellNew(n);
    while (cellGet(end) > 0 && strByteAt(t, cellGet(end) - 1) == 41) {
        cellSet(end, cellGet(end) - 1)
    };
    let s = trimLine(strSlice(t, 0, cellGet(end)));
    if (strStartsWith(s, "(- ")) {
        "-" + trimLine(strSlice(s, 3, strLen(s)))
    } else if (strStartsWith(s, "#x") || strStartsWith(s, "#b") || strStartsWith(s, "(_ bv")) {
        decodeBvLiteral(s)
    } else s
}

def parseSmtModel(out: String, userVars: List (String, String)): List (String, String) = {
    let lines = strSplitChar(out, '\n');
    let symVals: StrMap String = strMapNew();
    let cur = cellNew(lines);
    let pendingSym: Cell (Option String) = cellNew(None);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(rawLn, r) -> {
                let ln = trimLine(rawLn);
                if (strStartsWith(ln, "(define-fun ")) {
                    let rest = strSlice(ln, 12, strLen(ln));
                    match strIndexOfByte(rest, 32, 0) {
                        Some(spIdx) -> {
                            let sym = strSlice(rest, 0, spIdx);
                            // Find `()` then skip return sort (which may be `(_ BitVec 32)` or `Bool`)
                            match strIndexOfByte(rest, 41, spIdx) {
                                Some(rpIdx) -> {
                                    let afterArgs = trimLine(strSlice(rest, rpIdx + 1, strLen(rest)));
                                    // If line ends with `)` after `(_ BitVec 32)` (no value on same line), value is on next line
                                    if (strStartsWith(afterArgs, "(_ ")) {
                                        match strIndexOfByte(afterArgs, 41, 0) {
                                            Some(sortRp) -> {
                                                let tail = trimLine(strSlice(afterArgs, sortRp + 1, strLen(afterArgs)));
                                                if (strLen(tail) > 0) {
                                                    let v = cleanSmtVal(tail);
                                                    if (strLen(v) > 0 && !strStartsWith(v, "(")) {
                                                        strMapInsert(symVals, sym, v);
                                                        cellSet(pendingSym, None)
                                                    } else cellSet(pendingSym, Some(sym))
                                                } else cellSet(pendingSym, Some(sym))
                                            },
                                            None -> cellSet(pendingSym, Some(sym)),
                                        }
                                    } else match strIndexOfByte(afterArgs, 32, 0) {
                                        Some(sortEnd) -> {
                                            let valPart = cleanSmtVal(strSlice(afterArgs, sortEnd + 1, strLen(afterArgs)));
                                            if (strLen(valPart) > 0 && !strStartsWith(valPart, "(")) {
                                                strMapInsert(symVals, sym, valPart);
                                                cellSet(pendingSym, None)
                                            } else cellSet(pendingSym, Some(sym))
                                        },
                                        None -> cellSet(pendingSym, Some(sym)),
                                    }
                                },
                                None -> cellSet(pendingSym, Some(sym)),
                            }
                        },
                        None -> cellSet(pendingSym, None),
                    }
                } else {
                    match cellGet(pendingSym) {
                        Some(sym) -> {
                            let v = cleanSmtVal(ln);
                            if (strLen(v) > 0 && !strStartsWith(v, "(")) {
                                strMapInsert(symVals, sym, v)
                            } else ();
                            cellSet(pendingSym, None)
                        },
                        None -> (),
                    }
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    let outModelRev: Cell (List (String, String)) = cellNew(Nil);
    let seenNames: StrMap Bool = strMapNew();
    let cu = cellNew(listRev(userVars));
    while (match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons((srcName, smtSym), r) -> {
                if (!strMapContains(seenNames, srcName) && !strStartsWith(srcName, "__hloc_")) {
                    match strMapGet(symVals, smtSym) {
                        Some(v) -> {
                            strMapInsert(seenNames, srcName, true);
                            cellSet(outModelRev, Cons((srcName, v), cellGet(outModelRev)))
                        },
                        None -> (),
                    }
                } else ();
                cellSet(cu, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(outModelRev))
}

def formatModelSummary(model: List (String, String)): Option String = match model {
    Nil -> None,
    _ -> {
        let b = bufNew();
        bufPushStr(b, "counterexample: ");
        let cur = cellNew(model);
        let first = cellNew(true);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((k, v), r) -> {
                    if (!cellGet(first)) bufPushStr(b, ", ") else cellSet(first, false);
                    bufPushStr(b, k);
                    bufPushStr(b, " = ");
                    bufPushStr(b, v);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        Some(bufToString(b))
    },
}

def isCvc5Binary(bin: String): Bool = {
    let base = pathBasename(bin);
    strStartsWith(base, "cvc5") || strStartsWith(base, "cvc4")
}

def querySmtSolver(ctx: VerifyCtx, script: String): Result (String, String) String = {
    let seq = cellGet(ctx.vcNextSym);
    cellSet(ctx.vcNextSym, seq + 1);
    let tmpDir = pathJoin(geishaHomeDir(), "tmp");
    let _ = mkdirAll(tmpDir)?;
    let smtPath = pathJoin(tmpDir, "geisha_verify_" + intToStr(c_verify_getpid()) + "_" + intToStr(seq) + ".smt2");
    let _ = writeFile(smtPath, script)?;
    let solverArgs =
        if (isCvc5Binary(ctx.vcSolver)) ["--lang", "smt2", "--produce-models", smtPath]
        else ["-smt2", smtPath];
    let cmd = command(ctx.vcSolver, solverArgs);
    let runRes = runTimeout(cmd, ctx.vcTimeoutMs);
    let _ = removeFile(smtPath);
    match runRes {
        Err(e) -> Err("failed to invoke SMT solver '" + ctx.vcSolver + "': " + e + " (install Z3/CVC5 or pass --solver <path>)"),
        Ok(None) -> Ok(("unknown", "timeout")),
        Ok(Some(out)) -> {
            let firstLn = match strSplitChar(out.stdout, '\n') {
                Cons(h, _) -> trimLine(h),
                Nil -> "",
            };
            if (firstLn == "unsat") Ok(("proved", out.stdout))
            else if (firstLn == "sat") Ok(("failed", out.stdout))
            else Ok(("unknown", out.stdout))
        },
    }
}

def recordUnknown(ctx: VerifyCtx, kind: String, sp: Span, msg: String, reason: String): Void =
    cellSet(ctx.vcResultsRev, Cons(MkObResult {
        obFn: ctx.vcCurFn,
        obKind: kind,
        obStatus: "unknown",
        obSpan: sp,
        obMsg: msg,
        obHint: Some(reason),
        obModel: Nil,
    }, cellGet(ctx.vcResultsRev)))

def recordFailed(ctx: VerifyCtx, kind: String, sp: Span, msg: String, hint: Option String): Void =
    cellSet(ctx.vcResultsRev, Cons(MkObResult {
        obFn: ctx.vcCurFn,
        obKind: kind,
        obStatus: "failed",
        obSpan: sp,
        obMsg: msg,
        obHint: hint,
        obModel: Nil,
    }, cellGet(ctx.vcResultsRev)))

def dischargeObligation(
    ctx: VerifyCtx,
    st: SymState,
    kind: String,
    sp: Span,
    msg: String,
    goalExpr: String,
    extraHint: Option String
): Void = {
    match cellGet(ctx.vcSolverErr) {
        Some(_) -> (),
        None -> {
            let script = buildSmtScript(st, goalExpr);
            match querySmtSolver(ctx, script) {
                Err(e) -> cellSet(ctx.vcSolverErr, Some(e)),
                Ok((status, rawOut)) -> {
                    let model = if (status == "failed") parseSmtModel(rawOut, st.stUserVars) else Nil;
                    let hintOpt =
                        if (status == "failed") {
                            match (formatModelSummary(model), extraHint) {
                                (Some(ce), Some(eh)) -> Some(ce + "; " + eh),
                                (Some(ce), None) -> Some(ce),
                                (None, eh) -> eh,
                            }
                        } else if (status == "unknown") {
                            Some("SMT solver returned unknown or timed out")
                        } else None;
                    cellSet(ctx.vcResultsRev, Cons(MkObResult {
                        obFn: ctx.vcCurFn,
                        obKind: kind,
                        obStatus: status,
                        obSpan: sp,
                        obMsg: msg,
                        obHint: hintOpt,
                        obModel: model,
                    }, cellGet(ctx.vcResultsRev)))
                },
            }
        },
    }
}

def dischargeOptGoal(
    ctx: VerifyCtx,
    st: SymState,
    kind: String,
    sp: Span,
    msg: String,
    goalOpt: Option String,
    extraHint: Option String
): Void = match goalOpt {
    Some(g) -> dischargeObligation(ctx, st, kind, sp, msg, g, extraHint),
    None -> recordUnknown(ctx, kind, sp, msg, "expression contains constructs not yet modeled by SMT backend"),
}

// ============================================================================
// Pattern Matching Support in SMT
// ============================================================================

def adtHeadNameAndArgs(ty: Type): (Option String, List Type) = match ty {
    TyCon(n) -> (Some(n), Nil),
    TyComp(b, a) -> {
        let (h, args) = adtHeadNameAndArgs(b);
        (h, listAppend(args, [a]))
    },
    _ -> (None, Nil),
}

def adtVariantCountForType(ctx: VerifyCtx, ty: Type): Option Int =
    match adtHeadNameAndArgs(ty) {
        (Some(nm), _) -> strMapGet(ctx.vcAdtVariantCount, nm),
        _ -> None,
    }

def instantiateCtorFieldTypes(ctx: VerifyCtx, cname: String, scrutTy: Type): List Type =
    match strMapGet(ctx.vcCtorFieldTypes, cname) {
        None -> Nil,
        Some(rawFtys) -> match (strMapGet(ctx.vcCtorAdt, cname), adtHeadNameAndArgs(scrutTy)) {
            (Some(adtNm), (_, targs)) -> match strMapGet(ctx.vcAdtTypeParams, adtNm) {
                Some(tparams) -> {
                    let sub: StrMap Type = strMapNew();
                    let cp = cellNew(tparams);
                    let ca = cellNew(targs);
                    while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                        match (cellGet(cp), cellGet(ca)) {
                            (Cons(tp, rp), Cons(ta, ra)) -> {
                                strMapInsert(sub, tp, ta);
                                cellSet(cp, rp);
                                cellSet(ca, ra)
                            },
                            _ -> (),
                        }
                    };
                    let outRev: Cell (List Type) = cellNew(Nil);
                    let cf = cellNew(rawFtys);
                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                        match cellGet(cf) {
                            Cons(ft, rf) -> {
                                cellSet(outRev, Cons(applyExplicitSubst(ft, sub), cellGet(outRev)));
                                cellSet(cf, rf)
                            },
                            Nil -> (),
                        }
                    };
                    listRev(cellGet(outRev))
                },
                None -> rawFtys,
            },
            _ -> rawFtys,
        },
    }

def ensureDeclOnce(decls: List String, decl: String): List String =
    if (listHasStr(decls, decl)) decls else Cons(decl, decls)

def bindUnknownPatternVarsList(ctx: VerifyCtx, st: SymState, pats: List Pattern, tys: List Type): SymState = match pats {
    Nil -> st,
    Cons(p, r) -> match tys {
        Cons(t0, rt) -> bindUnknownPatternVarsList(ctx, bindUnknownPatternVars(ctx, st, p, Some(t0)), r, rt),
        Nil -> bindUnknownPatternVarsList(ctx, bindUnknownPatternVars(ctx, st, p, None), r, Nil),
    },
}

def bindUnknownPatternVarsNamed(ctx: VerifyCtx, st: SymState, namedPats: List (String, Pattern, Span, Bool), tys: List Type): SymState = match namedPats {
    Nil -> st,
    Cons((_, p, _, _), r) -> match tys {
        Cons(t0, rt) -> bindUnknownPatternVarsNamed(ctx, bindUnknownPatternVars(ctx, st, p, Some(t0)), r, rt),
        Nil -> bindUnknownPatternVarsNamed(ctx, bindUnknownPatternVars(ctx, st, p, None), r, Nil),
    },
}

def bindUnknownPatternVars(ctx: VerifyCtx, st: SymState, pat: Pattern, tyOpt: Option Type): SymState = match pat {
    PatVar(vn, _) -> {
        let sortOpt = match tyOpt {
            Some(vty) -> typeToSmtSort(vty),
            None -> None,
        };
        match sortOpt {
            Some(sort) -> {
                let sym = freshSym(ctx, vn);
                let decl = "(declare-const " + sym + " " + sort + ")";
                let path2 = match tyOpt {
                    Some(TyCon("Char")) -> Cons("(bvult " + sym + " #x00000100)", st.stPath),
                    _ -> st.stPath,
                };
                let uvars = if (strStartsWith(vn, "__")) st.stUserVars else assocSet(st.stUserVars, vn, sym);
                MkSymState {
                    stDecls: Cons(decl, st.stDecls),
                    stVars: assocSet(st.stVars, vn, sym),
                    stCells: st.stCells, stLocSorts: st.stLocSorts,
                    stArrLens: st.stArrLens, stArrMems: st.stArrMems,
                    stDataTags: st.stDataTags, stDataFields: st.stDataFields,
                    stPath: path2, stUserVars: uvars,
                }
            },
            None -> MkSymState {
                stDecls: st.stDecls,
                stVars: assocRemove(st.stVars, vn),
                stCells: st.stCells, stLocSorts: st.stLocSorts,
                stArrLens: st.stArrLens, stArrMems: st.stArrMems,
                stDataTags: st.stDataTags, stDataFields: st.stDataFields,
                stPath: st.stPath, stUserVars: st.stUserVars,
            },
        }
    },
    PatCtor(cname, subPats) -> {
        let ftys = match tyOpt {
            Some(sty) -> instantiateCtorFieldTypes(ctx, cname, sty),
            None -> Nil,
        };
        bindUnknownPatternVarsList(ctx, st, subPats, ftys)
    },
    PatTuple(subPats) -> {
        let ftys = match tyOpt {
            Some(TyTuple(ts)) -> ts,
            _ -> Nil,
        };
        bindUnknownPatternVarsList(ctx, st, subPats, ftys)
    },
    PatStruct(cname, namedPats) -> {
        let ftys = match tyOpt {
            Some(sty) -> instantiateCtorFieldTypes(ctx, cname, sty),
            None -> Nil,
        };
        bindUnknownPatternVarsNamed(ctx, st, namedPats, ftys)
    },
    _ -> st,
}

def bindPatternInSym(
    ctx: VerifyCtx,
    st: SymState,
    pat: Pattern,
    scrutOpt: Option String,
    scrutTy: Type
): (SymState, Option String) = match pat {
    PatWild -> (st, Some("true")),
    PatVar(vn, _) -> match scrutOpt {
        Some(sv) -> {
            let st2 = MkSymState {
                stDecls: st.stDecls,
                stVars: assocSet(st.stVars, vn, sv),
                stCells: st.stCells, stLocSorts: st.stLocSorts,
                stArrLens: st.stArrLens, stArrMems: st.stArrMems,
                stDataTags: st.stDataTags, stDataFields: st.stDataFields,
                stPath: st.stPath, stUserVars: st.stUserVars,
            };
            (st2, Some("true"))
        },
        None -> (bindUnknownPatternVars(ctx, st, pat, Some(scrutTy)), Some("true")),
    },
    PatLit(LitInt(n)) -> match scrutOpt {
        Some(sv) -> (st, Some("(= " + sv + " " + bvLitForBits(n, typeBitWidth(scrutTy)) + ")")),
        None -> (st, None),
    },
    PatLit(LitBool(b)) -> match scrutOpt {
        Some(sv) -> (st, Some("(= " + sv + " " + (if (b) "true" else "false") + ")")),
        None -> (st, None),
    },
    PatLit(LitUnit) -> (st, Some("true")),
    PatLit(_) -> (st, None),
    PatCtor(cname, subPats) -> match strMapGet(ctx.vcCtorTags, cname) {
        Some(tag) -> match scrutOpt {
            Some(sv) -> {
                let tagExpr = match assocGet(st.stDataTags, sv) {
                    Some(te) -> te,
                    None -> sv,
                };
                let tagCond = "(= " + tagExpr + " " + bvLitForBits(tag, 32) + ")";
                let fieldsOpt = assocGetFields(st.stDataFields, sv);
                let ftys = instantiateCtorFieldTypes(ctx, cname, scrutTy);
                bindSubPatterns(ctx, st, subPats, fieldsOpt, ftys, sv, tag, tagCond)
            },
            None -> (bindUnknownPatternVars(ctx, st, pat, Some(scrutTy)), None),
        },
        None -> (bindUnknownPatternVars(ctx, st, pat, Some(scrutTy)), None),
    },
    PatStruct(cname, namedPats) -> match strMapGet(ctx.vcCtorTags, cname) {
        Some(tag) -> match scrutOpt {
            Some(sv) -> {
                let tagExpr = match assocGet(st.stDataTags, sv) {
                    Some(te) -> te,
                    None -> sv,
                };
                let tagCond = "(= " + tagExpr + " " + bvLitForBits(tag, 32) + ")";
                let subPats = cellNew(Nil);
                let cn = cellNew(namedPats);
                while (match cellGet(cn) { Nil -> false, _ -> true }) {
                    match cellGet(cn) {
                        Cons((_, p, _, _), r) -> { cellSet(subPats, listAppend(cellGet(subPats), [p])); cellSet(cn, r) },
                        Nil -> (),
                    }
                };
                let fieldsOpt = assocGetFields(st.stDataFields, sv);
                let ftys = instantiateCtorFieldTypes(ctx, cname, scrutTy);
                bindSubPatterns(ctx, st, cellGet(subPats), fieldsOpt, ftys, sv, tag, tagCond)
            },
            None -> (bindUnknownPatternVars(ctx, st, pat, Some(scrutTy)), None),
        },
        None -> (bindUnknownPatternVars(ctx, st, pat, Some(scrutTy)), None),
    },
    PatTuple(subPats) -> match scrutOpt {
        Some(sv) -> {
            let fieldsOpt = assocGetFields(st.stDataFields, sv);
            bindSubPatterns(ctx, st, subPats, fieldsOpt, Nil, sv, 0, "true")
        },
        None -> (bindUnknownPatternVars(ctx, st, pat, Some(scrutTy)), None),
    },
}

def bindSubPatterns(
    ctx: VerifyCtx,
    st: SymState,
    pats: List Pattern,
    fieldsOpt: Option (List (Option String)),
    fieldTypes: List Type,
    scrutSym: String,
    ctorTag: Int,
    initCond: String
): (SymState, Option String) = {
    let curSt = cellNew(st);
    let condAcc: Cell (Option String) = cellNew(Some(initCond));
    let cp = cellNew(pats);
    let cf = cellNew(match fieldsOpt { Some(fs) -> fs, None -> Nil });
    let cft = cellNew(fieldTypes);
    let fIdx = cellNew(0);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(p, rp) -> {
                let curIdx = cellGet(fIdx);
                cellSet(fIdx, curIdx + 1);
                let fTy = match cellGet(cft) {
                    Cons(t0, rt) -> { cellSet(cft, rt); t0 },
                    Nil -> TyCon("Int"),
                };
                let fSortOpt = match typeToSmtSort(fTy) {
                    Some(sr) -> Some(sr),
                    None -> match adtVariantCountForType(ctx, fTy) {
                        Some(_) -> Some("(_ BitVec 32)"),
                        None -> None,
                    },
                };
                let fValOpt: Option String = match cellGet(cf) {
                    Cons(fv, rf) -> { cellSet(cf, rf); fv },
                    Nil -> match fSortOpt {
                        Some(fSort) -> {
                            // Deterministic projection symbol so repeated `match x` yields identical field symbols
                            let projSym = sanitizeSmtIdent(scrutSym) + "_c" + intToStr(ctorTag) + "_f" + intToStr(curIdx);
                            let decl = "(declare-const " + projSym + " " + fSort + ")";
                            let s0 = cellGet(curSt);
                            let path0 = match fTy {
                                TyCon("Char") -> Cons("(bvult " + projSym + " #x00000100)", s0.stPath),
                                _ -> s0.stPath,
                            };
                            let path1 = match adtVariantCountForType(ctx, fTy) {
                                Some(nv) if (nv > 0) -> Cons("(bvult " + projSym + " " + bvLitForBits(nv, 32) + ")", path0),
                                _ -> path0,
                            };
                            cellSet(curSt, MkSymState {
                                stDecls: ensureDeclOnce(s0.stDecls, decl),
                                stVars: s0.stVars, stCells: s0.stCells, stLocSorts: s0.stLocSorts,
                                stArrLens: s0.stArrLens, stArrMems: s0.stArrMems,
                                stDataTags: s0.stDataTags, stDataFields: s0.stDataFields,
                                stPath: path1, stUserVars: s0.stUserVars,
                            });
                            Some(projSym)
                        },
                        None -> None,
                    },
                };
                let (st1, pc) = bindPatternInSym(ctx, cellGet(curSt), p, fValOpt, fTy);
                cellSet(curSt, st1);
                cellSet(condAcc, match (cellGet(condAcc), pc) {
                    (Some("true"), Some(c2)) -> Some(c2),
                    (Some(c1), Some("true")) -> Some(c1),
                    (Some(c1), Some(c2)) -> Some("(and " + c1 + " " + c2 + ")"),
                    _ -> None,
                });
                cellSet(cp, rp)
            },
            Nil -> (),
        }
    };
    (cellGet(curSt), cellGet(condAcc))
}

// ============================================================================
// Symbolic Evaluator & Verification Condition Generator
// ============================================================================

def evalContractTerm(ctx: VerifyCtx, st: SymState, t: TaggedTerm): (SymState, Option String) =
    evalTerm(ctx, st, t, true)

def evalTerm(ctx: VerifyCtx, st: SymState, t: TaggedTerm, emitObs: Bool): (SymState, Option String) =
    match t.tnode {
        TmLit(LitInt(n)) -> (st, Some(bvLitForBits(n, typeBitWidth(schemeBody(t.tscm))))),
        TmLit(LitChar(cp)) -> (st, Some(bvLitForBits(cp & 255, 32))),
        TmLit(LitBool(b)) -> (st, Some(if (b) "true" else "false")),
        TmLit(LitUnit) -> (st, Some("#x00000000")),
        TmLit(_) -> (st, None),
        TmVar(v) -> match assocGet(st.stVars, v) {
            Some(s) -> (st, Some(s)),
            None -> {
                let vty = schemeBody(t.tscm);
                match typeToSmtSort(vty) {
                    Some(sort) -> {
                        let sym = freshSym(ctx, v);
                        let decl = "(declare-const " + sym + " " + sort + ")";
                        let path1 = match vty {
                            TyCon("Char") -> Cons("(bvult " + sym + " #x00000100)", st.stPath),
                            _ -> st.stPath,
                        };
                        let st2 = MkSymState {
                            stDecls: Cons(decl, st.stDecls),
                            stVars: assocSet(st.stVars, v, sym),
                            stCells: st.stCells, stLocSorts: st.stLocSorts,
                            stArrLens: st.stArrLens, stArrMems: st.stArrMems,
                            stDataTags: st.stDataTags, stDataFields: st.stDataFields,
                            stPath: path1,
                            stUserVars: assocSet(st.stUserVars, v, sym),
                        };
                        (st2, Some(sym))
                    },
                    None -> (st, None),
                }
            },
        },
        TmGlobalVar(_) -> (st, None),
        TmUn(UnNot, e) -> {
            let (st1, ev) = evalTerm(ctx, st, e, emitObs);
            match ev {
                Some(s) -> (st1, Some("(not " + s + ")")),
                None -> (st1, None),
            }
        },
        TmUn(UnNeg, e) -> {
            let (st1, ev) = evalTerm(ctx, st, e, emitObs);
            let ety = schemeBody(e.tscm);
            match (typeToSmtSort(ety), ev) {
                (Some("(_ BitVec 32)"), Some(s)) -> (st1, Some("(bvneg " + s + ")")),
                (Some("(_ BitVec 64)"), Some(s)) -> (st1, Some("(bvneg " + s + ")")),
                _ -> (st1, None),
            }
        },
        TmUn(UnBitNot, e) -> {
            let (st1, ev) = evalTerm(ctx, st, e, emitObs);
            let ety = schemeBody(e.tscm);
            match (typeToSmtSort(ety), ev) {
                (Some("(_ BitVec 32)"), Some(s)) -> (st1, Some("(bvnot " + s + ")")),
                (Some("(_ BitVec 64)"), Some(s)) -> (st1, Some("(bvnot " + s + ")")),
                _ -> (st1, None),
            }
        },
        TmBin(OpAnd, l, r) -> {
            let falseTerm = MkTerm { tspan: t.tspan, tscm: ScmMono(TyCon("Bool")), tnode: TmLit(LitBool(false)) };
            evalIf(ctx, st, TyCon("Bool"), l, r, falseTerm, emitObs)
        },
        TmBin(OpOr, l, r) -> {
            let trueTerm = MkTerm { tspan: t.tspan, tscm: ScmMono(TyCon("Bool")), tnode: TmLit(LitBool(true)) };
            evalIf(ctx, st, TyCon("Bool"), l, trueTerm, r, emitObs)
        },
        TmBin(op, l, r) -> {
            let (st1, lv) = evalTerm(ctx, st, l, emitObs);
            let (st2, rv) = evalTerm(ctx, st1, r, emitObs);
            let lty = schemeBody(l.tscm);
            let bits = typeBitWidth(lty);
            let isScalarModeled = match typeToSmtSort(lty) { Some(_) -> true, None -> false };
            let isChar = match lty { TyCon("Char") -> true, _ -> false };
            let isSignedInt = match lty { TyCon("Int") -> true, TyCon("Int64") -> true, _ -> false };
            // A4: Always check div/rem-by-zero BEFORE matching `(lv, rv)` so an unmodeled dividend or divisor never skips the check!
            let isDivOrRem = match op { OpDiv -> true, OpRem -> true, _ -> false };
            if (isSignedInt && isDivOrRem && emitObs && ctx.vcCheckImplicit) {
                let msg = match op {
                    OpDiv -> "possible division by zero in `" + ctx.vcCurFn + "`",
                    _ -> "possible remainder by zero in `" + ctx.vcCurFn + "`",
                };
                match rv {
                    Some(rs) -> dischargeObligation(
                        ctx, st2, "div_by_zero", t.tspan, msg,
                        "(not (= " + rs + " " + bvZero(bits) + "))", None
                    ),
                    None -> recordUnknown(
                        ctx, "div_by_zero", t.tspan, msg,
                        "divisor expression is not modeled in SMT"
                    ),
                }
            } else ();
            match (lv, rv) {
                (Some(ls), Some(rs)) ->
                    if (isSignedInt) {
                        match op {
                            OpAdd -> (st2, Some("(bvadd " + ls + " " + rs + ")")),
                            OpSub -> (st2, Some("(bvsub " + ls + " " + rs + ")")),
                            OpMul -> (st2, Some("(bvmul " + ls + " " + rs + ")")),
                            OpDiv -> (st2, Some("(bvsdiv " + ls + " " + rs + ")")),
                            OpRem -> (st2, Some("(bvsrem " + ls + " " + rs + ")")),
                            OpBitAnd -> (st2, Some("(bvand " + ls + " " + rs + ")")),
                            OpBitOr -> (st2, Some("(bvor " + ls + " " + rs + ")")),
                            OpBitXor -> (st2, Some("(bvxor " + ls + " " + rs + ")")),
                            OpShl -> {
                                let shAmt = if (bits == 64) "((_ zero_extend 32) (bvand " + rs + " #x0000003f))" else "(bvand " + rs + " #x0000001f)";
                                (st2, Some("(bvshl " + ls + " " + shAmt + ")"))
                            },
                            OpShr -> {
                                let shAmt = if (bits == 64) "((_ zero_extend 32) (bvand " + rs + " #x0000003f))" else "(bvand " + rs + " #x0000001f)";
                                (st2, Some("(bvashr " + ls + " " + shAmt + ")"))
                            },
                            OpUshr -> {
                                let shAmt = if (bits == 64) "((_ zero_extend 32) (bvand " + rs + " #x0000003f))" else "(bvand " + rs + " #x0000001f)";
                                (st2, Some("(bvlshr " + ls + " " + shAmt + ")"))
                            },
                            OpEq -> (st2, Some("(= " + ls + " " + rs + ")")),
                            OpNe -> (st2, Some("(not (= " + ls + " " + rs + "))")),
                            OpLt -> (st2, Some("(bvslt " + ls + " " + rs + ")")),
                            OpLe -> (st2, Some("(bvsle " + ls + " " + rs + ")")),
                            OpGt -> (st2, Some("(bvsgt " + ls + " " + rs + ")")),
                            OpGe -> (st2, Some("(bvsge " + ls + " " + rs + ")")),
                            _ -> (st2, None),
                        }
                    } else if (isChar) {
                        match op {
                            OpEq -> (st2, Some("(= " + ls + " " + rs + ")")),
                            OpNe -> (st2, Some("(not (= " + ls + " " + rs + "))")),
                            OpLt -> (st2, Some("(bvult " + ls + " " + rs + ")")),
                            OpLe -> (st2, Some("(bvule " + ls + " " + rs + ")")),
                            OpGt -> (st2, Some("(bvugt " + ls + " " + rs + ")")),
                            OpGe -> (st2, Some("(bvuge " + ls + " " + rs + ")")),
                            _ -> (st2, None),
                        }
                    } else if (isScalarModeled) {
                        match op {
                            OpEq -> (st2, Some("(= " + ls + " " + rs + ")")),
                            OpNe -> (st2, Some("(not (= " + ls + " " + rs + "))")),
                            _ -> (st2, None),
                        }
                    } else (st2, None),
                _ -> (st2, None),
            }
        },
        TmTuple(es) -> {
            let (st1, vs) = evalArgs(ctx, st, es, emitObs);
            let sym = freshSym(ctx, "tup");
            let st2 = MkSymState {
                stDecls: Cons("(declare-const " + sym + " (_ BitVec 32))", st1.stDecls),
                stVars: st1.stVars, stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                stDataTags: assocSet(st1.stDataTags, sym, "#x00000000"),
                stDataFields: Cons((sym, vs), st1.stDataFields),
                stPath: st1.stPath, stUserVars: st1.stUserVars,
            };
            (st2, Some(sym))
        },
        TmMakeData(_, tag, fs, _, _) -> {
            let (st1, vs) = evalArgs(ctx, st, fs, emitObs);
            let sym = freshSym(ctx, "adt");
            let tagBv = bvLitForBits(tag, 32);
            let st2 = MkSymState {
                stDecls: Cons("(declare-const " + sym + " (_ BitVec 32))", st1.stDecls),
                stVars: st1.stVars, stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                stDataTags: assocSet(st1.stDataTags, sym, tagBv),
                stDataFields: Cons((sym, vs), st1.stDataFields),
                stPath: Cons("(= " + sym + " " + tagBv + ")", st1.stPath),
                stUserVars: st1.stUserVars,
            };
            (st2, Some(sym))
        },
        TmGetTag(e) -> {
            let (st1, ev) = evalTerm(ctx, st, e, emitObs);
            match ev {
                Some(sv) -> match assocGet(st1.stDataTags, sv) {
                    Some(tg) -> (st1, Some(tg)),
                    None -> (st1, Some(sv)),
                },
                None -> (st1, None),
            }
        },
        TmMakeCls(vd, cls, body) -> {
            if (strStartsWith(vd.vname, ".try_while_") && emitObs && ctx.vcCurFn != cls.clsEntry) {
                let hasExplicitInv = match strMapGet(ctx.vcSpecs, cls.clsEntry) {
                    Some(cspec) -> {
                        let inner = match cspec.fsBody.tnode {
                            TmMakeCls(_, _, b) -> b,
                            _ -> cspec.fsBody,
                        };
                        match inner.tnode {
                            TmBlock(Cons(firstStmt, _)) -> match firstStmt.tnode {
                                TmApplyDir(avd, _) -> avd.vname == "assume",
                                _ -> false,
                            },
                            _ -> false,
                        }
                    },
                    None -> false,
                };
                if (!hasExplicitInv) {
                    recordUnknown(
                        ctx, "invariant", t.tspan,
                        "while loop containing `?` in `" + ctx.vcCurFn + "` has no `invariant`",
                        "add an explicit `invariant` clause to verify loops containing `?`"
                    )
                } else ()
            } else ();
            evalTerm(ctx, st, body, emitObs)
        },
        TmApplyCls(callee, args) -> {
            let (st1, _) = evalTerm(ctx, st, callee, emitObs);
            let (st2, _) = evalArgs(ctx, st1, args, emitObs);
            // Conservative havoc: unknown closure may mutate any captured Cell or MutArray
            let allCellLocs = assocKeysUnique(st2.stCells);
            let allArrLocs = assocKeysUnique(st2.stArrMems);
            let st3 = havocLocs(ctx, st2, allCellLocs, allArrLocs, "cls");
            (st3, None)
        },
        TmLet(vd, valT, bodyT) -> {
            let vname = vd.vname;
            let vty = schemeBody(vd.vscm);
            match valT.tnode {
                TmApplyDir(cvd, cargs) if (cvd.vname == "cellNew" && !isShadowedByDecl(ctx.vcSpecs, ctx.vcExterns, cvd.vname)) -> match cargs {
                    Cons(initT, _) -> {
                        let (st1, iv) = evalTerm(ctx, st, initT, emitObs);
                        let loc = freshLoc(ctx, vname);
                        let eSort = elemSortForContainer(ctx, vty);
                        let (decls2, initSym) =
                            if (eSort == "__nonscalar") {
                                match iv {
                                    Some(s) -> (st1.stDecls, s),
                                    None -> (st1.stDecls, "__unknown_nonscalar"),
                                }
                            } else match iv {
                                Some(s) -> (st1.stDecls, s),
                                None -> {
                                    let fs = freshSym(ctx, vname);
                                    (Cons("(declare-const " + fs + " " + eSort + ")", st1.stDecls), fs)
                                },
                            };
                        let st2 = MkSymState {
                            stDecls: decls2,
                            stVars: assocSet(st1.stVars, vname, loc),
                            stCells: assocSet(st1.stCells, loc, initSym),
                            stLocSorts: assocSet(st1.stLocSorts, loc, eSort),
                            stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                            stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                            stPath: st1.stPath, stUserVars: st1.stUserVars,
                        };
                        let (stOut, rv) = evalTerm(ctx, st2, bodyT, emitObs);
                        (stRestoreVars(stOut, st1.stVars), rv)
                    },
                    Nil -> evalTerm(ctx, st, bodyT, emitObs),
                },
                TmApplyDir(avd, aargs) if ((avd.vname == "arrayNew" || avd.vname == "arrayNewZeroed") && !isShadowedByDecl(ctx.vcSpecs, ctx.vcExterns, avd.vname)) -> match aargs {
                    Cons(lenT, restA) -> {
                        let (st1, lenV) = evalTerm(ctx, st, lenT, emitObs);
                        let (st2, initV) = match restA {
                            Cons(initT, _) -> evalTerm(ctx, st1, initT, emitObs),
                            Nil -> (st1, zeroValForElemTy(ctx, vty)),
                        };
                        let loc = freshLoc(ctx, vname);
                        let eSort = elemSortForContainer(ctx, vty);
                        let (decls2, lenSym) = match lenV {
                            Some(ls) -> {
                                if (emitObs && ctx.vcCheckImplicit) {
                                    dischargeObligation(
                                        ctx, st2, "bounds", valT.tspan,
                                        "array length may be negative in `" + ctx.vcCurFn + "`",
                                        "(bvsge " + ls + " #x00000000)", None
                                    )
                                } else ();
                                (st2.stDecls, ls)
                            },
                            None -> {
                                if (emitObs && ctx.vcCheckImplicit) {
                                    recordUnknown(
                                        ctx, "bounds", valT.tspan,
                                        "array length non-negativity could not be verified in `" + ctx.vcCurFn + "`",
                                        "array length expression is not modeled in SMT"
                                    )
                                } else ();
                                let fl = freshSym(ctx, vname + "_len");
                                (Cons("(declare-const " + fl + " (_ BitVec 32))", st2.stDecls), fl)
                            },
                        };
                        let (decls3, memExpr) =
                            if (eSort == "__nonscalar") (decls2, "__nonscalar_arr")
                            else match initV {
                                Some(iv) -> (decls2, "((as const (Array (_ BitVec 32) " + eSort + ")) " + iv + ")"),
                                None -> {
                                    let ms = freshSym(ctx, vname + "_mem");
                                    (Cons("(declare-const " + ms + " (Array (_ BitVec 32) " + eSort + "))", decls2), ms)
                                },
                            };
                        let st3 = MkSymState {
                            stDecls: decls3,
                            stVars: assocSet(st2.stVars, vname, loc),
                            stCells: st2.stCells,
                            stLocSorts: assocSet(st2.stLocSorts, loc, eSort),
                            stArrLens: assocSet(st2.stArrLens, loc, lenSym),
                            stArrMems: assocSet(st2.stArrMems, loc, memExpr),
                            stDataTags: st2.stDataTags, stDataFields: st2.stDataFields,
                            stPath: Cons("(bvsge " + lenSym + " #x00000000)", st2.stPath),
                            stUserVars: st2.stUserVars,
                        };
                        let (stOut, rv) = evalTerm(ctx, st3, bodyT, emitObs);
                        (stRestoreVars(stOut, st2.stVars), rv)
                    },
                    Nil -> evalTerm(ctx, st, bodyT, emitObs),
                },
                _ -> {
                    let (st1, vv) = evalTerm(ctx, st, valT, emitObs);
                    let st2 = match vv {
                        Some(exprStr) ->
                            if (isCellType(vty) || isArrayType(vty)) {
                                // Aliasing: bind `vname` to the exact same `locId`
                                MkSymState {
                                    stDecls: st1.stDecls,
                                    stVars: assocSet(st1.stVars, vname, exprStr),
                                    stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                                    stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                                    stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                                    stPath: st1.stPath, stUserVars: st1.stUserVars,
                                }
                            } else match typeToSmtSort(vty) {
                                Some(sort) -> {
                                    let sym = freshSym(ctx, vname);
                                    let decl = "(declare-const " + sym + " " + sort + ")";
                                    let eq = "(= " + sym + " " + exprStr + ")";
                                    let uvars = if (strStartsWith(vname, "__")) st1.stUserVars else assocSet(st1.stUserVars, vname, sym);
                                    MkSymState {
                                        stDecls: Cons(decl, st1.stDecls),
                                        stVars: assocSet(st1.stVars, vname, sym),
                                        stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                                        stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                                        stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                                        stPath: Cons(eq, st1.stPath),
                                        stUserVars: uvars,
                                    }
                                },
                                None -> MkSymState {
                                    stDecls: st1.stDecls,
                                    stVars: assocSet(st1.stVars, vname, exprStr),
                                    stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                                    stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                                    stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                                    stPath: st1.stPath, stUserVars: st1.stUserVars,
                                },
                            },
                        None -> match typeToSmtSort(vty) {
                            Some(sort) -> {
                                let sym = freshSym(ctx, vname);
                                let decl = "(declare-const " + sym + " " + sort + ")";
                                let path2 = match vty {
                                    TyCon("Char") -> Cons("(bvult " + sym + " #x00000100)", st1.stPath),
                                    _ -> st1.stPath,
                                };
                                let uvars = if (strStartsWith(vname, "__")) st1.stUserVars else assocSet(st1.stUserVars, vname, sym);
                                MkSymState {
                                    stDecls: Cons(decl, st1.stDecls),
                                    stVars: assocSet(st1.stVars, vname, sym),
                                    stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                                    stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                                    stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                                    stPath: path2, stUserVars: uvars,
                                }
                            },
                            None -> MkSymState {
                                stDecls: st1.stDecls,
                                stVars: assocRemove(st1.stVars, vname),
                                stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                                stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                                stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                                stPath: st1.stPath, stUserVars: st1.stUserVars,
                            },
                        },
                    };
                    let (stOut, rv) = evalTerm(ctx, st2, bodyT, emitObs);
                    (stRestoreVars(stOut, st1.stVars), rv)
                },
            }
        },
        TmBlock(stmts) -> evalBlock(ctx, st, stmts, emitObs),
        TmIf(c, th, el) -> evalIf(ctx, st, schemeBody(t.tscm), c, th, el, emitObs),
        TmMatch(scrut, arms) -> evalMatch(ctx, st, schemeBody(t.tscm), scrut, arms, emitObs),
        TmWhile(cond, body) -> evalWhile(ctx, st, t.tspan, cond, body, emitObs),
        TmApplyDir(vd, args) -> evalApplyDir(ctx, st, t.tspan, schemeBody(t.tscm), vd.vname, args, emitObs),
    }

def isPureSmtIteType(ctx: VerifyCtx, ty: Type): Bool =
    match typeToSmtSort(ty) {
        Some(_) -> true,
        None -> match adtHeadNameAndArgs(ty) {
            (Some(nm), _) -> match strMapGet(ctx.vcAdtReg, nm) {
                Some(info) -> match info.variants {
                    Nil -> false,
                    _ -> {
                        let allFieldless = cellNew(true);
                        let cv = cellNew(info.variants);
                        while (cellGet(allFieldless) && match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(v, r) -> {
                                    match v.fieldTypes {
                                        Nil -> (),
                                        _ -> cellSet(allFieldless, false),
                                    };
                                    cellSet(cv, r)
                                },
                                Nil -> (),
                            }
                        };
                        cellGet(allFieldless)
                    },
                },
                None -> false,
            },
            _ -> false,
        },
    }

def evalIf(
    ctx: VerifyCtx,
    st: SymState,
    resTy: Type,
    c: TaggedTerm,
    th: TaggedTerm,
    el: TaggedTerm,
    emitObs: Bool
): (SymState, Option String) = {
    let (st1, cv) = evalTerm(ctx, st, c, emitObs);
    match cv {
        Some(cs) -> {
            let stThenIn = stWithPath(st1, cs);
            let (stThenOut, tv) = evalTerm(ctx, stThenIn, th, emitObs);
            let stElseIn = MkSymState {
                stDecls: stThenOut.stDecls, stVars: st1.stVars,
                stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                stPath: Cons("(not " + cs + ")", st1.stPath),
                stUserVars: stThenOut.stUserVars,
            };
            let (stElseOut, ev) = evalTerm(ctx, stElseIn, el, emitObs);

            // Merge BOTH modified Cells and modified MutArrays with `(ite cs thenVal elseVal)`
            let allCellLocs = assocKeysUnique(st1.stCells);
            let mergedCells = cellNew(st1.stCells);
            let cc = cellNew(allCellLocs);
            while (match cellGet(cc) { Nil -> false, _ -> true }) {
                match cellGet(cc) {
                    Cons(loc, r) -> {
                        let isNonScalar = match assocGet(st1.stLocSorts, loc) { Some("__nonscalar") -> true, _ -> false };
                        match (assocGet(stThenOut.stCells, loc), assocGet(stElseOut.stCells, loc)) {
                            (Some(vt), Some(ve)) if (vt != ve) ->
                                if (isNonScalar) cellSet(mergedCells, assocSet(cellGet(mergedCells), loc, "__unknown_nonscalar"))
                                else cellSet(mergedCells, assocSet(cellGet(mergedCells), loc, "(ite " + cs + " " + vt + " " + ve + ")")),
                            (Some(vt), Some(_)) ->
                                cellSet(mergedCells, assocSet(cellGet(mergedCells), loc, vt)),
                            _ -> (),
                        };
                        cellSet(cc, r)
                    },
                    Nil -> (),
                }
            };

            let allArrLocs = assocKeysUnique(st1.stArrMems);
            let mergedArrs = cellNew(st1.stArrMems);
            let ca = cellNew(allArrLocs);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(loc, r) -> {
                        let isNonScalar = match assocGet(st1.stLocSorts, loc) { Some("__nonscalar") -> true, _ -> false };
                        match (assocGet(stThenOut.stArrMems, loc), assocGet(stElseOut.stArrMems, loc)) {
                            (Some(mt), Some(me)) if (mt != me) ->
                                if (isNonScalar) cellSet(mergedArrs, assocSet(cellGet(mergedArrs), loc, "__nonscalar_arr"))
                                else cellSet(mergedArrs, assocSet(cellGet(mergedArrs), loc, "(ite " + cs + " " + mt + " " + me + ")")),
                            (Some(mt), Some(_)) ->
                                cellSet(mergedArrs, assocSet(cellGet(mergedArrs), loc, mt)),
                            _ -> (),
                        };
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            };

            // Propagate branch-local facts guarded by branch condition
            let baseLen = listLen(st1.stPath);
            let mergedPath = cellNew(st1.stPath);
            let addGuardedPrefix = (branchPath: List String, guardExpr: String) -> {
                let extraCnt = listLen(branchPath) - (baseLen + 1);
                let k = cellNew(0);
                let curP = cellNew(branchPath);
                while (cellGet(k) < extraCnt) {
                    match cellGet(curP) {
                        Cons(p, rp) -> {
                            cellSet(mergedPath, Cons("(=> " + guardExpr + " " + p + ")", cellGet(mergedPath)));
                            cellSet(curP, rp);
                            cellSet(k, cellGet(k) + 1)
                        },
                        Nil -> cellSet(k, extraCnt),
                    }
                }
            };
            addGuardedPrefix(stThenOut.stPath, cs);
            addGuardedPrefix(stElseOut.stPath, "(not " + cs + ")");

            let stMerged = MkSymState {
                stDecls: stElseOut.stDecls,
                stVars: st1.stVars,
                stCells: cellGet(mergedCells),
                stLocSorts: st1.stLocSorts,
                stArrLens: st1.stArrLens,
                stArrMems: cellGet(mergedArrs),
                stDataTags: stElseOut.stDataTags,
                stDataFields: stElseOut.stDataFields,
                stPath: cellGet(mergedPath),
                stUserVars: stElseOut.stUserVars,
            };
            let resVal = match (tv, ev) {
                (Some(ts), Some(es)) ->
                    if (ts == es) Some(ts)
                    else if (isPureSmtIteType(ctx, resTy)) Some("(ite " + cs + " " + ts + " " + es + ")")
                    else None,
                _ -> None,
            };
            (stMerged, resVal)
        },
        None -> {
            // Even when condition is unmodeled, verify BOTH branches so no obligations are missed!
            let (stT, _) = evalTerm(ctx, st1, th, emitObs);
            let (stE, _) = evalTerm(ctx, MkSymState {
                stDecls: stT.stDecls, stVars: st1.stVars,
                stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                stPath: st1.stPath, stUserVars: stT.stUserVars,
            }, el, emitObs);
            let stHavoc = havocLocs(ctx, MkSymState {
                stDecls: stE.stDecls, stVars: st1.stVars,
                stCells: st1.stCells, stLocSorts: st1.stLocSorts,
                stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                stPath: st1.stPath, stUserVars: stE.stUserVars,
            }, assocKeysUnique(st1.stCells), assocKeysUnique(st1.stArrMems), "if");
            (stHavoc, None)
        },
    }
}

def evalMatch(
    ctx: VerifyCtx,
    st: SymState,
    resTy: Type,
    scrut: TaggedTerm,
    arms: List CoreArm,
    emitObs: Bool
): (SymState, Option String) = {
    let (st1, scrutVal) = evalTerm(ctx, st, scrut, emitObs);
    let scrutTy = schemeBody(scrut.tscm);
    let declsAcc = cellNew(st1.stDecls);
    let uvarsAcc = cellNew(st1.stUserVars);
    let mergedPath = cellNew(st1.stPath);
    let curCells = cellNew(st1.stCells);
    let curArrMems = cellNew(st1.stArrMems);
    let prevNegs: Cell (List String) = cellNew(Nil);
    let hasUnknownPrev = cellNew(false);
    let armResultsRev: Cell (List (Option String, Option String)) = cellNew(Nil);
    let anyMut = cellNew(false);
    let cur = cellNew(arms);

    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(arm, rest) -> {
                let armBase = MkSymState {
                    stDecls: cellGet(declsAcc), stVars: st1.stVars,
                    stCells: cellGet(curCells), stLocSorts: st1.stLocSorts,
                    stArrLens: st1.stArrLens, stArrMems: cellGet(curArrMems),
                    stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                    stPath: listAppend(cellGet(prevNegs), st1.stPath),
                    stUserVars: cellGet(uvarsAcc),
                };
                let (stPat, patCondOpt) = bindPatternInSym(ctx, armBase, arm.caPat, scrutVal, scrutTy);
                let stAfterPat = match patCondOpt {
                    Some("true") -> stPat,
                    Some(pc) -> stWithPath(stPat, pc),
                    None -> stPat,
                };
                let armVars = bindPatEffectVars(arm.caPat, st1.stVars);
                let (stAfterGuard, guardCondOpt) = match arm.caGuard {
                    Some(g) -> {
                        let (sg, gv) = evalTerm(ctx, stAfterPat, g, emitObs);
                        // A3: If guard mutates any Cell/Array, propagate havoc to subsequent arms & match exit!
                        let gmc: Cell (List String) = cellNew(Nil);
                        let gma: Cell (List String) = cellNew(Nil);
                        let goc = cellNew(false);
                        scanEffectsInTerm(ctx, g, armVars, gmc, gma, goc);
                        if (cellGet(goc) || match (cellGet(gmc), cellGet(gma)) { (Nil, Nil) -> false, _ -> true }) {
                            cellSet(anyMut, true);
                            let hCells = if (cellGet(goc)) assocKeysUnique(cellGet(curCells)) else cellGet(gmc);
                            let hArrs = if (cellGet(goc)) assocKeysUnique(cellGet(curArrMems)) else cellGet(gma);
                            let stGuardHavoc = havocLocs(ctx, MkSymState {
                                stDecls: sg.stDecls, stVars: st1.stVars,
                                stCells: cellGet(curCells), stLocSorts: st1.stLocSorts,
                                stArrLens: st1.stArrLens, stArrMems: cellGet(curArrMems),
                                stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                                stPath: st1.stPath, stUserVars: sg.stUserVars,
                            }, hCells, hArrs, "mguard");
                            cellSet(declsAcc, stGuardHavoc.stDecls);
                            cellSet(curCells, stGuardHavoc.stCells);
                            cellSet(curArrMems, stGuardHavoc.stArrMems);
                            cellSet(hasUnknownPrev, true)
                        } else ();
                        match gv {
                            Some(gs) -> (stWithPath(sg, gs), Some(gs)),
                            None -> (sg, None),
                        }
                    },
                    None -> (stAfterPat, Some("true")),
                };
                let fullArmCond: Option String = match (patCondOpt, guardCondOpt) {
                    (Some("true"), Some(gc)) -> Some(gc),
                    (Some(pc), Some("true")) -> Some(pc),
                    (Some(pc), Some(gc)) -> Some("(and " + pc + " " + gc + ")"),
                    _ -> None,
                };
                let armPrePathLen = listLen(stAfterGuard.stPath);
                let (stBodyOut, bodyVal) = evalTerm(ctx, stAfterGuard, arm.caBody, emitObs);
                cellSet(declsAcc, stBodyOut.stDecls);
                cellSet(uvarsAcc, stBodyOut.stUserVars);
                // Propagate branch-local facts (e.g. `let` equalities & callee `ensures`) guarded by arm reach condition
                let extraCnt = listLen(stBodyOut.stPath) - armPrePathLen;
                if (extraCnt > 0 && !cellGet(hasUnknownPrev)) {
                    let reachCondOpt: Option String = match fullArmCond {
                        Some(fc) -> {
                            let rc = cellNew(fc);
                            let cn = cellNew(cellGet(prevNegs));
                            while (match cellGet(cn) { Nil -> false, _ -> true }) {
                                match cellGet(cn) {
                                    Cons(negC, rn) -> {
                                        if (cellGet(rc) == "true") cellSet(rc, negC)
                                        else cellSet(rc, "(and " + negC + " " + cellGet(rc) + ")");
                                        cellSet(cn, rn)
                                    },
                                    Nil -> (),
                                }
                            };
                            Some(cellGet(rc))
                        },
                        None -> None,
                    };
                    match reachCondOpt {
                        Some(rcond) -> {
                            let k = cellNew(0);
                            let cp = cellNew(stBodyOut.stPath);
                            while (cellGet(k) < extraCnt) {
                                match cellGet(cp) {
                                    Cons(p, rp) -> {
                                        let guarded = if (rcond == "true") p else "(=> " + rcond + " " + p + ")";
                                        cellSet(mergedPath, Cons(guarded, cellGet(mergedPath)));
                                        cellSet(cp, rp);
                                        cellSet(k, cellGet(k) + 1)
                                    },
                                    Nil -> cellSet(k, extraCnt),
                                }
                            }
                        },
                        None -> (),
                    }
                } else ();
                // Check if arm modified cells or arrays
                let mc: Cell (List String) = cellNew(Nil);
                let ma: Cell (List String) = cellNew(Nil);
                let oc = cellNew(false);
                let armVars = bindPatEffectVars(arm.caPat, st1.stVars);
                match arm.caGuard { Some(g) -> scanEffectsInTerm(ctx, g, armVars, mc, ma, oc), None -> () };
                scanEffectsInTerm(ctx, arm.caBody, armVars, mc, ma, oc);
                if (cellGet(oc) || match (cellGet(mc), cellGet(ma)) { (Nil, Nil) -> false, _ -> true }) {
                    cellSet(anyMut, true)
                } else ();
                cellSet(armResultsRev, Cons((fullArmCond, bodyVal), cellGet(armResultsRev)));
                match fullArmCond {
                    Some("true") -> (),
                    Some(fc) -> cellSet(prevNegs, Cons("(not " + fc + ")", cellGet(prevNegs))),
                    None -> cellSet(hasUnknownPrev, true),
                };
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };

    // Fold arm values into nested `(ite cond_i val_i ...)` ONLY for pure SMT scalar/enum types
    let canIte = isPureSmtIteType(ctx, resTy);
    let resVal: Cell (Option String) = cellNew(None);
    let firstArm = cellNew(true);
    let cr = cellNew(cellGet(armResultsRev));
    while (match cellGet(cr) { Nil -> false, _ -> true }) {
        match cellGet(cr) {
            Cons((condOpt, valOpt), r) -> {
                if (cellGet(firstArm)) {
                    cellSet(resVal, valOpt);
                    cellSet(firstArm, false)
                } else {
                    cellSet(resVal, match (condOpt, valOpt, cellGet(resVal)) {
                        (Some("true"), Some(v), _) -> Some(v),
                        (Some(c), Some(v), Some(elseV)) ->
                            if (v == elseV) Some(v)
                            else if (canIte) Some("(ite " + c + " " + v + " " + elseV + ")")
                            else None,
                        _ -> None,
                    })
                };
                cellSet(cr, r)
            },
            Nil -> (),
        }
    };

    let stBaseOut = MkSymState {
        stDecls: cellGet(declsAcc), stVars: st1.stVars,
        stCells: st1.stCells, stLocSorts: st1.stLocSorts,
        stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
        stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
        stPath: cellGet(mergedPath), stUserVars: cellGet(uvarsAcc),
    };
    let stOut =
        if (cellGet(anyMut)) havocLocs(ctx, stBaseOut, assocKeysUnique(st1.stCells), assocKeysUnique(st1.stArrMems), "match")
        else stBaseOut;
    (stOut, cellGet(resVal))
}

def evalBlock(ctx: VerifyCtx, st: SymState, stmts: List TaggedTerm, emitObs: Bool): (SymState, Option String) =
    match stmts {
        Nil -> (st, Some("#x00000000")),
        Cons(last, Nil) -> evalTerm(ctx, st, last, emitObs),
        Cons(h, r) -> {
            let (st1, _) = evalTerm(ctx, st, h, emitObs);
            evalBlock(ctx, st1, r, emitObs)
        },
    }

def evalArgs(ctx: VerifyCtx, st: SymState, args: List TaggedTerm, emitObs: Bool): (SymState, List (Option String)) = {
    let cur = cellNew(args);
    let curSt = cellNew(st);
    let valsRev: Cell (List (Option String)) = cellNew(Nil);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                let (st1, av) = evalTerm(ctx, cellGet(curSt), a, emitObs);
                cellSet(curSt, st1);
                cellSet(valsRev, Cons(av, cellGet(valsRev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (cellGet(curSt), listRev(cellGet(valsRev)))
}

def typeContainsMutableRec(ctx: VerifyCtx, ty: Type, visited: List String): Bool =
    if (isCellType(ty) || isMutArrayType(ty)) {
        true
    } else match ty {
        TyArr(_, _, _) -> true,
        TyTuple(ts) -> {
            let found = cellNew(false);
            let cur = cellNew(ts);
            while (!cellGet(found) && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(t, r) -> {
                        if (typeContainsMutableRec(ctx, t, visited)) cellSet(found, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(found)
        },
        _ -> {
            let (headOpt, targs) = adtHeadNameAndArgs(ty);
            let found = cellNew(false);
            let ca = cellNew(targs);
            while (!cellGet(found) && match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(ta, ra) -> {
                        if (typeContainsMutableRec(ctx, ta, visited)) cellSet(found, true) else ();
                        cellSet(ca, ra)
                    },
                    Nil -> (),
                }
            };
            if (cellGet(found)) {
                true
            } else match headOpt {
                Some(adtName) ->
                    if (listHasStr(visited, adtName)) {
                        false
                    } else match strMapGet(ctx.vcAdtReg, adtName) {
                        Some(info) -> {
                            let nextVis = Cons(adtName, visited);
                            let cv = cellNew(info.variants);
                            while (!cellGet(found) && match cellGet(cv) { Nil -> false, _ -> true }) {
                                match cellGet(cv) {
                                    Cons(v, rv) -> {
                                        let cf = cellNew(v.fieldTypes);
                                        while (!cellGet(found) && match cellGet(cf) { Nil -> false, _ -> true }) {
                                            match cellGet(cf) {
                                                Cons(ft, rf) -> {
                                                    if (typeContainsMutableRec(ctx, ft, nextVis)) cellSet(found, true) else ();
                                                    cellSet(cf, rf)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        cellSet(cv, rv)
                                    },
                                    Nil -> (),
                                }
                            };
                            cellGet(found)
                        },
                        None -> false,
                    },
                None -> false,
            }
        },
    }

def collectMutLocsFromSym(
    st: SymState,
    sym: String,
    cellsOut: Cell (List String),
    arrsOut: Cell (List String),
    unknownOut: Cell Bool,
    visited: List String
): Void =
    if (listHasStr(visited, sym)) {
        ()
    } else match assocGet(st.stCells, sym) {
        Some(innerVal) -> {
            cellSet(cellsOut, addUnique(cellGet(cellsOut), sym));
            match assocGet(st.stLocSorts, sym) {
                Some("__nonscalar") ->
                    if (innerVal == "__unknown_nonscalar") cellSet(unknownOut, true)
                    else collectMutLocsFromSym(st, innerVal, cellsOut, arrsOut, unknownOut, Cons(sym, visited)),
                _ -> (),
            }
        },
        None -> match assocGet(st.stArrMems, sym) {
            Some(memVal) -> {
                cellSet(arrsOut, addUnique(cellGet(arrsOut), sym));
                if (memVal == "__nonscalar_arr") cellSet(unknownOut, true) else ()
            },
            None -> match assocGetFields(st.stDataFields, sym) {
                Some(fields) -> {
                    let nextVis = Cons(sym, visited);
                    let cf = cellNew(fields);
                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                        match cellGet(cf) {
                            Cons(Some(fsym), r) -> {
                                collectMutLocsFromSym(st, fsym, cellsOut, arrsOut, unknownOut, nextVis);
                                cellSet(cf, r)
                            },
                            Cons(None, r) -> {
                                cellSet(unknownOut, true);
                                cellSet(cf, r)
                            },
                            Nil -> (),
                        }
                    }
                },
                None -> cellSet(unknownOut, true),
            },
        },
    }

def isSideEffectFreeVerifyList(specs: StrMap FnSpec, externs: StrMap ExternDef, ts: List TaggedTerm, visited: List String): Bool = match ts {
    Nil -> true,
    Cons(t, r) -> if (isSideEffectFreeVerifyTerm(specs, externs, t, visited)) isSideEffectFreeVerifyList(specs, externs, r, visited) else false,
}

def isSideEffectFreeVerifyArms(specs: StrMap FnSpec, externs: StrMap ExternDef, arms: List CoreArm, visited: List String): Bool = match arms {
    Nil -> true,
    Cons(a, r) -> {
        let gOk = match a.caGuard { Some(g) -> isSideEffectFreeVerifyTerm(specs, externs, g, visited), None -> true };
        if (gOk && isSideEffectFreeVerifyTerm(specs, externs, a.caBody, visited)) isSideEffectFreeVerifyArms(specs, externs, r, visited)
        else false
    },
}

def isSideEffectFreeVerifyTerm(specs: StrMap FnSpec, externs: StrMap ExternDef, tm: TaggedTerm, visited: List String): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(_) -> true,
    TmGlobalVar(_) -> true,
    TmTuple(es) -> isSideEffectFreeVerifyList(specs, externs, es, visited),
    TmBlock(es) -> isSideEffectFreeVerifyList(specs, externs, es, visited),
    TmMakeData(_, _, fs, _, _) -> isSideEffectFreeVerifyList(specs, externs, fs, visited),
    TmBin(_, a, b) -> isSideEffectFreeVerifyTerm(specs, externs, a, visited) && isSideEffectFreeVerifyTerm(specs, externs, b, visited),
    TmUn(_, a) -> isSideEffectFreeVerifyTerm(specs, externs, a, visited),
    TmLet(_, v, b) -> isSideEffectFreeVerifyTerm(specs, externs, v, visited) && isSideEffectFreeVerifyTerm(specs, externs, b, visited),
    TmIf(c, t, e) ->
        isSideEffectFreeVerifyTerm(specs, externs, c, visited)
        && isSideEffectFreeVerifyTerm(specs, externs, t, visited)
        && isSideEffectFreeVerifyTerm(specs, externs, e, visited),
    TmMatch(s, arms) -> isSideEffectFreeVerifyTerm(specs, externs, s, visited) && isSideEffectFreeVerifyArms(specs, externs, arms, visited),
    TmGetTag(e) -> isSideEffectFreeVerifyTerm(specs, externs, e, visited),
    TmApplyDir(vd, args) -> {
        let nm = vd.vname;
        if (!isSideEffectFreeVerifyList(specs, externs, args, visited)) false
        else if (strMapContains(externs, nm)) false
        else if (!strStartsWith(nm, "__gs_") && strMapContains(specs, nm)) {
            if (listHasStr(visited, nm)) false
            else match strMapGet(specs, nm) {
                Some(sp) -> isSideEffectFreeVerifyTerm(specs, externs, sp.fsBody, Cons(nm, visited)),
                None -> false,
            }
        } else if (
            nm == "cellGet" || nm == "arrayLen" || nm == "immArrayLen"
            || nm == "arrayGet" || nm == "immArrayGet"
            || nm == "intToI64" || nm == "i64ToInt"
            || nm == "__gs_requires" || nm == "__gs_ensures" || nm == "__gs_invariant" || nm == "__gs_decreases"
        ) true
        else false
    },
    _ -> false,
}

def evalApplyDir(
    ctx: VerifyCtx,
    st: SymState,
    sp: Span,
    retTy: Type,
    nm: String,
    args: List TaggedTerm,
    emitObs: Bool
): (SymState, Option String) =
    if (strMapContains(ctx.vcExterns, nm)) {
        // Extern declaration: never match built-in intrinsic semantics; conservatively havoc all mutable heap
        let (st1, _) = evalArgs(ctx, st, args, emitObs);
        let stOut = havocLocs(ctx, st1, assocKeysUnique(st1.stCells), assocKeysUnique(st1.stArrMems), "ext");
        (stOut, None)
    } else if (!strStartsWith(nm, "__gs_") && strMapContains(ctx.vcSpecs, nm)) {
        evalUserOrUnknownCallDir(ctx, st, sp, retTy, nm, args, emitObs)
    } else if (nm == "cellNew") {
        match args {
            Cons(initT, _) -> {
                let (st1, initV) = evalTerm(ctx, st, initT, emitObs);
                let loc = freshLoc(ctx, "cell");
                let eSort = elemSortForContainer(ctx, retTy);
                let (decls2, initSym) =
                    if (eSort == "__nonscalar") {
                        match initV {
                            Some(iv) -> (st1.stDecls, iv),
                            None -> (st1.stDecls, "__unknown_nonscalar"),
                        }
                    } else match initV {
                        Some(iv) -> (st1.stDecls, iv),
                        None -> {
                            let fs = freshSym(ctx, "cell_init");
                            (Cons("(declare-const " + fs + " " + eSort + ")", st1.stDecls), fs)
                        },
                    };
                let st2 = MkSymState {
                    stDecls: decls2,
                    stVars: st1.stVars,
                    stCells: assocSet(st1.stCells, loc, initSym),
                    stLocSorts: assocSet(st1.stLocSorts, loc, eSort),
                    stArrLens: st1.stArrLens, stArrMems: st1.stArrMems,
                    stDataTags: st1.stDataTags, stDataFields: st1.stDataFields,
                    stPath: st1.stPath, stUserVars: st1.stUserVars,
                };
                (st2, Some(loc))
            },
            Nil -> (st, None),
        }
    } else if (nm == "arrayNew" || nm == "arrayNewZeroed") {
        match args {
            Cons(lenT, restA) -> {
                let (st1, lenV) = evalTerm(ctx, st, lenT, emitObs);
                let (st2, initV) = match restA {
                    Cons(initT, _) -> evalTerm(ctx, st1, initT, emitObs),
                    Nil -> (st1, zeroValForElemTy(ctx, retTy)),
                };
                let loc = freshLoc(ctx, "arr");
                let eSort = elemSortForContainer(ctx, retTy);
                let (decls2, lenSym) = match lenV {
                    Some(ls) -> {
                        if (emitObs && ctx.vcCheckImplicit) {
                            dischargeObligation(
                                ctx, st2, "bounds", sp,
                                "array length may be negative in `" + ctx.vcCurFn + "`",
                                "(bvsge " + ls + " #x00000000)", None
                            )
                        } else ();
                        (st2.stDecls, ls)
                    },
                    None -> {
                        if (emitObs && ctx.vcCheckImplicit) {
                            recordUnknown(
                                ctx, "bounds", sp,
                                "array length non-negativity could not be verified in `" + ctx.vcCurFn + "`",
                                "array length expression is not modeled in SMT"
                            )
                        } else ();
                        let fl = freshSym(ctx, "arr_len");
                        (Cons("(declare-const " + fl + " (_ BitVec 32))", st2.stDecls), fl)
                    },
                };
                let (decls3, memExpr) =
                    if (eSort == "__nonscalar") (decls2, "__nonscalar_arr")
                    else match initV {
                        Some(iv) -> (decls2, "((as const (Array (_ BitVec 32) " + eSort + ")) " + iv + ")"),
                        None -> {
                            let ms = freshSym(ctx, "arr_mem");
                            (Cons("(declare-const " + ms + " (Array (_ BitVec 32) " + eSort + "))", decls2), ms)
                        },
                    };
                let st3 = MkSymState {
                    stDecls: decls3,
                    stVars: st2.stVars,
                    stCells: st2.stCells,
                    stLocSorts: assocSet(st2.stLocSorts, loc, eSort),
                    stArrLens: assocSet(st2.stArrLens, loc, lenSym),
                    stArrMems: assocSet(st2.stArrMems, loc, memExpr),
                    stDataTags: st2.stDataTags, stDataFields: st2.stDataFields,
                    stPath: Cons("(bvsge " + lenSym + " #x00000000)", st2.stPath),
                    stUserVars: st2.stUserVars,
                };
                (st3, Some(loc))
            },
            Nil -> (st, None),
        }
    } else if (nm == "parTabulate") {
        match args {
            Cons(lenT, _) -> {
                let (st1, lenV) = evalTerm(ctx, st, lenT, emitObs);
                match lenV {
                    Some(ls) ->
                        if (emitObs && ctx.vcCheckImplicit) {
                            dischargeObligation(
                                ctx, st1, "bounds", sp,
                                "array length may be negative in `" + ctx.vcCurFn + "`",
                                "(bvsge " + ls + " #x00000000)", None
                            )
                        } else (),
                    None ->
                        if (emitObs && ctx.vcCheckImplicit) {
                            recordUnknown(
                                ctx, "bounds", sp,
                                "array length non-negativity could not be verified in `" + ctx.vcCurFn + "`",
                                "array length expression is not modeled in SMT"
                            )
                        } else (),
                };
                (st1, None)
            },
            Nil -> (st, None),
        }
    } else if (nm == "cellGet") {
        match args {
            Cons(cArg, _) -> {
                let (st1, cv) = evalTerm(ctx, st, cArg, emitObs);
                match cv {
                    Some(loc) -> match assocGet(st1.stCells, loc) {
                        Some("__unknown_nonscalar") -> (st1, None),
                        other -> (st1, other),
                    },
                    None -> (st1, None),
                }
            },
            Nil -> (st, None),
        }
    } else if (nm == "cellSet") {
        match args {
            Cons(cArg, Cons(vArg, _)) -> {
                let (st1, cv) = evalTerm(ctx, st, cArg, emitObs);
                let (st2, vv) = evalTerm(ctx, st1, vArg, emitObs);
                match cv {
                    Some(loc) -> match assocGet(st2.stCells, loc) {
                        Some(_) -> {
                            let isNonScalar = match assocGet(st2.stLocSorts, loc) { Some("__nonscalar") -> true, _ -> false };
                            match vv {
                                Some(vs) -> {
                                    let st3 = MkSymState {
                                        stDecls: st2.stDecls, stVars: st2.stVars,
                                        stCells: assocSet(st2.stCells, loc, vs),
                                        stLocSorts: st2.stLocSorts,
                                        stArrLens: st2.stArrLens, stArrMems: st2.stArrMems,
                                        stDataTags: st2.stDataTags, stDataFields: st2.stDataFields,
                                        stPath: st2.stPath, stUserVars: st2.stUserVars,
                                    };
                                    (st3, Some("#x00000000"))
                                },
                                None ->
                                    if (isNonScalar) {
                                        let st3 = MkSymState {
                                            stDecls: st2.stDecls, stVars: st2.stVars,
                                            stCells: assocSet(st2.stCells, loc, "__unknown_nonscalar"),
                                            stLocSorts: st2.stLocSorts,
                                            stArrLens: st2.stArrLens, stArrMems: st2.stArrMems,
                                            stDataTags: st2.stDataTags, stDataFields: st2.stDataFields,
                                            stPath: st2.stPath, stUserVars: st2.stUserVars,
                                        };
                                        (st3, Some("#x00000000"))
                                    } else (havocLocs(ctx, st2, [loc], Nil, "cset"), Some("#x00000000")),
                            }
                        },
                        None -> (havocLocs(ctx, st2, assocKeysUnique(st2.stCells), Nil, "cset"), Some("#x00000000")),
                    },
                    None -> (havocLocs(ctx, st2, assocKeysUnique(st2.stCells), Nil, "cset"), Some("#x00000000")),
                }
            },
            _ -> (st, Some("#x00000000")),
        }
    } else if (nm == "arrayLen" || nm == "immArrayLen") {
        match args {
            Cons(aArg, _) -> {
                let (st1, av) = evalTerm(ctx, st, aArg, emitObs);
                match av {
                    Some(loc) -> (st1, assocGet(st1.stArrLens, loc)),
                    None -> (st1, None),
                }
            },
            Nil -> (st, None),
        }
    } else if (nm == "arrayGet" || nm == "immArrayGet") {
        match args {
            Cons(aArg, Cons(idxArg, _)) -> {
                let (st1, av) = evalTerm(ctx, st, aArg, emitObs);
                let (st2, iv) = evalTerm(ctx, st1, idxArg, emitObs);
                let arrLabel = match aArg.tnode { TmVar(an) -> an, _ -> "array" };
                match (av, iv) {
                    (Some(loc), Some(idxS)) -> {
                        if (emitObs && ctx.vcCheckImplicit) {
                            match assocGet(st2.stArrLens, loc) {
                                Some(lenS) -> dischargeObligation(
                                    ctx, st2, "bounds", sp,
                                    "array index out of bounds on `" + arrLabel + "` in `" + ctx.vcCurFn + "`",
                                    "(and (bvsge " + idxS + " #x00000000) (bvslt " + idxS + " " + lenS + "))",
                                    None
                                ),
                                None -> recordUnknown(ctx, "bounds", sp, "array bounds on `" + arrLabel + "` could not be verified", "array length is unknown"),
                            }
                        } else ();
                        match assocGet(st2.stArrMems, loc) {
                            Some("__nonscalar_arr") -> (st2, None),
                            Some(memS) -> (st2, Some("(select " + memS + " " + idxS + ")")),
                            None -> (st2, None),
                        }
                    },
                _ -> {
                        if (emitObs && ctx.vcCheckImplicit) {
                            recordUnknown(ctx, "bounds", sp, "array index bounds on `" + arrLabel + "` could not be verified", "array or index expression is not modeled in SMT")
                        } else ();
                        (st2, None)
                    },
                }
            },
            _ -> (st, None),
        }
    } else if (nm == "arraySet") {
        match args {
            Cons(aArg, Cons(idxArg, Cons(valArg, _))) -> {
                let (st1, av) = evalTerm(ctx, st, aArg, emitObs);
                let (st2, iv) = evalTerm(ctx, st1, idxArg, emitObs);
                let (st3, vv) = evalTerm(ctx, st2, valArg, emitObs);
                let arrLabel = match aArg.tnode { TmVar(an) -> an, _ -> "array" };
                match (av, iv) {
                    (Some(loc), Some(idxS)) -> {
                        if (emitObs && ctx.vcCheckImplicit) {
                            match assocGet(st3.stArrLens, loc) {
                                Some(lenS) -> dischargeObligation(
                                    ctx, st3, "bounds", sp,
                                    "array index out of bounds on `" + arrLabel + "` in `" + ctx.vcCurFn + "`",
                                    "(and (bvsge " + idxS + " #x00000000) (bvslt " + idxS + " " + lenS + "))",
                                    None
                                ),
                                None -> recordUnknown(ctx, "bounds", sp, "array bounds on `" + arrLabel + "` could not be verified", "array length is unknown"),
                            }
                        } else ();
                        match (assocGet(st3.stArrMems, loc), vv) {
                            (Some("__nonscalar_arr"), _) -> (st3, Some("#x00000000")),
                            (Some(memS), Some(valS)) -> {
                                let st4 = MkSymState {
                                    stDecls: st3.stDecls, stVars: st3.stVars,
                                    stCells: st3.stCells, stLocSorts: st3.stLocSorts,
                                    stArrLens: st3.stArrLens,
                                    stArrMems: assocSet(st3.stArrMems, loc, "(store " + memS + " " + idxS + " " + valS + ")"),
                                    stDataTags: st3.stDataTags, stDataFields: st3.stDataFields,
                                    stPath: st3.stPath, stUserVars: st3.stUserVars,
                                };
                                (st4, Some("#x00000000"))
                            },
                            (Some(_), None) -> (havocLocs(ctx, st3, Nil, [loc], "aset"), Some("#x00000000")),
                            (None, _) -> (havocLocs(ctx, st3, Nil, assocKeysUnique(st3.stArrMems), "aset"), Some("#x00000000")),
                        }
                    },
                _ -> {
                        if (emitObs && ctx.vcCheckImplicit) {
                            recordUnknown(ctx, "bounds", sp, "array index bounds on `" + arrLabel + "` could not be verified", "array or index expression is not modeled in SMT")
                        } else ();
                        (havocLocs(ctx, st3, Nil, assocKeysUnique(st3.stArrMems), "aset"), Some("#x00000000"))
                    },
                }
            },
            _ -> (st, Some("#x00000000")),
        }
    } else if (nm == "assert") {
        match args {
            Cons(cArg, _) ->
                if (!isSideEffectFreeVerifyTerm(ctx.vcSpecs, ctx.vcExterns, cArg, Nil)) {
                    if (emitObs) {
                        recordUnknown(
                            ctx, "assert", sp,
                            "side-effecting expression inside `assert(...)` cannot be statically verified in `" + ctx.vcCurFn + "`",
                            "move mutations (`cellSet`/`arraySet`/allocations) outside `assert(...)`; `--contracts=erase` elides `assert`"
                        )
                    } else ();
                    (havocLocs(ctx, st, assocKeysUnique(st.stCells), assocKeysUnique(st.stArrMems), "impure_assert"), Some("#x00000000"))
                } else {
                    let (st1, cv) = evalTerm(ctx, st, cArg, emitObs);
                    if (emitObs) {
                        dischargeOptGoal(
                            ctx, st1, "assert", sp,
                            "assertion may fail in `" + ctx.vcCurFn + "`",
                            cv, None
                        )
                    } else ();
                    match cv {
                        Some(cs) -> (stWithPath(st1, cs), Some("#x00000000")),
                        None -> (st1, Some("#x00000000")),
                    }
                },
            Nil -> (st, Some("#x00000000")),
        }
    } else if (nm == "assume") {
        match args {
            Cons(cArg, _) ->
                if (!isSideEffectFreeVerifyTerm(ctx.vcSpecs, ctx.vcExterns, cArg, Nil)) {
                    if (emitObs) {
                        recordUnknown(
                            ctx, "assume", sp,
                            "side-effecting expression inside `assume(...)` cannot be statically verified in `" + ctx.vcCurFn + "`",
                            "move mutations (`cellSet`/`arraySet`/allocations) outside `assume(...)`"
                        )
                    } else ();
                    (havocLocs(ctx, st, assocKeysUnique(st.stCells), assocKeysUnique(st.stArrMems), "impure_assume"), Some("#x00000000"))
                } else {
                    let (st1, cv) = evalTerm(ctx, st, cArg, false);
                    match cv {
                        Some(cs) -> (stWithPath(st1, cs), Some("#x00000000")),
                        None -> (st1, Some("#x00000000")),
                    }
                },
            Nil -> (st, Some("#x00000000")),
        }
    } else if (nm == "intToI64") {
        match args {
            Cons(a0, _) -> {
                let (st1, av) = evalTerm(ctx, st, a0, emitObs);
                match av {
                    Some(s) -> (st1, Some("((_ sign_extend 32) " + s + ")")),
                    None -> (st1, None),
                }
            },
            Nil -> (st, None),
        }
    } else if (nm == "i64ToInt") {
        match args {
            Cons(a0, _) -> {
                let (st1, av) = evalTerm(ctx, st, a0, emitObs);
                match av {
                    Some(s) -> (st1, Some("((_ extract 31 0) " + s + ")")),
                    None -> (st1, None),
                }
            },
            Nil -> (st, None),
        }
    } else if (nm == "__gs_requires" || nm == "__gs_ensures" || nm == "__gs_invariant" || nm == "__gs_decreases") {
        (st, Some("#x00000000"))
    } else {
        evalUserOrUnknownCallDir(ctx, st, sp, retTy, nm, args, emitObs)
    }

def evalUserOrUnknownCallDir(
    ctx: VerifyCtx,
    st: SymState,
    sp: Span,
    retTy: Type,
    nm: String,
    args: List TaggedTerm,
    emitObs: Bool
): (SymState, Option String) = {
        // Modular user function call:
        // 1. Evaluate arguments
        // 2. Build ISOLATED callee variable map (never inherit caller's local names!)
        // 3. Check callee `requires`
        // 4. Check self or mutual recursion `decreases` (via call graph SCC)
        // 5. Conservatively havoc any passed Cell / MutArray arguments
        // 6. Assume callee `ensures` on fresh return symbol
        let (st1, argVals) = evalArgs(ctx, st, args, emitObs);
        let passedCellLocs: Cell (List String) = cellNew(Nil);
        let passedMutArrLocs: Cell (List String) = cellNew(Nil);
        let unknownMutContainer = cellNew(false);
        match strMapGet(ctx.vcSpecs, nm) {
            Some(callee) -> {
                let calleeVars: Cell (List (String, String)) = cellNew(Nil);
                let seenMutLocs: Cell (List String) = cellNew(Nil);
                let seenImmLocs: Cell (List String) = cellNew(Nil);
                let hasMutAlias = cellNew(false);
                let cp = cellNew(callee.fsParams);
                let ca = cellNew(argVals);
                let caTerms = cellNew(args);
                while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                    match (cellGet(cp), cellGet(ca), cellGet(caTerms)) {
                        (Cons(pvd, rp), Cons(avOpt, ra), Cons(at, rat)) -> {
                            let pty = schemeBody(pvd.vscm);
                            let isMutParam = isCellType(pty) || isMutArrayType(pty);
                            let isImmArrParam = isArrayType(pty) && !isMutArrayType(pty);
                            let hasNestedMut = !isMutParam && typeContainsMutableRec(ctx, pty, Nil);
                            match avOpt {
                                Some(asmt) -> {
                                    cellSet(calleeVars, assocSet(cellGet(calleeVars), pvd.vname, asmt));
                                    if (isMutParam) {
                                        let knownLoc =
                                            if (isCellType(pty)) match assocGet(st1.stCells, asmt) { Some(_) -> true, None -> false }
                                            else match assocGet(st1.stArrMems, asmt) { Some(_) -> true, None -> false };
                                        if (!knownLoc) {
                                            cellSet(unknownMutContainer, true);
                                            cellSet(hasMutAlias, true)
                                        } else {
                                            if (listHasStr(cellGet(seenMutLocs), asmt) || listHasStr(cellGet(seenImmLocs), asmt)) {
                                                cellSet(hasMutAlias, true)
                                            } else {
                                                cellSet(seenMutLocs, Cons(asmt, cellGet(seenMutLocs)))
                                            };
                                            let eTy = elemTypeOf(pty);
                                            if (isCellType(pty)) {
                                                cellSet(passedCellLocs, addUnique(cellGet(passedCellLocs), asmt));
                                                if (typeContainsMutableRec(ctx, eTy, Nil) || isArrayType(eTy)) {
                                                    match assocGet(st1.stCells, asmt) {
                                                        Some("__unknown_nonscalar") -> {
                                                            cellSet(unknownMutContainer, true);
                                                            cellSet(hasMutAlias, true)
                                                        },
                                                        Some(innerSym) -> {
                                                            let embCells: Cell (List String) = cellNew(Nil);
                                                            let embArrs: Cell (List String) = cellNew(Nil);
                                                            collectMutLocsFromSym(st1, innerSym, embCells, embArrs, unknownMutContainer, [asmt]);
                                                            let cec = cellNew(cellGet(embCells));
                                                            while (match cellGet(cec) { Nil -> false, _ -> true }) {
                                                                match cellGet(cec) {
                                                                    Cons(cloc, r) -> {
                                                                        if (listHasStr(cellGet(seenMutLocs), cloc) || listHasStr(cellGet(seenImmLocs), cloc)) {
                                                                            cellSet(hasMutAlias, true)
                                                                        } else {
                                                                            cellSet(seenMutLocs, Cons(cloc, cellGet(seenMutLocs)))
                                                                        };
                                                                        cellSet(passedCellLocs, addUnique(cellGet(passedCellLocs), cloc));
                                                                        cellSet(cec, r)
                                                                    },
                                                                    Nil -> (),
                                                                }
                                                            };
                                                            let cea = cellNew(cellGet(embArrs));
                                                            while (match cellGet(cea) { Nil -> false, _ -> true }) {
                                                                match cellGet(cea) {
                                                                    Cons(aloc, r) -> {
                                                                        if (listHasStr(cellGet(seenMutLocs), aloc) || listHasStr(cellGet(seenImmLocs), aloc)) {
                                                                            cellSet(hasMutAlias, true)
                                                                        } else {
                                                                            cellSet(seenMutLocs, Cons(aloc, cellGet(seenMutLocs)))
                                                                        };
                                                                        cellSet(passedMutArrLocs, addUnique(cellGet(passedMutArrLocs), aloc));
                                                                        cellSet(cea, r)
                                                                    },
                                                                    Nil -> (),
                                                                }
                                                            }
                                                        },
                                                        None -> {
                                                            cellSet(unknownMutContainer, true);
                                                            cellSet(hasMutAlias, true)
                                                        },
                                                    }
                                                } else ()
                                            } else {
                                                cellSet(passedMutArrLocs, addUnique(cellGet(passedMutArrLocs), asmt));
                                                if (typeContainsMutableRec(ctx, eTy, Nil) || isArrayType(eTy)) {
                                                    cellSet(unknownMutContainer, true);
                                                    cellSet(hasMutAlias, true)
                                                } else ()
                                            }
                                        }
                                    } else if (hasNestedMut) {
                                        let embCells: Cell (List String) = cellNew(Nil);
                                        let embArrs: Cell (List String) = cellNew(Nil);
                                        collectMutLocsFromSym(st1, asmt, embCells, embArrs, unknownMutContainer, Nil);
                                        let cec = cellNew(cellGet(embCells));
                                        while (match cellGet(cec) { Nil -> false, _ -> true }) {
                                            match cellGet(cec) {
                                                Cons(cloc, r) -> {
                                                    if (listHasStr(cellGet(seenMutLocs), cloc) || listHasStr(cellGet(seenImmLocs), cloc)) {
                                                        cellSet(hasMutAlias, true)
                                                    } else {
                                                        cellSet(seenMutLocs, Cons(cloc, cellGet(seenMutLocs)))
                                                    };
                                                    cellSet(passedCellLocs, addUnique(cellGet(passedCellLocs), cloc));
                                                    cellSet(cec, r)
                                                },
                                                Nil -> (),
                                            }
                                        };
                                        let cea = cellNew(cellGet(embArrs));
                                        while (match cellGet(cea) { Nil -> false, _ -> true }) {
                                            match cellGet(cea) {
                                                Cons(aloc, r) -> {
                                                    if (listHasStr(cellGet(seenMutLocs), aloc) || listHasStr(cellGet(seenImmLocs), aloc)) {
                                                        cellSet(hasMutAlias, true)
                                                    } else {
                                                        cellSet(seenMutLocs, Cons(aloc, cellGet(seenMutLocs)))
                                                    };
                                                    cellSet(passedMutArrLocs, addUnique(cellGet(passedMutArrLocs), aloc));
                                                    cellSet(cea, r)
                                                },
                                                Nil -> (),
                                            }
                                        }
                                    } else if (isImmArrParam) {
                                        match assocGet(st1.stArrLens, asmt) {
                                            Some(_) -> {
                                                if (listHasStr(cellGet(seenMutLocs), asmt)) cellSet(hasMutAlias, true)
                                                else cellSet(seenImmLocs, Cons(asmt, cellGet(seenImmLocs)));
                                                if (typeContainsMutableRec(ctx, elemTypeOf(pty), Nil)) {
                                                    cellSet(unknownMutContainer, true);
                                                    cellSet(hasMutAlias, true)
                                                } else ()
                                            },
                                            None -> cellSet(hasMutAlias, true),
                                        }
                                    } else ()
                                },
                                None ->
                                    if (isMutParam || hasNestedMut) {
                                        cellSet(unknownMutContainer, true);
                                        cellSet(hasMutAlias, true)
                                    } else (),
                            };
                            cellSet(cp, rp);
                            cellSet(ca, ra);
                            cellSet(caTerms, rat)
                        },
                        _ -> (),
                    }
                };
                if (cellGet(unknownMutContainer)) {
                    cellSet(hasMutAlias, true)
                } else ();
                if (emitObs && cellGet(hasMutAlias)) {
                    recordFailed(
                        ctx, "aliasing", sp,
                        "mutable arguments may alias at call to `" + nm + "` in `" + ctx.vcCurFn + "`",
                        Some("pass distinct `Cell`/`MutArray` references; callee contracts assume non-aliasing mutable parameters")
                    )
                } else ();
                let calleeSt = MkSymState {
                    stDecls: st1.stDecls,
                    stVars: cellGet(calleeVars),
                    stCells: st1.stCells,
                    stLocSorts: st1.stLocSorts,
                    stArrLens: st1.stArrLens,
                    stArrMems: st1.stArrMems,
                    stDataTags: st1.stDataTags,
                    stDataFields: st1.stDataFields,
                    stPath: st1.stPath,
                    stUserVars: st1.stUserVars,
                };
                // Check callee preconditions
                if (emitObs) {
                    let cr = cellNew(callee.fsRequires);
                    while (match cellGet(cr) { Nil -> false, _ -> true }) {
                        match cellGet(cr) {
                            Cons((_, reqTerm), rr) -> {
                                let (stReq, rv) = evalTerm(ctx, calleeSt, reqTerm, false);
                                dischargeOptGoal(
                                    ctx, stReq, "requires", sp,
                                    "precondition of `" + nm + "` may not hold at call site in `" + ctx.vcCurFn + "`",
                                    rv, None
                                );
                                cellSet(cr, rr)
                            },
                            Nil -> (),
                        }
                    }
                } else ();
                // Check self-recursion OR mutual-recursion termination measure (`decreases`)
                let isSameScc = nm == ctx.vcCurFn || canReachFn(ctx.vcCallGraph, nm, ctx.vcCurFn);
                if (emitObs && isSameScc) {
                    match (ctx.vcCurDecExpr, ctx.vcCurDecVal) {
                        (Some(_), Some(curVal)) -> match callee.fsDecreases {
                            Some((_, calleeDecExpr)) -> {
                                let (stDec, nextValOpt) = evalTerm(ctx, calleeSt, calleeDecExpr, false);
                                let decZero = bvZero(typeBitWidth(schemeBody(calleeDecExpr.tscm)));
                                let decGoal = match nextValOpt {
                                    Some(nextVal) -> Some("(and (bvsge " + curVal + " " + decZero + ") (bvslt " + nextVal + " " + curVal + "))"),
                                    None -> None,
                                };
                                dischargeOptGoal(
                                    ctx, stDec, "decreases", sp,
                                    "recursive call to `" + nm + "` may not strictly decrease termination measure",
                                    decGoal, None
                                )
                            },
                            None -> recordFailed(
                                ctx, "decreases", sp,
                                "mutually recursive callee `" + nm + "` is missing a `decreases` clause",
                                Some("add a `decreases` measure to `" + nm + "` so mutual recursion termination can be proved")
                            ),
                        },
                        _ -> (),
                    }
                } else ();

                // Conservatively havoc any passed Cell or MutArray parameters (including wrapped in Tuple/ADT),
                // and full-havoc whenever callee has transitive ambient heap effects (Z1: globals / gcHandleGet / FVs / closures)
                let fullHavoc = cellGet(unknownMutContainer) || strMapContains(ctx.vcAmbientMutFns, nm);
                let havocCellList = if (fullHavoc) assocKeysUnique(st1.stCells) else cellGet(passedCellLocs);
                let havocArrList = if (fullHavoc) assocKeysUnique(st1.stArrMems) else cellGet(passedMutArrLocs);
                let stAfterMut = havocLocs(ctx, st1, havocCellList, havocArrList, "call");

                // Allocate fresh return symbol ONLY for modeled types (fail-closed `None` for Float/String/Ptr/closures)
                let retSortOpt = match typeToSmtSort(retTy) {
                    Some(s) -> Some(s),
                    None -> match adtVariantCountForType(ctx, retTy) {
                        Some(_) -> Some("(_ BitVec 32)"),
                        None -> None,
                    },
                };
                match retSortOpt {
                    Some(rsort) -> {
                        let rsym = freshSym(ctx, nm + "_ret");
                        let rdecl = "(declare-const " + rsym + " " + rsort + ")";
                        let initPath0 = match retTy {
                            TyCon("Char") -> Cons("(bvult " + rsym + " #x00000100)", stAfterMut.stPath),
                            _ -> stAfterMut.stPath,
                        };
                        let initPath = match adtVariantCountForType(ctx, retTy) {
                            Some(nv) if (nv > 0) -> Cons("(bvult " + rsym + " " + bvLitForBits(nv, 32) + ")", initPath0),
                            _ -> initPath0,
                        };
                        let pathAcc = cellNew(initPath);
                        let declsAcc = cellNew(Cons(rdecl, stAfterMut.stDecls));
                        let ce = cellNew(if (cellGet(hasMutAlias)) Nil else callee.fsEnsures);
                        while (match cellGet(ce) { Nil -> false, _ -> true }) {
                            match cellGet(ce) {
                                Cons(ec, re) -> {
                                    let ensVars = match ec.ecBind {
                                        Some(bname) -> assocSet(cellGet(calleeVars), bname, rsym),
                                        None -> cellGet(calleeVars),
                                    };
                                    let ensSt = MkSymState {
                                        stDecls: cellGet(declsAcc),
                                        stVars: ensVars,
                                        stCells: stAfterMut.stCells,
                                        stLocSorts: stAfterMut.stLocSorts,
                                        stArrLens: stAfterMut.stArrLens,
                                        stArrMems: stAfterMut.stArrMems,
                                        stDataTags: stAfterMut.stDataTags,
                                        stDataFields: stAfterMut.stDataFields,
                                        stPath: cellGet(pathAcc),
                                        stUserVars: stAfterMut.stUserVars,
                                    };
                                    let (stEnsOut, evOpt) = evalTerm(ctx, ensSt, ec.ecExpr, false);
                                    cellSet(declsAcc, stEnsOut.stDecls);
                                    match evOpt {
                                        Some(es) -> cellSet(pathAcc, Cons(es, cellGet(pathAcc))),
                                        None -> (),
                                    };
                                    cellSet(ce, re)
                                },
                                Nil -> (),
                            }
                        };
                        let stOut = MkSymState {
                            stDecls: cellGet(declsAcc),
                            stVars: stAfterMut.stVars,
                            stCells: stAfterMut.stCells,
                            stLocSorts: stAfterMut.stLocSorts,
                            stArrLens: stAfterMut.stArrLens,
                            stArrMems: stAfterMut.stArrMems,
                            stDataTags: stAfterMut.stDataTags,
                            stDataFields: stAfterMut.stDataFields,
                            stPath: cellGet(pathAcc),
                            stUserVars: stAfterMut.stUserVars,
                        };
                        (stOut, Some(rsym))
                    },
                    None -> (stAfterMut, None),
                }
            },
            None -> {
                // Unknown/extern function: havoc any Cell/MutArray arguments (including wrapped in Tuple/ADT)
                let ca = cellNew(args);
                let cav = cellNew(argVals);
                while (match (cellGet(ca), cellGet(cav)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                    match (cellGet(ca), cellGet(cav)) {
                        (Cons(a, ra), Cons(avOpt, rav)) -> {
                            let aty = schemeBody(a.tscm);
                            match avOpt {
                                Some(loc) ->
                                    if (isCellType(aty)) {
                                        match assocGet(st1.stCells, loc) {
                                            Some(innerSym) -> {
                                                cellSet(passedCellLocs, addUnique(cellGet(passedCellLocs), loc));
                                                if (typeContainsMutableRec(ctx, elemTypeOf(aty), Nil) || isArrayType(elemTypeOf(aty))) {
                                                    if (innerSym == "__unknown_nonscalar") cellSet(unknownMutContainer, true)
                                                    else collectMutLocsFromSym(st1, innerSym, passedCellLocs, passedMutArrLocs, unknownMutContainer, [loc])
                                                } else ()
                                            },
                                            None -> cellSet(unknownMutContainer, true),
                                        }
                                    } else if (isMutArrayType(aty)) {
                                        match assocGet(st1.stArrMems, loc) {
                                            Some(_) -> {
                                                cellSet(passedMutArrLocs, addUnique(cellGet(passedMutArrLocs), loc));
                                                if (typeContainsMutableRec(ctx, elemTypeOf(aty), Nil) || isArrayType(elemTypeOf(aty))) {
                                                    cellSet(unknownMutContainer, true)
                                                } else ()
                                            },
                                            None -> cellSet(unknownMutContainer, true),
                                        }
                                    } else if (typeContainsMutableRec(ctx, aty, Nil)) {
                                        collectMutLocsFromSym(st1, loc, passedCellLocs, passedMutArrLocs, unknownMutContainer, Nil)
                                    } else (),
                                None ->
                                    if (typeContainsMutableRec(ctx, aty, Nil)) cellSet(unknownMutContainer, true) else (),
                            };
                            cellSet(ca, ra);
                            cellSet(cav, rav)
                        },
                        _ -> (),
                    }
                };
                if (!isKnownLocalOnlyIntrinsic(ctx.vcSpecs, ctx.vcExterns, nm)) {
                    cellSet(unknownMutContainer, true)
                } else ();
                let havocCells = if (cellGet(unknownMutContainer)) assocKeysUnique(st1.stCells) else cellGet(passedCellLocs);
                let havocArrs = if (cellGet(unknownMutContainer)) assocKeysUnique(st1.stArrMems) else cellGet(passedMutArrLocs);
                let stOut = havocLocs(ctx, st1, havocCells, havocArrs, "ext");
                (stOut, None)
            },
        }
    }

def evalWhile(
    ctx: VerifyCtx,
    st: SymState,
    sp: Span,
    cond: TaggedTerm,
    body: TaggedTerm,
    emitObs: Bool
): (SymState, Option String) = {
    let invsRev: Cell (List (Span, TaggedTerm)) = cellNew(Nil);
    let decOpt: Cell (Option (Span, TaggedTerm)) = cellNew(None);
    let restBody: Cell TaggedTerm = cellNew(body);

    match body.tnode {
        TmBlock(stmts) -> {
            let cur = cellNew(stmts);
            let taking = cellNew(true);
            while (cellGet(taking)) {
                match cellGet(cur) {
                    Cons(s, r) -> match s.tnode {
                        TmApplyDir(vd, args) if (vd.vname == "__gs_invariant") -> {
                            match args {
                                Cons(ie, _) -> cellSet(invsRev, Cons((s.tspan, ie), cellGet(invsRev))),
                                Nil -> (),
                            };
                            cellSet(cur, r)
                        },
                        TmApplyDir(vd, args) if (vd.vname == "__gs_decreases") -> {
                            match args {
                                Cons(de, _) -> cellSet(decOpt, Some((s.tspan, de))),
                                Nil -> (),
                            };
                            cellSet(cur, r)
                        },
                _ -> {
                            cellSet(restBody, MkTerm { tspan: body.tspan, tscm: body.tscm, tnode: TmBlock(Cons(s, r)) });
                            cellSet(taking, false)
                        },
                    },
                    Nil -> {
                        cellSet(restBody, MkTerm { tspan: body.tspan, tscm: body.tscm, tnode: TmBlock(Nil) });
                        cellSet(taking, false)
                    },
                }
            }
        },
        _ -> (),
    };

    let invs = listRev(cellGet(invsRev));
    let actualBody = cellGet(restBody);

    let modCellsCell: Cell (List String) = cellNew(Nil);
    let modArrsCell: Cell (List String) = cellNew(Nil);
    let hasOpaque = cellNew(false);
    scanEffectsInTerm(ctx, cond, st.stVars, modCellsCell, modArrsCell, hasOpaque);
    scanEffectsInTerm(ctx, actualBody, st.stVars, modCellsCell, modArrsCell, hasOpaque);
    let modCells = if (cellGet(hasOpaque)) assocKeysUnique(st.stCells) else cellGet(modCellsCell);
    let modArrs = if (cellGet(hasOpaque)) assocKeysUnique(st.stArrMems) else cellGet(modArrsCell);

    let missingInvHint: Option String = match (invs, modCells, modArrs) {
        (Nil, Cons(_, _), _) -> Some("loop modifies mutable state without an `invariant`"),
        (Nil, _, Cons(_, _)) -> Some("loop modifies a `MutArray` without an `invariant`"),
        _ -> None,
    };

    // 1. Base case: invariants hold on entry (also check invariant well-formedness)
    if (emitObs) {
        let ci = cellNew(invs);
        while (match cellGet(ci) { Nil -> false, _ -> true }) {
            match cellGet(ci) {
                Cons((isp, ie), r) -> {
                    let (stInv, iv) = evalContractTerm(ctx, st, ie);
                    dischargeOptGoal(
                        ctx, stInv, "invariant_init", isp,
                        "loop invariant may not hold on entry in `" + ctx.vcCurFn + "`",
                        iv, None
                    );
                    cellSet(ci, r)
                },
                Nil -> (),
            }
        }
    } else ();

    // 2. Inductive step: havoc modified cells AND modified arrays
    let stStep0 = havocLocs(ctx, st, modCells, modArrs, "loop");
    let stepPath = cellNew(stStep0.stPath);
    let stepDecls = cellNew(stStep0.stDecls);
    let ci2 = cellNew(invs);
    while (match cellGet(ci2) { Nil -> false, _ -> true }) {
        match cellGet(ci2) {
            Cons((_, ie), r) -> {
                let tmpSt = MkSymState {
                    stDecls: cellGet(stepDecls), stVars: stStep0.stVars,
                    stCells: stStep0.stCells, stLocSorts: stStep0.stLocSorts,
                    stArrLens: stStep0.stArrLens, stArrMems: stStep0.stArrMems,
                    stDataTags: stStep0.stDataTags, stDataFields: stStep0.stDataFields,
                    stPath: cellGet(stepPath), stUserVars: stStep0.stUserVars,
                };
                let (stTmpOut, iv) = evalTerm(ctx, tmpSt, ie, false);
                cellSet(stepDecls, stTmpOut.stDecls);
                match iv {
                    Some(is) -> cellSet(stepPath, Cons(is, cellGet(stepPath))),
                    None -> (),
                };
                cellSet(ci2, r)
            },
            Nil -> (),
        }
    };
    let stStep1 = MkSymState {
        stDecls: cellGet(stepDecls), stVars: stStep0.stVars,
        stCells: stStep0.stCells, stLocSorts: stStep0.stLocSorts,
        stArrLens: stStep0.stArrLens, stArrMems: stStep0.stArrMems,
        stDataTags: stStep0.stDataTags, stDataFields: stStep0.stDataFields,
        stPath: cellGet(stepPath), stUserVars: stStep0.stUserVars,
    };
    let (stStep2, condVal) = evalTerm(ctx, stStep1, cond, emitObs);
    let stStep3 = match condVal {
        Some(cs) -> stWithPath(stStep2, cs),
        None -> stStep2,
    };

    // Check decreases >= 0 before iteration
    let decBeforeOpt: Cell (Option (Span, TaggedTerm, Option String)) = cellNew(None);
    match cellGet(decOpt) {
        Some((dsp, de)) -> {
            let (stD0, dv) = evalContractTerm(ctx, stStep3, de);
            let nonNegGoal = match dv { Some(ds) -> Some("(bvsge " + ds + " #x00000000)"), None -> None };
            if (emitObs) {
                dischargeOptGoal(
                    ctx, stD0, "decreases", dsp,
                    "loop `decreases` measure may be negative in `" + ctx.vcCurFn + "`",
                    nonNegGoal, missingInvHint
                )
            } else ();
            cellSet(decBeforeOpt, Some((dsp, de, dv)))
        },
        None -> (),
    };

    // Execute loop body symbolically
    let (stAfterBody, _) = evalTerm(ctx, stStep3, actualBody, emitObs);

    // Check decreases strictly decreased after iteration
    match cellGet(decBeforeOpt) {
        Some((dsp, de, dvBefore)) -> {
            let (stD1, dvAfter) = evalTerm(ctx, stAfterBody, de, false);
            let stepGoal = match (dvBefore, dvAfter) {
                (Some(db), Some(da)) -> Some("(bvslt " + da + " " + db + ")"),
                _ -> None,
            };
            if (emitObs) {
                dischargeOptGoal(
                    ctx, stD1, "decreases", dsp,
                    "loop `decreases` measure may not strictly decrease in `" + ctx.vcCurFn + "`",
                    stepGoal, missingInvHint
                )
            } else ()
        },
        None -> (),
    };

    // Check invariants preserved after iteration
    if (emitObs) {
        let ci3 = cellNew(invs);
        while (match cellGet(ci3) { Nil -> false, _ -> true }) {
            match cellGet(ci3) {
                Cons((isp, ie), r) -> {
                    let (stInv2, iv2) = evalContractTerm(ctx, stAfterBody, ie);
                    dischargeOptGoal(
                        ctx, stInv2, "invariant_preserve", isp,
                        "loop invariant may not be preserved by loop body in `" + ctx.vcCurFn + "`",
                        iv2, None
                    );
                    cellSet(ci3, r)
                },
                Nil -> (),
            }
        }
    } else ();

    // 3. Post-loop state: havoc modified cells AND arrays, assume invariants && !cond
    let stPost0 = havocLocs(ctx, MkSymState {
        stDecls: stAfterBody.stDecls,
        stVars: st.stVars,
        stCells: st.stCells,
        stLocSorts: st.stLocSorts,
        stArrLens: st.stArrLens,
        stArrMems: st.stArrMems,
        stDataTags: st.stDataTags,
        stDataFields: st.stDataFields,
        stPath: st.stPath,
        stUserVars: stAfterBody.stUserVars,
    }, modCells, modArrs, "after");
    let postPath = cellNew(stPost0.stPath);
    let postDecls = cellNew(stPost0.stDecls);
    let ci4 = cellNew(invs);
    while (match cellGet(ci4) { Nil -> false, _ -> true }) {
        match cellGet(ci4) {
            Cons((_, ie), r) -> {
                let tmpSt = MkSymState {
                    stDecls: cellGet(postDecls), stVars: stPost0.stVars,
                    stCells: stPost0.stCells, stLocSorts: stPost0.stLocSorts,
                    stArrLens: stPost0.stArrLens, stArrMems: stPost0.stArrMems,
                    stDataTags: stPost0.stDataTags, stDataFields: stPost0.stDataFields,
                    stPath: cellGet(postPath), stUserVars: stPost0.stUserVars,
                };
                let (stTmpOut, iv) = evalTerm(ctx, tmpSt, ie, false);
                cellSet(postDecls, stTmpOut.stDecls);
                match iv {
                    Some(is) -> cellSet(postPath, Cons(is, cellGet(postPath))),
                    None -> (),
                };
                cellSet(ci4, r)
            },
            Nil -> (),
        }
    };
    let stPost1 = MkSymState {
        stDecls: cellGet(postDecls), stVars: stPost0.stVars,
        stCells: stPost0.stCells, stLocSorts: stPost0.stLocSorts,
        stArrLens: stPost0.stArrLens, stArrMems: stPost0.stArrMems,
        stDataTags: stPost0.stDataTags, stDataFields: stPost0.stDataFields,
        stPath: cellGet(postPath), stUserVars: stPost0.stUserVars,
    };
    let (stPost2, postCondVal) = evalTerm(ctx, stPost1, cond, false);
    let stPost3 = match postCondVal {
        Some(cs) -> stWithPath(stPost2, "(not " + cs + ")"),
        None -> stPost2,
    };
    (stPost3, Some("#x00000000"))
}

// ============================================================================
// Per-Function Verification Driver
// ============================================================================

def verifySingleFn(ctx: VerifyCtx, spec: FnSpec): Void = {
    let decls = cellNew(Nil);
    let vars = cellNew(Nil);
    let cells = cellNew(Nil);
    let locSorts = cellNew(Nil);
    let arrLens = cellNew(Nil);
    let arrMems = cellNew(Nil);
    let path = cellNew(Nil);
    let uvars = cellNew(Nil);

    let cp = cellNew(spec.fsParams);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(pvd, r) -> {
                let pty = schemeBody(pvd.vscm);
                if (isArrayType(pty)) {
                    let loc = freshLoc(ctx, pvd.vname);
                    let lenSym = freshSym(ctx, pvd.vname + "_len");
                    let eSort = elemSortForContainer(ctx, pty);
                    cellSet(decls, Cons("(declare-const " + lenSym + " (_ BitVec 32))", cellGet(decls)));
                    let memSym =
                        if (eSort == "__nonscalar") "__nonscalar_arr"
                        else {
                            let ms = freshSym(ctx, pvd.vname + "_mem");
                            cellSet(decls, Cons("(declare-const " + ms + " (Array (_ BitVec 32) " + eSort + "))", cellGet(decls)));
                            ms
                        };
                    cellSet(path, Cons("(bvsge " + lenSym + " #x00000000)", cellGet(path)));
                    cellSet(vars, assocSet(cellGet(vars), pvd.vname, loc));
                    cellSet(locSorts, assocSet(cellGet(locSorts), loc, eSort));
                    cellSet(arrLens, assocSet(cellGet(arrLens), loc, lenSym));
                    cellSet(arrMems, assocSet(cellGet(arrMems), loc, memSym));
                    cellSet(uvars, assocSet(cellGet(uvars), "len(" + pvd.vname + ")", lenSym))
                } else if (isCellType(pty)) {
                    let loc = freshLoc(ctx, pvd.vname);
                    let eSort = elemSortForContainer(ctx, pty);
                    let cSym =
                        if (eSort == "__nonscalar") "__unknown_nonscalar"
                        else {
                            let cs = freshSym(ctx, pvd.vname);
                            cellSet(decls, Cons("(declare-const " + cs + " " + eSort + ")", cellGet(decls)));
                            cellSet(uvars, assocSet(cellGet(uvars), pvd.vname, cs));
                            cs
                        };
                    cellSet(vars, assocSet(cellGet(vars), pvd.vname, loc));
                    cellSet(locSorts, assocSet(cellGet(locSorts), loc, eSort));
                    cellSet(cells, assocSet(cellGet(cells), loc, cSym))
                } else {
                    let sortOpt = match typeToSmtSort(pty) {
                        Some(s) -> Some(s),
                        None -> match adtVariantCountForType(ctx, pty) {
                            Some(_) -> Some("(_ BitVec 32)"),
                            None -> None,
                        },
                    };
                    match sortOpt {
                        Some(sort) -> {
                            let pSym = freshSym(ctx, pvd.vname);
                            cellSet(decls, Cons("(declare-const " + pSym + " " + sort + ")", cellGet(decls)));
                            match pty {
                                TyCon("Char") -> cellSet(path, Cons("(bvult " + pSym + " #x00000100)", cellGet(path))),
                                _ -> (),
                            };
                            match adtVariantCountForType(ctx, pty) {
                                Some(nv) if (nv > 0) -> cellSet(path, Cons("(bvult " + pSym + " " + bvLitForBits(nv, 32) + ")", cellGet(path))),
                                _ -> (),
                            };
                            cellSet(vars, assocSet(cellGet(vars), pvd.vname, pSym));
                            cellSet(uvars, assocSet(cellGet(uvars), pvd.vname, pSym))
                        },
                        None -> (),
                    }
                };
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };

    let st0 = MkSymState {
        stDecls: cellGet(decls),
        stVars: cellGet(vars),
        stCells: cellGet(cells),
        stLocSorts: cellGet(locSorts),
        stArrLens: cellGet(arrLens),
        stArrMems: cellGet(arrMems),
        stDataTags: Nil,
        stDataFields: Nil,
        stPath: cellGet(path),
        stUserVars: cellGet(uvars),
    };

    let fnCtxBase = MkVerifyCtx {
        vcSpecs: ctx.vcSpecs,
        vcExterns: ctx.vcExterns,
        vcCtorTags: ctx.vcCtorTags,
        vcCtorAdt: ctx.vcCtorAdt,
        vcCtorFieldTypes: ctx.vcCtorFieldTypes,
        vcAdtVariantCount: ctx.vcAdtVariantCount,
        vcAdtTypeParams: ctx.vcAdtTypeParams,
        vcAdtReg: ctx.vcAdtReg,
        vcCallGraph: ctx.vcCallGraph,
        vcAmbientMutFns: ctx.vcAmbientMutFns,
        vcCurFn: spec.fsName,
        vcCurDecExpr: match spec.fsDecreases { Some((_, de)) -> Some(de), None -> None },
        vcCurDecVal: None,
        vcSolver: ctx.vcSolver,
        vcTimeoutMs: ctx.vcTimeoutMs,
        vcCheckImplicit: ctx.vcCheckImplicit,
        vcNextSym: ctx.vcNextSym,
        vcResultsRev: ctx.vcResultsRev,
        vcSolverErr: ctx.vcSolverErr,
    };

    // Check well-formedness of each `requires` and then assume it
    let curSt = cellNew(st0);
    let cr = cellNew(spec.fsRequires);
    while (match cellGet(cr) { Nil -> false, _ -> true }) {
        match cellGet(cr) {
            Cons((_, reqExpr), r) -> {
                let (st1, rv) = evalContractTerm(fnCtxBase, cellGet(curSt), reqExpr);
                let st2 = match rv {
                    Some(rs) -> stWithPath(st1, rs),
                    None -> st1,
                };
                cellSet(curSt, st2);
                cellSet(cr, r)
            },
            Nil -> (),
        }
    };

    // Evaluate entry `decreases` measure (checking its well-formedness AND entry non-negativity, matching core.gsa)
    let decValOpt: Option String = match spec.fsDecreases {
        Some((dsp, decE)) -> {
            let (stD, dv) = evalContractTerm(fnCtxBase, cellGet(curSt), decE);
            cellSet(curSt, stD);
            let decZero = bvZero(typeBitWidth(schemeBody(decE.tscm)));
            let entryGoal = match dv {
                Some(d) -> Some("(bvsge " + d + " " + decZero + ")"),
                None -> None,
            };
            dischargeOptGoal(
                fnCtxBase, stD, "decreases", dsp,
                "entry termination measure may be negative in `" + spec.fsName + "`",
                entryGoal, None
            );
            dv
        },
        None -> None,
    };

    let fnCtx = MkVerifyCtx {
        vcSpecs: ctx.vcSpecs,
        vcExterns: ctx.vcExterns,
        vcCtorTags: ctx.vcCtorTags,
        vcCtorAdt: ctx.vcCtorAdt,
        vcCtorFieldTypes: ctx.vcCtorFieldTypes,
        vcAdtVariantCount: ctx.vcAdtVariantCount,
        vcAdtTypeParams: ctx.vcAdtTypeParams,
        vcAdtReg: ctx.vcAdtReg,
        vcCallGraph: ctx.vcCallGraph,
        vcAmbientMutFns: ctx.vcAmbientMutFns,
        vcCurFn: spec.fsName,
        vcCurDecExpr: match spec.fsDecreases { Some((_, de)) -> Some(de), None -> None },
        vcCurDecVal: decValOpt,
        vcSolver: ctx.vcSolver,
        vcTimeoutMs: ctx.vcTimeoutMs,
        vcCheckImplicit: ctx.vcCheckImplicit,
        vcNextSym: ctx.vcNextSym,
        vcResultsRev: ctx.vcResultsRev,
        vcSolverErr: ctx.vcSolverErr,
    };

    // Symbolically verify function body
    let (stAfter, retValOpt) = evalTerm(fnCtx, cellGet(curSt), spec.fsBody, true);

    // Discharge all function postconditions (`ensures`)
    let ce = cellNew(spec.fsEnsures);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons(ec, r) -> {
                let ensVars = match (ec.ecBind, retValOpt) {
                    (Some(bname), Some(rv)) -> assocSet(stAfter.stVars, bname, rv),
                    _ -> stAfter.stVars,
                };
                let stEnsIn = MkSymState {
                    stDecls: stAfter.stDecls,
                    stVars: ensVars,
                    stCells: stAfter.stCells,
                    stLocSorts: stAfter.stLocSorts,
                    stArrLens: stAfter.stArrLens,
                    stArrMems: stAfter.stArrMems,
                    stDataTags: stAfter.stDataTags,
                    stDataFields: stAfter.stDataFields,
                    stPath: stAfter.stPath,
                    stUserVars: stAfter.stUserVars,
                };
                let (stEnsOut, evOpt) = evalContractTerm(fnCtx, stEnsIn, ec.ecExpr);
                dischargeOptGoal(
                    fnCtx, stEnsOut, "ensures", ec.ecSpan,
                    "postcondition of `" + spec.fsName + "` may not hold",
                    evOpt, None
                );
                cellSet(ce, r)
            },
            Nil -> (),
        }
    }
}

// ============================================================================
// JSON (`std.json`) & 1D Diagnostic Reporting
// ============================================================================

def buildAdtVerifyMaps(
    adtNames: List String,
    adtReg: StrMap AdtInfo
): (StrMap Int, StrMap String, StrMap (List Type), StrMap Int, StrMap (List String)) = {
    let ctorTags: StrMap Int = strMapNew();
    let ctorAdt: StrMap String = strMapNew();
    let ctorFtys: StrMap (List Type) = strMapNew();
    let adtCounts: StrMap Int = strMapNew();
    let adtTps: StrMap (List String) = strMapNew();
    // Fallback built-in tags
    strMapInsert(ctorTags, "Some", 0);
    strMapInsert(ctorTags, "None", 1);
    strMapInsert(ctorTags, "Ok", 0);
    strMapInsert(ctorTags, "Err", 1);
    strMapInsert(ctorTags, "Cons", 0);
    strMapInsert(ctorTags, "Nil", 1);
    let ca = cellNew(adtNames);
    while (match cellGet(ca) { Nil -> false, _ -> true }) {
        match cellGet(ca) {
            Cons(adtName, ra) -> {
                match strMapGet(adtReg, adtName) {
                    Some(info) -> {
                        strMapInsert(adtCounts, adtName, listLen(info.variants));
                        strMapInsert(adtTps, adtName, info.typeParams);
                        let cv = cellNew(info.variants);
                        while (match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(vi, rv) -> {
                                    strMapInsert(ctorTags, vi.vname, vi.tag);
                                    strMapInsert(ctorAdt, vi.vname, adtName);
                                    strMapInsert(ctorFtys, vi.vname, vi.fieldTypes);
                                    cellSet(cv, rv)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    None -> (),
                };
                cellSet(ca, ra)
            },
            Nil -> (),
        }
    };
    (ctorTags, ctorAdt, ctorFtys, adtCounts, adtTps)
}

def isUserFnToVerify(fd: FunDef, entryFile: String, scopeDir: String): Bool =
    if ((strStartsWith(fd.fnName, "__") && !strStartsWith(fd.fnName, "__inst_"))
        || strStartsWith(fd.fnName, "$derive")
        || strStartsWith(fd.fnName, "std.")
        || strStartsWith(fd.fnName, "sys.")) false
    else match diagGetFile(fd.fnSpan.fileId) {
        Some(sf) ->
            if (strStartsWith(sf.sfPath, "<stdlib") || strStartsWith(sf.sfPath, "<builtin")) false
            else if (sf.sfPath == entryFile) true
            else if (strLen(scopeDir) > 0) strStartsWith(sf.sfPath, scopeDir)
            else true,
        None -> false,
    }

def fnMatchesFilters(name: String, filters: List String): Bool = match filters {
    Nil -> true,
    _ -> {
        let found = cellNew(false);
        let cf = cellNew(filters);
        while (!cellGet(found) && match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(f, r) -> {
                    if (name == f) cellSet(found, true)
                    else {
                        let suf = "." + f;
                        let nl = strLen(name);
                        let sl = strLen(suf);
                        if (nl > sl && strSlice(name, nl - sl, nl) == suf) cellSet(found, true) else ()
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
}

pub def collectUserVerifyFnNames(prog: CoreProgram, entryFile: String, scopeDir: String, fnFilters: List String): List String = {
    let outRev: Cell (List String) = cellNew(Nil);
    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(nm, r) -> {
                match strMapGet(prog.coreFns, nm) {
                    Some(fd) ->
                        if (isUserFnToVerify(fd, entryFile, scopeDir) && fnMatchesFilters(nm, fnFilters)) {
                            cellSet(outRev, Cons(nm, cellGet(outRev)))
                        } else (),
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(outRev))
}

pub def verifyCoreProgram(
    prog: CoreProgram,
    entryFile: String,
    scopeDir: String,
    jsonOut: Bool,
    solverBin: String,
    timeoutMs: Int,
    checkImplicit: Bool,
    fnFilters: List String
): Result Int String = {
    let specs: StrMap FnSpec = strMapNew();
    let callGraph: StrMap (List String) = strMapNew();
    let userFnsRev: Cell (List FnSpec) = cellNew(Nil);

    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(nm, r) -> {
                match strMapGet(prog.coreFns, nm) {
                    Some(fd) -> {
                        let sp = extractFnSpec(fd);
                        strMapInsert(specs, nm, sp);
                        strMapInsert(callGraph, nm, collectDirectCallees(sp.fsBody, Nil));
                        if (isUserFnToVerify(fd, entryFile, scopeDir) && fnMatchesFilters(nm, fnFilters)) {
                            cellSet(userFnsRev, Cons(sp, cellGet(userFnsRev)))
                        } else ()
                    },
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    let (ctorTags, ctorAdt, ctorFtys, adtCounts, adtTps) = buildAdtVerifyMaps(prog.coreAdtNames, prog.coreAdtReg);
    let ambientMutFns = computeAmbientHeapEffectFns(prog, specs, callGraph);
    let ctx = MkVerifyCtx {
        vcSpecs: specs,
        vcExterns: prog.coreExterns,
        vcCtorTags: ctorTags,
        vcCtorAdt: ctorAdt,
        vcCtorFieldTypes: ctorFtys,
        vcAdtVariantCount: adtCounts,
        vcAdtTypeParams: adtTps,
        vcAdtReg: prog.coreAdtReg,
        vcCallGraph: callGraph,
        vcAmbientMutFns: ambientMutFns,
        vcCurFn: "",
        vcCurDecExpr: None,
        vcCurDecVal: None,
        vcSolver: solverBin,
        vcTimeoutMs: if (timeoutMs < 100) 100 else timeoutMs,
        vcCheckImplicit: checkImplicit,
        vcNextSym: cellNew(0),
        vcResultsRev: cellNew(Nil),
        vcSolverErr: cellNew(None),
    };

    let userFns = listRev(cellGet(userFnsRev));
    let hasFnFilter = match fnFilters { Nil -> false, _ -> true };
    if (hasFnFilter && listLen(userFns) == 0) {
        Err("no user functions matched --fn filter in " + entryFile)
    } else {
    let uf = cellNew(userFns);
    while (match cellGet(uf) { Nil -> false, _ -> true } && match cellGet(ctx.vcSolverErr) { None -> true, Some(_) -> false }) {
        match cellGet(uf) {
            Cons(sp, r) -> {
                verifySingleFn(ctx, sp);
                cellSet(uf, r)
            },
            Nil -> (),
        }
    };

    match cellGet(ctx.vcSolverErr) {
        Some(e) -> Err(e),
        None -> {
            let results = listRev(cellGet(ctx.vcResultsRev));
            let provedCnt = cellNew(0);
            let failedCnt = cellNew(0);
            let unknownCnt = cellNew(0);
            let cr = cellNew(results);
            while (match cellGet(cr) { Nil -> false, _ -> true }) {
                match cellGet(cr) {
                    Cons(ob, r) -> {
                        if (ob.obStatus == "proved") cellSet(provedCnt, cellGet(provedCnt) + 1)
                        else if (ob.obStatus == "failed") cellSet(failedCnt, cellGet(failedCnt) + 1)
                        else cellSet(unknownCnt, cellGet(unknownCnt) + 1);
                        cellSet(cr, r)
                    },
                    Nil -> (),
                }
            };
            let okAll = cellGet(failedCnt) == 0 && cellGet(unknownCnt) == 0;
            if (jsonOut) {
                let obsValsRev: Cell (List Value) = cellNew(Nil);
                let co = cellNew(results);
                while (match cellGet(co) { Nil -> false, _ -> true }) {
                    match cellGet(co) {
                        Cons(ob, r) -> {
                            let (ln, col) = diagSpanLineCol(ob.obSpan);
                            let fpath = match diagGetFile(ob.obSpan.fileId) { Some(sf) -> sf.sfPath, None -> entryFile };
                            let fields: Cell (List (String, Value)) = cellNew([
                                ("fn", VStr(ob.obFn)),
                                ("kind", VStr(ob.obKind)),
                                ("status", VStr(ob.obStatus)),
                                ("file", VStr(fpath)),
                                ("line", VInt(intToI64(ln))),
                                ("col", VInt(intToI64(col))),
                                ("message", VStr(ob.obMsg)),
                            ]);
                            match ob.obHint {
                                Some(h) -> cellSet(fields, listAppend(cellGet(fields), [("hint", VStr(h))])),
                                None -> (),
                            };
                            match ob.obModel {
                                Cons(_, _) -> {
                                    let mFieldsRev: Cell (List (String, Value)) = cellNew(Nil);
                                    let cm = cellNew(ob.obModel);
                                    while (match cellGet(cm) { Nil -> false, _ -> true }) {
                                        match cellGet(cm) {
                                            Cons((mk, mv), rm) -> {
                                                cellSet(mFieldsRev, Cons((mk, VStr(mv)), cellGet(mFieldsRev)));
                                                cellSet(cm, rm)
                                            },
                                            Nil -> (),
                                        }
                                    };
                                    cellSet(fields, listAppend(cellGet(fields), [("counterexample", VObj(listRev(cellGet(mFieldsRev))))]))
                                },
                                Nil -> (),
                            };
                            cellSet(obsValsRev, Cons(VObj(cellGet(fields)), cellGet(obsValsRev)));
                            cellSet(co, r)
                        },
                        Nil -> (),
                    }
                };
                let rootObj = VObj([
                    ("ok", VBool(okAll)),
                    ("file", VStr(entryFile)),
                    ("functions", VInt(intToI64(listLen(userFns)))),
                    ("proved", VInt(intToI64(cellGet(provedCnt)))),
                    ("failed", VInt(intToI64(cellGet(failedCnt)))),
                    ("unknown", VInt(intToI64(cellGet(unknownCnt)))),
                    ("obligations", VArr(listRev(cellGet(obsValsRev)))),
                ]);
                printLn(stringify(rootObj));
                Ok(if (okAll) 0 else 1)
            } else {
                if (okAll) {
                    printLn(
                        "VERIFIED: " + entryFile
                        + " (" + intToStr(listLen(userFns)) + " functions, "
                        + intToStr(cellGet(provedCnt)) + " obligations proved)"
                    );
                    Ok(0)
                } else {
                    let co = cellNew(results);
                    while (match cellGet(co) { Nil -> false, _ -> true }) {
                        match cellGet(co) {
                            Cons(ob, r) -> {
                                if (ob.obStatus != "proved") {
                                    let diagStr = match ob.obHint {
                                        Some(h) -> formatSpanDiagHint("verify", ob.obSpan, ob.obMsg, h),
                                        None -> formatSpanDiag("verify", ob.obSpan, ob.obMsg),
                                    };
                                    printLn(diagStr)
                                } else ();
                                cellSet(co, r)
                            },
                            Nil -> (),
                        }
                    };
                    printLn(
                        "FAILED: " + entryFile
                        + " (" + intToStr(cellGet(provedCnt)) + " proved, "
                        + intToStr(cellGet(failedCnt)) + " failed, "
                        + intToStr(cellGet(unknownCnt)) + " unknown)"
                    );
                    Ok(1)
                }
            }
        },
    }
    }
}

// ============================================================================
// Verification-Driven Optimization (`--verified-opt`) Closed Call-Graph Analysis
// ============================================================================

def termListContainsAssume(ts: List TaggedTerm): Bool = match ts {
    Nil -> false,
    Cons(t, r) -> if (termContainsAssume(t)) true else termListContainsAssume(r),
}

def armListContainsAssume(arms: List CoreArm): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let gHas = match a.caGuard { Some(g) -> termContainsAssume(g), None -> false };
        if (gHas || termContainsAssume(a.caBody)) true else armListContainsAssume(r)
    },
}

def termContainsAssume(tm: TaggedTerm): Bool = match tm.tnode {
    TmApplyDir(vd, args) ->
        if (vd.vname == "assume") true else termListContainsAssume(args),
    TmApplyCls(f, args) -> if (termContainsAssume(f)) true else termListContainsAssume(args),
    TmTuple(es) -> termListContainsAssume(es),
    TmBlock(es) -> termListContainsAssume(es),
    TmMakeCls(_, _, body) -> termContainsAssume(body),
    TmMakeData(_, _, fs, _, _) -> termListContainsAssume(fs),
    TmBin(_, a, b) -> if (termContainsAssume(a)) true else termContainsAssume(b),
    TmUn(_, a) -> termContainsAssume(a),
    TmLet(_, v, b) -> if (termContainsAssume(v)) true else termContainsAssume(b),
    TmIf(c, t, e) -> if (termContainsAssume(c)) true else if (termContainsAssume(t)) true else termContainsAssume(e),
    TmWhile(c, b) -> if (termContainsAssume(c)) true else termContainsAssume(b),
    TmMatch(s, arms) -> if (termContainsAssume(s)) true else armListContainsAssume(arms),
    TmGetTag(e) -> termContainsAssume(e),
    _ -> false,
}

def collectCallsAndEscapesList(
    ts: List TaggedTerm,
    callerName: String,
    callersOf: StrMap (List String),
    calledFromGlobal: StrMap Bool,
    escapedCls: StrMap Bool
): Void = match ts {
    Nil -> (),
    Cons(t, r) -> {
        collectCallsAndEscapes(t, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapesList(r, callerName, callersOf, calledFromGlobal, escapedCls)
    },
}

def collectCallsAndEscapesArms(
    arms: List CoreArm,
    callerName: String,
    callersOf: StrMap (List String),
    calledFromGlobal: StrMap Bool,
    escapedCls: StrMap Bool
): Void = match arms {
    Nil -> (),
    Cons(a, r) -> {
        match a.caGuard {
            Some(g) -> collectCallsAndEscapes(g, callerName, callersOf, calledFromGlobal, escapedCls),
            None -> (),
        };
        collectCallsAndEscapes(a.caBody, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapesArms(r, callerName, callersOf, calledFromGlobal, escapedCls)
    },
}

def collectCallsAndEscapes(
    tm: TaggedTerm,
    callerName: String,
    callersOf: StrMap (List String),
    calledFromGlobal: StrMap Bool,
    escapedCls: StrMap Bool
): Void = match tm.tnode {
    TmApplyDir(vd, args) -> {
        let callee = vd.vname;
        if (callerName == "") {
            strMapInsert(calledFromGlobal, callee, true)
        } else {
            let prev = match strMapGet(callersOf, callee) { Some(xs) -> xs, None -> Nil };
            strMapInsert(callersOf, callee, Cons(callerName, prev))
        };
        collectCallsAndEscapesList(args, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmApplyCls(f, args) -> {
        collectCallsAndEscapes(f, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapesList(args, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmMakeCls(_, cs, body) -> {
        strMapInsert(escapedCls, cs.clsEntry, true);
        collectCallsAndEscapes(body, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmGlobalVar(nm) -> {
        strMapInsert(escapedCls, nm, true)
    },
    TmTuple(es) -> collectCallsAndEscapesList(es, callerName, callersOf, calledFromGlobal, escapedCls),
    TmBlock(es) -> collectCallsAndEscapesList(es, callerName, callersOf, calledFromGlobal, escapedCls),
    TmMakeData(_, _, fs, _, _) -> collectCallsAndEscapesList(fs, callerName, callersOf, calledFromGlobal, escapedCls),
    TmBin(_, a, b) -> {
        collectCallsAndEscapes(a, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapes(b, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmUn(_, a) -> collectCallsAndEscapes(a, callerName, callersOf, calledFromGlobal, escapedCls),
    TmLet(_, v, b) -> {
        collectCallsAndEscapes(v, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapes(b, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmIf(c, t, e) -> {
        collectCallsAndEscapes(c, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapes(t, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapes(e, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmWhile(c, b) -> {
        collectCallsAndEscapes(c, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapes(b, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmMatch(s, arms) -> {
        collectCallsAndEscapes(s, callerName, callersOf, calledFromGlobal, escapedCls);
        collectCallsAndEscapesArms(arms, callerName, callersOf, calledFromGlobal, escapedCls)
    },
    TmGetTag(e) -> collectCallsAndEscapes(e, callerName, callersOf, calledFromGlobal, escapedCls),
    _ -> (),
}

def isUserFnForVerifiedOpt(fd: FunDef): Bool =
    if (fd.fnSpan.fileId <= 0) false
    else match diagGetFile(fd.fnSpan.fileId) {
        Some(sf) ->
            !strStartsWith(sf.sfPath, "<builtin")
            && !strStartsWith(sf.sfPath, "std/")
            && !strStartsWith(sf.sfPath, "sys/"),
        None -> false,
    }

/// Compute the sound set of Verified-Safe functions for `--verified-opt`:
///   1. Every implicit & explicit VC of `f` under `vcCheckImplicit = true` is `"proved"` (`0 failed, 0 unknown`);
///   2. `f` contains NO `assume(...)` call (prevents `--contracts=erase` unsoundness / LLVM UB);
///   3. Downward `CalleeSound` fixed-point: any unverified or `assume`-tainted callee has its
///      `ensures` stripped and its callers re-verified until convergence;
///   4. Upward closed call-graph fixed-point: if `f` has non-empty `requires`, then `isOpenWorld`
///      is false, `f` has at least one direct caller, `f` is NOT `main`/exported/extern/ctor,
///      NOT escaped as a closure/global, NOT called from a global initializer, and EVERY direct
///      caller of `f` is also Verified-Safe.
def isDefaultWasmExportVerify(fnName: String): Bool = {
    let eff = if (strStartsWith(fnName, "$root.")) strSlice(fnName, 6, strLen(fnName)) else fnName;
    let n = strLen(eff);
    if (n == 0 || eff == "main") false
    else if (n >= 2 && strByteAt(eff, 0) == 95 && strByteAt(eff, 1) == 95) false
    else {
        let ok = cellNew(true);
        let i = cellNew(0);
        while (cellGet(i) < n && cellGet(ok)) {
            let c = strByteAt(eff, cellGet(i));
            if (c == 46 || c == 36) cellSet(ok, false) else ();
            cellSet(i, cellGet(i) + 1)
        };
        cellGet(ok)
    }
}

pub def computeVerifiedSafeFns(
    prog: CoreProgram,
    exportedFns: List String,
    isOpenWorld: Bool,
    isWasm: Bool,
    solverBin: String,
    timeoutMs: Int
): Result (StrMap Bool) String = {
    let specs: StrMap FnSpec = strMapNew();
    let callGraph: StrMap (List String) = strMapNew();
    let callersOf: StrMap (List String) = strMapNew();
    let calledFromGlobal: StrMap Bool = strMapNew();
    let escapedCls: StrMap Bool = strMapNew();
    let hasAssume: StrMap Bool = strMapNew();
    let extCallable: StrMap Bool = strMapNew();

    strMapInsert(extCallable, "main", true);
    let hasExplicitExports = match exportedFns { Nil -> false, _ -> true };
    let ce = cellNew(exportedFns);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons(en, r) -> {
                strMapInsert(extCallable, en, true);
                strMapInsert(extCallable, "$root." + en, true);
                cellSet(ce, r)
            },
            Nil -> (),
        }
    };
    if (isWasm && !hasExplicitExports) {
        let cw = cellNew(prog.coreFnNames);
        while (match cellGet(cw) { Nil -> false, _ -> true }) {
            match cellGet(cw) {
                Cons(fnm, r) -> {
                    if (isDefaultWasmExportVerify(fnm)) strMapInsert(extCallable, fnm, true) else ();
                    cellSet(cw, r)
                },
                Nil -> (),
            }
        }
    } else ();
    let cex = cellNew(prog.coreExternNames);
    while (match cellGet(cex) { Nil -> false, _ -> true }) {
        match cellGet(cex) {
            Cons(en, r) -> { strMapInsert(extCallable, en, true); cellSet(cex, r) },
            Nil -> (),
        }
    };
    let cce = cellNew(prog.coreCExports);
    while (match cellGet(cce) { Nil -> false, _ -> true }) {
        match cellGet(cce) {
            Cons((fnNm, _), r) -> { strMapInsert(extCallable, fnNm, true); cellSet(cce, r) },
            Nil -> (),
        }
    };
    let cct = cellNew(prog.coreCtors);
    while (match cellGet(cct) { Nil -> false, _ -> true }) {
        match cellGet(cct) {
            Cons((fnNm, _), r) -> { strMapInsert(extCallable, fnNm, true); cellSet(cct, r) },
            Nil -> (),
        }
    };

    let userFnsRev: Cell (List FnSpec) = cellNew(Nil);
    let assumeShadowed = strMapContains(prog.coreExterns, "assume") || strMapContains(prog.coreFns, "assume");
    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(nm, r) -> {
                match strMapGet(prog.coreFns, nm) {
                    Some(fd) -> {
                        let spRaw = extractFnSpec(fd);
                        let fnHasAssume = !assumeShadowed && termContainsAssume(fd.fnBody);
                        if (fnHasAssume) strMapInsert(hasAssume, nm, true) else ();
                        let eligible = isUserFnForVerifiedOpt(fd) && !fnHasAssume;
                        let sp =
                            if (eligible) spRaw
                            else MkFnSpec {
                                fsName: spRaw.fsName,
                                fsSpan: spRaw.fsSpan,
                                fsParams: spRaw.fsParams,
                                fsRetTy: spRaw.fsRetTy,
                                fsRequires: spRaw.fsRequires,
                                fsEnsures: Nil,
                                fsDecreases: spRaw.fsDecreases,
                                fsBody: spRaw.fsBody,
                            };
                        strMapInsert(specs, nm, sp);
                        strMapInsert(callGraph, nm, collectDirectCallees(sp.fsBody, Nil));
                        collectCallsAndEscapes(fd.fnBody, nm, callersOf, calledFromGlobal, escapedCls);
                        if (eligible) {
                            cellSet(userFnsRev, Cons(sp, cellGet(userFnsRev)))
                        } else ()
                    },
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    let cg = cellNew(prog.coreGlobals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(gd, r) -> {
                collectCallsAndEscapes(gd.gvInit, "", callersOf, calledFromGlobal, escapedCls);
                cellSet(cg, r)
            },
            Nil -> (),
        }
    };

    let (ctorTags, ctorAdt, ctorFtys, adtCounts, adtTps) = buildAdtVerifyMaps(prog.coreAdtNames, prog.coreAdtReg);
    let ambientMutFns = computeAmbientHeapEffectFns(prog, specs, callGraph);
    let provedMap: StrMap Bool = strMapNew();
    let solverErr: Cell (Option String) = cellNew(None);

    let runVerifyOne = (sp: FnSpec) -> {
        let ctx = MkVerifyCtx {
            vcSpecs: specs,
            vcExterns: prog.coreExterns,
            vcCtorTags: ctorTags,
            vcCtorAdt: ctorAdt,
            vcCtorFieldTypes: ctorFtys,
            vcAdtVariantCount: adtCounts,
            vcAdtTypeParams: adtTps,
            vcAdtReg: prog.coreAdtReg,
            vcCallGraph: callGraph,
            vcAmbientMutFns: ambientMutFns,
            vcCurFn: "",
            vcCurDecExpr: None,
            vcCurDecVal: None,
            vcSolver: solverBin,
            vcTimeoutMs: if (timeoutMs < 100) 100 else timeoutMs,
            vcCheckImplicit: true,
            vcNextSym: cellNew(0),
            vcResultsRev: cellNew(Nil),
            vcSolverErr: cellNew(None),
        };
        verifySingleFn(ctx, sp);
        match cellGet(ctx.vcSolverErr) {
            Some(e) -> cellSet(solverErr, Some(e)),
            None -> {
                let allOk = cellNew(true);
                let cr = cellNew(cellGet(ctx.vcResultsRev));
                while (cellGet(allOk) && match cellGet(cr) { Nil -> false, _ -> true }) {
                    match cellGet(cr) {
                        Cons(ob, rr) -> {
                            if (ob.obStatus != "proved") cellSet(allOk, false) else ();
                            cellSet(cr, rr)
                        },
                        Nil -> (),
                    }
                };
                strMapInsert(provedMap, sp.fsName, cellGet(allOk))
            },
        }
    };

    let isProved = (nm: String) -> match strMapGet(provedMap, nm) { Some(true) -> true, _ -> false };

    let uf = cellNew(listRev(cellGet(userFnsRev)));
    while (match cellGet(uf) { Nil -> false, _ -> true } && match cellGet(solverErr) { None -> true, Some(_) -> false }) {
        match cellGet(uf) {
            Cons(sp, r) -> {
                runVerifyOne(sp);
                cellSet(uf, r)
            },
            Nil -> (),
        }
    };

    // Downward `CalleeSound` fixed-point (V1): if any function with non-empty `fsEnsures`
    // failed verification, strip its `fsEnsures` from `specs` and re-verify its proved callers.
    let calleeChanged = cellNew(true);
    while (cellGet(calleeChanged) && match cellGet(solverErr) { None -> true, Some(_) -> false }) {
        cellSet(calleeChanged, false);
        let toReverifyMap: StrMap Bool = strMapNew();
        let toReverifyRev: Cell (List String) = cellNew(Nil);
        let cfd = cellNew(prog.coreFnNames);
        while (match cellGet(cfd) { Nil -> false, _ -> true }) {
            match cellGet(cfd) {
                Cons(nm, r) -> {
                    if (!isProved(nm)) {
                        match strMapGet(specs, nm) {
                            Some(sp) -> {
                                let hasEns = match sp.fsEnsures { Nil -> false, _ -> true };
                                if (hasEns) {
                                    strMapInsert(specs, nm, MkFnSpec {
                                        fsName: sp.fsName,
                                        fsSpan: sp.fsSpan,
                                        fsParams: sp.fsParams,
                                        fsRetTy: sp.fsRetTy,
                                        fsRequires: sp.fsRequires,
                                        fsEnsures: Nil,
                                        fsDecreases: sp.fsDecreases,
                                        fsBody: sp.fsBody,
                                    });
                                    cellSet(calleeChanged, true);
                                    let callers = match strMapGet(callersOf, nm) { Some(xs) -> xs, None -> Nil };
                                    let cc = cellNew(callers);
                                    while (match cellGet(cc) { Nil -> false, _ -> true }) {
                                        match cellGet(cc) {
                                            Cons(callerNm, rc) -> {
                                                if (isProved(callerNm) && !strMapContains(toReverifyMap, callerNm)) {
                                                    strMapInsert(toReverifyMap, callerNm, true);
                                                    cellSet(toReverifyRev, Cons(callerNm, cellGet(toReverifyRev)))
                                                } else ();
                                                cellSet(cc, rc)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                } else ()
                            },
                            None -> (),
                        }
                    } else ();
                    cellSet(cfd, r)
                },
                Nil -> (),
            }
        };
        let crv = cellNew(listRev(cellGet(toReverifyRev)));
        while (match cellGet(crv) { Nil -> false, _ -> true } && match cellGet(solverErr) { None -> true, Some(_) -> false }) {
            match cellGet(crv) {
                Cons(callerNm, rr) -> {
                    match strMapGet(specs, callerNm) {
                        Some(sp) -> runVerifyOne(sp),
                        None -> (),
                    };
                    cellSet(crv, rr)
                },
                Nil -> (),
            }
        }
    };

    match cellGet(solverErr) {
        Some(e) -> Err(e),
        None -> {
            // Upward closed call-graph fixed-point for functions with non-empty `requires`
            // OR implicit non-aliasing preconditions on mutable parameters (Iron Law 1 + V2 + W2)
            let aliasCtx = MkVerifyCtx {
                vcSpecs: specs,
                vcExterns: prog.coreExterns,
                vcCtorTags: ctorTags,
                vcCtorAdt: ctorAdt,
                vcCtorFieldTypes: ctorFtys,
                vcAdtVariantCount: adtCounts,
                vcAdtTypeParams: adtTps,
                vcAdtReg: prog.coreAdtReg,
                vcCallGraph: callGraph,
                vcAmbientMutFns: ambientMutFns,
                vcCurFn: "",
                vcCurDecExpr: None,
                vcCurDecVal: None,
                vcSolver: solverBin,
                vcTimeoutMs: 100,
                vcCheckImplicit: true,
                vcNextSym: cellNew(0),
                vcResultsRev: cellNew(Nil),
                vcSolverErr: cellNew(None),
            };
            let fnHasImplicitAliasPrecond = (params: List VarDecl) -> {
                let mutCnt = cellNew(0);
                let immArrCnt = cellNew(0);
                let nestedMutCnt = cellNew(0);
                let cp = cellNew(params);
                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                    match cellGet(cp) {
                        Cons(pvd, r) -> {
                            let pty = schemeBody(pvd.vscm);
                            let isMut = isCellType(pty) || isMutArrayType(pty);
                            let isImm = isArrayType(pty) && !isMutArrayType(pty);
                            let hasNested = !isMut && typeContainsMutableRec(aliasCtx, pty, Nil);
                            let mutElemNested = match pty {
                                TyComp(_, ety) -> typeContainsMutableRec(aliasCtx, ety, Nil),
                                _ -> false,
                            };
                            if (isMut) {
                                cellSet(mutCnt, cellGet(mutCnt) + 1);
                                if (mutElemNested) cellSet(nestedMutCnt, cellGet(nestedMutCnt) + 1) else ()
                            } else if (hasNested) cellSet(nestedMutCnt, cellGet(nestedMutCnt) + 1)
                            else if (isImm) {
                                cellSet(immArrCnt, cellGet(immArrCnt) + 1);
                                if (mutElemNested) cellSet(nestedMutCnt, cellGet(nestedMutCnt) + 1) else ()
                            } else ();
                            cellSet(cp, r)
                        },
                        Nil -> (),
                    }
                };
                cellGet(mutCnt) >= 2
                || (cellGet(mutCnt) >= 1 && cellGet(immArrCnt) >= 1)
                || cellGet(nestedMutCnt) >= 1
            };
            let unsafeSet: StrMap Bool = strMapNew();
            let changed = cellNew(true);
            while (cellGet(changed)) {
                cellSet(changed, false);
                let cf2 = cellNew(prog.coreFnNames);
                while (match cellGet(cf2) { Nil -> false, _ -> true }) {
                    match cellGet(cf2) {
                        Cons(nm, r) -> {
                            if (isProved(nm) && !strMapContains(unsafeSet, nm)) {
                                match strMapGet(specs, nm) {
                                    Some(sp) -> {
                                        let hasReq = match sp.fsRequires { Nil -> false, _ -> true };
                                        let hasEntryPrecond = hasReq || fnHasImplicitAliasPrecond(sp.fsParams);
                                        if (hasEntryPrecond) {
                                            let callers = match strMapGet(callersOf, nm) { Some(xs) -> xs, None -> Nil };
                                            let noCallers = match callers { Nil -> true, _ -> false };
                                            let bad = cellNew(
                                                isOpenWorld
                                                || noCallers
                                                || strMapContains(extCallable, nm)
                                                || strMapContains(escapedCls, nm)
                                                || strMapContains(calledFromGlobal, nm)
                                            );
                                            if (!cellGet(bad)) {
                                                let cc = cellNew(callers);
                                                while (!cellGet(bad) && match cellGet(cc) { Nil -> false, _ -> true }) {
                                                    match cellGet(cc) {
                                                        Cons(callerNm, rc) -> {
                                                            if (!isProved(callerNm) || strMapContains(unsafeSet, callerNm)) {
                                                                cellSet(bad, true)
                                                            } else ();
                                                            cellSet(cc, rc)
                                                        },
                                                        Nil -> (),
                                                    }
                                                }
                                            } else ();
                                            if (cellGet(bad)) {
                                                strMapInsert(unsafeSet, nm, true);
                                                cellSet(changed, true)
                                            } else ()
                                        } else ()
                                    },
                                    None -> (),
                                }
                            } else ();
                            cellSet(cf2, r)
                        },
                        Nil -> (),
                    }
                }
            };

            let safeOut: StrMap Bool = strMapNew();
            let cf3 = cellNew(prog.coreFnNames);
            while (match cellGet(cf3) { Nil -> false, _ -> true }) {
                match cellGet(cf3) {
                    Cons(nm, r) -> {
                        if (isProved(nm) && !strMapContains(unsafeSet, nm) && !strMapContains(hasAssume, nm)) {
                            strMapInsert(safeOut, nm, true)
                        } else ();
                        cellSet(cf3, r)
                    },
                    Nil -> (),
                }
            };
            Ok(safeOut)
        },
    }
}
