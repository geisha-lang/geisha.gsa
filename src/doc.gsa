}

extern "gs_sys_lstat_kind" def c_doc_lstat_kind(path: String): Int

def formatTypeList(ts: List Type, sep: String): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> typeToString(h),
    Cons(h, t) -> typeToString(h) + sep + formatTypeList(t, sep),
}

def formatConstraints(cs: List ConstraintSpec): String = match cs {
    Nil -> "",
    _ -> {
        let parts = cellNew(Nil);
        let cur = cellNew(cs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(c, r) -> {
                    let s = c.conceptName + (match c.typeArgs {
                        Nil -> "",
                        as_ -> " " + formatTypeList(as_, " "),
                    });
                    cellSet(parts, listAppend(cellGet(parts), [s]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        "(" + strJoin(cellGet(parts), ", ") + ") => "
    },
}

pub def formatScheme(scm: Scheme): String = match scm {
    ScmMono(t) -> typeToString(t),
    ScmPoly(_, t) -> typeToString(t),
    ScmPolyConstrained(_, cs, t) -> formatConstraints(cs) + typeToString(t),
    ScmSlot -> "_",
}

def formatFunDeps(fds: List FunDep): String = match fds {
    Nil -> "",
    _ -> {
        let parts = cellNew(Nil);
        let cur = cellNew(fds);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(fd, r) -> {
                    cellSet(parts, listAppend(cellGet(parts), [strJoin(fd.fdLhs, " ") + " -> " + strJoin(fd.fdRhs, " ")]));
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        " | " + strJoin(cellGet(parts), ", ")
    },
}

def formatFieldDecls(fs: List FieldDecl): String = {
    let parts = cellNew(Nil);
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(f, r) -> {
                let s = match f.fname {
                    Some(n) -> n + ": " + typeToString(f.fty),
                    None -> typeToString(f.fty),
                };
                cellSet(parts, listAppend(cellGet(parts), [s]));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    strJoin(cellGet(parts), ", ")
}

pub def formatVariant(v: VariantDef): String = match v.vbody {
    VarUnit -> v.vname,
    VarTuple(fs) -> v.vname + "(" + formatFieldDecls(fs) + ")",
    VarStruct(fs) -> v.vname + " { " + formatFieldDecls(fs) + " }",
}

def formatParamsFromAbs(ps: List VarDecl): String = {
    let parts = cellNew(Nil);
    let cur = cellNew(ps);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(vd, r) -> {
                let s = match vd.vscm {
                    ScmSlot -> vd.vname,
                    sc -> vd.vname + ": " + formatScheme(sc),
                };
                cellSet(parts, listAppend(cellGet(parts), [s]));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    strJoin(cellGet(parts), ", ")
}

def stripDocPrefix(line: String): String =
    if (strStartsWith(line, "/// ")) strSlice(line, 4, strLen(line))
    else if (strStartsWith(line, "///")) strSlice(line, 3, strLen(line))
    else if (strStartsWith(line, "//! ")) strSlice(line, 4, strLen(line))
    else if (strStartsWith(line, "//!")) strSlice(line, 3, strLen(line))
    else line

// Extract contiguous `///` doc comment lines immediately preceding `startByte`.
pub def extractDocComment(src: String, startByte: Int): List String = {
    let n = strLen(src);
    let pos = if (startByte < 0) 0 else if (startByte > n) n else startByte;

    // Walk back to the start of the line containing `pos`
    let lineStart = cellNew(pos);
    while (cellGet(lineStart) > 0 && strByteAt(src, cellGet(lineStart) - 1) != 10) {
        cellSet(lineStart, cellGet(lineStart) - 1)
    };

    let docLines = cellNew(Nil);
    let curEnd = cellNew(cellGet(lineStart));
    let keep = cellNew(true);
    while (cellGet(keep) && cellGet(curEnd) > 0) {
        // Step over preceding '\n'
        let prevEndRaw = cellGet(curEnd) - 1;
        let prevEnd =
            if (prevEndRaw > 0 && strByteAt(src, prevEndRaw - 1) == 13) prevEndRaw - 1
            else prevEndRaw;
        let prevStart = cellNew(prevEnd);
        while (cellGet(prevStart) > 0 && strByteAt(src, cellGet(prevStart) - 1) != 10) {
            cellSet(prevStart, cellGet(prevStart) - 1)
        };
        let ps = cellGet(prevStart);
        // Trim leading spaces/tabs
        let firstNonWs = cellNew(ps);
        while (cellGet(firstNonWs) < prevEnd && (strByteAt(src, cellGet(firstNonWs)) == 32 || strByteAt(src, cellGet(firstNonWs)) == 9)) {
            cellSet(firstNonWs, cellGet(firstNonWs) + 1)
        };
        let trimmed = strSlice(src, cellGet(firstNonWs), prevEnd);
        if (strStartsWith(trimmed, "///")) {
            cellSet(docLines, Cons(trimmed, cellGet(docLines)));
            cellSet(curEnd, ps)
        } else {
            cellSet(keep, false)
        }
    };
    cellGet(docLines)
}

def stripDocLines(raw: List String): List String = {
    let rev = cellNew(Nil);
    let cur = cellNew(raw);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(l, r) -> {
                cellSet(rev, Cons(stripDocPrefix(l), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

// Extract module-level doc comment at the top of a file (`//!` lines or leading `///` lines
// separated from the first declaration by a blank line or `use`/`open`).
def extractModuleDocComment(src: String): List String = {
    let n = strLen(src);
    let pos = cellNew(0);
    // Skip optional shebang line
    if (strStartsWith(src, "#!")) {
        while (cellGet(pos) < n && strByteAt(src, cellGet(pos)) != 10) {
            cellSet(pos, cellGet(pos) + 1)
        };
        if (cellGet(pos) < n) cellSet(pos, cellGet(pos) + 1) else ()
    } else ();

    let rev = cellNew(Nil);
    let sawDoc = cellNew(false);
    let isDetached = cellNew(false);
    let done = cellNew(false);
    while (cellGet(pos) < n && !cellGet(done)) {
        let start = cellGet(pos);
        let e = cellNew(start);
        while (cellGet(e) < n && strByteAt(src, cellGet(e)) != 10) {
            cellSet(e, cellGet(e) + 1)
        };
        let endRaw = cellGet(e);
        let endTrim = if (endRaw > start && strByteAt(src, endRaw - 1) == 13) endRaw - 1 else endRaw;
        let line = strTrim(strSlice(src, start, endTrim));
        if (strLen(line) == 0) {
            if (cellGet(sawDoc)) {
                cellSet(isDetached, true);
                cellSet(done, true)
            } else ()
        } else if (strStartsWith(line, "//!")) {
            cellSet(sawDoc, true);
            cellSet(isDetached, true);
            cellSet(rev, Cons(stripDocPrefix(line), cellGet(rev)))
        } else if (strStartsWith(line, "///")) {
            cellSet(sawDoc, true);
            cellSet(rev, Cons(stripDocPrefix(line), cellGet(rev)))
        } else if (strStartsWith(line, "use ") || strStartsWith(line, "open ")) {
            if (cellGet(sawDoc)) cellSet(isDetached, true) else ();
            cellSet(done, true)
        } else {
            cellSet(done, true)
        };
        cellSet(pos, if (endRaw < n) endRaw + 1 else n)
    };
    if (cellGet(isDetached)) listRev(cellGet(rev)) else Nil
}

def formatDefExternPrefix(attrs: List DefAttr): String = match attrs {
    Nil -> "",
    Cons(AttrCStruct, _) -> "extern ",
    Cons(AttrExport(Some(sym)), _) -> "extern \"" + sym + "\" ",
    Cons(AttrExport(None), _) -> "extern ",
    Cons(AttrCtor(_), _) -> "extern init ",
}

pub def formatDefSig(d: Def): String = {
    let visPfx = (if (isPublicVis(d.vis)) "pub " else "") + formatDefExternPrefix(d.attrs);
    match d.item {
        ItAlg(tparams, variants) -> {
            let tpStr = match tparams { Nil -> "", ts -> " " + strJoin(ts, " ") };
            let vStrs = cellNew(Nil);
            let cur = cellNew(variants);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(v, r) -> {
                        cellSet(vStrs, listAppend(cellGet(vStrs), [formatVariant(v)]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            visPfx + "data " + d.ident + tpStr + " { " + strJoin(cellGet(vStrs), ", ") + " }"
        },
        ItAlias(tparams, scm) -> {
            let tpStr = match tparams { Nil -> "", ts -> " " + strJoin(ts, " ") };
            visPfx + "type " + d.ident + tpStr + " = " + formatScheme(scm)
        },
        ItConcept(tparams, supers, fundeps, methods) -> {
            let supStr = formatConstraints(supers);
            let tpStr = match tparams { Nil -> "", ts -> " " + strJoin(ts, " ") };
            let fdStr = formatFunDeps(fundeps);
            let mLines = cellNew(Nil);
            let cur = cellNew(methods);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(m, r) -> {
                        cellSet(mLines, listAppend(cellGet(mLines), ["    " + m.mname + ": " + formatScheme(m.mty)]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            match cellGet(mLines) {
                Nil -> visPfx + "concept " + supStr + d.ident + tpStr + fdStr + " {}",
                ms -> visPfx + "concept " + supStr + d.ident + tpStr + fdStr + " {\n" + strJoin(ms, "\n") + "\n}",
            }
        },
        ItInstance(cname, targs, cs, _) -> {
            let csStr = formatConstraints(cs);
            let taStr = match targs { Nil -> "", ts -> " " + formatTypeList(ts, " ") };
            visPfx + "instance " + csStr + cname + taStr
        },
        ItExtern(sym, scm, noAlloc, isFnPtr) -> {
            let modStr =
                (if (isFnPtr) "ptr " else "")
                + (if (noAlloc) "noalloc " else "")
                + (if (isFnPtr) "" else "\"" + sym + "\" ");
            visPfx + "extern " + modStr + "def " + d.ident + ": " + formatScheme(scm)
        },
        ItForm(f) -> match f.node {
            ExAbs(ps, retOpt, _) -> {
                let pStr = formatParamsFromAbs(ps);
                let rStr = match retOpt {
                    Some(rt) -> ": " + typeToString(rt),
                    None -> match f.annot {
                        Some(sc) -> " : " + formatScheme(sc),
                        None -> "",
                    },
                };
                visPfx + "def " + d.ident + "(" + pStr + ")" + rStr
            },
            _ -> match f.annot {
                Some(sc) -> visPfx + "def " + d.ident + ": " + formatScheme(sc),
                None -> visPfx + "def " + d.ident,
            },
        },
    }
}

def defKindStr(d: Def): String = match d.item {
    ItAlg(_, _) -> "data",
    ItAlias(_, _) -> "type",
    ItConcept(_, _, _, _) -> "concept",
    ItInstance(_, _, _, _) -> "instance",
    ItExtern(_, _, _, _) -> "extern",
    ItForm(f) -> match f.node {
        ExAbs(_, _, _) -> "def",
        _ -> "const",
    },
}

def defTypeParams(d: Def): List String = match d.item {
    ItAlg(tps, _) -> tps,
    ItAlias(tps, _) -> tps,
    ItConcept(tps, _, _, _) -> tps,
    ItExtern(_, scm, _, _) -> schemeTypeParams(scm),
    ItForm(f) -> match f.annot {
        Some(sc) -> schemeTypeParams(sc),
        None -> Nil,
    },
    ItInstance(_, _, _, _) -> Nil,
}

def defDisplayName(d: Def): String = match d.item {
    ItInstance(cname, targs, _, _) ->
        cname + (match targs { Nil -> "", ts -> " " + formatTypeList(ts, " ") }),
    _ -> d.ident,
}

def extractDocItemsRec(
    src: String,
    modKey: String,
    fileLabel: String,
    items: List ModuleItem,
    showAll: Bool
): List DocItem = {
    let rev: Cell (List DocItem) = cellNew(Nil);
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(vis, d), r) -> {
                if (showAll || isPublicVis(vis)) {
                    let docs = stripDocLines(extractDocComment(src, d.dpos.start));
                    let (startLine, _) = diagSpanLineCol(d.dpos);
                    let endSp = MkSpan { fileId: d.dpos.fileId, start: d.dpos.end, end: d.dpos.end };
                    let (endLine, _) = diagSpanLineCol(endSp);
                    let item = MkDocItem {
                        diName: defDisplayName(d),
                        diKind: defKindStr(d),
                        diVis: if (isPublicVis(vis)) "pub" else "private",
                        diModule: modKey,
                        diSig: formatDefSig(d),
                        diTypeParams: defTypeParams(d),
                        diDocs: docs,
                        diFile: fileLabel,
                        diLine: startLine,
                        diEndLine: if (endLine >= startLine) endLine else startLine,
                        diImports: Nil,
                        diChildren: Nil,
                    };
                    cellSet(rev, Cons(item, cellGet(rev)))
                } else ();
                cellSet(cur, r)
            },
            Cons(ModSub(vis, subName, subItems, sp), r) -> {
                if (showAll || isPublicVis(vis)) {
                    let docs = stripDocLines(extractDocComment(src, sp.start));
                    let (startLine, _) = diagSpanLineCol(sp);
                    let endSp = MkSpan { fileId: sp.fileId, start: sp.end, end: sp.end };
                    let (endLine, _) = diagSpanLineCol(endSp);
                    let subKey = modKey + "." + subName;
                    let subImports = extractModuleImports(subItems);
                    let children = extractDocItemsRec(src, subKey, fileLabel, subItems, showAll);
                    let visPfx = if (isPublicVis(vis)) "pub " else "";
                    let item = MkDocItem {
                        diName: subName,
                        diKind: "mod",
                        diVis: if (isPublicVis(vis)) "pub" else "private",
                        diModule: modKey,
                        diSig: visPfx + "mod " + subName,
                        diTypeParams: Nil,
                        diDocs: docs,
                        diFile: fileLabel,
                        diLine: startLine,
                        diEndLine: if (endLine >= startLine) endLine else startLine,
                        diImports: subImports,
                        diChildren: children,
                    };
                    cellSet(rev, Cons(item, cellGet(rev)))
                } else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def splitLastSeg(segs: List String): Option (List String, String) = match segs {
    Nil -> None,
    Cons(x, Nil) -> Some((Nil, x)),
    Cons(x, rest) -> match splitLastSeg(rest) {
        None -> None,
        Some((init, last)) -> Some((Cons(x, init), last)),
    },
}

def extractModuleImports(items: List ModuleItem): List (String, String, String) = {
    let rev: Cell (List (String, String, String)) = cellNew(Nil);
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModUse(_, u), r) -> {
                match u {
                    UseSingle(segs, _) -> match splitLastSeg(segs) {
                        Some((modSegs, sym)) ->
                            if (match modSegs { Nil -> false, _ -> true }) {
                                cellSet(rev, Cons((sym, strJoin(modSegs, "."), sym), cellGet(rev)))
                            } else (),
                        None -> (),
                    },
                    UseAlias(segs, alias, _) -> match splitLastSeg(segs) {
                        Some((modSegs, sym)) ->
                            if (match modSegs { Nil -> false, _ -> true }) {
                                cellSet(rev, Cons((alias, strJoin(modSegs, "."), sym), cellGet(rev)))
                            } else (),
                        None -> (),
                    },
                    UseMulti(modSegs, specs) -> {
                        let mKey = strJoin(modSegs, ".");
                        let cs = cellNew(specs);
                        while (match cellGet(cs) { Nil -> false, _ -> true }) {
                            match cellGet(cs) {
                                Cons(sp, rs) -> {
                                    cellSet(rev, Cons((useSpecLocalName(sp), mKey, sp.orig), cellGet(rev)));
                                    cellSet(cs, rs)
                                },
                                Nil -> (),
                            }
                        }
                    },
                    UseGlob(modSegs) ->
                        if (match modSegs { Nil -> false, _ -> true }) {
                            cellSet(rev, Cons(("*", strJoin(modSegs, "."), "*"), cellGet(rev)))
                        } else (),
                };
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def buildDocModule(
    modKey: String,
    group: String,
    pkgName: String,
    srcLabel: String,
    src: String,
    showAll: Bool
): Result DocModule String = {
    let fid = diagRegisterFile(srcLabel, src);
    let fm = parseFileModuleInFile(src, Nil, fid)?;
    let items = extractDocItemsRec(src, modKey, srcLabel, fm.items, showAll);
    let modDocs = extractModuleDocComment(src);
    let imports = extractModuleImports(fm.items);
    Ok(MkDocModule {
        dmKey: modKey,
        dmGroup: group,
        dmPackage: pkgName,
        dmSourceLabel: srcLabel,
        dmSourceText: src,
        dmModuleDocs: modDocs,
        dmImports: imports,
        dmItems: items,
    })
}

def renderModuleItems(src: String, items: List ModuleItem, showAll: Bool, out: Cell (List String), prefix: String): Void = {
    let cur = cellNew(items);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ModDef(vis, d), r) -> {
                if (showAll || isPublicVis(vis)) {
                    let docs = extractDocComment(src, d.dpos.start);
                    let cd = cellNew(docs);
                    while (match cellGet(cd) { Nil -> false, _ -> true }) {
                        match cellGet(cd) {
                            Cons(dl, rd) -> {
                                cellSet(out, listAppend(cellGet(out), [prefix + dl]));
                                cellSet(cd, rd)
                            },
                            Nil -> (),
                        }
                    };
                    cellSet(out, listAppend(cellGet(out), [prefix + formatDefSig(d)]));
                } else ();
                cellSet(cur, r)
            },
            Cons(ModSub(vis, subName, subItems, _), r) -> {
                if (showAll || isPublicVis(vis)) {
                    let visPfx = if (isPublicVis(vis)) "pub " else "";
                    cellSet(out, listAppend(cellGet(out), [prefix + visPfx + "mod " + subName + " {"]));
                    renderModuleItems(src, subItems, showAll, out, prefix + "    ");
                    cellSet(out, listAppend(cellGet(out), [prefix + "}"]))
                } else ();
                cellSet(cur, r)
            },
            Cons(_, r) -> cellSet(cur, r),
            Nil -> (),
        }
    }
}

def collectGsaModulesRec(dir: String, modPrefix: String, out: Cell (List String)): Void =
    match readDir(dir) {
        Err(_) -> (),
        Ok(entries) -> {
            let cur = cellNew(entries);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(name, r) -> {
                        if (name != "." && name != ".." && !strStartsWith(name, ".")) {
                            let full = pathJoin(dir, name);
                            let kind = c_doc_lstat_kind(full);
                            if (kind == 2) {
                                let nextPfx = if (modPrefix == "") name else modPrefix + "." + name;
                                collectGsaModulesRec(full, nextPfx, out)
                            } else if (kind == 1 && strEndsWith(name, ".gsa")) {
                                let stem = pathStem(name);
                                let modKey =
                                    if (stem == "mod") modPrefix
                                    else if (modPrefix == "") stem
                                    else modPrefix + "." + stem;
                                if (modKey != "") {
                                    cellSet(out, listAppend(cellGet(out), [modKey]))
                                } else ()
                            } else ()
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    }

def resolveModPathInRoots(roots: List String, segs: List String): Option String = {
    let cur = cellNew(roots);
    let found: Cell (Option String) = cellNew(None);
    while (match cellGet(found) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(root, r) -> {
                if (c_doc_lstat_kind(root) == 2) {
                    let p = cellNew(root);
                    let safe = cellNew(true);
                    let cs = cellNew(segs);
                    while (cellGet(safe) && match cellGet(cs) { Nil -> false, _ -> true }) {
                        match cellGet(cs) {
                            Cons(s, Nil) -> {
                                let base = pathJoin(cellGet(p), s);
                                let cand1 = base + ".gsa";
                                let cand2 = pathJoin(base, "mod.gsa");
                                if (c_doc_lstat_kind(cand1) == 1) cellSet(found, Some(cand1))
                                else if (c_doc_lstat_kind(base) == 2 && c_doc_lstat_kind(cand2) == 1) cellSet(found, Some(cand2))
                                else ();
                                cellSet(cs, Nil)
                            },
                            Cons(s, rs) -> {
                                let nextDir = pathJoin(cellGet(p), s);
                                if (c_doc_lstat_kind(nextDir) == 2) {
                                    cellSet(p, nextDir);
                                    cellSet(cs, rs)
                                } else {
                                    cellSet(safe, false)
                                }
                            },
                            Nil -> (),
                        }
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(found)
}

def lookupDepPkg(extSpecs: List PkgSpec, pkgId: String): Option PkgSpec = match extSpecs {
    Nil -> None,
    Cons(p, r) -> if (p.pkgId == pkgId) Some(p) else lookupDepPkg(r, pkgId),
}

def lookupAlias(deps: List (String, String), alias: String): Option String = match deps {
    Nil -> None,
    Cons((a, pid), r) -> if (a == alias) Some(pid) else lookupAlias(r, alias),
}

def resolveTargetSource(target: String): Result (String, String) String =
    match builtinModuleSource(target) {
        Some(src) -> Ok((target + " (builtin)", src)),
        None ->
            if (fileExists(target)) {
                let src = readFile(target)?;
                Ok((target, src))
            } else {
                match findProjectRoot(".") {
                    None -> Err("module or file not found: '" + target + "' (run 'geisha doc' to list available modules)"),
                    Some(projDir) -> {
                        let (rootMf, rootSpec, resolvedPkgs) = resolveProjectGraph(projDir, false, None, true)?;
                        let extSpecs = toLoaderPkgSpecs(resolvedPkgs);
                        let segs = strSplitChar(target, '.');
                        match segs {
                            Nil -> Err("empty module name"),
                            Cons(first, rest) -> {
                                let localSegs =
                                    if (first == rootMf.mfName && match rest { Nil -> false, _ -> true }) rest
                                    else segs;
                                match resolveModPathInRoots(rootSpec.srcRoots, localSegs) {
                                    Some(fpath) -> {
                                        let src = readFile(fpath)?;
                                        Ok((target + " (" + fpath + ")", src))
                                    },
                                    None ->
                                        match lookupAlias(rootSpec.deps, first) {
                                            Some(depId) -> match lookupDepPkg(extSpecs, depId) {
                                                Some(dp) -> {
                                                    let depSegs = match rest { Nil -> [dp.pkgName], _ -> rest };
                                                    match resolveModPathInRoots(dp.srcRoots, depSegs) {
                                                        Some(fpath) -> {
                                                            let src = readFile(fpath)?;
                                                            Ok((target + " (" + fpath + ")", src))
                                                        },
                                                        None -> match resolveModPathInRoots(dp.srcRoots, rest) {
                                                            Some(fpath) -> {
                                                                let src = readFile(fpath)?;
                                                                Ok((target + " (" + fpath + ")", src))
                                                            },
                                                            None -> Err("module '" + target + "' not found in dependency '" + first + "'"),
                                                        },
                                                    }
                                                },
                                                None -> Err("dependency '" + first + "' could not be resolved"),
                                            },
                                            None -> Err("module or file not found: '" + target + "' (run 'geisha doc' to list available modules)"),
                                        },
                                }
                            },
                        }
                    },
                }
            },
    }

def appendStdlibDocModules(showAll: Bool, outRev: Cell (List DocModule)): Result Void String = {
    let cur = cellNew(builtinModuleKeys());
    let errOpt: Cell (Option String) = cellNew(None);
    while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(k, r) -> {
                match builtinModuleSource(k) {
                    Some(src) -> {
                        let grp = if (strStartsWith(k, "sys.")) "sys" else "std";
                        match buildDocModule(k, grp, grp, k + " (builtin)", src, showAll) {
                            Ok(dm) -> cellSet(outRev, Cons(dm, cellGet(outRev))),
                            Err(e) -> cellSet(errOpt, Some(e)),
                        }
                    },
                    None -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None -> Ok(()),
    }
}

def collectSiteData(
    targetOpt: Option String,
    showAll: Bool,
    forceStdlib: Bool,
    noStdlib: Bool
): Result DocSiteData String = {
    let modsRev: Cell (List DocModule) = cellNew(Nil);
    match targetOpt {
        Some(target) -> {
            let (label, src) = resolveTargetSource(target)?;
            let isBuiltin = match builtinModuleSource(target) { Some(_) -> true, None -> false };
            let modKey =
                if (isBuiltin) target
                else if (strEndsWith(target, ".gsa")) pathStem(target)
                else target;
            let grp =
                if (isBuiltin) (if (strStartsWith(target, "sys.")) "sys" else "std")
                else if (strEndsWith(target, ".gsa")) "file"
                else "package";
            let (title, ver, pkgName) = match findProjectRoot(".") {
                Some(projDir) if (!isBuiltin) -> match resolveProjectGraph(projDir, false, None, true) {
                    Ok((mf, _, _)) -> (mf.mfName, mf.mfVersion, mf.mfName),
                    Err(_) -> (modKey, "", ""),
                },
                _ -> (if (isBuiltin) "Geisha Standard Library" else modKey, "", if (isBuiltin) grp else ""),
            };
            let dm = buildDocModule(modKey, grp, pkgName, label, src, showAll)?;
            cellSet(modsRev, Cons(dm, cellGet(modsRev)));
            if (forceStdlib && !noStdlib) {
                appendStdlibDocModules(showAll, modsRev)?
            } else ();
            Ok(MkDocSiteData {
                dsTitle: title,
                dsVersion: ver,
                dsModules: listRev(cellGet(modsRev)),
            })
        },
        None -> match findProjectRoot(".") {
            Some(projDir) -> {
                let (rootMf, rootSpec, _) = resolveProjectGraph(projDir, false, None, true)?;
                let localMods = cellNew(Nil);
                let cr = cellNew(rootSpec.srcRoots);
                while (match cellGet(cr) { Nil -> false, _ -> true }) {
                    match cellGet(cr) {
                        Cons(sr, rr) -> {
                            if (c_doc_lstat_kind(sr) == 2) {
                                collectGsaModulesRec(sr, "", localMods)
                            } else ();
                            cellSet(cr, rr)
                        },
                        Nil -> (),
                    }
                };
                let sortedLocal = sortUniqueStrings(cellGet(localMods));
                let cl = cellNew(sortedLocal);
                let errOpt: Cell (Option String) = cellNew(None);
                while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(cl) { Nil -> false, _ -> true }) {
                    match cellGet(cl) {
                        Cons(mKey, rm) -> {
                            let segs = strSplitChar(mKey, '.');
                            match resolveModPathInRoots(rootSpec.srcRoots, segs) {
                                Some(fpath) -> match readFile(fpath) {
                                    Err(e) -> cellSet(errOpt, Some(e)),
                                    Ok(src) -> {
                                        let fullKey =
                                            if (rootMf.mfName != "" && mKey != rootMf.mfName) rootMf.mfName + "." + mKey
                                            else mKey;
                                        match buildDocModule(fullKey, "package", rootMf.mfName, fpath, src, showAll) {
                                            Ok(dm) -> cellSet(modsRev, Cons(dm, cellGet(modsRev))),
                                            Err(e) -> cellSet(errOpt, Some(e)),
                                        }
                                    },
                                },
                                None -> (),
                            };
                            cellSet(cl, rm)
                        },
                        Nil -> (),
                    }
                };
                match cellGet(errOpt) {
                    Some(e) -> Err(e),
                    None -> {
                        if (!noStdlib) {
                            appendStdlibDocModules(showAll, modsRev)?
                        } else ();
                        Ok(MkDocSiteData {
                            dsTitle: if (rootMf.mfName != "") rootMf.mfName else "Geisha Project",
                            dsVersion: rootMf.mfVersion,
                            dsModules: listRev(cellGet(modsRev)),
                        })
                    },
                }
            },
            None -> {
                appendStdlibDocModules(showAll, modsRev)?;
                Ok(MkDocSiteData {
                    dsTitle: "Geisha Standard Library",
                    dsVersion: "",
                    dsModules: listRev(cellGet(modsRev)),
                })
            },
        },
    }
}

def listAllDocModules(): Result Void String = {
    let b = bufNew();
    bufPushStr(b, "Built-in modules (run `geisha doc <module>` for signatures, or `geisha doc --html` for static site):\n");
    let cur = cellNew(builtinModuleKeys());
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(k, r) -> {
                bufPushStr(b, "  ");
                bufPushStr(b, k);
                bufPushStr(b, "\n");
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };

    match findProjectRoot(".") {
        None -> (),
        Some(projDir) -> match resolveProjectGraph(projDir, false, None, true) {
            Err(_) -> (),
            Ok((rootMf, rootSpec, _)) -> {
                let localMods = cellNew(Nil);
                let cr = cellNew(rootSpec.srcRoots);
                while (match cellGet(cr) { Nil -> false, _ -> true }) {
                    match cellGet(cr) {
                        Cons(sr, rr) -> {
                            if (c_doc_lstat_kind(sr) == 2) {
                                collectGsaModulesRec(sr, "", localMods)
                            } else ();
                            cellSet(cr, rr)
                        },
                        Nil -> (),
                    }
                };
                let sortedLocal = sortUniqueStrings(cellGet(localMods));
                match sortedLocal {
                    Nil -> (),
                    xs -> {
                        bufPushStr(b, "\nProject modules (");
                        bufPushStr(b, rootMf.mfName);
                        bufPushStr(b, "):\n");
                        let cl = cellNew(xs);
                        while (match cellGet(cl) { Nil -> false, _ -> true }) {
                            match cellGet(cl) {
                                Cons(m, rm) -> {
                                    bufPushStr(b, "  ");
                                    bufPushStr(b, m);
                                    bufPushStr(b, "\n");
                                    cellSet(cl, rm)
                                },
                                Nil -> (),
                            }
                        }
                    },
                };

                match rootSpec.deps {
                    Nil -> (),
                    ds -> {
                        bufPushStr(b, "\nDependencies:\n");
                        let cd = cellNew(ds);
                        while (match cellGet(cd) { Nil -> false, _ -> true }) {
                            match cellGet(cd) {
                                Cons((alias, pid), rd) -> {
                                    bufPushStr(b, "  ");
                                    bufPushStr(b, alias);
                                    bufPushStr(b, " (");
                                    bufPushStr(b, pid);
                                    bufPushStr(b, ")\n");
                                    cellSet(cd, rd)
                                },
                                Nil -> (),
                            }
                        }
                    },
                }
            },
        },
    };
    printLn(bufToString(b));
    Ok(())
}

pub def cmdDoc(args: List String): Result Void String = {
    let showAll = cellNew(false);
    let htmlMode = cellNew(false);
    let jsonMode = cellNew(false);
    let forceStdlib = cellNew(false);
    let noStdlib = cellNew(false);
    let outDirOpt: Cell (Option String) = cellNew(None);
    let targetOpt: Cell (Option String) = cellNew(None);
    let errOpt: Cell (Option String) = cellNew(None);

    let cur = cellNew(args);
    while (match cellGet(cur) { Nil -> false, _ -> true } && match cellGet(errOpt) { None -> true, Some(_) -> false }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                if (a == "--all" || a == "-a") {
                    cellSet(showAll, true);
                    cellSet(cur, r)
                } else if (a == "--html" || a == "--site") {
                    cellSet(htmlMode, true);
                    cellSet(cur, r)
                } else if (a == "--json") {
                    cellSet(jsonMode, true);
                    cellSet(cur, r)
                } else if (a == "--stdlib") {
                    cellSet(forceStdlib, true);
                    cellSet(cur, r)
                } else if (a == "--no-stdlib") {
                    cellSet(noStdlib, true);
                    cellSet(cur, r)
                } else if (a == "--out" || a == "-o") {
                    match r {
                        Cons(dir, r2) -> {
                            cellSet(outDirOpt, Some(dir));
                            cellSet(htmlMode, true);
                            cellSet(cur, r2)
                        },
                        Nil -> cellSet(errOpt, Some("missing output directory after '" + a + "'")),
                    }
                } else if (strStartsWith(a, "--out=")) {
                    cellSet(outDirOpt, Some(strSlice(a, 6, strLen(a))));
                    cellSet(htmlMode, true);
                    cellSet(cur, r)
                } else if (strStartsWith(a, "-")) {
                    cellSet(errOpt, Some("unknown option for 'geisha doc': " + a))
                } else {
                    cellSet(targetOpt, Some(a));
                    cellSet(cur, r)
                }
            },
            Nil -> (),
        }
    };

    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None ->
            if (cellGet(htmlMode)) {
                let site = collectSiteData(cellGet(targetOpt), cellGet(showAll), cellGet(forceStdlib), cellGet(noStdlib))?;
                let outDir = match cellGet(outDirOpt) {
                    Some(d) -> d,
                    None -> match findProjectRoot(".") {
                        Some(projDir) -> pathJoin(projDir, "build/doc"),
                        None -> "build/doc",
                    },
                };
                generateDocSite(site, outDir, cellGet(jsonMode))?;
                printLn("Generated documentation site (" + intToStr(listLen(site.dsModules)) + " module(s)) in " + pathJoin(outDir, "index.html"));
                Ok(())
            } else if (cellGet(jsonMode)) {
                let site = collectSiteData(cellGet(targetOpt), cellGet(showAll), cellGet(forceStdlib), cellGet(noStdlib))?;
                printLn(docSiteToJson(site));
                Ok(())
            } else {
                match cellGet(targetOpt) {
                    None -> listAllDocModules(),
                    Some(target) -> {
                        let (label, src) = resolveTargetSource(target)?;
                        let fid = diagRegisterFile(label, src);
                        let fm = parseFileModuleInFile(src, Nil, fid)?;
                        let lines = cellNew(Nil);
                        renderModuleItems(src, fm.items, cellGet(showAll), lines, "");
                        let out = bufNew();
                        bufPushStr(out, "// module ");
                        bufPushStr(out, label);
                        bufPushStr(out, "\n");
                        match cellGet(lines) {
                            Nil -> bufPushStr(out, "// (no public items; pass --all to include private items)\n"),
                            ls -> {
                                bufPushStr(out, strJoin(ls, "\n"));
                                bufPushStr(out, "\n")
                            },
                        };
                        printLn(bufToString(out));
                        Ok(())
                    },
                }
            },
    }
}
