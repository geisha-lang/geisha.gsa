    VariantInfo, AdtInfo, ConceptInfo, InstanceInfo, InferOutput,
    mangleType, applyExplicitSubst, buildPairMap, matchInstancePatList, isConcreteTypeSend
}
use diag.{diagGetFile, diagSpanLineCol, formatSpanDiagHint}

pub def coFreshNextId(curId: Int): Int
    requires 0 <= curId && curId < 2147483647
    ensures r -> r == curId + 1 && r > curId && r > 0
= curId + 1

pub def coFreshBatchEnd(startId: Int, count: Int): Int
    requires 0 <= startId && startId <= 1073741824 && 0 <= count && count <= 1048576
    ensures r -> r == startId + count && r >= startId
= {
    let cur = cellNew(startId);
    let rem = cellNew(count);
    while (cellGet(rem) > 0)
        invariant 0 <= cellGet(rem) && cellGet(rem) <= count
        invariant 0 <= cellGet(cur) && cellGet(cur) == startId + (count - cellGet(rem))
        decreases cellGet(rem)
    {
        cellSet(cur, cellGet(cur) + 1);
        cellSet(rem, cellGet(rem) - 1)
    };
    cellGet(cur)
}

pub def coFlatTotalArity(fvCount: Int, paramCount: Int): Int
    requires 0 <= fvCount && fvCount <= 1048576 && 0 <= paramCount && paramCount <= 1048576
    ensures r -> r == fvCount + paramCount && r >= fvCount && r >= paramCount
= fvCount + paramCount

pub def coSpecSlotStepArity(curArity: Int, isSpecCb: Bool, fvCount: Int): Int
    requires 0 <= curArity && curArity <= 1048576 && 0 <= fvCount && fvCount <= 1024
    ensures r -> r >= curArity
        && ((isSpecCb && r == curArity + fvCount) || (!isSpecCb && r == curArity + 1))
= if (isSpecCb) curArity + fvCount else curArity + 1

pub def coAnfInFloatPrefix(idx: Int, lastFloatIdx: Int): Bool
    requires idx >= 0 && lastFloatIdx >= -1
    ensures r -> (r == (idx <= lastFloatIdx)) && (!r || lastFloatIdx >= 0)
= idx <= lastFloatIdx

pub def coPatSeqStatus(s1: Int, s2: Int): Int
    requires 0 <= s1 && s1 <= 2 && 0 <= s2 && s2 <= 2
    ensures r -> 0 <= r && r <= 2
        && ((r == 1) == (s1 == 1 || s2 == 1))
        && ((r == 0) == (s1 == 0 && s2 == 0))
= if (s1 == 1) 1 else if (s1 == 2) { if (s2 == 1) 1 else 2 } else s2

pub def coInlineBudgetAllows(
    cost: Int,
    maxCost: Int,
    inlCnt: Int,
    maxInlines: Int,
    depth: Int,
    maxDepth: Int
): Bool
    requires maxCost >= 1 && maxInlines >= 0 && maxDepth >= 0
    ensures r -> r == (
        1 <= cost && cost <= maxCost
        && 0 <= inlCnt && inlCnt < maxInlines
        && 0 <= depth && depth < maxDepth
    )
= 1 <= cost && cost <= maxCost
    && 0 <= inlCnt && inlCnt < maxInlines
    && 0 <= depth && depth < maxDepth

// ============================================================================
// Core IR Data Types (Distinct single-variant field names across project)
// ============================================================================

pub data ClosureSpec {
    MkClosureSpec { clsEntry: String, clsFvs: List String },
}

pub data TaggedTerm {
    MkTerm { tspan: Span, tscm: Scheme, tnode: Term },
}

pub data CoreArm {
    MkCoreArm { caPat: Pattern, caGuard: Option TaggedTerm, caBody: TaggedTerm },
}

pub data Term {
    TmLit(Lit),
    TmVar(String),
    TmGlobalVar(String),
    TmTuple(List TaggedTerm),
    TmBlock(List TaggedTerm),
    TmMakeCls(VarDecl, ClosureSpec, TaggedTerm),
    TmApplyCls(TaggedTerm, List TaggedTerm),
    TmApplyDir(VarDecl, List TaggedTerm),
    TmBin(BinOp, TaggedTerm, TaggedTerm),
    TmUn(UnOp, TaggedTerm),
    TmLet(VarDecl, TaggedTerm, TaggedTerm),
    TmIf(TaggedTerm, TaggedTerm, TaggedTerm),
    TmWhile(TaggedTerm, TaggedTerm),
    TmMatch(TaggedTerm, List CoreArm),
    TmMakeData(String, Int, List TaggedTerm, List Type, List Type),
    TmGetTag(TaggedTerm),
}

pub data FunDef {
    MkFunDef {
        fnName: String,
        fnSpan: Span,
        fnScm: Scheme,
        fnParams: List VarDecl,
        fnFvs: List VarDecl,
        fnBody: TaggedTerm,
    },
}

pub data GlobalValDef {
    MkGlobalValDef { gvName: String, gvSpan: Span, gvTy: Type, gvInit: TaggedTerm },
}

pub data ExternDef {
    MkExternDef { extName: String, extLink: String, extTy: Type, extNoAlloc: Bool, extIsFnPtr: Bool },
}

pub data EscapeInfo {
    MkEscapeInfo {
        escRecAdts: StrMap Bool,
        escFnStackVars: StrMap (StrMap Bool),
        escFnHasStack: StrMap Bool,
    },
}

pub data CoreProgram {
    MkCoreProgram {
        coreFns: StrMap FunDef,
        coreFnNames: List String,
        coreGlobals: List GlobalValDef,
        coreExterns: StrMap ExternDef,
        coreExternNames: List String,
        coreCExports: List (String, String),
        coreCtors: List (String, Int),
        coreAdtReg: StrMap AdtInfo,
        coreAdtNames: List String,
        coreEscape: EscapeInfo,
        coreVerifiedFns: StrMap Bool,
        coreOrigFnNames: StrMap String,
        coreUnseededPolyFns: List (String, Span, Bool),
    },
}

data Instantiation {
    MkInst { instFn: String, instArgs: List Type, instMangled: String },
}

def mkInst(fnName: String, targs: List Type): Instantiation = {
    let mangled = match targs {
        Nil -> fnName,
        _ -> fnName + "_" + joinMangledArgs(targs),
    };
    MkInst { instFn: fnName, instArgs: targs, instMangled: mangled }
}

def joinMangledArgs(ts: List Type): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> mangleType(h),
    Cons(h, t) -> mangleType(h) + "_" + joinMangledArgs(t),
}

// ============================================================================
// Type Helpers for K-Conversion & Monomorphization
// ============================================================================

pub def isTypeConcrete(ty: Type): Bool = match ty {
    TyVar(_) -> false,
    TyVoid -> true,
    TyCon(_) -> true,
    TyArr(_, ps, r) -> isTypeListConcrete(ps) && isTypeConcrete(r),
    TyTuple(es) -> isTypeListConcrete(es),
    TyComp(b, a) -> isTypeConcrete(b) && isTypeConcrete(a),
}

def isTypeListConcrete(ts: List Type): Bool = match ts {
    Nil -> true,
    Cons(h, t) -> isTypeConcrete(h) && isTypeListConcrete(t),
}

def isBuiltinOpPrimitive(ty: Type): Bool = match ty {
    TyCon(n) -> n == "Int" || n == "Int64" || n == "Float" || n == "Float32" || n == "Bool" || n == "Char" || n == "String",
    _ -> false,
}

def defaultPhantomType(ty: Type): Type = match ty {
    TyVar(_) -> TyVoid,
    TyVoid -> TyVoid,
    TyCon(_) -> ty,
    TyArr(_, ps, r) -> TyArr(TyVoid, defaultPhantomTypeList(ps), defaultPhantomType(r)),
    TyTuple(es) -> TyTuple(defaultPhantomTypeList(es)),
    TyComp(b, a) -> TyComp(defaultPhantomType(b), defaultPhantomType(a)),
}

def defaultPhantomTypeList(ts: List Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(defaultPhantomType(h), defaultPhantomTypeList(t)),
}

pub def extractTypeArgs(ty: Type): List Type = {
    let acc = cellNew(Nil);
    let curr = cellNew(ty);
    let looping = cellNew(true);
    while (cellGet(looping)) {
        match cellGet(curr) {
            TyComp(b, a) -> {
                cellSet(acc, Cons(a, cellGet(acc)));
                cellSet(curr, b)
            },
            _ -> cellSet(looping, false),
        }
    };
    cellGet(acc)
}

def unifyTypesInto(pat: Type, concrete: Type, sub: StrMap Type): Void = match (pat, concrete) {
    (TyVar(nm), _) ->
        if (strMapContains(sub, nm)) ()
        else strMapInsert(sub, nm, concrete),
    (TyArr(_, ps1, r1), TyArr(_, ps2, r2)) ->
        if (listLen(ps1) == listLen(ps2)) {
            unifyListsInto(ps1, ps2, sub);
            unifyTypesInto(r1, r2, sub)
        } else (),
    (TyTuple(es1), TyTuple(es2)) ->
        if (listLen(es1) == listLen(es2)) unifyListsInto(es1, es2, sub) else (),
    (TyComp(b1, a1), TyComp(b2, a2)) -> {
        unifyTypesInto(b1, b2, sub);
        unifyTypesInto(a1, a2, sub)
    },
    _ -> (),
}

def unifyListsInto(xs: List Type, ys: List Type, sub: StrMap Type): Void = match (xs, ys) {
    (Cons(x, xr), Cons(y, yr)) -> {
        unifyTypesInto(x, y, sub);
        unifyListsInto(xr, yr, sub)
    },
    _ -> (),
}

def applySchemeSubst(scm: Scheme, sub: StrMap Type): Scheme = match scm {
    ScmMono(t) -> ScmMono(applyExplicitSubst(t, sub)),
    ScmPoly(vs, t) -> ScmPoly(vs, applyExplicitSubstExcept(t, vs, sub)),
    ScmPolyConstrained(vs, cs, t) -> ScmPolyConstrained(vs, cs, applyExplicitSubstExcept(t, vs, sub)),
    ScmSlot -> ScmSlot,
}

def applyExplicitSubstExcept(ty: Type, bound: List String, sub: StrMap Type): Type = match ty {
    TyVoid -> TyVoid,
    TyCon(_) -> ty,
    TyVar(v) ->
        if (listContainsStr(bound, v)) ty
        else match strMapGet(sub, v) {
            Some(target) -> target,
            None -> ty,
        },
    TyArr(m, ps, r) -> TyArr(applyExplicitSubstExcept(m, bound, sub), applyExplicitSubstListExcept(ps, bound, sub), applyExplicitSubstExcept(r, bound, sub)),
    TyTuple(es) -> TyTuple(applyExplicitSubstListExcept(es, bound, sub)),
    TyComp(b, a) -> TyComp(applyExplicitSubstExcept(b, bound, sub), applyExplicitSubstExcept(a, bound, sub)),
}

def applyExplicitSubstListExcept(ts: List Type, bound: List String, sub: StrMap Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(applyExplicitSubstExcept(h, bound, sub), applyExplicitSubstListExcept(t, bound, sub)),
}

// ============================================================================
// Sanitize Phantom Type Variables in Concrete Terms
// ============================================================================

def sanitizePhantomTerm(tm: TaggedTerm): TaggedTerm = {
    let nscm = ScmMono(defaultPhantomType(schemeBody(tm.tscm)));
    let nnode = match tm.tnode {
        TmLit(_) -> tm.tnode,
        TmVar(_) -> tm.tnode,
        TmGlobalVar(_) -> tm.tnode,
        TmTuple(es) -> TmTuple(sanitizePhantomList(es)),
        TmBlock(es) -> TmBlock(sanitizePhantomList(es)),
        TmMakeCls(vd, cls, body) ->
            TmMakeCls(
                MkVarDecl { vname: vd.vname, vscm: ScmMono(defaultPhantomType(schemeBody(vd.vscm))) },
                cls,
                sanitizePhantomTerm(body)
            ),
        TmApplyCls(c, args) -> TmApplyCls(sanitizePhantomTerm(c), sanitizePhantomList(args)),
        TmApplyDir(vd, args) ->
            TmApplyDir(
                MkVarDecl { vname: vd.vname, vscm: ScmMono(defaultPhantomType(schemeBody(vd.vscm))) },
                sanitizePhantomList(args)
            ),
        TmBin(op, l, r) -> TmBin(op, sanitizePhantomTerm(l), sanitizePhantomTerm(r)),
        TmUn(op, e) -> TmUn(op, sanitizePhantomTerm(e)),
        TmGetTag(e) -> TmGetTag(sanitizePhantomTerm(e)),
        TmLet(vd, val, body) ->
            TmLet(
                MkVarDecl { vname: vd.vname, vscm: ScmMono(defaultPhantomType(schemeBody(vd.vscm))) },
                sanitizePhantomTerm(val),
                sanitizePhantomTerm(body)
            ),
        TmIf(c, t, e) -> TmIf(sanitizePhantomTerm(c), sanitizePhantomTerm(t), sanitizePhantomTerm(e)),
        TmWhile(c, b) -> TmWhile(sanitizePhantomTerm(c), sanitizePhantomTerm(b)),
        TmMatch(s, arms) -> {
            let rev = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ng = match a.caGuard { Some(g) -> Some(sanitizePhantomTerm(g)), None -> None };
                        cellSet(rev, Cons(MkCoreArm { caPat: a.caPat, caGuard: ng, caBody: sanitizePhantomTerm(a.caBody) }, cellGet(rev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            TmMatch(sanitizePhantomTerm(s), listRev(cellGet(rev)))
        },
        TmMakeData(tn, tg, fs, ftys, targs) ->
            TmMakeData(
                tn,
                tg,
                sanitizePhantomList(fs),
                defaultPhantomTypeList(ftys),
                defaultPhantomTypeList(targs)
            ),
    };
    MkTerm { tspan: tm.tspan, tscm: nscm, tnode: nnode }
}

def sanitizePhantomList(es: List TaggedTerm): List TaggedTerm = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(sanitizePhantomTerm(h), sanitizePhantomList(t)),
}

// ============================================================================
// K-Conversion Context & Helpers
// ============================================================================

data KCtx {
    MkKCtx {
        kCount: Cell Int,
        kCurrentFn: Cell String,
        kLocalEnv: Cell (List (String, Scheme)),
        kLocalDirect: Cell (List (String, String)),
        kPolyLifted: Cell (List (String, (String, List VarDecl, Scheme))),
        kGlobalFns: StrMap FunDef,
        kAllFnNames: Vec String,
        kGlobalValsRev: Cell (List GlobalValDef),
        kGlobalValSet: StrMap Bool,
        kExterns: StrMap ExternDef,
        kExternNamesRev: Cell (List String),
        kTopDirect: StrMap String,
        kLiftedClosures: StrMap (List String),
        kAdtReg: StrMap AdtInfo,
        kAdtNames: Vec String,
        kCtorMap: StrMap (String, VariantInfo),
        kConceptReg: StrMap ConceptInfo,
        kInstanceReg: List InstanceInfo,
        kConceptMethods: StrMap (String, Int),
        kContractMode: String,
        kVerifiedFns: StrMap Bool,
        kOrigFnNames: StrMap String,
        kInstantiatedPoly: StrMap Bool,
        kUnseededPolyRev: Cell (List (String, Span, Bool)),
        kErr: Cell (Option String),
    },
}

def kUnique(ctx: KCtx): Int = {
    let n = cellGet(ctx.kCount) + 1;
    cellSet(ctx.kCount, n);
    n
}

def kFresh(ctx: KCtx): String = ".tmp" + intToStr(kUnique(ctx))

def makeClsName(ctx: KCtx, bound: String): String = {
    let base = cellGet(ctx.kCurrentFn);
    let cname = base + ".inner.closure." + bound + intToStr(kUnique(ctx));
    let prev = match strMapGet(ctx.kLiftedClosures, base) {
        Some(xs) -> xs,
        None -> Nil,
    };
    strMapInsert(ctx.kLiftedClosures, base, listAppend(prev, [cname]));
    cname
}

def removeLiftedClosure(ctx: KCtx, parent: String, child: String): Void = {
    match strMapGet(ctx.kLiftedClosures, parent) {
        None -> (),
        Some(xs) -> {
            let rev = cellNew(Nil);
            let cur = cellNew(xs);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(x, r) -> {
                        if (x != child) cellSet(rev, Cons(x, cellGet(rev))) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            strMapInsert(ctx.kLiftedClosures, parent, listRev(cellGet(rev)))
        },
    }
}

def defineFn(ctx: KCtx, name: String, fnSpan: Span, scm: Scheme, params: List VarDecl, fvs: List VarDecl, body: TaggedTerm): (String, List String) = {
    if (!strMapContains(ctx.kGlobalFns, name)) {
        let fd = MkFunDef {
            fnName: name,
            fnSpan: fnSpan,
            fnScm: scm,
            fnParams: params,
            fnFvs: fvs,
            fnBody: body,
        };
        strMapInsert(ctx.kGlobalFns, name, fd);
        vecPush(ctx.kAllFnNames, name)
    } else ();
    let fvNamesRev = cellNew(Nil);
    let cur = cellNew(fvs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(vd, r) -> {
                cellSet(fvNamesRev, Cons(vd.vname, cellGet(fvNamesRev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (name, listRev(cellGet(fvNamesRev)))
}

def assocLookupScheme(xs: List (String, Scheme), key: String): Option Scheme = match xs {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else assocLookupScheme(r, key),
}

def assocLookupStr(xs: List (String, String), key: String): Option String = match xs {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else assocLookupStr(r, key),
}

def assocLookupPoly(
    xs: List (String, (String, List VarDecl, Scheme)),
    key: String
): Option (String, List VarDecl, Scheme) = match xs {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else assocLookupPoly(r, key),
}

def lookupDirectTarget(ctx: KCtx, name: String): Option String =
    match assocLookupStr(cellGet(ctx.kLocalDirect), name) {
        Some(t) -> Some(t),
        None -> strMapGet(ctx.kTopDirect, name),
    }

// Collect free local variables (present in `localEnv`) inside `tm`
def collectFvWithBound(localEnv: List (String, Scheme), tm: TaggedTerm, boundVars: List String, seen: StrMap Bool, outKeys: Cell (List String)): Void = match tm.tnode {
    TmLit(_) -> (),
    TmGlobalVar(_) -> (),
    TmVar(v) ->
        if (!listContainsStr(boundVars, v) && !strMapContains(seen, v)) {
            match assocLookupScheme(localEnv, v) {
                Some(_) -> {
                    strMapInsert(seen, v, true);
                    cellSet(outKeys, Cons(v, cellGet(outKeys)))
                },
                None -> (),
            }
        } else (),
    TmTuple(es) -> collectFvListWithBound(localEnv, es, boundVars, seen, outKeys),
    TmBlock(es) -> collectFvListWithBound(localEnv, es, boundVars, seen, outKeys),
    TmApplyDir(_, es) -> collectFvListWithBound(localEnv, es, boundVars, seen, outKeys),
    TmMakeData(_, _, es, _, _) -> collectFvListWithBound(localEnv, es, boundVars, seen, outKeys),
    TmApplyCls(c, args) -> {
        collectFvWithBound(localEnv, c, boundVars, seen, outKeys);
        collectFvListWithBound(localEnv, args, boundVars, seen, outKeys)
    },
    TmBin(_, l, r) -> {
        collectFvWithBound(localEnv, l, boundVars, seen, outKeys);
        collectFvWithBound(localEnv, r, boundVars, seen, outKeys)
    },
    TmUn(_, e) -> collectFvWithBound(localEnv, e, boundVars, seen, outKeys),
    TmGetTag(e) -> collectFvWithBound(localEnv, e, boundVars, seen, outKeys),
    TmIf(c, t, e) -> {
        collectFvWithBound(localEnv, c, boundVars, seen, outKeys);
        collectFvWithBound(localEnv, t, boundVars, seen, outKeys);
        collectFvWithBound(localEnv, e, boundVars, seen, outKeys)
    },
    TmWhile(c, b) -> {
        collectFvWithBound(localEnv, c, boundVars, seen, outKeys);
        collectFvWithBound(localEnv, b, boundVars, seen, outKeys)
    },
    TmLet(vd, val, exp) -> {
        collectFvWithBound(localEnv, val, boundVars, seen, outKeys);
        collectFvWithBound(localEnv, exp, Cons(vd.vname, boundVars), seen, outKeys)
    },
    TmMakeCls(vd, cls, exp) -> {
        let nextBound = Cons(vd.vname, boundVars);
        let curFv = cellNew(cls.clsFvs);
        while (match cellGet(curFv) { Nil -> false, _ -> true }) {
            match cellGet(curFv) {
                Cons(fvId, r) -> {
                    if (!listContainsStr(nextBound, fvId) && !strMapContains(seen, fvId)) {
                        match assocLookupScheme(localEnv, fvId) {
                            Some(_) -> {
                                strMapInsert(seen, fvId, true);
                                cellSet(outKeys, Cons(fvId, cellGet(outKeys)))
                            },
                            None -> (),
                        }
                    } else ();
                    cellSet(curFv, r)
                },
                Nil -> (),
            }
        };
        collectFvWithBound(localEnv, exp, nextBound, seen, outKeys)
    },
    TmMatch(scrut, arms) -> {
        collectFvWithBound(localEnv, scrut, boundVars, seen, outKeys);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let armBound = collectPatVarsList(a.caPat, boundVars);
                    match a.caGuard {
                        Some(g) -> collectFvWithBound(localEnv, g, armBound, seen, outKeys),
                        None -> (),
                    };
                    collectFvWithBound(localEnv, a.caBody, armBound, seen, outKeys);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
}

def collectFvListWithBound(localEnv: List (String, Scheme), es: List TaggedTerm, boundVars: List String, seen: StrMap Bool, outKeys: Cell (List String)): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectFvWithBound(localEnv, h, boundVars, seen, outKeys);
        collectFvListWithBound(localEnv, t, boundVars, seen, outKeys)
    },
}

def collectPatVarsList(pat: Pattern, acc: List String): List String = match pat {
    PatVar(v, _) -> Cons(v, acc),
    PatWild -> acc,
    PatLit(_) -> acc,
    PatTuple(ps) -> collectPatVarsInList(ps, acc),
    PatCtor(_, ps) -> collectPatVarsInList(ps, acc),
    PatStruct(_, fs) -> collectPatVarsInNamed(fs, acc),
}

def collectPatVarsInList(ps: List Pattern, acc: List String): List String = match ps {
    Nil -> acc,
    Cons(h, t) -> collectPatVarsInList(t, collectPatVarsList(h, acc)),
}

def collectPatVarsInNamed(fs: List (String, Pattern, Span, Bool), acc: List String): List String = match fs {
    Nil -> acc,
    Cons((_, p, _, _), t) -> collectPatVarsInNamed(t, collectPatVarsList(p, acc)),
}

// Pattern normalization (converts `PatStruct` -> positional `PatCtor` and collects typed local bindings)
def instantiatedVariantFields(ctx: KCtx, cname: String, scrutTy: Type): List Type =
    match strMapGet(ctx.kCtorMap, cname) {
        None -> Nil,
        Some((adtName, vinfo)) -> match strMapGet(ctx.kAdtReg, adtName) {
            None -> Nil,
            Some(ainfo) -> {
                let targs = extractTypeArgs(scrutTy);
                let sub = buildPairMap(ainfo.typeParams, targs);
                let rev = cellNew(Nil);
                let cur = cellNew(vinfo.fieldTypes);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(ft, r) -> {
                            cellSet(rev, Cons(applyExplicitSubst(ft, sub), cellGet(rev)));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                listRev(cellGet(rev))
            },
        },
    }

def listNthTypeOrVoid(ts: List Type, idx: Int): Type = match ts {
    Nil -> TyVoid,
    Cons(h, t) -> if (idx == 0) h else listNthTypeOrVoid(t, idx - 1),
}

def lookupNamedPatOrWild(named: List (String, Pattern, Span, Bool), target: String): Pattern = match named {
    Nil -> PatWild,
    Cons((k, p, _, _), r) -> if (k == target) p else lookupNamedPatOrWild(r, target),
}

def normalizeAndCollectPattern(ctx: KCtx, pat: Pattern, scrutTy: Type): (Pattern, List (String, Scheme)) = match pat {
    PatVar(v, sp) -> (PatVar(v, sp), [(v, ScmMono(scrutTy))]),
    PatWild -> (PatWild, Nil),
    PatLit(l) -> (PatLit(l), Nil),
    PatTuple(ps) -> {
        let elemTys = match scrutTy {
            TyTuple(es) -> es,
            _ -> Nil,
        };
        let normRev = cellNew(Nil);
        let bindsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(ps);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    let i = cellGet(idx);
                    let et = listNthTypeOrVoid(elemTys, i);
                    let (np, bs) = normalizeAndCollectPattern(ctx, p, et);
                    cellSet(normRev, Cons(np, cellGet(normRev)));
                    cellSet(bindsRev, listAppend(listRev(bs), cellGet(bindsRev)));
                    cellSet(idx, i + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        (PatTuple(listRev(cellGet(normRev))), listRev(cellGet(bindsRev)))
    },
    PatCtor(cname, subPats) -> {
        let ftys = instantiatedVariantFields(ctx, cname, scrutTy);
        let normRev = cellNew(Nil);
        let bindsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(subPats);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(p, r) -> {
                    let i = cellGet(idx);
                    let ft = listNthTypeOrVoid(ftys, i);
                    let (np, bs) = normalizeAndCollectPattern(ctx, p, ft);
                    cellSet(normRev, Cons(np, cellGet(normRev)));
                    cellSet(bindsRev, listAppend(listRev(bs), cellGet(bindsRev)));
                    cellSet(idx, i + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        (PatCtor(cname, listRev(cellGet(normRev))), listRev(cellGet(bindsRev)))
    },
    PatStruct(cname, namedPats) -> {
        let ftys = instantiatedVariantFields(ctx, cname, scrutTy);
        let declNames = match strMapGet(ctx.kCtorMap, cname) {
            Some((_, vi)) -> match vi.fieldNames {
                Some(ns) -> ns,
                None -> Nil,
            },
            None -> Nil,
        };
        let normRev = cellNew(Nil);
        let bindsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(declNames);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(dn, r) -> {
                    let i = cellGet(idx);
                    let subP = lookupNamedPatOrWild(namedPats, dn);
                    let ft = listNthTypeOrVoid(ftys, i);
                    let (np, bs) = normalizeAndCollectPattern(ctx, subP, ft);
                    cellSet(normRev, Cons(np, cellGet(normRev)));
                    cellSet(bindsRev, listAppend(listRev(bs), cellGet(bindsRev)));
                    cellSet(idx, i + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        (PatCtor(cname, listRev(cellGet(normRev))), listRev(cellGet(bindsRev)))
    },
}

def transLambda(ctx: KCtx, params: List VarDecl, bodyForm: Form, capFv: Bool): (List VarDecl, List VarDecl, TaggedTerm) = {
    let outerEnv = cellGet(ctx.kLocalEnv);
    let innerEnv = cellNew(outerEnv);
    let paramNames = cellNew(Nil);
    let cp = cellNew(params);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(vd, r) -> {
                cellSet(innerEnv, Cons((vd.vname, vd.vscm), cellGet(innerEnv)));
                cellSet(paramNames, Cons(vd.vname, cellGet(paramNames)));
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };
    cellSet(ctx.kLocalEnv, cellGet(innerEnv));
    let bodyTerm = transformForm(ctx, bodyForm);
    cellSet(ctx.kLocalEnv, outerEnv);

    let fvs = if (!capFv) Nil else {
        let seen: StrMap Bool = strMapNew();
        let rawKeys = cellNew(Nil);
        collectFvWithBound(outerEnv, bodyTerm, cellGet(paramNames), seen, rawKeys);
        let sortedNames = sortUniqueStrings(cellGet(rawKeys));
        let fvDeclsRev = cellNew(Nil);
        let cf = cellNew(sortedNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(vn, r) -> {
                    match assocLookupScheme(outerEnv, vn) {
                        Some(scm) -> cellSet(fvDeclsRev, Cons(MkVarDecl { vname: vn, vscm: scm }, cellGet(fvDeclsRev))),
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        listRev(cellGet(fvDeclsRev))
    };
    (params, fvs, bodyTerm)
}

def etaWrapGlobalFn(ctx: KCtx, sp: Span, fnName: String, fnScm: Scheme): Term = match schemeBody(fnScm) {
    TyArr(_, paramTys, retTy) -> {
        let clsId = makeClsName(ctx, "eta");
        let paramsRev = cellNew(Nil);
        let argsRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(paramTys);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(pt, r) -> {
                    let i = cellGet(idx);
                    let pid = ".eta_arg" + intToStr(i);
                    cellSet(paramsRev, Cons(MkVarDecl { vname: pid, vscm: ScmMono(pt) }, cellGet(paramsRev)));
                    cellSet(argsRev, Cons(MkTerm { tspan: sp, tscm: ScmMono(pt), tnode: TmVar(pid) }, cellGet(argsRev)));
                    cellSet(idx, i + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let callBody = MkTerm {
            tspan: sp,
            tscm: ScmMono(retTy),
            tnode: TmApplyDir(MkVarDecl { vname: fnName, vscm: fnScm }, listRev(cellGet(argsRev))),
        };
        let _ = defineFn(ctx, clsId, sp, fnScm, listRev(cellGet(paramsRev)), Nil, callBody);
        let tmp = kFresh(ctx);
        TmMakeCls(
            MkVarDecl { vname: tmp, vscm: fnScm },
            MkClosureSpec { clsEntry: clsId, clsFvs: Nil },
            MkTerm { tspan: sp, tscm: fnScm, tnode: TmVar(tmp) }
        )
    },
    _ -> TmVar(fnName),
}

def lookupNamedForm(fs: List (String, Form), target: String): Option Form = match fs {
    Nil -> None,
    Cons((k, v), r) -> if (k == target) Some(v) else lookupNamedForm(r, target),
}

def buildWildcardPatWithVar(len: Int, targetIdx: Int, varName: String, curIdx: Int): List Pattern =
    if (curIdx >= len) Nil
    else {
        let p = if (curIdx == targetIdx) PatVar(varName, emptySpan()) else PatWild;
        Cons(p, buildWildcardPatWithVar(len, targetIdx, varName, curIdx + 1))
    }

def listIndexOfStr(xs: List String, target: String, idx: Int): Int = match xs {
    Nil -> 0,
    Cons(h, t) -> if (h == target) idx else listIndexOfStr(t, target, idx + 1),
}

def transformFormList(ctx: KCtx, fs: List Form): List TaggedTerm = {
    let rev = cellNew(Nil);
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(f, r) -> {
                cellSet(rev, Cons(transformForm(ctx, f), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def resolveDirectCallee(ctx: KCtx, calleeExpr: Expr): Option String = match calleeExpr {
    ExVar(n) ->
        match assocLookupScheme(cellGet(ctx.kLocalEnv), n) {
            None -> Some(n),
            Some(_) -> lookupDirectTarget(ctx, n),
        },
    _ -> None,
}

def collectAstFreeLocals(
    localEnv: List (String, Scheme),
    f: Form,
    boundNames: List String,
    seen: StrMap Bool,
    outKeys: Cell (List String)
): Void = match f.node {
    ExLit(_) -> (),
    ExVar(v) ->
        if (!listContainsStr(boundNames, v) && !strMapContains(seen, v)) {
            match assocLookupScheme(localEnv, v) {
                Some(_) -> {
                    strMapInsert(seen, v, true);
                    cellSet(outKeys, Cons(v, cellGet(outKeys)))
                },
                None -> (),
            }
        } else (),
    ExTuple(es) -> collectAstFreeLocalsList(localEnv, es, boundNames, seen, outKeys),
    ExList(es) -> collectAstFreeLocalsList(localEnv, es, boundNames, seen, outKeys),
    ExBlock(es) -> collectAstFreeLocalsList(localEnv, es, boundNames, seen, outKeys),
    ExStructInit(_, fs) -> {
        let cur = cellNew(fs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, vf), r) -> {
                    collectAstFreeLocals(localEnv, vf, boundNames, seen, outKeys);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    ExApply(c, args) -> {
        collectAstFreeLocals(localEnv, c, boundNames, seen, outKeys);
        collectAstFreeLocalsList(localEnv, args, boundNames, seen, outKeys)
    },
    ExBin(_, l, r) -> {
        collectAstFreeLocals(localEnv, l, boundNames, seen, outKeys);
        collectAstFreeLocals(localEnv, r, boundNames, seen, outKeys)
    },
    ExUn(_, e) -> collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys),
    ExField(e, _) -> collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys),
    ExTry(e) -> collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys),
    ExIf(c, t, e) -> {
        collectAstFreeLocals(localEnv, c, boundNames, seen, outKeys);
        collectAstFreeLocals(localEnv, t, boundNames, seen, outKeys);
        collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys)
    },
    ExWhile(c, b) -> {
        collectAstFreeLocals(localEnv, c, boundNames, seen, outKeys);
        collectAstFreeLocals(localEnv, b, boundNames, seen, outKeys)
    },
    ExContract(fc, b) -> {
        let cr = cellNew(fc.fcRequires);
        while (match cellGet(cr) { Nil -> false, _ -> true }) {
            match cellGet(cr) { Cons((_, e), r) -> { collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys); cellSet(cr, r) }, Nil -> () }
        };
        let cd = cellNew(fc.fcDecreases);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) { Cons((_, e), r) -> { collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys); cellSet(cd, r) }, Nil -> () }
        };
        let ce = cellNew(fc.fcEnsures);
        while (match cellGet(ce) { Nil -> false, _ -> true }) {
            match cellGet(ce) {
                Cons(ec, r) -> {
                    let eb = match ec.ecBind { Some(bn) -> Cons(bn, boundNames), None -> boundNames };
                    collectAstFreeLocals(localEnv, ec.ecExpr, eb, seen, outKeys);
                    cellSet(ce, r)
                },
                Nil -> (),
            }
        };
        collectAstFreeLocals(localEnv, b, boundNames, seen, outKeys)
    },
    ExLoopContract(invs, decs, b) -> {
        let ci = cellNew(invs);
        while (match cellGet(ci) { Nil -> false, _ -> true }) {
            match cellGet(ci) { Cons((_, e), r) -> { collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys); cellSet(ci, r) }, Nil -> () }
        };
        let cd = cellNew(decs);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) { Cons((_, e), r) -> { collectAstFreeLocals(localEnv, e, boundNames, seen, outKeys); cellSet(cd, r) }, Nil -> () }
        };
        collectAstFreeLocals(localEnv, b, boundNames, seen, outKeys)
    },
    ExLet(vd, val, body) -> {
        let nextBound = Cons(vd.vname, boundNames);
        collectAstFreeLocals(localEnv, val, nextBound, seen, outKeys);
        collectAstFreeLocals(localEnv, body, nextBound, seen, outKeys)
    },
    ExAbs(ps, _, body) -> {
        let nextBound = cellNew(boundNames);
        let cp = cellNew(ps);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(pvd, r) -> {
                    cellSet(nextBound, Cons(pvd.vname, cellGet(nextBound)));
                    cellSet(cp, r)
                },
                Nil -> (),
            }
        };
        collectAstFreeLocals(localEnv, body, cellGet(nextBound), seen, outKeys)
    },
    ExMatch(s, arms) -> {
        collectAstFreeLocals(localEnv, s, boundNames, seen, outKeys);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let armBound = collectPatVarsList(a.pat, boundNames);
                    match a.guard {
                        Some(g) -> collectAstFreeLocals(localEnv, g, armBound, seen, outKeys),
                        None -> (),
                    };
                    collectAstFreeLocals(localEnv, a.body, armBound, seen, outKeys);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
}

def collectAstFreeLocalsList(
    localEnv: List (String, Scheme),
    es: List Form,
    boundNames: List String,
    seen: StrMap Bool,
    outKeys: Cell (List String)
): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectAstFreeLocals(localEnv, h, boundNames, seen, outKeys);
        collectAstFreeLocalsList(localEnv, t, boundNames, seen, outKeys)
    },
}

def isUnshadowedOldInCore(ctx: KCtx, innerBound: List String): Bool =
    !listContainsStr(innerBound, "old")
    && (match assocLookupScheme(cellGet(ctx.kLocalEnv), "old") { Some(_) -> false, None -> true })
    && !strMapContains(ctx.kTopDirect, "old")

def formMentionsAnyBound(f: Form, targets: List String, shadowed: List String): Bool = match f.node {
    ExVar(v) -> !listContainsStr(shadowed, v) && listContainsStr(targets, v),
    ExTuple(es) -> formListMentionsAnyBound(es, targets, shadowed),
    ExList(es) -> formListMentionsAnyBound(es, targets, shadowed),
    ExBlock(es) -> formListMentionsAnyBound(es, targets, shadowed),
    ExStructInit(_, fs) -> {
        let hit = cellNew(false);
        let cur = cellNew(fs);
        while (!cellGet(hit) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, vf), r) -> {
                    if (formMentionsAnyBound(vf, targets, shadowed)) cellSet(hit, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(hit)
    },
    ExApply(c, args) -> formMentionsAnyBound(c, targets, shadowed) || formListMentionsAnyBound(args, targets, shadowed),
    ExAbs(ps, _, b) -> {
        let nextSh = cellNew(shadowed);
        let cp = cellNew(ps);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(vd, r) -> { cellSet(nextSh, Cons(vd.vname, cellGet(nextSh))); cellSet(cp, r) },
                Nil -> (),
            }
        };
        formMentionsAnyBound(b, targets, cellGet(nextSh))
    },
    ExBin(_, l, r) -> formMentionsAnyBound(l, targets, shadowed) || formMentionsAnyBound(r, targets, shadowed),
    ExUn(_, e) -> formMentionsAnyBound(e, targets, shadowed),
    ExField(e, _) -> formMentionsAnyBound(e, targets, shadowed),
    ExTry(e) -> formMentionsAnyBound(e, targets, shadowed),
    ExLet(vd, v, b) ->
        formMentionsAnyBound(v, targets, shadowed)
        || formMentionsAnyBound(b, targets, Cons(vd.vname, shadowed)),
    ExIf(c, t, e) ->
        formMentionsAnyBound(c, targets, shadowed)
        || formMentionsAnyBound(t, targets, shadowed)
        || formMentionsAnyBound(e, targets, shadowed),
    ExMatch(s, arms) ->
        if (formMentionsAnyBound(s, targets, shadowed)) true
        else {
            let hit = cellNew(false);
            let cur = cellNew(arms);
            while (!cellGet(hit) && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let sh2 = collectPatVarsList(a.pat, shadowed);
                        let gHit = match a.guard {
                            Some(g) -> formMentionsAnyBound(g, targets, sh2),
                            None -> false,
                        };
                        if (gHit || formMentionsAnyBound(a.body, targets, sh2)) cellSet(hit, true) else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        },
    _ -> false,
}

def formListMentionsAnyBound(es: List Form, targets: List String, shadowed: List String): Bool = match es {
    Nil -> false,
    Cons(h, t) -> if (formMentionsAnyBound(h, targets, shadowed)) true else formListMentionsAnyBound(t, targets, shadowed),
}

def kAdtHeadAndArgs(ty: Type): (Option String, List Type) = match ty {
    TyCon(n) -> (Some(n), Nil),
    TyComp(b, a) -> {
        let (h, args) = kAdtHeadAndArgs(b);
        (h, listAppend(args, [a]))
    },
    _ -> (None, Nil),
}

def kTypeListHasMutContainer(ctx: KCtx, tys: List Type, visited: List String): Bool = match tys {
    Nil -> false,
    Cons(t, r) -> if (kTypeHasMutContainer(ctx, t, visited)) true else kTypeListHasMutContainer(ctx, r, visited),
}

def kTypeHasMutContainer(ctx: KCtx, ty: Type, visited: List String): Bool = match ty {
    TyComp(TyCon("Cell"), _) -> true,
    TyComp(TyCon("MutArray"), _) -> true,
    TyTuple(ts) -> kTypeListHasMutContainer(ctx, ts, visited),
    _ -> {
        let (hOpt, targs) = kAdtHeadAndArgs(ty);
        if (kTypeListHasMutContainer(ctx, targs, visited)) true
        else match hOpt {
            Some(adtNm) ->
                if (listContainsStr(visited, adtNm)) false
                else match strMapGet(ctx.kAdtReg, adtNm) {
                    Some(ainfo) -> {
                        let nextVis = Cons(adtNm, visited);
                        let hit = cellNew(false);
                        let cv = cellNew(ainfo.variants);
                        while (!cellGet(hit) && match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(vi, rv) -> {
                                    if (kTypeListHasMutContainer(ctx, vi.fieldTypes, nextVis)) cellSet(hit, true) else ();
                                    cellSet(cv, rv)
                                },
                                Nil -> (),
                            }
                        };
                        cellGet(hit)
                    },
                    None -> false,
                },
            None -> false,
        }
    },
}

def kTypeListCloneablePreState(ctx: KCtx, tys: List Type, depth: Int): Bool = match tys {
    Nil -> true,
    Cons(t, r) -> if (kTypeIsCloneablePreState(ctx, t, depth)) kTypeListCloneablePreState(ctx, r, depth) else false,
}

def kTypeIsCloneablePreState(ctx: KCtx, ty: Type, depth: Int): Bool =
    if (!kTypeHasMutContainer(ctx, ty, Nil)) true
    else if (depth > 6) false
    else match ty {
        TyComp(TyCon("Cell"), et) -> kTypeIsCloneablePreState(ctx, et, depth + 1),
        TyComp(TyCon("MutArray"), et) -> kTypeIsCloneablePreState(ctx, et, depth + 1),
        TyTuple(ts) -> kTypeListCloneablePreState(ctx, ts, depth + 1),
        _ -> match kAdtHeadAndArgs(ty) {
            (Some(adtNm), targs) -> match strMapGet(ctx.kAdtReg, adtNm) {
                Some(ainfo) -> {
                    let sub = buildPairMap(ainfo.typeParams, targs);
                    let ok = cellNew(true);
                    let cv = cellNew(ainfo.variants);
                    while (cellGet(ok) && match cellGet(cv) { Nil -> false, _ -> true }) {
                        match cellGet(cv) {
                            Cons(vi, rv) -> {
                                let cf = cellNew(vi.fieldTypes);
                                while (cellGet(ok) && match cellGet(cf) { Nil -> false, _ -> true }) {
                                    match cellGet(cf) {
                                        Cons(ft, rf) -> {
                                            let instFt = applyExplicitSubst(ft, sub);
                                            if (!kTypeIsCloneablePreState(ctx, instFt, depth + 1)) cellSet(ok, false) else ();
                                            cellSet(cf, rf)
                                        },
                                        Nil -> (),
                                    }
                                };
                                cellSet(cv, rv)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(ok)
                },
                None -> false,
            },
            _ -> false,
        },
    }

def mkCloneMutArrayTerm(ctx: KCtx, sp: Span, arrScm: Scheme, arrTerm: TaggedTerm, depth: Int): TaggedTerm = {
    let arrTy = schemeBody(arrScm);
    let elemTy = match arrTy {
        TyComp(_, et) -> et,
        _ -> TyCon("Int"),
    };
    let intScm = ScmMono(TyCon("Int"));
    let boolScm = ScmMono(TyCon("Bool"));
    let voidScm = ScmMono(TyVoid);
    let cellIntScm = ScmMono(TyComp(TyCon("Cell"), TyCon("Int")));

    let srcName = "__gs_old_src_" + intToStr(kUnique(ctx));
    let lenName = "__gs_old_len_" + intToStr(kUnique(ctx));
    let cpName = "__gs_old_cp_" + intToStr(kUnique(ctx));
    let idxName = "__gs_old_idx_" + intToStr(kUnique(ctx));

    let srcVar = MkTerm { tspan: sp, tscm: arrScm, tnode: TmVar(srcName) };
    let lenVar = MkTerm { tspan: sp, tscm: intScm, tnode: TmVar(lenName) };
    let cpVar = MkTerm { tspan: sp, tscm: arrScm, tnode: TmVar(cpName) };
    let idxVar = MkTerm { tspan: sp, tscm: cellIntScm, tnode: TmVar(idxName) };

    let zeroLit = MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(0)) };
    let oneLit = MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(1)) };

    let arrLenCall = MkTerm {
        tspan: sp, tscm: intScm,
        tnode: TmApplyDir(MkVarDecl { vname: "arrayLen", vscm: ScmMono(TyArr(TyVoid, [arrTy], TyCon("Int"))) }, [srcVar]),
    };
    let emptyCall = MkTerm {
        tspan: sp, tscm: arrScm,
        tnode: TmApplyDir(MkVarDecl { vname: "arrayNewZeroed", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], arrTy)) }, [zeroLit]),
    };
    let elem0Raw = MkTerm {
        tspan: sp, tscm: ScmMono(elemTy),
        tnode: TmApplyDir(MkVarDecl { vname: "arrayGet", vscm: ScmMono(TyArr(TyVoid, [arrTy, TyCon("Int")], elemTy)) }, [srcVar, zeroLit]),
    };
    let elem0Call = mkDeepClonePreStateTerm(ctx, sp, ScmMono(elemTy), elem0Raw, depth + 1);
    let allocCall = MkTerm {
        tspan: sp, tscm: arrScm,
        tnode: TmApplyDir(MkVarDecl { vname: "arrayNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int"), elemTy], arrTy)) }, [lenVar, elem0Call]),
    };
    let idxInit = MkTerm {
        tspan: sp, tscm: cellIntScm,
        tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], TyComp(TyCon("Cell"), TyCon("Int")))) }, [oneLit]),
    };
    let idxGet = () -> MkTerm {
        tspan: sp, tscm: intScm,
        tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Int"))], TyCon("Int"))) }, [idxVar]),
    };
    let elemIRaw = MkTerm {
        tspan: sp, tscm: ScmMono(elemTy),
        tnode: TmApplyDir(MkVarDecl { vname: "arrayGet", vscm: ScmMono(TyArr(TyVoid, [arrTy, TyCon("Int")], elemTy)) }, [srcVar, idxGet()]),
    };
    let elemICall = mkDeepClonePreStateTerm(ctx, sp, ScmMono(elemTy), elemIRaw, depth + 1);
    let setICall = MkTerm {
        tspan: sp, tscm: voidScm,
        tnode: TmApplyDir(MkVarDecl { vname: "arraySet", vscm: ScmMono(TyArr(TyVoid, [arrTy, TyCon("Int"), elemTy], TyVoid)) }, [cpVar, idxGet(), elemICall]),
    };
    let incExpr = MkTerm { tspan: sp, tscm: intScm, tnode: TmBin(OpAdd, idxGet(), oneLit) };
    let idxIncCall = MkTerm {
        tspan: sp, tscm: voidScm,
        tnode: TmApplyDir(MkVarDecl { vname: "cellSet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Int")), TyCon("Int")], TyVoid)) }, [idxVar, incExpr]),
    };
    let loopCond = MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpLt, idxGet(), lenVar) };
    let loopTerm = MkTerm {
        tspan: sp, tscm: voidScm,
        tnode: TmWhile(loopCond, MkTerm { tspan: sp, tscm: voidScm, tnode: TmBlock([setICall, idxIncCall]) }),
    };
    let nonEmptyBranch = MkTerm {
        tspan: sp, tscm: arrScm,
        tnode: TmLet(
            MkVarDecl { vname: cpName, vscm: arrScm },
            allocCall,
            MkTerm {
                tspan: sp, tscm: arrScm,
                tnode: TmLet(
                    MkVarDecl { vname: idxName, vscm: cellIntScm },
                    idxInit,
                    MkTerm { tspan: sp, tscm: arrScm, tnode: TmBlock([loopTerm, cpVar]) }
                ),
            }
        ),
    };
    let condZero = MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpLe, lenVar, zeroLit) };
    let branchTerm = MkTerm { tspan: sp, tscm: arrScm, tnode: TmIf(condZero, emptyCall, nonEmptyBranch) };
    MkTerm {
        tspan: sp, tscm: arrScm,
        tnode: TmLet(
            MkVarDecl { vname: srcName, vscm: arrScm },
            arrTerm,
            MkTerm {
                tspan: sp, tscm: arrScm,
                tnode: TmLet(MkVarDecl { vname: lenName, vscm: intScm }, arrLenCall, branchTerm),
            }
        ),
    }
}

def mkDeepClonePreStateTerm(ctx: KCtx, sp: Span, scm: Scheme, srcTerm: TaggedTerm, depth: Int): TaggedTerm = {
    let ty = schemeBody(scm);
    if (!kTypeHasMutContainer(ctx, ty, Nil) || depth > 6) srcTerm
    else match ty {
        TyComp(TyCon("Cell"), et) -> {
            let getCall = MkTerm {
                tspan: sp, tscm: ScmMono(et),
                tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [ty], et)) }, [srcTerm]),
            };
            let clonedInner = mkDeepClonePreStateTerm(ctx, sp, ScmMono(et), getCall, depth + 1);
            MkTerm {
                tspan: sp, tscm: scm,
                tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [et], ty)) }, [clonedInner]),
            }
        },
        TyComp(TyCon("MutArray"), _) -> mkCloneMutArrayTerm(ctx, sp, scm, srcTerm, depth),
        TyTuple(ts) -> {
            let patsRev: Cell (List Pattern) = cellNew(Nil);
            let elemsRev: Cell (List TaggedTerm) = cellNew(Nil);
            let ct = cellNew(ts);
            while (match cellGet(ct) { Nil -> false, _ -> true }) {
                match cellGet(ct) {
                    Cons(et, rt) -> {
                        let pn = "__gs_old_tp_" + intToStr(kUnique(ctx));
                        cellSet(patsRev, Cons(PatVar(pn, sp), cellGet(patsRev)));
                        let pv = MkTerm { tspan: sp, tscm: ScmMono(et), tnode: TmVar(pn) };
                        cellSet(elemsRev, Cons(mkDeepClonePreStateTerm(ctx, sp, ScmMono(et), pv, depth + 1), cellGet(elemsRev)));
                        cellSet(ct, rt)
                    },
                    Nil -> (),
                }
            };
            let arm = MkCoreArm {
                caPat: PatTuple(listRev(cellGet(patsRev))),
                caGuard: None,
                caBody: MkTerm { tspan: sp, tscm: scm, tnode: TmTuple(listRev(cellGet(elemsRev))) },
            };
            MkTerm { tspan: sp, tscm: scm, tnode: TmMatch(srcTerm, [arm]) }
        },
        _ -> match kAdtHeadAndArgs(ty) {
            (Some(adtNm), targs) -> match strMapGet(ctx.kAdtReg, adtNm) {
                Some(ainfo) -> {
                    let sub = buildPairMap(ainfo.typeParams, targs);
                    let armsRev: Cell (List CoreArm) = cellNew(Nil);
                    let cv = cellNew(ainfo.variants);
                    while (match cellGet(cv) { Nil -> false, _ -> true }) {
                        match cellGet(cv) {
                            Cons(vi, rv) -> {
                                let patsRev: Cell (List Pattern) = cellNew(Nil);
                                let ftermsRev: Cell (List TaggedTerm) = cellNew(Nil);
                                let ftysRev: Cell (List Type) = cellNew(Nil);
                                let cf = cellNew(vi.fieldTypes);
                                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                    match cellGet(cf) {
                                        Cons(ft, rf) -> {
                                            let instFt = applyExplicitSubst(ft, sub);
                                            let pn = "__gs_old_fd_" + intToStr(kUnique(ctx));
                                            cellSet(patsRev, Cons(PatVar(pn, sp), cellGet(patsRev)));
                                            let pv = MkTerm { tspan: sp, tscm: ScmMono(instFt), tnode: TmVar(pn) };
                                            cellSet(ftermsRev, Cons(mkDeepClonePreStateTerm(ctx, sp, ScmMono(instFt), pv, depth + 1), cellGet(ftermsRev)));
                                            cellSet(ftysRev, Cons(instFt, cellGet(ftysRev)));
                                            cellSet(cf, rf)
                                        },
                                        Nil -> (),
                                    }
                                };
                                let armBody = MkTerm {
                                    tspan: sp, tscm: scm,
                                    tnode: TmMakeData(adtNm, vi.tag, listRev(cellGet(ftermsRev)), listRev(cellGet(ftysRev)), targs),
                                };
                                cellSet(armsRev, Cons(MkCoreArm {
                                    caPat: PatCtor(vi.vname, listRev(cellGet(patsRev))),
                                    caGuard: None,
                                    caBody: armBody,
                                }, cellGet(armsRev)));
                                cellSet(cv, rv)
                            },
                            Nil -> (),
                        }
                    };
                    MkTerm { tspan: sp, tscm: scm, tnode: TmMatch(srcTerm, listRev(cellGet(armsRev))) }
                },
                None -> srcTerm,
            },
            _ -> srcTerm,
        },
    }
}

/// Inside `old(arg0)` in `--contracts=check`: snapshot ONLY pre-state mutable containers
/// (`Cell`, `MutArray`, or tuples/ADTs holding them) infallibly at function entry, and evaluate
/// `arg0` lazily in place inside `ensures` so short-circuit guards (`==>`, `&&`, `if`, `match`)
/// and inner quantifier binders (`old(arrayGet(a, i + cellGet(pos)))`) behave identically to `verify`.
def rewriteInsideOldForCheck(
    ctx: KCtx,
    f: Form,
    innerBound: List String,
    varSnapMap: Cell (List (String, String)),
    snapsRev: Cell (List (String, Scheme, TaggedTerm))
): Form = {
    let mk = (nd: Expr) -> MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: nd };
    match f.node {
        ExVar(vn) -> {
            let isBoundHere = listContainsStr(innerBound, vn) || strStartsWith(vn, "__gs_old_");
            let isOuterDataVar =
                (match assocLookupScheme(cellGet(ctx.kLocalEnv), vn) { Some(_) -> true, None -> false })
                || strMapContains(ctx.kGlobalValSet, vn);
            let vty = schemeBody(f.ty);
            if (!isBoundHere && isOuterDataVar && kTypeHasMutContainer(ctx, vty, Nil)) {
                if (!kTypeIsCloneablePreState(ctx, vty, 0)) {
                    match cellGet(ctx.kErr) {
                        None -> cellSet(ctx.kErr, Some(formatSpanDiagHint(
                            "contract",
                            f.pos,
                            "cannot snapshot recursive mutable container `" + vn + "` of type `" + typeToString(vty) + "` for `old(...)` in `--contracts=check` mode",
                            "read the `Cell` or `MutArray` field directly inside `old(...)` or compile with `--contracts=erase`"
                        ))),
                        Some(_) -> (),
                    };
                    f
                } else match assocLookupStr(cellGet(varSnapMap), vn) {
                    Some(existingSnap) -> MkForm { pos: f.pos, ty: f.ty, annot: None, node: ExVar(existingSnap) },
                    None -> {
                        let snapName = "__gs_old_" + intToStr(kUnique(ctx));
                        let rawVarTerm = transformForm(ctx, f);
                        let cloneTerm = mkDeepClonePreStateTerm(ctx, f.pos, f.ty, rawVarTerm, 0);
                        cellSet(snapsRev, Cons((snapName, f.ty, cloneTerm), cellGet(snapsRev)));
                        cellSet(varSnapMap, Cons((vn, snapName), cellGet(varSnapMap)));
                        MkForm { pos: f.pos, ty: f.ty, annot: None, node: ExVar(snapName) }
                    },
                }
            } else f
        },
        ExApply(callee, args) -> {
            let isOld = match callee.node {
                ExVar(nm) -> nm == "old" && isUnshadowedOldInCore(ctx, innerBound),
                _ -> false,
            };
            if (isOld) {
                match args {
                    Cons(arg0, Nil) -> rewriteInsideOldForCheck(ctx, arg0, innerBound, varSnapMap, snapsRev),
                    _ -> f,
                }
            } else {
                let rc = rewriteInsideOldForCheck(ctx, callee, innerBound, varSnapMap, snapsRev);
                let raRev: Cell (List Form) = cellNew(Nil);
                let ca = cellNew(args);
                while (match cellGet(ca) { Nil -> false, _ -> true }) {
                    match cellGet(ca) {
                        Cons(a, r) -> {
                            cellSet(raRev, Cons(rewriteInsideOldForCheck(ctx, a, innerBound, varSnapMap, snapsRev), cellGet(raRev)));
                            cellSet(ca, r)
                        },
                        Nil -> (),
                    }
                };
                mk(ExApply(rc, listRev(cellGet(raRev))))
            }
        },
        ExTuple(es) -> {
            let rev: Cell (List Form) = cellNew(Nil);
            let cur = cellNew(es);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(e, r) -> { cellSet(rev, Cons(rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExTuple(listRev(cellGet(rev))))
        },
        ExList(es) -> {
            let rev: Cell (List Form) = cellNew(Nil);
            let cur = cellNew(es);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(e, r) -> { cellSet(rev, Cons(rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExList(listRev(cellGet(rev))))
        },
        ExBlock(es) -> {
            let rev: Cell (List Form) = cellNew(Nil);
            let cur = cellNew(es);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(e, r) -> { cellSet(rev, Cons(rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExBlock(listRev(cellGet(rev))))
        },
        ExStructInit(cn, fs) -> {
            let rev: Cell (List (String, Form)) = cellNew(Nil);
            let cur = cellNew(fs);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons((k, v), r) -> { cellSet(rev, Cons((k, rewriteInsideOldForCheck(ctx, v, innerBound, varSnapMap, snapsRev)), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExStructInit(cn, listRev(cellGet(rev))))
        },
        ExAbs(ps, rt, b) -> {
            let nb = cellNew(innerBound);
            let cp = cellNew(ps);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(vd, r) -> { cellSet(nb, Cons(vd.vname, cellGet(nb))); cellSet(cp, r) },
                    Nil -> (),
                }
            };
            mk(ExAbs(ps, rt, rewriteInsideOldForCheck(ctx, b, cellGet(nb), varSnapMap, snapsRev)))
        },
        ExBin(op, l, r) -> mk(ExBin(
            op,
            rewriteInsideOldForCheck(ctx, l, innerBound, varSnapMap, snapsRev),
            rewriteInsideOldForCheck(ctx, r, innerBound, varSnapMap, snapsRev)
        )),
        ExUn(op, e) -> mk(ExUn(op, rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev))),
        ExField(e, nm) -> mk(ExField(rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev), nm)),
        ExTry(e) -> mk(ExTry(rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev))),
        ExLet(vd, v, b) -> mk(ExLet(
            vd,
            rewriteInsideOldForCheck(ctx, v, innerBound, varSnapMap, snapsRev),
            rewriteInsideOldForCheck(ctx, b, Cons(vd.vname, innerBound), varSnapMap, snapsRev)
        )),
        ExIf(c, t, e) -> mk(ExIf(
            rewriteInsideOldForCheck(ctx, c, innerBound, varSnapMap, snapsRev),
            rewriteInsideOldForCheck(ctx, t, innerBound, varSnapMap, snapsRev),
            rewriteInsideOldForCheck(ctx, e, innerBound, varSnapMap, snapsRev)
        )),
        ExMatch(s, arms) -> {
            let rs = rewriteInsideOldForCheck(ctx, s, innerBound, varSnapMap, snapsRev);
            let narmsRev: Cell (List MatchArm) = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ab = collectPatVarsList(a.pat, innerBound);
                        let ng = match a.guard { Some(g) -> Some(rewriteInsideOldForCheck(ctx, g, ab, varSnapMap, snapsRev)), None -> None };
                        let nb = rewriteInsideOldForCheck(ctx, a.body, ab, varSnapMap, snapsRev);
                        cellSet(narmsRev, Cons(MkMatchArm { pat: a.pat, guard: ng, body: nb }, cellGet(narmsRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            mk(ExMatch(rs, listRev(cellGet(narmsRev))))
        },
        _ -> f,
    }
}

def rewriteOldInFormForCheck(
    ctx: KCtx,
    f: Form,
    innerBound: List String,
    varSnapMap: Cell (List (String, String)),
    snapsRev: Cell (List (String, Scheme, TaggedTerm))
): Form = {
    let mk = (nd: Expr) -> MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: nd };
    match f.node {
        ExApply(callee, args) -> {
            let isOld = match callee.node {
                ExVar(nm) -> nm == "old" && isUnshadowedOldInCore(ctx, innerBound),
                _ -> false,
            };
            if (isOld) {
                match args {
                    Cons(arg0, Nil) -> rewriteInsideOldForCheck(ctx, arg0, innerBound, varSnapMap, snapsRev),
                    _ -> f,
                }
            } else {
                let rc = rewriteOldInFormForCheck(ctx, callee, innerBound, varSnapMap, snapsRev);
                let raRev: Cell (List Form) = cellNew(Nil);
                let ca = cellNew(args);
                while (match cellGet(ca) { Nil -> false, _ -> true }) {
                    match cellGet(ca) {
                        Cons(a, r) -> {
                            cellSet(raRev, Cons(rewriteOldInFormForCheck(ctx, a, innerBound, varSnapMap, snapsRev), cellGet(raRev)));
                            cellSet(ca, r)
                        },
                        Nil -> (),
                    }
                };
                mk(ExApply(rc, listRev(cellGet(raRev))))
            }
        },
        ExTuple(es) -> {
            let rev: Cell (List Form) = cellNew(Nil);
            let cur = cellNew(es);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(e, r) -> { cellSet(rev, Cons(rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExTuple(listRev(cellGet(rev))))
        },
        ExList(es) -> {
            let rev: Cell (List Form) = cellNew(Nil);
            let cur = cellNew(es);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(e, r) -> { cellSet(rev, Cons(rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExList(listRev(cellGet(rev))))
        },
        ExBlock(es) -> {
            let rev: Cell (List Form) = cellNew(Nil);
            let cur = cellNew(es);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(e, r) -> { cellSet(rev, Cons(rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExBlock(listRev(cellGet(rev))))
        },
        ExStructInit(cn, fs) -> {
            let rev: Cell (List (String, Form)) = cellNew(Nil);
            let cur = cellNew(fs);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons((k, v), r) -> { cellSet(rev, Cons((k, rewriteOldInFormForCheck(ctx, v, innerBound, varSnapMap, snapsRev)), cellGet(rev))); cellSet(cur, r) },
                    Nil -> (),
                }
            };
            mk(ExStructInit(cn, listRev(cellGet(rev))))
        },
        ExAbs(ps, rt, b) -> {
            let nb = cellNew(innerBound);
            let cp = cellNew(ps);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(vd, r) -> { cellSet(nb, Cons(vd.vname, cellGet(nb))); cellSet(cp, r) },
                    Nil -> (),
                }
            };
            mk(ExAbs(ps, rt, rewriteOldInFormForCheck(ctx, b, cellGet(nb), varSnapMap, snapsRev)))
        },
        ExBin(op, l, r) -> mk(ExBin(
            op,
            rewriteOldInFormForCheck(ctx, l, innerBound, varSnapMap, snapsRev),
            rewriteOldInFormForCheck(ctx, r, innerBound, varSnapMap, snapsRev)
        )),
        ExUn(op, e) -> mk(ExUn(op, rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev))),
        ExField(e, nm) -> mk(ExField(rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev), nm)),
        ExTry(e) -> mk(ExTry(rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev))),
        ExLet(vd, v, b) -> mk(ExLet(
            vd,
            rewriteOldInFormForCheck(ctx, v, innerBound, varSnapMap, snapsRev),
            rewriteOldInFormForCheck(ctx, b, Cons(vd.vname, innerBound), varSnapMap, snapsRev)
        )),
        ExIf(c, t, e) -> mk(ExIf(
            rewriteOldInFormForCheck(ctx, c, innerBound, varSnapMap, snapsRev),
            rewriteOldInFormForCheck(ctx, t, innerBound, varSnapMap, snapsRev),
            rewriteOldInFormForCheck(ctx, e, innerBound, varSnapMap, snapsRev)
        )),
        ExMatch(s, arms) -> {
            let rs = rewriteOldInFormForCheck(ctx, s, innerBound, varSnapMap, snapsRev);
            let narmsRev: Cell (List MatchArm) = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ab = collectPatVarsList(a.pat, innerBound);
                        let ng = match a.guard { Some(g) -> Some(rewriteOldInFormForCheck(ctx, g, ab, varSnapMap, snapsRev)), None -> None };
                        let nb = rewriteOldInFormForCheck(ctx, a.body, ab, varSnapMap, snapsRev);
                        cellSet(narmsRev, Cons(MkMatchArm { pat: a.pat, guard: ng, body: nb }, cellGet(narmsRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            mk(ExMatch(rs, listRev(cellGet(narmsRev))))
        },
        _ -> f,
    }
}

data QuantBoundStep {
    QbGuard(Form),
    QbLo(Form, Bool),
    QbHi(Form, Bool),
}

def collectIntQuantSteps(
    cond: Form,
    qvar: String,
    innerQVars: List String,
    stepsRev: Cell (List QuantBoundStep)
): Void = {
    let forbidVars = Cons(qvar, innerQVars);
    match cond.node {
        ExBin(OpAnd, l, r) -> {
            collectIntQuantSteps(l, qvar, innerQVars, stepsRev);
            collectIntQuantSteps(r, qvar, innerQVars, stepsRev)
        },
        ExIf(c, t, el) -> match el.node {
            ExLit(LitBool(false)) -> {
                collectIntQuantSteps(c, qvar, innerQVars, stepsRev);
                collectIntQuantSteps(t, qvar, innerQVars, stepsRev)
            },
            _ ->
                if (!formMentionsAnyBound(cond, forbidVars, Nil)) {
                    cellSet(stepsRev, Cons(QbGuard(cond), cellGet(stepsRev)))
                } else (),
        },
        ExBin(op, l, r) -> {
            let lIsVar = match l.node { ExVar(v) -> v == qvar && !listContainsStr(innerQVars, v), _ -> false };
            let rIsVar = match r.node { ExVar(v) -> v == qvar && !listContainsStr(innerQVars, v), _ -> false };
            if (lIsVar && !formMentionsAnyBound(r, forbidVars, Nil)) {
                match op {
                    OpGe -> cellSet(stepsRev, Cons(QbLo(r, false), cellGet(stepsRev))),
                    OpGt -> cellSet(stepsRev, Cons(QbLo(r, true), cellGet(stepsRev))),
                    OpLt -> cellSet(stepsRev, Cons(QbHi(r, false), cellGet(stepsRev))),
                    OpLe -> cellSet(stepsRev, Cons(QbHi(r, true), cellGet(stepsRev))),
                    _ -> (),
                }
            } else if (rIsVar && !formMentionsAnyBound(l, forbidVars, Nil)) {
                match op {
                    OpLe -> cellSet(stepsRev, Cons(QbLo(l, false), cellGet(stepsRev))),
                    OpLt -> cellSet(stepsRev, Cons(QbLo(l, true), cellGet(stepsRev))),
                    OpGt -> cellSet(stepsRev, Cons(QbHi(l, false), cellGet(stepsRev))),
                    OpGe -> cellSet(stepsRev, Cons(QbHi(l, true), cellGet(stepsRev))),
                    _ -> (),
                }
            } else if (!formMentionsAnyBound(cond, forbidVars, Nil)) {
                cellSet(stepsRev, Cons(QbGuard(cond), cellGet(stepsRev)))
            } else ()
        },
        _ ->
            if (!formMentionsAnyBound(cond, forbidVars, Nil)) {
                cellSet(stepsRev, Cons(QbGuard(cond), cellGet(stepsRev)))
            } else (),
    }
}

def peelAndCollectIntQuantSteps(
    ctx: KCtx,
    isForall: Bool,
    body: Form,
    qvar: String,
    innerQVars: List String,
    stepsRev: Cell (List QuantBoundStep)
): Void = {
    let nestedOpt: Option (String, Form) = match body.node {
        ExApply(cF, Cons(lamF, Nil)) -> match (resolveDirectCallee(ctx, cF.node), lamF.node) {
            (Some(dn), ExAbs(Cons(ivd, Nil), _, innerB)) ->
                if ((isForall && dn == "$gs$forall") || (!isForall && dn == "$gs$exists")) {
                    Some((ivd.vname, innerB))
                } else None,
            _ -> None,
        },
        _ -> None,
    };
    match nestedOpt {
        Some((ivName, innerB)) ->
            if (ivName == qvar) ()
            else peelAndCollectIntQuantSteps(ctx, isForall, innerB, qvar, Cons(ivName, innerQVars), stepsRev),
        None ->
            if (isForall) {
                match body.node {
                    ExIf(guardF, thF, elF) -> match elF.node {
                        ExLit(LitBool(true)) -> {
                            collectIntQuantSteps(guardF, qvar, innerQVars, stepsRev);
                            peelAndCollectIntQuantSteps(ctx, true, thF, qvar, innerQVars, stepsRev)
                        },
                        _ -> (),
                    },
                    ExBin(OpOr, negG, thF) -> match negG.node {
                        ExUn(UnNot, guardF) -> {
                            collectIntQuantSteps(guardF, qvar, innerQVars, stepsRev);
                            peelAndCollectIntQuantSteps(ctx, true, thF, qvar, innerQVars, stepsRev)
                        },
                        _ -> (),
                    },
                    _ -> (),
                }
            } else {
                collectIntQuantSteps(body, qvar, innerQVars, stepsRev)
            },
    }
}

def recordUnboundedQuantCheckErr(ctx: KCtx, sp: Span, isForall: Bool, vd: VarDecl): TaggedTerm = {
    let qkw = if (isForall) "forall" else "exists";
    let bty = schemeBody(vd.vscm);
    match cellGet(ctx.kErr) {
        None -> cellSet(ctx.kErr, Some(formatSpanDiagHint(
            "contract",
            sp,
            "cannot execute unbounded `" + qkw + "` quantifier over `" + typeToString(bty) + "` in `--contracts=check` mode",
            "provide finite `Int` lower and upper bounds (e.g. `0 <= " + vd.vname + " && " + vd.vname + " < n`), use `geisha verify`, or compile with `--contracts=erase`"
        ))),
        Some(_) -> (),
    };
    MkTerm { tspan: sp, tscm: ScmMono(TyCon("Bool")), tnode: TmLit(LitBool(true)) }
}

def lowerQuantifierForCheck(
    ctx: KCtx,
    sp: Span,
    isForall: Bool,
    vd: VarDecl,
    qbody: Form
): TaggedTerm = {
    let boolScm = ScmMono(TyCon("Bool"));
    let intScm = ScmMono(TyCon("Int"));
    let charScm = ScmMono(TyCon("Char"));
    let voidScm = ScmMono(TyVoid);
    let bty = schemeBody(vd.vscm);
    match bty {
        TyCon("Bool") -> {
            let savedEnv = cellGet(ctx.kLocalEnv);
            cellSet(ctx.kLocalEnv, Cons((vd.vname, boolScm), savedEnv));
            let tbFalse = transformForm(ctx, qbody);
            let tbTrue = transformForm(ctx, qbody);
            cellSet(ctx.kLocalEnv, savedEnv);
            let fLit = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(false)) };
            let tLit = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(true)) };
            let eFalse = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLet(MkVarDecl { vname: vd.vname, vscm: boolScm }, fLit, tbFalse) };
            let eTrue = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLet(MkVarDecl { vname: vd.vname, vscm: boolScm }, tLit, tbTrue) };
            MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(if (isForall) OpAnd else OpOr, eFalse, eTrue) }
        },
        TyCon("Char") -> {
            let cellIntScm = ScmMono(TyComp(TyCon("Cell"), TyCon("Int")));
            let cellBoolScm = ScmMono(TyComp(TyCon("Cell"), TyCon("Bool")));
            let idxName = "__gs_qi_" + intToStr(kUnique(ctx));
            let resName = "__gs_qr_" + intToStr(kUnique(ctx));
            let idxVar = MkTerm { tspan: sp, tscm: cellIntScm, tnode: TmVar(idxName) };
            let resVar = MkTerm { tspan: sp, tscm: cellBoolScm, tnode: TmVar(resName) };
            let savedEnv = cellGet(ctx.kLocalEnv);
            cellSet(ctx.kLocalEnv, Cons((vd.vname, charScm), savedEnv));
            let tbody = transformForm(ctx, qbody);
            cellSet(ctx.kLocalEnv, savedEnv);
            let getI = () -> MkTerm {
                tspan: sp, tscm: intScm,
                tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Int"))], TyCon("Int"))) }, [idxVar]),
            };
            let getR = () -> MkTerm {
                tspan: sp, tscm: boolScm,
                tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Bool"))], TyCon("Bool"))) }, [resVar]),
            };
            let chVal = MkTerm {
                tspan: sp, tscm: charScm,
                tnode: TmApplyDir(MkVarDecl { vname: "intToChar", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], TyCon("Char"))) }, [getI()]),
            };
            let bodyLet = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLet(MkVarDecl { vname: vd.vname, vscm: charScm }, chVal, tbody) };
            let flipVal = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(!isForall)) };
            let setRes = MkTerm {
                tspan: sp, tscm: voidScm,
                tnode: TmApplyDir(MkVarDecl { vname: "cellSet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Bool")), TyCon("Bool")], TyVoid)) }, [resVar, flipVal]),
            };
            let chkCond = if (isForall) MkTerm { tspan: sp, tscm: boolScm, tnode: TmUn(UnNot, bodyLet) } else bodyLet;
            let stepChk = MkTerm { tspan: sp, tscm: voidScm, tnode: TmIf(chkCond, setRes, mkUnitTerm(sp)) };
            let incI = MkTerm {
                tspan: sp, tscm: voidScm,
                tnode: TmApplyDir(
                    MkVarDecl { vname: "cellSet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Int")), TyCon("Int")], TyVoid)) },
                    [idxVar, MkTerm { tspan: sp, tscm: intScm, tnode: TmBin(OpAdd, getI(), MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(1)) }) }]
                ),
            };
            let keepGoing = if (isForall) getR() else MkTerm { tspan: sp, tscm: boolScm, tnode: TmUn(UnNot, getR()) };
            let inRange = MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpLt, getI(), MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(256)) }) };
            let wCond = MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpAnd, keepGoing, inRange) };
            let wLoop = MkTerm { tspan: sp, tscm: voidScm, tnode: TmWhile(wCond, MkTerm { tspan: sp, tscm: voidScm, tnode: TmBlock([stepChk, incI]) }) };
            let initI = MkTerm {
                tspan: sp, tscm: cellIntScm,
                tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], TyComp(TyCon("Cell"), TyCon("Int")))) }, [MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(0)) }]),
            };
            let initR = MkTerm {
                tspan: sp, tscm: cellBoolScm,
                tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Bool")], TyComp(TyCon("Cell"), TyCon("Bool")))) }, [MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(isForall)) }]),
            };
            MkTerm {
                tspan: sp, tscm: boolScm,
                tnode: TmLet(
                    MkVarDecl { vname: idxName, vscm: cellIntScm },
                    initI,
                    MkTerm {
                        tspan: sp, tscm: boolScm,
                        tnode: TmLet(
                            MkVarDecl { vname: resName, vscm: cellBoolScm },
                            initR,
                            MkTerm { tspan: sp, tscm: boolScm, tnode: TmBlock([wLoop, getR()]) }
                        ),
                    }
                ),
            }
        },
        TyCon("Int") -> {
            let stepsRev: Cell (List QuantBoundStep) = cellNew(Nil);
            peelAndCollectIntQuantSteps(ctx, isForall, qbody, vd.vname, Nil, stepsRev);
            let steps = listRev(cellGet(stepsRev));
            let loPick: Cell (Option (Int, Form, Bool)) = cellNew(None);
            let hiPick: Cell (Option (Int, Form, Bool)) = cellNew(None);
            let sIdx = cellNew(0);
            let cs = cellNew(steps);
            while (match cellGet(cs) { Nil -> false, _ -> true }) {
                match cellGet(cs) {
                    Cons(stp, rs) -> {
                        let k = cellGet(sIdx);
                        match stp {
                            QbLo(lf, ls) -> match cellGet(loPick) {
                                None -> cellSet(loPick, Some((k, lf, ls))),
                                Some(_) -> (),
                            },
                            QbHi(hf, hi) -> match cellGet(hiPick) {
                                None -> cellSet(hiPick, Some((k, hf, hi))),
                                Some(_) -> (),
                            },
                            QbGuard(_) -> (),
                        };
                        cellSet(sIdx, k + 1);
                        cellSet(cs, rs)
                    },
                    Nil -> (),
                }
            };
            match (cellGet(loPick), cellGet(hiPick)) {
                (Some((loIdx, loF, loStrict)), Some((hiIdx, hiF, hiIncl))) -> {
                    let cellIntScm = ScmMono(TyComp(TyCon("Cell"), TyCon("Int")));
                    let cellBoolScm = ScmMono(TyComp(TyCon("Cell"), TyCon("Bool")));
                    let savedEnv = cellGet(ctx.kLocalEnv);
                    cellSet(ctx.kLocalEnv, Cons((vd.vname, intScm), savedEnv));
                    let tbody = transformForm(ctx, qbody);
                    cellSet(ctx.kLocalEnv, savedEnv);

                    let loName = "__gs_qlo_" + intToStr(kUnique(ctx));
                    let hiName = "__gs_qhi_" + intToStr(kUnique(ctx));
                    let idxName = "__gs_qi_" + intToStr(kUnique(ctx));
                    let resName = "__gs_qr_" + intToStr(kUnique(ctx));
                    let doneName = "__gs_qdone_" + intToStr(kUnique(ctx));

                    let loVar = MkTerm { tspan: sp, tscm: intScm, tnode: TmVar(loName) };
                    let hiVar = MkTerm { tspan: sp, tscm: intScm, tnode: TmVar(hiName) };
                    let idxVar = MkTerm { tspan: sp, tscm: cellIntScm, tnode: TmVar(idxName) };
                    let resVar = MkTerm { tspan: sp, tscm: cellBoolScm, tnode: TmVar(resName) };
                    let doneVar = MkTerm { tspan: sp, tscm: cellBoolScm, tnode: TmVar(doneName) };

                    let oneLit = MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(1)) };
                    let maxIntLit = MkTerm { tspan: sp, tscm: intScm, tnode: TmLit(LitInt(2147483647)) };
                    let startVal = if (loStrict) MkTerm { tspan: sp, tscm: intScm, tnode: TmBin(OpAdd, loVar, oneLit) } else loVar;
                    let emptyRange =
                        if (loStrict && !hiIncl) {
                            MkTerm {
                                tspan: sp, tscm: boolScm,
                                tnode: TmBin(
                                    OpOr,
                                    MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpGe, loVar, hiVar) },
                                    MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpEq, loVar, maxIntLit) }
                                ),
                            }
                        } else if (loStrict && hiIncl) {
                            MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpGe, loVar, hiVar) }
                        } else if (!loStrict && !hiIncl) {
                            MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpGe, loVar, hiVar) }
                        } else {
                            MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpGt, loVar, hiVar) }
                        };

                    let getI = () -> MkTerm {
                        tspan: sp, tscm: intScm,
                        tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Int"))], TyCon("Int"))) }, [idxVar]),
                    };
                    let getR = () -> MkTerm {
                        tspan: sp, tscm: boolScm,
                        tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Bool"))], TyCon("Bool"))) }, [resVar]),
                    };
                    let getDone = () -> MkTerm {
                        tspan: sp, tscm: boolScm,
                        tnode: TmApplyDir(MkVarDecl { vname: "cellGet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Bool"))], TyCon("Bool"))) }, [doneVar]),
                    };
                    let setDoneTrue = MkTerm {
                        tspan: sp, tscm: voidScm,
                        tnode: TmApplyDir(
                            MkVarDecl { vname: "cellSet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Bool")), TyCon("Bool")], TyVoid)) },
                            [doneVar, MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(true)) }]
                        ),
                    };
                    let setResFlip = MkTerm {
                        tspan: sp, tscm: voidScm,
                        tnode: TmApplyDir(
                            MkVarDecl { vname: "cellSet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Bool")), TyCon("Bool")], TyVoid)) },
                            [resVar, MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(!isForall)) }]
                        ),
                    };
                    let bodyLet = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLet(MkVarDecl { vname: vd.vname, vscm: intScm }, getI(), tbody) };
                    let chkCond = if (isForall) MkTerm { tspan: sp, tscm: boolScm, tnode: TmUn(UnNot, bodyLet) } else bodyLet;
                    let onHit = MkTerm { tspan: sp, tscm: voidScm, tnode: TmBlock([setResFlip, setDoneTrue]) };
                    let stepChk = MkTerm { tspan: sp, tscm: voidScm, tnode: TmIf(chkCond, onHit, mkUnitTerm(sp)) };

                    let incI = MkTerm {
                        tspan: sp, tscm: voidScm,
                        tnode: TmApplyDir(
                            MkVarDecl { vname: "cellSet", vscm: ScmMono(TyArr(TyVoid, [TyComp(TyCon("Cell"), TyCon("Int")), TyCon("Int")], TyVoid)) },
                            [idxVar, MkTerm { tspan: sp, tscm: intScm, tnode: TmBin(OpAdd, getI(), oneLit) }]
                        ),
                    };
                    let stopAtEnd =
                        if (hiIncl) MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpGe, getI(), hiVar) }
                        else MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(OpGe, MkTerm { tspan: sp, tscm: intScm, tnode: TmBin(OpAdd, getI(), oneLit) }, hiVar) };
                    let advTerm = MkTerm { tspan: sp, tscm: voidScm, tnode: TmIf(stopAtEnd, setDoneTrue, incI) };
                    let inBound = MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(if (hiIncl) OpLe else OpLt, getI(), hiVar) };
                    let wCond = MkTerm {
                        tspan: sp, tscm: boolScm,
                        tnode: TmBin(OpAnd, MkTerm { tspan: sp, tscm: boolScm, tnode: TmUn(UnNot, getDone()) }, inBound),
                    };
                    let wLoop = MkTerm { tspan: sp, tscm: voidScm, tnode: TmWhile(wCond, MkTerm { tspan: sp, tscm: voidScm, tnode: TmBlock([stepChk, advTerm]) }) };

                    let initI = MkTerm {
                        tspan: sp, tscm: cellIntScm,
                        tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], TyComp(TyCon("Cell"), TyCon("Int")))) }, [startVal]),
                    };
                    let initR = MkTerm {
                        tspan: sp, tscm: cellBoolScm,
                        tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Bool")], TyComp(TyCon("Cell"), TyCon("Bool")))) }, [MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(isForall)) }]),
                    };
                    let initDone = MkTerm {
                        tspan: sp, tscm: cellBoolScm,
                        tnode: TmApplyDir(MkVarDecl { vname: "cellNew", vscm: ScmMono(TyArr(TyVoid, [TyCon("Bool")], TyComp(TyCon("Cell"), TyCon("Bool")))) }, [emptyRange]),
                    };

                    let loopInner = MkTerm {
                        tspan: sp, tscm: boolScm,
                        tnode: TmLet(
                            MkVarDecl { vname: idxName, vscm: cellIntScm },
                            initI,
                            MkTerm {
                                tspan: sp, tscm: boolScm,
                                tnode: TmLet(
                                    MkVarDecl { vname: resName, vscm: cellBoolScm },
                                    initR,
                                    MkTerm {
                                        tspan: sp, tscm: boolScm,
                                        tnode: TmLet(
                                            MkVarDecl { vname: doneName, vscm: cellBoolScm },
                                            initDone,
                                            MkTerm { tspan: sp, tscm: boolScm, tnode: TmBlock([wLoop, getR()]) }
                                        ),
                                    }
                                ),
                            }
                        ),
                    };

                    // Wrap `loopInner` right-to-left over `steps[0 .. max(loIdx, hiIdx)]` so independent
                    // short-circuit guards (e.g. `x > 0 && 0 <= i && i < positive(x)`) run BEFORE bound expressions!
                    let maxBIdx = if (loIdx > hiIdx) loIdx else hiIdx;
                    let selectedRev: Cell (List QuantBoundStep) = cellNew(Nil);
                    let pIdx = cellNew(0);
                    let cpSteps = cellNew(steps);
                    while (cellGet(pIdx) <= maxBIdx && match cellGet(cpSteps) { Nil -> false, _ -> true }) {
                        match cellGet(cpSteps) {
                            Cons(stItem, rSteps) -> {
                                let k = cellGet(pIdx);
                                if (k == loIdx) {
                                    cellSet(selectedRev, Cons(QbLo(loF, loStrict), cellGet(selectedRev)))
                                } else if (k == hiIdx) {
                                    cellSet(selectedRev, Cons(QbHi(hiF, hiIncl), cellGet(selectedRev)))
                                } else {
                                    match stItem {
                                        QbGuard(gf) -> cellSet(selectedRev, Cons(QbGuard(gf), cellGet(selectedRev))),
                                        _ -> (),
                                    }
                                };
                                cellSet(pIdx, k + 1);
                                cellSet(cpSteps, rSteps)
                            },
                            Nil -> (),
                        }
                    };
                    let wrapped = cellNew(loopInner);
                    let cWrap = cellNew(cellGet(selectedRev));
                    while (match cellGet(cWrap) { Nil -> false, _ -> true }) {
                        match cellGet(cWrap) {
                            Cons(wStep, rWrap) -> {
                                match wStep {
                                    QbLo(lf, _) -> {
                                        let lt = transformForm(ctx, lf);
                                        cellSet(wrapped, MkTerm {
                                            tspan: sp, tscm: boolScm,
                                            tnode: TmLet(MkVarDecl { vname: loName, vscm: intScm }, lt, cellGet(wrapped)),
                                        })
                                    },
                                    QbHi(hf, _) -> {
                                        let ht = transformForm(ctx, hf);
                                        cellSet(wrapped, MkTerm {
                                            tspan: sp, tscm: boolScm,
                                            tnode: TmLet(MkVarDecl { vname: hiName, vscm: intScm }, ht, cellGet(wrapped)),
                                        })
                                    },
                                    QbGuard(gf) -> {
                                        let gt = transformForm(ctx, gf);
                                        let vacuousLit = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLit(LitBool(isForall)) };
                                        cellSet(wrapped, MkTerm {
                                            tspan: sp, tscm: boolScm,
                                            tnode: TmIf(gt, cellGet(wrapped), vacuousLit),
                                        })
                                    },
                                };
                                cellSet(cWrap, rWrap)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(wrapped)
                },
                _ -> recordUnboundedQuantCheckErr(ctx, sp, isForall, vd),
            }
        },
        _ -> {
            // Support finite fieldless enum ADTs (`data Color { Red, Green, Blue }`) in `--contracts=check` too!
            let (hOpt, targs) = kAdtHeadAndArgs(bty);
            let enumVariantsOpt: Option (String, List VariantInfo) = match hOpt {
                Some(adtNm) -> match strMapGet(ctx.kAdtReg, adtNm) {
                    Some(ainfo) -> match ainfo.variants {
                        Nil -> None,
                        vs -> {
                            let allNullary = cellNew(true);
                            let cv = cellNew(vs);
                            while (cellGet(allNullary) && match cellGet(cv) { Nil -> false, _ -> true }) {
                                match cellGet(cv) {
                                    Cons(vi, rv) -> {
                                        match vi.fieldTypes { Nil -> (), _ -> cellSet(allNullary, false) };
                                        cellSet(cv, rv)
                                    },
                                    Nil -> (),
                                }
                            };
                            if (cellGet(allNullary)) Some((adtNm, vs)) else None
                        },
                    },
                    None -> None,
                },
                None -> None,
            };
            match enumVariantsOpt {
                Some((adtNm, vs)) -> {
                    let enumScm = ScmMono(bty);
                    let accOpt: Cell (Option TaggedTerm) = cellNew(None);
                    let cv = cellNew(vs);
                    while (match cellGet(cv) { Nil -> false, _ -> true }) {
                        match cellGet(cv) {
                            Cons(vi, rv) -> {
                                let savedEnv = cellGet(ctx.kLocalEnv);
                                cellSet(ctx.kLocalEnv, Cons((vd.vname, enumScm), savedEnv));
                                let tb = transformForm(ctx, qbody);
                                cellSet(ctx.kLocalEnv, savedEnv);
                                let ctorVal = MkTerm { tspan: sp, tscm: enumScm, tnode: TmMakeData(adtNm, vi.tag, Nil, Nil, targs) };
                                let armTerm = MkTerm { tspan: sp, tscm: boolScm, tnode: TmLet(MkVarDecl { vname: vd.vname, vscm: enumScm }, ctorVal, tb) };
                                cellSet(accOpt, match cellGet(accOpt) {
                                    None -> Some(armTerm),
                                    Some(prev) -> Some(MkTerm { tspan: sp, tscm: boolScm, tnode: TmBin(if (isForall) OpAnd else OpOr, prev, armTerm) }),
                                });
                                cellSet(cv, rv)
                            },
                            Nil -> (),
                        }
                    };
                    match cellGet(accOpt) {
                        Some(resT) -> resT,
                        None -> recordUnboundedQuantCheckErr(ctx, sp, isForall, vd),
                    }
                },
                None -> recordUnboundedQuantCheckErr(ctx, sp, isForall, vd),
            }
        },
    }
}

def transformForm(ctx: KCtx, form: Form): TaggedTerm = {
    let tform = form.ty;
    match form.node {
        ExLit(l) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmLit(l) },
        ExTuple(es) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmTuple(transformFormList(ctx, es)) },
        ExBlock(es) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmBlock(transformFormList(ctx, es)) },
        ExUn(op, e) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmUn(op, transformForm(ctx, e)) },
        ExBin(op, l, r) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmBin(op, transformForm(ctx, l), transformForm(ctx, r)) },
        ExIf(c, t, e) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmIf(transformForm(ctx, c), transformForm(ctx, t), transformForm(ctx, e)) },
        ExWhile(c, b) -> {
            let tc = transformForm(ctx, c);
            match b.node {
                ExLoopContract(invs, decs, innerBody) ->
                    if (ctx.kContractMode == "erase") {
                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmWhile(tc, transformForm(ctx, innerBody)) }
                    } else if (ctx.kContractMode == "check") {
                        let invChecksRev: Cell (List TaggedTerm) = cellNew(Nil);
                        let ci = cellNew(invs);
                        while (match cellGet(ci) { Nil -> false, _ -> true }) {
                            match cellGet(ci) {
                                Cons((isp, ie), r) -> {
                                    cellSet(invChecksRev, Cons(mkContractCheckTerm(isp, "invariant", transformForm(ctx, ie)), cellGet(invChecksRev)));
                                    cellSet(ci, r)
                                },
                                Nil -> (),
                            }
                        };
                        let invChecks = listRev(cellGet(invChecksRev));
                        let tb = transformForm(ctx, innerBody);
                        // Wrap loop body with decreases nonneg + strict decrease checks + invariant checks
                        let bodyWithDec = match decs {
                            Nil -> MkTerm { tspan: b.pos, tscm: b.ty, tnode: TmBlock(listAppend([tb], invChecks)) },
                            Cons((dsp, de), _) -> {
                                let dName = "__gs_dec_" + intToStr(kUnique(ctx));
                                let dVd = MkVarDecl { vname: dName, vscm: ScmMono(TyCon("Int")) };
                                let dVar = MkTerm { tspan: dsp, tscm: ScmMono(TyCon("Int")), tnode: TmVar(dName) };
                                let dBefore = transformForm(ctx, de);
                                let dAfter = transformForm(ctx, de);
                                let nonNegChk = mkDecreasesCheckTerm(dsp, dVar);
                                let decCond = MkTerm { tspan: dsp, tscm: ScmMono(TyCon("Bool")), tnode: TmBin(OpLt, dAfter, dVar) };
                                let stepChk = mkContractCheckTerm(dsp, "decreases", decCond);
                                let innerSeq = MkTerm {
                                    tspan: b.pos, tscm: b.ty,
                                    tnode: TmBlock(listAppend([nonNegChk, tb, stepChk], invChecks)),
                                };
                                MkTerm { tspan: b.pos, tscm: b.ty, tnode: TmLet(dVd, dBefore, innerSeq) }
                            },
                        };
                        let wTerm = MkTerm { tspan: form.pos, tscm: tform, tnode: TmWhile(tc, bodyWithDec) };
                        match invChecks {
                            Nil -> wTerm,
                            _ -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmBlock(listAppend(invChecks, [wTerm])) },
                        }
                    } else {
                        // `keep` mode for `geisha verify`: canonical order [invs..., decs..., innerBody]
                        let stmtsRev: Cell (List TaggedTerm) = cellNew(Nil);
                        let ci = cellNew(invs);
                        while (match cellGet(ci) { Nil -> false, _ -> true }) {
                            match cellGet(ci) {
                                Cons((isp, ie), r) -> {
                                    let ivd = MkVarDecl { vname: "__gs_invariant", vscm: ScmMono(TyArr(TyVoid, [TyCon("Bool")], TyVoid)) };
                                    cellSet(stmtsRev, Cons(MkTerm { tspan: isp, tscm: ScmMono(TyVoid), tnode: TmApplyDir(ivd, [transformForm(ctx, ie)]) }, cellGet(stmtsRev)));
                                    cellSet(ci, r)
                                },
                                Nil -> (),
                            }
                        };
                        let cd = cellNew(decs);
                        while (match cellGet(cd) { Nil -> false, _ -> true }) {
                            match cellGet(cd) {
                                Cons((dsp, de), r) -> {
                                    let dvd = MkVarDecl { vname: "__gs_decreases", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], TyVoid)) };
                                    cellSet(stmtsRev, Cons(MkTerm { tspan: dsp, tscm: ScmMono(TyVoid), tnode: TmApplyDir(dvd, [transformForm(ctx, de)]) }, cellGet(stmtsRev)));
                                    cellSet(cd, r)
                                },
                                Nil -> (),
                            }
                        };
                        let tb = transformForm(ctx, innerBody);
                        let loopBody = MkTerm { tspan: b.pos, tscm: b.ty, tnode: TmBlock(listAppend(listRev(cellGet(stmtsRev)), [tb])) };
                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmWhile(tc, loopBody) }
                    },
                _ -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmWhile(tc, transformForm(ctx, b)) },
            }
        },
        ExContract(fc, innerBody) ->
            if (ctx.kContractMode == "erase") {
                transformForm(ctx, innerBody)
            } else if (ctx.kContractMode == "check") {
                let prefixRev: Cell (List TaggedTerm) = cellNew(Nil);
                let cr = cellNew(fc.fcRequires);
                while (match cellGet(cr) { Nil -> false, _ -> true }) {
                    match cellGet(cr) {
                        Cons((rsp, re), r) -> {
                            cellSet(prefixRev, Cons(mkContractCheckTerm(rsp, "requires", transformForm(ctx, re)), cellGet(prefixRev)));
                            cellSet(cr, r)
                        },
                        Nil -> (),
                    }
                };
                let cd = cellNew(fc.fcDecreases);
                while (match cellGet(cd) { Nil -> false, _ -> true }) {
                    match cellGet(cd) {
                        Cons((dsp, de), r) -> {
                            cellSet(prefixRev, Cons(mkDecreasesCheckTerm(dsp, transformForm(ctx, de)), cellGet(prefixRev)));
                            cellSet(cd, r)
                        },
                        Nil -> (),
                    }
                };
                // Snapshot any pre-state mutable containers referenced inside `old(...)` BEFORE executing `innerBody`!
                let oldSnapsRev: Cell (List (String, Scheme, TaggedTerm)) = cellNew(Nil);
                let oldVarSnapMap: Cell (List (String, String)) = cellNew(Nil);
                let rewrittenEnsRev: Cell (List EnsuresClause) = cellNew(Nil);
                let ce0 = cellNew(fc.fcEnsures);
                while (match cellGet(ce0) { Nil -> false, _ -> true }) {
                    match cellGet(ce0) {
                        Cons(ec, r) -> {
                            let initInner = match ec.ecBind { Some(bn) -> [bn], None -> Nil };
                            let rwE = rewriteOldInFormForCheck(ctx, ec.ecExpr, initInner, oldVarSnapMap, oldSnapsRev);
                            cellSet(rewrittenEnsRev, Cons(MkEnsuresClause { ecBind: ec.ecBind, ecSpan: ec.ecSpan, ecExpr: rwE }, cellGet(rewrittenEnsRev)));
                            cellSet(ce0, r)
                        },
                        Nil -> (),
                    }
                };
                let oldSnaps = listRev(cellGet(oldSnapsRev));
                let rewrittenEns = listRev(cellGet(rewrittenEnsRev));
                let tBody = transformForm(ctx, innerBody);
                let savedOuterEnv = cellGet(ctx.kLocalEnv);
                let csEnv = cellNew(oldSnaps);
                while (match cellGet(csEnv) { Nil -> false, _ -> true }) {
                    match cellGet(csEnv) {
                        Cons((snm, sscm, _), rs) -> {
                            cellSet(ctx.kLocalEnv, Cons((snm, sscm), cellGet(ctx.kLocalEnv)));
                            cellSet(csEnv, rs)
                        },
                        Nil -> (),
                    }
                };
                let bodyWithEns0 = match rewrittenEns {
                    Nil -> tBody,
                    ensList -> {
                        let resVd = MkVarDecl { vname: "__gs_res", vscm: tBody.tscm };
                        let resVar = MkTerm { tspan: innerBody.pos, tscm: tBody.tscm, tnode: TmVar("__gs_res") };
                        let ensChecksRev: Cell (List TaggedTerm) = cellNew(Nil);
                        let ce = cellNew(ensList);
                        while (match cellGet(ce) { Nil -> false, _ -> true }) {
                            match cellGet(ce) {
                                Cons(ec, r) -> {
                                    let savedEnv = cellGet(ctx.kLocalEnv);
                                    let chk = match ec.ecBind {
                                        Some(bn) -> {
                                            cellSet(ctx.kLocalEnv, Cons((bn, tBody.tscm), savedEnv));
                                            let te = transformForm(ctx, ec.ecExpr);
                                            cellSet(ctx.kLocalEnv, savedEnv);
                                            let bvd = MkVarDecl { vname: bn, vscm: tBody.tscm };
                                            MkTerm { tspan: ec.ecSpan, tscm: ScmMono(TyVoid), tnode: TmLet(bvd, resVar, mkContractCheckTerm(ec.ecSpan, "ensures", te)) }
                                        },
                                        None -> mkContractCheckTerm(ec.ecSpan, "ensures", transformForm(ctx, ec.ecExpr)),
                                    };
                                    cellSet(ensChecksRev, Cons(chk, cellGet(ensChecksRev)));
                                    cellSet(ce, r)
                                },
                                Nil -> (),
                            }
                        };
                        let after = MkTerm {
                            tspan: innerBody.pos, tscm: tBody.tscm,
                            tnode: TmBlock(listAppend(listRev(cellGet(ensChecksRev)), [resVar])),
                        };
                        MkTerm { tspan: innerBody.pos, tscm: tBody.tscm, tnode: TmLet(resVd, tBody, after) }
                    },
                };
                cellSet(ctx.kLocalEnv, savedOuterEnv);
                let bodyWithEns = {
                    let acc = cellNew(bodyWithEns0);
                    let csRev = cellNew(listRev(oldSnaps));
                    while (match cellGet(csRev) { Nil -> false, _ -> true }) {
                        match cellGet(csRev) {
                            Cons((snm, sscm, sterm), rs) -> {
                                cellSet(acc, MkTerm {
                                    tspan: form.pos,
                                    tscm: tBody.tscm,
                                    tnode: TmLet(MkVarDecl { vname: snm, vscm: sscm }, sterm, cellGet(acc)),
                                });
                                cellSet(csRev, rs)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(acc)
                };
                match cellGet(prefixRev) {
                    Nil -> bodyWithEns,
                    pr -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmBlock(listAppend(listRev(pr), [bodyWithEns])) },
                }
            } else {
                // `keep` mode for `geisha verify`
                let prefixRev: Cell (List TaggedTerm) = cellNew(Nil);
                let cr = cellNew(fc.fcRequires);
                while (match cellGet(cr) { Nil -> false, _ -> true }) {
                    match cellGet(cr) {
                        Cons((rsp, re), r) -> {
                            let rvd = MkVarDecl { vname: "__gs_requires", vscm: ScmMono(TyArr(TyVoid, [TyCon("Bool")], TyVoid)) };
                            cellSet(prefixRev, Cons(MkTerm { tspan: rsp, tscm: ScmMono(TyVoid), tnode: TmApplyDir(rvd, [transformForm(ctx, re)]) }, cellGet(prefixRev)));
                            cellSet(cr, r)
                        },
                        Nil -> (),
                    }
                };
                let cd = cellNew(fc.fcDecreases);
                while (match cellGet(cd) { Nil -> false, _ -> true }) {
                    match cellGet(cd) {
                        Cons((dsp, de), r) -> {
                            let dvd = MkVarDecl { vname: "__gs_decreases", vscm: ScmMono(TyArr(TyVoid, [TyCon("Int")], TyVoid)) };
                            cellSet(prefixRev, Cons(MkTerm { tspan: dsp, tscm: ScmMono(TyVoid), tnode: TmApplyDir(dvd, [transformForm(ctx, de)]) }, cellGet(prefixRev)));
                            cellSet(cd, r)
                        },
                        Nil -> (),
                    }
                };
                let tBody = transformForm(ctx, innerBody);
                let bodyWithEns = match fc.fcEnsures {
                    Nil -> tBody,
                    ensList -> {
                        let resVd = MkVarDecl { vname: "__gs_res", vscm: tBody.tscm };
                        let resVar = MkTerm { tspan: innerBody.pos, tscm: tBody.tscm, tnode: TmVar("__gs_res") };
                        let ensStmtsRev: Cell (List TaggedTerm) = cellNew(Nil);
                        let ce = cellNew(ensList);
                        while (match cellGet(ce) { Nil -> false, _ -> true }) {
                            match cellGet(ce) {
                                Cons(ec, r) -> {
                                    let evd = MkVarDecl { vname: "__gs_ensures", vscm: ScmMono(TyArr(TyVoid, [TyCon("Bool")], TyVoid)) };
                                    let savedEnv = cellGet(ctx.kLocalEnv);
                                    let st = match ec.ecBind {
                                        Some(bn) -> {
                                            cellSet(ctx.kLocalEnv, Cons((bn, tBody.tscm), savedEnv));
                                            let te = transformForm(ctx, ec.ecExpr);
                                            cellSet(ctx.kLocalEnv, savedEnv);
                                            let callE = MkTerm { tspan: ec.ecSpan, tscm: ScmMono(TyVoid), tnode: TmApplyDir(evd, [te]) };
                                            let bvd = MkVarDecl { vname: bn, vscm: tBody.tscm };
                                            MkTerm { tspan: ec.ecSpan, tscm: ScmMono(TyVoid), tnode: TmLet(bvd, resVar, callE) }
                                        },
                                        None -> MkTerm { tspan: ec.ecSpan, tscm: ScmMono(TyVoid), tnode: TmApplyDir(evd, [transformForm(ctx, ec.ecExpr)]) },
                                    };
                                    cellSet(ensStmtsRev, Cons(st, cellGet(ensStmtsRev)));
                                    cellSet(ce, r)
                                },
                                Nil -> (),
                            }
                        };
                        let after = MkTerm {
                            tspan: innerBody.pos, tscm: tBody.tscm,
                            tnode: TmBlock(listAppend(listRev(cellGet(ensStmtsRev)), [resVar])),
                        };
                        MkTerm { tspan: innerBody.pos, tscm: tBody.tscm, tnode: TmLet(resVd, tBody, after) }
                    },
                };
                MkTerm { tspan: form.pos, tscm: tform, tnode: TmBlock(listAppend(listRev(cellGet(prefixRev)), [bodyWithEns])) }
            },
        ExLoopContract(_, _, innerBody) -> transformForm(ctx, innerBody),
        ExTry(e) -> transformForm(ctx, e),

        ExStructInit(cname, namedFields) -> match strMapGet(ctx.kCtorMap, cname) {
            None -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmLit(LitInt(0)) },
            Some((adtName, vinfo)) -> {
                let declNames = match vinfo.fieldNames {
                    Some(ns) -> ns,
                    None -> Nil,
                };
                let termsRev = cellNew(Nil);
                let ftysRev = cellNew(Nil);
                let cur = cellNew(declNames);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(dn, r) -> {
                            match lookupNamedForm(namedFields, dn) {
                                Some(ff) -> {
                                    let tt = transformForm(ctx, ff);
                                    cellSet(ftysRev, Cons(schemeBody(tt.tscm), cellGet(ftysRev)));
                                    cellSet(termsRev, Cons(tt, cellGet(termsRev)))
                                },
                                None -> (),
                            };
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                let targs = extractTypeArgs(schemeBody(tform));
                MkTerm {
                    tspan: form.pos,
                    tscm: tform,
                    tnode: TmMakeData(adtName, vinfo.tag, listRev(cellGet(termsRev)), listRev(cellGet(ftysRev)), targs),
                }
            },
        },

        ExList(elems) -> {
            let listTy = schemeBody(tform);
            let targs = extractTypeArgs(listTy);
            let elemTy = match targs {
                Cons(et, _) -> et,
                Nil -> TyVoid,
            };
            let nilTag = match strMapGet(ctx.kCtorMap, "Nil") {
                Some((_, vi)) -> vi.tag,
                None -> 0,
            };
            let consTag = match strMapGet(ctx.kCtorMap, "Cons") {
                Some((_, vi)) -> vi.tag,
                None -> 1,
            };
            let transElems = transformFormList(ctx, elems);
            let revElems = listRev(transElems);
            let acc = cellNew(MkTerm {
                tspan: form.pos,
                tscm: ScmMono(listTy),
                tnode: TmMakeData("List", nilTag, Nil, Nil, targs),
            });
            let cur = cellNew(revElems);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(ht, r) -> {
                        cellSet(acc, MkTerm {
                            tspan: form.pos,
                            tscm: ScmMono(listTy),
                            tnode: TmMakeData("List", consTag, [ht, cellGet(acc)], [elemTy, listTy], targs),
                        });
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(acc)
        },

        ExField(base, fieldName) -> {
            let baseTy = schemeBody(base.ty);
            let curr = cellNew(baseTy);
            while (match cellGet(curr) { TyComp(_, _) -> true, _ -> false }) {
                match cellGet(curr) {
                    TyComp(b, _) -> cellSet(curr, b),
                    _ -> (),
                }
            };
            let adtName = match cellGet(curr) {
                TyCon(n) -> n,
                _ -> "",
            };
            match strMapGet(ctx.kAdtReg, adtName) {
                Some(ainfo) -> match ainfo.variants {
                    Cons(vinfo, _) -> {
                        let declNames = match vinfo.fieldNames {
                            Some(ns) -> ns,
                            None -> Nil,
                        };
                        let idx = listIndexOfStr(declNames, fieldName, 0);
                        let baseTerm = transformForm(ctx, base);
                        let resId = kFresh(ctx);
                        let pats = buildWildcardPatWithVar(listLen(declNames), idx, resId, 0);
                        let arm = MkCoreArm {
                            caPat: PatCtor(vinfo.vname, pats),
                            caGuard: None,
                            caBody: MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(resId) },
                        };
                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmMatch(baseTerm, [arm]) }
                    },
                    Nil -> transformForm(ctx, base),
                },
                None -> transformForm(ctx, base),
            }
        },

        ExVar(varName) -> {
            // 1. ADT constructor?
            match strMapGet(ctx.kCtorMap, varName) {
                Some((adtName, vinfo)) ->
                    match vinfo.fieldTypes {
                        Nil -> {
                            let targs = extractTypeArgs(schemeBody(tform));
                            MkTerm { tspan: form.pos, tscm: tform, tnode: TmMakeData(adtName, vinfo.tag, Nil, Nil, targs) }
                        },
                        _ -> match schemeBody(tform) {
                            TyArr(_, paramTys, retTy) -> {
                                let clsId = makeClsName(ctx, "ctor");
                                let paramsRev = cellNew(Nil);
                                let fieldsRev = cellNew(Nil);
                                let idx = cellNew(0);
                                let cur = cellNew(paramTys);
                                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                                    match cellGet(cur) {
                                        Cons(pt, r) -> {
                                            let i = cellGet(idx);
                                            let pid = ".ctor_arg" + intToStr(i);
                                            cellSet(paramsRev, Cons(MkVarDecl { vname: pid, vscm: ScmMono(pt) }, cellGet(paramsRev)));
                                            cellSet(fieldsRev, Cons(MkTerm { tspan: form.pos, tscm: ScmMono(pt), tnode: TmVar(pid) }, cellGet(fieldsRev)));
                                            cellSet(idx, i + 1);
                                            cellSet(cur, r)
                                        },
                                        Nil -> (),
                                    }
                                };
                                let targs = extractTypeArgs(retTy);
                                let body = MkTerm {
                                    tspan: form.pos,
                                    tscm: ScmMono(retTy),
                                    tnode: TmMakeData(adtName, vinfo.tag, listRev(cellGet(fieldsRev)), paramTys, targs),
                                };
                                let _ = defineFn(ctx, clsId, form.pos, tform, listRev(cellGet(paramsRev)), Nil, body);
                                let tmp = kFresh(ctx);
                                MkTerm {
                                    tspan: form.pos,
                                    tscm: tform,
                                    tnode: TmMakeCls(
                                        MkVarDecl { vname: tmp, vscm: tform },
                                        MkClosureSpec { clsEntry: clsId, clsFvs: Nil },
                                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(tmp) }
                                    ),
                                }
                            },
                            _ -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(varName) },
                        },
                    },
                None -> {
                    // 2. Lambda-lifted polymorphic local `let` function referenced as first-class value?
                    match assocLookupPoly(cellGet(ctx.kPolyLifted), varName) {
                        Some((liftedFnId, fvDecls, liftedScm)) -> match schemeBody(tform) {
                            TyArr(_, paramTys, retTy) -> {
                                let etaId = makeClsName(ctx, "poly_eta");
                                let paramsRev = cellNew(Nil);
                                let allArgsRev = cellNew(Nil);
                                let fvIdsRev = cellNew(Nil);
                                let cf = cellNew(fvDecls);
                                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                    match cellGet(cf) {
                                        Cons(fvd, r) -> {
                                            cellSet(allArgsRev, Cons(MkTerm { tspan: form.pos, tscm: fvd.vscm, tnode: TmVar(fvd.vname) }, cellGet(allArgsRev)));
                                            cellSet(fvIdsRev, Cons(fvd.vname, cellGet(fvIdsRev)));
                                            cellSet(cf, r)
                                        },
                                        Nil -> (),
                                    }
                                };
                                let idx = cellNew(0);
                                let cp = cellNew(paramTys);
                                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                    match cellGet(cp) {
                                        Cons(pt, r) -> {
                                            let i = cellGet(idx);
                                            let pid = ".poly_eta_arg" + intToStr(i);
                                            cellSet(paramsRev, Cons(MkVarDecl { vname: pid, vscm: ScmMono(pt) }, cellGet(paramsRev)));
                                            cellSet(allArgsRev, Cons(MkTerm { tspan: form.pos, tscm: ScmMono(pt), tnode: TmVar(pid) }, cellGet(allArgsRev)));
                                            cellSet(idx, i + 1);
                                            cellSet(cp, r)
                                        },
                                        Nil -> (),
                                    }
                                };
                                let callBody = MkTerm {
                                    tspan: form.pos,
                                    tscm: ScmMono(retTy),
                                    tnode: TmApplyDir(MkVarDecl { vname: liftedFnId, vscm: liftedScm }, listRev(cellGet(allArgsRev))),
                                };
                                let _ = defineFn(ctx, etaId, form.pos, tform, listRev(cellGet(paramsRev)), fvDecls, callBody);
                                let tmp = kFresh(ctx);
                                MkTerm {
                                    tspan: form.pos,
                                    tscm: tform,
                                    tnode: TmMakeCls(
                                        MkVarDecl { vname: tmp, vscm: tform },
                                        MkClosureSpec { clsEntry: etaId, clsFvs: listRev(cellGet(fvIdsRev)) },
                                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(tmp) }
                                    ),
                                }
                            },
                            _ -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(varName) },
                        },
                        None -> {
                            // 3. Lexical local vs top-level global val vs first-class top-level function
                            match assocLookupScheme(cellGet(ctx.kLocalEnv), varName) {
                                Some(_) -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(varName) },
                                None ->
                                    if (strMapContains(ctx.kGlobalValSet, varName)) {
                                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmGlobalVar(varName) }
                                    } else if (isFnScheme(tform)) {
                                        let target = match lookupDirectTarget(ctx, varName) {
                                            Some(t) -> t,
                                            None -> varName,
                                        };
                                        MkTerm { tspan: form.pos, tscm: tform, tnode: etaWrapGlobalFn(ctx, form.pos, target, tform) }
                                    } else {
                                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(varName) }
                                    },
                            }
                        },
                    }
                },
            }
        },

        ExLet(vd, val, exp) -> {
            let vname = vd.vname;
            let scm = vd.vscm;
            let isPolyAbs = match (schemeTypeParams(scm), val.node) {
                (Cons(_, _), ExAbs(_, _, _)) -> true,
                _ -> false,
            };
            if (isPolyAbs) {
                match val.node {
                    ExAbs(ps, _, bd) -> {
                        let clsFnId = makeClsName(ctx, vname);
                        let parentFn = cellGet(ctx.kCurrentFn);
                        removeLiftedClosure(ctx, parentFn, clsFnId);

                        let outerEnv = cellGet(ctx.kLocalEnv);
                        let initBound = cellNew([vname]);
                        let cp0 = cellNew(ps);
                        while (match cellGet(cp0) { Nil -> false, _ -> true }) {
                            match cellGet(cp0) {
                                Cons(pvd, r) -> {
                                    cellSet(initBound, Cons(pvd.vname, cellGet(initBound)));
                                    cellSet(cp0, r)
                                },
                                Nil -> (),
                            }
                        };
                        let seenAstFv: StrMap Bool = strMapNew();
                        let rawAstFvs = cellNew(Nil);
                        collectAstFreeLocals(outerEnv, bd, cellGet(initBound), seenAstFv, rawAstFvs);
                        let sortedFvNames = sortUniqueStrings(cellGet(rawAstFvs));
                        let fvDeclsRev = cellNew(Nil);
                        let cf0 = cellNew(sortedFvNames);
                        while (match cellGet(cf0) { Nil -> false, _ -> true }) {
                            match cellGet(cf0) {
                                Cons(fvn, r) -> {
                                    match assocLookupScheme(outerEnv, fvn) {
                                        Some(fscm) -> cellSet(fvDeclsRev, Cons(MkVarDecl { vname: fvn, vscm: fscm }, cellGet(fvDeclsRev))),
                                        None -> (),
                                    };
                                    cellSet(cf0, r)
                                },
                                Nil -> (),
                            }
                        };
                        let fvDecls = listRev(cellGet(fvDeclsRev));

                        let liftedScm = match fvDecls {
                            Nil -> scm,
                            _ -> {
                                let fvTysRev = cellNew(Nil);
                                let cf = cellNew(fvDecls);
                                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                    match cellGet(cf) {
                                        Cons(fvd, r) -> {
                                            cellSet(fvTysRev, Cons(schemeBody(fvd.vscm), cellGet(fvTysRev)));
                                            cellSet(cf, r)
                                        },
                                        Nil -> (),
                                    }
                                };
                                let newBody = match schemeBody(scm) {
                                    TyArr(m, ptys, rty) -> TyArr(m, listAppend(listRev(cellGet(fvTysRev)), ptys), rty),
                                    other -> other,
                                };
                                match scm {
                                    ScmPoly(vs, _) -> ScmPoly(vs, newBody),
                                    ScmPolyConstrained(vs, cs, _) -> ScmPolyConstrained(vs, cs, newBody),
                                    other -> other,
                                }
                            },
                        };

                        let savedPoly = cellGet(ctx.kPolyLifted);
                        cellSet(ctx.kPolyLifted, Cons((vname, (clsFnId, fvDecls, liftedScm)), savedPoly));
                        cellSet(ctx.kCurrentFn, clsFnId);
                        let (lps, _, lbd) = transLambda(ctx, ps, bd, false);
                        cellSet(ctx.kCurrentFn, parentFn);

                        let allParams = listAppend(fvDecls, lps);
                        let _ = defineFn(ctx, clsFnId, val.pos, liftedScm, allParams, Nil, lbd);
                        let expTerm = transformForm(ctx, exp);
                        cellSet(ctx.kPolyLifted, savedPoly);
                        expTerm
                    },
                    _ -> transformForm(ctx, exp),
                }
            } else {
                let savedEnv = cellGet(ctx.kLocalEnv);
                cellSet(ctx.kLocalEnv, Cons((vname, scm), savedEnv));
                let resNode = match val.node {
                    ExAbs(ps, _, bd) -> {
                        let clsFnId = makeClsName(ctx, vname);
                        let savedDirect = cellGet(ctx.kLocalDirect);
                        cellSet(ctx.kLocalDirect, Cons((vname, clsFnId), savedDirect));
                        let (ps1, fv1, bd1) = transLambda(ctx, ps, bd, true);
                        cellSet(ctx.kLocalDirect, savedDirect);

                        let (clsName, clsFvs) = match fv1 {
                            Nil -> defineFn(ctx, clsFnId, val.pos, scm, ps1, Nil, bd1),
                            _ -> {
                                let (ps2, fv2, bd2) = transLambda(ctx, ps, bd, true);
                                defineFn(ctx, clsFnId, val.pos, scm, ps2, fv2, bd2)
                            },
                        };

                        let expTerm = match clsFvs {
                            Nil -> {
                                let sd2 = cellGet(ctx.kLocalDirect);
                                cellSet(ctx.kLocalDirect, Cons((vname, clsName), sd2));
                                let et = transformForm(ctx, exp);
                                cellSet(ctx.kLocalDirect, sd2);
                                et
                            },
                            _ -> transformForm(ctx, exp),
                        };
                        TmMakeCls(vd, MkClosureSpec { clsEntry: clsName, clsFvs: clsFvs }, expTerm)
                    },
                    _ -> {
                        let valTerm = transformForm(ctx, val);
                        let expTerm = transformForm(ctx, exp);
                        TmLet(vd, valTerm, expTerm)
                    },
                };
                cellSet(ctx.kLocalEnv, savedEnv);
                MkTerm { tspan: form.pos, tscm: tform, tnode: resNode }
            }
        },

        ExApply(callee, args) -> {
            // 1. ADT Constructor application?
            let ctorOpt = match callee.node {
                ExVar(cn) -> strMapGet(ctx.kCtorMap, cn),
                _ -> None,
            };
            match ctorOpt {
                Some((adtName, vinfo)) -> {
                    let argTerms = transformFormList(ctx, args);
                    let ftysRev = cellNew(Nil);
                    let cur = cellNew(argTerms);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(at, r) -> {
                                cellSet(ftysRev, Cons(schemeBody(at.tscm), cellGet(ftysRev)));
                                cellSet(cur, r)
                            },
                            Nil -> (),
                        }
                    };
                    let targs = extractTypeArgs(schemeBody(tform));
                    MkTerm {
                        tspan: form.pos,
                        tscm: tform,
                        tnode: TmMakeData(adtName, vinfo.tag, argTerms, listRev(cellGet(ftysRev)), targs),
                    }
                },
                None -> {
                    // 2. Lambda-lifted polymorphic local `let` call?
                    let polyOpt = match callee.node {
                        ExVar(cn) -> assocLookupPoly(cellGet(ctx.kPolyLifted), cn),
                        _ -> None,
                    };
                    match polyOpt {
                        Some((liftedFnId, fvDecls, liftedScm)) -> {
                            let fvArgsRev = cellNew(Nil);
                            let cf = cellNew(fvDecls);
                            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                match cellGet(cf) {
                                    Cons(fvd, r) -> {
                                        cellSet(fvArgsRev, Cons(MkTerm { tspan: form.pos, tscm: fvd.vscm, tnode: TmVar(fvd.vname) }, cellGet(fvArgsRev)));
                                        cellSet(cf, r)
                                    },
                                    Nil -> (),
                                }
                            };
                            let allArgs = listAppend(listRev(cellGet(fvArgsRev)), transformFormList(ctx, args));
                            MkTerm {
                                tspan: form.pos,
                                tscm: tform,
                                tnode: TmApplyDir(MkVarDecl { vname: liftedFnId, vscm: liftedScm }, allArgs),
                            }
                        },
                        None -> {
                            // 3. Direct function / concept method / intrinsic call?
                            match resolveDirectCallee(ctx, callee.node) {
                                Some(directName) ->
                                    if (directName == "$gs$forall" || directName == "$gs$exists") {
                                        let isForall = directName == "$gs$forall";
                                        match args {
                                            Cons(lamF, Nil) -> match lamF.node {
                                                ExAbs(Cons(vd, Nil), _, qbody) ->
                                                    if (ctx.kContractMode == "erase") {
                                                        MkTerm { tspan: form.pos, tscm: ScmMono(TyCon("Bool")), tnode: TmLit(LitBool(true)) }
                                                    } else if (ctx.kContractMode == "check") {
                                                        lowerQuantifierForCheck(ctx, form.pos, isForall, vd, qbody)
                                                    } else {
                                                        let savedEnv = cellGet(ctx.kLocalEnv);
                                                        cellSet(ctx.kLocalEnv, Cons((vd.vname, vd.vscm), savedEnv));
                                                        let tqb = transformForm(ctx, qbody);
                                                        cellSet(ctx.kLocalEnv, savedEnv);
                                                        let qFnScm = ScmMono(TyArr(TyVoid, [schemeBody(vd.vscm), TyCon("Bool")], TyCon("Bool")));
                                                        let qVarTerm = MkTerm { tspan: form.pos, tscm: vd.vscm, tnode: TmVar(vd.vname) };
                                                        MkTerm {
                                                            tspan: form.pos,
                                                            tscm: ScmMono(TyCon("Bool")),
                                                            tnode: TmApplyDir(MkVarDecl { vname: directName, vscm: qFnScm }, [qVarTerm, tqb]),
                                                        }
                                                    },
                                                _ -> MkTerm { tspan: form.pos, tscm: ScmMono(TyCon("Bool")), tnode: TmLit(LitBool(true)) },
                                            },
                                            _ -> MkTerm { tspan: form.pos, tscm: ScmMono(TyCon("Bool")), tnode: TmLit(LitBool(true)) },
                                        }
                                    } else if (directName == "old" && ctx.kContractMode == "keep" && isUnshadowedOldInCore(ctx, Nil)) {
                                        match args {
                                            Cons(arg0, Nil) -> {
                                                let ta = transformForm(ctx, arg0);
                                                let oldScm = ScmMono(TyArr(TyVoid, [schemeBody(ta.tscm)], schemeBody(tform)));
                                                MkTerm {
                                                    tspan: form.pos,
                                                    tscm: tform,
                                                    tnode: TmApplyDir(MkVarDecl { vname: "$gs$old", vscm: oldScm }, [ta]),
                                                }
                                            },
                                            _ -> MkTerm { tspan: form.pos, tscm: tform, tnode: TmLit(LitUnit) },
                                        }
                                    } else if (directName == "cFnPtr") {
                                        match args {
                                            Cons(argF, Nil) -> match argF.node {
                                                ExVar(fnNm) -> {
                                                    let isLocal = match assocLookupScheme(cellGet(ctx.kLocalEnv), fnNm) {
                                                        Some(_) -> true,
                                                        None -> false,
                                                    };
                                                    let isTop = strMapContains(ctx.kTopDirect, fnNm);
                                                    let isExtFnPtr = match strMapGet(ctx.kExterns, fnNm) {
                                                        Some(ed) -> ed.extIsFnPtr,
                                                        None -> false,
                                                    };
                                                    if (isLocal || !isTop) {
                                                        match cellGet(ctx.kErr) {
                                                            None -> cellSet(ctx.kErr, Some("cFnPtr requires a top-level or extern function (got local/non-top-level '" + fnNm + "')")),
                                                            Some(_) -> (),
                                                        }
                                                    } else if (isExtFnPtr) {
                                                        match cellGet(ctx.kErr) {
                                                            None -> cellSet(ctx.kErr, Some("cFnPtr cannot take an 'extern ptr' declaration ('" + fnNm + "')")),
                                                            Some(_) -> (),
                                                        }
                                                    } else ();
                                                    MkTerm {
                                                        tspan: form.pos,
                                                        tscm: tform,
                                                        tnode: TmApplyDir(
                                                            MkVarDecl { vname: "cFnPtr", vscm: callee.ty },
                                                            [MkTerm { tspan: form.pos, tscm: argF.ty, tnode: TmLit(LitStr(fnNm)) }]
                                                        ),
                                                    }
                                                },
                                                _ -> {
                                                    let argTerms = transformFormList(ctx, args);
                                                    MkTerm { tspan: form.pos, tscm: tform, tnode: TmApplyDir(MkVarDecl { vname: "cFnPtr", vscm: callee.ty }, argTerms) }
                                                },
                                            },
                                            _ -> {
                                                let argTerms = transformFormList(ctx, args);
                                                MkTerm { tspan: form.pos, tscm: tform, tnode: TmApplyDir(MkVarDecl { vname: "cFnPtr", vscm: callee.ty }, argTerms) }
                                            },
                                        }
                                    } else if (!strMapContains(ctx.kGlobalValSet, directName)) {
                                        let target = match lookupDirectTarget(ctx, directName) {
                                            Some(t) -> t,
                                            None -> directName,
                                        };
                                        let argTerms = transformFormList(ctx, args);
                                        MkTerm {
                                            tspan: form.pos,
                                            tscm: tform,
                                            tnode: TmApplyDir(MkVarDecl { vname: target, vscm: callee.ty }, argTerms),
                                        }
                                    } else {
                                        let ct = transformForm(ctx, callee);
                                        MkTerm { tspan: form.pos, tscm: tform, tnode: TmApplyCls(ct, transformFormList(ctx, args)) }
                                    },
                                None -> {
                                    let ct = transformForm(ctx, callee);
                                    MkTerm { tspan: form.pos, tscm: tform, tnode: TmApplyCls(ct, transformFormList(ctx, args)) }
                                },
                            }
                        },
                    }
                },
            }
        },

        ExMatch(scrut, arms) -> {
            let scrutTy = schemeBody(scrut.ty);
            let scrutTerm = transformForm(ctx, scrut);
            let armsRev = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let (normPat, binds) = normalizeAndCollectPattern(ctx, a.pat, scrutTy);
                        let savedEnv = cellGet(ctx.kLocalEnv);
                        cellSet(ctx.kLocalEnv, listAppend(binds, savedEnv));
                        let gTerm = match a.guard {
                            Some(g) -> Some(transformForm(ctx, g)),
                            None -> None,
                        };
                        let bTerm = transformForm(ctx, a.body);
                        cellSet(ctx.kLocalEnv, savedEnv);
                        cellSet(armsRev, Cons(MkCoreArm { caPat: normPat, caGuard: gTerm, caBody: bTerm }, cellGet(armsRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            MkTerm { tspan: form.pos, tscm: tform, tnode: TmMatch(scrutTerm, listRev(cellGet(armsRev))) }
        },

        ExAbs(ps, _, bd) -> {
            let frName = kFresh(ctx);
            let tmpFnId = makeClsName(ctx, frName);
            let (lps, fvs, lbd) = transLambda(ctx, ps, bd, true);
            let (clsName, clsFvs) = defineFn(ctx, tmpFnId, form.pos, tform, lps, fvs, lbd);
            let clsVar = kFresh(ctx);
            MkTerm {
                tspan: form.pos,
                tscm: tform,
                tnode: TmMakeCls(
                    MkVarDecl { vname: clsVar, vscm: tform },
                    MkClosureSpec { clsEntry: clsName, clsFvs: clsFvs },
                    MkTerm { tspan: form.pos, tscm: tform, tnode: TmVar(clsVar) }
                ),
            }
        },
    }
}

// ============================================================================
// Worklist Monomorphization & Static Concept Method Dispatch
// ============================================================================

def findConceptMethodScm(ms: List (String, Scheme), mname: String): Option Scheme = match ms {
    Nil -> None,
    Cons((k, s), r) -> if (k == mname) Some(s) else findConceptMethodScm(r, mname),
}

def listNthStr(xs: List String, idx: Int): Option String = match xs {
    Nil -> None,
    Cons(h, t) -> if (idx == 0) Some(h) else listNthStr(t, idx - 1),
}

def collectSubstArgs(tparams: List String, sub: StrMap Type): Option (List Type) = {
    let rev = cellNew(Nil);
    let ok = cellNew(true);
    let cur = cellNew(tparams);
    while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
        match cellGet(cur) {
            Cons(p, r) -> {
                match strMapGet(sub, p) {
                    Some(t) ->
                        if (isTypeConcrete(t)) cellSet(rev, Cons(t, cellGet(rev)))
                        else cellSet(ok, false),
                    None -> cellSet(ok, false),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    if (cellGet(ok)) Some(listRev(cellGet(rev))) else None
}

def resolveConceptCall(
    ctx: KCtx,
    methodName: String,
    argTys: List Type,
    retTy: Type
): Option (String, Scheme, Option Instantiation) =
    strMapGet(ctx.kConceptMethods, methodName) >>= ((pair) -> {
        let (conceptName, _) = pair;
        strMapGet(ctx.kConceptReg, conceptName) >>= (cinfo) ->
        findConceptMethodScm(cinfo.methods, methodName) >>= (methodScm) -> {
            let callSub: StrMap Type = strMapNew();
            let concreteFnTy = TyArr(TyVoid, argTys, retTy);
            unifyTypesInto(schemeBody(methodScm), concreteFnTy, callSub);
            resolveFunDepsInSubst(ctx, schemeConstraints(methodScm), callSub);
            collectSubstArgs(cinfo.typeParams, callSub) >>= (concreteTargetTys) ->
            if (!isTypeListConcrete(concreteTargetTys)) None
            else {
                let res: Cell (Option (String, Scheme, Option Instantiation)) = cellNew(None);
                let curI = cellNew(ctx.kInstanceReg);
                while (match cellGet(curI) { Nil -> false, _ -> match cellGet(res) { None -> true, Some(_) -> false } }) {
                    match cellGet(curI) {
                        Cons(instInfo, rI) -> {
                            if (instInfo.conceptName == conceptName && listLen(instInfo.targetTypes) == listLen(concreteTargetTys)) {
                                let instSub: StrMap Type = strMapNew();
                                if (matchInstancePatList(instInfo.targetTypes, concreteTargetTys, instSub)) {
                                    let resolved = strMapGet(instInfo.methodImpls, methodName) >>= (baseImplName) ->
                                        strMapGet(ctx.kGlobalFns, baseImplName) >>= (baseDef) -> {
                                            unifyTypesInto(schemeBody(baseDef.fnScm), concreteFnTy, instSub);
                                            resolveFunDepsInSubst(ctx, schemeConstraints(baseDef.fnScm), instSub);
                                            let tparams = schemeTypeParams(baseDef.fnScm);
                                            match tparams {
                                                Nil -> Some((baseImplName, ScmMono(concreteFnTy), None)),
                                                _ -> fmap((targs) -> {
                                                    let specInst = mkInst(baseImplName, targs);
                                                    (specInst.instMangled, ScmMono(concreteFnTy), Some(specInst))
                                                }, collectSubstArgs(tparams, instSub)),
                                            }
                                        };
                                    match resolved {
                                        Some(v) -> cellSet(res, Some(v)),
                                        None -> (),
                                    }
                                } else ()
                            } else ();
                            cellSet(curI, rI)
                        },
                        Nil -> (),
                    }
                };
                cellGet(res)
            }
        }
    })

def selectCoreTypesByNames(params: List String, names: List String, args: List Type): List Type = match names {
    Nil -> Nil,
    Cons(nm, rest) -> {
        let found = cellNew(TyVoid);
        let cp = cellNew(params);
        let ca = cellNew(args);
        while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
            match (cellGet(cp), cellGet(ca)) {
                (Cons(p, rp), Cons(a, ra)) -> {
                    if (p == nm) cellSet(found, a) else ();
                    cellSet(cp, rp);
                    cellSet(ca, ra)
                },
                _ -> (),
            }
        };
        Cons(cellGet(found), selectCoreTypesByNames(params, rest, args))
    },
}

def applySubstToTypeList(ts: List Type, sub: StrMap Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(applyExplicitSubst(h, sub), applySubstToTypeList(t, sub)),
}

def unifyTypeListsInto(pats: List Type, concs: List Type, sub: StrMap Type): Void = match (pats, concs) {
    (Cons(p, pr), Cons(c, cr)) -> {
        unifyTypesInto(p, c, sub);
        unifyTypeListsInto(pr, cr, sub)
    },
    _ -> (),
}

def resolveFunDepsInSubst(ctx: KCtx, cs: List ConstraintSpec, sub: StrMap Type): Void = match cs {
    Nil -> (),
    _ -> {
        let round = cellNew(0);
        while (cellGet(round) < 8) {
            cellSet(round, cellGet(round) + 1);
            let cc = cellNew(cs);
            while (match cellGet(cc) { Nil -> false, _ -> true }) {
                match cellGet(cc) {
                    Cons(c, rc) -> {
                        match strMapGet(ctx.kConceptReg, c.conceptName) {
                            Some(cinfo) -> {
                                let curArgs = applySubstToTypeList(c.typeArgs, sub);
                                let cfds = cellNew(cinfo.fundeps);
                                while (match cellGet(cfds) { Nil -> false, _ -> true }) {
                                    match cellGet(cfds) {
                                        Cons(fd, rfd) -> {
                                            let wLhs = selectCoreTypesByNames(cinfo.typeParams, fd.fdLhs, curArgs);
                                            if (isTypeListConcrete(wLhs)) {
                                                let ci = cellNew(ctx.kInstanceReg);
                                                let matched = cellNew(false);
                                                while (match cellGet(ci) { Nil -> false, _ -> !cellGet(matched) }) {
                                                    match cellGet(ci) {
                                                        Cons(inst, ri) -> {
                                                            if (inst.conceptName == c.conceptName) {
                                                                let iLhs = selectCoreTypesByNames(cinfo.typeParams, fd.fdLhs, inst.targetTypes);
                                                                let instSub: StrMap Type = strMapNew();
                                                                if (matchInstancePatList(iLhs, wLhs, instSub)) {
                                                                    let wRhs = selectCoreTypesByNames(cinfo.typeParams, fd.fdRhs, curArgs);
                                                                    let iRhs = applySubstToTypeList(selectCoreTypesByNames(cinfo.typeParams, fd.fdRhs, inst.targetTypes), instSub);
                                                                    unifyTypeListsInto(wRhs, iRhs, sub);
                                                                    cellSet(matched, true)
                                                                } else ()
                                                            } else ();
                                                            cellSet(ci, ri)
                                                        },
                                                        Nil -> (),
                                                    }
                                                }
                                            } else ();
                                            cellSet(cfds, rfd)
                                        },
                                        Nil -> (),
                                    }
                                }
                            },
                            None -> (),
                        };
                        cellSet(cc, rc)
                    },
                    Nil -> (),
                }
            }
        }
    },
}

def resolvePolyFnCall(
    ctx: KCtx,
    fnName: String,
    concreteFnTy: Type
): Option (String, Scheme, Instantiation) =
    strMapGet(ctx.kGlobalFns, fnName) >>= (fdef) ->
    match schemeTypeParams(fdef.fnScm) {
        Nil -> None,
        tparams -> {
            let sub: StrMap Type = strMapNew();
            unifyTypesInto(schemeBody(fdef.fnScm), concreteFnTy, sub);
            resolveFunDepsInSubst(ctx, schemeConstraints(fdef.fnScm), sub);
            fmap((targs) -> {
                let inst = mkInst(fnName, targs);
                let specTy = applyExplicitSubst(schemeBody(fdef.fnScm), sub);
                (inst.instMangled, ScmMono(specTy), inst)
            }, collectSubstArgs(tparams, sub))
        },
    }

def rewriteTermList(ctx: KCtx, es: List TaggedTerm, discovered: Cell (List Instantiation)): List TaggedTerm = {
    let rev = cellNew(Nil);
    let cur = cellNew(es);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(e, r) -> {
                cellSet(rev, Cons(rewriteCallsInTerm(ctx, e, discovered), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def pushDiscovered(discovered: Cell (List Instantiation), optInst: Option Instantiation): Void = match optInst {
    Some(i) -> cellSet(discovered, Cons(i, cellGet(discovered))),
    None -> (),
}

def rewriteCallsInTerm(ctx: KCtx, tm: TaggedTerm, discovered: Cell (List Instantiation)): TaggedTerm = {
    let nodeTy = schemeBody(tm.tscm);
    match tm.tnode {
        TmLit(_) -> tm,
        TmGlobalVar(_) -> tm,
        TmVar(name) -> {
            let resolvedConcept: Option TaggedTerm =
                if (isTypeConcrete(nodeTy) && !strMapContains(ctx.kGlobalFns, name)) {
                    match nodeTy {
                        TyArr(_, ps, r) -> match resolveConceptCall(ctx, name, ps, r) {
                            Some((mangled, specScm, optInst)) -> {
                                strMapInsert(ctx.kTopDirect, mangled, mangled);
                                pushDiscovered(discovered, optInst);
                                Some(MkTerm { tspan: tm.tspan, tscm: specScm, tnode: TmVar(mangled) })
                            },
                            None -> None,
                        },
                        _ -> None,
                    }
                } else None;
            match resolvedConcept {
                Some(rt) -> rt,
                None ->
                    if (isTypeConcrete(nodeTy)) {
                        match resolvePolyFnCall(ctx, name, nodeTy) {
                            Some((mangled, specScm, inst)) -> {
                                strMapInsert(ctx.kTopDirect, mangled, mangled);
                                cellSet(discovered, Cons(inst, cellGet(discovered)));
                                MkTerm { tspan: tm.tspan, tscm: specScm, tnode: TmVar(mangled) }
                            },
                            None -> tm,
                        }
                    } else tm,
            }
        },
        TmTuple(es) -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmTuple(rewriteTermList(ctx, es, discovered)) },
        TmBlock(es) -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBlock(rewriteTermList(ctx, es, discovered)) },
        TmMakeCls(vd, cls, body) -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmMakeCls(vd, cls, rewriteCallsInTerm(ctx, body, discovered)) },
        TmApplyCls(c, args) -> MkTerm {
            tspan: tm.tspan,
            tscm: tm.tscm,
            tnode: TmApplyCls(rewriteCallsInTerm(ctx, c, discovered), rewriteTermList(ctx, args, discovered)),
        },
        TmApplyDir(calleeDecl, rawArgs) -> {
            let args = rewriteTermList(ctx, rawArgs, discovered);
            let fnName = calleeDecl.vname;
            let argTysRev = cellNew(Nil);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        cellSet(argTysRev, Cons(schemeBody(a.tscm), cellGet(argTysRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let argTys = listRev(cellGet(argTysRev));
            let retTy = nodeTy;

            let conceptAttempt: Option TaggedTerm =
                if (!strMapContains(ctx.kGlobalFns, fnName)) {
                    match resolveConceptCall(ctx, fnName, argTys, retTy) {
                        Some((mangled, specScm, optInst)) -> {
                            strMapInsert(ctx.kTopDirect, mangled, mangled);
                            pushDiscovered(discovered, optInst);
                            Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, args) })
                        },
                        None -> match args {
                            Cons(a0, Nil) ->
                                if (isBuiltinOpPrimitive(schemeBody(a0.tscm))) {
                                    if (fnName == "neg") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmUn(UnNeg, a0) })
                                    } else if (fnName == "bitNot" || fnName == "$op$tilde") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmUn(UnBitNot, a0) })
                                    } else None
                                } else None,
                            Cons(a0, Cons(b0, Nil)) ->
                                if (isBuiltinOpPrimitive(schemeBody(a0.tscm))) {
                                    if (fnName == "eq") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpEq, a0, b0) })
                                    } else if (fnName == "compare") {
                                        let boolScm = ScmMono(TyCon("Bool"));
                                        let intScm = ScmMono(TyCon("Int"));
                                        let ltCond = MkTerm { tspan: tm.tspan, tscm: boolScm, tnode: TmBin(OpLt, a0, b0) };
                                        let eqCond = MkTerm { tspan: tm.tspan, tscm: boolScm, tnode: TmBin(OpEq, a0, b0) };
                                        let negOne = MkTerm { tspan: tm.tspan, tscm: intScm, tnode: TmLit(LitInt(0 - 1)) };
                                        let zero = MkTerm { tspan: tm.tspan, tscm: intScm, tnode: TmLit(LitInt(0)) };
                                        let posOne = MkTerm { tspan: tm.tspan, tscm: intScm, tnode: TmLit(LitInt(1)) };
                                        let innerIf = MkTerm { tspan: tm.tspan, tscm: intScm, tnode: TmIf(eqCond, zero, posOne) };
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmIf(ltCond, negOne, innerIf) })
                                    } else if (fnName == "add" || fnName == "$op$plus") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpAdd, a0, b0) })
                                    } else if (fnName == "sub" || fnName == "$op$minus") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpSub, a0, b0) })
                                    } else if (fnName == "mul" || fnName == "$op$star") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpMul, a0, b0) })
                                    } else if (fnName == "div" || fnName == "$op$slash") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpDiv, a0, b0) })
                                    } else if (fnName == "rem" || fnName == "$op$rem") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpRem, a0, b0) })
                                    } else if (fnName == "bitAnd" || fnName == "$op$amp") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpBitAnd, a0, b0) })
                                    } else if (fnName == "bitOr" || fnName == "$op$bar") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpBitOr, a0, b0) })
                                    } else if (fnName == "bitXor" || fnName == "$op$caret") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpBitXor, a0, b0) })
                                    } else if (fnName == "shl" || fnName == "$op$lt_lt") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpShl, a0, b0) })
                                    } else if (fnName == "shr" || fnName == "$op$gt_gt") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpShr, a0, b0) })
                                    } else if (fnName == "ushr" || fnName == "$op$gt_gt_gt") {
                                        Some(MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(OpUshr, a0, b0) })
                                    } else None
                                } else None,
                            _ -> None,
                        },
                    }
                } else None;

            match conceptAttempt {
                Some(rewritten) -> rewritten,
                None -> {
                    let concreteFnTy = TyArr(TyVoid, argTys, retTy);
                    match resolvePolyFnCall(ctx, fnName, concreteFnTy) {
                        Some((mangled, specScm, inst)) -> {
                            strMapInsert(ctx.kTopDirect, mangled, mangled);
                            cellSet(discovered, Cons(inst, cellGet(discovered)));
                            MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, args) }
                        },
                        None -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmApplyDir(calleeDecl, args) },
                    }
                },
            }
        },
        TmBin(bop, rawL, rawR) -> {
            let l = rewriteCallsInTerm(ctx, rawL, discovered);
            let r = rewriteCallsInTerm(ctx, rawR, discovered);
            let opTy = schemeBody(l.tscm);
            let rTy = schemeBody(r.tscm);
            let isPrimBin = match bop {
                OpShl -> isBuiltinOpPrimitive(opTy),
                OpShr -> isBuiltinOpPrimitive(opTy),
                OpUshr -> isBuiltinOpPrimitive(opTy),
                _ -> isBuiltinOpPrimitive(opTy) && typesEqual(opTy, rTy),
            };
            if (isTypeConcrete(opTy) && isTypeConcrete(rTy) && !isPrimBin) {
                let argTys = [opTy, rTy];
                match bop {
                    OpAnd -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(bop, l, r) },
                    OpOr -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(bop, l, r) },
                    OpEq -> match resolveConceptCall(ctx, "eq", argTys, nodeTy) {
                        Some((mangled, specScm, optInst)) -> {
                            strMapInsert(ctx.kTopDirect, mangled, mangled);
                            pushDiscovered(discovered, optInst);
                            MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, [l, r]) }
                        },
                        None -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(bop, l, r) },
                    },
                    OpNe -> {
                        let boolTy = TyCon("Bool");
                        match resolveConceptCall(ctx, "eq", argTys, boolTy) {
                            Some((mangled, specScm, optInst)) -> {
                                strMapInsert(ctx.kTopDirect, mangled, mangled);
                                pushDiscovered(discovered, optInst);
                                let eqCall = MkTerm {
                                    tspan: tm.tspan,
                                    tscm: ScmMono(boolTy),
                                    tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, [l, r]),
                                };
                                MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmUn(UnNot, eqCall) }
                            },
                            None -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(bop, l, r) },
                        }
                    },
                    OpLt -> rewriteOrdBinOp(ctx, tm.tspan, bop, l, r, argTys, tm.tscm, discovered),
                    OpLe -> rewriteOrdBinOp(ctx, tm.tspan, bop, l, r, argTys, tm.tscm, discovered),
                    OpGt -> rewriteOrdBinOp(ctx, tm.tspan, bop, l, r, argTys, tm.tscm, discovered),
                    OpGe -> rewriteOrdBinOp(ctx, tm.tspan, bop, l, r, argTys, tm.tscm, discovered),
                    _ -> {
                        let mname = match bop {
                            OpAdd -> "$op$plus",
                            OpSub -> "$op$minus",
                            OpMul -> "$op$star",
                            OpDiv -> "$op$slash",
                            OpRem -> "$op$rem",
                            OpBitAnd -> "$op$amp",
                            OpBitOr -> "$op$bar",
                            OpBitXor -> "$op$caret",
                            OpShl -> "$op$lt_lt",
                            OpShr -> "$op$gt_gt",
                            OpUshr -> "$op$gt_gt_gt",
                            _ -> "$op$plus",
                        };
                        match resolveConceptCall(ctx, mname, argTys, nodeTy) {
                            Some((mangled, specScm, optInst)) -> {
                                strMapInsert(ctx.kTopDirect, mangled, mangled);
                                pushDiscovered(discovered, optInst);
                                MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, [l, r]) }
                            },
                            None -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(bop, l, r) },
                        }
                    },
                }
            } else MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmBin(bop, l, r) }
        },
        TmUn(uop, rawE) -> {
            let e = rewriteCallsInTerm(ctx, rawE, discovered);
            let opTy = schemeBody(e.tscm);
            match uop {
                UnNot -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmUn(UnNot, e) },
                _ ->
                    if (isTypeConcrete(opTy) && !isBuiltinOpPrimitive(opTy)) {
                        let mname = match uop {
                            UnNeg -> "neg",
                            UnBitNot -> "$op$tilde",
                            _ -> "neg",
                        };
                        match resolveConceptCall(ctx, mname, [opTy], opTy) {
                            Some((mangled, specScm, optInst)) -> {
                                strMapInsert(ctx.kTopDirect, mangled, mangled);
                                pushDiscovered(discovered, optInst);
                                MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, [e]) }
                            },
                            None -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmUn(uop, e) },
                        }
                    } else MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmUn(uop, e) },
            }
        },
        TmGetTag(e) -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmGetTag(rewriteCallsInTerm(ctx, e, discovered)) },
        TmLet(vd, v, b) -> MkTerm {
            tspan: tm.tspan,
            tscm: tm.tscm,
            tnode: TmLet(vd, rewriteCallsInTerm(ctx, v, discovered), rewriteCallsInTerm(ctx, b, discovered)),
        },
        TmIf(c, t, e) -> MkTerm {
            tspan: tm.tspan,
            tscm: tm.tscm,
            tnode: TmIf(
                rewriteCallsInTerm(ctx, c, discovered),
                rewriteCallsInTerm(ctx, t, discovered),
                rewriteCallsInTerm(ctx, e, discovered)
            ),
        },
        TmWhile(c, b) -> MkTerm {
            tspan: tm.tspan,
            tscm: tm.tscm,
            tnode: TmWhile(rewriteCallsInTerm(ctx, c, discovered), rewriteCallsInTerm(ctx, b, discovered)),
        },
        TmMatch(s, arms) -> {
            let ns = rewriteCallsInTerm(ctx, s, discovered);
            let rev = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ng = match a.caGuard { Some(g) -> Some(rewriteCallsInTerm(ctx, g, discovered)), None -> None };
                        cellSet(rev, Cons(MkCoreArm { caPat: a.caPat, caGuard: ng, caBody: rewriteCallsInTerm(ctx, a.caBody, discovered) }, cellGet(rev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: TmMatch(ns, listRev(cellGet(rev))) }
        },
        TmMakeData(tn, tg, fs, ftys, targs) -> MkTerm {
            tspan: tm.tspan,
            tscm: tm.tscm,
            tnode: TmMakeData(tn, tg, rewriteTermList(ctx, fs, discovered), ftys, targs),
        },
    }
}

def rewriteOrdBinOp(
    ctx: KCtx,
    sp: Span,
    bop: BinOp,
    l: TaggedTerm,
    r: TaggedTerm,
    argTys: List Type,
    tscm: Scheme,
    discovered: Cell (List Instantiation)
): TaggedTerm = {
    let intTy = TyCon("Int");
    match resolveConceptCall(ctx, "compare", argTys, intTy) {
        Some((mangled, specScm, optInst)) -> {
            strMapInsert(ctx.kTopDirect, mangled, mangled);
            pushDiscovered(discovered, optInst);
            let cmpCall = MkTerm {
                tspan: sp,
                tscm: ScmMono(intTy),
                tnode: TmApplyDir(MkVarDecl { vname: mangled, vscm: specScm }, [l, r]),
            };
            let zero = MkTerm { tspan: sp, tscm: ScmMono(intTy), tnode: TmLit(LitInt(0)) };
            MkTerm { tspan: sp, tscm: tscm, tnode: TmBin(bop, cmpCall, zero) }
        },
        None -> MkTerm { tspan: sp, tscm: tscm, tnode: TmBin(bop, l, r) },
    }
}

def specializeTermList(es: List TaggedTerm, typeSub: StrMap Type, fnRename: StrMap String): List TaggedTerm = {
    let rev = cellNew(Nil);
    let cur = cellNew(es);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(e, r) -> {
                cellSet(rev, Cons(specializeTerm(e, typeSub, fnRename), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def applyExplicitSubstListCore(ts: List Type, sub: StrMap Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(applyExplicitSubst(h, sub), applyExplicitSubstListCore(t, sub)),
}

def specializeTerm(tm: TaggedTerm, typeSub: StrMap Type, fnRename: StrMap String): TaggedTerm = {
    let nscm = match tm.tnode {
        TmVar(id) -> match strMapGet(fnRename, id) {
            Some(_) -> ScmMono(applyExplicitSubst(schemeBody(tm.tscm), typeSub)),
            None -> applySchemeSubst(tm.tscm, typeSub),
        },
        _ -> applySchemeSubst(tm.tscm, typeSub),
    };
    let nnode = match tm.tnode {
        TmLit(l) -> TmLit(l),
        TmGlobalVar(g) -> TmGlobalVar(g),
        TmVar(id) -> match strMapGet(fnRename, id) {
            Some(nid) -> TmVar(nid),
            None -> TmVar(id),
        },
        TmTuple(es) -> TmTuple(specializeTermList(es, typeSub, fnRename)),
        TmBlock(es) -> TmBlock(specializeTermList(es, typeSub, fnRename)),
        TmBin(op, l, r) -> TmBin(op, specializeTerm(l, typeSub, fnRename), specializeTerm(r, typeSub, fnRename)),
        TmUn(op, e) -> TmUn(op, specializeTerm(e, typeSub, fnRename)),
        TmGetTag(e) -> TmGetTag(specializeTerm(e, typeSub, fnRename)),
        TmLet(vd, v, b) -> TmLet(
            MkVarDecl { vname: vd.vname, vscm: applySchemeSubst(vd.vscm, typeSub) },
            specializeTerm(v, typeSub, fnRename),
            specializeTerm(b, typeSub, fnRename)
        ),
        TmIf(c, t, e) -> TmIf(
            specializeTerm(c, typeSub, fnRename),
            specializeTerm(t, typeSub, fnRename),
            specializeTerm(e, typeSub, fnRename)
        ),
        TmWhile(c, b) -> TmWhile(specializeTerm(c, typeSub, fnRename), specializeTerm(b, typeSub, fnRename)),
        TmApplyDir(vd, args) -> {
            let (nid, nvscm) = match strMapGet(fnRename, vd.vname) {
                Some(r) -> (r, ScmMono(applyExplicitSubst(schemeBody(vd.vscm), typeSub))),
                None -> (vd.vname, applySchemeSubst(vd.vscm, typeSub)),
            };
            TmApplyDir(
                MkVarDecl { vname: nid, vscm: nvscm },
                specializeTermList(args, typeSub, fnRename)
            )
        },
        TmApplyCls(c, args) -> TmApplyCls(specializeTerm(c, typeSub, fnRename), specializeTermList(args, typeSub, fnRename)),
        TmMakeCls(vd, cls, body) -> {
            let (newEntry, nvscm) = match strMapGet(fnRename, cls.clsEntry) {
                Some(r) -> (r, ScmMono(applyExplicitSubst(schemeBody(vd.vscm), typeSub))),
                None -> (cls.clsEntry, applySchemeSubst(vd.vscm, typeSub)),
            };
            TmMakeCls(
                MkVarDecl { vname: vd.vname, vscm: nvscm },
                MkClosureSpec { clsEntry: newEntry, clsFvs: cls.clsFvs },
                specializeTerm(body, typeSub, fnRename)
            )
        },
        TmMatch(s, arms) -> {
            let rev = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ng = match a.caGuard { Some(g) -> Some(specializeTerm(g, typeSub, fnRename)), None -> None };
                        cellSet(rev, Cons(MkCoreArm {
                            caPat: a.caPat,
                            caGuard: ng,
                            caBody: specializeTerm(a.caBody, typeSub, fnRename),
                        }, cellGet(rev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            TmMatch(specializeTerm(s, typeSub, fnRename), listRev(cellGet(rev)))
        },
        TmMakeData(tn, tg, fs, ftys, targs) -> TmMakeData(
            tn,
            tg,
            specializeTermList(fs, typeSub, fnRename),
            applyExplicitSubstListCore(ftys, typeSub),
            applyExplicitSubstListCore(targs, typeSub)
        ),
    };
    MkTerm { tspan: tm.tspan, tscm: nscm, tnode: nnode }
}

def specializeVarDecls(vds: List VarDecl, sub: StrMap Type): List VarDecl = {
    let rev = cellNew(Nil);
    let cur = cellNew(vds);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(vd, r) -> {
                cellSet(rev, Cons(MkVarDecl { vname: vd.vname, vscm: applySchemeSubst(vd.vscm, sub) }, cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def sanitizeVarDecls(vds: List VarDecl): List VarDecl = {
    let rev = cellNew(Nil);
    let cur = cellNew(vds);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(vd, r) -> {
                cellSet(rev, Cons(MkVarDecl { vname: vd.vname, vscm: ScmMono(defaultPhantomType(schemeBody(vd.vscm))) }, cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def buildSpecializedFunDef(orig: FunDef, newName: String, sub: StrMap Type, fnRename: StrMap String): FunDef = {
    let specTy = defaultPhantomType(applyExplicitSubst(schemeBody(orig.fnScm), sub));
    let specParams = sanitizeVarDecls(specializeVarDecls(orig.fnParams, sub));
    let specFvs = sanitizeVarDecls(specializeVarDecls(orig.fnFvs, sub));
    let specBody = sanitizePhantomTerm(specializeTerm(orig.fnBody, sub, fnRename));
    MkFunDef {
        fnName: newName,
        fnSpan: orig.fnSpan,
        fnScm: ScmMono(specTy),
        fnParams: specParams,
        fnFvs: specFvs,
        fnBody: specBody,
    }
}

def collectTransitiveClosuresRec(liftedMap: StrMap (List String), fnId: String, seen: StrMap Bool, outRev: Cell (List String)): Void =
    match strMapGet(liftedMap, fnId) {
        None -> (),
        Some(cids) -> {
            let cur = cellNew(cids);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(cid, r) -> {
                        if (!strMapContains(seen, cid)) {
                            strMapInsert(seen, cid, true);
                            cellSet(outRev, Cons(cid, cellGet(outRev)));
                            collectTransitiveClosuresRec(liftedMap, cid, seen, outRev)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    }

def collectTransitiveClosures(liftedMap: StrMap (List String), fnId: String): List String = {
    let seen: StrMap Bool = strMapNew();
    let outRev = cellNew(Nil);
    collectTransitiveClosuresRec(liftedMap, fnId, seen, outRev);
    listRev(cellGet(outRev))
}

def materializeSpecialization(ctx: KCtx, inst: Instantiation): List String =
    match strMapGet(ctx.kGlobalFns, inst.instFn) {
        None -> Nil,
        Some(orig) -> {
            let tparams = schemeTypeParams(orig.fnScm);
            if (listLen(tparams) != listLen(inst.instArgs)) Nil
            else if (strMapContains(ctx.kGlobalFns, inst.instMangled)) [inst.instMangled]
            else {
                let sub = buildPairMap(tparams, inst.instArgs);
                let suffix =
                    if (strLen(inst.instMangled) > strLen(inst.instFn)) {
                        strSlice(inst.instMangled, strLen(inst.instFn), strLen(inst.instMangled))
                    } else "";
                let fnRename: StrMap String = strMapNew();
                strMapInsert(fnRename, inst.instFn, inst.instMangled);

                let innerCls = collectTransitiveClosures(ctx.kLiftedClosures, inst.instFn);
                let cc1 = cellNew(innerCls);
                while (match cellGet(cc1) { Nil -> false, _ -> true }) {
                    match cellGet(cc1) {
                        Cons(cid, r) -> {
                            strMapInsert(fnRename, cid, cid + suffix);
                            cellSet(cc1, r)
                        },
                        Nil -> (),
                    }
                };

                let createdRev = cellNew(Nil);
                let cc2 = cellNew(innerCls);
                while (match cellGet(cc2) { Nil -> false, _ -> true }) {
                    match cellGet(cc2) {
                        Cons(cid, r) -> {
                            match strMapGet(ctx.kGlobalFns, cid) {
                                Some(clsDef) -> {
                                    let specClsId = cid + suffix;
                                    let specCls = buildSpecializedFunDef(clsDef, specClsId, sub, fnRename);
                                    strMapInsert(ctx.kTopDirect, specClsId, specClsId);
                                    strMapInsert(ctx.kGlobalFns, specClsId, specCls);
                                    vecPush(ctx.kAllFnNames, specClsId);
                                    cellSet(createdRev, Cons(specClsId, cellGet(createdRev)))
                                },
                                None -> (),
                            };
                            cellSet(cc2, r)
                        },
                        Nil -> (),
                    }
                };

                let specFn = buildSpecializedFunDef(orig, inst.instMangled, sub, fnRename);
                strMapInsert(ctx.kInstantiatedPoly, inst.instFn, true);
                strMapInsert(ctx.kOrigFnNames, inst.instMangled, inst.instFn);
                if (strMapContains(ctx.kVerifiedFns, inst.instFn)) {
                    strMapInsert(ctx.kVerifiedFns, inst.instMangled, true)
                } else ();
                strMapInsert(ctx.kTopDirect, inst.instMangled, inst.instMangled);
                strMapInsert(ctx.kGlobalFns, inst.instMangled, specFn);
                vecPush(ctx.kAllFnNames, inst.instMangled);
                cellSet(createdRev, Cons(inst.instMangled, cellGet(createdRev)));
                listRev(cellGet(createdRev))
            }
        },
    }

def markTransitiveTemplateClosures(liftedMap: StrMap (List String), fnId: String, out: StrMap Bool): Void =
    match strMapGet(liftedMap, fnId) {
        None -> (),
        Some(cids) -> {
            let cur = cellNew(cids);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(cid, r) -> {
                        if (!strMapContains(out, cid)) {
                            strMapInsert(out, cid, true);
                            markTransitiveTemplateClosures(liftedMap, cid, out)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    }

def isAllIntTypeArgs(ts: List Type): Bool = match ts {
    Nil -> true,
    Cons(TyCon("Int"), r) -> isAllIntTypeArgs(r),
    _ -> false,
}

def canSatisfyConcreteConstraintCore(ctx: KCtx, c: ConstraintSpec, depth: Int): Bool =
    if (depth > 6) false
    else if (!isTypeListConcrete(c.typeArgs)) false
    else if (c.conceptName == "Send") {
        match c.typeArgs {
            Cons(ta, Nil) -> isConcreteTypeSend(ctx.kAdtReg, ta),
            _ -> false,
        }
    } else if (c.conceptName == "SendIf") {
        match c.typeArgs {
            Cons(TyCon("$Local"), _) -> true,
            Cons(TyCon("$Scoped"), _) -> true,
            Cons(_, Cons(ta, Nil)) -> isConcreteTypeSend(ctx.kAdtReg, ta),
            _ -> false,
        }
    } else if (
        (c.conceptName == "Eq" || c.conceptName == "Ord"
         || c.conceptName == "Add" || c.conceptName == "Sub" || c.conceptName == "Mul"
         || c.conceptName == "Div" || c.conceptName == "Rem" || c.conceptName == "Neg"
         || c.conceptName == "BitAnd" || c.conceptName == "BitOr" || c.conceptName == "BitXor"
         || c.conceptName == "BitNot" || c.conceptName == "Shl" || c.conceptName == "Shr" || c.conceptName == "Ushr")
        && isAllIntTypeArgs(c.typeArgs)
    ) {
        true
    } else {
        let hit = cellNew(false);
        let ci = cellNew(ctx.kInstanceReg);
        while (!cellGet(hit) && match cellGet(ci) { Nil -> false, _ -> true }) {
            match cellGet(ci) {
                Cons(inst, ri) -> {
                    if (inst.conceptName == c.conceptName && listLen(inst.targetTypes) == listLen(c.typeArgs)) {
                        let isub: StrMap Type = strMapNew();
                        if (matchInstancePatList(inst.targetTypes, c.typeArgs, isub)) {
                            let subOk = cellNew(true);
                            let csub = cellNew(inst.constraints);
                            while (cellGet(subOk) && match cellGet(csub) { Nil -> false, _ -> true }) {
                                match cellGet(csub) {
                                    Cons(sc, rsc) -> {
                                        let instSc = MkConstraint {
                                            conceptName: sc.conceptName,
                                            typeArgs: applySubstToTypeList(sc.typeArgs, isub),
                                        };
                                        if (!canSatisfyConcreteConstraintCore(ctx, instSc, depth + 1)) {
                                            cellSet(subOk, false)
                                        } else ();
                                        cellSet(csub, rsc)
                                    },
                                    Nil -> (),
                                }
                            };
                            if (cellGet(subOk)) cellSet(hit, true) else ()
                        } else ()
                    } else ();
                    cellSet(ci, ri)
                },
                Nil -> (),
            }
        };
        cellGet(hit)
    }

def canSeedPolySchemeWithInt(ctx: KCtx, scm: Scheme): (Bool, List Type) = {
    let tps = schemeTypeParams(scm);
    match tps {
        Nil -> (false, Nil),
        _ -> {
            let sub: StrMap Type = strMapNew();
            let argsRev: Cell (List Type) = cellNew(Nil);
            let ct = cellNew(tps);
            while (match cellGet(ct) { Nil -> false, _ -> true }) {
                match cellGet(ct) {
                    Cons(tv, rt) -> {
                        let conc = if (isModeVarName(tv)) TyCon("$Local") else TyCon("Int");
                        strMapInsert(sub, tv, conc);
                        cellSet(argsRev, Cons(conc, cellGet(argsRev)));
                        cellSet(ct, rt)
                    },
                    Nil -> (),
                }
            };
            // Allow fundeps to refine any dependent output type params from `Int` inputs!
            let subFd: StrMap Type = strMapNew();
            let ct2 = cellNew(tps);
            let hasMultiParamConcept = match schemeConstraints(scm) {
                Nil -> false,
                cs -> {
                    let found = cellNew(false);
                    let cc0 = cellNew(cs);
                    while (!cellGet(found) && match cellGet(cc0) { Nil -> false, _ -> true }) {
                        match cellGet(cc0) {
                            Cons(c0, rc0) -> {
                                match strMapGet(ctx.kConceptReg, c0.conceptName) {
                                    Some(ci0) -> match ci0.fundeps {
                                        Cons(_, _) -> cellSet(found, true),
                                        Nil -> (),
                                    },
                                    None -> (),
                                };
                                cellSet(cc0, rc0)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(found)
                },
            };
            let finalSub =
                if (!hasMultiParamConcept) sub
                else {
                    // Seed non-fundep-rhs vars to Int, run fundep solver, then default remaining vars to Int
                    let rhsVars: StrMap Bool = strMapNew();
                    let cc1 = cellNew(schemeConstraints(scm));
                    while (match cellGet(cc1) { Nil -> false, _ -> true }) {
                        match cellGet(cc1) {
                            Cons(c1, rc1) -> {
                                match strMapGet(ctx.kConceptReg, c1.conceptName) {
                                    Some(ci1) -> {
                                        let cfd = cellNew(ci1.fundeps);
                                        while (match cellGet(cfd) { Nil -> false, _ -> true }) {
                                            match cellGet(cfd) {
                                                Cons(fd, rfd) -> {
                                                    let sel = selectCoreTypesByNames(ci1.typeParams, fd.fdRhs, c1.typeArgs);
                                                    let cs = cellNew(sel);
                                                    while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                                        match cellGet(cs) {
                                                            Cons(TyVar(rv), rcs) -> { strMapInsert(rhsVars, rv, true); cellSet(cs, rcs) },
                                                            Cons(_, rcs) -> cellSet(cs, rcs),
                                                            Nil -> (),
                                                        }
                                                    };
                                                    cellSet(cfd, rfd)
                                                },
                                                Nil -> (),
                                            }
                                        }
                                    },
                                    None -> (),
                                };
                                cellSet(cc1, rc1)
                            },
                            Nil -> (),
                        }
                    };
                    while (match cellGet(ct2) { Nil -> false, _ -> true }) {
                        match cellGet(ct2) {
                            Cons(tv, rt) -> {
                                if (isModeVarName(tv)) strMapInsert(subFd, tv, TyCon("$Local"))
                                else if (!strMapContains(rhsVars, tv)) strMapInsert(subFd, tv, TyCon("Int"))
                                else ();
                                cellSet(ct2, rt)
                            },
                            Nil -> (),
                        }
                    };
                    resolveFunDepsInSubst(ctx, schemeConstraints(scm), subFd);
                    let ct3 = cellNew(tps);
                    while (match cellGet(ct3) { Nil -> false, _ -> true }) {
                        match cellGet(ct3) {
                            Cons(tv, rt) -> {
                                if (!strMapContains(subFd, tv)) {
                                    strMapInsert(subFd, tv, if (isModeVarName(tv)) TyCon("$Local") else TyCon("Int"))
                                } else ();
                                cellSet(ct3, rt)
                            },
                            Nil -> (),
                        }
                    };
                    subFd
                };
            let ok = cellNew(true);
            let cc = cellNew(schemeConstraints(scm));
            while (cellGet(ok) && match cellGet(cc) { Nil -> false, _ -> true }) {
                match cellGet(cc) {
                    Cons(c, rc) -> {
                        let concC = MkConstraint {
                            conceptName: c.conceptName,
                            typeArgs: applySubstToTypeList(c.typeArgs, finalSub),
                        };
                        if (!canSatisfyConcreteConstraintCore(ctx, concC, 0)) cellSet(ok, false) else ();
                        cellSet(cc, rc)
                    },
                    Nil -> (),
                }
            };
            if (!cellGet(ok)) (false, Nil)
            else {
                let finalArgsRev: Cell (List Type) = cellNew(Nil);
                let ct4 = cellNew(tps);
                while (match cellGet(ct4) { Nil -> false, _ -> true }) {
                    match cellGet(ct4) {
                        Cons(tv, rt) -> {
                            let ta = match strMapGet(finalSub, tv) { Some(t) -> t, None -> TyCon("Int") };
                            cellSet(finalArgsRev, Cons(ta, cellGet(finalArgsRev)));
                            cellSet(ct4, rt)
                        },
                        Nil -> (),
                    }
                };
                (true, listRev(cellGet(finalArgsRev)))
            }
        },
    }
}

def isUserSourceFileForSeed(fileId: Int): Bool =
    if (fileId <= 0) false
    else match diagGetFile(fileId) {
        Some(sf) ->
            !(strLen(sf.sfPath) >= 1 && strByteAt(sf.sfPath, 0) == 60)
            && !strStartsWith(sf.sfPath, "std/")
            && !strStartsWith(sf.sfPath, "sys/"),
        None -> false,
    }

def runMonomorphizationWorklist(ctx: KCtx): (StrMap FunDef, List String, List GlobalValDef) = {
    let queue: Vec String = vecNew();
    let qHead = cellNew(0);
    let processed: StrMap Bool = strMapNew();
    let createdSpecs: StrMap Bool = strMapNew();

    // Identify inner closures belonging to polymorphic templates so unspecialized templates are never seeded/emitted
    let templateClosures: StrMap Bool = strMapNew();
    let totalInitial = vecLen(ctx.kAllFnNames);
    let t0 = cellNew(0);
    while (cellGet(t0) < totalInitial) {
        let fnm = vecGetOr(ctx.kAllFnNames, cellGet(t0), "");
        match strMapGet(ctx.kGlobalFns, fnm) {
            Some(fd) -> match schemeTypeParams(fd.fnScm) {
                Cons(_, _) -> markTransitiveTemplateClosures(ctx.kLiftedClosures, fnm, templateClosures),
                Nil -> (),
            },
            None -> (),
        };
        cellSet(t0, cellGet(t0) + 1)
    };

    // Seed with concrete monomorphic top-level functions (preserving polymorphic templates intact!)
    let i = cellNew(0);
    while (cellGet(i) < totalInitial) {
        let fnm = vecGetOr(ctx.kAllFnNames, cellGet(i), "");
        if (!strMapContains(templateClosures, fnm)) {
            match strMapGet(ctx.kGlobalFns, fnm) {
                Some(fd) -> {
                    let isMono = match schemeTypeParams(fd.fnScm) {
                        Nil -> isTypeConcrete(schemeBody(fd.fnScm)),
                        _ -> false,
                    };
                    if (isMono) {
                        let cleanFd = MkFunDef {
                            fnName: fd.fnName,
                            fnSpan: fd.fnSpan,
                            fnScm: ScmMono(defaultPhantomType(schemeBody(fd.fnScm))),
                            fnParams: sanitizeVarDecls(fd.fnParams),
                            fnFvs: sanitizeVarDecls(fd.fnFvs),
                            fnBody: sanitizePhantomTerm(fd.fnBody),
                        };
                        strMapInsert(ctx.kGlobalFns, fnm, cleanFd);
                        vecPush(queue, fnm)
                    } else ()
                },
                None -> (),
            }
        } else ();
        cellSet(i, cellGet(i) + 1)
    };

    // Rewrite global value initializers
    let initDiscovered: Cell (List Instantiation) = cellNew(Nil);
    let newGlobalsRev = cellNew(Nil);
    let curG = cellNew(listRev(cellGet(ctx.kGlobalValsRev)));
    while (match cellGet(curG) { Nil -> false, _ -> true }) {
        match cellGet(curG) {
            Cons(g, r) -> {
                let cleanTy = defaultPhantomType(g.gvTy);
                let cleanInit = sanitizePhantomTerm(g.gvInit);
                let rwInit = rewriteCallsInTerm(ctx, cleanInit, initDiscovered);
                cellSet(newGlobalsRev, Cons(MkGlobalValDef { gvName: g.gvName, gvSpan: g.gvSpan, gvTy: cleanTy, gvInit: rwInit }, cellGet(newGlobalsRev)));
                cellSet(curG, r)
            },
            Nil -> (),
        }
    };

    enqueueDiscoveredSpecs(ctx, listRev(cellGet(initDiscovered)), createdSpecs, queue);

    let drainWorklist = () -> {
        while (cellGet(qHead) < vecLen(queue)) {
            let h = cellGet(qHead);
            cellSet(qHead, h + 1);
            let fnId = vecGetOr(queue, h, "");
            if (!strMapContains(processed, fnId)) {
                strMapInsert(processed, fnId, true);
                match strMapGet(ctx.kGlobalFns, fnId) {
                    Some(fd) -> {
                        let disc: Cell (List Instantiation) = cellNew(Nil);
                        let rwBody = rewriteCallsInTerm(ctx, fd.fnBody, disc);
                        strMapInsert(ctx.kGlobalFns, fnId, MkFunDef {
                            fnName: fd.fnName,
                            fnSpan: fd.fnSpan,
                            fnScm: fd.fnScm,
                            fnParams: fd.fnParams,
                            fnFvs: fd.fnFvs,
                            fnBody: rwBody,
                        });
                        enqueueDiscoveredSpecs(ctx, listRev(cellGet(disc)), createdSpecs, queue)
                    },
                    None -> (),
                }
            } else ()
        }
    };

    drainWorklist();

    // In `"keep"` mode (`geisha verify`), seed any uninstantiated user polymorphic functions
    // (including Concept-constrained generics satisfied by `Int`!) via non-destructive specialization,
    // and record any unseedable user polymorphic functions so `verify` fails closed with `unknown`.
    if (ctx.kContractMode == "keep") {
        let seedSpecsRev: Cell (List Instantiation) = cellNew(Nil);
        let pIdx = cellNew(0);
        while (cellGet(pIdx) < totalInitial) {
            let fnm = vecGetOr(ctx.kAllFnNames, cellGet(pIdx), "");
            if (!strMapContains(templateClosures, fnm)
                && !strStartsWith(fnm, "__inst_")
                && !strStartsWith(fnm, "$derive")
                && !strMapContains(ctx.kInstantiatedPoly, fnm)) {
                match strMapGet(ctx.kGlobalFns, fnm) {
                    Some(fd) -> match schemeTypeParams(fd.fnScm) {
                        Cons(_, _) if (isUserSourceFileForSeed(fd.fnSpan.fileId)) -> {
                            let (canSeed, seedArgs) = canSeedPolySchemeWithInt(ctx, fd.fnScm);
                            if (canSeed) {
                                cellSet(seedSpecsRev, Cons(mkInst(fnm, seedArgs), cellGet(seedSpecsRev)))
                            } else {
                                cellSet(ctx.kUnseededPolyRev, Cons((fnm, fd.fnSpan, strMapContains(ctx.kVerifiedFns, fnm)), cellGet(ctx.kUnseededPolyRev)))
                            }
                        },
                        _ -> (),
                    },
                    None -> (),
                }
            } else ();
            cellSet(pIdx, cellGet(pIdx) + 1)
        };
        enqueueDiscoveredSpecs(ctx, listRev(cellGet(seedSpecsRev)), createdSpecs, queue);
        drainWorklist()
    } else ();

    // Keep only concrete monomorphic functions, sorted deterministically by name!
    let concreteFns: StrMap FunDef = strMapNew();
    let concreteNamesRev = cellNew(Nil);
    let k = cellNew(0);
    while (cellGet(k) < vecLen(ctx.kAllFnNames)) {
        let fnm = vecGetOr(ctx.kAllFnNames, cellGet(k), "");
        match strMapGet(ctx.kGlobalFns, fnm) {
            Some(fd) -> {
                let keep = match schemeTypeParams(fd.fnScm) {
                    Nil ->
                        !strMapContains(templateClosures, fnm)
                        && isTypeConcrete(schemeBody(fd.fnScm))
                        && !strMapContains(concreteFns, fnm),
                    _ -> false,
                };
                if (keep) {
                    strMapInsert(concreteFns, fnm, fd);
                    cellSet(concreteNamesRev, Cons(fnm, cellGet(concreteNamesRev)))
                } else ()
            },
            None -> (),
        };
        cellSet(k, cellGet(k) + 1)
    };

    (concreteFns, sortUniqueStrings(cellGet(concreteNamesRev)), listRev(cellGet(newGlobalsRev)))
}

def enqueueDiscoveredSpecs(
    ctx: KCtx,
    insts: List Instantiation,
    createdSpecs: StrMap Bool,
    queue: Vec String
): Void = {
    let cur = cellNew(insts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(inst, r) -> {
                if (!strMapContains(createdSpecs, inst.instMangled)) {
                    strMapInsert(createdSpecs, inst.instMangled, true);
                    let sids = materializeSpecialization(ctx, inst);
                    let cs = cellNew(sids);
                    while (match cellGet(cs) { Nil -> false, _ -> true }) {
                        match cellGet(cs) {
                            Cons(sid, rs) -> {
                                vecPush(queue, sid);
                                cellSet(cs, rs)
                            },
                            Nil -> (),
                        }
                    }
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

// ============================================================================
// Concurrent `Send` Closure Verification
// ============================================================================

def intrinsicSendClosureArg(callee: String): Option Int =
    if (callee == "__concTaskSpawn" || callee == "__concActorSpawn") Some(0)
    else if (callee == "__concActorCall" || callee == "__concActorSend" || callee == "parTabulate") Some(1)
    else None

def findNonSendGlobalInTerm(
    tm: TaggedTerm,
    fns: StrMap FunDef,
    globalTys: StrMap Type,
    adtReg: StrMap AdtInfo,
    visitedFns: StrMap Bool
): Option (String, Type) = match tm.tnode {
    TmGlobalVar(gn) -> match strMapGet(globalTys, gn) {
        Some(gty) -> if (!isConcreteTypeSend(adtReg, gty)) Some((gn, gty)) else None,
        None -> None,
    },
    TmApplyDir(vd, args) -> {
        let inArgs = findNonSendGlobalInList(args, fns, globalTys, adtReg, visitedFns);
        match inArgs {
            Some(hit) -> Some(hit),
            None ->
                if (!strMapContains(visitedFns, vd.vname)) {
                    strMapInsert(visitedFns, vd.vname, true);
                    match strMapGet(fns, vd.vname) {
                        Some(fd) -> findNonSendGlobalInTerm(fd.fnBody, fns, globalTys, adtReg, visitedFns),
                        None -> None,
                    }
                } else None,
        }
    },
    TmMakeCls(_, cls, body) -> {
        let inCls =
            if (!strMapContains(visitedFns, cls.clsEntry)) {
                strMapInsert(visitedFns, cls.clsEntry, true);
                match strMapGet(fns, cls.clsEntry) {
                    Some(fd) -> findNonSendGlobalInTerm(fd.fnBody, fns, globalTys, adtReg, visitedFns),
                    None -> None,
                }
            } else None;
        match inCls {
            Some(hit) -> Some(hit),
            None -> findNonSendGlobalInTerm(body, fns, globalTys, adtReg, visitedFns),
        }
    },
    TmApplyCls(c, args) -> match findNonSendGlobalInTerm(c, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> findNonSendGlobalInList(args, fns, globalTys, adtReg, visitedFns),
    },
    TmTuple(es) -> findNonSendGlobalInList(es, fns, globalTys, adtReg, visitedFns),
    TmBlock(es) -> findNonSendGlobalInList(es, fns, globalTys, adtReg, visitedFns),
    TmMakeData(_, _, es, _, _) -> findNonSendGlobalInList(es, fns, globalTys, adtReg, visitedFns),
    TmBin(_, l, r) -> match findNonSendGlobalInTerm(l, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> findNonSendGlobalInTerm(r, fns, globalTys, adtReg, visitedFns),
    },
    TmUn(_, e) -> findNonSendGlobalInTerm(e, fns, globalTys, adtReg, visitedFns),
    TmGetTag(e) -> findNonSendGlobalInTerm(e, fns, globalTys, adtReg, visitedFns),
    TmLet(_, v, b) -> match findNonSendGlobalInTerm(v, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> findNonSendGlobalInTerm(b, fns, globalTys, adtReg, visitedFns),
    },
    TmIf(c, t, e) -> match findNonSendGlobalInTerm(c, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> match findNonSendGlobalInTerm(t, fns, globalTys, adtReg, visitedFns) {
            Some(hit) -> Some(hit),
            None -> findNonSendGlobalInTerm(e, fns, globalTys, adtReg, visitedFns),
        },
    },
    TmWhile(c, b) -> match findNonSendGlobalInTerm(c, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> findNonSendGlobalInTerm(b, fns, globalTys, adtReg, visitedFns),
    },
    TmMatch(s, arms) -> match findNonSendGlobalInTerm(s, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> findNonSendGlobalInArms(arms, fns, globalTys, adtReg, visitedFns),
    },
    _ -> None,
}

def findNonSendGlobalInList(
    es: List TaggedTerm,
    fns: StrMap FunDef,
    globalTys: StrMap Type,
    adtReg: StrMap AdtInfo,
    visitedFns: StrMap Bool
): Option (String, Type) = match es {
    Nil -> None,
    Cons(h, t) -> match findNonSendGlobalInTerm(h, fns, globalTys, adtReg, visitedFns) {
        Some(hit) -> Some(hit),
        None -> findNonSendGlobalInList(t, fns, globalTys, adtReg, visitedFns),
    },
}

def findNonSendGlobalInArms(
    arms: List CoreArm,
    fns: StrMap FunDef,
    globalTys: StrMap Type,
    adtReg: StrMap AdtInfo,
    visitedFns: StrMap Bool
): Option (String, Type) = match arms {
    Nil -> None,
    Cons(a, r) -> {
        let gHit = match a.caGuard {
            Some(g) -> findNonSendGlobalInTerm(g, fns, globalTys, adtReg, visitedFns),
            None -> None,
        };
        match gHit {
            Some(hit) -> Some(hit),
            None -> match findNonSendGlobalInTerm(a.caBody, fns, globalTys, adtReg, visitedFns) {
                Some(hit) -> Some(hit),
                None -> findNonSendGlobalInArms(r, fns, globalTys, adtReg, visitedFns),
            },
        }
    },
}

def collectLocalClosuresInTerm(tm: TaggedTerm, closures: StrMap ClosureSpec, aliases: StrMap String): Void = match tm.tnode {
    TmMakeCls(vd, cls, body) -> {
        strMapInsert(closures, vd.vname, cls);
        collectLocalClosuresInTerm(body, closures, aliases)
    },
    TmLet(vd, val, body) -> {
        match val.tnode {
            TmVar(rhs) -> strMapInsert(aliases, vd.vname, rhs),
            _ -> (),
        };
        collectLocalClosuresInTerm(val, closures, aliases);
        collectLocalClosuresInTerm(body, closures, aliases)
    },
    TmTuple(es) -> collectLocalClosuresInList(es, closures, aliases),
    TmBlock(es) -> collectLocalClosuresInList(es, closures, aliases),
    TmApplyDir(_, args) -> collectLocalClosuresInList(args, closures, aliases),
    TmMakeData(_, _, args, _, _) -> collectLocalClosuresInList(args, closures, aliases),
    TmApplyCls(c, args) -> {
        collectLocalClosuresInTerm(c, closures, aliases);
        collectLocalClosuresInList(args, closures, aliases)
    },
    TmBin(_, l, r) -> {
        collectLocalClosuresInTerm(l, closures, aliases);
        collectLocalClosuresInTerm(r, closures, aliases)
    },
    TmUn(_, e) -> collectLocalClosuresInTerm(e, closures, aliases),
    TmGetTag(e) -> collectLocalClosuresInTerm(e, closures, aliases),
    TmIf(c, t, e) -> {
        collectLocalClosuresInTerm(c, closures, aliases);
        collectLocalClosuresInTerm(t, closures, aliases);
        collectLocalClosuresInTerm(e, closures, aliases)
    },
    TmWhile(c, b) -> {
        collectLocalClosuresInTerm(c, closures, aliases);
        collectLocalClosuresInTerm(b, closures, aliases)
    },
    TmMatch(s, arms) -> {
        collectLocalClosuresInTerm(s, closures, aliases);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> collectLocalClosuresInTerm(g, closures, aliases), None -> () };
                    collectLocalClosuresInTerm(a.caBody, closures, aliases);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    _ -> (),
}

def collectLocalClosuresInList(es: List TaggedTerm, closures: StrMap ClosureSpec, aliases: StrMap String): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectLocalClosuresInTerm(h, closures, aliases);
        collectLocalClosuresInList(t, closures, aliases)
    },
}

def resolveAliasName(id: String, aliases: StrMap String, hops: Int): String =
    if (hops > 32) id
    else match strMapGet(aliases, id) {
        Some(next) -> if (next == id) id else resolveAliasName(next, aliases, hops + 1),
        None -> id,
    }

def resolveClosureSpecArg(tm: TaggedTerm, closures: StrMap ClosureSpec, aliases: StrMap String): Option ClosureSpec = match tm.tnode {
    TmMakeCls(vd, cls, body) -> match body.tnode {
        TmVar(retId) -> if (retId == vd.vname) Some(cls) else resolveClosureSpecArg(body, closures, aliases),
        _ -> resolveClosureSpecArg(body, closures, aliases),
    },
    TmLet(_, _, body) -> resolveClosureSpecArg(body, closures, aliases),
    TmBlock(es) -> match listRev(es) {
        Cons(last, _) -> resolveClosureSpecArg(last, closures, aliases),
        Nil -> None,
    },
    TmVar(id) -> strMapGet(closures, resolveAliasName(id, aliases, 0)),
    _ -> None,
}

def listNthTerm(es: List TaggedTerm, idx: Int): Option TaggedTerm = match es {
    Nil -> None,
    Cons(h, t) -> if (idx == 0) Some(h) else listNthTerm(t, idx - 1),
}

def verifySinkClosureSpec(
    cls: ClosureSpec,
    fns: StrMap FunDef,
    globalTys: StrMap Type,
    adtReg: StrMap AdtInfo
): Result Void String =
    match strMapGet(fns, cls.clsEntry) {
        None -> Ok(()),
        Some(clsFn) -> {
            let curFv = cellNew(clsFn.fnFvs);
            while (match cellGet(curFv) { Nil -> false, _ -> true }) {
                match cellGet(curFv) {
                    Cons(fvd, r) -> {
                        let fvTy = schemeBody(fvd.vscm);
                        if (!isConcreteTypeSend(adtReg, fvTy)) {
                            returnCoreErr("Concurrent closure captures non-Send variable '" + fvd.vname + "' of type '" + typeToString(fvTy) + "'")?
                        } else ();
                        cellSet(curFv, r)
                    },
                    Nil -> (),
                }
            };
            let visited: StrMap Bool = strMapNew();
            strMapInsert(visited, cls.clsEntry, true);
            match findNonSendGlobalInTerm(clsFn.fnBody, fns, globalTys, adtReg, visited) {
                Some((gn, gty)) -> Err("Concurrent closure accesses non-Send global '" + gn + "' of type '" + typeToString(gty) + "'"),
                None -> Ok(()),
            }
        },
    }

def returnCoreErr(msg: String): Result Void String = Err(msg)

def verifyConcCallsInTerm(
    tm: TaggedTerm,
    closures: StrMap ClosureSpec,
    aliases: StrMap String,
    fns: StrMap FunDef,
    globalTys: StrMap Type,
    adtReg: StrMap AdtInfo
): Result Void String = match tm.tnode {
    TmApplyDir(vd, args) -> {
        verifyConcCallsInList(args, closures, aliases, fns, globalTys, adtReg)?;
        match intrinsicSendClosureArg(vd.vname) {
            Some(argIdx) -> match listNthTerm(args, argIdx) {
                Some(argTm) -> match resolveClosureSpecArg(argTm, closures, aliases) {
                    Some(cls) -> verifySinkClosureSpec(cls, fns, globalTys, adtReg),
                    None -> Ok(()),
                },
                None -> Ok(()),
            },
            None -> Ok(()),
        }
    },
    TmMakeCls(_, _, body) -> verifyConcCallsInTerm(body, closures, aliases, fns, globalTys, adtReg),
    TmApplyCls(c, args) -> {
        verifyConcCallsInTerm(c, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInList(args, closures, aliases, fns, globalTys, adtReg)
    },
    TmTuple(es) -> verifyConcCallsInList(es, closures, aliases, fns, globalTys, adtReg),
    TmBlock(es) -> verifyConcCallsInList(es, closures, aliases, fns, globalTys, adtReg),
    TmMakeData(_, _, es, _, _) -> verifyConcCallsInList(es, closures, aliases, fns, globalTys, adtReg),
    TmBin(_, l, r) -> {
        verifyConcCallsInTerm(l, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInTerm(r, closures, aliases, fns, globalTys, adtReg)
    },
    TmUn(_, e) -> verifyConcCallsInTerm(e, closures, aliases, fns, globalTys, adtReg),
    TmGetTag(e) -> verifyConcCallsInTerm(e, closures, aliases, fns, globalTys, adtReg),
    TmLet(_, v, b) -> {
        verifyConcCallsInTerm(v, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInTerm(b, closures, aliases, fns, globalTys, adtReg)
    },
    TmIf(c, t, e) -> {
        verifyConcCallsInTerm(c, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInTerm(t, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInTerm(e, closures, aliases, fns, globalTys, adtReg)
    },
    TmWhile(c, b) -> {
        verifyConcCallsInTerm(c, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInTerm(b, closures, aliases, fns, globalTys, adtReg)
    },
    TmMatch(s, arms) -> {
        verifyConcCallsInTerm(s, closures, aliases, fns, globalTys, adtReg)?;
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> verifyConcCallsInTerm(g, closures, aliases, fns, globalTys, adtReg)?, None -> () };
                    verifyConcCallsInTerm(a.caBody, closures, aliases, fns, globalTys, adtReg)?;
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        Ok(())
    },
    _ -> Ok(()),
}

def verifyConcCallsInList(
    es: List TaggedTerm,
    closures: StrMap ClosureSpec,
    aliases: StrMap String,
    fns: StrMap FunDef,
    globalTys: StrMap Type,
    adtReg: StrMap AdtInfo
): Result Void String = match es {
    Nil -> Ok(()),
    Cons(h, t) -> {
        verifyConcCallsInTerm(h, closures, aliases, fns, globalTys, adtReg)?;
        verifyConcCallsInList(t, closures, aliases, fns, globalTys, adtReg)
    },
}

def verifyConcurrentClosures(
    fns: StrMap FunDef,
    fnNames: List String,
    globals: List GlobalValDef,
    adtReg: StrMap AdtInfo
): Result Void String = {
    let globalTys: StrMap Type = strMapNew();
    let cg = cellNew(globals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(g, r) -> { strMapInsert(globalTys, g.gvName, g.gvTy); cellSet(cg, r) },
            Nil -> (),
        }
    };
    let cf = cellNew(fnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnm, r) -> {
                match strMapGet(fns, fnm) {
                    Some(fd) -> {
                        let closures: StrMap ClosureSpec = strMapNew();
                        let aliases: StrMap String = strMapNew();
                        collectLocalClosuresInTerm(fd.fnBody, closures, aliases);
                        verifyConcCallsInTerm(fd.fnBody, closures, aliases, fns, globalTys, adtReg)?
                    },
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };
    Ok(())
}

// ============================================================================
// Recursive ADT Detection & Sound Escape Analysis
// ============================================================================

def collectAdtRefsInType(adtReg: StrMap AdtInfo, ty: Type, acc: List String): List String = match ty {
    TyCon(n) -> if (strMapContains(adtReg, n) && !listContainsStr(acc, n)) Cons(n, acc) else acc,
    TyComp(b, a) -> collectAdtRefsInType(adtReg, a, collectAdtRefsInType(adtReg, b, acc)),
    TyTuple(es) -> collectAdtRefsInList(adtReg, es, acc),
    TyArr(_, ps, r) -> collectAdtRefsInType(adtReg, r, collectAdtRefsInList(adtReg, ps, acc)),
    _ -> acc,
}

def collectAdtRefsInList(adtReg: StrMap AdtInfo, ts: List Type, acc: List String): List String = match ts {
    Nil -> acc,
    Cons(h, t) -> collectAdtRefsInList(adtReg, t, collectAdtRefsInType(adtReg, h, acc)),
}

def canAdtReachTarget(adtReg: StrMap AdtInfo, curr: String, target: String, visited: StrMap Bool): Bool =
    match strMapGet(adtReg, curr) {
        None -> false,
        Some(ainfo) -> {
            let refs = cellNew(Nil);
            let cv = cellNew(ainfo.variants);
            while (match cellGet(cv) { Nil -> false, _ -> true }) {
                match cellGet(cv) {
                    Cons(vi, r) -> {
                        cellSet(refs, collectAdtRefsInList(adtReg, vi.fieldTypes, cellGet(refs)));
                        cellSet(cv, r)
                    },
                    Nil -> (),
                }
            };
            let hit = cellNew(false);
            let cr = cellNew(cellGet(refs));
            while (match cellGet(cr) { Nil -> false, _ -> !cellGet(hit) }) {
                match cellGet(cr) {
                    Cons(nextAdt, rr) -> {
                        if (nextAdt == target) cellSet(hit, true)
                        else if (!strMapContains(visited, nextAdt)) {
                            strMapInsert(visited, nextAdt, true);
                            if (canAdtReachTarget(adtReg, nextAdt, target, visited)) cellSet(hit, true) else ()
                        } else ();
                        cellSet(cr, rr)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        },
    }

def computeRecursiveAdts(adtReg: StrMap AdtInfo, adtNames: Vec String): StrMap Bool = {
    let recMap: StrMap Bool = strMapNew();
    let i = cellNew(0);
    while (cellGet(i) < vecLen(adtNames)) {
        let nm = vecGetOr(adtNames, cellGet(i), "");
        let vis: StrMap Bool = strMapNew();
        if (canAdtReachTarget(adtReg, nm, nm, vis)) strMapInsert(recMap, nm, true) else ();
        cellSet(i, cellGet(i) + 1)
    };
    recMap
}

// ParamEscape levels encoded as `Int`: 0 = NoEscape, 1 = EscapesReturn, 2 = EscapesCapture, 3 = EscapesStore
def maxInt(a: Int, b: Int): Int = if (a > b) a else b

def addUniqueInt(xs: List Int, v: Int): List Int = match xs {
    Nil -> [v],
    Cons(h, t) -> if (h == v) xs else Cons(h, addUniqueInt(t, v)),
}

def unionInts(xs: List Int, ys: List Int): List Int = match ys {
    Nil -> xs,
    Cons(h, t) -> unionInts(addUniqueInt(xs, h), t),
}

def collectVarsInCoreTerm(tm: TaggedTerm, seen: StrMap Bool, out: Cell (List String)): Void = match tm.tnode {
    TmVar(id) ->
        if (!strMapContains(seen, id)) {
            strMapInsert(seen, id, true);
            cellSet(out, Cons(id, cellGet(out)))
        } else (),
    TmTuple(es) -> collectVarsInCoreList(es, seen, out),
    TmBlock(es) -> collectVarsInCoreList(es, seen, out),
    TmApplyDir(_, es) -> collectVarsInCoreList(es, seen, out),
    TmMakeData(_, _, es, _, _) -> collectVarsInCoreList(es, seen, out),
    TmApplyCls(c, args) -> {
        collectVarsInCoreTerm(c, seen, out);
        collectVarsInCoreList(args, seen, out)
    },
    TmIf(_, t, e) -> {
        collectVarsInCoreTerm(t, seen, out);
        collectVarsInCoreTerm(e, seen, out)
    },
    TmWhile(_, _) -> (),
    TmMatch(s, arms) -> {
        collectVarsInCoreTerm(s, seen, out);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> collectVarsInCoreTerm(g, seen, out), None -> () };
                    collectVarsInCoreTerm(a.caBody, seen, out);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmLet(_, v, b) -> {
        collectVarsInCoreTerm(v, seen, out);
        collectVarsInCoreTerm(b, seen, out)
    },
    TmMakeCls(_, cls, b) -> {
        let cf = cellNew(cls.clsFvs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fv, r) -> {
                    if (!strMapContains(seen, fv)) {
                        strMapInsert(seen, fv, true);
                        cellSet(out, Cons(fv, cellGet(out)))
                    } else ();
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        collectVarsInCoreTerm(b, seen, out)
    },
    TmUn(_, _) -> (),
    TmGetTag(_) -> (),
    TmBin(_, _, _) -> (),
    _ -> (),
}

def collectVarsInCoreList(es: List TaggedTerm, seen: StrMap Bool, out: Cell (List String)): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectVarsInCoreTerm(h, seen, out);
        collectVarsInCoreList(t, seen, out)
    },
}

def varsOfTerm(tm: TaggedTerm): List String = {
    let seen: StrMap Bool = strMapNew();
    let out = cellNew(Nil);
    collectVarsInCoreTerm(tm, seen, out);
    cellGet(out)
}

def taintUnionForVars(vars: List String, taints: StrMap (List Int)): List Int = {
    let u = cellNew(Nil);
    let cur = cellNew(vars);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(v, r) -> {
                match strMapGet(taints, v) {
                    Some(ts) -> cellSet(u, unionInts(cellGet(u), ts)),
                    None -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(u)
}

def analyzeParamEscapesInTerm(
    tm: TaggedTerm,
    taints: StrMap (List Int),
    escapesArr: MutArray Int,
    knownEscapes: StrMap (MutArray Int),
    recAdts: StrMap Bool,
    inTail: Bool
): Void = match tm.tnode {
    TmVar(id) ->
        if (inTail) {
            match strMapGet(taints, id) {
                Some(ts) -> {
                    let cur = cellNew(ts);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(idx, r) -> {
                                arraySet(escapesArr, idx, maxInt(arrayGet(escapesArr, idx), 1));
                                cellSet(cur, r)
                            },
                            Nil -> (),
                        }
                    }
                },
                None -> (),
            }
        } else (),
    TmTuple(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    analyzeParamEscapesInTerm(e, taints, escapesArr, knownEscapes, recAdts, inTail);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeCls(vd, cls, body) -> {
        let clsTaint = cellNew(Nil);
        let cf = cellNew(cls.clsFvs);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fvId, r) -> {
                    match strMapGet(taints, fvId) {
                        Some(ts) -> {
                            cellSet(clsTaint, unionInts(cellGet(clsTaint), ts));
                            let ct = cellNew(ts);
                            while (match cellGet(ct) { Nil -> false, _ -> true }) {
                                match cellGet(ct) {
                                    Cons(idx, rt) -> {
                                        arraySet(escapesArr, idx, maxInt(arrayGet(escapesArr, idx), 2));
                                        cellSet(ct, rt)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        match cellGet(clsTaint) {
            Nil -> (),
            ct -> strMapInsert(taints, vd.vname, ct),
        };
        analyzeParamEscapesInTerm(body, taints, escapesArr, knownEscapes, recAdts, inTail)
    },
    TmLet(vd, val, body) -> {
        let rhsTaint = taintUnionForVars(varsOfTerm(val), taints);
        match rhsTaint {
            Nil -> (),
            rt -> strMapInsert(taints, vd.vname, rt),
        };
        analyzeParamEscapesInTerm(val, taints, escapesArr, knownEscapes, recAdts, false);
        analyzeParamEscapesInTerm(body, taints, escapesArr, knownEscapes, recAdts, inTail)
    },
    TmApplyDir(vd, args) -> match strMapGet(knownEscapes, vd.vname) {
        Some(calleeEsc) -> {
            let cLen = arrayLen(calleeEsc);
            let idx = cellNew(0);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arg, r) -> {
                        let i = cellGet(idx);
                        let argTaints = taintUnionForVars(varsOfTerm(arg), taints);
                        let ct = cellNew(argTaints);
                        while (match cellGet(ct) { Nil -> false, _ -> true }) {
                            match cellGet(ct) {
                                Cons(pidx, rt) -> {
                                    if (i < cLen) {
                                        let ce = arrayGet(calleeEsc, i);
                                        if (ce >= 2) arraySet(escapesArr, pidx, 3)
                                        else if (ce == 1 && inTail) arraySet(escapesArr, pidx, maxInt(arrayGet(escapesArr, pidx), 1))
                                        else ()
                                    } else ();
                                    cellSet(ct, rt)
                                },
                                Nil -> (),
                            }
                        };
                        analyzeParamEscapesInTerm(arg, taints, escapesArr, knownEscapes, recAdts, false);
                        cellSet(idx, i + 1);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
        None -> {
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arg, r) -> {
                        let argTaints = taintUnionForVars(varsOfTerm(arg), taints);
                        let ct = cellNew(argTaints);
                        while (match cellGet(ct) { Nil -> false, _ -> true }) {
                            match cellGet(ct) {
                                Cons(pidx, rt) -> {
                                    arraySet(escapesArr, pidx, 3);
                                    cellSet(ct, rt)
                                },
                                Nil -> (),
                            }
                        };
                        analyzeParamEscapesInTerm(arg, taints, escapesArr, knownEscapes, recAdts, true);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    },
    TmApplyCls(c, args) -> {
        analyzeParamEscapesInTerm(c, taints, escapesArr, knownEscapes, recAdts, false);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arg, r) -> {
                    let argTaints = taintUnionForVars(varsOfTerm(arg), taints);
                    let ct = cellNew(argTaints);
                    while (match cellGet(ct) { Nil -> false, _ -> true }) {
                        match cellGet(ct) {
                            Cons(pidx, rt) -> {
                                arraySet(escapesArr, pidx, 3);
                                cellSet(ct, rt)
                            },
                            Nil -> (),
                        }
                    };
                    analyzeParamEscapesInTerm(arg, taints, escapesArr, knownEscapes, recAdts, true);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmIf(c, t, e) -> {
        analyzeParamEscapesInTerm(c, taints, escapesArr, knownEscapes, recAdts, false);
        analyzeParamEscapesInTerm(t, taints, escapesArr, knownEscapes, recAdts, inTail);
        analyzeParamEscapesInTerm(e, taints, escapesArr, knownEscapes, recAdts, inTail)
    },
    TmWhile(c, b) -> {
        analyzeParamEscapesInTerm(c, taints, escapesArr, knownEscapes, recAdts, false);
        analyzeParamEscapesInTerm(b, taints, escapesArr, knownEscapes, recAdts, false)
    },
    TmBin(_, l, r) -> {
        analyzeParamEscapesInTerm(l, taints, escapesArr, knownEscapes, recAdts, false);
        analyzeParamEscapesInTerm(r, taints, escapesArr, knownEscapes, recAdts, false)
    },
    TmUn(_, e) -> analyzeParamEscapesInTerm(e, taints, escapesArr, knownEscapes, recAdts, false),
    TmGetTag(e) -> analyzeParamEscapesInTerm(e, taints, escapesArr, knownEscapes, recAdts, false),
    TmMatch(s, arms) -> {
        let scrutTaints = taintUnionForVars(varsOfTerm(s), taints);
        if (inTail) {
            let ct = cellNew(scrutTaints);
            while (match cellGet(ct) { Nil -> false, _ -> true }) {
                match cellGet(ct) {
                    Cons(pidx, rt) -> {
                        arraySet(escapesArr, pidx, maxInt(arrayGet(escapesArr, pidx), 1));
                        cellSet(ct, rt)
                    },
                    Nil -> (),
                }
            }
        } else ();
        analyzeParamEscapesInTerm(s, taints, escapesArr, knownEscapes, recAdts, false);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match scrutTaints {
                        Nil -> (),
                        st -> {
                            let pvars = collectPatVarsList(a.caPat, Nil);
                            let cp = cellNew(pvars);
                            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                match cellGet(cp) {
                                    Cons(pv, rp) -> {
                                        let existing = match strMapGet(taints, pv) { Some(ex) -> ex, None -> Nil };
                                        strMapInsert(taints, pv, unionInts(existing, st));
                                        cellSet(cp, rp)
                                    },
                                    Nil -> (),
                                }
                            }
                        },
                    };
                    match a.caGuard { Some(g) -> analyzeParamEscapesInTerm(g, taints, escapesArr, knownEscapes, recAdts, false), None -> () };
                    analyzeParamEscapesInTerm(a.caBody, taints, escapesArr, knownEscapes, recAdts, inTail);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(tn, _, fs, _, _) -> {
        let isRec = strMapContains(recAdts, tn);
        let cur = cellNew(fs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(f, r) -> {
                    analyzeParamEscapesInTerm(f, taints, escapesArr, knownEscapes, recAdts, isRec || inTail);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmBlock(items) -> {
        let cur = cellNew(items);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(it, r) -> {
                    let isLast = match r { Nil -> true, _ -> false };
                    analyzeParamEscapesInTerm(it, taints, escapesArr, knownEscapes, recAdts, inTail && isLast);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    _ -> (),
}

def intArraysEqual(a: MutArray Int, b: MutArray Int): Bool = {
    let n = arrayLen(a);
    if (n != arrayLen(b)) false
    else {
        let i = cellNew(0);
        let eq = cellNew(true);
        while (cellGet(i) < n && cellGet(eq)) {
            let idx = cellGet(i);
            if (arrayGet(a, idx) != arrayGet(b, idx)) cellSet(eq, false) else ();
            cellSet(i, idx + 1)
        };
        cellGet(eq)
    }
}

def insertOrMergeAlloc(
    allocMap: StrMap (Bool, List String),
    allocKeys: Cell (List String),
    name: String,
    isRec: Bool,
    contained: List String
): Void = match strMapGet(allocMap, name) {
    Some((oldRec, oldList)) ->
        strMapInsert(allocMap, name, (oldRec || isRec, listAppend(contained, oldList))),
    None -> {
        cellSet(allocKeys, Cons(name, cellGet(allocKeys)));
        strMapInsert(allocMap, name, (isRec, contained))
    },
}

def isShadowedBuiltin(nm: String, fns: StrMap FunDef, externs: StrMap ExternDef): Bool =
    !strStartsWith(nm, "__gs_") && !strStartsWith(nm, "$gs$") && (strMapContains(externs, nm) || strMapContains(fns, nm))

def collectNonAllocBindings(tm: TaggedTerm, nonAlloc: StrMap Bool, allowCellOps: Bool): Void = match tm.tnode {
    TmMakeCls(_, _, body) -> collectNonAllocBindings(body, nonAlloc, allowCellOps),
    TmLet(vd, val, body) -> {
        let isEligibleAlloc = match val.tnode {
            TmMakeData(_, _, _, _, _) -> true,
            TmApplyDir(fvd, _) if (allowCellOps && fvd.vname == "cellNew") -> true,
            _ -> false,
        };
        if (!isEligibleAlloc) strMapInsert(nonAlloc, vd.vname, true) else ();
        collectNonAllocBindings(val, nonAlloc, allowCellOps);
        collectNonAllocBindings(body, nonAlloc, allowCellOps)
    },
    TmIf(c, t, e) -> {
        collectNonAllocBindings(c, nonAlloc, allowCellOps);
        collectNonAllocBindings(t, nonAlloc, allowCellOps);
        collectNonAllocBindings(e, nonAlloc, allowCellOps)
    },
    TmWhile(c, b) -> {
        collectNonAllocBindings(c, nonAlloc, allowCellOps);
        collectNonAllocBindings(b, nonAlloc, allowCellOps)
    },
    TmBin(_, l, r) -> {
        collectNonAllocBindings(l, nonAlloc, allowCellOps);
        collectNonAllocBindings(r, nonAlloc, allowCellOps)
    },
    TmUn(_, e) -> collectNonAllocBindings(e, nonAlloc, allowCellOps),
    TmGetTag(e) -> collectNonAllocBindings(e, nonAlloc, allowCellOps),
    TmMatch(s, arms) -> {
        collectNonAllocBindings(s, nonAlloc, allowCellOps);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    let pvs = collectPatVarsList(a.caPat, Nil);
                    let cp = cellNew(pvs);
                    while (match cellGet(cp) { Nil -> false, _ -> true }) {
                        match cellGet(cp) {
                            Cons(pv, rp) -> {
                                strMapInsert(nonAlloc, pv, true);
                                cellSet(cp, rp)
                            },
                            Nil -> (),
                        }
                    };
                    match a.caGuard { Some(g) -> collectNonAllocBindings(g, nonAlloc, allowCellOps), None -> () };
                    collectNonAllocBindings(a.caBody, nonAlloc, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmApplyDir(_, es) -> collectNonAllocBindingsInList(es, nonAlloc, allowCellOps),
    TmTuple(es) -> collectNonAllocBindingsInList(es, nonAlloc, allowCellOps),
    TmBlock(es) -> collectNonAllocBindingsInList(es, nonAlloc, allowCellOps),
    TmMakeData(_, _, es, _, _) -> collectNonAllocBindingsInList(es, nonAlloc, allowCellOps),
    TmApplyCls(c, args) -> {
        collectNonAllocBindings(c, nonAlloc, allowCellOps);
        collectNonAllocBindingsInList(args, nonAlloc, allowCellOps)
    },
    _ -> (),
}

def collectNonAllocBindingsInList(es: List TaggedTerm, nonAlloc: StrMap Bool, allowCellOps: Bool): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectNonAllocBindings(h, nonAlloc, allowCellOps);
        collectNonAllocBindingsInList(t, nonAlloc, allowCellOps)
    },
}

def collectLocalAllocs(
    tm: TaggedTerm,
    recAdts: StrMap Bool,
    allocMap: StrMap (Bool, List String),
    allocKeys: Cell (List String),
    allowCellOps: Bool
): Void = match tm.tnode {
    TmMakeCls(vd, cls, body) -> {
        insertOrMergeAlloc(allocMap, allocKeys, vd.vname, false, cls.clsFvs);
        collectLocalAllocs(body, recAdts, allocMap, allocKeys, allowCellOps)
    },
    TmLet(vd, val, body) -> {
        match val.tnode {
            TmMakeData(tn, _, fs, _, _) -> {
                let seen: StrMap Bool = strMapNew();
                let contained = cellNew(Nil);
                collectVarsInCoreList(fs, seen, contained);
                insertOrMergeAlloc(allocMap, allocKeys, vd.vname, strMapContains(recAdts, tn), cellGet(contained))
            },
            TmApplyDir(fvd, args) if (allowCellOps && fvd.vname == "cellNew") -> {
                let seen: StrMap Bool = strMapNew();
                let contained = cellNew(Nil);
                collectVarsInCoreList(args, seen, contained);
                insertOrMergeAlloc(allocMap, allocKeys, vd.vname, false, cellGet(contained))
            },
            _ -> (),
        };
        collectLocalAllocs(val, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocs(body, recAdts, allocMap, allocKeys, allowCellOps)
    },
    TmIf(c, t, e) -> {
        collectLocalAllocs(c, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocs(t, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocs(e, recAdts, allocMap, allocKeys, allowCellOps)
    },
    TmWhile(c, b) -> {
        collectLocalAllocs(c, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocs(b, recAdts, allocMap, allocKeys, allowCellOps)
    },
    TmBin(_, l, r) -> {
        collectLocalAllocs(l, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocs(r, recAdts, allocMap, allocKeys, allowCellOps)
    },
    TmUn(_, e) -> collectLocalAllocs(e, recAdts, allocMap, allocKeys, allowCellOps),
    TmGetTag(e) -> collectLocalAllocs(e, recAdts, allocMap, allocKeys, allowCellOps),
    TmMatch(s, arms) -> {
        collectLocalAllocs(s, recAdts, allocMap, allocKeys, allowCellOps);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> collectLocalAllocs(g, recAdts, allocMap, allocKeys, allowCellOps), None -> () };
                    collectLocalAllocs(a.caBody, recAdts, allocMap, allocKeys, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmApplyDir(_, es) -> collectLocalAllocsInList(es, recAdts, allocMap, allocKeys, allowCellOps),
    TmTuple(es) -> collectLocalAllocsInList(es, recAdts, allocMap, allocKeys, allowCellOps),
    TmBlock(es) -> collectLocalAllocsInList(es, recAdts, allocMap, allocKeys, allowCellOps),
    TmMakeData(_, _, es, _, _) -> collectLocalAllocsInList(es, recAdts, allocMap, allocKeys, allowCellOps),
    TmApplyCls(c, args) -> {
        collectLocalAllocs(c, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocsInList(args, recAdts, allocMap, allocKeys, allowCellOps)
    },
    _ -> (),
}

def collectLocalAllocsInList(
    es: List TaggedTerm,
    recAdts: StrMap Bool,
    allocMap: StrMap (Bool, List String),
    allocKeys: Cell (List String),
    allowCellOps: Bool
): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        collectLocalAllocs(h, recAdts, allocMap, allocKeys, allowCellOps);
        collectLocalAllocsInList(t, recAdts, allocMap, allocKeys, allowCellOps)
    },
}

def markEscaping(id: String, allocMap: StrMap (Bool, List String), escaping: StrMap Bool, escList: Cell (List String)): Void =
    if (strMapContains(allocMap, id) && !strMapContains(escaping, id)) {
        strMapInsert(escaping, id, true);
        cellSet(escList, Cons(id, cellGet(escList)))
    } else ()

def markVarsEscaping(vars: List String, allocMap: StrMap (Bool, List String), escaping: StrMap Bool, escList: Cell (List String)): Void = match vars {
    Nil -> (),
    Cons(v, r) -> {
        markEscaping(v, allocMap, escaping, escList);
        markVarsEscaping(r, allocMap, escaping, escList)
    },
}

def strListHas(xs: List String, target: String): Bool = match xs {
    Nil -> false,
    Cons(h, t) -> if (h == target) true else strListHas(t, target),
}

def cellOnlyGetSetList(vname: String, ts: List TaggedTerm): Bool = match ts {
    Nil -> true,
    Cons(h, t) -> cellOnlyGetSet(vname, h) && cellOnlyGetSetList(vname, t),
}

def cellOnlyGetSetArms(vname: String, arms: List CoreArm): Bool = match arms {
    Nil -> true,
    Cons(a, t) -> {
        let gOk = match a.caGuard { Some(g) -> cellOnlyGetSet(vname, g), None -> true };
        gOk && cellOnlyGetSet(vname, a.caBody) && cellOnlyGetSetArms(vname, t)
    },
}

def cellOnlyGetSet(vname: String, term: TaggedTerm): Bool = match term.tnode {
    TmLit(_) -> true,
    TmGlobalVar(_) -> true,
    TmVar(n) -> n != vname,
    TmTuple(es) -> cellOnlyGetSetList(vname, es),
    TmBlock(es) -> cellOnlyGetSetList(vname, es),
    TmMakeCls(_, spec, body) -> !strListHas(spec.clsFvs, vname) && cellOnlyGetSet(vname, body),
    TmApplyCls(fnT, args) -> cellOnlyGetSet(vname, fnT) && cellOnlyGetSetList(vname, args),
    TmApplyDir(vd, args) ->
        if (vd.vname == "cellGet") {
            match args {
                Cons(a0, Nil) -> match a0.tnode {
                    TmVar(n) if (n == vname) -> true,
                    _ -> cellOnlyGetSet(vname, a0),
                },
                _ -> cellOnlyGetSetList(vname, args),
            }
        } else if (vd.vname == "cellSet") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> match a0.tnode {
                    TmVar(n) if (n == vname) -> cellOnlyGetSet(vname, a1),
                    _ -> cellOnlyGetSet(vname, a0) && cellOnlyGetSet(vname, a1),
                },
                _ -> cellOnlyGetSetList(vname, args),
            }
        } else {
            cellOnlyGetSetList(vname, args)
        },
    TmBin(_, l, r) -> cellOnlyGetSet(vname, l) && cellOnlyGetSet(vname, r),
    TmUn(_, e) -> cellOnlyGetSet(vname, e),
    TmGetTag(e) -> cellOnlyGetSet(vname, e),
    TmLet(vd, val, body) ->
        if (vd.vname == vname) {
            match val.tnode {
                TmApplyDir(cvd, cargs) if (cvd.vname == "cellNew") ->
                    cellOnlyGetSetList(vname, cargs) && cellOnlyGetSet(vname, body),
                _ -> false,
            }
        } else {
            cellOnlyGetSet(vname, val) && cellOnlyGetSet(vname, body)
        },
    TmIf(c, t, e) -> cellOnlyGetSet(vname, c) && cellOnlyGetSet(vname, t) && cellOnlyGetSet(vname, e),
    TmWhile(c, b) -> cellOnlyGetSet(vname, c) && cellOnlyGetSet(vname, b),
    TmMatch(s, arms) -> cellOnlyGetSet(vname, s) && cellOnlyGetSetArms(vname, arms),
    TmMakeData(_, _, fs, _, _) -> cellOnlyGetSetList(vname, fs),
}

def collectPureLoopCells(b: TaggedTerm, loopKeys: List String): List String = {
    let escLoop = cellNew(Nil);
    let cur = cellNew(loopKeys);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(k, r) -> {
                if (!cellOnlyGetSet(k, b)) {
                    cellSet(escLoop, Cons(k, cellGet(escLoop)))
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(escLoop)
}

def analyzeAllocEscapes(
    tm: TaggedTerm,
    allocMap: StrMap (Bool, List String),
    escaping: StrMap Bool,
    escList: Cell (List String),
    allParamEscapes: StrMap (MutArray Int),
    recAdts: StrMap Bool,
    inTail: Bool,
    allowCellOps: Bool
): Void = match tm.tnode {
    TmVar(id) -> if (inTail) markEscaping(id, allocMap, escaping, escList) else (),
    TmTuple(es) -> {
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    analyzeAllocEscapes(e, allocMap, escaping, escList, allParamEscapes, recAdts, inTail, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeCls(_, cls, body) -> {
        markVarsEscaping(cls.clsFvs, allocMap, escaping, escList);
        analyzeAllocEscapes(body, allocMap, escaping, escList, allParamEscapes, recAdts, inTail, allowCellOps)
    },
    TmLet(_, val, body) -> {
        match val.tnode {
            TmMakeData(_, _, fs, _, _) -> {
                let cur = cellNew(fs);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(f, r) -> {
                            analyzeAllocEscapes(f, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                }
            },
            TmApplyDir(fvd, args) if (allowCellOps && fvd.vname == "cellNew") -> {
                let cur = cellNew(args);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(a, r) -> {
                            markVarsEscaping(varsOfTerm(a), allocMap, escaping, escList);
                            analyzeAllocEscapes(a, allocMap, escaping, escList, allParamEscapes, recAdts, true, allowCellOps);
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                }
            },
            TmApplyDir(fvd, _) if (allowCellOps && fvd.vname == "cellGet") ->
                analyzeAllocEscapes(val, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
            TmBin(_, _, _) ->
                analyzeAllocEscapes(val, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
            TmUn(_, _) ->
                analyzeAllocEscapes(val, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
            TmGetTag(_) ->
                analyzeAllocEscapes(val, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
            _ -> {
                markVarsEscaping(varsOfTerm(val), allocMap, escaping, escList);
                analyzeAllocEscapes(val, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps)
            },
        };
        analyzeAllocEscapes(body, allocMap, escaping, escList, allParamEscapes, recAdts, inTail, allowCellOps)
    },
    TmApplyDir(vd, args) ->
        if (allowCellOps && vd.vname == "cellGet") {
            match args {
                Cons(cellArg, _) -> analyzeAllocEscapes(cellArg, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
                Nil -> (),
            }
        } else if (allowCellOps && vd.vname == "cellSet") {
            match args {
                Cons(cellArg, Cons(valArg, _)) -> {
                    analyzeAllocEscapes(cellArg, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
                    markVarsEscaping(varsOfTerm(valArg), allocMap, escaping, escList);
                    analyzeAllocEscapes(valArg, allocMap, escaping, escList, allParamEscapes, recAdts, true, allowCellOps)
                },
                _ -> (),
            }
        } else match strMapGet(allParamEscapes, vd.vname) {
        Some(calleeEsc) -> {
            let cLen = arrayLen(calleeEsc);
            let idx = cellNew(0);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arg, r) -> {
                        let i = cellGet(idx);
                        let argEscapes =
                            if (i < cLen) {
                                let ce = arrayGet(calleeEsc, i);
                                if (ce >= 2) true else if (ce == 1) inTail else false
                            } else true;
                        if (argEscapes) markVarsEscaping(varsOfTerm(arg), allocMap, escaping, escList) else ();
                        analyzeAllocEscapes(arg, allocMap, escaping, escList, allParamEscapes, recAdts, argEscapes, allowCellOps);
                        cellSet(idx, i + 1);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
        None -> {
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(arg, r) -> {
                        markVarsEscaping(varsOfTerm(arg), allocMap, escaping, escList);
                        analyzeAllocEscapes(arg, allocMap, escaping, escList, allParamEscapes, recAdts, true, allowCellOps);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    },
    TmApplyCls(c, args) -> {
        analyzeAllocEscapes(c, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
        let cur = cellNew(args);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(arg, r) -> {
                    markVarsEscaping(varsOfTerm(arg), allocMap, escaping, escList);
                    analyzeAllocEscapes(arg, allocMap, escaping, escList, allParamEscapes, recAdts, true, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmIf(c, t, e) -> {
        analyzeAllocEscapes(c, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
        analyzeAllocEscapes(t, allocMap, escaping, escList, allParamEscapes, recAdts, inTail, allowCellOps);
        analyzeAllocEscapes(e, allocMap, escaping, escList, allParamEscapes, recAdts, inTail, allowCellOps)
    },
    TmWhile(c, b) -> {
        analyzeAllocEscapes(c, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
        let loopMap: StrMap (Bool, List String) = strMapNew();
        let loopKeys = cellNew(Nil);
        collectLocalAllocs(b, recAdts, loopMap, loopKeys, allowCellOps);
        let escLoopKeys = collectPureLoopCells(b, cellGet(loopKeys));
        markVarsEscaping(escLoopKeys, allocMap, escaping, escList);
        analyzeAllocEscapes(b, allocMap, escaping, escList, allParamEscapes, recAdts, true, allowCellOps)
    },
    TmBin(_, l, r) -> {
        analyzeAllocEscapes(l, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
        analyzeAllocEscapes(r, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps)
    },
    TmUn(_, e) -> analyzeAllocEscapes(e, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
    TmGetTag(e) -> analyzeAllocEscapes(e, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps),
    TmMatch(s, arms) -> {
        if (inTail) markVarsEscaping(varsOfTerm(s), allocMap, escaping, escList) else ();
        let scrutVars = varsOfTerm(s);
        let pvarsAll = cellNew(Nil);
        let cur0 = cellNew(arms);
        while (match cellGet(cur0) { Nil -> false, _ -> true }) {
            match cellGet(cur0) {
                Cons(a, r) -> {
                    cellSet(pvarsAll, collectPatVarsList(a.caPat, cellGet(pvarsAll)));
                    cellSet(cur0, r)
                },
                Nil -> (),
            }
        };
        let cp = cellNew(cellGet(pvarsAll));
        let scrutAdded = cellNew(false);
        while (match cellGet(cp) { Nil -> false, _ -> !cellGet(scrutAdded) }) {
            match cellGet(cp) {
                Cons(pv, rp) -> {
                    // Conservatively propagate if pattern-extracted field could be stored/captured inside arm
                    let curSV = cellNew(scrutVars);
                    while (match cellGet(curSV) { Nil -> false, _ -> true }) {
                        match cellGet(curSV) {
                            Cons(sv, rsv) -> {
                                match strMapGet(allocMap, sv) {
                                    Some((isRec, cList)) ->
                                        strMapInsert(allocMap, pv, (isRec, Cons(sv, cList))),
                                    None -> (),
                                };
                                cellSet(curSV, rsv)
                            },
                            Nil -> (),
                        }
                    };
                    cellSet(cp, rp)
                },
                Nil -> (),
            }
        };
        analyzeAllocEscapes(s, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> analyzeAllocEscapes(g, allocMap, escaping, escList, allParamEscapes, recAdts, false, allowCellOps), None -> () };
                    analyzeAllocEscapes(a.caBody, allocMap, escaping, escList, allParamEscapes, recAdts, inTail, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, fs, _, _) -> {
        let cur = cellNew(fs);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(f, r) -> {
                    markVarsEscaping(varsOfTerm(f), allocMap, escaping, escList);
                    analyzeAllocEscapes(f, allocMap, escaping, escList, allParamEscapes, recAdts, true, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmBlock(items) -> {
        let cur = cellNew(items);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(it, r) -> {
                    let isLast = match r { Nil -> true, _ -> false };
                    analyzeAllocEscapes(it, allocMap, escaping, escList, allParamEscapes, recAdts, inTail && isLast, allowCellOps);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    _ -> (),
}

def escPatBindsName(pat: Pattern, target: String): Bool = match pat {
    PatWild -> false,
    PatLit(_) -> false,
    PatVar(x, _) -> x == target,
    PatTuple(ps) -> escPatListBindsName(ps, target),
    PatCtor(_, ps) -> escPatListBindsName(ps, target),
    PatStruct(_, _) -> false,
}

def escPatListBindsName(ps: List Pattern, target: String): Bool = match ps {
    Nil -> false,
    Cons(p, r) -> if (escPatBindsName(p, target)) true else escPatListBindsName(r, target),
}

def escTermMentionsVar(fns: StrMap FunDef, tm: TaggedTerm, x: String, visitedCls: StrMap Bool): Bool = match tm.tnode {
    TmLit(_) -> false,
    TmVar(y) -> y == x,
    TmGlobalVar(_) -> false,
    TmTuple(es) -> escTermListMentionsVar(fns, es, x, visitedCls),
    TmBlock(es) -> escTermListMentionsVar(fns, es, x, visitedCls),
    TmMakeCls(vd, cls, body) -> {
        let inCls =
            if (strMapContains(visitedCls, cls.clsEntry)) false
            else {
                strMapInsert(visitedCls, cls.clsEntry, true);
                match strMapGet(fns, cls.clsEntry) {
                    Some(cfd) -> escTermMentionsVar(fns, cfd.fnBody, x, visitedCls),
                    None -> false,
                }
            };
        vd.vname == x
        || strListHas(cls.clsFvs, x)
        || inCls
        || escTermMentionsVar(fns, body, x, visitedCls)
    },
    TmApplyCls(fnTm, args) ->
        escTermMentionsVar(fns, fnTm, x, visitedCls) || escTermListMentionsVar(fns, args, x, visitedCls),
    TmApplyDir(_, args) -> escTermListMentionsVar(fns, args, x, visitedCls),
    TmBin(_, e1, e2) ->
        escTermMentionsVar(fns, e1, x, visitedCls) || escTermMentionsVar(fns, e2, x, visitedCls),
    TmUn(_, e1) -> escTermMentionsVar(fns, e1, x, visitedCls),
    TmLet(vd, e1, e2) ->
        vd.vname == x
        || escTermMentionsVar(fns, e1, x, visitedCls)
        || escTermMentionsVar(fns, e2, x, visitedCls),
    TmIf(c, t, e) ->
        escTermMentionsVar(fns, c, x, visitedCls)
        || escTermMentionsVar(fns, t, x, visitedCls)
        || escTermMentionsVar(fns, e, x, visitedCls),
    TmWhile(c, b) ->
        escTermMentionsVar(fns, c, x, visitedCls) || escTermMentionsVar(fns, b, x, visitedCls),
    TmMatch(s, arms) ->
        if (escTermMentionsVar(fns, s, x, visitedCls)) true
        else {
            let hit = cellNew(false);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> !cellGet(hit) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let gHit = match a.caGuard {
                            Some(g) -> escTermMentionsVar(fns, g, x, visitedCls),
                            None -> false,
                        };
                        if (escPatBindsName(a.caPat, x) || gHit || escTermMentionsVar(fns, a.caBody, x, visitedCls)) {
                            cellSet(hit, true)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(hit)
        },
    TmMakeData(_, _, args, _, _) -> escTermListMentionsVar(fns, args, x, visitedCls),
    TmGetTag(e1) -> escTermMentionsVar(fns, e1, x, visitedCls),
}

def escTermListMentionsVar(fns: StrMap FunDef, es: List TaggedTerm, x: String, visitedCls: StrMap Bool): Bool = match es {
    Nil -> false,
    Cons(h, t) -> if (escTermMentionsVar(fns, h, x, visitedCls)) true else escTermListMentionsVar(fns, t, x, visitedCls),
}

def escClsFreeOfVar(fns: StrMap FunDef, vd: VarDecl, cls: ClosureSpec, x: String): Bool =
    vd.vname != x
    && !strListHas(cls.clsFvs, x)
    && (match strMapGet(fns, cls.clsEntry) {
        Some(cfd) -> {
            let pbound = cellNew(false);
            let cp = cellNew(cfd.fnParams);
            while (match cellGet(cp) { Nil -> false, _ -> !cellGet(pbound) }) {
                match cellGet(cp) {
                    Cons(pvd, pr) -> {
                        if (pvd.vname == x) cellSet(pbound, true) else ();
                        cellSet(cp, pr)
                    },
                    Nil -> (),
                }
            };
            cellGet(pbound) || !escTermMentionsVar(fns, cfd.fnBody, x, strMapNew())
        },
        None -> false,
    })

def escOnlyDirectCellOps(fns: StrMap FunDef, tm: TaggedTerm, x: String): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(y) -> y != x,
    TmGlobalVar(_) -> true,
    TmTuple(es) -> escOnlyDirectCellOpsList(fns, es, x),
    TmBlock(es) -> escOnlyDirectCellOpsList(fns, es, x),
    TmMakeCls(vd, cls, body) ->
        escClsFreeOfVar(fns, vd, cls, x) && escOnlyDirectCellOps(fns, body, x),
    TmApplyCls(fnTm, args) ->
        escOnlyDirectCellOps(fns, fnTm, x) && escOnlyDirectCellOpsList(fns, args, x),
    TmApplyDir(vd, args) ->
        if (vd.vname == "cellGet") {
            match args {
                Cons(a0, Nil) -> match a0.tnode {
                    TmVar(y) -> if (y == x) true else escOnlyDirectCellOps(fns, a0, x),
                    _ -> escOnlyDirectCellOps(fns, a0, x),
                },
                _ -> false,
            }
        } else if (vd.vname == "cellSet") {
            match args {
                Cons(a0, Cons(a1, Nil)) -> match a0.tnode {
                    TmVar(y) ->
                        if (y == x) escOnlyDirectCellOps(fns, a1, x)
                        else escOnlyDirectCellOps(fns, a0, x) && escOnlyDirectCellOps(fns, a1, x),
                    _ -> escOnlyDirectCellOps(fns, a0, x) && escOnlyDirectCellOps(fns, a1, x),
                },
                _ -> false,
            }
        } else escOnlyDirectCellOpsList(fns, args, x),
    TmBin(_, e1, e2) ->
        escOnlyDirectCellOps(fns, e1, x) && escOnlyDirectCellOps(fns, e2, x),
    TmUn(_, e1) -> escOnlyDirectCellOps(fns, e1, x),
    TmLet(vd, e1, e2) ->
        vd.vname != x && escOnlyDirectCellOps(fns, e1, x) && escOnlyDirectCellOps(fns, e2, x),
    TmIf(c, t, e) ->
        escOnlyDirectCellOps(fns, c, x) && escOnlyDirectCellOps(fns, t, x) && escOnlyDirectCellOps(fns, e, x),
    TmWhile(c, b) ->
        escOnlyDirectCellOps(fns, c, x) && escOnlyDirectCellOps(fns, b, x),
    TmMatch(s, arms) ->
        if (!escOnlyDirectCellOps(fns, s, x)) false
        else {
            let ok = cellNew(true);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let gOk = match a.caGuard {
                            Some(g) -> escOnlyDirectCellOps(fns, g, x),
                            None -> true,
                        };
                        if (escPatBindsName(a.caPat, x) || !gOk || !escOnlyDirectCellOps(fns, a.caBody, x)) {
                            cellSet(ok, false)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(ok)
        },
    TmMakeData(_, _, args, _, _) -> escOnlyDirectCellOpsList(fns, args, x),
    TmGetTag(e1) -> escOnlyDirectCellOps(fns, e1, x),
}

def escOnlyDirectCellOpsList(fns: StrMap FunDef, es: List TaggedTerm, x: String): Bool = match es {
    Nil -> true,
    Cons(h, t) -> if (escOnlyDirectCellOps(fns, h, x)) escOnlyDirectCellOpsList(fns, t, x) else false,
}

def escCheckStackVarInTerm(fns: StrMap FunDef, tm: TaggedTerm, x: String): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(y) -> y != x,
    TmGlobalVar(_) -> true,
    TmTuple(es) -> escCheckStackVarInList(fns, es, x),
    TmBlock(es) -> escCheckStackVarInList(fns, es, x),
    TmMakeCls(vd, cls, body) ->
        escClsFreeOfVar(fns, vd, cls, x) && escCheckStackVarInTerm(fns, body, x),
    TmApplyCls(fnTm, args) ->
        escCheckStackVarInTerm(fns, fnTm, x) && escCheckStackVarInList(fns, args, x),
    TmApplyDir(_, args) -> escCheckStackVarInList(fns, args, x),
    TmBin(_, e1, e2) ->
        escCheckStackVarInTerm(fns, e1, x) && escCheckStackVarInTerm(fns, e2, x),
    TmUn(_, e1) -> escCheckStackVarInTerm(fns, e1, x),
    TmLet(vd, e1, e2) ->
        if (vd.vname == x) {
            match e1.tnode {
                TmApplyDir(fvd, Cons(init, Nil)) ->
                    fvd.vname == "cellNew"
                    && escCheckStackVarInTerm(fns, init, x)
                    && escOnlyDirectCellOps(fns, e2, x),
                _ -> false,
            }
        } else {
            escCheckStackVarInTerm(fns, e1, x) && escCheckStackVarInTerm(fns, e2, x)
        },
    TmIf(c, t, e) ->
        escCheckStackVarInTerm(fns, c, x)
        && escCheckStackVarInTerm(fns, t, x)
        && escCheckStackVarInTerm(fns, e, x),
    TmWhile(c, b) ->
        escCheckStackVarInTerm(fns, c, x) && escCheckStackVarInTerm(fns, b, x),
    TmMatch(s, arms) ->
        if (!escCheckStackVarInTerm(fns, s, x)) false
        else {
            let ok = cellNew(true);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let gOk = match a.caGuard {
                            Some(g) -> escCheckStackVarInTerm(fns, g, x),
                            None -> true,
                        };
                        if (escPatBindsName(a.caPat, x) || !gOk || !escCheckStackVarInTerm(fns, a.caBody, x)) {
                            cellSet(ok, false)
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(ok)
        },
    TmMakeData(_, _, args, _, _) -> escCheckStackVarInList(fns, args, x),
    TmGetTag(e1) -> escCheckStackVarInTerm(fns, e1, x),
}

def escCheckStackVarInList(fns: StrMap FunDef, es: List TaggedTerm, x: String): Bool = match es {
    Nil -> true,
    Cons(h, t) -> if (escCheckStackVarInTerm(fns, h, x)) escCheckStackVarInList(fns, t, x) else false,
}

def escCollectCellAllocs(tm: TaggedTerm, out: StrMap Bool): Void = match tm.tnode {
    TmLet(vd, val, body) -> {
        match val.tnode {
            TmApplyDir(fvd, _) if (fvd.vname == "cellNew") -> strMapInsert(out, vd.vname, true),
            _ -> (),
        };
        escCollectCellAllocs(val, out);
        escCollectCellAllocs(body, out)
    },
    TmMakeCls(_, _, body) -> escCollectCellAllocs(body, out),
    TmTuple(es) -> escCollectCellAllocsList(es, out),
    TmBlock(es) -> escCollectCellAllocsList(es, out),
    TmApplyCls(c, args) -> {
        escCollectCellAllocs(c, out);
        escCollectCellAllocsList(args, out)
    },
    TmApplyDir(_, args) -> escCollectCellAllocsList(args, out),
    TmBin(_, e1, e2) -> {
        escCollectCellAllocs(e1, out);
        escCollectCellAllocs(e2, out)
    },
    TmUn(_, e1) -> escCollectCellAllocs(e1, out),
    TmIf(c, t, e) -> {
        escCollectCellAllocs(c, out);
        escCollectCellAllocs(t, out);
        escCollectCellAllocs(e, out)
    },
    TmWhile(c, b) -> {
        escCollectCellAllocs(c, out);
        escCollectCellAllocs(b, out)
    },
    TmMatch(s, arms) -> {
        escCollectCellAllocs(s, out);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> escCollectCellAllocs(g, out), None -> () };
                    escCollectCellAllocs(a.caBody, out);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, args, _, _) -> escCollectCellAllocsList(args, out),
    TmGetTag(e1) -> escCollectCellAllocs(e1, out),
    _ -> (),
}

def escCollectCellAllocsList(es: List TaggedTerm, out: StrMap Bool): Void = match es {
    Nil -> (),
    Cons(h, t) -> {
        escCollectCellAllocs(h, out);
        escCollectCellAllocsList(t, out)
    },
}

def isVerifiedStackCellInFn(fd: FunDef, fns: StrMap FunDef, x: String): Bool = {
    let badParam = cellNew(false);
    let cp = cellNew(fd.fnParams);
    while (match cellGet(cp) { Nil -> false, _ -> !cellGet(badParam) }) {
        match cellGet(cp) {
            Cons(pvd, pr) -> {
                if (pvd.vname == x) cellSet(badParam, true) else ();
                cellSet(cp, pr)
            },
            Nil -> (),
        }
    };
    let cf = cellNew(fd.fnFvs);
    while (match cellGet(cf) { Nil -> false, _ -> !cellGet(badParam) }) {
        match cellGet(cf) {
            Cons(fvd, fr) -> {
                if (fvd.vname == x) cellSet(badParam, true) else ();
                cellSet(cf, fr)
            },
            Nil -> (),
        }
    };
    !cellGet(badParam) && escCheckStackVarInTerm(fns, fd.fnBody, x)
}

def runEscapeAnalysis(
    fns: StrMap FunDef,
    fnNames: List String,
    externs: StrMap ExternDef,
    adtReg: StrMap AdtInfo,
    adtNames: Vec String
): EscapeInfo = {
    let recAdts = computeRecursiveAdts(adtReg, adtNames);
    let allowCellOps =
        !isShadowedBuiltin("cellNew", fns, externs)
        && !isShadowedBuiltin("cellGet", fns, externs)
        && !isShadowedBuiltin("cellSet", fns, externs);

    // Phase 1: Interprocedural parameter escape fixed-point
    let paramEscapes: StrMap (MutArray Int) = strMapNew();
    let cf0 = cellNew(fnNames);
    while (match cellGet(cf0) { Nil -> false, _ -> true }) {
        match cellGet(cf0) {
            Cons(fnm, r) -> {
                match strMapGet(fns, fnm) {
                    Some(fd) -> strMapInsert(paramEscapes, fnm, arrayNew(listLen(fd.fnParams), 0)),
                    None -> (),
                };
                cellSet(cf0, r)
            },
            Nil -> (),
        }
    };

    let changed = cellNew(true);
    let iters = cellNew(0);
    while (cellGet(changed) && cellGet(iters) < 64) {
        cellSet(changed, false);
        cellSet(iters, cellGet(iters) + 1);
        let cf = cellNew(fnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(fnm, r) -> {
                    match strMapGet(fns, fnm) {
                        Some(fd) -> {
                            let pCount = listLen(fd.fnParams);
                            let nextEsc = arrayNew(pCount, 0);
                            let taints: StrMap (List Int) = strMapNew();
                            let pi = cellNew(0);
                            let cp = cellNew(fd.fnParams);
                            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                                match cellGet(cp) {
                                    Cons(pvd, rp) -> {
                                        let idx = cellGet(pi);
                                        strMapInsert(taints, pvd.vname, [idx]);
                                        cellSet(pi, idx + 1);
                                        cellSet(cp, rp)
                                    },
                                    Nil -> (),
                                }
                            };
                            analyzeParamEscapesInTerm(fd.fnBody, taints, nextEsc, paramEscapes, recAdts, true);
                            match strMapGet(paramEscapes, fnm) {
                                Some(oldEsc) ->
                                    if (!intArraysEqual(oldEsc, nextEsc)) {
                                        cellSet(changed, true);
                                        strMapInsert(paramEscapes, fnm, nextEsc)
                                    } else (),
                                None -> strMapInsert(paramEscapes, fnm, nextEsc),
                            }
                        },
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        }
    };

    // Phase 2: Intraprocedural local allocation analysis + containment propagation
    let fnStackVars: StrMap (StrMap Bool) = strMapNew();
    let fnHasStack: StrMap Bool = strMapNew();
    let cf2 = cellNew(fnNames);
    while (match cellGet(cf2) { Nil -> false, _ -> true }) {
        match cellGet(cf2) {
            Cons(fnm, r) -> {
                match strMapGet(fns, fnm) {
                    Some(fd) -> {
                        let nonAlloc: StrMap Bool = strMapNew();
                        let cp0 = cellNew(fd.fnParams);
                        while (match cellGet(cp0) { Nil -> false, _ -> true }) {
                            match cellGet(cp0) {
                                Cons(pvd, rp) -> {
                                    strMapInsert(nonAlloc, pvd.vname, true);
                                    cellSet(cp0, rp)
                                },
                                Nil -> (),
                            }
                        };
                        collectNonAllocBindings(fd.fnBody, nonAlloc, allowCellOps);

                        let allocMap: StrMap (Bool, List String) = strMapNew();
                        let allocKeys = cellNew(Nil);
                        collectLocalAllocs(fd.fnBody, recAdts, allocMap, allocKeys, allowCellOps);
                        let origKeys = cellGet(allocKeys);
                        let cellAllocs: StrMap Bool = strMapNew();
                        if (allowCellOps) escCollectCellAllocs(fd.fnBody, cellAllocs) else ();

                        let escaping: StrMap Bool = strMapNew();
                        let escList = cellNew(Nil);
                        let ck0 = cellNew(origKeys);
                        while (match cellGet(ck0) { Nil -> false, _ -> true }) {
                            match cellGet(ck0) {
                                Cons(aid, rk) -> {
                                    if (strMapContains(nonAlloc, aid)) {
                                        markEscaping(aid, allocMap, escaping, escList)
                                    } else ();
                                    if (strMapContains(cellAllocs, aid) && (!allowCellOps || !isVerifiedStackCellInFn(fd, fns, aid))) {
                                        markEscaping(aid, allocMap, escaping, escList)
                                    } else ();
                                    match strMapGet(allocMap, aid) {
                                        Some((isRec, _)) -> if (isRec) markEscaping(aid, allocMap, escaping, escList) else (),
                                        None -> (),
                                    };
                                    cellSet(ck0, rk)
                                },
                                Nil -> (),
                            }
                        };

                        analyzeAllocEscapes(fd.fnBody, allocMap, escaping, escList, paramEscapes, recAdts, true, allowCellOps);

                        // Containment fixed-point propagation
                        let propChanged = cellNew(true);
                        while (cellGet(propChanged)) {
                            cellSet(propChanged, false);
                            let snap = cellGet(escList);
                            let cs = cellNew(snap);
                            while (match cellGet(cs) { Nil -> false, _ -> true }) {
                                match cellGet(cs) {
                                    Cons(outerId, rs) -> {
                                        match strMapGet(allocMap, outerId) {
                                            Some((_, contained)) -> {
                                                let cc = cellNew(contained);
                                                while (match cellGet(cc) { Nil -> false, _ -> true }) {
                                                    match cellGet(cc) {
                                                        Cons(innerId, rc) -> {
                                                            if (strMapContains(allocMap, innerId) && !strMapContains(escaping, innerId)) {
                                                                strMapInsert(escaping, innerId, true);
                                                                cellSet(escList, Cons(innerId, cellGet(escList)));
                                                                cellSet(propChanged, true)
                                                            } else ();
                                                            cellSet(cc, rc)
                                                        },
                                                        Nil -> (),
                                                    }
                                                }
                                            },
                                            None -> (),
                                        };
                                        cellSet(cs, rs)
                                    },
                                    Nil -> (),
                                }
                            }
                        };

                        let stackSet: StrMap Bool = strMapNew();
                        let hasStack = cellNew(false);
                        let ck1 = cellNew(origKeys);
                        while (match cellGet(ck1) { Nil -> false, _ -> true }) {
                            match cellGet(ck1) {
                                Cons(aid, rk) -> {
                                    if (!strMapContains(escaping, aid)) {
                                        strMapInsert(stackSet, aid, true);
                                        cellSet(hasStack, true)
                                    } else ();
                                    cellSet(ck1, rk)
                                },
                                Nil -> (),
                            }
                        };
                        strMapInsert(fnStackVars, fnm, stackSet);
                        if (cellGet(hasStack)) strMapInsert(fnHasStack, fnm, true) else ()
                    },
                    None -> (),
                };
                cellSet(cf2, r)
            },
            Nil -> (),
        }
    };

    MkEscapeInfo {
        escRecAdts: recAdts,
        escFnStackVars: fnStackVars,
        escFnHasStack: fnHasStack,
    }
}

pub def isStackAlloc(esc: EscapeInfo, fnName: String, bindingName: String): Bool =
    match strMapGet(esc.escFnStackVars, fnName) {
        Some(m) -> strMapContains(m, bindingName),
        None -> false,
    }

pub def fnHasStackAlloc(esc: EscapeInfo, fnName: String): Bool =
    strMapContains(esc.escFnHasStack, fnName)

pub def isRecursiveAdt(esc: EscapeInfo, adtName: String): Bool =
    strMapContains(esc.escRecAdts, adtName)

// ============================================================================
// Tiny Non-Recursive Leaf Inliner (`inlineTinyLeafFns`)
// ============================================================================

def typeBlocksInline(ty: Type): Bool = match ty {
    TyVar(_) -> true,
    TyVoid -> false,
    TyCon(n) ->
        n == "ScopedPtr" || n == "Arena"
        || n == "$Local" || n == "$Shared" || n == "$Scoped",
    TyArr(_, _, _) -> true,
    TyTuple(es) -> typeListBlocksInline(es),
    TyComp(b, a) -> {
        let blockedHead = match b {
            TyCon(bn) -> bn == "Cell" || bn == "ScopedPtr" || bn == "Arena",
            _ -> false,
        };
        blockedHead || typeBlocksInline(b) || typeBlocksInline(a)
    },
}

def typeListBlocksInline(ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> typeBlocksInline(h) || typeListBlocksInline(t),
}

def varDeclListBlocksInline(vds: List VarDecl): Bool = match vds {
    Nil -> false,
    Cons(vd, r) -> typeBlocksInline(schemeBody(vd.vscm)) || varDeclListBlocksInline(r),
}

def isInlineSafeIntrinsic(name: String): Bool =
    name == "arrayLen" || name == "arrayGet" || name == "arraySet"
    || name == "immArrayLen" || name == "immArrayGet"
    || name == "strLen" || name == "strByteAt"
    || name == "bitAnd" || name == "bitAnd64" || name == "bitOr" || name == "bitOr64"
    || name == "bitXor" || name == "bitXor64" || name == "bitNot" || name == "bitNot64"
    || name == "bitShl" || name == "bitShr" || name == "bitUshr"
    || name == "bitShl64" || name == "bitShr64" || name == "bitUshr64"
    || name == "bitPopCount" || name == "bitPopCount64" || name == "bitCtz"
    || name == "bitCtz64" || name == "bitClz" || name == "bitClz64"
    || name == "__simdSplat" || name == "__simdIota" || name == "__simdExtract" || name == "__simdReplace"
    || name == "__simdUnary" || name == "__simdBin" || name == "__simdShift" || name == "__simdFma"
    || name == "__simdCmp" || name == "__simdReduce" || name == "__simdPermute"
    || name == "__simdConvert" || name == "__simdCombine"
    || name == "__simdLoad" || name == "__simdStore"
    || name == "__simdLoadRaw" || name == "__simdStoreRaw" || name == "__simdLoadStr"
    || name == "charToInt" || name == "intToChar" || name == "intToI64" || name == "i64ToInt"
    || name == "floatToBits64" || name == "bits64ToFloat" || name == "floatToBits32" || name == "bits32ToFloat"
    || name == "intToFloat" || name == "floatToInt"
    || name == "floatToF32" || name == "f32ToFloat" || name == "intToF32" || name == "f32ToInt"
    || name == "f32ToBits32" || name == "bits32ToF32"
    || name == "mathExp" || name == "mathLog" || name == "mathSqrt" || name == "mathSin" || name == "mathCos"
    || name == "mathTanh" || name == "mathPow" || name == "mathAbs" || name == "mathFloor" || name == "mathCeil" || name == "mathFma"
    || name == "mathExpF32" || name == "mathLogF32" || name == "mathSqrtF32" || name == "mathSinF32" || name == "mathCosF32"
    || name == "mathTanhF32" || name == "mathPowF32" || name == "mathAbsF32" || name == "mathFloorF32" || name == "mathCeilF32" || name == "mathFmaF32"
    || name == "ptrNull" || name == "ptrIsNull" || name == "ptrOffset" || name == "ptrOffset64"
    || name == "ptrByteAt" || name == "ptrSetByte"

def leafPatOk(pat: Pattern): Bool = match pat {
    PatWild -> true,
    PatLit(_) -> true,
    PatVar(_, _) -> true,
    PatTuple(ps) -> leafPatListOk(ps),
    PatCtor(_, ps) -> leafPatListOk(ps),
    PatStruct(_, _) -> false,
}

def leafPatListOk(ps: List Pattern): Bool = match ps {
    Nil -> true,
    Cons(p, r) -> leafPatOk(p) && leafPatListOk(r),
}

def leafTermCost(tm: TaggedTerm, fns: StrMap FunDef, externs: StrMap ExternDef): Int = {
    let ty = schemeBody(tm.tscm);
    if (!isTypeConcrete(ty) || typeBlocksInline(ty)) -1
    else match tm.tnode {
        TmLit(_) -> 1,
        TmVar(_) -> 1,
        TmGlobalVar(_) -> -1,
        TmMakeCls(_, _, _) -> -1,
        TmApplyCls(_, _) -> -1,
        TmWhile(_, _) -> -1,
        TmTuple(es) -> {
            let c = leafTermListCost(es, fns, externs);
            if (c < 0) -1 else 1 + c
        },
        TmBlock(es) -> {
            let c = leafTermListCost(es, fns, externs);
            if (c < 0) -1 else 1 + c
        },
        TmApplyDir(vd, args) ->
            if (strMapContains(fns, vd.vname) || strMapContains(externs, vd.vname) || !isInlineSafeIntrinsic(vd.vname)) -1
            else {
                let c = leafTermListCost(args, fns, externs);
                if (c < 0) -1 else 1 + c
            },
        TmBin(_, l, r) -> {
            let cl = leafTermCost(l, fns, externs);
            let cr = leafTermCost(r, fns, externs);
            if (cl < 0 || cr < 0) -1 else 1 + cl + cr
        },
        TmUn(_, e1) -> {
            let c1 = leafTermCost(e1, fns, externs);
            if (c1 < 0) -1 else 1 + c1
        },
        TmLet(vd, e1, e2) ->
            if (typeBlocksInline(schemeBody(vd.vscm))) -1
            else {
                let c1 = leafTermCost(e1, fns, externs);
                let c2 = leafTermCost(e2, fns, externs);
                if (c1 < 0 || c2 < 0) -1 else 1 + c1 + c2
            },
        TmIf(cnd, thn, els) -> {
            let cc = leafTermCost(cnd, fns, externs);
            let ct = leafTermCost(thn, fns, externs);
            let ce = leafTermCost(els, fns, externs);
            if (cc < 0 || ct < 0 || ce < 0) -1 else 1 + cc + ct + ce
        },
        TmMatch(scrut, arms) ->
            if (listLen(arms) > 4) -1
            else {
                let cs = leafTermCost(scrut, fns, externs);
                let ca = leafArmListCost(arms, fns, externs);
                if (cs < 0 || ca < 0) -1 else 1 + cs + ca
            },
        TmMakeData(_, _, args, fTys, tArgs) ->
            if (typeListBlocksInline(fTys) || typeListBlocksInline(tArgs)) -1
            else {
                let c = leafTermListCost(args, fns, externs);
                if (c < 0) -1 else 1 + c
            },
        TmGetTag(e1) -> {
            let c1 = leafTermCost(e1, fns, externs);
            if (c1 < 0) -1 else 1 + c1
        },
    }
}

def leafTermListCost(es: List TaggedTerm, fns: StrMap FunDef, externs: StrMap ExternDef): Int = match es {
    Nil -> 0,
    Cons(h, t) -> {
        let ch = leafTermCost(h, fns, externs);
        if (ch < 0) -1
        else {
            let ct = leafTermListCost(t, fns, externs);
            if (ct < 0) -1 else ch + ct
        }
    },
}

def leafArmListCost(arms: List CoreArm, fns: StrMap FunDef, externs: StrMap ExternDef): Int = match arms {
    Nil -> 0,
    Cons(a, r) ->
        if (!leafPatOk(a.caPat)) -1
        else {
            let cg = match a.caGuard {
                Some(g) -> leafTermCost(g, fns, externs),
                None -> 0,
            };
            let cb = leafTermCost(a.caBody, fns, externs);
            if (cg < 0 || cb < 0) -1
            else {
                let cr = leafArmListCost(r, fns, externs);
                if (cr < 0) -1 else 1 + cg + cb + cr
            }
        },
}

def isEligibleTinyLeafFn(fd: FunDef, fns: StrMap FunDef, externs: StrMap ExternDef): Bool =
    if (fd.fnName == "main" || strStartsWith(fd.fnName, "__ctor_")) false
    else match fd.fnFvs {
        Cons(_, _) -> false,
        Nil -> {
            let fnTy = schemeBody(fd.fnScm);
            match fnTy {
                TyArr(_, _, retTy) ->
                    if (!isTypeConcrete(fnTy) || typeBlocksInline(retTy) || varDeclListBlocksInline(fd.fnParams)) false
                    else {
                        let cost = leafTermCost(fd.fnBody, fns, externs);
                        let maxCost =
                            if (strStartsWith(fd.fnName, "std.simd.") || strStartsWith(fd.fnName, "__inst_")) 34
                            else 14;
                        cost >= 1 && cost <= maxCost
                    },
                _ -> false,
            }
        },
    }

def inlineModPrefix(fnName: String): String = {
    let n = strLen(fnName);
    let lastDot = cellNew(-1);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let b = strByteAt(fnName, cellGet(i));
        if (b == 36) cellSet(i, n)
        else {
            if (b == 46) cellSet(lastDot, cellGet(i)) else ();
            cellSet(i, cellGet(i) + 1)
        }
    };
    let d = cellGet(lastDot);
    if (d > 0) strSlice(fnName, 0, d) else ""
}

def canInlineIntoCaller(callerName: String, calleeName: String): Bool =
    strStartsWith(calleeName, "std.")
    || strStartsWith(calleeName, "__inst_")
    || inlineModPrefix(callerName) == inlineModPrefix(calleeName)

def lookupInlineEnv(env: List (String, String), name: String): String = match env {
    Nil -> name,
    Cons((k, v), r) -> if (k == name) v else lookupInlineEnv(r, name),
}

def cleanCoreBinderHint(hint: String): String = {
    let n = strLen(hint);
    if (n > 0 && strByteAt(hint, 0) == 36) {
        let lastDollar = cellNew(-1);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            if (strByteAt(hint, cellGet(i)) == 36) cellSet(lastDollar, cellGet(i)) else ();
            cellSet(i, cellGet(i) + 1)
        };
        let d = cellGet(lastDollar);
        if (d >= 0 && d + 1 < n) strSlice(hint, d + 1, n) else hint
    } else hint
}

def allocFreshCoreBinder(nextId: Cell Int, tag: String, hint: String): String
    requires cellGet(nextId) >= 0 && cellGet(nextId) < 2147483647 && strLen(tag) > 0
    ensures r -> cellGet(nextId) > 0 && strLen(r) >= 4
= {
    let id = cellGet(nextId);
    cellSet(nextId, coFreshNextId(id));
    "$" + tag + "$" + intToStr(id) + "$" + cleanCoreBinderHint(hint)
}

def alphaClonePat(pat: Pattern, nextId: Cell Int, env: List (String, String)): (Pattern, List (String, String)) = match pat {
    PatWild -> (PatWild, env),
    PatLit(l) -> (PatLit(l), env),
    PatVar(v, sp) -> {
        let fv = allocFreshCoreBinder(nextId, "inl", v);
        (PatVar(fv, sp), Cons((v, fv), env))
    },
    PatTuple(ps) -> {
        let (ps2, env2) = alphaClonePatList(ps, nextId, env);
        (PatTuple(ps2), env2)
    },
    PatCtor(cn, ps) -> {
        let (ps2, env2) = alphaClonePatList(ps, nextId, env);
        (PatCtor(cn, ps2), env2)
    },
    PatStruct(cn, fs) -> (PatStruct(cn, fs), env),
}

def alphaClonePatList(
    ps: List Pattern,
    nextId: Cell Int,
    env: List (String, String)
): (List Pattern, List (String, String)) = match ps {
    Nil -> (Nil, env),
    Cons(p, r) -> {
        let (p2, env1) = alphaClonePat(p, nextId, env);
        let (r2, env2) = alphaClonePatList(r, nextId, env1);
        (Cons(p2, r2), env2)
    },
}

def alphaCloneTerm(tm: TaggedTerm, nextId: Cell Int, env: List (String, String), sp: Span): TaggedTerm = {
    let nd = match tm.tnode {
        TmLit(l) -> TmLit(l),
        TmVar(v) -> TmVar(lookupInlineEnv(env, v)),
        TmGlobalVar(g) -> TmGlobalVar(g),
        TmTuple(es) -> TmTuple(alphaCloneTermList(es, nextId, env, sp)),
        TmBlock(es) -> TmBlock(alphaCloneTermList(es, nextId, env, sp)),
        TmMakeCls(vd, cls, body) -> TmMakeCls(vd, cls, alphaCloneTerm(body, nextId, env, sp)),
        TmApplyCls(c, args) -> TmApplyCls(alphaCloneTerm(c, nextId, env, sp), alphaCloneTermList(args, nextId, env, sp)),
        TmApplyDir(vd, args) -> TmApplyDir(vd, alphaCloneTermList(args, nextId, env, sp)),
        TmBin(op, l, r) -> TmBin(op, alphaCloneTerm(l, nextId, env, sp), alphaCloneTerm(r, nextId, env, sp)),
        TmUn(op, e1) -> TmUn(op, alphaCloneTerm(e1, nextId, env, sp)),
        TmLet(vd, e1, e2) -> {
            let e1c = alphaCloneTerm(e1, nextId, env, sp);
            let fv = allocFreshCoreBinder(nextId, "inl", vd.vname);
            let vd2 = MkVarDecl { vname: fv, vscm: vd.vscm };
            let e2c = alphaCloneTerm(e2, nextId, Cons((vd.vname, fv), env), sp);
            TmLet(vd2, e1c, e2c)
        },
        TmIf(c, t, e) -> TmIf(alphaCloneTerm(c, nextId, env, sp), alphaCloneTerm(t, nextId, env, sp), alphaCloneTerm(e, nextId, env, sp)),
        TmWhile(c, b) -> TmWhile(alphaCloneTerm(c, nextId, env, sp), alphaCloneTerm(b, nextId, env, sp)),
        TmMatch(s, arms) -> TmMatch(alphaCloneTerm(s, nextId, env, sp), alphaCloneArmList(arms, nextId, env, sp)),
        TmMakeData(cn, tag, args, fTys, tArgs) ->
            TmMakeData(cn, tag, alphaCloneTermList(args, nextId, env, sp), fTys, tArgs),
        TmGetTag(e1) -> TmGetTag(alphaCloneTerm(e1, nextId, env, sp)),
    };
    MkTerm { tspan: sp, tscm: tm.tscm, tnode: nd }
}

def alphaCloneTermList(
    es: List TaggedTerm,
    nextId: Cell Int,
    env: List (String, String),
    sp: Span
): List TaggedTerm = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(alphaCloneTerm(h, nextId, env, sp), alphaCloneTermList(t, nextId, env, sp)),
}

def alphaCloneArmList(
    arms: List CoreArm,
    nextId: Cell Int,
    env: List (String, String),
    sp: Span
): List CoreArm = match arms {
    Nil -> Nil,
    Cons(a, r) -> {
        let (pat2, envArm) = alphaClonePat(a.caPat, nextId, env);
        let g2 = match a.caGuard {
            Some(g) -> Some(alphaCloneTerm(g, nextId, envArm, sp)),
            None -> None,
        };
        let b2 = alphaCloneTerm(a.caBody, nextId, envArm, sp);
        Cons(MkCoreArm { caPat: pat2, caGuard: g2, caBody: b2 }, alphaCloneArmList(r, nextId, env, sp))
    },
}

def inlineParamsMatchArgs(ps: List VarDecl, args: List TaggedTerm): Bool = match (ps, args) {
    (Nil, Nil) -> true,
    (Cons(p, pr), Cons(a, ar)) ->
        typesEqual(schemeBody(p.vscm), schemeBody(a.tscm)) && inlineParamsMatchArgs(pr, ar),
    _ -> false,
}

def allocParamInlineBinders(
    ps: List VarDecl,
    nextId: Cell Int
): (List String, List (String, String))
    requires cellGet(nextId) >= 0
    ensures r -> match r { (nms, env) -> listLen(nms) == listLen(ps) && listLen(env) == listLen(ps) }
= {
    let startId = cellGet(nextId);
    let namesRev: Cell (List String) = cellNew(Nil);
    let envCell: Cell (List (String, String)) = cellNew(Nil);
    let cur = cellNew(ps);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(p, r) -> {
                let fnm = allocFreshCoreBinder(nextId, "inl", p.vname);
                cellSet(namesRev, Cons(fnm, cellGet(namesRev)));
                cellSet(envCell, Cons((p.vname, fnm), cellGet(envCell)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    let pCnt = listLen(ps);
    if (startId <= 1073741824 && pCnt <= 1048576) {
        assert(cellGet(nextId) == coFreshBatchEnd(startId, pCnt))
    } else ();
    (listRev(cellGet(namesRev)), cellGet(envCell))
}

def wrapInlinedParamLets(
    pNames: List String,
    args: List TaggedTerm,
    body: TaggedTerm,
    sp: Span,
    resScm: Scheme
): TaggedTerm = match (pNames, args) {
    (Cons(pnm, pr), Cons(a, ar)) -> {
        let inner = wrapInlinedParamLets(pr, ar, body, sp, resScm);
        let vd = MkVarDecl { vname: pnm, vscm: ScmMono(schemeBody(a.tscm)) };
        MkTerm { tspan: sp, tscm: resScm, tnode: TmLet(vd, a, inner) }
    },
    _ -> body,
}

def rewriteTermInlineLeaves(
    callerName: String,
    tm: TaggedTerm,
    leaves: StrMap FunDef,
    nextId: Cell Int
): TaggedTerm = {
    let sp = tm.tspan;
    let sc = tm.tscm;
    match tm.tnode {
        TmLit(_) -> tm,
        TmVar(_) -> tm,
        TmGlobalVar(_) -> tm,
        TmTuple(es) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmTuple(rewriteTermListInlineLeaves(callerName, es, leaves, nextId)),
        },
        TmBlock(es) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmBlock(rewriteTermListInlineLeaves(callerName, es, leaves, nextId)),
        },
        TmMakeCls(vd, cls, body) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmMakeCls(vd, cls, rewriteTermInlineLeaves(callerName, body, leaves, nextId)),
        },
        TmApplyCls(c, args) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmApplyCls(
                rewriteTermInlineLeaves(callerName, c, leaves, nextId),
                rewriteTermListInlineLeaves(callerName, args, leaves, nextId)
            ),
        },
        TmApplyDir(vd, args) -> {
            let args2 = rewriteTermListInlineLeaves(callerName, args, leaves, nextId);
            match strMapGet(leaves, vd.vname) {
                Some(callee) ->
                    if (
                        callerName != callee.fnName
                        && canInlineIntoCaller(callerName, callee.fnName)
                        && typesEqual(schemeBody(sc), schemeBody(callee.fnBody.tscm))
                        && inlineParamsMatchArgs(callee.fnParams, args2)
                    ) {
                        let (pNames, pEnv) = allocParamInlineBinders(callee.fnParams, nextId);
                        let cloned = alphaCloneTerm(callee.fnBody, nextId, pEnv, sp);
                        wrapInlinedParamLets(pNames, args2, cloned, sp, sc)
                    } else MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(vd, args2) },
                None -> MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(vd, args2) },
            }
        },
        TmBin(op, l, r) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmBin(
                op,
                rewriteTermInlineLeaves(callerName, l, leaves, nextId),
                rewriteTermInlineLeaves(callerName, r, leaves, nextId)
            ),
        },
        TmUn(op, e1) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmUn(op, rewriteTermInlineLeaves(callerName, e1, leaves, nextId)),
        },
        TmLet(vd, e1, e2) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmLet(
                vd,
                rewriteTermInlineLeaves(callerName, e1, leaves, nextId),
                rewriteTermInlineLeaves(callerName, e2, leaves, nextId)
            ),
        },
        TmIf(c, t, e) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmIf(
                rewriteTermInlineLeaves(callerName, c, leaves, nextId),
                rewriteTermInlineLeaves(callerName, t, leaves, nextId),
                rewriteTermInlineLeaves(callerName, e, leaves, nextId)
            ),
        },
        TmWhile(c, b) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmWhile(
                rewriteTermInlineLeaves(callerName, c, leaves, nextId),
                rewriteTermInlineLeaves(callerName, b, leaves, nextId)
            ),
        },
        TmMatch(s, arms) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmMatch(
                rewriteTermInlineLeaves(callerName, s, leaves, nextId),
                rewriteArmListInlineLeaves(callerName, arms, leaves, nextId)
            ),
        },
        TmMakeData(cn, tag, args, fTys, tArgs) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmMakeData(cn, tag, rewriteTermListInlineLeaves(callerName, args, leaves, nextId), fTys, tArgs),
        },
        TmGetTag(e1) -> MkTerm {
            tspan: sp,
            tscm: sc,
            tnode: TmGetTag(rewriteTermInlineLeaves(callerName, e1, leaves, nextId)),
        },
    }
}

def rewriteTermListInlineLeaves(
    callerName: String,
    es: List TaggedTerm,
    leaves: StrMap FunDef,
    nextId: Cell Int
): List TaggedTerm = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(
        rewriteTermInlineLeaves(callerName, h, leaves, nextId),
        rewriteTermListInlineLeaves(callerName, t, leaves, nextId)
    ),
}

def rewriteArmListInlineLeaves(
    callerName: String,
    arms: List CoreArm,
    leaves: StrMap FunDef,
    nextId: Cell Int
): List CoreArm = match arms {
    Nil -> Nil,
    Cons(a, r) -> {
        let g2 = match a.caGuard {
            Some(g) -> Some(rewriteTermInlineLeaves(callerName, g, leaves, nextId)),
            None -> None,
        };
        let b2 = rewriteTermInlineLeaves(callerName, a.caBody, leaves, nextId);
        Cons(
            MkCoreArm { caPat: a.caPat, caGuard: g2, caBody: b2 },
            rewriteArmListInlineLeaves(callerName, r, leaves, nextId)
        )
    },
}

def termListHasCheckedOp(ts: List TaggedTerm, fns: StrMap FunDef, externs: StrMap ExternDef): Bool = match ts {
    Nil -> false,
    Cons(t, r) -> if (termHasCheckedOp(t, fns, externs)) true else termListHasCheckedOp(r, fns, externs),
}

def armListHasCheckedOp(arms: List CoreArm, fns: StrMap FunDef, externs: StrMap ExternDef): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let gHas = match a.caGuard { Some(g) -> termHasCheckedOp(g, fns, externs), None -> false };
        if (gHas || termHasCheckedOp(a.caBody, fns, externs)) true else armListHasCheckedOp(r, fns, externs)
    },
}

def termHasCheckedOp(tm: TaggedTerm, fns: StrMap FunDef, externs: StrMap ExternDef): Bool = match tm.tnode {
    TmBin(op, a, b) -> {
        let isDiv = match op { OpDiv -> true, OpRem -> true, _ -> false };
        isDiv || termHasCheckedOp(a, fns, externs) || termHasCheckedOp(b, fns, externs)
    },
    TmApplyDir(vd, args) -> {
        let nm = vd.vname;
        let isArr =
            !isShadowedBuiltin(nm, fns, externs)
            && (nm == "arrayGet" || nm == "immArrayGet" || nm == "arraySet"
                || nm == "arrayNew" || nm == "arrayNewZeroed");
        isArr || termListHasCheckedOp(args, fns, externs)
    },
    TmApplyCls(f, args) -> termHasCheckedOp(f, fns, externs) || termListHasCheckedOp(args, fns, externs),
    TmTuple(es) -> termListHasCheckedOp(es, fns, externs),
    TmBlock(es) -> termListHasCheckedOp(es, fns, externs),
    TmMakeCls(_, _, body) -> termHasCheckedOp(body, fns, externs),
    TmMakeData(_, _, fs, _, _) -> termListHasCheckedOp(fs, fns, externs),
    TmUn(_, a) -> termHasCheckedOp(a, fns, externs),
    TmLet(_, v, b) -> termHasCheckedOp(v, fns, externs) || termHasCheckedOp(b, fns, externs),
    TmIf(c, t, e) -> termHasCheckedOp(c, fns, externs) || termHasCheckedOp(t, fns, externs) || termHasCheckedOp(e, fns, externs),
    TmWhile(c, b) -> termHasCheckedOp(c, fns, externs) || termHasCheckedOp(b, fns, externs),
    TmMatch(s, arms) -> termHasCheckedOp(s, fns, externs) || armListHasCheckedOp(arms, fns, externs),
    TmGetTag(e) -> termHasCheckedOp(e, fns, externs),
    _ -> false,
}

def isPureScalarAssumeTermCoreList(ts: List TaggedTerm, fns: StrMap FunDef, externs: StrMap ExternDef): Bool = match ts {
    Nil -> true,
    Cons(t, r) -> if (isPureScalarAssumeTermCore(t, fns, externs)) isPureScalarAssumeTermCoreList(r, fns, externs) else false,
}

def isAllowedScalarAssumeTypeCore(ty: Type): Bool = match ty {
    TyCon("Int") -> true,
    TyCon("Int64") -> true,
    TyCon("Bool") -> true,
    TyCon("Char") -> true,
    _ -> false,
}

def isPureScalarAssumeTermCore(tm: TaggedTerm, fns: StrMap FunDef, externs: StrMap ExternDef): Bool = match tm.tnode {
    TmLit(_) -> isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm)),
    TmVar(_) -> isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm)),
    TmBin(op, a, b) -> {
        let isDiv = match op { OpDiv -> true, OpRem -> true, _ -> false };
        !isDiv
        && isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm))
        && isAllowedScalarAssumeTypeCore(schemeBody(a.tscm))
        && isAllowedScalarAssumeTypeCore(schemeBody(b.tscm))
        && isPureScalarAssumeTermCore(a, fns, externs)
        && isPureScalarAssumeTermCore(b, fns, externs)
    },
    TmUn(_, a) ->
        isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm))
        && isAllowedScalarAssumeTypeCore(schemeBody(a.tscm))
        && isPureScalarAssumeTermCore(a, fns, externs),
    TmIf(c, t, e) ->
        isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm))
        && isPureScalarAssumeTermCore(c, fns, externs)
        && isPureScalarAssumeTermCore(t, fns, externs)
        && isPureScalarAssumeTermCore(e, fns, externs),
    TmGetTag(e) ->
        isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm))
        && match e.tnode { TmVar(_) -> true, _ -> false },
    TmApplyDir(vd, args) ->
        if (isShadowedBuiltin(vd.vname, fns, externs)) false
        else if (vd.vname == "cellGet") {
            isAllowedScalarAssumeTypeCore(schemeBody(tm.tscm))
            && match args { Cons(a0, Nil) -> match a0.tnode { TmVar(_) -> true, _ -> false }, _ -> false }
        } else if (vd.vname == "arrayLen" || vd.vname == "immArrayLen") {
            match args { Cons(a0, Nil) -> match a0.tnode { TmVar(_) -> true, _ -> false }, _ -> false }
        } else false,
    _ -> false,
}

def isEnsuresOnlyBlockEndingInVar(es: List TaggedTerm, resName: String): Bool = match es {
    Nil -> false,
    Cons(last, Nil) -> match last.tnode { TmVar(nm) -> nm == resName, _ -> false },
    Cons(hd, rest) -> match hd.tnode {
        TmApplyDir(vd, _) ->
            if (vd.vname == "__gs_ensures") isEnsuresOnlyBlockEndingInVar(rest, resName)
            else false,
        _ -> false,
    },
}

def isUnitLitTerm(tm: TaggedTerm): Bool = match tm.tnode {
    TmLit(LitUnit) -> true,
    _ -> false,
}

def pruneLeadingUnitStmts(es: List TaggedTerm): List TaggedTerm = match es {
    Nil -> Nil,
    Cons(last, Nil) -> Cons(last, Nil),
    Cons(hd, rest) ->
        if (isUnitLitTerm(hd)) pruneLeadingUnitStmts(rest)
        else Cons(hd, pruneLeadingUnitStmts(rest)),
}

def eraseContractsTermList(ts: List TaggedTerm, keepReq: Bool, fns: StrMap FunDef, externs: StrMap ExternDef): List TaggedTerm = match ts {
    Nil -> Nil,
    Cons(t, r) -> Cons(eraseContractsTerm(t, keepReq, fns, externs), eraseContractsTermList(r, keepReq, fns, externs)),
}

def eraseContractsArms(arms: List CoreArm, keepReq: Bool, fns: StrMap FunDef, externs: StrMap ExternDef): List CoreArm = match arms {
    Nil -> Nil,
    Cons(a, r) -> {
        let g2 = match a.caGuard { Some(g) -> Some(eraseContractsTerm(g, keepReq, fns, externs)), None -> None };
        Cons(
            MkCoreArm { caPat: a.caPat, caGuard: g2, caBody: eraseContractsTerm(a.caBody, keepReq, fns, externs) },
            eraseContractsArms(r, keepReq, fns, externs)
        )
    },
}

def eraseContractsTerm(tm: TaggedTerm, keepReq: Bool, fns: StrMap FunDef, externs: StrMap ExternDef): TaggedTerm = {
    let mk = (n: Term) -> MkTerm { tspan: tm.tspan, tscm: tm.tscm, tnode: n };
    match tm.tnode {
        TmApplyDir(vd, args) -> {
            let nm = vd.vname;
            if (nm == "__gs_ensures" || nm == "__gs_invariant" || nm == "__gs_decreases" || (nm == "assume" && !isShadowedBuiltin(nm, fns, externs))) {
                MkTerm { tspan: tm.tspan, tscm: ScmMono(TyVoid), tnode: TmLit(LitUnit) }
            } else if (nm == "__gs_requires" || (nm == "assert" && !isShadowedBuiltin(nm, fns, externs))) {
                let keepThis = keepReq && match args {
                    Cons(a0, _) -> isPureScalarAssumeTermCore(a0, fns, externs),
                    Nil -> false,
                };
                if (keepThis) mk(TmApplyDir(vd, eraseContractsTermList(args, keepReq, fns, externs)))
                else MkTerm { tspan: tm.tspan, tscm: ScmMono(TyVoid), tnode: TmLit(LitUnit) }
            } else {
                mk(TmApplyDir(vd, eraseContractsTermList(args, keepReq, fns, externs)))
            }
        },
        TmLet(vd, v, b) -> {
            // Erase `let r = __gs_res in ()` left behind after erasing `ensures r -> ...`,
            // and unwrap `let __gs_res = body in __gs_res` to restore tail-call TCO!
            let b2 = eraseContractsTerm(b, keepReq, fns, externs);
            let isResVar = match v.tnode { TmVar(nm) -> nm == "__gs_res", _ -> false };
            if (isUnitLitTerm(b2) && isResVar) {
                b2
            } else {
                let isRetRes =
                    vd.vname == "__gs_res"
                    && match b2.tnode { TmVar(nm) -> nm == "__gs_res", _ -> false };
                if (isRetRes) eraseContractsTerm(v, keepReq, fns, externs)
                else mk(TmLet(vd, eraseContractsTerm(v, keepReq, fns, externs), b2))
            }
        },
        TmBlock(es) -> {
            let mapped = pruneLeadingUnitStmts(eraseContractsTermList(es, keepReq, fns, externs));
            match mapped {
                Cons(single, Nil) -> single,
                _ -> mk(TmBlock(mapped)),
            }
        },
        TmApplyCls(f, args) -> mk(TmApplyCls(eraseContractsTerm(f, keepReq, fns, externs), eraseContractsTermList(args, keepReq, fns, externs))),
        TmTuple(es) -> mk(TmTuple(eraseContractsTermList(es, keepReq, fns, externs))),
        TmMakeCls(vd, cs, body) -> mk(TmMakeCls(vd, cs, eraseContractsTerm(body, keepReq, fns, externs))),
        TmMakeData(adt, tag, fs, t1, t2) -> mk(TmMakeData(adt, tag, eraseContractsTermList(fs, keepReq, fns, externs), t1, t2)),
        TmBin(op, a, b) -> mk(TmBin(op, eraseContractsTerm(a, keepReq, fns, externs), eraseContractsTerm(b, keepReq, fns, externs))),
        TmUn(op, a) -> mk(TmUn(op, eraseContractsTerm(a, keepReq, fns, externs))),
        TmIf(c, t, e) -> mk(TmIf(eraseContractsTerm(c, keepReq, fns, externs), eraseContractsTerm(t, keepReq, fns, externs), eraseContractsTerm(e, keepReq, fns, externs))),
        TmWhile(c, b) -> mk(TmWhile(eraseContractsTerm(c, keepReq, fns, externs), eraseContractsTerm(b, keepReq, fns, externs))),
        TmMatch(s, arms) -> mk(TmMatch(eraseContractsTerm(s, keepReq, fns, externs), eraseContractsArms(arms, keepReq, fns, externs))),
        TmGetTag(e) -> mk(TmGetTag(eraseContractsTerm(e, keepReq, fns, externs))),
        _ -> tm,
    }
}

/// Prepare a verified `"keep"` CoreProgram for `--verified-opt` LLVM codegen:
/// 1. Unwraps `__gs_res` `ensures` wrappers so recursive calls stay in tail position (TCO preserved);
/// 2. Erases all contracts/asserts except pure-scalar `__gs_requires`/`assert` inside `safeFns`;
/// 3. Runs `inlineTinyLeafFns` while preventing unverified div/array ops from being inlined into `safeFns`.
pub def prepareVerifiedOptCore(
    prog: CoreProgram,
    safeFns: StrMap Bool,
    enableInline: Bool
): CoreProgram = {
    let fns2: StrMap FunDef = strMapNew();
    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(nm, r) -> {
                match strMapGet(prog.coreFns, nm) {
                    Some(fd) -> {
                        let keepReq = strMapContains(safeFns, nm);
                        strMapInsert(fns2, nm, MkFunDef {
                            fnName: fd.fnName,
                            fnSpan: fd.fnSpan,
                            fnScm: fd.fnScm,
                            fnParams: fd.fnParams,
                            fnFvs: fd.fnFvs,
                            fnBody: eraseContractsTerm(fd.fnBody, keepReq, prog.coreFns, prog.coreExterns),
                        })
                    },
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };
    let globsRev: Cell (List GlobalValDef) = cellNew(Nil);
    let cg = cellNew(prog.coreGlobals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(gv, r) -> {
                cellSet(globsRev, Cons(MkGlobalValDef {
                    gvName: gv.gvName,
                    gvSpan: gv.gvSpan,
                    gvTy: gv.gvTy,
                    gvInit: eraseContractsTerm(gv.gvInit, false, prog.coreFns, prog.coreExterns),
                }, cellGet(globsRev)));
                cellSet(cg, r)
            },
            Nil -> (),
        }
    };
    let globs2 = listRev(cellGet(globsRev));
    let (finalNames, finalGlobs, finalEscape) =
        if (enableInline) {
            // Restrict leaf inlining into `safeFns` callers: only inline leaves that are also
            // in `safeFns` or contain no checked div/rem/array operations.
            let nextBinderId = cellNew(0);
            let curGlobals = cellNew(globs2);
            let pass = cellNew(0);
            while (cellGet(pass) < 2) {
                let unverifiedLeaves: StrMap FunDef = strMapNew();
                let safeLeaves: StrMap FunDef = strMapNew();
                let leafCount = cellNew(0);
                let cf0 = cellNew(prog.coreFnNames);
                while (match cellGet(cf0) { Nil -> false, _ -> true }) {
                    match cellGet(cf0) {
                        Cons(fnm, r) -> {
                            match strMapGet(fns2, fnm) {
                                Some(fd) ->
                                    if (isEligibleTinyLeafFn(fd, fns2, prog.coreExterns)) {
                                        if (!strMapContains(safeFns, fnm)) {
                                            strMapInsert(unverifiedLeaves, fnm, fd)
                                        } else ();
                                        if (strMapContains(safeFns, fnm) || !termHasCheckedOp(fd.fnBody, fns2, prog.coreExterns)) {
                                            strMapInsert(safeLeaves, fnm, fd)
                                        } else ();
                                        cellSet(leafCount, cellGet(leafCount) + 1)
                                    } else (),
                                None -> (),
                            };
                            cellSet(cf0, r)
                        },
                        Nil -> (),
                    }
                };
                if (cellGet(leafCount) > 0) {
                    let cf1 = cellNew(prog.coreFnNames);
                    while (match cellGet(cf1) { Nil -> false, _ -> true }) {
                        match cellGet(cf1) {
                            Cons(fnm, r) -> {
                                match strMapGet(fns2, fnm) {
                                    Some(fd) -> {
                                        let allowedLeaves = if (strMapContains(safeFns, fnm)) safeLeaves else unverifiedLeaves;
                                        let newBody = rewriteTermInlineLeaves(fnm, fd.fnBody, allowedLeaves, nextBinderId);
                                        strMapInsert(fns2, fnm, MkFunDef {
                                            fnName: fd.fnName,
                                            fnSpan: fd.fnSpan,
                                            fnScm: fd.fnScm,
                                            fnParams: fd.fnParams,
                                            fnFvs: fd.fnFvs,
                                            fnBody: newBody,
                                        })
                                    },
                                    None -> (),
                                };
                                cellSet(cf1, r)
                            },
                            Nil -> (),
                        }
                    };
                    let newGlobsRev = cellNew(Nil);
                    let cg2 = cellNew(cellGet(curGlobals));
                    while (match cellGet(cg2) { Nil -> false, _ -> true }) {
                        match cellGet(cg2) {
                            Cons(gv, r) -> {
                                let newInit = rewriteTermInlineLeaves("", gv.gvInit, unverifiedLeaves, nextBinderId);
                                cellSet(newGlobsRev, Cons(MkGlobalValDef {
                                    gvName: gv.gvName,
                                    gvSpan: gv.gvSpan,
                                    gvTy: gv.gvTy,
                                    gvInit: newInit,
                                }, cellGet(newGlobsRev)));
                                cellSet(cg2, r)
                            },
                            Nil -> (),
                        }
                    };
                    cellSet(curGlobals, listRev(cellGet(newGlobsRev)))
                } else ();
                cellSet(pass, cellGet(pass) + 1)
            };
            // Run HOF combinator/closure/loop optimization on non-`safeFns` functions while
            // keeping `safeFns` bodies & boundaries intact (`coSkipFns = safeFns`).
            let voptCtorMap: StrMap (String, VariantInfo) = strMapNew();
            let adtVec: Vec String = vecNew();
            let ca = cellNew(prog.coreAdtNames);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(adtName, ra) -> {
                        vecPush(adtVec, adtName);
                        match strMapGet(prog.coreAdtReg, adtName) {
                            Some(ainfo) -> {
                                let cv = cellNew(ainfo.variants);
                                while (match cellGet(cv) { Nil -> false, _ -> true }) {
                                    match cellGet(cv) {
                                        Cons(vi, rv) -> {
                                            strMapInsert(voptCtorMap, vi.vname, (adtName, vi));
                                            cellSet(cv, rv)
                                        },
                                        Nil -> (),
                                    }
                                }
                            },
                            None -> (),
                        };
                        cellSet(ca, ra)
                    },
                    Nil -> (),
                }
            };
            let (nsOpt, gsOpt) = optimizeCoreCombinators(
                fns2, prog.coreFnNames, cellGet(curGlobals), prog.coreExterns,
                voptCtorMap, prog.coreCExports, safeFns, nextBinderId
            );
            let escOpt = runEscapeAnalysis(fns2, nsOpt, prog.coreExterns, prog.coreAdtReg, adtVec);
            (nsOpt, gsOpt, escOpt)
        } else (prog.coreFnNames, globs2, prog.coreEscape);
    MkCoreProgram {
        coreFns: fns2,
        coreFnNames: finalNames,
        coreGlobals: finalGlobs,
        coreExterns: prog.coreExterns,
        coreExternNames: prog.coreExternNames,
        coreCExports: prog.coreCExports,
        coreCtors: prog.coreCtors,
        coreAdtReg: prog.coreAdtReg,
        coreAdtNames: prog.coreAdtNames,
        coreEscape: finalEscape,
        coreVerifiedFns: prog.coreVerifiedFns,
        coreOrigFnNames: prog.coreOrigFnNames,
        coreUnseededPolyFns: prog.coreUnseededPolyFns,
    }
}

def inlineTinyLeafFns(
    fns: StrMap FunDef,
    fnNames: List String,
    globals: List GlobalValDef,
    externs: StrMap ExternDef,
    nextBinderId: Cell Int
): List GlobalValDef
    requires cellGet(nextBinderId) >= 0
    ensures out -> listLen(out) == listLen(globals)
= {
    let pass = cellNew(0);
    let prevLeafCount = cellNew(-1);
    let curGlobals = cellNew(globals);
    while (cellGet(pass) < 3) {
        let leaves: StrMap FunDef = strMapNew();
        let leafCount = cellNew(0);
        let cf0 = cellNew(fnNames);
        while (match cellGet(cf0) { Nil -> false, _ -> true }) {
            match cellGet(cf0) {
                Cons(fnm, r) -> {
                    match strMapGet(fns, fnm) {
                        Some(fd) ->
                            if (isEligibleTinyLeafFn(fd, fns, externs)) {
                                strMapInsert(leaves, fnm, fd);
                                cellSet(leafCount, cellGet(leafCount) + 1)
                            } else (),
                        None -> (),
                    };
                    cellSet(cf0, r)
                },
                Nil -> (),
            }
        };
        let curCnt = cellGet(leafCount);
        let shouldRun = curCnt > 0 && (cellGet(pass) < 2 || curCnt > cellGet(prevLeafCount));
        cellSet(prevLeafCount, curCnt);
        if (shouldRun) {
            let cf1 = cellNew(fnNames);
            while (match cellGet(cf1) { Nil -> false, _ -> true }) {
                match cellGet(cf1) {
                    Cons(fnm, r) -> {
                        match strMapGet(fns, fnm) {
                            Some(fd) -> {
                                let newBody = rewriteTermInlineLeaves(fnm, fd.fnBody, leaves, nextBinderId);
                                strMapInsert(fns, fnm, MkFunDef {
                                    fnName: fd.fnName,
                                    fnSpan: fd.fnSpan,
                                    fnScm: fd.fnScm,
                                    fnParams: fd.fnParams,
                                    fnFvs: fd.fnFvs,
                                    fnBody: newBody,
                                })
                            },
                            None -> (),
                        };
                        cellSet(cf1, r)
                    },
                    Nil -> (),
                }
            };
            let newGlobsRev = cellNew(Nil);
            let cg = cellNew(cellGet(curGlobals));
            while (match cellGet(cg) { Nil -> false, _ -> true }) {
                match cellGet(cg) {
                    Cons(gv, r) -> {
                        let newInit = rewriteTermInlineLeaves("", gv.gvInit, leaves, nextBinderId);
                        cellSet(newGlobsRev, Cons(MkGlobalValDef {
                            gvName: gv.gvName,
                            gvSpan: gv.gvSpan,
                            gvTy: gv.gvTy,
                            gvInit: newInit,
                        }, cellGet(newGlobsRev)));
                        cellSet(cg, r)
                    },
                    Nil -> (),
                }
            };
            cellSet(curGlobals, listRev(cellGet(newGlobsRev)))
        } else ();
        cellSet(pass, cellGet(pass) + 1)
    };
    cellGet(curGlobals)
}

// ============================================================================
// Contract Lowering (`erase` | `check` | `keep`)
// ============================================================================

def mkUnitTerm(sp: Span): TaggedTerm =
    MkTerm { tspan: sp, tscm: ScmMono(TyVoid), tnode: TmLit(LitUnit) }

def formatContractLoc(sp: Span): String =
    match diagGetFile(sp.fileId) {
        Some(sf) -> {
            let (ln, col) = diagSpanLineCol(sp);
            sf.sfPath + ":" + intToStr(ln) + ":" + intToStr(col)
        },
        None -> "<unknown>",
    }

def mkContractFailCall(sp: Span, kind: String): TaggedTerm = {
    let msg = kind + " violated at " + formatContractLoc(sp);
    let failDecl = MkVarDecl {
        vname: "$gs$contract_fail",
        vscm: ScmMono(TyArr(TyVoid, [TyCon("String")], TyVoid)),
    };
    let msgTerm = MkTerm { tspan: sp, tscm: ScmMono(TyCon("String")), tnode: TmLit(LitStr(msg)) };
    MkTerm { tspan: sp, tscm: ScmMono(TyVoid), tnode: TmApplyDir(failDecl, [msgTerm]) }
}

def mkContractCheckTerm(sp: Span, kind: String, cond: TaggedTerm): TaggedTerm =
    MkTerm {
        tspan: sp,
        tscm: ScmMono(TyVoid),
        tnode: TmIf(cond, mkUnitTerm(sp), mkContractFailCall(sp, kind)),
    }

def mkDecreasesCheckTerm(sp: Span, expr: TaggedTerm): TaggedTerm = {
    let zero = MkTerm { tspan: sp, tscm: ScmMono(TyCon("Int")), tnode: TmLit(LitInt(0)) };
    let cond = MkTerm { tspan: sp, tscm: ScmMono(TyCon("Bool")), tnode: TmBin(OpGe, expr, zero) };
    mkContractCheckTerm(sp, "decreases", cond)
}

def lowerContractsInTerm(t: TaggedTerm, mode: String, fns: StrMap FunDef, externs: StrMap ExternDef): TaggedTerm =
    if (mode == "keep") t
    else {
        let sp = t.tspan;
        let scm = t.tscm;
        match t.tnode {
            TmApplyDir(vd, args) -> {
                let nm = vd.vname;
                if (nm == "__gs_requires" || nm == "__gs_ensures" || nm == "__gs_invariant" || (nm == "assert" && !isShadowedBuiltin(nm, fns, externs))) {
                    if (mode == "check") {
                        match args {
                            Cons(cond0, _) -> {
                                let cond = lowerContractsInTerm(cond0, mode, fns, externs);
                                let lbl =
                                    if (nm == "__gs_requires") "requires"
                                    else if (nm == "__gs_ensures") "ensures"
                                    else if (nm == "__gs_invariant") "invariant"
                                    else "assert";
                                mkContractCheckTerm(sp, lbl, cond)
                            },
                            Nil -> mkUnitTerm(sp),
                        }
                    } else mkUnitTerm(sp)
                } else if (nm == "__gs_decreases") {
                    if (mode == "check") {
                        match args {
                            Cons(d0, _) -> mkDecreasesCheckTerm(sp, lowerContractsInTerm(d0, mode, fns, externs)),
                            Nil -> mkUnitTerm(sp),
                        }
                    } else mkUnitTerm(sp)
                } else if (nm == "assume" && !isShadowedBuiltin(nm, fns, externs)) {
                    mkUnitTerm(sp)
                } else {
                    MkTerm { tspan: sp, tscm: scm, tnode: TmApplyDir(vd, lowerContractsInList(args, mode, fns, externs)) }
                }
            },
            TmTuple(es) -> MkTerm { tspan: sp, tscm: scm, tnode: TmTuple(lowerContractsInList(es, mode, fns, externs)) },
            TmBlock(es) -> MkTerm { tspan: sp, tscm: scm, tnode: TmBlock(lowerContractsInList(es, mode, fns, externs)) },
            TmMakeCls(vd, cs, b) -> MkTerm { tspan: sp, tscm: scm, tnode: TmMakeCls(vd, cs, lowerContractsInTerm(b, mode, fns, externs)) },
            TmApplyCls(c, args) -> MkTerm { tspan: sp, tscm: scm, tnode: TmApplyCls(lowerContractsInTerm(c, mode, fns, externs), lowerContractsInList(args, mode, fns, externs)) },
            TmBin(op, l, r) -> MkTerm { tspan: sp, tscm: scm, tnode: TmBin(op, lowerContractsInTerm(l, mode, fns, externs), lowerContractsInTerm(r, mode, fns, externs)) },
            TmUn(op, e) -> MkTerm { tspan: sp, tscm: scm, tnode: TmUn(op, lowerContractsInTerm(e, mode, fns, externs)) },
            TmLet(vd, v, b) -> MkTerm { tspan: sp, tscm: scm, tnode: TmLet(vd, lowerContractsInTerm(v, mode, fns, externs), lowerContractsInTerm(b, mode, fns, externs)) },
            TmIf(c, th, el) -> MkTerm { tspan: sp, tscm: scm, tnode: TmIf(lowerContractsInTerm(c, mode, fns, externs), lowerContractsInTerm(th, mode, fns, externs), lowerContractsInTerm(el, mode, fns, externs)) },
            TmWhile(c, b) -> {
                let lc = lowerContractsInTerm(c, mode, fns, externs);
                if (mode == "check") {
                    // Extract leading invariant checks to run both before the loop and at each iteration
                    let invChecksRev: Cell (List TaggedTerm) = cellNew(Nil);
                    let restStmts: Cell (List TaggedTerm) = cellNew(Nil);
                    match b.tnode {
                        TmBlock(stmts) -> {
                            let cur = cellNew(stmts);
                            let taking = cellNew(true);
                            while (cellGet(taking)) {
                                match cellGet(cur) {
                                    Cons(st, r) -> match st.tnode {
                                        TmApplyDir(vd, args) if (vd.vname == "__gs_invariant") -> {
                                            match args {
                                                Cons(ic, _) -> cellSet(invChecksRev, Cons(mkContractCheckTerm(st.tspan, "invariant", lowerContractsInTerm(ic, mode, fns, externs)), cellGet(invChecksRev))),
                                                Nil -> (),
                                            };
                                            cellSet(cur, r)
                                        },
                                        _ -> {
                                            cellSet(restStmts, Cons(st, r));
                                            cellSet(taking, false)
                                        },
                                    },
                                    Nil -> cellSet(taking, false),
                                }
                            }
                        },
                        _ -> cellSet(restStmts, [b]),
                    };
                    match cellGet(invChecksRev) {
                        Nil -> MkTerm { tspan: sp, tscm: scm, tnode: TmWhile(lc, lowerContractsInTerm(b, mode, fns, externs)) },
                        invsR -> {
                            let invs = listRev(invsR);
                            let loweredRest = lowerContractsInList(cellGet(restStmts), mode, fns, externs);
                            let loopBody = MkTerm { tspan: b.tspan, tscm: b.tscm, tnode: TmBlock(listAppend(loweredRest, invs)) };
                            let wTerm = MkTerm { tspan: sp, tscm: scm, tnode: TmWhile(lc, loopBody) };
                            MkTerm { tspan: sp, tscm: scm, tnode: TmBlock(listAppend(invs, [wTerm])) }
                        },
                    }
                } else {
                    MkTerm { tspan: sp, tscm: scm, tnode: TmWhile(lc, lowerContractsInTerm(b, mode, fns, externs)) }
                }
            },
            TmMatch(s, arms) -> {
                let rev = cellNew(Nil);
                let cur = cellNew(arms);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(a, r) -> {
                            let ng = match a.caGuard { Some(g) -> Some(lowerContractsInTerm(g, mode, fns, externs)), None -> None };
                            let nb = lowerContractsInTerm(a.caBody, mode, fns, externs);
                            cellSet(rev, Cons(MkCoreArm { caPat: a.caPat, caGuard: ng, caBody: nb }, cellGet(rev)));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                MkTerm { tspan: sp, tscm: scm, tnode: TmMatch(lowerContractsInTerm(s, mode, fns, externs), listRev(cellGet(rev))) }
            },
            TmMakeData(adt, tag, fs, ftys, targs) ->
                MkTerm { tspan: sp, tscm: scm, tnode: TmMakeData(adt, tag, lowerContractsInList(fs, mode, fns, externs), ftys, targs) },
            TmGetTag(e) -> MkTerm { tspan: sp, tscm: scm, tnode: TmGetTag(lowerContractsInTerm(e, mode, fns, externs)) },
            _ -> t,
        }
    }

def lowerContractsInList(ts: List TaggedTerm, mode: String, fns: StrMap FunDef, externs: StrMap ExternDef): List TaggedTerm = {
    let rev = cellNew(Nil);
    let cur = cellNew(ts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                cellSet(rev, Cons(lowerContractsInTerm(h, mode, fns, externs), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def lowerContractsInProgramFns(
    fns: StrMap FunDef,
    fnNames: List String,
    globals: List GlobalValDef,
    externs: StrMap ExternDef,
    mode: String
): (StrMap FunDef, List GlobalValDef) =
    if (mode == "keep") (fns, globals)
    else {
        let outFns: StrMap FunDef = strMapNew();
        let cf = cellNew(fnNames);
        while (match cellGet(cf) { Nil -> false, _ -> true }) {
            match cellGet(cf) {
                Cons(nm, r) -> {
                    match strMapGet(fns, nm) {
                        Some(fd) -> strMapInsert(outFns, nm, MkFunDef {
                            fnName: fd.fnName,
                            fnSpan: fd.fnSpan,
                            fnScm: fd.fnScm,
                            fnParams: fd.fnParams,
                            fnFvs: fd.fnFvs,
                            fnBody: lowerContractsInTerm(fd.fnBody, mode, fns, externs),
                        }),
                        None -> (),
                    };
                    cellSet(cf, r)
                },
                Nil -> (),
            }
        };
        let outGlobalsRev: Cell (List GlobalValDef) = cellNew(Nil);
        let cg = cellNew(globals);
        while (match cellGet(cg) { Nil -> false, _ -> true }) {
            match cellGet(cg) {
                Cons(g, r) -> {
                    cellSet(outGlobalsRev, Cons(MkGlobalValDef {
                        gvName: g.gvName,
                        gvSpan: g.gvSpan,
                        gvTy: g.gvTy,
                        gvInit: lowerContractsInTerm(g.gvInit, mode, fns, externs),
                    }, cellGet(outGlobalsRev)));
                    cellSet(cg, r)
                },
                Nil -> (),
            }
        };
        (outFns, listRev(cellGet(outGlobalsRev)))
    }

// ============================================================================
// General Higher-Order Simplifier, Case-of-Known-Constructor, Closure
// Devirtualization & Self-Recursive Call-Pattern Specialization
// ============================================================================

data CoKnownVal {
    CoValData(String, Int, List TaggedTerm, List Type, List Type),
    CoValTuple(List TaggedTerm),
    CoValLit(Lit),
}

data CoPatMatch {
    CoPatYes(List (VarDecl, TaggedTerm)),
    CoPatNo,
    CoPatUnknown,
}

data CoEnv {
    MkCoEnv {
        ceAliases: List (String, String),
        ceVarTys: List (String, Scheme),
        ceKnownVals: List (String, CoKnownVal),
        ceKnownCls: List (String, ClosureSpec),
    },
}

data CombOptCtx {
    MkCombOptCtx {
        coFns: StrMap FunDef,
        coCalleesCache: StrMap (List String),
        coNewNamesRev: Cell (List String),
        coExterns: StrMap ExternDef,
        coCtorMap: StrMap (String, VariantInfo),
        coSkipFns: StrMap Bool,
        coFlatClsMap: StrMap String,
        coSpecMap: StrMap String,
        coSpecCount: Cell Int,
        coFnInlines: Cell Int,
        coIdCnt: Cell Int,
    },
}

def coFreshId(cctx: CombOptCtx): Int
    requires cellGet(cctx.coIdCnt) >= 0 && cellGet(cctx.coIdCnt) < 2147483647
    ensures id -> id >= 0 && cellGet(cctx.coIdCnt) == id + 1
= {
    let id = cellGet(cctx.coIdCnt);
    cellSet(cctx.coIdCnt, coFreshNextId(id));
    id
}

def coFreshBinder(cctx: CombOptCtx, hint: String): String =
    allocFreshCoreBinder(cctx.coIdCnt, "co", hint)

def coComputeDirectCallees(tm: TaggedTerm): List String = {
    let out: Cell (List String) = cellNew(Nil);
    coCollectDirectCallees(tm, out);
    cellGet(out)
}

def coStoreFn(cctx: CombOptCtx, fd: FunDef): Void = {
    strMapInsert(cctx.coFns, fd.fnName, fd);
    strMapInsert(cctx.coCalleesCache, fd.fnName, coComputeDirectCallees(fd.fnBody))
}

def coRegisterFn(cctx: CombOptCtx, fd: FunDef): Void = {
    if (!strMapContains(cctx.coFns, fd.fnName)) {
        cellSet(cctx.coNewNamesRev, Cons(fd.fnName, cellGet(cctx.coNewNamesRev)))
    } else ();
    coStoreFn(cctx, fd)
}

def coTypeBlocksOpt(ty: Type): Bool = match ty {
    TyVar(_) -> true,
    TyVoid -> false,
    TyCon(n) -> n == "ScopedPtr" || n == "Arena" || n == "$Scoped" || n == "Task",
    TyArr(_, ps, r) -> coTypeListBlocksOpt(ps) || coTypeBlocksOpt(r),
    TyTuple(es) -> coTypeListBlocksOpt(es),
    TyComp(b, a) -> {
        let blockedHead = match b {
            TyCon(bn) -> bn == "ScopedPtr" || bn == "Arena" || bn == "Task",
            _ -> false,
        };
        blockedHead || coTypeBlocksOpt(b) || coTypeBlocksOpt(a)
    },
}

def coTypeListBlocksOpt(ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> coTypeBlocksOpt(h) || coTypeListBlocksOpt(t),
}

def coVarDeclListBlocksOpt(vds: List VarDecl): Bool = match vds {
    Nil -> false,
    Cons(vd, r) -> coTypeBlocksOpt(schemeBody(vd.vscm)) || coVarDeclListBlocksOpt(r),
}

def coLitsEqual(a: Lit, b: Lit): Bool = match (a, b) {
    (LitInt(x), LitInt(y)) -> x == y,
    (LitChar(x), LitChar(y)) -> x == y,
    (LitStr(x), LitStr(y)) -> x == y,
    (LitBool(x), LitBool(y)) -> x == y,
    (LitUnit, LitUnit) -> true,
    (LitFloat(_), LitFloat(_)) -> false,
    _ -> false,
}

def coIsSimpleTerm(tm: TaggedTerm): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(_) -> true,
    TmGlobalVar(_) -> true,
    _ -> false,
}

def coAllTermsSimple(es: List TaggedTerm): Bool = match es {
    Nil -> true,
    Cons(h, t) -> coIsSimpleTerm(h) && coAllTermsSimple(t),
}

def coTypesEqualModuloMode(a: Type, b: Type): Bool = match (a, b) {
    (TyVoid, TyVoid) -> true,
    (TyVar(x), TyVar(y)) -> x == y,
    (TyCon(x), TyCon(y)) -> x == y,
    (TyComp(b1, a1), TyComp(b2, a2)) -> coTypesEqualModuloMode(b1, b2) && coTypesEqualModuloMode(a1, a2),
    (TyTuple(es1), TyTuple(es2)) -> coTypeListsEqualModuloMode(es1, es2),
    (TyArr(_, ps1, r1), TyArr(_, ps2, r2)) -> coTypeListsEqualModuloMode(ps1, ps2) && coTypesEqualModuloMode(r1, r2),
    _ -> false,
}

def coTypeListsEqualModuloMode(xs: List Type, ys: List Type): Bool = match (xs, ys) {
    (Nil, Nil) -> true,
    (Cons(x, xr), Cons(y, yr)) -> coTypesEqualModuloMode(x, y) && coTypeListsEqualModuloMode(xr, yr),
    _ -> false,
}

def coInlineParamsMatchArgs(ps: List VarDecl, args: List TaggedTerm): Bool = match (ps, args) {
    (Nil, Nil) -> true,
    (Cons(p, pr), Cons(a, ar)) ->
        coTypesEqualModuloMode(schemeBody(p.vscm), schemeBody(a.tscm)) && coInlineParamsMatchArgs(pr, ar),
    _ -> false,
}

def coTermNeedsArgFloat(tm: TaggedTerm): Bool = match tm.tnode {
    TmLet(_, _, _) -> true,
    TmMakeCls(_, _, _) -> true,
    TmMakeData(_, _, fs, _, _) -> coAllTermsSimple(fs),
    TmTuple(es) -> coAllTermsSimple(es),
    _ -> false,
}

def coAnyTermNeedsArgFloat(es: List TaggedTerm): Bool = match es {
    Nil -> false,
    Cons(h, t) -> coTermNeedsArgFloat(h) || coAnyTermNeedsArgFloat(t),
}

def coTermIsPure(tm: TaggedTerm): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(_) -> true,
    TmGlobalVar(_) -> true,
    TmMakeCls(_, _, body) -> coTermIsPure(body),
    TmTuple(es) -> coTermListIsPure(es),
    TmMakeData(_, _, es, _, _) -> coTermListIsPure(es),
    _ -> false,
}

def coTermListIsPure(es: List TaggedTerm): Bool = match es {
    Nil -> true,
    Cons(h, t) -> coTermIsPure(h) && coTermListIsPure(t),
}

def coPatBindsVar(pat: Pattern, target: String): Bool = match pat {
    PatWild -> false,
    PatLit(_) -> false,
    PatVar(v, _) -> v == target,
    PatTuple(ps) -> coPatListBindsVar(ps, target),
    PatCtor(_, ps) -> coPatListBindsVar(ps, target),
    PatStruct(_, _) -> false,
}

def coPatListBindsVar(ps: List Pattern, target: String): Bool = match ps {
    Nil -> false,
    Cons(p, r) -> coPatBindsVar(p, target) || coPatListBindsVar(r, target),
}

def coTermMentionsVar(tm: TaggedTerm, target: String): Bool = match tm.tnode {
    TmLit(_) -> false,
    TmVar(v) -> v == target,
    TmGlobalVar(_) -> false,
    TmTuple(es) -> coTermListMentionsVar(es, target),
    TmBlock(es) -> coTermListMentionsVar(es, target),
    TmMakeCls(vd, cls, body) ->
        listContainsStr(cls.clsFvs, target)
        || (vd.vname != target && coTermMentionsVar(body, target)),
    TmApplyCls(c, args) -> coTermMentionsVar(c, target) || coTermListMentionsVar(args, target),
    TmApplyDir(_, args) -> coTermListMentionsVar(args, target),
    TmBin(_, l, r) -> coTermMentionsVar(l, target) || coTermMentionsVar(r, target),
    TmUn(_, e1) -> coTermMentionsVar(e1, target),
    TmLet(vd, e1, e2) ->
        coTermMentionsVar(e1, target)
        || (vd.vname != target && coTermMentionsVar(e2, target)),
    TmIf(c, t, e) -> coTermMentionsVar(c, target) || coTermMentionsVar(t, target) || coTermMentionsVar(e, target),
    TmWhile(c, b) -> coTermMentionsVar(c, target) || coTermMentionsVar(b, target),
    TmMatch(s, arms) -> coTermMentionsVar(s, target) || coArmListMentionsVar(arms, target),
    TmMakeData(_, _, args, _, _) -> coTermListMentionsVar(args, target),
    TmGetTag(e1) -> coTermMentionsVar(e1, target),
}

def coTermListMentionsVar(es: List TaggedTerm, target: String): Bool = match es {
    Nil -> false,
    Cons(h, t) -> coTermMentionsVar(h, target) || coTermListMentionsVar(t, target),
}

def coArmListMentionsVar(arms: List CoreArm, target: String): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let bound = coPatBindsVar(a.caPat, target);
        let inArm =
            if (bound) false
            else {
                let gHit = match a.caGuard { Some(g) -> coTermMentionsVar(g, target), None -> false };
                gHit || coTermMentionsVar(a.caBody, target)
            };
        inArm || coArmListMentionsVar(r, target)
    },
}

def coKnownValMentionsVar(kv: CoKnownVal, target: String): Bool = match kv {
    CoValLit(_) -> false,
    CoValTuple(es) -> coTermListMentionsVar(es, target),
    CoValData(_, _, es, _, _) -> coTermListMentionsVar(es, target),
}

def coFilterAliases(xs: List (String, String), v: String): List (String, String) = match xs {
    Nil -> Nil,
    Cons((k, tgt), r) ->
        if (k == v || tgt == v) coFilterAliases(r, v)
        else Cons((k, tgt), coFilterAliases(r, v)),
}

def coFilterKnownVals(xs: List (String, CoKnownVal), v: String): List (String, CoKnownVal) = match xs {
    Nil -> Nil,
    Cons((k, kv), r) ->
        if (k == v || coKnownValMentionsVar(kv, v)) coFilterKnownVals(r, v)
        else Cons((k, kv), coFilterKnownVals(r, v)),
}

def coFilterKnownCls(xs: List (String, ClosureSpec), v: String): List (String, ClosureSpec) = match xs {
    Nil -> Nil,
    Cons((k, cls), r) ->
        if (k == v || listContainsStr(cls.clsFvs, v)) coFilterKnownCls(r, v)
        else Cons((k, cls), coFilterKnownCls(r, v)),
}

def coBindVarInEnv(cenv: CoEnv, v: String, scm: Scheme): CoEnv = MkCoEnv {
    ceAliases: coFilterAliases(cenv.ceAliases, v),
    ceVarTys: Cons((v, scm), cenv.ceVarTys),
    ceKnownVals: coFilterKnownVals(cenv.ceKnownVals, v),
    ceKnownCls: coFilterKnownCls(cenv.ceKnownCls, v),
}

def lookupInlineEnvOpt(env: List (String, a), key: String): Option a = match env {
    Nil -> None,
    Cons((k, v), r) -> if (k == key) Some(v) else lookupInlineEnvOpt(r, key),
}

def coResolveAlias(aliases: List (String, String), name: String, hops: Int): String =
    if (hops > 24) name
    else match lookupInlineEnvOpt(aliases, name) {
        Some(nxt) -> if (nxt == name) name else coResolveAlias(aliases, nxt, hops + 1),
        None -> name,
    }

def coCombinatorTermCost(tm: TaggedTerm, externs: StrMap ExternDef): Int = {
    let ty = schemeBody(tm.tscm);
    if (!isTypeConcrete(ty) || coTypeBlocksOpt(ty)) -1
    else match tm.tnode {
        TmLit(_) -> 1,
        TmVar(_) -> 1,
        TmGlobalVar(_) -> 1,
        TmWhile(_, _) -> -1,
        TmMakeCls(vd, cls, body) ->
            if (listContainsStr(cls.clsFvs, vd.vname) || coTypeBlocksOpt(schemeBody(vd.vscm))) -1
            else {
                let cb = coCombinatorTermCost(body, externs);
                if (cb < 0) -1 else 2 + cb
            },
        TmApplyCls(c, args) -> {
            let cc = coCombinatorTermCost(c, externs);
            let ca = coCombinatorTermListCost(args, externs);
            if (cc < 0 || ca < 0) -1 else 2 + cc + ca
        },
        TmApplyDir(vd, args) ->
            if (
                vd.vname == "$gs$contract_fail"
                || (match intrinsicSendClosureArg(vd.vname) { Some(_) -> true, None -> false })
                || strMapContains(externs, vd.vname)
            ) -1
            else {
                let ca = coCombinatorTermListCost(args, externs);
                if (ca < 0) -1 else 2 + ca
            },
        TmTuple(es) -> {
            let c = coCombinatorTermListCost(es, externs);
            if (c < 0) -1 else 1 + c
        },
        TmBlock(es) -> {
            let c = coCombinatorTermListCost(es, externs);
            if (c < 0) -1 else 1 + c
        },
        TmBin(_, l, r) -> {
            let cl = coCombinatorTermCost(l, externs);
            let cr = coCombinatorTermCost(r, externs);
            if (cl < 0 || cr < 0) -1 else 1 + cl + cr
        },
        TmUn(_, e1) -> {
            let c1 = coCombinatorTermCost(e1, externs);
            if (c1 < 0) -1 else 1 + c1
        },
        TmLet(vd, e1, e2) ->
            if (coTypeBlocksOpt(schemeBody(vd.vscm))) -1
            else {
                let c1 = coCombinatorTermCost(e1, externs);
                let c2 = coCombinatorTermCost(e2, externs);
                if (c1 < 0 || c2 < 0) -1 else 1 + c1 + c2
            },
        TmIf(cnd, thn, els) -> {
            let cc = coCombinatorTermCost(cnd, externs);
            let ct = coCombinatorTermCost(thn, externs);
            let ce = coCombinatorTermCost(els, externs);
            if (cc < 0 || ct < 0 || ce < 0) -1 else 1 + cc + ct + ce
        },
        TmMatch(scrut, arms) ->
            if (listLen(arms) > 6) -1
            else {
                let cs = coCombinatorTermCost(scrut, externs);
                let ca = coCombinatorArmListCost(arms, externs);
                if (cs < 0 || ca < 0) -1 else 1 + cs + ca
            },
        TmMakeData(_, _, args, fTys, tArgs) ->
            if (coTypeListBlocksOpt(fTys) || coTypeListBlocksOpt(tArgs)) -1
            else {
                let c = coCombinatorTermListCost(args, externs);
                if (c < 0) -1 else 1 + c
            },
        TmGetTag(e1) -> {
            let c1 = coCombinatorTermCost(e1, externs);
            if (c1 < 0) -1 else 1 + c1
        },
    }
}

def coCombinatorTermListCost(es: List TaggedTerm, externs: StrMap ExternDef): Int = match es {
    Nil -> 0,
    Cons(h, t) -> {
        let ch = coCombinatorTermCost(h, externs);
        if (ch < 0) -1
        else {
            let ct = coCombinatorTermListCost(t, externs);
            if (ct < 0) -1 else ch + ct
        }
    },
}

def coCombinatorArmListCost(arms: List CoreArm, externs: StrMap ExternDef): Int = match arms {
    Nil -> 0,
    Cons(a, r) ->
        if (!leafPatOk(a.caPat)) -1
        else {
            let cg = match a.caGuard {
                Some(g) -> coCombinatorTermCost(g, externs),
                None -> 0,
            };
            let cb = coCombinatorTermCost(a.caBody, externs);
            if (cg < 0 || cb < 0) -1
            else {
                let cr = coCombinatorArmListCost(r, externs);
                if (cr < 0) -1 else 1 + cg + cb + cr
            }
        },
}

def coTermCallsFn(tm: TaggedTerm, targetFn: String): Bool = match tm.tnode {
    TmApplyDir(vd, args) -> vd.vname == targetFn || coTermListCallsFn(args, targetFn),
    TmApplyCls(c, args) -> coTermCallsFn(c, targetFn) || coTermListCallsFn(args, targetFn),
    TmMakeCls(_, cls, body) -> cls.clsEntry == targetFn || coTermCallsFn(body, targetFn),
    TmTuple(es) -> coTermListCallsFn(es, targetFn),
    TmBlock(es) -> coTermListCallsFn(es, targetFn),
    TmBin(_, l, r) -> coTermCallsFn(l, targetFn) || coTermCallsFn(r, targetFn),
    TmUn(_, e1) -> coTermCallsFn(e1, targetFn),
    TmLet(_, e1, e2) -> coTermCallsFn(e1, targetFn) || coTermCallsFn(e2, targetFn),
    TmIf(c, t, e) -> coTermCallsFn(c, targetFn) || coTermCallsFn(t, targetFn) || coTermCallsFn(e, targetFn),
    TmWhile(c, b) -> coTermCallsFn(c, targetFn) || coTermCallsFn(b, targetFn),
    TmMatch(s, arms) -> coTermCallsFn(s, targetFn) || coArmListCallsFn(arms, targetFn),
    TmMakeData(_, _, es, _, _) -> coTermListCallsFn(es, targetFn),
    TmGetTag(e1) -> coTermCallsFn(e1, targetFn),
    _ -> false,
}

def coTermListCallsFn(es: List TaggedTerm, targetFn: String): Bool = match es {
    Nil -> false,
    Cons(h, t) -> coTermCallsFn(h, targetFn) || coTermListCallsFn(t, targetFn),
}

def coArmListCallsFn(arms: List CoreArm, targetFn: String): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let gHit = match a.caGuard { Some(g) -> coTermCallsFn(g, targetFn), None -> false };
        gHit || coTermCallsFn(a.caBody, targetFn) || coArmListCallsFn(r, targetFn)
    },
}

def coCollectDirectCallees(tm: TaggedTerm, out: Cell (List String)): Void = match tm.tnode {
    TmApplyDir(vd, args) -> {
        cellSet(out, addUniqueStr(cellGet(out), vd.vname));
        coCollectDirectCalleesList(args, out)
    },
    TmMakeCls(_, cls, body) -> {
        cellSet(out, addUniqueStr(cellGet(out), cls.clsEntry));
        coCollectDirectCallees(body, out)
    },
    TmApplyCls(c, args) -> {
        coCollectDirectCallees(c, out);
        coCollectDirectCalleesList(args, out)
    },
    TmTuple(es) -> coCollectDirectCalleesList(es, out),
    TmBlock(es) -> coCollectDirectCalleesList(es, out),
    TmBin(_, l, r) -> { coCollectDirectCallees(l, out); coCollectDirectCallees(r, out) },
    TmUn(_, e1) -> coCollectDirectCallees(e1, out),
    TmLet(_, e1, e2) -> { coCollectDirectCallees(e1, out); coCollectDirectCallees(e2, out) },
    TmIf(c, t, e) -> { coCollectDirectCallees(c, out); coCollectDirectCallees(t, out); coCollectDirectCallees(e, out) },
    TmWhile(c, b) -> { coCollectDirectCallees(c, out); coCollectDirectCallees(b, out) },
    TmMatch(s, arms) -> {
        coCollectDirectCallees(s, out);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> coCollectDirectCallees(g, out), None -> () };
                    coCollectDirectCallees(a.caBody, out);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, es, _, _) -> coCollectDirectCalleesList(es, out),
    TmGetTag(e1) -> coCollectDirectCallees(e1, out),
    _ -> (),
}

def coCollectDirectCalleesList(es: List TaggedTerm, out: Cell (List String)): Void = match es {
    Nil -> (),
    Cons(h, t) -> { coCollectDirectCallees(h, out); coCollectDirectCalleesList(t, out) },
}

def coGetDirectCalleesCached(cctx: CombOptCtx, fnName: String): List String =
    match strMapGet(cctx.coCalleesCache, fnName) {
        Some(cs) -> cs,
        None -> match strMapGet(cctx.coFns, fnName) {
            None -> Nil,
            Some(fd) -> {
                let cs = coComputeDirectCallees(fd.fnBody);
                strMapInsert(cctx.coCalleesCache, fnName, cs);
                cs
            },
        },
    }

def coReachesTargetVisited(cctx: CombOptCtx, curFn: String, targetFn: String, visited: StrMap Bool): Bool =
    if (curFn == targetFn) true
    else if (strMapContains(visited, curFn)) false
    else {
        strMapInsert(visited, curFn, true);
        let cur = cellNew(coGetDirectCalleesCached(cctx, curFn));
        let hit = cellNew(false);
        while (!cellGet(hit) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(cn, r) -> {
                    if (coReachesTargetVisited(cctx, cn, targetFn, visited)) cellSet(hit, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(hit)
    }

def coReachesTargetFn(cctx: CombOptCtx, curFn: String, targetFn: String): Bool =
    if (curFn == targetFn) true
    else coCalleeReachesTargetFn(cctx, curFn, targetFn)

def coCalleeReachesTargetFn(cctx: CombOptCtx, startFn: String, targetFn: String): Bool = {
    let visited: StrMap Bool = strMapNew();
    let cur = cellNew(coGetDirectCalleesCached(cctx, startFn));
    let hit = cellNew(false);
    while (!cellGet(hit) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(cn, r) -> {
                if (coReachesTargetVisited(cctx, cn, targetFn, visited)) cellSet(hit, true) else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(hit)
}

def coIsEligibleGeneralInlineFn(cctx: CombOptCtx, fd: FunDef, cExportSet: StrMap Bool): Bool =
    if (
        fd.fnName == "main"
        || strStartsWith(fd.fnName, "__ctor_")
        || strMapContains(cExportSet, fd.fnName)
        || strMapContains(cctx.coSkipFns, fd.fnName)
    ) false
    else match fd.fnFvs {
        Cons(_, _) -> false,
        Nil -> {
            let fnTy = schemeBody(fd.fnScm);
            match fnTy {
                TyArr(_, _, retTy) ->
                    if (!isTypeConcrete(fnTy) || coTypeBlocksOpt(retTy) || coVarDeclListBlocksOpt(fd.fnParams)) false
                    else {
                        let cost = coCombinatorTermCost(fd.fnBody, cctx.coExterns);
                        if (!coInlineBudgetAllows(cost, 28, 0, 1, 0, 1)) false
                        else !coCalleeReachesTargetFn(cctx, fd.fnName, fd.fnName)
                    },
                _ -> false,
            }
        },
    }

def coAlphaClonePat(
    cctx: CombOptCtx,
    pat: Pattern,
    env: List (String, String)
): (Pattern, List (String, String)) = match pat {
    PatWild -> (PatWild, env),
    PatLit(l) -> (PatLit(l), env),
    PatVar(v, sp) -> {
        let fv = coFreshBinder(cctx, v);
        (PatVar(fv, sp), Cons((v, fv), env))
    },
    PatTuple(ps) -> {
        let (ps2, env2) = coAlphaClonePatList(cctx, ps, env);
        (PatTuple(ps2), env2)
    },
    PatCtor(cn, ps) -> {
        let (ps2, env2) = coAlphaClonePatList(cctx, ps, env);
        (PatCtor(cn, ps2), env2)
    },
    PatStruct(cn, fs) -> (PatStruct(cn, fs), env),
}

def coAlphaClonePatList(
    cctx: CombOptCtx,
    ps: List Pattern,
    env: List (String, String)
): (List Pattern, List (String, String)) = match ps {
    Nil -> (Nil, env),
    Cons(p, r) -> {
        let (p2, env1) = coAlphaClonePat(cctx, p, env);
        let (r2, env2) = coAlphaClonePatList(cctx, r, env1);
        (Cons(p2, r2), env2)
    },
}

def coCloneClosureEntryForEnv(
    cctx: CombOptCtx,
    origEntry: String,
    origCallFvs: List String,
    env: List (String, String),
    sp: Span
): Option (String, List String) =
    match strMapGet(cctx.coFns, origEntry) {
        None -> None,
        Some(origFd) ->
            if (listLen(origFd.fnFvs) != listLen(origCallFvs)) None
            else {
                let cid = coFreshId(cctx);
                let newEntry = origEntry + "$icls$" + intToStr(cid);
                let newFnFvsRev: Cell (List VarDecl) = cellNew(Nil);
                let newCallFvsRev: Cell (List String) = cellNew(Nil);
                let seenCallerFvs: Cell (List String) = cellNew(Nil);
                let clsEnv: Cell (List (String, String)) = cellNew(Nil);
                let cf1 = cellNew(origFd.fnFvs);
                let cf2 = cellNew(origCallFvs);
                while (match (cellGet(cf1), cellGet(cf2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                    match (cellGet(cf1), cellGet(cf2)) {
                        (Cons(fvd, rf1), Cons(callerFv, rf2)) -> {
                            let mappedFv = lookupInlineEnv(env, callerFv);
                            cellSet(clsEnv, Cons((fvd.vname, mappedFv), cellGet(clsEnv)));
                            if (!listContainsStr(cellGet(seenCallerFvs), mappedFv)) {
                                cellSet(seenCallerFvs, Cons(mappedFv, cellGet(seenCallerFvs)));
                                cellSet(newCallFvsRev, Cons(mappedFv, cellGet(newCallFvsRev)));
                                cellSet(newFnFvsRev, Cons(MkVarDecl { vname: mappedFv, vscm: fvd.vscm }, cellGet(newFnFvsRev)))
                            } else ();
                            cellSet(cf1, rf1);
                            cellSet(cf2, rf2)
                        },
                        _ -> (),
                    }
                };
                let newParamsRev: Cell (List VarDecl) = cellNew(Nil);
                let cp = cellNew(origFd.fnParams);
                while (match cellGet(cp) { Nil -> false, _ -> true }) {
                    match cellGet(cp) {
                        Cons(pvd, rp) -> {
                            let np = coFreshBinder(cctx, pvd.vname);
                            cellSet(clsEnv, Cons((pvd.vname, np), cellGet(clsEnv)));
                            cellSet(newParamsRev, Cons(MkVarDecl { vname: np, vscm: pvd.vscm }, cellGet(newParamsRev)));
                            cellSet(cp, rp)
                        },
                        Nil -> (),
                    }
                };
                let clonedBody = coCloneTerm(cctx, origFd.fnBody, cellGet(clsEnv), sp);
                let newFd = MkFunDef {
                    fnName: newEntry,
                    fnSpan: sp,
                    fnScm: origFd.fnScm,
                    fnParams: listRev(cellGet(newParamsRev)),
                    fnFvs: listRev(cellGet(newFnFvsRev)),
                    fnBody: clonedBody,
                };
                coRegisterFn(cctx, newFd);
                Some((newEntry, listRev(cellGet(newCallFvsRev))))
            },
    }

def coCloneTerm(
    cctx: CombOptCtx,
    tm: TaggedTerm,
    env: List (String, String),
    sp: Span
): TaggedTerm = {
    let nd = match tm.tnode {
        TmLit(l) -> TmLit(l),
        TmVar(v) -> TmVar(lookupInlineEnv(env, v)),
        TmGlobalVar(g) -> TmGlobalVar(g),
        TmTuple(es) -> TmTuple(coCloneTermList(cctx, es, env, sp)),
        TmBlock(es) -> TmBlock(coCloneTermList(cctx, es, env, sp)),
        TmMakeCls(vd, cls, body) -> {
            let fv = coFreshBinder(cctx, vd.vname);
            let vd2 = MkVarDecl { vname: fv, vscm: vd.vscm };
            let envBody = Cons((vd.vname, fv), env);
            match cls.clsFvs {
                Nil -> TmMakeCls(vd2, cls, coCloneTerm(cctx, body, envBody, sp)),
                _ -> match coCloneClosureEntryForEnv(cctx, cls.clsEntry, cls.clsFvs, envBody, sp) {
                    Some((newEntry, newFvs)) ->
                        TmMakeCls(
                            vd2,
                            MkClosureSpec { clsEntry: newEntry, clsFvs: newFvs },
                            coCloneTerm(cctx, body, envBody, sp)
                        ),
                    None -> TmMakeCls(vd, cls, coCloneTerm(cctx, body, env, sp)),
                },
            }
        },
        TmApplyCls(c, args) ->
            TmApplyCls(coCloneTerm(cctx, c, env, sp), coCloneTermList(cctx, args, env, sp)),
        TmApplyDir(vd, args) ->
            TmApplyDir(vd, coCloneTermList(cctx, args, env, sp)),
        TmBin(op, l, r) ->
            TmBin(op, coCloneTerm(cctx, l, env, sp), coCloneTerm(cctx, r, env, sp)),
        TmUn(op, e1) ->
            TmUn(op, coCloneTerm(cctx, e1, env, sp)),
        TmLet(vd, e1, e2) -> {
            let e1c = coCloneTerm(cctx, e1, env, sp);
            let fv = coFreshBinder(cctx, vd.vname);
            let vd2 = MkVarDecl { vname: fv, vscm: vd.vscm };
            let e2c = coCloneTerm(cctx, e2, Cons((vd.vname, fv), env), sp);
            TmLet(vd2, e1c, e2c)
        },
        TmIf(c, t, e) ->
            TmIf(
                coCloneTerm(cctx, c, env, sp),
                coCloneTerm(cctx, t, env, sp),
                coCloneTerm(cctx, e, env, sp)
            ),
        TmWhile(c, b) ->
            TmWhile(coCloneTerm(cctx, c, env, sp), coCloneTerm(cctx, b, env, sp)),
        TmMatch(s, arms) ->
            TmMatch(coCloneTerm(cctx, s, env, sp), coCloneArmList(cctx, arms, env, sp)),
        TmMakeData(cn, tag, args, fTys, tArgs) ->
            TmMakeData(cn, tag, coCloneTermList(cctx, args, env, sp), fTys, tArgs),
        TmGetTag(e1) ->
            TmGetTag(coCloneTerm(cctx, e1, env, sp)),
    };
    MkTerm { tspan: sp, tscm: tm.tscm, tnode: nd }
}

def coCloneTermList(
    cctx: CombOptCtx,
    es: List TaggedTerm,
    env: List (String, String),
    sp: Span
): List TaggedTerm
    ensures out -> listLen(out) == listLen(es)
= match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(coCloneTerm(cctx, h, env, sp), coCloneTermList(cctx, t, env, sp)),
}

def coCloneArmList(
    cctx: CombOptCtx,
    arms: List CoreArm,
    env: List (String, String),
    sp: Span
): List CoreArm
    ensures out -> listLen(out) == listLen(arms)
= match arms {
    Nil -> Nil,
    Cons(a, r) -> {
        let (pat2, envArm) = coAlphaClonePat(cctx, a.caPat, env);
        let g2 = match a.caGuard {
            Some(g) -> Some(coCloneTerm(cctx, g, envArm, sp)),
            None -> None,
        };
        let b2 = coCloneTerm(cctx, a.caBody, envArm, sp);
        Cons(MkCoreArm { caPat: pat2, caGuard: g2, caBody: b2 }, coCloneArmList(cctx, r, env, sp))
    },
}

def coBuildCallArgsInline(
    cctx: CombOptCtx,
    ps: List VarDecl,
    args: List TaggedTerm,
    baseEnv: List (String, String),
    sp: Span,
    resScm: Scheme,
    bodyToClone: TaggedTerm
): TaggedTerm = {
    let envCell: Cell (List (String, String)) = cellNew(baseEnv);
    let letsRev: Cell (List (VarDecl, TaggedTerm)) = cellNew(Nil);
    let cp = cellNew(ps);
    let ca = cellNew(args);
    while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
        match (cellGet(cp), cellGet(ca)) {
            (Cons(p, rp), Cons(a, ra)) -> {
                match a.tnode {
                    TmVar(v) -> cellSet(envCell, Cons((p.vname, v), cellGet(envCell))),
                    _ -> {
                        let fv = coFreshBinder(cctx, p.vname);
                        cellSet(envCell, Cons((p.vname, fv), cellGet(envCell)));
                        cellSet(letsRev, Cons((MkVarDecl { vname: fv, vscm: ScmMono(schemeBody(a.tscm)) }, a), cellGet(letsRev)))
                    },
                };
                cellSet(cp, rp);
                cellSet(ca, ra)
            },
            _ -> (),
        }
    };
    let cloned = coCloneTerm(cctx, bodyToClone, cellGet(envCell), sp);
    let cur = cellNew(cellGet(letsRev));
    let out = cellNew(cloned);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((vd, rhs), r) -> {
                cellSet(out, MkTerm { tspan: sp, tscm: resScm, tnode: TmLet(vd, rhs, cellGet(out)) });
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    cellGet(out)
}

def coMapVarDeclTypes(vds: List VarDecl): List Type = match vds {
    Nil -> Nil,
    Cons(vd, r) -> Cons(schemeBody(vd.vscm), coMapVarDeclTypes(r)),
}

def coGetOrCreateFlatClsFn(
    cctx: CombOptCtx,
    clsFd: FunDef,
    cExportSet: StrMap Bool
): String
    ensures fnName -> strLen(fnName) >= 6
=
    match strMapGet(cctx.coFlatClsMap, clsFd.fnName) {
        Some(existing) -> {
            assert(strMapContains(cctx.coFns, existing));
            existing
        },
        None -> {
            let fid = coFreshId(cctx);
            let flatName = clsFd.fnName + "$flat$" + intToStr(fid);
            strMapInsert(cctx.coFlatClsMap, clsFd.fnName, flatName);
            let envRev: Cell (List (String, String)) = cellNew(Nil);
            let allParamsRev: Cell (List VarDecl) = cellNew(Nil);
            let cf = cellNew(clsFd.fnFvs);
            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                match cellGet(cf) {
                    Cons(fvd, rf) -> {
                        let nf = coFreshBinder(cctx, fvd.vname);
                        cellSet(envRev, Cons((fvd.vname, nf), cellGet(envRev)));
                        cellSet(allParamsRev, Cons(MkVarDecl { vname: nf, vscm: fvd.vscm }, cellGet(allParamsRev)));
                        cellSet(cf, rf)
                    },
                    Nil -> (),
                }
            };
            let cp = cellNew(clsFd.fnParams);
            while (match cellGet(cp) { Nil -> false, _ -> true }) {
                match cellGet(cp) {
                    Cons(pvd, rp) -> {
                        let np = coFreshBinder(cctx, pvd.vname);
                        cellSet(envRev, Cons((pvd.vname, np), cellGet(envRev)));
                        cellSet(allParamsRev, Cons(MkVarDecl { vname: np, vscm: pvd.vscm }, cellGet(allParamsRev)));
                        cellSet(cp, rp)
                    },
                    Nil -> (),
                }
            };
            let allParams = listRev(cellGet(allParamsRev));
            let fvCnt = listLen(clsFd.fnFvs);
            let pCnt = listLen(clsFd.fnParams);
            if (fvCnt <= 1048576 && pCnt <= 1048576) {
                assert(listLen(allParams) == coFlatTotalArity(fvCnt, pCnt))
            } else ();
            let retTy = schemeBody(clsFd.fnBody.tscm);
            let flatScm = ScmMono(TyArr(TyVoid, coMapVarDeclTypes(allParams), retTy));
            let clonedBody = coCloneTerm(cctx, clsFd.fnBody, cellGet(envRev), clsFd.fnSpan);
            let initEnv = coInitialEnvForFn(allParams, Nil);
            let savedInl = cellGet(cctx.coFnInlines);
            cellSet(cctx.coFnInlines, 0);
            let optBody = coOptTerm(cctx, flatName, clonedBody, initEnv, cExportSet, 1);
            cellSet(cctx.coFnInlines, savedInl);
            let flatFd = MkFunDef {
                fnName: flatName,
                fnSpan: clsFd.fnSpan,
                fnScm: flatScm,
                fnParams: allParams,
                fnFvs: Nil,
                fnBody: optBody,
            };
            coRegisterFn(cctx, flatFd);
            flatName
        },
    }

def coResolveTermKnownVal(tm: TaggedTerm, cenv: CoEnv): Option CoKnownVal = match tm.tnode {
    TmLit(l) -> Some(CoValLit(l)),
    TmTuple(es) -> if (coAllTermsSimple(es)) Some(CoValTuple(es)) else None,
    TmMakeData(adt, tag, fs, ftys, targs) ->
        if (coAllTermsSimple(fs)) Some(CoValData(adt, tag, fs, ftys, targs)) else None,
    TmVar(v) -> {
        let rv = coResolveAlias(cenv.ceAliases, v, 0);
        lookupInlineEnvOpt(cenv.ceKnownVals, rv)
    },
    _ -> None,
}

def coMatchPatKnown(
    cctx: CombOptCtx,
    pat: Pattern,
    tm: TaggedTerm,
    cenv: CoEnv
): CoPatMatch = match pat {
    PatWild ->
        if (coIsSimpleTerm(tm)) CoPatYes(Nil)
        else match tm.tnode {
            TmTuple(es) -> if (coAllTermsSimple(es)) CoPatYes(Nil) else CoPatUnknown,
            TmMakeData(_, _, fs, _, _) -> if (coAllTermsSimple(fs)) CoPatYes(Nil) else CoPatUnknown,
            _ -> CoPatUnknown,
        },
    PatVar(v, _) ->
        if (coIsSimpleTerm(tm)) {
            CoPatYes([(MkVarDecl { vname: v, vscm: ScmMono(schemeBody(tm.tscm)) }, tm)])
        } else match tm.tnode {
            TmTuple(es) if (coAllTermsSimple(es)) ->
                CoPatYes([(MkVarDecl { vname: v, vscm: ScmMono(schemeBody(tm.tscm)) }, tm)]),
            TmMakeData(_, _, fs, _, _) if (coAllTermsSimple(fs)) ->
                CoPatYes([(MkVarDecl { vname: v, vscm: ScmMono(schemeBody(tm.tscm)) }, tm)]),
            _ -> CoPatUnknown,
        },
    PatLit(pLit) -> match pLit {
        LitFloat(_) -> CoPatUnknown,
        _ -> match coResolveTermKnownVal(tm, cenv) {
            Some(CoValLit(LitFloat(_))) -> CoPatUnknown,
            Some(CoValLit(tLit)) -> if (coLitsEqual(pLit, tLit)) CoPatYes(Nil) else CoPatNo,
            _ -> CoPatUnknown,
        },
    },
    PatTuple(subPats) -> match coResolveTermKnownVal(tm, cenv) {
        Some(CoValTuple(elems)) ->
            if (listLen(subPats) != listLen(elems)) CoPatUnknown
            else coMatchPatListKnown(cctx, subPats, elems, cenv),
        _ -> CoPatUnknown,
    },
    PatCtor(cname, subPats) -> match strMapGet(cctx.coCtorMap, cname) {
        None -> CoPatUnknown,
        Some((patAdt, vinfo)) -> match coResolveTermKnownVal(tm, cenv) {
            Some(CoValData(dataAdt, dataTag, fields, _, _)) ->
                if (patAdt != dataAdt) CoPatUnknown
                else if (vinfo.tag != dataTag) CoPatNo
                else if (listLen(subPats) != listLen(fields)) CoPatUnknown
                else coMatchPatListKnown(cctx, subPats, fields, cenv),
            _ -> CoPatUnknown,
        },
    },
    PatStruct(_, _) -> CoPatUnknown,
}

def coPatMatchStatus(m: CoPatMatch): Int = match m {
    CoPatYes(_) -> 0,
    CoPatNo -> 1,
    CoPatUnknown -> 2,
}

def coMatchPatListKnown(
    cctx: CombOptCtx,
    ps: List Pattern,
    es: List TaggedTerm,
    cenv: CoEnv
): CoPatMatch = match (ps, es) {
    (Nil, Nil) -> CoPatYes(Nil),
    (Cons(p, rp), Cons(e, re)) -> {
        let m1 = coMatchPatKnown(cctx, p, e, cenv);
        match m1 {
            CoPatNo -> CoPatNo,
            _ -> {
                let m2 = coMatchPatListKnown(cctx, rp, re, cenv);
                let st = coPatSeqStatus(coPatMatchStatus(m1), coPatMatchStatus(m2));
                if (st == 1) CoPatNo
                else if (st == 0) match (m1, m2) {
                    (CoPatYes(b1), CoPatYes(b2)) -> CoPatYes(listAppend(b1, b2)),
                    _ -> CoPatUnknown,
                }
                else CoPatUnknown
            },
        }
    },
    _ -> CoPatUnknown,
}

def coWrapLetBindings(
    binds: List (VarDecl, TaggedTerm),
    body: TaggedTerm,
    sp: Span,
    resScm: Scheme
): TaggedTerm = match binds {
    Nil -> body,
    Cons((vd, rhs), r) -> MkTerm {
        tspan: sp,
        tscm: resScm,
        tnode: TmLet(vd, rhs, coWrapLetBindings(r, body, sp, resScm)),
    },
}

def coTryReduceMatch(
    cctx: CombOptCtx,
    scrut: TaggedTerm,
    arms: List CoreArm,
    cenv: CoEnv,
    sp: Span,
    resScm: Scheme
): Option TaggedTerm = match arms {
    Nil -> None,
    Cons(a, rest) -> match coMatchPatKnown(cctx, a.caPat, scrut, cenv) {
        CoPatNo -> coTryReduceMatch(cctx, scrut, rest, cenv, sp, resScm),
        CoPatUnknown -> None,
        CoPatYes(binds) -> match a.caGuard {
            None -> {
                let envRev: Cell (List (String, String)) = cellNew(Nil);
                let renamedBindsRev: Cell (List (VarDecl, TaggedTerm)) = cellNew(Nil);
                let cb = cellNew(binds);
                while (match cellGet(cb) { Nil -> false, _ -> true }) {
                    match cellGet(cb) {
                        Cons((vd, rhs), rb) -> {
                            let fv = coFreshBinder(cctx, vd.vname);
                            cellSet(envRev, Cons((vd.vname, fv), cellGet(envRev)));
                            cellSet(renamedBindsRev, Cons((MkVarDecl { vname: fv, vscm: vd.vscm }, rhs), cellGet(renamedBindsRev)));
                            cellSet(cb, rb)
                        },
                        Nil -> (),
                    }
                };
                let clonedBody = coCloneTerm(cctx, a.caBody, cellGet(envRev), sp);
                Some(coWrapLetBindings(listRev(cellGet(renamedBindsRev)), clonedBody, sp, resScm))
            },
            Some(_) -> None,
        },
    },
}

def coAnfLiftTermList(
    cctx: CombOptCtx,
    es: List TaggedTerm,
    sp: Span,
    outerScm: Scheme,
    buildInner: List TaggedTerm -> Term
): TaggedTerm =
    if (coAllTermsSimple(es)) {
        MkTerm { tspan: sp, tscm: outerScm, tnode: buildInner(es) }
    } else {
        let letsRev: Cell (List (VarDecl, TaggedTerm)) = cellNew(Nil);
        let simpleRev: Cell (List TaggedTerm) = cellNew(Nil);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    if (coIsSimpleTerm(e)) {
                        cellSet(simpleRev, Cons(e, cellGet(simpleRev)))
                    } else {
                        let nm = coFreshBinder(cctx, "anf");
                        let sc = ScmMono(schemeBody(e.tscm));
                        let vd = MkVarDecl { vname: nm, vscm: sc };
                        cellSet(letsRev, Cons((vd, e), cellGet(letsRev)));
                        cellSet(simpleRev, Cons(MkTerm { tspan: e.tspan, tscm: sc, tnode: TmVar(nm) }, cellGet(simpleRev)))
                    };
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let coreTm = MkTerm { tspan: sp, tscm: outerScm, tnode: buildInner(listRev(cellGet(simpleRev))) };
        coWrapLetBindings(listRev(cellGet(letsRev)), coreTm, sp, outerScm)
    }

def coLastFloatArgIndex(es: List TaggedTerm, idx: Int, lastHit: Int): Int = match es {
    Nil -> lastHit,
    Cons(h, t) -> {
        let nextHit = if (coTermNeedsArgFloat(h)) idx else lastHit;
        coLastFloatArgIndex(t, idx + 1, nextHit)
    },
}

def coFloatSelectedArgs(
    cctx: CombOptCtx,
    es: List TaggedTerm,
    sp: Span,
    outerScm: Scheme,
    buildInner: List TaggedTerm -> Term
): TaggedTerm = {
    let lastIdx = coLastFloatArgIndex(es, 0, -1);
    if (lastIdx < 0) {
        MkTerm { tspan: sp, tscm: outerScm, tnode: buildInner(es) }
    } else {
        let letsRev: Cell (List (VarDecl, TaggedTerm)) = cellNew(Nil);
        let outArgsRev: Cell (List TaggedTerm) = cellNew(Nil);
        let iCell = cellNew(0);
        let cur = cellNew(es);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(e, r) -> {
                    let idx = cellGet(iCell);
                    if (!coAnfInFloatPrefix(idx, lastIdx) || coIsSimpleTerm(e)) {
                        cellSet(outArgsRev, Cons(e, cellGet(outArgsRev)))
                    } else {
                        let nm = coFreshBinder(cctx, "arg");
                        let sc = ScmMono(schemeBody(e.tscm));
                        let vd = MkVarDecl { vname: nm, vscm: sc };
                        cellSet(letsRev, Cons((vd, e), cellGet(letsRev)));
                        cellSet(outArgsRev, Cons(MkTerm { tspan: e.tspan, tscm: sc, tnode: TmVar(nm) }, cellGet(outArgsRev)))
                    };
                    cellSet(iCell, idx + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let coreTm = MkTerm { tspan: sp, tscm: outerScm, tnode: buildInner(listRev(cellGet(outArgsRev))) };
        coWrapLetBindings(listRev(cellGet(letsRev)), coreTm, sp, outerScm)
    }
}

// ---- Self-Recursive Higher-Order Call-Pattern Specialization (`SpecConstr`) ----

def coParamInvariantAndOnlyCalledInTerm(
    tm: TaggedTerm,
    selfFnName: String,
    paramName: String,
    paramIdx: Int
): Bool = match tm.tnode {
    TmLit(_) -> true,
    TmVar(v) -> v != paramName,
    TmGlobalVar(_) -> true,
    TmTuple(es) -> coParamInvariantInList(es, selfFnName, paramName, paramIdx),
    TmBlock(es) -> coParamInvariantInList(es, selfFnName, paramName, paramIdx),
    TmMakeCls(vd, cls, body) ->
        !listContainsStr(cls.clsFvs, paramName)
        && (if (vd.vname == paramName) !coTermCallsFn(body, selfFnName) else coParamInvariantAndOnlyCalledInTerm(body, selfFnName, paramName, paramIdx)),
    TmApplyCls(callee, args) -> {
        let calleeOk = match callee.tnode {
            TmVar(v) if (v == paramName) -> true,
            _ -> coParamInvariantAndOnlyCalledInTerm(callee, selfFnName, paramName, paramIdx),
        };
        calleeOk && coParamInvariantInList(args, selfFnName, paramName, paramIdx)
    },
    TmApplyDir(vd, args) ->
        if (vd.vname == selfFnName) {
            let argAtIdxOk = match listNthTerm(args, paramIdx) {
                Some(ith) -> match ith.tnode {
                    TmVar(v) -> v == paramName,
                    _ -> false,
                },
                None -> false,
            };
            argAtIdxOk && coSelfCallOtherArgsOk(args, 0, paramIdx, selfFnName, paramName)
        } else coParamInvariantInList(args, selfFnName, paramName, paramIdx),
    TmBin(_, l, r) ->
        coParamInvariantAndOnlyCalledInTerm(l, selfFnName, paramName, paramIdx)
        && coParamInvariantAndOnlyCalledInTerm(r, selfFnName, paramName, paramIdx),
    TmUn(_, e1) -> coParamInvariantAndOnlyCalledInTerm(e1, selfFnName, paramName, paramIdx),
    TmLet(vd, e1, e2) ->
        coParamInvariantAndOnlyCalledInTerm(e1, selfFnName, paramName, paramIdx)
        && (if (vd.vname == paramName) !coTermCallsFn(e2, selfFnName) else coParamInvariantAndOnlyCalledInTerm(e2, selfFnName, paramName, paramIdx)),
    TmIf(c, t, e) ->
        coParamInvariantAndOnlyCalledInTerm(c, selfFnName, paramName, paramIdx)
        && coParamInvariantAndOnlyCalledInTerm(t, selfFnName, paramName, paramIdx)
        && coParamInvariantAndOnlyCalledInTerm(e, selfFnName, paramName, paramIdx),
    TmWhile(c, b) ->
        coParamInvariantAndOnlyCalledInTerm(c, selfFnName, paramName, paramIdx)
        && coParamInvariantAndOnlyCalledInTerm(b, selfFnName, paramName, paramIdx),
    TmMatch(s, arms) ->
        coParamInvariantAndOnlyCalledInTerm(s, selfFnName, paramName, paramIdx)
        && coParamInvariantInArms(arms, selfFnName, paramName, paramIdx),
    TmMakeData(_, _, es, _, _) -> coParamInvariantInList(es, selfFnName, paramName, paramIdx),
    TmGetTag(e1) -> coParamInvariantAndOnlyCalledInTerm(e1, selfFnName, paramName, paramIdx),
}

def coSelfCallOtherArgsOk(
    args: List TaggedTerm,
    curIdx: Int,
    skipIdx: Int,
    selfFnName: String,
    paramName: String
): Bool = match args {
    Nil -> true,
    Cons(h, t) -> {
        let hOk =
            if (curIdx == skipIdx) true
            else coParamInvariantAndOnlyCalledInTerm(h, selfFnName, paramName, skipIdx);
        hOk && coSelfCallOtherArgsOk(t, curIdx + 1, skipIdx, selfFnName, paramName)
    },
}

def coParamInvariantInList(
    es: List TaggedTerm,
    selfFnName: String,
    paramName: String,
    paramIdx: Int
): Bool = match es {
    Nil -> true,
    Cons(h, t) ->
        coParamInvariantAndOnlyCalledInTerm(h, selfFnName, paramName, paramIdx)
        && coParamInvariantInList(t, selfFnName, paramName, paramIdx),
}

def coParamInvariantInArms(
    arms: List CoreArm,
    selfFnName: String,
    paramName: String,
    paramIdx: Int
): Bool = match arms {
    Nil -> true,
    Cons(a, r) -> {
        let aOk =
            if (coPatBindsVar(a.caPat, paramName)) {
                let gCalls = match a.caGuard { Some(g) -> coTermCallsFn(g, selfFnName), None -> false };
                !gCalls && !coTermCallsFn(a.caBody, selfFnName)
            } else {
                let gOk = match a.caGuard {
                    Some(g) -> coParamInvariantAndOnlyCalledInTerm(g, selfFnName, paramName, paramIdx),
                    None -> true,
                };
                gOk && coParamInvariantAndOnlyCalledInTerm(a.caBody, selfFnName, paramName, paramIdx)
            };
        aOk && coParamInvariantInArms(r, selfFnName, paramName, paramIdx)
    },
}

def coResolveKnownArgClosure(
    argTm: TaggedTerm,
    cenv: CoEnv,
    cctx: CombOptCtx
): Option (ClosureSpec, FunDef) = match argTm.tnode {
    TmVar(v) -> {
        let rv = coResolveAlias(cenv.ceAliases, v, 0);
        match lookupInlineEnvOpt(cenv.ceKnownCls, rv) {
            Some(cls) ->
                if (listContainsStr(cls.clsFvs, rv)) None
                else match strMapGet(cctx.coFns, cls.clsEntry) {
                    Some(clsFd) ->
                        if (
                            listLen(clsFd.fnFvs) == listLen(cls.clsFvs)
                            && !coVarDeclListBlocksOpt(clsFd.fnFvs)
                            && !coVarDeclListBlocksOpt(clsFd.fnParams)
                        ) Some((cls, clsFd))
                        else None,
                    None -> None,
                },
            None -> None,
        }
    },
    _ -> None,
}

def coRewriteSelfCallsInSpecBody(
    tm: TaggedTerm,
    origFnName: String,
    specFnName: String,
    specScm: Scheme,
    paramExpansions: List (Option (List TaggedTerm))
): TaggedTerm = {
    let sp = tm.tspan;
    let sc = tm.tscm;
    let nd = match tm.tnode {
        TmLit(l) -> TmLit(l),
        TmVar(v) -> TmVar(v),
        TmGlobalVar(g) -> TmGlobalVar(g),
        TmTuple(es) -> TmTuple(coRewriteSelfCallsInList(es, origFnName, specFnName, specScm, paramExpansions)),
        TmBlock(es) -> TmBlock(coRewriteSelfCallsInList(es, origFnName, specFnName, specScm, paramExpansions)),
        TmMakeCls(vd, cls, b) ->
            TmMakeCls(vd, cls, coRewriteSelfCallsInSpecBody(b, origFnName, specFnName, specScm, paramExpansions)),
        TmApplyCls(c, args) ->
            TmApplyCls(
                coRewriteSelfCallsInSpecBody(c, origFnName, specFnName, specScm, paramExpansions),
                coRewriteSelfCallsInList(args, origFnName, specFnName, specScm, paramExpansions)
            ),
        TmApplyDir(vd, args) -> {
            let args2 = coRewriteSelfCallsInList(args, origFnName, specFnName, specScm, paramExpansions);
            if (vd.vname == origFnName && listLen(args2) == listLen(paramExpansions)) {
                let newArgsRev: Cell (List TaggedTerm) = cellNew(Nil);
                let ca = cellNew(args2);
                let ce = cellNew(paramExpansions);
                while (match (cellGet(ca), cellGet(ce)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                    match (cellGet(ca), cellGet(ce)) {
                        (Cons(a, ra), Cons(expOpt, re)) -> {
                            match expOpt {
                                None -> cellSet(newArgsRev, Cons(a, cellGet(newArgsRev))),
                                Some(fvTerms) -> {
                                    let cf = cellNew(fvTerms);
                                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                        match cellGet(cf) {
                                            Cons(ft, rf) -> {
                                                cellSet(newArgsRev, Cons(ft, cellGet(newArgsRev)));
                                                cellSet(cf, rf)
                                            },
                                            Nil -> (),
                                        }
                                    }
                                },
                            };
                            cellSet(ca, ra);
                            cellSet(ce, re)
                        },
                        _ -> (),
                    }
                };
                TmApplyDir(MkVarDecl { vname: specFnName, vscm: specScm }, listRev(cellGet(newArgsRev)))
            } else TmApplyDir(vd, args2)
        },
        TmBin(op, l, r) ->
            TmBin(
                op,
                coRewriteSelfCallsInSpecBody(l, origFnName, specFnName, specScm, paramExpansions),
                coRewriteSelfCallsInSpecBody(r, origFnName, specFnName, specScm, paramExpansions)
            ),
        TmUn(op, e1) ->
            TmUn(op, coRewriteSelfCallsInSpecBody(e1, origFnName, specFnName, specScm, paramExpansions)),
        TmLet(vd, e1, e2) ->
            TmLet(
                vd,
                coRewriteSelfCallsInSpecBody(e1, origFnName, specFnName, specScm, paramExpansions),
                coRewriteSelfCallsInSpecBody(e2, origFnName, specFnName, specScm, paramExpansions)
            ),
        TmIf(c, t, e) ->
            TmIf(
                coRewriteSelfCallsInSpecBody(c, origFnName, specFnName, specScm, paramExpansions),
                coRewriteSelfCallsInSpecBody(t, origFnName, specFnName, specScm, paramExpansions),
                coRewriteSelfCallsInSpecBody(e, origFnName, specFnName, specScm, paramExpansions)
            ),
        TmWhile(c, b) ->
            TmWhile(
                coRewriteSelfCallsInSpecBody(c, origFnName, specFnName, specScm, paramExpansions),
                coRewriteSelfCallsInSpecBody(b, origFnName, specFnName, specScm, paramExpansions)
            ),
        TmMatch(s, arms) -> {
            let rev: Cell (List CoreArm) = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let g2 = match a.caGuard {
                            Some(g) -> Some(coRewriteSelfCallsInSpecBody(g, origFnName, specFnName, specScm, paramExpansions)),
                            None -> None,
                        };
                        let b2 = coRewriteSelfCallsInSpecBody(a.caBody, origFnName, specFnName, specScm, paramExpansions);
                        cellSet(rev, Cons(MkCoreArm { caPat: a.caPat, caGuard: g2, caBody: b2 }, cellGet(rev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            TmMatch(
                coRewriteSelfCallsInSpecBody(s, origFnName, specFnName, specScm, paramExpansions),
                listRev(cellGet(rev))
            )
        },
        TmMakeData(cn, tag, es, ftys, targs) ->
            TmMakeData(cn, tag, coRewriteSelfCallsInList(es, origFnName, specFnName, specScm, paramExpansions), ftys, targs),
        TmGetTag(e1) ->
            TmGetTag(coRewriteSelfCallsInSpecBody(e1, origFnName, specFnName, specScm, paramExpansions)),
    };
    MkTerm { tspan: sp, tscm: sc, tnode: nd }
}

def coRewriteSelfCallsInList(
    es: List TaggedTerm,
    origFnName: String,
    specFnName: String,
    specScm: Scheme,
    paramExpansions: List (Option (List TaggedTerm))
): List TaggedTerm = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(
        coRewriteSelfCallsInSpecBody(h, origFnName, specFnName, specScm, paramExpansions),
        coRewriteSelfCallsInList(t, origFnName, specFnName, specScm, paramExpansions)
    ),
}

def coTrySpecializeHofLoop(
    cctx: CombOptCtx,
    targetFd: FunDef,
    callArgs: List TaggedTerm,
    cenv: CoEnv,
    cExportSet: StrMap Bool,
    sp: Span,
    resScm: Scheme
): Option TaggedTerm =
    if (
        strMapContains(cctx.coSkipFns, targetFd.fnName)
        || listLen(targetFd.fnParams) != listLen(callArgs)
        || coTypeBlocksOpt(schemeBody(targetFd.fnScm))
        || !coInlineParamsMatchArgs(targetFd.fnParams, callArgs)
    ) None
    else {
        let choicesRev: Cell (List (Option (ClosureSpec, FunDef))) = cellNew(Nil);
        let keyPartsRev: Cell (List String) = cellNew(Nil);
        let expectedSpecArity = cellNew(0);
        let arityCheckOk = cellNew(true);
        let anySpec = cellNew(false);
        let idx = cellNew(0);
        let cp = cellNew(targetFd.fnParams);
        let ca = cellNew(callArgs);
        while (match (cellGet(cp), cellGet(ca)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
            match (cellGet(cp), cellGet(ca)) {
                (Cons(pvd, rp), Cons(argTm, ra)) -> {
                    let i = cellGet(idx);
                    let specHit: Option (ClosureSpec, FunDef) = match schemeBody(pvd.vscm) {
                        TyArr(_, _, _) ->
                            if (coParamInvariantAndOnlyCalledInTerm(targetFd.fnBody, targetFd.fnName, pvd.vname, i)) {
                                coResolveKnownArgClosure(argTm, cenv, cctx)
                            } else None,
                        _ -> None,
                    };
                    match specHit {
                        Some((cls, clsFd)) -> {
                            cellSet(anySpec, true);
                            cellSet(choicesRev, Cons(Some((cls, clsFd)), cellGet(choicesRev)));
                            cellSet(keyPartsRev, Cons(intToStr(i) + ":" + cls.clsEntry, cellGet(keyPartsRev)));
                            let fvCnt = listLen(clsFd.fnFvs);
                            let curAr = cellGet(expectedSpecArity);
                            if (cellGet(arityCheckOk) && curAr <= 1048576 && fvCnt <= 1024) {
                                cellSet(expectedSpecArity, coSpecSlotStepArity(curAr, true, fvCnt))
                            } else cellSet(arityCheckOk, false)
                        },
                        None -> {
                            cellSet(choicesRev, Cons(None, cellGet(choicesRev)));
                            cellSet(keyPartsRev, Cons("-", cellGet(keyPartsRev)));
                            let curAr = cellGet(expectedSpecArity);
                            if (cellGet(arityCheckOk) && curAr <= 1048576) {
                                cellSet(expectedSpecArity, coSpecSlotStepArity(curAr, false, 0))
                            } else cellSet(arityCheckOk, false)
                        },
                    };
                    cellSet(idx, i + 1);
                    cellSet(cp, rp);
                    cellSet(ca, ra)
                },
                _ -> (),
            }
        };
        if (!cellGet(anySpec)) None
        else {
            let choices = listRev(cellGet(choicesRev));
            let specKey = targetFd.fnName + "|" + joinKeyListPipe(listRev(cellGet(keyPartsRev)));
            // Build call-site arguments corresponding to `choices`
            let siteArgsRev: Cell (List TaggedTerm) = cellNew(Nil);
            let cc0 = cellNew(choices);
            let ca0 = cellNew(callArgs);
            while (match (cellGet(cc0), cellGet(ca0)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                match (cellGet(cc0), cellGet(ca0)) {
                    (Cons(chOpt, rc), Cons(origArg, ra)) -> {
                        match chOpt {
                            None -> cellSet(siteArgsRev, Cons(origArg, cellGet(siteArgsRev))),
                            Some((cls, clsFd)) -> {
                                let cf1 = cellNew(clsFd.fnFvs);
                                let cf2 = cellNew(cls.clsFvs);
                                while (match (cellGet(cf1), cellGet(cf2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                    match (cellGet(cf1), cellGet(cf2)) {
                                        (Cons(fvd, rf1), Cons(callerFv, rf2)) -> {
                                            let rv = coResolveAlias(cenv.ceAliases, callerFv, 0);
                                            cellSet(siteArgsRev, Cons(MkTerm {
                                                tspan: sp,
                                                tscm: fvd.vscm,
                                                tnode: TmVar(rv),
                                            }, cellGet(siteArgsRev)));
                                            cellSet(cf1, rf1);
                                            cellSet(cf2, rf2)
                                        },
                                        _ -> (),
                                    }
                                }
                            },
                        };
                        cellSet(cc0, rc);
                        cellSet(ca0, ra)
                    },
                    _ -> (),
                }
            };
            let siteArgs = listRev(cellGet(siteArgsRev));
            match strMapGet(cctx.coSpecMap, specKey) {
                Some(existingSpecFn) -> match strMapGet(cctx.coFns, existingSpecFn) {
                    Some(sfd) -> Some(MkTerm {
                        tspan: sp,
                        tscm: resScm,
                        tnode: TmApplyDir(MkVarDecl { vname: existingSpecFn, vscm: sfd.fnScm }, siteArgs),
                    }),
                    None -> None,
                },
                None ->
                    if (cellGet(cctx.coSpecCount) >= 64) None
                    else {
                        let sid = coFreshId(cctx);
                        let specName = targetFd.fnName + "$spec$" + intToStr(sid);
                        cellSet(cctx.coSpecCount, cellGet(cctx.coSpecCount) + 1);
                        strMapInsert(cctx.coSpecMap, specKey, specName);

                        let specParamsRev: Cell (List VarDecl) = cellNew(Nil);
                        let cloneEnvRev: Cell (List (String, String)) = cellNew(Nil);
                        let recExpansionsRev: Cell (List (Option (List TaggedTerm))) = cellNew(Nil);
                        let wrapperClsRev: Cell (List (VarDecl, ClosureSpec)) = cellNew(Nil);

                        let cp1 = cellNew(targetFd.fnParams);
                        let cc1 = cellNew(choices);
                        while (match (cellGet(cp1), cellGet(cc1)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                            match (cellGet(cp1), cellGet(cc1)) {
                                (Cons(pvd, rp), Cons(chOpt, rc)) -> {
                                    match chOpt {
                                        None -> {
                                            let np = coFreshBinder(cctx, pvd.vname);
                                            cellSet(cloneEnvRev, Cons((pvd.vname, np), cellGet(cloneEnvRev)));
                                            cellSet(specParamsRev, Cons(MkVarDecl { vname: np, vscm: pvd.vscm }, cellGet(specParamsRev)));
                                            cellSet(recExpansionsRev, Cons(None, cellGet(recExpansionsRev)))
                                        },
                                        Some((_, clsFd)) -> {
                                            let clsVarName = coFreshBinder(cctx, pvd.vname);
                                            cellSet(cloneEnvRev, Cons((pvd.vname, clsVarName), cellGet(cloneEnvRev)));
                                            let fvTermsRev: Cell (List TaggedTerm) = cellNew(Nil);
                                            let fvNamesRev: Cell (List String) = cellNew(Nil);
                                            let fvMapEnvRev: Cell (List (String, String)) = cellNew(Nil);
                                            let cf = cellNew(clsFd.fnFvs);
                                            while (match cellGet(cf) { Nil -> false, _ -> true }) {
                                                match cellGet(cf) {
                                                    Cons(fvd, rf) -> {
                                                        let fpNm = coFreshBinder(cctx, fvd.vname);
                                                        let fpDecl = MkVarDecl { vname: fpNm, vscm: fvd.vscm };
                                                        cellSet(specParamsRev, Cons(fpDecl, cellGet(specParamsRev)));
                                                        cellSet(fvNamesRev, Cons(fpNm, cellGet(fvNamesRev)));
                                                        cellSet(fvMapEnvRev, Cons((fvd.vname, fpNm), cellGet(fvMapEnvRev)));
                                                        cellSet(fvTermsRev, Cons(MkTerm {
                                                            tspan: targetFd.fnSpan,
                                                            tscm: fvd.vscm,
                                                            tnode: TmVar(fpNm),
                                                        }, cellGet(fvTermsRev)));
                                                        cellSet(cf, rf)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            cellSet(recExpansionsRev, Cons(Some(listRev(cellGet(fvTermsRev))), cellGet(recExpansionsRev)));
                                            let localSpec = match clsFd.fnFvs {
                                                Nil -> MkClosureSpec { clsEntry: clsFd.fnName, clsFvs: Nil },
                                                _ -> {
                                                    let origFvsList = mapVarDeclNames(clsFd.fnFvs);
                                                    match coCloneClosureEntryForEnv(cctx, clsFd.fnName, origFvsList, cellGet(fvMapEnvRev), targetFd.fnSpan) {
                                                        Some((ne, nfvs)) -> MkClosureSpec { clsEntry: ne, clsFvs: nfvs },
                                                        None -> MkClosureSpec { clsEntry: clsFd.fnName, clsFvs: listRev(cellGet(fvNamesRev)) },
                                                    }
                                                },
                                            };
                                            cellSet(wrapperClsRev, Cons((MkVarDecl { vname: clsVarName, vscm: pvd.vscm }, localSpec), cellGet(wrapperClsRev)))
                                        },
                                    };
                                    cellSet(cp1, rp);
                                    cellSet(cc1, rc)
                                },
                                _ -> (),
                            }
                        };

                        let specParams = listRev(cellGet(specParamsRev));
                        if (cellGet(arityCheckOk)) {
                            assert(listLen(specParams) == cellGet(expectedSpecArity) && listLen(siteArgs) == cellGet(expectedSpecArity))
                        } else ();
                        let retTy = schemeBody(targetFd.fnBody.tscm);
                        let specScm = ScmMono(TyArr(TyVoid, coMapVarDeclTypes(specParams), retTy));
                        let clonedRaw = coCloneTerm(cctx, targetFd.fnBody, cellGet(cloneEnvRev), targetFd.fnSpan);
                    let rewrittenSelf = coRewriteSelfCallsInSpecBody(
                        clonedRaw,
                        targetFd.fnName,
                        specName,
                        specScm,
                        listRev(cellGet(recExpansionsRev))
                    );
                    let wrappedBody = cellNew(rewrittenSelf);
                    let cw = cellNew(cellGet(wrapperClsRev));
                    while (match cellGet(cw) { Nil -> false, _ -> true }) {
                        match cellGet(cw) {
                            Cons((wvd, wspec), rw) -> {
                                cellSet(wrappedBody, MkTerm {
                                    tspan: targetFd.fnSpan,
                                    tscm: targetFd.fnBody.tscm,
                                    tnode: TmMakeCls(wvd, wspec, cellGet(wrappedBody)),
                                });
                                cellSet(cw, rw)
                            },
                            Nil -> (),
                        }
                    };

                    // Register placeholder first so nested specialization terminates cleanly
                    let placeholderFd = MkFunDef {
                        fnName: specName,
                        fnSpan: targetFd.fnSpan,
                        fnScm: specScm,
                        fnParams: specParams,
                        fnFvs: Nil,
                        fnBody: cellGet(wrappedBody),
                    };
                    coRegisterFn(cctx, placeholderFd);

                    let specInitEnv = coInitialEnvForFn(specParams, Nil);
                    let savedInl = cellGet(cctx.coFnInlines);
                    cellSet(cctx.coFnInlines, 0);
                    let optSpecBody = coOptTerm(cctx, specName, cellGet(wrappedBody), specInitEnv, cExportSet, 1);
                    cellSet(cctx.coFnInlines, savedInl);
                    let finalSpecFd = MkFunDef {
                        fnName: specName,
                        fnSpan: targetFd.fnSpan,
                        fnScm: specScm,
                        fnParams: specParams,
                        fnFvs: Nil,
                        fnBody: optSpecBody,
                    };
                    coRegisterFn(cctx, finalSpecFd);
                    Some(MkTerm {
                        tspan: sp,
                        tscm: resScm,
                        tnode: TmApplyDir(MkVarDecl { vname: specName, vscm: specScm }, siteArgs),
                    })
                },
            }
        }
    }

def joinKeyListPipe(xs: List String): String = match xs {
    Nil -> "",
    Cons(h, Nil) -> h,
    Cons(h, t) -> h + "," + joinKeyListPipe(t),
}

def mapVarDeclNames(vds: List VarDecl): List String = match vds {
    Nil -> Nil,
    Cons(vd, r) -> Cons(vd.vname, mapVarDeclNames(r)),
}

// ---- Closure Capture Propagation (`coSpecializeClosureCaptures`) ----

def coTryPropagateClosureCaptures(
    cctx: CombOptCtx,
    vd: VarDecl,
    cls: ClosureSpec,
    cenv: CoEnv,
    cExportSet: StrMap Bool,
    sp: Span,
    depth: Int
): ClosureSpec =
    if (depth >= 5 || listContainsStr(cls.clsFvs, vd.vname)) cls
    else match strMapGet(cctx.coFns, cls.clsEntry) {
        None -> cls,
        Some(clsFd) ->
            if (listLen(clsFd.fnFvs) != listLen(cls.clsFvs)) cls
            else {
                let anyKnown = cellNew(false);
                let cf = cellNew(cls.clsFvs);
                while (match cellGet(cf) { Nil -> false, _ -> true }) {
                    match cellGet(cf) {
                        Cons(rawFv, rf) -> {
                            let rv = coResolveAlias(cenv.ceAliases, rawFv, 0);
                            if (rv != rawFv) cellSet(anyKnown, true) else ();
                            match lookupInlineEnvOpt(cenv.ceKnownCls, rv) {
                                Some(icls) if (!listContainsStr(icls.clsFvs, rv)) -> cellSet(anyKnown, true),
                                _ -> match lookupInlineEnvOpt(cenv.ceKnownVals, rv) {
                                    Some(CoValData(_, _, dFs, dFtys, dTargs))
                                        if (listLen(dFs) <= 4 && !coTypeListBlocksOpt(dFtys) && !coTypeListBlocksOpt(dTargs)) ->
                                        cellSet(anyKnown, true),
                                    _ -> (),
                                },
                            };
                            cellSet(cf, rf)
                        },
                        Nil -> (),
                    }
                };
                if (!cellGet(anyKnown)) cls
                else {
                    let pid = coFreshId(cctx);
                    let newClsEntry = cls.clsEntry + "$cprop$" + intToStr(pid);

                    let newFnFvsRev: Cell (List VarDecl) = cellNew(Nil);
                    let newCallFvsRev: Cell (List String) = cellNew(Nil);
                    let seenCallerFvs: Cell (List String) = cellNew(Nil);
                    let cloneEnvRev: Cell (List (String, String)) = cellNew(Nil);
                    // Wrap bindings reconstructed inside `newClsEntry`:
                    // Left(vd, ClosureSpec) or Right(vd, TaggedTerm)
                    let reconClsRev: Cell (List (VarDecl, ClosureSpec)) = cellNew(Nil);
                    let reconLetRev: Cell (List (VarDecl, TaggedTerm)) = cellNew(Nil);

                    let addCapturedCallerVar = (callerVar: String, varScm: Scheme) -> {
                        let innerFvNm =
                            if (!listContainsStr(cellGet(seenCallerFvs), callerVar)) {
                                cellSet(seenCallerFvs, Cons(callerVar, cellGet(seenCallerFvs)));
                                cellSet(newCallFvsRev, Cons(callerVar, cellGet(newCallFvsRev)));
                                cellSet(newFnFvsRev, Cons(MkVarDecl { vname: callerVar, vscm: varScm }, cellGet(newFnFvsRev)));
                                callerVar
                            } else callerVar;
                        innerFvNm
                    };

                    let cf1 = cellNew(clsFd.fnFvs);
                    let cf2 = cellNew(cls.clsFvs);
                    while (match (cellGet(cf1), cellGet(cf2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                        match (cellGet(cf1), cellGet(cf2)) {
                            (Cons(fvd, rf1), Cons(rawFv, rf2)) -> {
                                let rv = coResolveAlias(cenv.ceAliases, rawFv, 0);
                                let handled = match lookupInlineEnvOpt(cenv.ceKnownCls, rv) {
                                    Some(icls) if (!listContainsStr(icls.clsFvs, rv)) ->
                                        match strMapGet(cctx.coFns, icls.clsEntry) {
                                            Some(ifd) if (listLen(ifd.fnFvs) == listLen(icls.clsFvs) && !coVarDeclListBlocksOpt(ifd.fnFvs)) -> {
                                                let innerBoundNm = coFreshBinder(cctx, fvd.vname);
                                                cellSet(cloneEnvRev, Cons((fvd.vname, innerBoundNm), cellGet(cloneEnvRev)));
                                                let subEnvRev: Cell (List (String, String)) = cellNew(Nil);
                                                let ic1 = cellNew(ifd.fnFvs);
                                                let ic2 = cellNew(icls.clsFvs);
                                                while (match (cellGet(ic1), cellGet(ic2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                                    match (cellGet(ic1), cellGet(ic2)) {
                                                        (Cons(ifvd, ric1), Cons(icallerFv, ric2)) -> {
                                                            let irv = coResolveAlias(cenv.ceAliases, icallerFv, 0);
                                                            let _ = addCapturedCallerVar(irv, ifvd.vscm);
                                                            cellSet(subEnvRev, Cons((ifvd.vname, irv), cellGet(subEnvRev)));
                                                            cellSet(ic1, ric1);
                                                            cellSet(ic2, ric2)
                                                        },
                                                        _ -> (),
                                                    }
                                                };
                                                let innerSpec = match ifd.fnFvs {
                                                    Nil -> MkClosureSpec { clsEntry: icls.clsEntry, clsFvs: Nil },
                                                    _ -> match coCloneClosureEntryForEnv(cctx, icls.clsEntry, mapVarDeclNames(ifd.fnFvs), cellGet(subEnvRev), sp) {
                                                        Some((ne, nfvs)) -> MkClosureSpec { clsEntry: ne, clsFvs: nfvs },
                                                        None -> icls,
                                                    },
                                                };
                                                cellSet(reconClsRev, Cons((MkVarDecl { vname: innerBoundNm, vscm: fvd.vscm }, innerSpec), cellGet(reconClsRev)));
                                                true
                                            },
                                            _ -> false,
                                        },
                                    _ -> false,
                                };
                                if (!handled) {
                                    let handledData = match lookupInlineEnvOpt(cenv.ceKnownVals, rv) {
                                        Some(CoValData(dAdt, dTag, dFs, dFtys, dTargs))
                                            if (listLen(dFs) <= 4 && !coTypeListBlocksOpt(dFtys) && !coTypeListBlocksOpt(dTargs)) -> {
                                            let innerDataNm = coFreshBinder(cctx, fvd.vname);
                                            cellSet(cloneEnvRev, Cons((fvd.vname, innerDataNm), cellGet(cloneEnvRev)));
                                            let newFieldsRev: Cell (List TaggedTerm) = cellNew(Nil);
                                            let dfs = cellNew(dFs);
                                            while (match cellGet(dfs) { Nil -> false, _ -> true }) {
                                                match cellGet(dfs) {
                                                    Cons(ftm, rdfs) -> {
                                                        let mappedFieldTm = match ftm.tnode {
                                                            TmVar(fvField) -> {
                                                                let rvf = coResolveAlias(cenv.ceAliases, fvField, 0);
                                                                let _ = addCapturedCallerVar(rvf, ftm.tscm);
                                                                // Also propagate closure if `rvf` itself is a known closure!
                                                                match lookupInlineEnvOpt(cenv.ceKnownCls, rvf) {
                                                                    Some(fcls) if (!listContainsStr(fcls.clsFvs, rvf)) ->
                                                                        match strMapGet(cctx.coFns, fcls.clsEntry) {
                                                                            Some(ffd) if (listLen(ffd.fnFvs) == listLen(fcls.clsFvs) && !coVarDeclListBlocksOpt(ffd.fnFvs)) -> {
                                                                                let subClsNm = coFreshBinder(cctx, rvf);
                                                                                let fEnvRev: Cell (List (String, String)) = cellNew(Nil);
                                                                                let fc1 = cellNew(ffd.fnFvs);
                                                                                let fc2 = cellNew(fcls.clsFvs);
                                                                                while (match (cellGet(fc1), cellGet(fc2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                                                                    match (cellGet(fc1), cellGet(fc2)) {
                                                                                        (Cons(ffvd, rfc1), Cons(fcallerFv, rfc2)) -> {
                                                                                            let frv = coResolveAlias(cenv.ceAliases, fcallerFv, 0);
                                                                                            let _ = addCapturedCallerVar(frv, ffvd.vscm);
                                                                                            cellSet(fEnvRev, Cons((ffvd.vname, frv), cellGet(fEnvRev)));
                                                                                            cellSet(fc1, rfc1);
                                                                                            cellSet(fc2, rfc2)
                                                                                        },
                                                                                        _ -> (),
                                                                                    }
                                                                                };
                                                                                let fInnerSpec = match ffd.fnFvs {
                                                                                    Nil -> MkClosureSpec { clsEntry: fcls.clsEntry, clsFvs: Nil },
                                                                                    _ -> match coCloneClosureEntryForEnv(cctx, fcls.clsEntry, mapVarDeclNames(ffd.fnFvs), cellGet(fEnvRev), sp) {
                                                                                        Some((ne, nfvs)) -> MkClosureSpec { clsEntry: ne, clsFvs: nfvs },
                                                                                        None -> fcls,
                                                                                    },
                                                                                };
                                                                                cellSet(reconClsRev, Cons((MkVarDecl { vname: subClsNm, vscm: ftm.tscm }, fInnerSpec), cellGet(reconClsRev)));
                                                                                MkTerm { tspan: ftm.tspan, tscm: ftm.tscm, tnode: TmVar(subClsNm) }
                                                                            },
                                                                            _ -> MkTerm { tspan: ftm.tspan, tscm: ftm.tscm, tnode: TmVar(rvf) },
                                                                        },
                                                                    _ -> MkTerm { tspan: ftm.tspan, tscm: ftm.tscm, tnode: TmVar(rvf) },
                                                                }
                                                            },
                                                            _ -> ftm,
                                                        };
                                                        cellSet(newFieldsRev, Cons(mappedFieldTm, cellGet(newFieldsRev)));
                                                        cellSet(dfs, rdfs)
                                                    },
                                                    Nil -> (),
                                                }
                                            };
                                            let dataRhs = MkTerm {
                                                tspan: sp,
                                                tscm: fvd.vscm,
                                                tnode: TmMakeData(dAdt, dTag, listRev(cellGet(newFieldsRev)), dFtys, dTargs),
                                            };
                                            cellSet(reconLetRev, Cons((MkVarDecl { vname: innerDataNm, vscm: fvd.vscm }, dataRhs), cellGet(reconLetRev)));
                                            true
                                        },
                                        _ -> false,
                                    };
                                    if (!handledData) {
                                        let _ = addCapturedCallerVar(rv, fvd.vscm);
                                        cellSet(cloneEnvRev, Cons((fvd.vname, rv), cellGet(cloneEnvRev)))
                                    } else ()
                                } else ();
                                cellSet(cf1, rf1);
                                cellSet(cf2, rf2)
                            },
                            _ -> (),
                        }
                    };

                    let newParamsRev: Cell (List VarDecl) = cellNew(Nil);
                    let cp = cellNew(clsFd.fnParams);
                    while (match cellGet(cp) { Nil -> false, _ -> true }) {
                        match cellGet(cp) {
                            Cons(pvd, rp) -> {
                                let np = coFreshBinder(cctx, pvd.vname);
                                cellSet(cloneEnvRev, Cons((pvd.vname, np), cellGet(cloneEnvRev)));
                                cellSet(newParamsRev, Cons(MkVarDecl { vname: np, vscm: pvd.vscm }, cellGet(newParamsRev)));
                                cellSet(cp, rp)
                            },
                            Nil -> (),
                        }
                    };

                    let clonedCore = coCloneTerm(cctx, clsFd.fnBody, cellGet(cloneEnvRev), sp);
                    let bodyWithLets = coWrapLetBindings(listRev(cellGet(reconLetRev)), clonedCore, sp, clsFd.fnBody.tscm);
                    let bodyWrapped = cellNew(bodyWithLets);
                    let crc = cellNew(cellGet(reconClsRev));
                    while (match cellGet(crc) { Nil -> false, _ -> true }) {
                        match cellGet(crc) {
                            Cons((rcVd, rcSpec), rrc) -> {
                                cellSet(bodyWrapped, MkTerm {
                                    tspan: sp,
                                    tscm: clsFd.fnBody.tscm,
                                    tnode: TmMakeCls(rcVd, rcSpec, cellGet(bodyWrapped)),
                                });
                                cellSet(crc, rrc)
                            },
                            Nil -> (),
                        }
                    };

                    let newParams = listRev(cellGet(newParamsRev));
                    let newFnFvs0 = listRev(cellGet(newFnFvsRev));
                    let newCallFvs0 = listRev(cellGet(newCallFvsRev));
                    let innerEnv = coInitialEnvForFn(newParams, newFnFvs0);
                    let savedInl = cellGet(cctx.coFnInlines);
                    cellSet(cctx.coFnInlines, 0);
                    let optInnerBody = coOptTerm(cctx, newClsEntry, cellGet(bodyWrapped), innerEnv, cExportSet, depth + 1);
                    cellSet(cctx.coFnInlines, savedInl);

                    // Prune any captured free variables that became dead after simplifying `optInnerBody`!
                    let liveFnFvsRev: Cell (List VarDecl) = cellNew(Nil);
                    let liveCallFvsRev: Cell (List String) = cellNew(Nil);
                    let lf1 = cellNew(newFnFvs0);
                    let lf2 = cellNew(newCallFvs0);
                    while (match (cellGet(lf1), cellGet(lf2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                        match (cellGet(lf1), cellGet(lf2)) {
                            (Cons(fvd, rlf1), Cons(cfv, rlf2)) -> {
                                if (coTermMentionsVar(optInnerBody, fvd.vname)) {
                                    cellSet(liveFnFvsRev, Cons(fvd, cellGet(liveFnFvsRev)));
                                    cellSet(liveCallFvsRev, Cons(cfv, cellGet(liveCallFvsRev)))
                                } else ();
                                cellSet(lf1, rlf1);
                                cellSet(lf2, rlf2)
                            },
                            _ -> (),
                        }
                    };

                    let finalFnFvs = listRev(cellGet(liveFnFvsRev));
                    let finalCallFvs = listRev(cellGet(liveCallFvsRev));
                    let newFd = MkFunDef {
                        fnName: newClsEntry,
                        fnSpan: sp,
                        fnScm: clsFd.fnScm,
                        fnParams: newParams,
                        fnFvs: finalFnFvs,
                        fnBody: optInnerBody,
                    };
                    coRegisterFn(cctx, newFd);
                    MkClosureSpec { clsEntry: newClsEntry, clsFvs: finalCallFvs }
                }
            },
    }

// ---- Main Recursive Term Optimizer (`coOptTerm`) ----

def coInitialEnvForFn(params: List VarDecl, fvs: List VarDecl): CoEnv = {
    let tysRev: Cell (List (String, Scheme)) = cellNew(Nil);
    let cp = cellNew(params);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(vd, r) -> {
                cellSet(tysRev, Cons((vd.vname, vd.vscm), cellGet(tysRev)));
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };
    let cf = cellNew(fvs);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(vd, r) -> {
                cellSet(tysRev, Cons((vd.vname, vd.vscm), cellGet(tysRev)));
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };
    MkCoEnv {
        ceAliases: Nil,
        ceVarTys: listRev(cellGet(tysRev)),
        ceKnownVals: Nil,
        ceKnownCls: Nil,
    }
}

def coRecordLetBindingInEnv(cenv: CoEnv, vd: VarDecl, rhs: TaggedTerm): CoEnv = {
    let base = coBindVarInEnv(cenv, vd.vname, vd.vscm);
    match rhs.tnode {
        TmVar(src) -> {
            let rsrc = coResolveAlias(base.ceAliases, src, 0);
            if (rsrc == vd.vname) base
            else MkCoEnv {
                ceAliases: Cons((vd.vname, rsrc), base.ceAliases),
                ceVarTys: base.ceVarTys,
                ceKnownVals: base.ceKnownVals,
                ceKnownCls: base.ceKnownCls,
            }
        },
        TmLit(l) -> MkCoEnv {
            ceAliases: base.ceAliases,
            ceVarTys: base.ceVarTys,
            ceKnownVals: Cons((vd.vname, CoValLit(l)), base.ceKnownVals),
            ceKnownCls: base.ceKnownCls,
        },
        TmTuple(es) if (coAllTermsSimple(es) && !coTermListMentionsVar(es, vd.vname)) -> MkCoEnv {
            ceAliases: base.ceAliases,
            ceVarTys: base.ceVarTys,
            ceKnownVals: Cons((vd.vname, CoValTuple(es)), base.ceKnownVals),
            ceKnownCls: base.ceKnownCls,
        },
        TmMakeData(adt, tag, fs, ftys, targs) if (coAllTermsSimple(fs) && !coTermListMentionsVar(fs, vd.vname)) -> MkCoEnv {
            ceAliases: base.ceAliases,
            ceVarTys: base.ceVarTys,
            ceKnownVals: Cons((vd.vname, CoValData(adt, tag, fs, ftys, targs)), base.ceKnownVals),
            ceKnownCls: base.ceKnownCls,
        },
        _ -> base,
    }
}

def coFinishLetWithDeadElim(vd: VarDecl, rhs: TaggedTerm, body: TaggedTerm, sp: Span, sc: Scheme): TaggedTerm =
    if (!coTermMentionsVar(body, vd.vname) && coTermIsPure(rhs)) body
    else MkTerm { tspan: sp, tscm: sc, tnode: TmLet(vd, rhs, body) }

def coFinishMakeClsWithDeadElim(vd: VarDecl, cls: ClosureSpec, body: TaggedTerm, sp: Span, sc: Scheme): TaggedTerm =
    if (!coTermMentionsVar(body, vd.vname)) body
    else MkTerm { tspan: sp, tscm: sc, tnode: TmMakeCls(vd, cls, body) }

def coEvictPatVarsFromEnv(pat: Pattern, cenv: CoEnv): CoEnv = match pat {
    PatWild -> cenv,
    PatLit(_) -> cenv,
    PatVar(v, _) -> coBindVarInEnv(cenv, v, ScmSlot),
    PatTuple(ps) -> coEvictPatVarListFromEnv(ps, cenv),
    PatCtor(_, ps) -> coEvictPatVarListFromEnv(ps, cenv),
    PatStruct(_, _) -> cenv,
}

def coEvictPatVarListFromEnv(ps: List Pattern, cenv: CoEnv): CoEnv = match ps {
    Nil -> cenv,
    Cons(p, r) -> coEvictPatVarListFromEnv(r, coEvictPatVarsFromEnv(p, cenv)),
}

def coEnvHasVar(cenv: CoEnv, v: String): Bool = match lookupInlineEnvOpt(cenv.ceVarTys, v) {
    Some(_) -> true,
    None -> false,
}

def coBindFlatLetChain(
    cctx: CombOptCtx,
    callerName: String,
    vd: VarDecl,
    flatRhs: TaggedTerm,
    body0: TaggedTerm,
    cenv: CoEnv,
    cExportSet: StrMap Bool,
    depth: Int,
    sp: Span,
    sc: Scheme
): TaggedTerm = match flatRhs.tnode {
    TmLet(innerVd, innerRhs, innerBody) if (innerVd.vname != vd.vname && !coEnvHasVar(cenv, innerVd.vname) && !coTermMentionsVar(body0, innerVd.vname)) -> {
        let cenv1 = coRecordLetBindingInEnv(cenv, innerVd, innerRhs);
        let restOpt = coBindFlatLetChain(cctx, callerName, vd, innerBody, body0, cenv1, cExportSet, depth, sp, sc);
        coFinishLetWithDeadElim(innerVd, innerRhs, restOpt, sp, sc)
    },
    TmMakeCls(clsVd, clsSpec, innerBody) if (clsVd.vname != vd.vname && !coEnvHasVar(cenv, clsVd.vname) && !coTermMentionsVar(body0, clsVd.vname)) -> {
        let base = coBindVarInEnv(cenv, clsVd.vname, clsVd.vscm);
        let cenv1 =
            if (listContainsStr(clsSpec.clsFvs, clsVd.vname)) base
            else MkCoEnv {
                ceAliases: base.ceAliases,
                ceVarTys: base.ceVarTys,
                ceKnownVals: base.ceKnownVals,
                ceKnownCls: Cons((clsVd.vname, clsSpec), base.ceKnownCls),
            };
        let restOpt = coBindFlatLetChain(cctx, callerName, vd, innerBody, body0, cenv1, cExportSet, depth, sp, sc);
        coFinishMakeClsWithDeadElim(clsVd, clsSpec, restOpt, sp, sc)
    },
    _ -> {
        let cenvNext = coRecordLetBindingInEnv(cenv, vd, flatRhs);
        let body1 = coOptTerm(cctx, callerName, body0, cenvNext, cExportSet, depth);
        coFinishLetWithDeadElim(vd, flatRhs, body1, sp, sc)
    },
}

def coOptMatchWithFloatedScrut(
    cctx: CombOptCtx,
    callerName: String,
    scrut: TaggedTerm,
    arms0: List CoreArm,
    cenv: CoEnv,
    cExportSet: StrMap Bool,
    depth: Int,
    sp: Span,
    sc: Scheme
): TaggedTerm = match scrut.tnode {
    TmLet(svd, srhs, sbody) if (!coEnvHasVar(cenv, svd.vname) && !coArmListMentionsVar(arms0, svd.vname)) -> {
        let cenv1 = coRecordLetBindingInEnv(cenv, svd, srhs);
        let inner = coOptMatchWithFloatedScrut(cctx, callerName, sbody, arms0, cenv1, cExportSet, depth, sp, sc);
        coFinishLetWithDeadElim(svd, srhs, inner, sp, sc)
    },
    TmMakeCls(cvd, cspec, sbody) if (!coEnvHasVar(cenv, cvd.vname) && !coArmListMentionsVar(arms0, cvd.vname)) -> {
        let base = coBindVarInEnv(cenv, cvd.vname, cvd.vscm);
        let cenv1 =
            if (listContainsStr(cspec.clsFvs, cvd.vname)) base
            else MkCoEnv {
                ceAliases: base.ceAliases,
                ceVarTys: base.ceVarTys,
                ceKnownVals: base.ceKnownVals,
                ceKnownCls: Cons((cvd.vname, cspec), base.ceKnownCls),
            };
        let inner = coOptMatchWithFloatedScrut(cctx, callerName, sbody, arms0, cenv1, cExportSet, depth, sp, sc);
        coFinishMakeClsWithDeadElim(cvd, cspec, inner, sp, sc)
    },
    _ -> match coTryReduceMatch(cctx, scrut, arms0, cenv, sp, sc) {
        Some(reduced) -> coOptTerm(cctx, callerName, reduced, cenv, cExportSet, depth),
        None -> {
            let armsRev: Cell (List CoreArm) = cellNew(Nil);
            let cur = cellNew(arms0);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let armEnv = coEvictPatVarsFromEnv(a.caPat, cenv);
                        let g2 = match a.caGuard {
                            Some(g) -> Some(coOptTerm(cctx, callerName, g, armEnv, cExportSet, depth)),
                            None -> None,
                        };
                        let b2 = coOptTerm(cctx, callerName, a.caBody, armEnv, cExportSet, depth);
                        cellSet(armsRev, Cons(MkCoreArm { caPat: a.caPat, caGuard: g2, caBody: b2 }, cellGet(armsRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            MkTerm { tspan: sp, tscm: sc, tnode: TmMatch(scrut, listRev(cellGet(armsRev))) }
        },
    },
}

def coOptTerm(
    cctx: CombOptCtx,
    callerName: String,
    tm: TaggedTerm,
    cenv: CoEnv,
    cExportSet: StrMap Bool,
    depth: Int
): TaggedTerm = {
    let sp = tm.tspan;
    let sc = tm.tscm;
    match tm.tnode {
        TmLit(_) -> tm,
        TmGlobalVar(_) -> tm,
        TmVar(v) -> {
            let rv = coResolveAlias(cenv.ceAliases, v, 0);
            if (rv == v) tm else MkTerm { tspan: sp, tscm: sc, tnode: TmVar(rv) }
        },
        TmTuple(es0) -> {
            let es1 = coOptTermList(cctx, callerName, es0, cenv, cExportSet, depth);
            if (coAllTermsSimple(es1)) MkTerm { tspan: sp, tscm: sc, tnode: TmTuple(es1) }
            else {
                let lifted = coAnfLiftTermList(cctx, es1, sp, sc, (xs) -> TmTuple(xs));
                coOptTerm(cctx, callerName, lifted, cenv, cExportSet, depth)
            }
        },
        TmMakeData(adt, tag, fs0, ftys, targs) -> {
            let fs1 = coOptTermList(cctx, callerName, fs0, cenv, cExportSet, depth);
            if (coAllTermsSimple(fs1)) {
                MkTerm { tspan: sp, tscm: sc, tnode: TmMakeData(adt, tag, fs1, ftys, targs) }
            } else {
                let lifted = coAnfLiftTermList(cctx, fs1, sp, sc, (xs) -> TmMakeData(adt, tag, xs, ftys, targs));
                coOptTerm(cctx, callerName, lifted, cenv, cExportSet, depth)
            }
        },
        TmBlock(es0) -> {
            let es1 = coOptTermList(cctx, callerName, es0, cenv, cExportSet, depth);
            match es1 {
                Cons(only, Nil) -> only,
                _ -> MkTerm { tspan: sp, tscm: sc, tnode: TmBlock(es1) },
            }
        },
        TmBin(op, l, r) ->
            MkTerm {
                tspan: sp,
                tscm: sc,
                tnode: TmBin(
                    op,
                    coOptTerm(cctx, callerName, l, cenv, cExportSet, depth),
                    coOptTerm(cctx, callerName, r, cenv, cExportSet, depth)
                ),
            },
        TmUn(op, e1) ->
            MkTerm { tspan: sp, tscm: sc, tnode: TmUn(op, coOptTerm(cctx, callerName, e1, cenv, cExportSet, depth)) },
        TmGetTag(e1) ->
            MkTerm { tspan: sp, tscm: sc, tnode: TmGetTag(coOptTerm(cctx, callerName, e1, cenv, cExportSet, depth)) },
        TmIf(c, t, e) ->
            MkTerm {
                tspan: sp,
                tscm: sc,
                tnode: TmIf(
                    coOptTerm(cctx, callerName, c, cenv, cExportSet, depth),
                    coOptTerm(cctx, callerName, t, cenv, cExportSet, depth),
                    coOptTerm(cctx, callerName, e, cenv, cExportSet, depth)
                ),
            },
        TmWhile(c, b) ->
            MkTerm {
                tspan: sp,
                tscm: sc,
                tnode: TmWhile(
                    coOptTerm(cctx, callerName, c, cenv, cExportSet, depth),
                    coOptTerm(cctx, callerName, b, cenv, cExportSet, depth)
                ),
            },
        TmLet(vd, rhs0, body0) -> {
            let rhs1 = coOptTerm(cctx, callerName, rhs0, cenv, cExportSet, depth);
            coBindFlatLetChain(cctx, callerName, vd, rhs1, body0, cenv, cExportSet, depth, sp, sc)
        },
        TmMakeCls(vd, cls0, body0) -> {
            let cls1 = coTryPropagateClosureCaptures(cctx, vd, cls0, cenv, cExportSet, sp, depth);
            let base = coBindVarInEnv(cenv, vd.vname, vd.vscm);
            let cenvNext =
                if (listContainsStr(cls1.clsFvs, vd.vname)) base
                else MkCoEnv {
                    ceAliases: base.ceAliases,
                    ceVarTys: base.ceVarTys,
                    ceKnownVals: base.ceKnownVals,
                    ceKnownCls: Cons((vd.vname, cls1), base.ceKnownCls),
                };
            let body1 = coOptTerm(cctx, callerName, body0, cenvNext, cExportSet, depth);
            coFinishMakeClsWithDeadElim(vd, cls1, body1, sp, sc)
        },
        TmMatch(scrut0, arms0) -> {
            let scrut1 = coOptTerm(cctx, callerName, scrut0, cenv, cExportSet, depth);
            coOptMatchWithFloatedScrut(cctx, callerName, scrut1, arms0, cenv, cExportSet, depth, sp, sc)
        },
        TmApplyCls(callee0, args0) -> {
            let callee1 = coOptTerm(cctx, callerName, callee0, cenv, cExportSet, depth);
            let args1 = coOptTermList(cctx, callerName, args0, cenv, cExportSet, depth);
            if (coTermNeedsArgFloat(callee1) || coAnyTermNeedsArgFloat(args1)) {
                let floatedList = Cons(callee1, args1);
                let lifted = coFloatSelectedArgs(cctx, floatedList, sp, sc, (xs) -> match xs {
                    Cons(nc, nargs) -> TmApplyCls(nc, nargs),
                    Nil -> TmApplyCls(callee1, args1),
                });
                coOptTerm(cctx, callerName, lifted, cenv, cExportSet, depth)
            } else {
                let devirtOpt: Option TaggedTerm = match callee1.tnode {
                    TmVar(cv) -> {
                        let rcv = coResolveAlias(cenv.ceAliases, cv, 0);
                        match lookupInlineEnvOpt(cenv.ceKnownCls, rcv) {
                            None -> None,
                            Some(cls) ->
                                if (listContainsStr(cls.clsFvs, rcv)) None
                                else match strMapGet(cctx.coFns, cls.clsEntry) {
                                    None -> None,
                                    Some(clsFd) ->
                                        if (
                                            listLen(clsFd.fnParams) != listLen(args1)
                                            || listLen(clsFd.fnFvs) != listLen(cls.clsFvs)
                                            || !coTypesEqualModuloMode(schemeBody(sc), schemeBody(clsFd.fnBody.tscm))
                                            || !coInlineParamsMatchArgs(clsFd.fnParams, args1)
                                            || coTypeBlocksOpt(schemeBody(sc))
                                            || coVarDeclListBlocksOpt(clsFd.fnParams)
                                            || coVarDeclListBlocksOpt(clsFd.fnFvs)
                                        ) None
                                        else {
                                            let cost = coCombinatorTermCost(clsFd.fnBody, cctx.coExterns);
                                            let inlCnt = cellGet(cctx.coFnInlines);
                                            if (
                                                coInlineBudgetAllows(cost, 52, inlCnt, 96, depth, 7)
                                                && !coReachesTargetFn(cctx, cls.clsEntry, callerName)
                                            ) {
                                                cellSet(cctx.coFnInlines, inlCnt + 1);
                                                let fvEnvRev: Cell (List (String, String)) = cellNew(Nil);
                                                let cf1 = cellNew(clsFd.fnFvs);
                                                let cf2 = cellNew(cls.clsFvs);
                                                while (match (cellGet(cf1), cellGet(cf2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                                    match (cellGet(cf1), cellGet(cf2)) {
                                                        (Cons(fvd, rf1), Cons(callerFv, rf2)) -> {
                                                            let rv = coResolveAlias(cenv.ceAliases, callerFv, 0);
                                                            cellSet(fvEnvRev, Cons((fvd.vname, rv), cellGet(fvEnvRev)));
                                                            cellSet(cf1, rf1);
                                                            cellSet(cf2, rf2)
                                                        },
                                                        _ -> (),
                                                    }
                                                };
                                                let inlined = coBuildCallArgsInline(
                                                    cctx, clsFd.fnParams, args1, cellGet(fvEnvRev), sp, sc, clsFd.fnBody
                                                );
                                                Some(coOptTerm(cctx, callerName, inlined, cenv, cExportSet, depth + 1))
                                            } else {
                                                match cls.clsFvs {
                                                    Nil -> {
                                                        let dirVd = MkVarDecl { vname: cls.clsEntry, vscm: ScmMono(schemeBody(callee1.tscm)) };
                                                        Some(MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(dirVd, args1) })
                                                    },
                                                    _ -> {
                                                        let flatName = coGetOrCreateFlatClsFn(cctx, clsFd, cExportSet);
                                                        match strMapGet(cctx.coFns, flatName) {
                                                            Some(flatFd) -> {
                                                                let fvArgsRev: Cell (List TaggedTerm) = cellNew(Nil);
                                                                let cf1 = cellNew(clsFd.fnFvs);
                                                                let cf2 = cellNew(cls.clsFvs);
                                                                while (match (cellGet(cf1), cellGet(cf2)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                                                    match (cellGet(cf1), cellGet(cf2)) {
                                                                        (Cons(fvd, rf1), Cons(callerFv, rf2)) -> {
                                                                            let rv = coResolveAlias(cenv.ceAliases, callerFv, 0);
                                                                            cellSet(fvArgsRev, Cons(MkTerm {
                                                                                tspan: sp,
                                                                                tscm: fvd.vscm,
                                                                                tnode: TmVar(rv),
                                                                            }, cellGet(fvArgsRev)));
                                                                            cellSet(cf1, rf1);
                                                                            cellSet(cf2, rf2)
                                                                        },
                                                                        _ -> (),
                                                                    }
                                                                };
                                                                let allArgs = listAppend(listRev(cellGet(fvArgsRev)), args1);
                                                                Some(MkTerm {
                                                                    tspan: sp,
                                                                    tscm: sc,
                                                                    tnode: TmApplyDir(MkVarDecl { vname: flatName, vscm: flatFd.fnScm }, allArgs),
                                                                })
                                                            },
                                                            None -> None,
                                                        }
                                                    },
                                                }
                                            }
                                        },
                                },
                        }
                    },
                    _ -> None,
                };
                match devirtOpt {
                    Some(resTm) -> resTm,
                    None -> MkTerm { tspan: sp, tscm: sc, tnode: TmApplyCls(callee1, args1) },
                }
            }
        },
        TmApplyDir(vd, args0) -> {
            let args1 = coOptTermList(cctx, callerName, args0, cenv, cExportSet, depth);
            let isCellIntrinsic = !isShadowedBuiltin(vd.vname, cctx.coFns, cctx.coExterns)
                && (vd.vname == "cellNew" || vd.vname == "cellGet" || vd.vname == "cellSet");
            if (!isCellIntrinsic && coAnyTermNeedsArgFloat(args1)) {
                let lifted = coFloatSelectedArgs(cctx, args1, sp, sc, (xs) -> TmApplyDir(vd, xs));
                coOptTerm(cctx, callerName, lifted, cenv, cExportSet, depth)
            } else if (strMapContains(cctx.coExterns, vd.vname)) {
                MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(vd, args1) }
            } else match strMapGet(cctx.coFns, vd.vname) {
                None -> MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(vd, args1) },
                Some(calleeFd) ->
                    if (callerName != calleeFd.fnName && match calleeFd.fnFvs { Nil -> true, _ -> false } && coTermCallsFn(calleeFd.fnBody, calleeFd.fnName)) {
                        match coTrySpecializeHofLoop(cctx, calleeFd, args1, cenv, cExportSet, sp, sc) {
                            Some(specCall) -> specCall,
                            None -> MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(vd, args1) },
                        }
                    } else {
                        let inlCnt = cellGet(cctx.coFnInlines);
                        if (
                            coInlineBudgetAllows(1, 28, inlCnt, 96, depth, 7)
                            && callerName != calleeFd.fnName
                            && coIsEligibleGeneralInlineFn(cctx, calleeFd, cExportSet)
                            && !coReachesTargetFn(cctx, calleeFd.fnName, callerName)
                            && coTypesEqualModuloMode(schemeBody(sc), schemeBody(calleeFd.fnBody.tscm))
                            && coInlineParamsMatchArgs(calleeFd.fnParams, args1)
                        ) {
                            cellSet(cctx.coFnInlines, inlCnt + 1);
                            let inlined = coBuildCallArgsInline(
                                cctx, calleeFd.fnParams, args1, Nil, sp, sc, calleeFd.fnBody
                            );
                            coOptTerm(cctx, callerName, inlined, cenv, cExportSet, depth + 1)
                        } else {
                            MkTerm { tspan: sp, tscm: sc, tnode: TmApplyDir(vd, args1) }
                        }
                    },
            }
        },
    }
}

def coOptTermList(
    cctx: CombOptCtx,
    callerName: String,
    es: List TaggedTerm,
    cenv: CoEnv,
    cExportSet: StrMap Bool,
    depth: Int
): List TaggedTerm
    ensures out -> listLen(out) == listLen(es)
= match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(
        coOptTerm(cctx, callerName, h, cenv, cExportSet, depth),
        coOptTermList(cctx, callerName, t, cenv, cExportSet, depth)
    ),
}

def optimizeCoreCombinators(
    fns: StrMap FunDef,
    fnNames: List String,
    globals: List GlobalValDef,
    externs: StrMap ExternDef,
    ctorMap: StrMap (String, VariantInfo),
    cExports: List (String, String),
    skipOptFns: StrMap Bool,
    nextBinderId: Cell Int
): (List String, List GlobalValDef)
    requires cellGet(nextBinderId) >= 0
    ensures r -> match r { (outNames, outGlobs) -> listLen(outNames) >= listLen(fnNames) && listLen(outGlobs) == listLen(globals) }
= {
    let cExportSet: StrMap Bool = strMapNew();
    let ce = cellNew(cExports);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons((fnm, _), r) -> {
                strMapInsert(cExportSet, fnm, true);
                cellSet(ce, r)
            },
            Nil -> (),
        }
    };

    let cctx = MkCombOptCtx {
        coFns: fns,
        coCalleesCache: strMapNew(),
        coNewNamesRev: cellNew(Nil),
        coExterns: externs,
        coCtorMap: ctorMap,
        coSkipFns: skipOptFns,
        coFlatClsMap: strMapNew(),
        coSpecMap: strMapNew(),
        coSpecCount: cellNew(0),
        coFnInlines: cellNew(0),
        coIdCnt: nextBinderId,
    };

    // Optimize top-level & monomorphized functions (`fnFvs == Nil`)
    let cf = cellNew(fnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnm, r) -> {
                if (!strMapContains(skipOptFns, fnm)) {
                    match strMapGet(fns, fnm) {
                        Some(fd) -> match fd.fnFvs {
                            Nil -> {
                                cellSet(cctx.coFnInlines, 0);
                                let initEnv = coInitialEnvForFn(fd.fnParams, Nil);
                                let newBody = coOptTerm(cctx, fnm, fd.fnBody, initEnv, cExportSet, 0);
                                coStoreFn(cctx, MkFunDef {
                                    fnName: fd.fnName,
                                    fnSpan: fd.fnSpan,
                                    fnScm: fd.fnScm,
                                    fnParams: fd.fnParams,
                                    fnFvs: Nil,
                                    fnBody: newBody,
                                })
                            },
                            _ -> (),
                        },
                        None -> (),
                    }
                } else ();
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    // Also optimize any remaining lifted closure bodies (`fnFvs != Nil`)
    let allNames1 = listAppend(fnNames, listRev(cellGet(cctx.coNewNamesRev)));
    cellSet(cctx.coNewNamesRev, Nil);
    let cf2 = cellNew(allNames1);
    while (match cellGet(cf2) { Nil -> false, _ -> true }) {
        match cellGet(cf2) {
            Cons(fnm, r) -> {
                if (!strMapContains(skipOptFns, fnm)) {
                    match strMapGet(fns, fnm) {
                        Some(fd) -> match fd.fnFvs {
                            Cons(_, _) -> {
                                cellSet(cctx.coFnInlines, 0);
                                let initEnv = coInitialEnvForFn(fd.fnParams, fd.fnFvs);
                                let newBody = coOptTerm(cctx, fnm, fd.fnBody, initEnv, cExportSet, 0);
                                coStoreFn(cctx, MkFunDef {
                                    fnName: fd.fnName,
                                    fnSpan: fd.fnSpan,
                                    fnScm: fd.fnScm,
                                    fnParams: fd.fnParams,
                                    fnFvs: fd.fnFvs,
                                    fnBody: newBody,
                                })
                            },
                            Nil -> (),
                        },
                        None -> (),
                    }
                } else ();
                cellSet(cf2, r)
            },
            Nil -> (),
        }
    };

    // Optimize global initializers
    let outGlobsRev: Cell (List GlobalValDef) = cellNew(Nil);
    let emptyEnv = coInitialEnvForFn(Nil, Nil);
    let cg = cellNew(globals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(gv, r) -> {
                cellSet(cctx.coFnInlines, 0);
                let newInit = coOptTerm(cctx, "$global$" + gv.gvName, gv.gvInit, emptyEnv, cExportSet, 0);
                cellSet(outGlobsRev, Cons(MkGlobalValDef {
                    gvName: gv.gvName,
                    gvSpan: gv.gvSpan,
                    gvTy: gv.gvTy,
                    gvInit: newInit,
                }, cellGet(outGlobsRev)));
                cellSet(cg, r)
            },
            Nil -> (),
        }
    };

    let finalNames = listAppend(allNames1, listRev(cellGet(cctx.coNewNamesRev)));
    (finalNames, listRev(cellGet(outGlobsRev)))
}

// ============================================================================
// Top-Level Entry Point (`lowerToCore`, `lowerToCoreOpt`, `lowerToCoreMode`, `lowerToCoreOptMode`, `lowerToCoreForCheck`)
// ============================================================================

pub def lowerToCoreOptMode(inf: InferOutput, runEscape: Bool, runInline: Bool, contractMode: String): Result CoreProgram String = {
    let ctorMap: StrMap (String, VariantInfo) = strMapNew();
    let ai = cellNew(0);
    while (cellGet(ai) < vecLen(inf.adtNames)) {
        let adtName = vecGetOr(inf.adtNames, cellGet(ai), "");
        match strMapGet(inf.adtReg, adtName) {
            Some(ainfo) -> {
                let cv = cellNew(ainfo.variants);
                while (match cellGet(cv) { Nil -> false, _ -> true }) {
                    match cellGet(cv) {
                        Cons(vi, r) -> {
                            strMapInsert(ctorMap, vi.vname, (adtName, vi));
                            cellSet(cv, r)
                        },
                        Nil -> (),
                    }
                }
            },
            None -> (),
        };
        cellSet(ai, cellGet(ai) + 1)
    };

    let globalValSet: StrMap Bool = strMapNew();
    let cd0 = cellNew(inf.defs);
    while (match cellGet(cd0) { Nil -> false, _ -> true }) {
        match cellGet(cd0) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> match f.node {
                        ExAbs(_, _, _) -> (),
                        _ -> strMapInsert(globalValSet, d.ident, true),
                    },
                    _ -> (),
                };
                cellSet(cd0, r)
            },
            Nil -> (),
        }
    };

    let ctx = MkKCtx {
        kCount: cellNew(0),
        kCurrentFn: cellNew(""),
        kLocalEnv: cellNew(Nil),
        kLocalDirect: cellNew(Nil),
        kPolyLifted: cellNew(Nil),
        kGlobalFns: strMapNew(),
        kAllFnNames: vecNew(),
        kGlobalValsRev: cellNew(Nil),
        kGlobalValSet: globalValSet,
        kExterns: strMapNew(),
        kExternNamesRev: cellNew(Nil),
        kTopDirect: strMapNew(),
        kLiftedClosures: strMapNew(),
        kAdtReg: inf.adtReg,
        kAdtNames: inf.adtNames,
        kCtorMap: ctorMap,
        kConceptReg: inf.conceptReg,
        kInstanceReg: inf.instanceReg,
        kConceptMethods: inf.conceptMethods,
        kContractMode: contractMode,
        kVerifiedFns: strMapNew(),
        kOrigFnNames: strMapNew(),
        kInstantiatedPoly: strMapNew(),
        kUnseededPolyRev: cellNew(Nil),
        kErr: cellNew(None),
    };

    let cExportsRev: Cell (List (String, String)) = cellNew(Nil);
    let ctorsRev: Cell (List (String, Int)) = cellNew(Nil);

    // Pre-register direct top-level functions & externs
    let cd1 = cellNew(inf.defs);
    while (match cellGet(cd1) { Nil -> false, _ -> true }) {
        match cellGet(cd1) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(_) ->
                        if (!strMapContains(globalValSet, d.ident)) {
                            strMapInsert(ctx.kTopDirect, d.ident, d.ident);
                            let ca = cellNew(d.attrs);
                            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                                match cellGet(ca) {
                                    Cons(AttrExport(symOpt), ra) -> {
                                        let cSym = match symOpt { Some(s) -> s, None -> d.ident };
                                        cellSet(cExportsRev, Cons((d.ident, cSym), cellGet(cExportsRev)));
                                        cellSet(ca, ra)
                                    },
                                    Cons(AttrCtor(prio), ra) -> {
                                        cellSet(ctorsRev, Cons((d.ident, prio), cellGet(ctorsRev)));
                                        cellSet(ca, ra)
                                    },
                                    Cons(AttrVerified, ra) -> {
                                        strMapInsert(ctx.kVerifiedFns, d.ident, true);
                                        cellSet(ca, ra)
                                    },
                                    Cons(_, ra) -> cellSet(ca, ra),
                                    Nil -> (),
                                }
                            }
                        } else (),
                    ItExtern(linkName, scm, noAlloc, isFnPtr) -> {
                        strMapInsert(ctx.kTopDirect, d.ident, d.ident);
                        strMapInsert(ctx.kExterns, d.ident, MkExternDef {
                            extName: d.ident,
                            extLink: linkName,
                            extTy: schemeBody(scm),
                            extNoAlloc: noAlloc,
                            extIsFnPtr: isFnPtr,
                        });
                        cellSet(ctx.kExternNamesRev, Cons(d.ident, cellGet(ctx.kExternNamesRev)))
                    },
                    _ -> (),
                };
                cellSet(cd1, r)
            },
            Nil -> (),
        }
    };

    // Convert each top-level `ItForm`
    let cd2 = cellNew(inf.defs);
    while (match cellGet(cd2) { Nil -> false, _ -> true }) {
        match cellGet(cd2) {
            Cons(d, r) -> {
                match d.item {
                    ItForm(f) -> {
                        cellSet(ctx.kCurrentFn, d.ident);
                        cellSet(ctx.kCount, 0);
                        match f.node {
                            ExAbs(ps, _, bd) -> {
                                let (lps, _, lbd) = transLambda(ctx, ps, bd, false);
                                let _ = defineFn(ctx, d.ident, d.dpos, f.ty, lps, Nil, lbd);
                                ()
                            },
                            _ -> {
                                let initTerm = transformForm(ctx, f);
                                cellSet(ctx.kGlobalValsRev, Cons(MkGlobalValDef {
                                    gvName: d.ident,
                                    gvSpan: d.dpos,
                                    gvTy: schemeBody(f.ty),
                                    gvInit: initTerm,
                                }, cellGet(ctx.kGlobalValsRev)))
                            },
                        }
                    },
                    _ -> (),
                };
                cellSet(cd2, r)
            },
            Nil -> (),
        }
    };

    match cellGet(ctx.kErr) {
        Some(emsg) -> Err(emsg),
        None -> {
            let (concreteFns0, concreteNames0, concreteGlobals0) = runMonomorphizationWorklist(ctx);
            match cellGet(ctx.kErr) {
                Some(emsg2) -> Err(emsg2),
                None -> {
                    let (concreteFns, concreteGlobals1) = lowerContractsInProgramFns(concreteFns0, concreteNames0, concreteGlobals0, ctx.kExterns, contractMode);
                    verifyConcurrentClosures(concreteFns, concreteNames0, concreteGlobals1, inf.adtReg)?;
                    let cExportList = listRev(cellGet(cExportsRev));
                    let (concreteNames, concreteGlobals) =
                        if (runInline && contractMode != "keep") {
                            let nextBinderId = cellNew(0);
                            let emptySkip: StrMap Bool = strMapNew();
                            let g2 = inlineTinyLeafFns(concreteFns, concreteNames0, concreteGlobals1, ctx.kExterns, nextBinderId);
                            let (ns3, g3) = optimizeCoreCombinators(
                                concreteFns, concreteNames0, g2, ctx.kExterns, ctorMap, cExportList, emptySkip, nextBinderId
                            );
                            let g4 = inlineTinyLeafFns(concreteFns, ns3, g3, ctx.kExterns, nextBinderId);
                            (ns3, g4)
                        } else (concreteNames0, concreteGlobals1);
                    verifyConcurrentClosures(concreteFns, concreteNames, concreteGlobals, inf.adtReg)?;
                    let escapeInfo =
                        if (runEscape) runEscapeAnalysis(concreteFns, concreteNames, ctx.kExterns, inf.adtReg, inf.adtNames)
                        else MkEscapeInfo {
                            escRecAdts: strMapNew(),
                            escFnStackVars: strMapNew(),
                            escFnHasStack: strMapNew(),
                        };

                    let adtNamesListRev: Cell (List String) = cellNew(Nil);
                    let anIdx = cellNew(0);
                    while (cellGet(anIdx) < vecLen(inf.adtNames)) {
                        cellSet(adtNamesListRev, Cons(vecGetOr(inf.adtNames, cellGet(anIdx), ""), cellGet(adtNamesListRev)));
                        cellSet(anIdx, cellGet(anIdx) + 1)
                    };

                    Ok(MkCoreProgram {
                        coreFns: concreteFns,
                        coreFnNames: concreteNames,
                        coreGlobals: concreteGlobals,
                        coreExterns: ctx.kExterns,
                        coreExternNames: sortUniqueStrings(cellGet(ctx.kExternNamesRev)),
                        coreCExports: cExportList,
                        coreCtors: listRev(cellGet(ctorsRev)),
                        coreAdtReg: inf.adtReg,
                        coreAdtNames: listRev(cellGet(adtNamesListRev)),
                        coreEscape: escapeInfo,
                        coreVerifiedFns: ctx.kVerifiedFns,
                        coreOrigFnNames: ctx.kOrigFnNames,
                        coreUnseededPolyFns: listRev(cellGet(ctx.kUnseededPolyRev)),
                    })
                },
            }
        },
    }
}

pub def lowerToCore(inf: InferOutput): Result CoreProgram String =
    lowerToCoreOptMode(inf, true, true, "erase")

pub def lowerToCoreOpt(inf: InferOutput, runEscape: Bool, runInline: Bool): Result CoreProgram String =
    lowerToCoreOptMode(inf, runEscape, runInline, "erase")

pub def lowerToCoreMode(inf: InferOutput, contractMode: String): Result CoreProgram String =
    lowerToCoreOptMode(inf, true, contractMode != "keep", contractMode)

pub def lowerToCoreForCheck(inf: InferOutput): Result Void String = {
    let _ = lowerToCoreOptMode(inf, false, false, "erase")?;
    Ok(())
}
