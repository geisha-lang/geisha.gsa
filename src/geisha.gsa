// Self-Hosting Geisha Compiler & Decentralized Package Driver (`geisha.gsa`).
//
// Notice: zero `mod.gsa` and zero top-level `mod xxx` declarations — all sibling
// compiler modules (`ast`, `lexer`, `parser`, `loader`, `infer`, `core`, `codegen`, `pkg`)
// are loaded on demand directly from `use` statements!

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend}
use std.buf.{bufNew, bufPushStr, bufPushByte, bufToString}
use std.str.{strStartsWith, strIndexOfByte, strJoin, intToStr}
use std.path.{pathStem, pathJoin, pathDirname}
use sys.env.{argCount, argAt, getEnv}
use sys.fs.{readFile, writeFile, removeFile, fileExists}
use sys.io.eprintLn
use sys.proc.{exit, shell}
use ast.addUniqueStr
use loader.{
    PkgSpec, MkPkgSpec,
    loadSingleSourceProgramWithPkgsNamed, loadProjectProgramWithPkgs
}
use infer.inferProgram
use core.lowerToCore
use core_dump.dumpCoreProgramSExpr
use codegen.emitProgramLlvmIrOpts
use doc.cmdDoc
use diag.isFormattedDiag
use guide_bundle.embeddedAgentGuide
use pkg.{
    NativeUnit, MkNativeUnit, TargetCfg, MkTargetCfg, CompileCallbacks, MkCompileCallbacks,
    shellQuote, geishaHomeDir, findProjectRoot, resolveProjectGraph, toLoaderPkgSpecs, resolveDefaultEntryFile,
    cmdInit, cmdAdd, cmdRemove, cmdFetch, cmdBuildProject, cmdRun, cmdTest
}

extern "gs_sys_host_os" def c_host_os(): Ptr
extern "gs_sys_host_arch" def c_host_arch(): Ptr
extern "gs_sys_exe_path" def c_exe_path(): Ptr

def currentHostOs(): String = {
    let p = c_host_os();
    if (ptrIsNull(p)) "posix" else ptrToString(p)
}

def currentHostArch(): String = {
    let p = c_host_arch();
    if (ptrIsNull(p)) "unknown" else ptrToString(p)
}

def currentExeDir(): String = {
    let p = c_exe_path();
    if (ptrIsNull(p)) pathDirname(argAt(0))
    else pathDirname(ptrToString(p))
}

data CliOpts {
    MkCliOpts {
        optSubcmd: Option String,
        optSubArgs: List String,
        optEmitIr: Bool,
        optDumpCore: Option String,
        optCompileOnly: Bool,
        optTarget: String,
        optExports: List String,
        optNoMain: Bool,
        optBootSym: Option String,
        optOutPath: Option String,
        optSrcRoot: Option String,
        optLibPaths: List String,
        optPkgFlags: List (String, String),
        optDepFlags: List (String, String, String),
        optRuntime: Option String,
        optInput: Option String,
        optJson: Bool,
        optHelp: Bool,
    },
}

def isSubcommandWord(w: String): Bool =
    w == "init"
    || w == "add"
    || w == "remove"
    || w == "fetch"
    || w == "update"
    || w == "build"
    || w == "check"
    || w == "run"
    || w == "test"
    || w == "doc"
    || w == "guide"

def parsePkgFlagSpec(spec: String): Result (String, String) String =
    match strIndexOfByte(spec, 61, 0) {
        Some(idx) if (idx > 0 && idx + 1 < strLen(spec)) ->
            Ok((strSlice(spec, 0, idx), strSlice(spec, idx + 1, strLen(spec)))),
        _ -> Err("invalid '--pkg' argument '" + spec + "' (expected '<id>=<src_dir>')"),
    }

def parseDepFlagSpec(spec: String): Result (String, String, String) String =
    match strIndexOfByte(spec, 61, 0) {
        Some(eqIdx) if (eqIdx > 0 && eqIdx + 1 < strLen(spec)) -> {
            let lhs = strSlice(spec, 0, eqIdx);
            let rhs = strSlice(spec, eqIdx + 1, strLen(spec));
            match strIndexOfByte(lhs, 58, 0) {
                Some(colIdx) ->
                    Ok((strSlice(lhs, 0, colIdx), strSlice(lhs, colIdx + 1, strLen(lhs)), rhs)),
                None ->
                    Ok(("", lhs, rhs)),
            }
        },
        _ -> Err("invalid '--dep' argument '" + spec + "' (expected '[from:]<alias>=<pkg_id>')"),
    }

def parseCliArgs(): Result CliOpts String = {
    let argc = argCount();
    if (argc >= 2 && isSubcommandWord(argAt(1))) {
        let sub = argAt(1);
        let emitIr = cellNew(false);
        let dumpCore: Cell (Option String) = cellNew(None);
        let compOnly = cellNew(false);
        let targetCell = cellNew("native");
        let exportsRev: Cell (List String) = cellNew(Nil);
        let noMain = cellNew(false);
        let bootSym: Cell (Option String) = cellNew(None);
        let outPath: Cell (Option String) = cellNew(None);
        let srcRoot: Cell (Option String) = cellNew(None);
        let libPathsRev: Cell (List String) = cellNew(Nil);
        let pkgFlagsRev: Cell (List (String, String)) = cellNew(Nil);
        let depFlagsRev: Cell (List (String, String, String)) = cellNew(Nil);
        let rtPath: Cell (Option String) = cellNew(None);
        let inPath: Cell (Option String) = cellNew(None);
        let jsonOut = cellNew(false);
        let showHelp = cellNew(false);
        let restArgsRev: Cell (List String) = cellNew(Nil);
        let afterDashDash = cellNew(false);
        let errOpt: Cell (Option String) = cellNew(None);

        let i = cellNew(2);
        while (cellGet(i) < argc && match cellGet(errOpt) { None -> true, Some(_) -> false }) {
            let a = argAt(cellGet(i));
            if (cellGet(afterDashDash) || sub == "init" || sub == "add" || sub == "remove" || sub == "fetch" || sub == "update" || sub == "doc" || sub == "guide") {
                if (!cellGet(afterDashDash) && (a == "-h" || a == "--help")) {
                    cellSet(showHelp, true)
                } else {
                    cellSet(restArgsRev, Cons(a, cellGet(restArgsRev)))
                };
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--") {
                cellSet(afterDashDash, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "-h" || a == "--help") {
                cellSet(showHelp, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--json") {
                cellSet(jsonOut, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "-e" || a == "--emit-llvm") {
                cellSet(emitIr, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "-c" || a == "--compile-only") {
                cellSet(compOnly, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--no-main") {
                cellSet(noMain, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--boot-sym") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing symbol after '--boot-sym'"))
                else { cellSet(bootSym, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "--dump-core") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing output path after '--dump-core'"))
                else { cellSet(dumpCore, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "--target") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing target name after '--target' (native | wasm32 | ios | ios-sim)"))
                else {
                    let t = argAt(cellGet(i) + 1);
                    if (t == "native" || t == "wasm32" || t == "ios" || t == "ios-sim") { cellSet(targetCell, t); cellSet(i, cellGet(i) + 2) }
                    else cellSet(errOpt, Some("Unsupported target '" + t + "' (expected 'native', 'wasm32', 'ios', or 'ios-sim')"))
                }
            } else if (a == "--export") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing function name after '--export'"))
                else { cellSet(exportsRev, Cons(argAt(cellGet(i) + 1), cellGet(exportsRev))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "-o" || a == "--output") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing argument after '" + a + "'"))
                else { cellSet(outPath, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "--src-root") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing directory after '--src-root'"))
                else { cellSet(srcRoot, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "-L" || a == "--lib-path") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing directory after '" + a + "'"))
                else { cellSet(libPathsRev, Cons(argAt(cellGet(i) + 1), cellGet(libPathsRev))); cellSet(i, cellGet(i) + 2) }
            } else if (strStartsWith(a, "-L") && strLen(a) > 2) {
                cellSet(libPathsRev, Cons(strSlice(a, 2, strLen(a)), cellGet(libPathsRev)));
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--pkg") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing '<id>=<dir>' after '--pkg'"))
                else {
                    match parsePkgFlagSpec(argAt(cellGet(i) + 1)) {
                        Ok(pair) -> cellSet(pkgFlagsRev, Cons(pair, cellGet(pkgFlagsRev))),
                        Err(e) -> cellSet(errOpt, Some(e)),
                    };
                    cellSet(i, cellGet(i) + 2)
                }
            } else if (a == "--dep") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing '[from:]<alias>=<id>' after '--dep'"))
                else {
                    match parseDepFlagSpec(argAt(cellGet(i) + 1)) {
                        Ok(triple) -> cellSet(depFlagsRev, Cons(triple, cellGet(depFlagsRev))),
                        Err(e) -> cellSet(errOpt, Some(e)),
                    };
                    cellSet(i, cellGet(i) + 2)
                }
            } else if (a == "--runtime") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing path after '--runtime'"))
                else { cellSet(rtPath, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if ((sub == "run" || sub == "check") && match cellGet(inPath) { None -> true, Some(_) -> false } && !strStartsWith(a, "-")) {
                cellSet(inPath, Some(a));
                cellSet(i, cellGet(i) + 1)
            } else {
                cellSet(restArgsRev, Cons(a, cellGet(restArgsRev)));
                cellSet(i, cellGet(i) + 1)
            }
        };

        match cellGet(errOpt) {
            Some(e) -> Err(e),
            None -> Ok(MkCliOpts {
                optSubcmd: Some(sub),
                optSubArgs: listRev(cellGet(restArgsRev)),
                optEmitIr: cellGet(emitIr),
                optDumpCore: cellGet(dumpCore),
                optCompileOnly: cellGet(compOnly),
                optTarget: cellGet(targetCell),
                optExports: listRev(cellGet(exportsRev)),
                optNoMain: cellGet(noMain),
                optBootSym: cellGet(bootSym),
                optOutPath: cellGet(outPath),
                optSrcRoot: cellGet(srcRoot),
                optLibPaths: listRev(cellGet(libPathsRev)),
                optPkgFlags: listRev(cellGet(pkgFlagsRev)),
                optDepFlags: listRev(cellGet(depFlagsRev)),
                optRuntime: cellGet(rtPath),
                optInput: cellGet(inPath),
                optJson: cellGet(jsonOut),
                optHelp: cellGet(showHelp),
            }),
        }
    } else {
        let emitIr = cellNew(false);
        let dumpCore: Cell (Option String) = cellNew(None);
        let compOnly = cellNew(false);
        let targetCell = cellNew("native");
        let exportsRev: Cell (List String) = cellNew(Nil);
        let noMain = cellNew(false);
        let bootSym: Cell (Option String) = cellNew(None);
        let outPath: Cell (Option String) = cellNew(None);
        let srcRoot: Cell (Option String) = cellNew(None);
        let libPathsRev: Cell (List String) = cellNew(Nil);
        let pkgFlagsRev: Cell (List (String, String)) = cellNew(Nil);
        let depFlagsRev: Cell (List (String, String, String)) = cellNew(Nil);
        let rtPath: Cell (Option String) = cellNew(None);
        let inPath: Cell (Option String) = cellNew(None);
        let showHelp = cellNew(false);
        let errOpt: Cell (Option String) = cellNew(None);

        let i = cellNew(1);
        while (cellGet(i) < argc && match cellGet(errOpt) { None -> true, Some(_) -> false }) {
            let a = argAt(cellGet(i));
            if (a == "-h" || a == "--help") {
                cellSet(showHelp, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "-e" || a == "--emit-llvm") {
                cellSet(emitIr, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--no-main") {
                cellSet(noMain, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--boot-sym") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing symbol name after '--boot-sym'"))
                else { cellSet(bootSym, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "--dump-core") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing output path after '--dump-core'"))
                else { cellSet(dumpCore, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "--target") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing target name after '--target' (native | wasm32 | ios | ios-sim)"))
                else {
                    let t = argAt(cellGet(i) + 1);
                    if (t == "native" || t == "wasm32" || t == "ios" || t == "ios-sim") { cellSet(targetCell, t); cellSet(i, cellGet(i) + 2) }
                    else cellSet(errOpt, Some("Unsupported target '" + t + "' (expected 'native', 'wasm32', 'ios', or 'ios-sim')"))
                }
            } else if (a == "--export") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing function name after '--export'"))
                else { cellSet(exportsRev, Cons(argAt(cellGet(i) + 1), cellGet(exportsRev))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "-c" || a == "--compile-only") {
                cellSet(compOnly, true);
                cellSet(i, cellGet(i) + 1)
            } else if (a == "-o" || a == "--output") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing argument after '" + a + "'"))
                else { cellSet(outPath, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "--src-root") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing directory after '--src-root'"))
                else { cellSet(srcRoot, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (a == "-L" || a == "--lib-path") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing directory after '" + a + "'"))
                else { cellSet(libPathsRev, Cons(argAt(cellGet(i) + 1), cellGet(libPathsRev))); cellSet(i, cellGet(i) + 2) }
            } else if (strStartsWith(a, "-L") && strLen(a) > 2) {
                cellSet(libPathsRev, Cons(strSlice(a, 2, strLen(a)), cellGet(libPathsRev)));
                cellSet(i, cellGet(i) + 1)
            } else if (a == "--pkg") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing '<id>=<dir>' after '--pkg'"))
                else {
                    match parsePkgFlagSpec(argAt(cellGet(i) + 1)) {
                        Ok(pair) -> cellSet(pkgFlagsRev, Cons(pair, cellGet(pkgFlagsRev))),
                        Err(e) -> cellSet(errOpt, Some(e)),
                    };
                    cellSet(i, cellGet(i) + 2)
                }
            } else if (a == "--dep") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing '[from:]<alias>=<id>' after '--dep'"))
                else {
                    match parseDepFlagSpec(argAt(cellGet(i) + 1)) {
                        Ok(triple) -> cellSet(depFlagsRev, Cons(triple, cellGet(depFlagsRev))),
                        Err(e) -> cellSet(errOpt, Some(e)),
                    };
                    cellSet(i, cellGet(i) + 2)
                }
            } else if (a == "--runtime") {
                if (cellGet(i) + 1 >= argc) cellSet(errOpt, Some("Missing archive path after '--runtime'"))
                else { cellSet(rtPath, Some(argAt(cellGet(i) + 1))); cellSet(i, cellGet(i) + 2) }
            } else if (strLen(a) > 0 && strByteAt(a, 0) == 45) {
                cellSet(errOpt, Some("Unknown option: '" + a + "'"))
            } else {
                cellSet(inPath, Some(a));
                cellSet(i, cellGet(i) + 1)
            }
        };

        match cellGet(errOpt) {
            Some(e) -> Err(e),
            None -> Ok(MkCliOpts {
                optSubcmd: None,
                optSubArgs: Nil,
                optEmitIr: cellGet(emitIr),
                optDumpCore: cellGet(dumpCore),
                optCompileOnly: cellGet(compOnly),
                optTarget: cellGet(targetCell),
                optExports: listRev(cellGet(exportsRev)),
                optNoMain: cellGet(noMain),
                optBootSym: cellGet(bootSym),
                optOutPath: cellGet(outPath),
                optSrcRoot: cellGet(srcRoot),
                optLibPaths: listRev(cellGet(libPathsRev)),
                optPkgFlags: listRev(cellGet(pkgFlagsRev)),
                optDepFlags: listRev(cellGet(depFlagsRev)),
                optRuntime: cellGet(rtPath),
                optInput: cellGet(inPath),
                optJson: false,
                optHelp: cellGet(showHelp),
            }),
        }
    }
}

def resolveWasmRuntimeObj(explicitOpt: Option String): Result String String =
    match explicitOpt {
        Some(p) ->
            if (fileExists(p)) Ok(p)
            else Err("WASM runtime object not found at '" + p + "'"),
        None -> match getEnv("GEISHA_WASM_RUNTIME") {
            Some(envP) ->
                if (fileExists(envP)) Ok(envP)
                else Err("GEISHA_WASM_RUNTIME object not found at '" + envP + "'"),
            None -> {
                let exeDir = currentExeDir();
                let cand1 = pathJoin(exeDir, "wasm_rt.o");
                let cand2 = pathJoin(pathDirname(exeDir), "lib/wasm_rt.o");
                let cand3 = pathJoin(pathDirname(exeDir), "build/wasm_rt.o");
                let cand4 = "build/wasm_rt.o";
                let cand5 = pathJoin(geishaHomeDir(), "lib/wasm_rt.o");
                if (fileExists(cand1)) Ok(cand1)
                else if (fileExists(cand2)) Ok(cand2)
                else if (fileExists(cand3)) Ok(cand3)
                else if (fileExists(cand4)) Ok(cand4)
                else if (fileExists(cand5)) Ok(cand5)
                else Err("Could not locate wasm_rt.o; run 'make wasm-runtime' or 'make install', or pass --runtime <path>")
            },
        },
    }

def resolveWasmCc(): String =
    match getEnv("WASM_CC") {
        Some(c) if (strLen(c) > 0) -> c,
        _ ->
            if (fileExists("/opt/homebrew/opt/llvm/bin/clang")) "/opt/homebrew/opt/llvm/bin/clang"
            else if (fileExists("/opt/homebrew/opt/llvm@20/bin/clang")) "/opt/homebrew/opt/llvm@20/bin/clang"
            else if (fileExists("/usr/local/opt/llvm/bin/clang")) "/usr/local/opt/llvm/bin/clang"
            else if (fileExists("/usr/local/opt/llvm@20/bin/clang")) "/usr/local/opt/llvm@20/bin/clang"
            else if (fileExists("/usr/lib/llvm-20/bin/clang")) "/usr/lib/llvm-20/bin/clang"
            else if (fileExists("/usr/bin/clang-20")) "/usr/bin/clang-20"
            else "clang",
    }

def resolveWasmLdFlag(): String =
    match getEnv("WASM_LD") {
        Some(l) if (strLen(l) > 0) -> " -fuse-ld=" + shellQuote(l),
        _ ->
            if (fileExists("/opt/homebrew/opt/lld/bin/wasm-ld")) " -fuse-ld=/opt/homebrew/opt/lld/bin/wasm-ld"
            else if (fileExists("/opt/homebrew/opt/lld@20/bin/wasm-ld")) " -fuse-ld=/opt/homebrew/opt/lld@20/bin/wasm-ld"
            else if (fileExists("/usr/local/opt/lld/bin/wasm-ld")) " -fuse-ld=/usr/local/opt/lld/bin/wasm-ld"
            else if (fileExists("/usr/local/opt/lld@20/bin/wasm-ld")) " -fuse-ld=/usr/local/opt/lld@20/bin/wasm-ld"
            else if (fileExists("/usr/lib/llvm-20/bin/wasm-ld")) " -fuse-ld=/usr/lib/llvm-20/bin/wasm-ld"
            else "",
    }

def resolveNativeCc(): String =
    match getEnv("CC") {
        Some(c) if (strLen(c) > 0) -> c,
        _ -> "clang",
    }

def nativeEnvPrefix(): String =
    if (currentHostOs() == "macos") "MACOSX_DEPLOYMENT_TARGET=14.0 " else ""

def nativeTargetFlag(): String =
    if (currentHostOs() == "macos") {
        let arch = currentHostArch();
        if (arch == "arm64") " -target arm64-apple-macosx14.0"
        else if (arch == "x86_64") " -target x86_64-apple-macosx14.0"
        else ""
    } else ""

def nativeSysLibs(): String =
    if (currentHostOs() == "macos") "" else " -lm"

def resolveRuntimeArchive(explicitOpt: Option String): Result String String =
    match explicitOpt {
        Some(p) ->
            if (fileExists(p)) Ok(p)
            else Err("Runtime archive not found at '" + p + "'"),
        None -> match getEnv("GEISHA_RUNTIME") {
            Some(envP) ->
                if (fileExists(envP)) Ok(envP)
                else Err("GEISHA_RUNTIME archive not found at '" + envP + "'"),
            None -> {
                let exeDir = currentExeDir();
                let cand1 = pathJoin(exeDir, "libgeisha_runtime.a");
                let cand2 = pathJoin(pathDirname(exeDir), "lib/libgeisha_runtime.a");
                let cand3 = pathJoin(pathDirname(exeDir), "build/libgeisha_runtime.a");
                let cand4 = "build/libgeisha_runtime.a";
                let cand5 = pathJoin(geishaHomeDir(), "lib/libgeisha_runtime.a");
                if (fileExists(cand1)) Ok(cand1)
                else if (fileExists(cand2)) Ok(cand2)
                else if (fileExists(cand3)) Ok(cand3)
                else if (fileExists(cand4)) Ok(cand4)
                else if (fileExists(cand5)) Ok(cand5)
                else Err("Could not locate libgeisha_runtime.a; run 'make install', pass --runtime <path>, or set GEISHA_RUNTIME")
            },
        },
    }

def shellQuoteArgs(xs: List String): String = {
    let parts = cellNew(Nil);
    let cur = cellNew(xs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(h, r) -> {
                cellSet(parts, listAppend(cellGet(parts), [shellQuote(h)]));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    match cellGet(parts) {
        Nil -> "",
        ps -> " " + strJoin(ps, " "),
    }
}

def maybeDumpCoreIr(coreProg: core.CoreProgram, dumpCoreOpt: Option String): Result Void String =
    match dumpCoreOpt {
        Some(dumpPath) -> {
            let sexp = dumpCoreProgramSExpr(coreProg)?;
            writeFile(dumpPath, sexp)
        },
        None -> Ok(()),
    }

def compileLoadedDefsToIr(
    rawDefs: List ast.Def,
    dumpCoreOpt: Option String,
    isWasm: Bool,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String
): Result String String = {
    let inf = inferProgram(rawDefs)?;
    let coreProg = lowerToCore(inf)?;
    maybeDumpCoreIr(coreProg, dumpCoreOpt)?;
    Ok(emitProgramLlvmIrOpts(coreProg, isWasm, exports, noMain, bootSymOpt))
}

def buildCliPkgGraph(
    entryFile: String,
    srcRootOpt: Option String,
    pkgFlags: List (String, String),
    depFlags: List (String, String, String)
): (PkgSpec, List PkgSpec) = {
    let depsFor = (ownerId: String) -> {
        let acc = cellNew(Nil);
        let cd = cellNew(depFlags);
        while (match cellGet(cd) { Nil -> false, _ -> true }) {
            match cellGet(cd) {
                Cons((fromId, al, toId), r) -> {
                    if (fromId == ownerId) cellSet(acc, listAppend(cellGet(acc), [(al, toId)])) else ();
                    cellSet(cd, r)
                },
                Nil -> (),
            }
        };
        cellGet(acc)
    };

    let rootDirs = match srcRootOpt {
        Some(sr) -> {
            let ed = pathDirname(entryFile);
            let ds = cellNew(Nil);
            if (ed != "" && ed != ".") cellSet(ds, addUniqueStr(cellGet(ds), ed)) else ();
            if (sr != "") cellSet(ds, addUniqueStr(cellGet(ds), sr)) else ();
            match cellGet(ds) { Nil -> ["."], xs -> xs }
        },
        None -> Nil,
    };

    // If `--pkg` was given without explicit `--dep`, expose `--pkg <id>=<dir>` to root by `<id>`!
    let explicitRootDeps = depsFor("");
    let autoRootDeps = {
        let acc = cellNew(explicitRootDeps);
        let cp = cellNew(pkgFlags);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons((pid, _), r) -> {
                    let alreadyBound = {
                        let c = cellNew(cellGet(acc));
                        let found = cellNew(false);
                        while (match cellGet(c) { Nil -> false, _ -> !cellGet(found) }) {
                            match cellGet(c) {
                                Cons((_, tid), rc) -> { if (tid == pid) cellSet(found, true) else (); cellSet(c, rc) },
                                Nil -> (),
                            }
                        };
                        cellGet(found)
                    };
                    if (!alreadyBound) cellSet(acc, listAppend(cellGet(acc), [(pid, pid)])) else ();
                    cellSet(cp, r)
                },
                Nil -> (),
            }
        };
        cellGet(acc)
    };

    let extSpecs = cellNew(Nil);
    let cp2 = cellNew(pkgFlags);
    while (match cellGet(cp2) { Nil -> false, _ -> true }) {
        match cellGet(cp2) {
            Cons((pid, pdir), r) -> {
                cellSet(extSpecs, listAppend(cellGet(extSpecs), [MkPkgSpec {
                    pkgId: pid,
                    pkgName: pid,
                    srcRoots: [pdir],
                    deps: depsFor(pid),
                }]));
                cellSet(cp2, r)
            },
            Nil -> (),
        }
    };

    let rootSpec = MkPkgSpec {
        pkgId: "",
        pkgName: "",
        srcRoots: rootDirs,
        deps: autoRootDeps,
    };
    (rootSpec, cellGet(extSpecs))
}

def compileWithPkgSpecsToIr(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String,
    dumpCoreOpt: Option String,
    isWasm: Bool,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String
): Result String String = {
    let rawDefs =
        if (useProjectLoader) {
            loadProjectProgramWithPkgs(entryFile, rootSpec, extSpecs, libPaths)?
        } else {
            let src = readFile(entryFile)?;
            loadSingleSourceProgramWithPkgsNamed(entryFile, src, rootSpec, extSpecs, libPaths)?
        };
    compileLoadedDefsToIr(rawDefs, dumpCoreOpt, isWasm, exports, noMain, bootSymOpt)
}

def jsonEscapeStr(s: String): String = {
    let b = bufNew();
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let ch = strByteAt(s, idx);
        if (ch == 34) bufPushStr(b, "\\\"")
        else if (ch == 92) bufPushStr(b, "\\\\")
        else if (ch == 10) bufPushStr(b, "\\n")
        else if (ch == 13) bufPushStr(b, "\\r")
        else if (ch == 9) bufPushStr(b, "\\t")
        else bufPushByte(b, ch);
        cellSet(i, idx + 1)
    };
    bufToString(b)
}

def checkProgramFrontEnd(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String
): Result Void String = {
    let rawDefs =
        if (useProjectLoader) {
            loadProjectProgramWithPkgs(entryFile, rootSpec, extSpecs, libPaths)?
        } else {
            let src = readFile(entryFile)?;
            loadSingleSourceProgramWithPkgsNamed(entryFile, src, rootSpec, extSpecs, libPaths)?
        };
    let inf = inferProgram(rawDefs)?;
    let _ = lowerToCore(inf)?;
    Ok(())
}

def runCheckSubcmd(opts: CliOpts): Result Int String = {
    let (entryLabel, res) = match opts.optInput {
        Some(inputFile) -> {
            let useProjLoader = match opts.optSrcRoot { Some(_) -> true, None -> false };
            let (rootSpec, extSpecs) = buildCliPkgGraph(inputFile, opts.optSrcRoot, opts.optPkgFlags, opts.optDepFlags);
            (inputFile, checkProgramFrontEnd(inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths))
        },
        None -> match findProjectRoot(".") {
            None -> ("<project>", Err("no geisha.toml found and no .gsa file specified (usage: geisha check [file.gsa] [--json])")),
            Some(projDir) -> match resolveProjectGraph(projDir, false, None, true) {
                Err(e) -> (projDir, Err(e)),
                Ok((rootMf, rootSpec, resolvedPkgs)) -> match resolveDefaultEntryFile(projDir, rootMf) {
                    Err(e) -> (projDir, Err(e)),
                    Ok(entryFile) -> {
                        let extSpecs = toLoaderPkgSpecs(resolvedPkgs);
                        (entryFile, checkProgramFrontEnd(entryFile, true, rootSpec, extSpecs, opts.optLibPaths))
                    },
                },
            },
        },
    };
    if (opts.optJson) {
        match res {
            Ok(_) -> {
                printLn("{\"ok\":true,\"file\":\"" + jsonEscapeStr(entryLabel) + "\"}");
                Ok(0)
            },
            Err(msg) -> {
                printLn("{\"ok\":false,\"file\":\"" + jsonEscapeStr(entryLabel) + "\",\"error\":\"" + jsonEscapeStr(msg) + "\"}");
                Ok(1)
            },
        }
    } else {
        match res {
            Ok(_) -> {
                printLn("OK: " + entryLabel);
                Ok(0)
            },
            Err(msg) -> Err(msg),
        }
    }
}

def emitNativeExecutableFromIr(
    llText: String,
    outBin: String,
    tc: TargetCfg,
    rtOverrideOpt: Option String
): Result Void String = {
    let rtArchive = resolveRuntimeArchive(rtOverrideOpt)?;
    let ccBin = shellQuote(resolveNativeCc());
    let envPfx = nativeEnvPrefix();
    let targetArchFlag = nativeTargetFlag();
    let sysLibs = nativeSysLibs();
    let tmpLl = outBin + ".tmp.ll";
    writeFile(tmpLl, llText)?;

    // Compile any extra native compiler units (e.g. `compiler = "nvcc"` from `[[target.native.when]]`)
    let extraObjs: Cell (List String) = cellNew(Nil);
    let extraErr: Cell (Option String) = cellNew(None);
    let uIdx = cellNew(0);
    let cu = cellNew(tc.tcExtraUnits);
    while (match cellGet(extraErr) { None -> true, Some(_) -> false } && match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons(u, ru) -> {
                let cs = cellNew(u.nuSources);
                while (match cellGet(extraErr) { None -> true, Some(_) -> false } && match cellGet(cs) { Nil -> false, _ -> true }) {
                    match cellGet(cs) {
                        Cons(srcPath, rs) -> {
                            let objPath = outBin + ".unit" + intToStr(cellGet(uIdx)) + ".tmp.o";
                            cellSet(uIdx, cellGet(uIdx) + 1);
                            let cmdU =
                                envPfx + shellQuote(u.nuCompiler)
                                + shellQuoteArgs(u.nuFlags)
                                + " -c " + shellQuote(srcPath)
                                + " -o " + shellQuote(objPath);
                            let rcu = shell(cmdU);
                            if (rcu != 0) {
                                cellSet(extraErr, Some("Native compiler '" + u.nuCompiler + "' failed on '" + srcPath + "'"))
                            } else {
                                cellSet(extraObjs, listAppend(cellGet(extraObjs), [objPath]))
                            };
                            cellSet(cs, rs)
                        },
                        Nil -> (),
                    }
                };
                cellSet(cu, ru)
            },
            Nil -> (),
        }
    };
    let cleanupExtraObjs = () -> {
        let co = cellNew(cellGet(extraObjs));
        while (match cellGet(co) { Nil -> false, _ -> true }) {
            match cellGet(co) {
                Cons(op, ro) -> { let _ = removeFile(op); cellSet(co, ro) },
                Nil -> (),
            }
        }
    };
    match cellGet(extraErr) {
        Some(emsg) -> {
            let _ = removeFile(tmpLl);
            cleanupExtraObjs();
            Err(emsg)
        },
        None -> match (tc.tcCSources, cellGet(extraObjs)) {
            (Nil, Nil) -> {
                let cmd =
                    envPfx + ccBin + targetArchFlag
                    + " -O2 -Wno-override-module -pthread -x ir "
                    + shellQuote(tmpLl) + " -x none " + shellQuote(rtArchive)
                    + shellQuoteArgs(tc.tcLinkFlags)
                    + sysLibs
                    + " -o " + shellQuote(outBin);
                let rc = shell(cmd);
                let _ = removeFile(tmpLl);
                if (rc == 0) Ok(())
                else Err("C/LLVM backend failed while linking executable '" + outBin + "'")
            },
            (cSrcs, eObjs) -> {
                // Compile IR to `.o` first so Objective-C / C host files compile cleanly without `-flto=thin` ObjC clashes
                let tmpObj = outBin + ".gsa.tmp.o";
                let cmdIr =
                    envPfx + ccBin + targetArchFlag
                    + " -O2 -Wno-override-module -x ir -c "
                    + shellQuote(tmpLl) + " -o " + shellQuote(tmpObj);
                let rc1 = shell(cmdIr);
                let _ = removeFile(tmpLl);
                if (rc1 != 0) {
                    let _ = removeFile(tmpObj);
                    cleanupExtraObjs();
                    Err("C/LLVM backend failed while compiling Geisha IR object for '" + outBin + "'")
                } else {
                    let cmdLink =
                        envPfx + ccBin + targetArchFlag
                        + " -O2 -pthread"
                        + shellQuoteArgs(tc.tcCFlags)
                        + shellQuoteArgs(cSrcs)
                        + shellQuoteArgs(eObjs)
                        + " " + shellQuote(tmpObj)
                        + " " + shellQuote(rtArchive)
                        + shellQuoteArgs(tc.tcLinkFlags)
                        + sysLibs
                        + " -o " + shellQuote(outBin);
                    let rc2 = shell(cmdLink);
                    let _ = removeFile(tmpObj);
                    cleanupExtraObjs();
                    if (rc2 == 0) Ok(())
                    else Err("C/LLVM backend failed while linking native host & executable '" + outBin + "'")
                }
            },
        },
    }
}

def emitTargetObjFromIr(llText: String, outObj: String, target: String): Result Void String = {
    let tmpLl = outObj + ".tmp.ll";
    writeFile(tmpLl, llText)?;
    let cmd =
        if (target == "ios") {
            "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=16.0 "
            + "xcrun --sdk iphoneos clang -target arm64-apple-ios16.0 -O2 -Wno-override-module -x ir -c "
            + shellQuote(tmpLl) + " -o " + shellQuote(outObj)
        } else if (target == "ios-sim") {
            "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=16.0 "
            + "xcrun --sdk iphonesimulator clang -target arm64-apple-ios16.0-simulator -O2 -Wno-override-module -x ir -c "
            + shellQuote(tmpLl) + " -o " + shellQuote(outObj)
        } else {
            let ccBin = shellQuote(resolveNativeCc());
            nativeEnvPrefix() + ccBin + nativeTargetFlag()
            + " -O2 -Wno-override-module -x ir -c "
            + shellQuote(tmpLl) + " -o " + shellQuote(outObj)
        };
    let rc = shell(cmd);
    let _ = removeFile(tmpLl);
    if (rc == 0) Ok(())
    else Err("C/LLVM backend failed while compiling object '" + outObj + "' for target '" + target + "'")
}

def emitNativeObjFromIr(llText: String, outObj: String): Result Void String =
    emitTargetObjFromIr(llText, outObj, "native")

def resolveRuntimeArchiveForTarget(target: String, rtOverrideOpt: Option String): Result String String =
    match rtOverrideOpt {
        Some(p) -> Ok(p),
        None ->
            if (target == "ios") {
                let c1 = "build/libgeisha_runtime_ios.a";
                let c2 = pathJoin(geishaHomeDir(), "lib/libgeisha_runtime_ios.a");
                if (fileExists(c1)) Ok(c1)
                else if (fileExists(c2)) Ok(c2)
                else Err("iOS runtime archive not found (run 'make runtime-ios' or pass '--runtime <path>')")
            } else if (target == "ios-sim") {
                let c1 = "build/libgeisha_runtime_ios_sim.a";
                let c2 = pathJoin(geishaHomeDir(), "lib/libgeisha_runtime_ios_sim.a");
                if (fileExists(c1)) Ok(c1)
                else if (fileExists(c2)) Ok(c2)
                else Err("iOS Simulator runtime archive not found (run 'make runtime-ios-sim' or pass '--runtime <path>')")
            } else {
                resolveRuntimeArchive(None)
            },
    }

def strEndsWithA(s: String): Bool = {
    let n = strLen(s);
    n >= 2 && strByteAt(s, n - 2) == 46 && strByteAt(s, n - 1) == 97
}

def emitStaticLibFromIr(
    llText: String,
    outArchive: String,
    target: String,
    rtOverrideOpt: Option String
): Result Void String = {
    let rtArchive = resolveRuntimeArchiveForTarget(target, rtOverrideOpt)?;
    let tmpObj = outArchive + ".gsa.tmp.o";
    emitTargetObjFromIr(llText, tmpObj, target)?;
    let cmd =
        if (currentHostOs() == "macos") {
            "libtool -static -o " + shellQuote(outArchive) + " " + shellQuote(tmpObj) + " " + shellQuote(rtArchive)
        } else {
            "rm -f " + shellQuote(outArchive)
            + " && printf 'CREATE %s\\nADDLIB %s\\nADDMOD %s\\nSAVE\\nEND\\n' "
            + shellQuote(outArchive) + " " + shellQuote(rtArchive) + " " + shellQuote(tmpObj)
            + " | ar -M"
        };
    let rc = shell(cmd);
    let _ = removeFile(tmpObj);
    if (rc == 0) Ok(())
    else Err("archiver failed while creating static library '" + outArchive + "'")
}

def emitWasmFromIr(
    llText: String,
    outPath: String,
    compileOnly: Bool,
    tc: TargetCfg,
    rtOverrideOpt: Option String
): Result Void String = {
    let wasmCc = resolveWasmCc();
    if (compileOnly) {
        let tmpLl = outPath + ".tmp.ll";
        writeFile(tmpLl, llText)?;
        let cmd =
            shellQuote(wasmCc) + " --target=wasm32 -O2 -mbulk-memory -mnontrapping-fptoint -Wno-override-module -nostdlib -x ir -c "
            + shellQuote(tmpLl) + " -o " + shellQuote(outPath);
        let rc = shell(cmd);
        let _ = removeFile(tmpLl);
        if (rc == 0) Ok(())
        else Err("LLVM wasm32 backend failed while compiling object '" + outPath + "'")
    } else {
        let wasmRt = resolveWasmRuntimeObj(rtOverrideOpt)?;
        let tmpLl = outPath + ".tmp.ll";
        writeFile(tmpLl, llText)?;
        let cmd =
            shellQuote(wasmCc)
            + " --target=wasm32 -O2 -mbulk-memory -mnontrapping-fptoint -Wno-override-module -nostdlib"
            + resolveWasmLdFlag()
            + shellQuoteArgs(tc.tcCFlags)
            + " -x ir " + shellQuote(tmpLl) + " -x none " + shellQuote(wasmRt)
            + shellQuoteArgs(tc.tcCSources)
            + shellQuoteArgs(tc.tcLinkFlags)
            + " -Wl,--no-entry -Wl,--export-dynamic -Wl,--allow-undefined -Wl,--gc-sections -o "
            + shellQuote(outPath);
        let rc = shell(cmd);
        let _ = removeFile(tmpLl);
        if (rc == 0) Ok(())
        else Err("LLVM wasm32 backend failed while linking '" + outPath + "' (ensure lld/wasm-ld is installed)")
    }
}

def makeCompileCallbacks(): CompileCallbacks = MkCompileCallbacks {
    cbCompileNativeExe: (entryFile, rootSpec, extSpecs, tc, outOpt, dumpCoreOpt, rtOpt) -> {
        let llText = compileWithPkgSpecsToIr(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            false, tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol
        )?;
        let outBin = match outOpt { Some(p) -> p, None -> pathStem(entryFile) };
        emitNativeExecutableFromIr(llText, outBin, tc, rtOpt)
    },
    cbCompileNativeObj: (entryFile, rootSpec, extSpecs, tc, outOpt, dumpCoreOpt) -> {
        let llText = compileWithPkgSpecsToIr(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            false, tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol
        )?;
        let outObj = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + ".o" };
        emitNativeObjFromIr(llText, outObj)
    },
    cbCompileWasm: (entryFile, rootSpec, extSpecs, tc, compOnly, outOpt, dumpCoreOpt, rtOpt) -> {
        let llText = compileWithPkgSpecsToIr(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            true, tc.tcExports, false, None
        )?;
        let outWasm = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + (if (compOnly) ".o" else ".wasm") };
        emitWasmFromIr(llText, outWasm, compOnly, tc, rtOpt)
    },
    cbEmitIr: (entryFile, rootSpec, extSpecs, tc, isWasm, outOpt, dumpCoreOpt) -> {
        let llText = compileWithPkgSpecsToIr(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            isWasm, tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol
        )?;
        match outOpt {
            Some(outLl) -> writeFile(outLl, llText),
            None -> {
                printLn(llText);
                Ok(())
            },
        }
    },
}

def printUsage(): Void = {
    printLn("geisha — Self-hosting Geisha compiler & decentralized package manager");
    printLn("");
    printLn("Package & Project Commands (reads geisha.toml):");
    printLn("  geisha init [--lib] [dir]      Initialize a new Geisha package or library");
    printLn("  geisha add <pkg|git-url>       Add dependency (MVS tag/rev + geisha.lock)");
    printLn("         [--version <v>] [--rev <r>] [--path <dir>] [--subdir <s>] [--as <name>]");
    printLn("  geisha remove <alias>          Remove dependency from geisha.toml");
    printLn("  geisha fetch                   Materialize dependencies into ~/.geisha/cache");
    printLn("  geisha update [alias]          Re-resolve remote tags/revs and update geisha.lock");
    printLn("  geisha build [options]         Compile current geisha.toml project");
    printLn("  geisha check [file.gsa]        Fast frontend type/exhaustiveness/Send check (--json)");
    printLn("  geisha run [file.gsa] [-- ..]  Build & run current project or standalone .gsa file");
    printLn("  geisha test                    Build & run project test suite (tests/*.gsa)");
    printLn("  geisha doc [module|file]       List modules or print public API signatures (--all)");
    printLn("  geisha guide                   Print compact Geisha language & pitfall guide for Agents");
    printLn("");
    printLn("Direct Compiler Usage:");
    printLn("  geisha [options] <input.gsa>");
    printLn("");
    printLn("Compiler Options:");
    printLn("  -e, --emit-llvm                Emit LLVM 20 textual IR (.ll) to stdout or -o <file.ll>");
    printLn("  --dump-core <file>             Dump Core Geisha S-expression IR (.gscore) for Lean 4 verifier");
    printLn("  --target <native|wasm32>       Target platform (default: 'native')");
    printLn("  --export <fn>                  Export function symbol on native or wasm32 (repeatable)");
    printLn("  --no-main                      Omit C main() wrapper (for custom native host entry)");
    printLn("  --boot-sym <sym>               Emit custom native global initializer symbol");
    printLn("  -c, --compile-only             Compile to object file (.o) without linking");
    printLn("  -o <output>                    Write output to <output>");
    printLn("  --src-root <dir>               Multi-file module source root directory");
    printLn("  --pkg <id>=<dir>               Register scoped external package root");
    printLn("  --dep [from:]<alias>=<id>      Bind explicit package dependency alias");
    printLn("  -L, --lib-path <dir>           Legacy external module search path (repeatable)");
    printLn("  --runtime <path>               Path to libgeisha_runtime.a or wasm_rt.o");
    printLn("  -h, --help                     Show this help message")
}

def runDriver(): Result Int String = {
    let opts = parseCliArgs()?;
    if (opts.optHelp) {
        printUsage();
        Ok(0)
    } else {
        let cbs = makeCompileCallbacks();
        match opts.optSubcmd {
            Some("init") -> { cmdInit(opts.optSubArgs)?; Ok(0) },
            Some("add") -> { cmdAdd(opts.optSubArgs)?; Ok(0) },
            Some("remove") -> { cmdRemove(opts.optSubArgs)?; Ok(0) },
            Some("fetch") -> { cmdFetch(false, opts.optSubArgs)?; Ok(0) },
            Some("update") -> { cmdFetch(true, opts.optSubArgs)?; Ok(0) },
            Some("build") -> {
                let projDir = match findProjectRoot(".") {
                    Some(d) -> d,
                    None -> returnDriverErr("no geisha.toml found in current or parent directories")?,
                };
                let _ = cmdBuildProject(
                    projDir,
                    opts.optTarget,
                    opts.optEmitIr,
                    opts.optCompileOnly,
                    opts.optOutPath,
                    opts.optDumpCore,
                    opts.optRuntime,
                    opts.optExports,
                    opts.optNoMain,
                    opts.optBootSym,
                    None,
                    cbs
                )?;
                Ok(0)
            },
            Some("check") -> runCheckSubcmd(opts),
            Some("run") -> cmdRun(opts.optSubArgs, opts.optInput, opts.optRuntime, cbs),
            Some("test") -> { cmdTest(opts.optRuntime, cbs)?; Ok(0) },
            Some("doc") -> { cmdDoc(opts.optSubArgs)?; Ok(0) },
            Some("guide") -> { printLn(embeddedAgentGuide()); Ok(0) },
            Some(other) -> Err("unknown subcommand: " + other),
            None -> {
                let inputFile = match opts.optInput {
                    Some(p) -> p,
                    None -> returnDriverErr("No input .gsa file specified (run 'geisha --help' for usage)")?,
                };
                let isWasm = opts.optTarget == "wasm32";
                let useProjLoader = match opts.optSrcRoot { Some(_) -> true, None -> false };
                let (rootSpec, extSpecs) = buildCliPkgGraph(inputFile, opts.optSrcRoot, opts.optPkgFlags, opts.optDepFlags);
                let llText = compileWithPkgSpecsToIr(
                    inputFile,
                    useProjLoader,
                    rootSpec,
                    extSpecs,
                    opts.optLibPaths,
                    opts.optDumpCore,
                    isWasm,
                    opts.optExports,
                    opts.optNoMain,
                    opts.optBootSym
                )?;
                let plainTc = MkTargetCfg {
                    tcCSources: Nil,
                    tcCFlags: Nil,
                    tcLinkFlags: Nil,
                    tcExtraUnits: Nil,
                    tcExports: opts.optExports,
                    tcWebAssets: Nil,
                    tcOwnsMain: opts.optNoMain,
                    tcBootSymbol: opts.optBootSym,
                };
                if (opts.optEmitIr) {
                    match opts.optOutPath {
                        Some(outLl) -> { writeFile(outLl, llText)?; Ok(0) },
                        None -> { printLn(llText); Ok(0) },
                    }
                } else if (isWasm) {
                    let outP = match opts.optOutPath {
                        Some(p) -> p,
                        None -> pathStem(inputFile) + (if (opts.optCompileOnly) ".o" else ".wasm"),
                    };
                    emitWasmFromIr(llText, outP, opts.optCompileOnly, plainTc, opts.optRuntime)?;
                    Ok(0)
                } else if (opts.optCompileOnly) {
                    let outObj = match opts.optOutPath {
                        Some(p) -> p,
                        None -> pathStem(inputFile) + ".o",
                    };
                    emitTargetObjFromIr(llText, outObj, opts.optTarget)?;
                    Ok(0)
                } else if (opts.optTarget == "ios" || opts.optTarget == "ios-sim" || (opts.optNoMain && match opts.optOutPath { Some(p) -> strEndsWithA(p), None -> false })) {
                    let outArc = match opts.optOutPath {
                        Some(p) -> p,
                        None -> "lib" + pathStem(inputFile) + ".a",
                    };
                    emitStaticLibFromIr(llText, outArc, opts.optTarget, opts.optRuntime)?;
                    Ok(0)
                } else {
                    let outBin = match opts.optOutPath {
                        Some(p) -> p,
                        None -> pathStem(inputFile),
                    };
                    emitNativeExecutableFromIr(llText, outBin, plainTc, opts.optRuntime)?;
                    Ok(0)
                }
            },
        }
    }
}

def returnDriverErr(msg: String): Result String String = Err(msg)

def main(): Void = match runDriver() {
    Ok(code) -> if (code != 0) exit(code) else (),
    Err(msg) -> {
        if (isFormattedDiag(msg)) {
            eprintLn(msg)
        } else {
            eprintLn("error: " + msg)
        };
        exit(1)
    },
}
