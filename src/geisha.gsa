    printLn("geisha — Self-hosting Geisha compiler & decentralized package manager");
    printLn("");
    printLn("Package & Project Commands (reads geisha.toml):");
    printLn("  geisha init [--lib] [dir]      Initialize a new Geisha package or library");
    printLn("  geisha add <pkg|git-url>       Add dependency (MVS tag/rev + geisha.lock)");
    printLn("         [--version <v>] [--rev <r>] [--path <dir>] [--subdir <s>] [--as <name>]");
    printLn("  geisha remove <alias>          Remove dependency from geisha.toml");
    printLn("  geisha fetch                   Materialize dependencies into ~/.geisha/cache");
    printLn("  geisha update [alias]          Re-resolve remote tags/revs and update geisha.lock");
    printLn("  geisha build [options]         Compile current geisha.toml project");
    printLn("  geisha check [file.gsa]        Fast frontend type/exhaustiveness/Send check (--json)");
    printLn("  geisha run [--watch] [file.gsa] [args..] Build & run project or cached standalone script");
    printLn("  geisha eval '<code>' [args..]  Evaluate inline Geisha script (cached)");
    printLn("  geisha test [--watch]          Build & run project test suite (tests/*.gsa)");
    printLn("  geisha bench [file|filter]     Run microbenchmarks (--iters N --warmup N --rounds N --filter <pat> --json)");
    printLn("  geisha doc [module|file]       List modules or print public API signatures (--all)");
    printLn("  geisha fmt [options] [paths..] Format .gsa files in-place (--check, --write, --stdout)");
    printLn("  geisha guide                   Print compact Geisha language & pitfall guide for Agents");
    printLn("  geisha lsp                     Start JSON-RPC Language Server over stdio");
    printLn("");
    printLn("Direct Compiler Usage:");
    printLn("  geisha [options] <input.gsa>");
    printLn("");
    printLn("Compiler Options:");
    printLn("  -e, --emit-llvm                Emit LLVM 20 textual IR (.ll) to stdout or -o <file.ll>");
    printLn("  -g, --debug                    Emit DWARF debug info (defaults to -O0, disables TCO, runs dsymutil on macOS)");
    printLn("  -O<0|1|2|3|s|z>, --opt <lvl>   Set LLVM optimization level (--dev=-O0, --release=-O2; default: -O2, or -O0 with -g)");
    printLn("  --dump-core <file>             Dump Core Geisha S-expression IR (.gscore) for Lean 4 verifier");
    printLn("  --target <target>              native | wasm32 | wasm-gc | js | ios | ios-sim | macos-app | ios-app | ios-sim-app");
    printLn("  --export <fn>                  Export function symbol on native, wasm32, wasm-gc, or js (repeatable)");
    printLn("  --opt[=]<0|1|2|3|s|z>          Optimization level (also -O0..-O3, -Os, -Oz, --dev, --release)");
    printLn("  --strip                        Strip custom/name sections on wasm32");
    printLn("  --slim-runtime                 Omit default gs_wasm_* host bridge exports on wasm32");
    printLn("  --no-dts                       Skip TypeScript .d.ts generation on --target js / wasm-gc");
    printLn("  --no-main                      Omit C main() wrapper (for custom native host entry)");
    printLn("  --boot-sym <sym>               Emit custom native global initializer symbol");
    printLn("  -c, --compile-only             Compile to object file (.o) without linking");
    printLn("  -o <output>                    Write output to <output>");
    printLn("  --src-root <dir>               Multi-file module source root directory");
    printLn("  --pkg <id>=<dir>               Register scoped external package root");
    printLn("  --dep [from:]<alias>=<id>      Bind explicit package dependency alias");
    printLn("  -L, --lib-path <dir>           Legacy external module search path (repeatable)");
    printLn("  --runtime <path>               Path to libgeisha_runtime.a or wasm_rt.o");
    printLn("  --single-cgu                   Emit a single monolithic LLVM IR unit instead of per-module CGUs");
    printLn("  --no-cache                     Bypass incremental CGU/native/project object caches");
    printLn("  -h, --help                     Show this help message")
}

def isWatchIgnoredDir(name: String): Bool =
    name == ".git" || name == "build" || name == "dist" || name == "target"
    || name == "node_modules" || strStartsWith(name, ".")

def collectWatchFilesDir(dir: String, outRev: Cell (List String)): Void =
    match readDir(dir) {
        Err(_) -> (),
        Ok(entries) -> {
            let cur = cellNew(entries);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(nm, r) -> {
                        if (!isWatchIgnoredDir(nm)) {
                            let full = pathJoin(dir, nm);
                            if (isDir(full)) {
                                collectWatchFilesDir(full, outRev)
                            } else if (strEndsWith(nm, ".gsa") || nm == "geisha.toml" || nm == "geisha.lock") {
                                cellSet(outRev, Cons(full, cellGet(outRev)))
                            } else ()
                        } else ();
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            }
        },
    }

def computeWatchSnapshot(watchDirs: List String, extraFiles: List String): String = {
    let filesRev: Cell (List String) = cellNew(extraFiles);
    let cd = cellNew(watchDirs);
    while (match cellGet(cd) { Nil -> false, _ -> true }) {
        match cellGet(cd) {
            Cons(d, r) -> {
                if (strLen(d) > 0 && isDir(d)) {
                    collectWatchFilesDir(d, filesRev)
                } else ();
                cellSet(cd, r)
            },
            Nil -> (),
        }
    };
    let sorted = sortUniqueStrings(cellGet(filesRev));
    let b = bufNew();
    let cf = cellNew(sorted);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fp, r) -> {
                if (fileExists(fp)) {
                    bufPushStr(b, fp);
                    bufPushByte(b, 9);
                    bufPushStr(b, i64ToStr(c_file_size(fp)));
                    bufPushByte(b, 9);
                    bufPushStr(b, i64ToStr(c_file_mtime_ms(fp)));
                    bufPushByte(b, 10)
                } else ();
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };
    bufToString(b)
}

def clearWatchScreen(): Void =
    match getEnv("GEISHA_WATCH_NO_CLEAR") {
        Some("1") -> (),
        _ -> {
            let b = bufNew();
            bufPushByte(b, 27);
            bufPushStr(b, "[2J");
            bufPushByte(b, 27);
            bufPushStr(b, "[H");
            printLn(bufToString(b))
        },
    }

def watchPollIntervalMs(): Int =
    match getEnv("GEISHA_WATCH_POLL_MS") {
        Some(raw) -> match parseInt(raw) {
            Ok(ms) if (ms >= 20) -> ms,
            _ -> 250,
        },
        None -> 250,
    }

def stopWatchChild(activeChild: Cell (Option Child)): Void =
    match cellGet(activeChild) {
        None -> (),
        Some(ch) -> {
            // While `ch` has NOT yet been reaped by `waitpid`, POSIX guarantees its
            // PID/PGID cannot be recycled by the OS. Signal ONLY `-ch.pid` (never `+pid`),
            // wait for exit via WNOWAIT, escalate to SIGKILL on `-ch.pid`, then reap `ch`.
            let _ = c_proc_signal_group_only(ch.pid, 0);
            let waited = cellNew(0);
            let exited = cellNew(false);
            while (!cellGet(exited) && cellGet(waited) < 1500) {
                if (c_proc_poll_exited_no_reap(ch.pid) != 0) {
                    cellSet(exited, true)
                } else {
                    sleepMs(25);
                    cellSet(waited, cellGet(waited) + 25)
                }
            };
            let _ = c_proc_signal_group_only(ch.pid, 1);
            let _ = childWait(ch);
            cellSet(activeChild, None)
        },
    }

def buildCachedScriptBin(
    gsaFile: String,
    rtOverrideOpt: Option String,
    optLevel: String,
    optDebug: Bool,
    noCache: Bool
): Result String String = {
    let rtArchive = resolveRuntimeArchive(rtOverrideOpt)?;
    let entrySrc = readFile(gsaFile)?;
    let cacheDir = pathJoin(pathJoin(geishaHomeDir(), "cache"), "scripts");
    mkdirAll(cacheDir)?;
    let key = strSlice(
        sha256Hex("script\n" + scriptCompilerFingerprint(rtArchive) + "\nO" + optLevel + "|dbg" + (if (optDebug) "1" else "0") + "\n" + gsaFile + "\n" + entrySrc),
        0,
        24
    );
    let binPath = pathJoin(cacheDir, "s_" + key + hostExeExt());
    let depsPath = binPath + ".deps";
    if (!noCache && fileExists(binPath) && verifyScriptDeps(depsPath)) {
        Ok(binPath)
    } else {
        diagReset();
        let rootSpec = MkPkgSpec {
            pkgId: "",
            pkgName: "",
            srcRoots: [pathDirname(gsaFile)],
            deps: Nil,
        };
        let llText = compileWithPkgSpecsToIrDebug(
            gsaFile, true, rootSpec, Nil, Nil, None, false, Nil, false, None, optDebug
        )?;
        let tmpBin = pathJoin(cacheDir, "s_" + key + ".tmp." + intToStr(c_getpid()) + hostExeExt());
        emitNativeExecutableFromIrDebug(llText, tmpBin, emptyPlainTargetCfg(), rtOverrideOpt, optDebug, " -O" + optLevel)?;
        writeScriptDeps(depsPath, gsaFile)?;
        if (c_rename(tmpBin, binPath) != 0) {
            let _ = removeFile(tmpBin);
            Err("failed to cache compiled script binary at '" + binPath + "'")
        } else {
            Ok(binPath)
        }
    }
}

def settleWatchSnapshot(watchDirs: List String, extraFiles: List String, initialSnap: String): String = {
    let cur = cellNew(initialSnap);
    let stable = cellNew(false);
    let tries = cellNew(0);
    while (!cellGet(stable) && cellGet(tries) < 10 && c_watch_should_stop() == 0) {
        sleepMs(40);
        let next = computeWatchSnapshot(watchDirs, extraFiles);
        if (next == cellGet(cur)) {
            cellSet(stable, true)
        } else {
            cellSet(cur, next);
            cellSet(tries, cellGet(tries) + 1)
        }
    };
    cellGet(cur)
}

def runWatchProcessLoop(
    label: String,
    watchDirs: List String,
    extraFiles: List String,
    appArgs: List String,
    buildBin: () -> Result String String
): Result Int String = {
    c_watch_install_signal_handlers();
    let pollMs = watchPollIntervalMs();
    let lastSnap = cellNew(computeWatchSnapshot(watchDirs, extraFiles));
    let firstRun = cellNew(true);
    let activeChild: Cell (Option Child) = cellNew(None);
    while (c_watch_should_stop() == 0) {
        stopWatchChild(activeChild);
        clearWatchScreen();
        if (cellGet(firstRun)) {
            eprintLn("[watch] Starting " + label + "...");
            cellSet(firstRun, false)
        } else {
            eprintLn("[watch] Change detected — restarting " + label + "...")
        };
        match buildBin() {
            Ok(binPath) ->
                if (c_watch_should_stop() == 0) {
                    let cmd = cmdOwnGroup(command(binPath, appArgs), true);
                    match procSpawn(cmd) {
                        Ok(ch) -> cellSet(activeChild, Some(ch)),
                        Err(e) -> {
                            eprintLn("error: " + e);
                            eprintLn("[watch] Watching for changes...")
                        },
                    }
                } else (),
            Err(msg) -> {
                if (isFormattedDiag(msg)) eprintLn(msg)
                else eprintLn("error: " + msg);
                eprintLn("[watch] Watching for changes...")
            },
        };
        let changed = cellNew(false);
        while (!cellGet(changed) && c_watch_should_stop() == 0) {
            match cellGet(activeChild) {
                Some(ch) -> {
                    let pollSt = c_proc_poll_exited_no_reap(ch.pid);
                    if (pollSt > 0) {
                        // Leader exited naturally (still unreaped so PGID cannot be reused!):
                        // immediately clean up any surviving background descendants in `-ch.pid`,
                        // then reap `ch` and clear `activeChild`.
                        let _ = c_proc_signal_group_only(ch.pid, 0);
                        sleepMs(25);
                        let _ = c_proc_signal_group_only(ch.pid, 1);
                        match childWait(ch) {
                            Ok(Exited(rc)) -> {
                                cellSet(activeChild, None);
                                if (rc != 0) eprintLn("[watch] Exited with status " + intToStr(rc) + ". Watching for changes...")
                                else eprintLn("[watch] Done. Watching for changes...")
                            },
                            Ok(Signaled(sig)) -> {
                                cellSet(activeChild, None);
                                eprintLn("[watch] Exited with signal " + intToStr(sig) + ". Watching for changes...")
                            },
                            Err(_) -> cellSet(activeChild, None),
                        }
                    } else if (pollSt < 0) {
                        cellSet(activeChild, None)
                    } else ()
                },
                None -> (),
            };
            if (c_watch_should_stop() == 0) {
                sleepMs(pollMs);
                let nextSnap = computeWatchSnapshot(watchDirs, extraFiles);
                if (nextSnap != cellGet(lastSnap)) {
                    cellSet(lastSnap, settleWatchSnapshot(watchDirs, extraFiles, nextSnap));
                    cellSet(changed, true)
                } else ()
            } else ()
        }
    };
    stopWatchChild(activeChild);
    Ok(0)
}

def runWatchLoop(
    label: String,
    watchDirs: List String,
    extraFiles: List String,
    runOnce: () -> Result Int String
): Result Int String = {
    c_watch_install_signal_handlers();
    let pollMs = watchPollIntervalMs();
    let lastSnap = cellNew(computeWatchSnapshot(watchDirs, extraFiles));
    let firstRun = cellNew(true);
    while (c_watch_should_stop() == 0) {
        clearWatchScreen();
        if (cellGet(firstRun)) {
            eprintLn("[watch] Starting " + label + "...");
            cellSet(firstRun, false)
        } else {
            eprintLn("[watch] Change detected — re-running " + label + "...")
        };
        match runOnce() {
            Ok(rc) ->
                if (rc != 0) eprintLn("[watch] Exited with status " + intToStr(rc) + ". Watching for changes...")
                else eprintLn("[watch] Done. Watching for changes..."),
            Err(msg) -> {
                if (isFormattedDiag(msg)) eprintLn(msg)
                else eprintLn("error: " + msg);
                eprintLn("[watch] Watching for changes...")
            },
        };
        let changed = cellNew(false);
        while (!cellGet(changed) && c_watch_should_stop() == 0) {
            sleepMs(pollMs);
            let nextSnap = computeWatchSnapshot(watchDirs, extraFiles);
            if (nextSnap != cellGet(lastSnap)) {
                cellSet(lastSnap, settleWatchSnapshot(watchDirs, extraFiles, nextSnap));
                cellSet(changed, true)
            } else ()
        }
    };
    Ok(0)
}

def runDriver(): Result Int String = {
    let opts = parseCliArgs()?;
    if (opts.optHelp) {
        printUsage();
        Ok(0)
    } else {
        let isTestSub = match opts.optSubcmd { Some("test") -> true, _ -> false };
        let effOptLevel = match opts.optLevel {
            Some(lvl) -> lvl,
            None -> if (opts.optDebug || isTestSub) "0" else "2",
        };
        let optFlag = " -O" + effOptLevel;
        let cbs = makeCompileCallbacks(opts.optDebug, effOptLevel, opts.optSingleCgu, opts.optNoCache);
        match opts.optSubcmd {
            Some("init") -> { cmdInit(opts.optSubArgs)?; Ok(0) },
            Some("add") -> { cmdAdd(opts.optSubArgs)?; Ok(0) },
            Some("remove") -> { cmdRemove(opts.optSubArgs)?; Ok(0) },
            Some("fetch") -> { cmdFetch(false, opts.optSubArgs)?; Ok(0) },
            Some("update") -> { cmdFetch(true, opts.optSubArgs)?; Ok(0) },
            Some("build") -> {
                let projDir = match findProjectRoot(".") {
                    Some(d) -> d,
                    None -> returnDriverErr("no geisha.toml found in current or parent directories")?,
                };
                let _ = cmdBuildProject(
                    projDir,
                    opts.optTarget,
                    opts.optEmitIr,
                    opts.optCompileOnly,
                    opts.optOutPath,
                    opts.optDumpCore,
                    opts.optRuntime,
                    opts.optExports,
                    opts.optNoMain,
                    opts.optBootSym,
                    opts.optLevel,
                    opts.optStrip,
                    opts.optSlimRuntime,
                    opts.optNoDts,
                    None,
                    cbs
                )?;
                Ok(0)
            },
            Some("check") -> runCheckSubcmd(opts),
            Some("run") -> {
                let runOnce = () -> match opts.optInput {
                    Some(gsaFile) ->
                        if (opts.optDebug) runUncachedScriptFile(gsaFile, opts.optSubArgs, opts.optRuntime, opts.optDebug, optFlag)
                        else runCachedScriptFile(gsaFile, opts.optSubArgs, opts.optRuntime, effOptLevel, opts.optDebug, opts.optNoCache),
                    None ->
                        if (opts.optTarget == "macos-app" || opts.optTarget == "ios-sim-app") {
                            let projDir = match findProjectRoot(".") {
                                Some(d) -> d,
                                None -> returnDriverErr("no geisha.toml found in current or parent directories")?,
                            };
                            let bundlePath = cmdBuildProject(
                                projDir, opts.optTarget, false, false, opts.optOutPath, None,
                                opts.optRuntime, opts.optExports, opts.optNoMain, opts.optBootSym,
                                opts.optLevel, opts.optStrip, opts.optSlimRuntime, opts.optNoDts,
                                None, cbs
                            )?;
                            if (opts.optTarget == "macos-app") {
                                let rc = shell("open " + shellQuote(bundlePath));
                                Ok(if (rc == 0) 0 else 1)
                            } else {
                                let (rootMf, _, _) = resolveProjectGraph(projDir, false, None, false)?;
                                let bid = match rootMf.mfIosBundle.abBundleId {
                                    Some(id) -> id,
                                    None -> "com.geisha." + rootMf.mfName,
                                };
                                let cmd =
                                    "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcrun simctl install booted "
                                    + shellQuote(bundlePath)
                                    + " && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcrun simctl launch booted "
                                    + shellQuote(bid);
                                let rc = shell(cmd);
                                Ok(if (rc == 0) 0 else 1)
                            }
                        } else {
                            cmdRun(opts.optSubArgs, None, opts.optRuntime, cbs)
                        },
                };
                if (opts.optWatch) {
                    match opts.optInput {
                        Some(gsaFile) -> {
                            let dir = pathDirname(gsaFile);
                            let watchRoot = match findProjectRoot(dir) {
                                Some(pr) -> pr,
                                None -> if (strLen(dir) == 0) "." else dir,
                            };
                            runWatchProcessLoop(
                                "geisha run " + gsaFile,
                                [watchRoot],
                                [gsaFile],
                                opts.optSubArgs,
                                () -> buildCachedScriptBin(gsaFile, opts.optRuntime, effOptLevel, opts.optDebug, opts.optNoCache)
                            )
                        },
                        None -> {
                            let projDir = match findProjectRoot(".") {
                                Some(d) -> d,
                                None -> returnDriverErr("no geisha.toml found in current or parent directories")?,
                            };
                            if (opts.optTarget == "macos-app" || opts.optTarget == "ios-sim-app") {
                                runWatchLoop("geisha run", [projDir], [pathJoin(projDir, "geisha.toml")], runOnce)
                            } else {
                                runWatchProcessLoop(
                                    "geisha run",
                                    [projDir],
                                    [pathJoin(projDir, "geisha.toml")],
                                    opts.optSubArgs,
                                    () -> cmdBuildProject(projDir, "native", false, false, None, None, opts.optRuntime, Nil, false, None, None, false, false, false, None, cbs)
                                )
                            }
                        },
                    }
                } else {
                    runOnce()
                }
            },
            Some("eval") -> runEvalSubcmd(opts.optSubArgs, opts.optRuntime),
            Some("test") ->
                if (opts.optWatch) {
                    let projDir = match findProjectRoot(".") {
                        Some(d) -> d,
                        None -> returnDriverErr("no geisha.toml found in current or parent directories")?,
                    };
                    runWatchLoop("geisha test", [projDir], [pathJoin(projDir, "geisha.toml")], () -> {
                        cmdTest(opts.optRuntime, cbs)?;
                        Ok(0)
                    })
                } else {
                    cmdTest(opts.optRuntime, cbs)?;
                    Ok(0)
                },
            Some("bench") -> cmdBench(opts.optSubArgs, opts.optJson, opts.optRuntime, cbs),
            Some("doc") -> { cmdDoc(opts.optSubArgs)?; Ok(0) },
            Some("fmt") -> cmdFmt(opts.optSubArgs),
            Some("guide") -> { printLn(embeddedAgentGuide()); Ok(0) },
            Some("lsp") -> cmdLsp(opts.optSubArgs),
            Some(other) -> Err("unknown subcommand: " + other),
            None -> {
                let inputFile = match opts.optInput {
                    Some(p) -> p,
                    None -> returnDriverErr("No input .gsa file specified (run 'geisha --help' for usage)")?,
                };
                let isWasm = opts.optTarget == "wasm32";
                let isWasmGc = opts.optTarget == "wasm-gc";
                let isJs = opts.optTarget == "js";
                let useProjLoader = match opts.optSrcRoot { Some(_) -> true, None -> false };
                let (rootSpec, extSpecs) = buildCliPkgGraph(inputFile, opts.optSrcRoot, opts.optPkgFlags, opts.optDepFlags);
                let plainTc = MkTargetCfg {
                    tcCSources: Nil,
                    tcCFlags: Nil,
                    tcLinkFlags: Nil,
                    tcExtraUnits: Nil,
                    tcExports: opts.optExports,
                    tcWebAssets: Nil,
                    tcOwnsMain: opts.optNoMain,
                    tcBootSymbol: opts.optBootSym,
                    tcOptLevel: opts.optLevel,
                    tcStrip: if (opts.optStrip) Some(true) else None,
                    tcSlimRuntime: opts.optSlimRuntime,
                    tcEmitDts: !opts.optNoDts,
                };
                if (isWasmGc) {
                    if (opts.optEmitIr) {
                        Err("cannot combine '--emit-llvm' with '--target wasm-gc'")
                    } else {
                        let outWasm = match opts.optOutPath {
                            Some(p) -> p,
                            None -> pathStem(inputFile) + ".wasm",
                        };
                        compileWithPkgSpecsToWasmGc(
                            inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                            opts.optDumpCore, plainTc, outWasm
                        )?;
                        Ok(0)
                    }
                } else if (isJs) {
                    if (opts.optEmitIr) {
                        Err("cannot combine '--emit-llvm' with '--target js'")
                    } else {
                        let outJs = match opts.optOutPath {
                            Some(p) -> p,
                            None -> pathStem(inputFile) + ".mjs",
                        };
                        compileWithPkgSpecsToJs(
                            inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                            opts.optDumpCore, plainTc, outJs
                        )?;
                        Ok(0)
                    }
                } else {
                let arch =
                    if (isWasm) "wasm32"
                    else if (opts.optTarget == "ios" || opts.optTarget == "ios-sim" || opts.optTarget == "ios-app" || opts.optTarget == "ios-sim-app") "arm64"
                    else currentHostArch();
                if (opts.optEmitIr) {
                    let llText = compileWithPkgSpecsToIrForArchDebug(
                        inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                        opts.optDumpCore, isWasm, arch, opts.optExports, opts.optNoMain, opts.optBootSym, opts.optDebug
                    )?;
                    match opts.optOutPath {
                        Some(outLl) -> { writeFile(outLl, llText)?; Ok(0) },
                        None -> { printLn(llText); Ok(0) },
                    }
                } else if (isWasm) {
                    let outP = match opts.optOutPath {
                        Some(p) -> p,
                        None -> pathStem(inputFile) + (if (opts.optCompileOnly) ".o" else ".wasm"),
                    };
                    if (opts.optCompileOnly) {
                        let llText = compileWithPkgSpecsToIrForArchDebug(
                            inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                            opts.optDumpCore, true, "wasm32", opts.optExports, opts.optNoMain, opts.optBootSym, opts.optDebug
                        )?;
                        emitWasmFromIrOpt(llText, outP, true, plainTc, opts.optRuntime, optFlag)?;
                        Ok(0)
                    } else {
                        let cgus = compileWithPkgSpecsToCgusForArchDebug(
                            inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                            opts.optDumpCore, true, "wasm32", opts.optExports, opts.optNoMain, opts.optBootSym, opts.optDebug, opts.optSingleCgu
                        )?;
                        emitWasmFromCgus(cgus, outP, plainTc, opts.optRuntime, defaultGlobalCacheDir(), effOptLevel, opts.optDebug, opts.optNoCache)?;
                        Ok(0)
                    }
                } else if (opts.optCompileOnly) {
                    let llText = compileWithPkgSpecsToIrForArchDebug(
                        inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                        opts.optDumpCore, false, arch, opts.optExports, opts.optNoMain, opts.optBootSym, opts.optDebug
                    )?;
                    let outObj = match opts.optOutPath {
                        Some(p) -> p,
                        None -> pathStem(inputFile) + ".o",
                    };
                    emitTargetObjFromIrOpt(llText, outObj, opts.optTarget, optFlag)?;
                    Ok(0)
                } else if (opts.optTarget == "ios" || opts.optTarget == "ios-sim" || (opts.optNoMain && match opts.optOutPath { Some(p) -> strEndsWithA(p), None -> false })) {
                    let llText = compileWithPkgSpecsToIrForArchDebug(
                        inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                        opts.optDumpCore, false, arch, opts.optExports, opts.optNoMain, opts.optBootSym, opts.optDebug
                    )?;
                    let outArc = match opts.optOutPath {
                        Some(p) -> p,
                        None -> "lib" + pathStem(inputFile) + ".a",
                    };
                    emitStaticLibFromIrOpt(llText, outArc, opts.optTarget, opts.optRuntime, optFlag)?;
                    Ok(0)
                } else {
                    let outBin = match opts.optOutPath {
                        Some(p) -> p,
                        None -> pathStem(inputFile) + hostExeExt(),
                    };
                    let cgus = compileWithPkgSpecsToCgusForArchDebug(
                        inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths,
                        opts.optDumpCore, false, arch, opts.optExports, opts.optNoMain, opts.optBootSym, opts.optDebug, opts.optSingleCgu
                    )?;
                    let _ = emitNativeExecutableFromCgus(cgus, outBin, plainTc, opts.optRuntime, defaultGlobalCacheDir(), effOptLevel, opts.optDebug, opts.optNoCache)?;
                    Ok(0)
                }
                }
            },
        }
    }
}

def returnDriverErr(msg: String): Result String String = Err(msg)

def main(): Void = match runDriver() {
    Ok(code) -> if (code != 0) exit(code) else (),
    Err(msg) -> {
        if (isFormattedDiag(msg)) {
            eprintLn(msg)
        } else {
            eprintLn("error: " + msg)
        };
        exit(1)
    },
}
