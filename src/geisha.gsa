    noMain: Bool,
    bootSymOpt: Option String
): Result String String =
    compileWithPkgSpecsToIrForArchDebug(
        entryFile, useProjectLoader, rootSpec, extSpecs, libPaths, dumpCoreOpt,
        isWasm, targetArch, exports, noMain, bootSymOpt, false
    )

def compileWithPkgSpecsToIrDebug(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String,
    dumpCoreOpt: Option String,
    isWasm: Bool,
