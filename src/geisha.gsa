        isWasm, if (isWasm) "wasm32" else currentHostArch(), exports, noMain, bootSymOpt, debugInfo
    )

def compileWithPkgSpecsToIr(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String,
    dumpCoreOpt: Option String,
    isWasm: Bool,
