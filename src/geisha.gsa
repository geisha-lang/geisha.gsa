def jsonEscapeStr(s: String): String = {
    let b = bufNew();
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        let ch = strByteAt(s, idx);
        if (ch == 34) bufPushStr(b, "\\\"")
        else if (ch == 92) bufPushStr(b, "\\\\")
        else if (ch == 10) bufPushStr(b, "\\n")
        else if (ch == 13) bufPushStr(b, "\\r")
        else if (ch == 9) bufPushStr(b, "\\t")
        else bufPushByte(b, ch);
        cellSet(i, idx + 1)
    };
    bufToString(b)
}

def checkProgramFrontEnd(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String
): Result Void String = {
    let rawDefs =
        if (useProjectLoader) {
            loadProjectProgramWithPkgs(entryFile, rootSpec, extSpecs, libPaths)?
        } else {
            let src = readFile(entryFile)?;
            loadSingleSourceProgramWithPkgsNamed(entryFile, src, rootSpec, extSpecs, libPaths)?
        };
    let inf = inferProgram(rawDefs)?;
    lowerToCoreForCheck(inf)
}

def runCheckSubcmd(opts: CliOpts): Result Int String = {
    let (entryLabel, res) = match opts.optInput {
        Some(inputFile) -> {
            let useProjLoader = match opts.optSrcRoot { Some(_) -> true, None -> false };
            let (rootSpec, extSpecs) = buildCliPkgGraph(inputFile, opts.optSrcRoot, opts.optPkgFlags, opts.optDepFlags);
            (inputFile, checkProgramFrontEnd(inputFile, useProjLoader, rootSpec, extSpecs, opts.optLibPaths))
        },
        None -> match findProjectRoot(".") {
            None -> ("<project>", Err("no geisha.toml found and no .gsa file specified (usage: geisha check [file.gsa] [--json])")),
            Some(projDir) -> match resolveProjectGraph(projDir, false, None, true) {
                Err(e) -> (projDir, Err(e)),
                Ok((rootMf, rootSpec, resolvedPkgs)) -> match resolveDefaultEntryFile(projDir, rootMf) {
                    Err(e) -> (projDir, Err(e)),
                    Ok(entryFile) -> {
                        let extSpecs = toLoaderPkgSpecs(resolvedPkgs);
                        (entryFile, checkProgramFrontEnd(entryFile, true, rootSpec, extSpecs, opts.optLibPaths))
                    },
                },
            },
        },
    };
    if (opts.optJson) {
        match res {
            Ok(_) -> {
                printLn("{\"ok\":true,\"file\":\"" + jsonEscapeStr(entryLabel) + "\"}");
                Ok(0)
            },
            Err(msg) -> {
                printLn("{\"ok\":false,\"file\":\"" + jsonEscapeStr(entryLabel) + "\",\"error\":\"" + jsonEscapeStr(msg) + "\"}");
                Ok(1)
            },
        }
    } else {
        match res {
            Ok(_) -> {
                printLn("OK: " + entryLabel);
                Ok(0)
            },
            Err(msg) -> Err(msg),
        }
    }
}

def emitNativeExecutableFromIrDebug(
    llText: String,
    outBin: String,
    tc: TargetCfg,
    rtOverrideOpt: Option String,
    debugInfo: Bool,
    optFlag: String
): Result Void String = {
    let rtArchive = resolveRuntimeArchive(rtOverrideOpt)?;
    let ccProg = resolveNativeCc();
    let envVars = nativeEnvVars();
    let targetArgs = nativeTargetArgs();
    let effOptArg = trimLeadingSpace(match tc.tcOptLevel { Some(lvl) -> "-O" + lvl, None -> optFlag });
    let pthreadArgs = nativePthreadArgs();
    let sysLibArgs = nativeSysLibArgs();
    let isMac = currentHostOs() == "macos";
    let dbgArgs = if (debugInfo) ["-g"] else Nil;
    let tmpLl = outBin + ".tmp.ll";
    writeFile(tmpLl, llText)?;

    // Compile any extra native compiler units (e.g. `compiler = "nvcc"` from `[[target.native.when]]`)
    let extraObjs: Cell (List String) = cellNew(Nil);
    let extraErr: Cell (Option String) = cellNew(None);
    let uIdx = cellNew(0);
    let cu = cellNew(tc.tcExtraUnits);
    while (match cellGet(extraErr) { None -> true, Some(_) -> false } && match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons(u, ru) -> {
                let cs = cellNew(u.nuSources);
                while (match cellGet(extraErr) { None -> true, Some(_) -> false } && match cellGet(cs) { Nil -> false, _ -> true }) {
                    match cellGet(cs) {
                        Cons(srcPath, rs) -> {
                            let objPath = outBin + ".unit" + intToStr(cellGet(uIdx)) + ".tmp.o";
                            cellSet(uIdx, cellGet(uIdx) + 1);
                            let uArgs = concatArgLists([u.nuFlags, ["-c", srcPath, "-o", objPath]]);
                            let rcu = runHostProc(u.nuCompiler, uArgs, envVars);
                            if (rcu != 0) {
                                cellSet(extraErr, Some("Native compiler '" + u.nuCompiler + "' failed on '" + srcPath + "'"))
                            } else {
                                cellSet(extraObjs, listAppend(cellGet(extraObjs), [objPath]))
                            };
                            cellSet(cs, rs)
                        },
                        Nil -> (),
                    }
                };
                cellSet(cu, ru)
            },
            Nil -> (),
        }
    };
    let cleanupExtraObjs = () -> {
        let co = cellNew(cellGet(extraObjs));
        while (match cellGet(co) { Nil -> false, _ -> true }) {
            match cellGet(co) {
                Cons(op, ro) -> { let _ = removeFile(op); cellSet(co, ro) },
                Nil -> (),
            }
        }
    };
    let needsObjStage = (debugInfo && isMac) || match (tc.tcCSources, cellGet(extraObjs)) {
        (Nil, Nil) -> false,
        _ -> true,
    };
    match cellGet(extraErr) {
        Some(emsg) -> {
            let _ = removeFile(tmpLl);
            cleanupExtraObjs();
            Err(emsg)
        },
        None ->
            if (!needsObjStage) {
                let args = concatArgLists([
                    targetArgs,
                    [effOptArg, "-Wno-override-module"],
                    pthreadArgs,
                    ["-x", "ir", tmpLl, "-x", "none", rtArchive],
                    tc.tcLinkFlags,
                    sysLibArgs,
                    ["-o", outBin]
                ]);
                let rc = runHostProc(ccProg, args, envVars);
                let _ = removeFile(tmpLl);
                if (rc == 0) Ok(())
                else Err("C/LLVM backend failed while linking executable '" + outBin + "'")
            } else {
                // Compile IR to `.o` first (required for ObjC/C host files and macOS `dsymutil` DWARF extraction)
                let tmpObj = outBin + ".gsa.tmp.o";
                let irArgs = concatArgLists([
                    targetArgs,
                    [effOptArg, "-Wno-override-module", "-x", "ir", "-c", tmpLl, "-o", tmpObj]
                ]);
                let rc1 = runHostProc(ccProg, irArgs, envVars);
                let _ = removeFile(tmpLl);
                if (rc1 != 0) {
                    let _ = removeFile(tmpObj);
                    cleanupExtraObjs();
                    Err("C/LLVM backend failed while compiling Geisha IR object for '" + outBin + "'")
                } else {
                    let linkArgs = concatArgLists([
                        targetArgs,
                        [effOptArg],
                        dbgArgs,
                        pthreadArgs,
                        tc.tcCFlags,
                        tc.tcCSources,
                        cellGet(extraObjs),
                        [tmpObj, rtArchive],
                        tc.tcLinkFlags,
                        sysLibArgs,
                        ["-o", outBin]
                    ]);
                    let rc2 = runHostProc(ccProg, linkArgs, envVars);
                    let rcDsym =
                        if (rc2 == 0 && debugInfo && isMac) {
                            runHostProc("dsymutil", [outBin], Nil)
                        } else 0;
                    let _ = removeFile(tmpObj);
                    cleanupExtraObjs();
                    if (rc2 != 0) Err("C/LLVM backend failed while linking native host & executable '" + outBin + "'")
                    else if (rcDsym != 0) Err("dsymutil failed while generating dSYM bundle for '" + outBin + "'")
                    else Ok(())
                }
            },
    }
}

def emitNativeExecutableFromIr(
    llText: String,
    outBin: String,
    tc: TargetCfg,
    rtOverrideOpt: Option String
): Result Void String =
    emitNativeExecutableFromIrDebug(llText, outBin, tc, rtOverrideOpt, false, " -O2")

def emitTargetObjFromIrOpt(llText: String, outObj: String, target: String, optFlag: String): Result Void String = {
    let tmpLl = outObj + ".tmp.ll";
    writeFile(tmpLl, llText)?;
    let optArg = trimLeadingSpace(optFlag);
    let rc =
        if (target == "ios") {
            let cmd =
                "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=16.0 "
                + "xcrun --sdk iphoneos clang -target arm64-apple-ios16.0" + optFlag + " -Wno-override-module -x ir -c "
                + shellQuote(tmpLl) + " -o " + shellQuote(outObj);
            shell(cmd)
        } else if (target == "ios-sim") {
            let cmd =
                "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=16.0 "
                + "xcrun --sdk iphonesimulator clang -target arm64-apple-ios16.0-simulator" + optFlag + " -Wno-override-module -x ir -c "
                + shellQuote(tmpLl) + " -o " + shellQuote(outObj);
            shell(cmd)
        } else {
            let args = concatArgLists([
                nativeTargetArgs(),
                [optArg, "-Wno-override-module", "-x", "ir", "-c", tmpLl, "-o", outObj]
            ]);
            runHostProc(resolveNativeCc(), args, nativeEnvVars())
        };
    let _ = removeFile(tmpLl);
    if (rc == 0) Ok(())
    else Err("C/LLVM backend failed while compiling object '" + outObj + "' for target '" + target + "'")
}

def emitTargetObjFromIr(llText: String, outObj: String, target: String): Result Void String =
    emitTargetObjFromIrOpt(llText, outObj, target, " -O2")

def emitNativeObjFromIrOpt(llText: String, outObj: String, optFlag: String): Result Void String =
    emitTargetObjFromIrOpt(llText, outObj, "native", optFlag)

def emitNativeObjFromIr(llText: String, outObj: String): Result Void String =
    emitTargetObjFromIr(llText, outObj, "native")

def resolveRuntimeArchiveForTarget(target: String, rtOverrideOpt: Option String): Result String String =
    match rtOverrideOpt {
        Some(p) -> Ok(p),
        None ->
            if (target == "ios") {
                let c1 = "build/libgeisha_runtime_ios.a";
                let c2 = pathJoin(geishaHomeDir(), "lib/libgeisha_runtime_ios.a");
                if (fileExists(c1)) Ok(c1)
                else if (fileExists(c2)) Ok(c2)
                else Err("iOS runtime archive not found (run 'make runtime-ios' or pass '--runtime <path>')")
            } else if (target == "ios-sim") {
                let c1 = "build/libgeisha_runtime_ios_sim.a";
                let c2 = pathJoin(geishaHomeDir(), "lib/libgeisha_runtime_ios_sim.a");
                if (fileExists(c1)) Ok(c1)
                else if (fileExists(c2)) Ok(c2)
                else Err("iOS Simulator runtime archive not found (run 'make runtime-ios-sim' or pass '--runtime <path>')")
            } else {
                resolveRuntimeArchive(None)
            },
    }

def strEndsWithA(s: String): Bool = {
    let n = strLen(s);
    n >= 2 && strByteAt(s, n - 2) == 46 && strByteAt(s, n - 1) == 97
}

def emitStaticLibFromIrOpt(
    llText: String,
    outArchive: String,
    target: String,
    rtOverrideOpt: Option String,
    optFlag: String
): Result Void String = {
    let rtArchive = resolveRuntimeArchiveForTarget(target, rtOverrideOpt)?;
    let tmpObj = outArchive + ".gsa.tmp.o";
    emitTargetObjFromIrOpt(llText, tmpObj, target, optFlag)?;
    let rc =
        if (currentHostOs() == "macos") {
            runHostProc("libtool", ["-static", "-o", outArchive, tmpObj, rtArchive], Nil)
        } else if (currentHostOs() == "windows") {
            let _ = removeFile(outArchive);
            runHostProc("lld-link", ["/lib", "/nologo", "/out:" + outArchive, rtArchive, tmpObj], Nil)
        } else {
            let cmd =
                "rm -f " + shellQuote(outArchive)
                + " && printf 'CREATE %s\\nADDLIB %s\\nADDMOD %s\\nSAVE\\nEND\\n' "
                + shellQuote(outArchive) + " " + shellQuote(rtArchive) + " " + shellQuote(tmpObj)
                + " | ar -M";
            shell(cmd)
        };
    let _ = removeFile(tmpObj);
    if (rc == 0) Ok(())
    else Err("archiver failed while creating static library '" + outArchive + "'")
}

def emitStaticLibFromIr(
    llText: String,
    outArchive: String,
    target: String,
    rtOverrideOpt: Option String
): Result Void String =
    emitStaticLibFromIrOpt(llText, outArchive, target, rtOverrideOpt, " -O2")

def dtsPathForJsOut(outJs: String): String = {
    let n = strLen(outJs);
    if (strEndsWith(outJs, ".mjs")) strSlice(outJs, 0, n - 4) + ".d.ts"
    else if (strEndsWith(outJs, ".js")) strSlice(outJs, 0, n - 3) + ".d.ts"
    else outJs + ".d.ts"
}

def compileWithPkgSpecsToJs(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String,
    dumpCoreOpt: Option String,
    tc: TargetCfg,
    outJsPath: String
): Result Void String = {
    let rawDefs =
        if (useProjectLoader) {
            loadProjectProgramWithPkgs(entryFile, rootSpec, extSpecs, libPaths)?
        } else {
            let src = readFile(entryFile)?;
            loadSingleSourceProgramWithPkgsNamed(entryFile, src, rootSpec, extSpecs, libPaths)?
        };
    let inf = inferProgram(rawDefs)?;
    let coreProg = lowerToCore(inf)?;
    maybeDumpCoreIr(coreProg, dumpCoreOpt)?;
    let effExports = match tc.tcExports {
        Nil -> collectRootPubFnNames(rawDefs, coreProg),
        es -> es,
    };
    let jsCode = emitProgramJs(coreProg, effExports, tc.tcOwnsMain);
    writeFile(outJsPath, jsCode)?;
    if (tc.tcEmitDts) {
        let dtsCode = emitProgramDts(coreProg, effExports, tc.tcOwnsMain);
        writeFile(dtsPathForJsOut(outJsPath), dtsCode)?;
        Ok(())
    } else Ok(())
}

def gluePathForWasmOut(outWasm: String, ext: String): String = {
    let n = strLen(outWasm);
    if (strEndsWith(outWasm, ".wasm")) strSlice(outWasm, 0, n - 5) + ext
    else outWasm + ext
}

def compileWithPkgSpecsToWasmGc(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String,
    dumpCoreOpt: Option String,
    tc: TargetCfg,
    outWasmPath: String
): Result Void String = {
    let rawDefs =
        if (useProjectLoader) {
            loadProjectProgramWithPkgs(entryFile, rootSpec, extSpecs, libPaths)?
        } else {
            let src = readFile(entryFile)?;
            loadSingleSourceProgramWithPkgsNamed(entryFile, src, rootSpec, extSpecs, libPaths)?
        };
    let inf = inferProgram(rawDefs)?;
    let coreProg = lowerToCore(inf)?;
    maybeDumpCoreIr(coreProg, dumpCoreOpt)?;
    let effExports = match tc.tcExports {
        Nil -> collectRootPubFnNames(rawDefs, coreProg),
        es -> es,
    };
    let wasmBuf = emitProgramWasmGc(coreProg, effExports, tc.tcOwnsMain)?;
    writeWasmGcBinary(outWasmPath, wasmBuf)?;
    let glueJs = emitProgramWasmGcGlue(coreProg, pathBasename(outWasmPath), effExports, tc.tcOwnsMain);
    writeFile(gluePathForWasmOut(outWasmPath, ".mjs"), glueJs)?;
    if (tc.tcEmitDts) {
        let dtsCode = emitProgramWasmGcDts(coreProg, effExports, tc.tcOwnsMain);
        writeFile(gluePathForWasmOut(outWasmPath, ".d.ts"), dtsCode)?;
        writeFile(gluePathForWasmOut(outWasmPath, ".d.mts"), dtsCode)?;
        Ok(())
    } else Ok(())
}

def isWasmOptDisabled(): Bool = match getEnv("GEISHA_DISABLE_TOOL") {
    Some(v) -> v == "wasm-opt",
    None -> false,
}

def findExeInPath(binName: String): Option String = match getEnv("PATH") {
    None -> None,
    Some(pathEnv) -> {
        let isWin = currentHostOs() == "windows";
        let sepCh = if (isWin) ';' else ':';
        let dirs = strSplitChar(pathEnv, sepCh);
        let cur = cellNew(dirs);
        let found: Cell (Option String) = cellNew(None);
        while (match cellGet(cur) { Nil -> false, _ -> match cellGet(found) { None -> true, Some(_) -> false } }) {
            match cellGet(cur) {
                Cons(d, r) -> {
                    if (strLen(d) > 0) {
                        let cand = pathJoin(d, binName);
                        if (fileExists(cand)) cellSet(found, Some(cand))
                        else if (isWin) {
                            let candExe = pathJoin(d, binName + ".exe");
                            if (fileExists(candExe)) cellSet(found, Some(candExe)) else ()
                        } else ()
                    } else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
}

def emitWasmFromIrOpt(
    llText: String,
    outPath: String,
    compileOnly: Bool,
    tc: TargetCfg,
    rtOverrideOpt: Option String,
    optFlag: String
): Result Void String = {
    let wasmCc = resolveWasmCc();
    let effOptArg = trimLeadingSpace(match tc.tcOptLevel { Some(lvl) -> "-O" + lvl, None -> optFlag });
    let isSizeOpt = effOptArg == "-Oz" || effOptArg == "-Os";
    if (compileOnly) {
        let tmpLl = outPath + ".tmp.ll";
        writeFile(tmpLl, llText)?;
        let args = ["--target=wasm32", effOptArg, "-mbulk-memory", "-mnontrapping-fptoint", "-Wno-override-module", "-nostdlib", "-x", "ir", "-c", tmpLl, "-o", outPath];
        let rc = runHostProc(wasmCc, args, Nil);
        let _ = removeFile(tmpLl);
        if (rc == 0) Ok(())
        else Err("LLVM wasm32 backend failed while compiling object '" + outPath + "'")
    } else {
        let wasmRt = resolveWasmRuntimeObj(rtOverrideOpt)?;
        let tmpLl = outPath + ".tmp.ll";
        writeFile(tmpLl, llText)?;
        let doStrip = match tc.tcStrip {
            Some(b) -> b,
            None -> isSizeOpt,
        };
        let ldArgs = resolveWasmLdArgs();
        let stripArgs = if (doStrip) ["-Wl,--strip-all"] else Nil;
        let rtExportArgs =
            if (tc.tcSlimRuntime) Nil
            else [
                "-Wl,--export=gs_wasm_gc_collect",
                "-Wl,--export=gs_wasm_alloc",
                "-Wl,--export=gs_wasm_str_len",
                "-Wl,--export=gs_wasm_heap_used",
                "-Wl,--export=gs_wasm_heap_live"
            ];
        let args = concatArgLists([
            ["--target=wasm32", effOptArg, "-mbulk-memory", "-mnontrapping-fptoint", "-Wno-override-module", "-nostdlib"],
            ldArgs,
            tc.tcCFlags,
            ["-x", "ir", tmpLl, "-x", "none", wasmRt],
            tc.tcCSources,
            tc.tcLinkFlags,
            ["-Wl,--no-entry", "-Wl,--allow-undefined", "-Wl,--gc-sections", "-Wl,--export-table"],
            stripArgs,
            rtExportArgs,
            ["-o", outPath]
        ]);
        let rc = runHostProc(wasmCc, args, Nil);
        let _ = removeFile(tmpLl);
        if (rc != 0) {
            Err("LLVM wasm32 backend failed while linking '" + outPath + "' (ensure lld/wasm-ld is installed)")
        } else {
            // Optional post-link `wasm-opt -Oz` pass when available in size mode (via PATH lookup, no `command -v` probe)
            if (isSizeOpt && !isWasmOptDisabled()) {
                match findExeInPath("wasm-opt") {
                    Some(wasmOptBin) -> {
                        let optArgs = ["-Oz", "--enable-bulk-memory", "--enable-nontrapping-float-to-int", outPath, "-o", outPath];
                        let optRc = runHostProc(wasmOptBin, optArgs, Nil);
                        if (optRc == 0) Ok(())
                        else Err("wasm-opt failed while optimizing '" + outPath + "'")
                    },
                    None -> Ok(()),
                }
            } else Ok(())
        }
    }
}

def emitWasmFromIr(
    llText: String,
    outPath: String,
    compileOnly: Bool,
    tc: TargetCfg,
    rtOverrideOpt: Option String
): Result Void String =
    emitWasmFromIrOpt(llText, outPath, compileOnly, tc, rtOverrideOpt, " -O2")

def generateDefaultMacosPlist(
    bundleId: String,
    bundleName: String,
    version: String,
    minOs: String,
    lsuiElement: Bool,
    iconFileOpt: Option String
): String = {
    let b = bufNew();
    bufPushStr(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    bufPushStr(b, "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n");
    bufPushStr(b, "<plist version=\"1.0\">\n<dict>\n");
    bufPushStr(b, "  <key>CFBundleDevelopmentRegion</key><string>en</string>\n");
    bufPushStr(b, "  <key>CFBundleExecutable</key><string>" + bundleName + "</string>\n");
    bufPushStr(b, "  <key>CFBundleIdentifier</key><string>" + bundleId + "</string>\n");
    bufPushStr(b, "  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>\n");
    bufPushStr(b, "  <key>CFBundleName</key><string>" + bundleName + "</string>\n");
    bufPushStr(b, "  <key>CFBundlePackageType</key><string>APPL</string>\n");
    bufPushStr(b, "  <key>CFBundleShortVersionString</key><string>" + version + "</string>\n");
    bufPushStr(b, "  <key>CFBundleVersion</key><string>" + version + "</string>\n");
    bufPushStr(b, "  <key>LSMinimumSystemVersion</key><string>" + minOs + "</string>\n");
    bufPushStr(b, "  <key>NSHighResolutionCapable</key><true/>\n");
    if (lsuiElement) bufPushStr(b, "  <key>LSUIElement</key><true/>\n") else ();
    match iconFileOpt {
        Some(ic) -> bufPushStr(b, "  <key>CFBundleIconFile</key><string>" + ic + "</string>\n"),
        None -> (),
    };
    bufPushStr(b, "</dict>\n</plist>\n");
    bufToString(b)
}

def generateDefaultIosPlist(
    bundleId: String,
    bundleName: String,
    version: String,
    minOs: String,
    isExtension: Bool,
    extensionPointOpt: Option String,
    principalClassOpt: Option String
): String = {
    let b = bufNew();
    bufPushStr(b, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    bufPushStr(b, "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n");
    bufPushStr(b, "<plist version=\"1.0\">\n<dict>\n");
    bufPushStr(b, "  <key>CFBundleDevelopmentRegion</key><string>en</string>\n");
    bufPushStr(b, "  <key>CFBundleExecutable</key><string>" + bundleName + "</string>\n");
    bufPushStr(b, "  <key>CFBundleIdentifier</key><string>" + bundleId + "</string>\n");
    bufPushStr(b, "  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>\n");
    bufPushStr(b, "  <key>CFBundleName</key><string>" + bundleName + "</string>\n");
    bufPushStr(b, "  <key>CFBundlePackageType</key><string>" + (if (isExtension) "XPC!" else "APPL") + "</string>\n");
    bufPushStr(b, "  <key>CFBundleShortVersionString</key><string>" + version + "</string>\n");
    bufPushStr(b, "  <key>CFBundleVersion</key><string>" + version + "</string>\n");
    bufPushStr(b, "  <key>MinimumOSVersion</key><string>" + minOs + "</string>\n");
    bufPushStr(b, "  <key>LSRequiresIPhoneOS</key><true/>\n");
    bufPushStr(b, "  <key>UILaunchScreen</key><dict/>\n");
    if (isExtension) {
        let pCls = match principalClassOpt { Some(c) -> c, None -> bundleName + "ViewController" };
        bufPushStr(b, "  <key>NSExtension</key>\n  <dict>\n");
        match extensionPointOpt {
            Some(ep) -> bufPushStr(b, "    <key>NSExtensionPointIdentifier</key><string>" + ep + "</string>\n"),
            None -> (),
        };
        bufPushStr(b, "    <key>NSExtensionPrincipalClass</key><string>" + pCls + "</string>\n");
        bufPushStr(b, "  </dict>\n")
    } else ();
    bufPushStr(b, "</dict>\n</plist>\n");
    bufToString(b)
}

def copyPathsIntoDir(paths: List String, dstDir: String): Result Void String = match paths {
    Nil -> Ok(()),
    Cons(src, rest) -> {
        let cmd = "cp -R " + shellQuote(src) + " " + shellQuote(dstDir) + "/";
        if (shell(cmd) != 0) Err("failed to copy bundle resource '" + src + "' into '" + dstDir + "'")
        else copyPathsIntoDir(rest, dstDir)
    },
}

def emitAppleBundleFromIrDebug(
    target: String,
    llText: String,
    tc: TargetCfg,
    ab: AppleBundleCfg,
    pkgName: String,
    pkgVersion: String,
    outDirOrBundleOpt: Option String,
    rtOverrideOpt: Option String,
    debugInfo: Bool,
    optFlag: String
): Result String String = {
    if (currentHostOs() != "macos") {
        Err("Apple bundle target '" + target + "' requires macOS with Xcode Command Line Tools")
    } else {
        let isMacos = target == "macos-app";
        let isIosSim = target == "ios-sim-app";
        let isExt = !isMacos && ab.abIsExtension;
        let bundleName = match ab.abBundleName { Some(n) -> n, None -> pkgName };
        let bundleId = match ab.abBundleId { Some(id) -> id, None -> "com.geisha." + pkgName };
        let version = match ab.abVersion { Some(v) -> v, None -> pkgVersion };
        let minOs = match ab.abMinOs { Some(m) -> m, None -> if (isMacos) "14.0" else "16.0" };
        let extSuffix = if (isExt) ".appex" else ".app";
        let bundlePath = match outDirOrBundleOpt {
            Some(p) ->
                if (strEndsWith(p, ".app") || strEndsWith(p, ".appex")) p
                else pathJoin(p, bundleName + extSuffix),
            None -> bundleName + extSuffix,
        };
        let contentsDir = if (isMacos) pathJoin(bundlePath, "Contents") else bundlePath;
        let execDir = if (isMacos) pathJoin(contentsDir, "MacOS") else bundlePath;
        let resDir = if (isMacos) pathJoin(contentsDir, "Resources") else bundlePath;
        let binPath = pathJoin(execDir, bundleName);
        mkdirAll(execDir)?;
        mkdirAll(resDir)?;

        let rtTarget = if (isMacos) "native" else if (isIosSim) "ios-sim" else "ios";
        let rtArchive = resolveRuntimeArchiveForTarget(rtTarget, rtOverrideOpt)?;
        let tmpLl = binPath + ".tmp.ll";
        let tmpObj = binPath + ".tmp.o";
        writeFile(tmpLl, llText)?;

        let hostArch = currentHostArch();
        let compilePrefix =
            if (isMacos) {
                "MACOSX_DEPLOYMENT_TARGET=" + minOs + " " + shellQuote(resolveNativeCc())
                + " -target " + hostArch + "-apple-macosx" + minOs
            } else if (isIosSim) {
                "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=" + minOs
                + " xcrun --sdk iphonesimulator clang -target arm64-apple-ios" + minOs + "-simulator"
            } else {
                "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=" + minOs
                + " xcrun --sdk iphoneos clang -target arm64-apple-ios" + minOs
            };
        let extFlags = if (isExt) " -fapplication-extension" else "";
        let extLinkFlags = if (isExt) " -fapplication-extension -e _NSExtensionMain" else "";
        let cDbgFlag = if (debugInfo) " -g" else "";
        let effOptFlag = match tc.tcOptLevel { Some(lvl) -> " -O" + lvl, None -> optFlag };

        let cmdObj =
            compilePrefix + extFlags + effOptFlag + " -Wno-override-module -x ir -c "
            + shellQuote(tmpLl) + " -o " + shellQuote(tmpObj);
        let rc1 = shell(cmdObj);
        let _ = removeFile(tmpLl);
        if (rc1 != 0) {
            let _ = removeFile(tmpObj);
            Err("LLVM backend failed compiling object for Apple bundle '" + bundlePath + "'")
        } else {
            let cmdLink =
                compilePrefix + extLinkFlags + effOptFlag + cDbgFlag + " -pthread"
                + shellQuoteArgs(tc.tcCFlags)
                + shellQuoteArgs(tc.tcCSources)
                + " " + shellQuote(tmpObj)
                + " " + shellQuote(rtArchive)
                + shellQuoteArgs(tc.tcLinkFlags)
                + " -o " + shellQuote(binPath);
            let rc2 = shell(cmdLink);
            let rcDsym =
                if (rc2 == 0 && debugInfo) {
                    shell("dsymutil " + shellQuote(binPath))
                } else 0;
            let _ = removeFile(tmpObj);
            if (rc2 != 0) {
                Err("Linker failed while building Apple bundle '" + bundlePath + "'")
            } else if (rcDsym != 0) {
                Err("dsymutil failed while generating dSYM bundle for '" + binPath + "'")
            } else {
                // Copy icon & resources
                let iconFileOpt = match ab.abIcon {
                    Some(icPath) -> {
                        let _ = copyPathsIntoDir([icPath], resDir)?;
                        Some(pathBasename(icPath))
                    },
                    None -> None,
                };
                let _ = copyPathsIntoDir(ab.abResources, resDir)?;

                // Write or copy Info.plist
                let plistDst = pathJoin(contentsDir, "Info.plist");
                let _ = match ab.abInfoPlist {
                    Some(srcPlist) -> {
                        let rawP = readFile(srcPlist)?;
                        writeFile(plistDst, rawP)
                    },
                    None -> {
                        let genP =
                            if (isMacos) generateDefaultMacosPlist(bundleId, bundleName, version, minOs, ab.abLsuiElement, iconFileOpt)
                            else generateDefaultIosPlist(bundleId, bundleName, version, minOs, isExt, ab.abExtensionPoint, ab.abPrincipalClass);
                        writeFile(plistDst, genP)
                    },
                }?;

                // Copy iOS provisioning profile if provided
                let _ = match ab.abProvisioningProfile {
                    Some(prov) -> {
                        let dstProv = pathJoin(bundlePath, "embedded.mobileprovision");
                        if (shell("cp " + shellQuote(prov) + " " + shellQuote(dstProv)) != 0) {
                            Err("failed to copy provisioning profile '" + prov + "'")
                        } else Ok(())
                    },
                    None -> Ok(()),
                }?;

                // Embed nested extensions (e.g. PlugIns/JuxuKeyboard.appex)
                let _ = match ab.abEmbedExtensions {
                    Nil -> Ok(()),
                    exts -> {
                        let pluginsDir = pathJoin(contentsDir, "PlugIns");
                        mkdirAll(pluginsDir)?;
                        copyPathsIntoDir(exts, pluginsDir)
                    },
                }?;

                // Code sign bundle
                let signId = match ab.abCodesign { Some(s) -> s, None -> "-" };
                if (strLen(signId) > 0 && signId != "none") {
                    let entFlag = match ab.abEntitlements {
                        Some(ep) -> " --entitlements " + shellQuote(ep),
                        None -> "",
                    };
                    let rtOptFlag = if (isMacos && signId != "-") " --options runtime" else "";
                    let signCmd =
                        "codesign --force --sign " + shellQuote(signId)
                        + rtOptFlag + entFlag + " " + shellQuote(bundlePath);
                    if (shell(signCmd) != 0) {
                        Err("codesign failed for Apple bundle '" + bundlePath + "'")
                    } else Ok(bundlePath)
                } else {
                    Ok(bundlePath)
                }
            }
        }
    }
}

def compileLoadedDefsToCgusForArchDebug(
    rawDefs: List ast.Def,
    dumpCoreOpt: Option String,
    isWasm: Bool,
    targetArch: String,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String,
    debugInfo: Bool,
    singleCgu: Bool
): Result (List CguIr) String = {
    let inf = inferProgram(rawDefs)?;
    let coreProg = lowerToCoreOpt(inf, true, !debugInfo)?;
    maybeDumpCoreIr(coreProg, dumpCoreOpt)?;
    let targetOs = if (isWasm) "wasm" else currentHostOs();
    if (singleCgu) {
        Ok([MkCguIr {
            cguName: "all",
            cguIr: emitProgramLlvmIrForTargetDebug(coreProg, isWasm, targetArch, targetOs, exports, noMain, bootSymOpt, debugInfo),
        }])
    } else {
        Ok(emitProgramLlvmIrCgusForTargetDebug(coreProg, isWasm, targetArch, targetOs, exports, noMain, bootSymOpt, debugInfo))
    }
}

def compileWithPkgSpecsToCgusForArchDebug(
    entryFile: String,
    useProjectLoader: Bool,
    rootSpec: PkgSpec,
    extSpecs: List PkgSpec,
    libPaths: List String,
    dumpCoreOpt: Option String,
    isWasm: Bool,
    targetArch: String,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String,
    debugInfo: Bool,
    singleCgu: Bool
): Result (List CguIr) String = {
    let rawDefs =
        if (useProjectLoader) {
            loadProjectProgramWithPkgs(entryFile, rootSpec, extSpecs, libPaths)?
        } else {
            let src = readFile(entryFile)?;
            loadSingleSourceProgramWithPkgsNamed(entryFile, src, rootSpec, extSpecs, libPaths)?
        };
    compileLoadedDefsToCgusForArchDebug(rawDefs, dumpCoreOpt, isWasm, targetArch, exports, noMain, bootSymOpt, debugInfo, singleCgu)
}

def resolveMaxJobs(): Int =
    match getEnv("GEISHA_JOBS") {
        Some(s) -> match parseInt(s) {
            Ok(n) if (n >= 1 && n <= 32) -> n,
            _ -> 8,
        },
        None -> 8,
    }

def optFlagForLevel(optLevel: String): String =
    "-O" + optLevel

def defaultGlobalCacheDir(): String =
    pathJoin(geishaHomeDir(), "cache")

def effectiveCacheDir(cacheDirOpt: Option String): String =
    match cacheDirOpt {
        Some(d) -> d,
        None -> defaultGlobalCacheDir(),
    }

def compilerSupportsDepfile(compiler: String): Bool = {
    let b = pathBasename(compiler);
    b == "clang" || b == "clang++" || b == "gcc" || b == "g++" || b == "cc" || b == "c++"
    || strStartsWith(b, "clang-") || strStartsWith(b, "clang++-")
    || strStartsWith(b, "gcc-") || strStartsWith(b, "g++-")
}

def findDepColonIndex(s: String): Int = {
    let n = strLen(s);
    let i = cellNew(0);
    let found = cellNew(-1);
    while (cellGet(i) < n && cellGet(found) < 0) {
        let p = cellGet(i);
        if (strByteAt(s, p) == 58) {
            if (p + 1 >= n) cellSet(found, p)
            else {
                let nb = strByteAt(s, p + 1);
                if (nb == 32 || nb == 9 || nb == 10 || nb == 13) cellSet(found, p) else ()
            }
        } else ();
        cellSet(i, p + 1)
    };
    cellGet(found)
}

def parseMakeDepfile(content: String): List String = {
    let n = strLen(content);
    let start = findDepColonIndex(content);
    if (start < 0) Nil
    else {
        let deps = cellNew(Nil);
        let i = cellNew(start + 1);
        let tok = cellNew(bufNew());
        let flushTok = () -> {
            let s = bufToString(cellGet(tok));
            if (strLen(s) > 0) {
                cellSet(deps, addUniqueStr(cellGet(deps), s));
                cellSet(tok, bufNew())
            } else ()
        };
        while (cellGet(i) < n) {
            let p = cellGet(i);
            let ch = strByteAt(content, p);
            if (ch == 92 && p + 1 < n) {
                let nx = strByteAt(content, p + 1);
                if (nx == 10) {
                    flushTok();
                    cellSet(i, p + 2)
                } else if (nx == 13 && p + 2 < n && strByteAt(content, p + 2) == 10) {
                    flushTok();
                    cellSet(i, p + 3)
                } else if (nx == 32 || nx == 92 || nx == 35 || nx == 58) {
                    bufPushByte(cellGet(tok), nx);
                    cellSet(i, p + 2)
                } else {
                    bufPushByte(cellGet(tok), ch);
                    cellSet(i, p + 1)
                }
            } else if (ch == 36 && p + 1 < n && strByteAt(content, p + 1) == 36) {
                bufPushByte(cellGet(tok), 36);
                cellSet(i, p + 2)
            } else if (ch == 32 || ch == 9 || ch == 10 || ch == 13) {
                flushTok();
                cellSet(i, p + 1)
            } else {
                bufPushByte(cellGet(tok), ch);
                cellSet(i, p + 1)
            }
        };
        flushTok();
        cellGet(deps)
    }
}

def readPathsFromDepsFile(depsPath: String): List String = match readFile(depsPath) {
    Err(_) -> Nil,
    Ok(content) -> {
        let out = cellNew(Nil);
        let cur = cellNew(strSplitChar(content, '\n'));
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(line, rest) -> {
                    if (strLen(line) > 0) {
                        match strIndexOfByte(line, 9, 0) {
                            Some(tabIdx) if (tabIdx > 0 && tabIdx + 1 < strLen(line)) ->
                                cellSet(out, addUniqueStr(cellGet(out), strSlice(line, tabIdx + 1, strLen(line)))),
                            _ -> (),
                        }
                    } else ();
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        };
        cellGet(out)
    },
}

def writeNativeDepManifest(depsPath: String, depPaths: List String): Result Bool String =
    match depPaths {
        Nil -> Ok(false),
        _ -> {
            let out = bufNew();
            let allOk = cellNew(true);
            let cur = cellNew(sortUniqueStrings(depPaths));
            while (cellGet(allOk) && match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(fp, r) -> {
                        if (strLen(fp) == 0 || !fileExists(fp)) {
                            cellSet(allOk, false)
                        } else {
                            match readFile(fp) {
                                Ok(bytes) -> {
                                    bufPushStr(out, sha256Hex(bytes));
                                    bufPushByte(out, 9);
                                    bufPushStr(out, fp);
                                    bufPushByte(out, 10)
                                },
                                Err(_) -> cellSet(allOk, false),
                            }
                        };
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            if (!cellGet(allOk)) Ok(false)
            else {
                let tmpDeps = depsPath + ".tmp." + intToStr(c_getpid());
                writeFile(tmpDeps, bufToString(out))?;
                if (c_rename(tmpDeps, depsPath) != 0) {
                    let _ = removeFile(tmpDeps);
                    Err("Failed to commit native depfile manifest '" + depsPath + "'")
                } else Ok(true)
            }
        },
    }

data PendingCcJob {
    MkPendingCcJob {
        pjTmpLl: String,
        pjTmpObj: String,
        pjDstObj: String,
        pjProg: String,
        pjArgs: List String,
        pjEnv: List (String, String),
    },
}

data ActiveCcJob {
    MkActiveCcJob {
        ajJob: PendingCcJob,
        ajPid: Int,
    },
}

def packSpawnArgBlob(prog: String, args: List String): (String, Int) = {
    let b = bufNew();
    bufPushStr(b, prog);
    bufPushByte(b, 0);
    let count = cellNew(1);
    let cur = cellNew(args);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(a, r) -> {
                bufPushStr(b, a);
                bufPushByte(b, 0);
                cellSet(count, cellGet(count) + 1);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (bufToString(b), cellGet(count))
}

def packSpawnEnvBlob(pairs: List (String, String)): (String, Int) = {
    let b = bufNew();
    let count = cellNew(0);
    let cur = cellNew(pairs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((k, v), r) -> {
                bufPushStr(b, k);
                bufPushByte(b, 61);
                bufPushStr(b, v);
                bufPushByte(b, 0);
                cellSet(count, cellGet(count) + 1);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (bufToString(b), cellGet(count))
}

def spawnDirectCcJob(job: PendingCcJob): Result Int String = {
    let (argBlob, argc) = packSpawnArgBlob(job.pjProg, job.pjArgs);
    let (envMode, envBlob, envc) = match job.pjEnv {
        Nil -> (0, "", 0),
        evs -> {
            let (eb, ec) = packSpawnEnvBlob(evs);
            (1, eb, ec)
        },
    };
    let outInts = ptrAllocBytes(16);
    let rc = c_proc_spawn(job.pjProg, argBlob, argc, "", envMode, envBlob, envc, 0, 0, outInts);
    if (rc != 0) Err("failed to spawn process: " + job.pjProg)
    else {
        let pid =
            (ptrByteAt(outInts, 0) & 255)
            | ((ptrByteAt(outInts, 1) & 255) << 8)
            | ((ptrByteAt(outInts, 2) & 255) << 16)
            | ((ptrByteAt(outInts, 3) & 255) << 24);
        Ok(pid)
    }
}

def makeCompileIrJob(
    cguLlPath: String,
    tmpObjPath: String,
    dstObjPath: String,
    target: String,
    optLevel: String,
    optDebug: Bool,
    minOs: String,
    isExt: Bool
): PendingCcJob = {
    let optFlag = optFlagForLevel(optLevel);
    let dbgArgs = if (optDebug) ["-g"] else Nil;
    if (target == "wasm32") {
        let wasmCc = resolveWasmCc();
        MkPendingCcJob {
            pjTmpLl: cguLlPath,
            pjTmpObj: tmpObjPath,
            pjDstObj: dstObjPath,
            pjProg: wasmCc,
            pjArgs: listAppend(["--target=wasm32", optFlag], listAppend(dbgArgs, ["-mbulk-memory", "-mnontrapping-fptoint", "-Wno-override-module", "-nostdlib", "-x", "ir", "-c", cguLlPath, "-o", tmpObjPath])),
            pjEnv: Nil,
        }
    } else if (target == "ios" || target == "ios-app") {
        let basePrefix = if (isExt) ["--sdk", "iphoneos", "clang", "-target", "arm64-apple-ios" + minOs, "-fapplication-extension"] else ["--sdk", "iphoneos", "clang", "-target", "arm64-apple-ios" + minOs];
        let args = listAppend(basePrefix, listAppend(Cons(optFlag, dbgArgs), ["-Wno-override-module", "-x", "ir", "-c", cguLlPath, "-o", tmpObjPath]));
        MkPendingCcJob {
            pjTmpLl: cguLlPath,
            pjTmpObj: tmpObjPath,
            pjDstObj: dstObjPath,
            pjProg: "xcrun",
            pjArgs: args,
            pjEnv: [("DEVELOPER_DIR", "/Applications/Xcode.app/Contents/Developer"), ("IPHONEOS_DEPLOYMENT_TARGET", minOs)],
        }
    } else if (target == "ios-sim" || target == "ios-sim-app") {
        let basePrefix = if (isExt) ["--sdk", "iphonesimulator", "clang", "-target", "arm64-apple-ios" + minOs + "-simulator", "-fapplication-extension"] else ["--sdk", "iphonesimulator", "clang", "-target", "arm64-apple-ios" + minOs + "-simulator"];
        let args = listAppend(basePrefix, listAppend(Cons(optFlag, dbgArgs), ["-Wno-override-module", "-x", "ir", "-c", cguLlPath, "-o", tmpObjPath]));
        MkPendingCcJob {
            pjTmpLl: cguLlPath,
            pjTmpObj: tmpObjPath,
            pjDstObj: dstObjPath,
            pjProg: "xcrun",
            pjArgs: args,
            pjEnv: [("DEVELOPER_DIR", "/Applications/Xcode.app/Contents/Developer"), ("IPHONEOS_DEPLOYMENT_TARGET", minOs)],
        }
    } else {
        let ccBin = resolveNativeCc();
        let isMac = currentHostOs() == "macos";
        let hostArch = currentHostArch();
        let hasSpace = match strIndexOfByte(ccBin, 32, 0) { Some(_) -> true, None -> false };
        let macEnv = if (isMac) [("MACOSX_DEPLOYMENT_TARGET", minOs)] else Nil;
        if (hasSpace && !fileExists(ccBin) && currentHostOs() != "windows") {
            let tgtFlag = if (isMac && (hostArch == "arm64" || hostArch == "x86_64")) " -target " + hostArch + "-apple-macosx" + minOs else "";
            let dbgStr = if (optDebug) " -g" else "";
            let shCmd = ccBin + tgtFlag + " " + optFlag + dbgStr + " -Wno-override-module -x ir -c " + shellQuote(cguLlPath) + " -o " + shellQuote(tmpObjPath);
            MkPendingCcJob {
                pjTmpLl: cguLlPath,
                pjTmpObj: tmpObjPath,
                pjDstObj: dstObjPath,
                pjProg: "/bin/sh",
                pjArgs: ["-c", shCmd],
                pjEnv: macEnv,
            }
        } else {
            let macPrefix =
                if (isMac && (hostArch == "arm64" || hostArch == "x86_64")) ["-target", hostArch + "-apple-macosx" + minOs]
                else Nil;
            let args = listAppend(macPrefix, listAppend(Cons(optFlag, dbgArgs), ["-Wno-override-module", "-x", "ir", "-c", cguLlPath, "-o", tmpObjPath]));
            MkPendingCcJob {
                pjTmpLl: cguLlPath,
                pjTmpObj: tmpObjPath,
                pjDstObj: dstObjPath,
                pjProg: ccBin,
                pjArgs: args,
                pjEnv: macEnv,
            }
        }
    }
}

def runPendingCcJobsParallel(jobs: List PendingCcJob, maxJobs: Int): Result Void String = {
    let remaining = cellNew(jobs);
    let errOpt: Cell (Option String) = cellNew(None);
    while (match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(remaining) { Nil -> false, _ -> true }) {
        let activeRev: Cell (List ActiveCcJob) = cellNew(Nil);
        let launched = cellNew(0);
        while (cellGet(launched) < maxJobs && match cellGet(errOpt) { None -> true, Some(_) -> false } && match cellGet(remaining) { Nil -> false, _ -> true }) {
            match cellGet(remaining) {
                Cons(job, rest) -> {
                    cellSet(remaining, rest);
                    match spawnDirectCcJob(job) {
                        Ok(pid) -> {
                            cellSet(activeRev, Cons(MkActiveCcJob { ajJob: job, ajPid: pid }, cellGet(activeRev)));
                            cellSet(launched, cellGet(launched) + 1)
                        },
                        Err(e) -> {
                            let _ = removeFile(job.pjTmpLl);
                            let _ = removeFile(job.pjTmpObj);
                            cellSet(errOpt, Some("Failed to spawn LLVM backend '" + job.pjProg + "': " + e))
                        },
                    }
                },
                Nil -> (),
            }
        };
        let ca = cellNew(listRev(cellGet(activeRev)));
        while (match cellGet(ca) { Nil -> false, _ -> true }) {
            match cellGet(ca) {
                Cons(act, restA) -> {
                    let j = act.ajJob;
                    let rawW = c_proc_wait(act.ajPid, 0);
                    let tag = i64ToInt(rawW >>> 32);
                    let lowMask = (intToI64(65535) << 16) | intToI64(65535);
                    let code = i64ToInt(rawW & lowMask);
                    if (rawW <= intToI64(0)) {
                        let _ = removeFile(j.pjTmpLl);
                        let _ = removeFile(j.pjTmpObj);
                        if (match cellGet(errOpt) { None -> true, Some(_) -> false }) {
                            cellSet(errOpt, Some("Failed waiting for C/LLVM backend"))
                        } else ()
                    } else if (tag == 1 && code == 0) {
                        let _ = removeFile(j.pjTmpLl);
                        if (c_rename(j.pjTmpObj, j.pjDstObj) != 0) {
                            let _ = removeFile(j.pjTmpObj);
                            if (match cellGet(errOpt) { None -> true, Some(_) -> false }) {
                                cellSet(errOpt, Some("Failed to commit cached object '" + j.pjDstObj + "'"))
                            } else ()
                        } else ()
                    } else if (tag == 2) {
                        let _ = removeFile(j.pjTmpLl);
                        let _ = removeFile(j.pjTmpObj);
                        if (match cellGet(errOpt) { None -> true, Some(_) -> false }) {
                            cellSet(errOpt, Some("C/LLVM backend killed by signal " + intToStr(code)))
                        } else ()
                    } else {
                        let _ = removeFile(j.pjTmpLl);
                        let _ = removeFile(j.pjTmpObj);
                        if (match cellGet(errOpt) { None -> true, Some(_) -> false }) {
                            cellSet(errOpt, Some("C/LLVM backend failed (exit " + intToStr(code) + ") while compiling CGU object"))
                        } else ()
                    };
                    cellSet(ca, restA)
                },
                Nil -> (),
            }
        }
    };
    let cr = cellNew(cellGet(remaining));
    while (match cellGet(cr) { Nil -> false, _ -> true }) {
        match cellGet(cr) {
            Cons(j, rest) -> {
                let _ = removeFile(j.pjTmpLl);
                let _ = removeFile(j.pjTmpObj);
                cellSet(cr, rest)
            },
            Nil -> (),
        }
    };
    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None -> Ok(()),
    }
}

def compileCgusToCachedObjs(
    cgus: List CguIr,
    cacheDir: String,
    noCache: Bool,
    target: String,
    optLevel: String,
    optDebug: Bool,
    minOs: String,
    isExt: Bool
): Result (List String, Int, Int) String = {
    let cguDir = pathJoin(cacheDir, "cgu");
    mkdirAll(cguDir)?;
    let ccFp =
        if (target == "wasm32") resolveWasmCc()
        else resolveNativeCc() + "|" + currentHostOs() + "|" + currentHostArch();
    let keyPrefix = "cgu-v3|" + target + "|O" + optLevel + "|dbg" + (if (optDebug) "1" else "0") + "|" + minOs + "|" + (if (isExt) "ext" else "app") + "|" + ccFp + "\n";
    let pidStr = intToStr(c_getpid());

    let objsRev = cellNew(Nil);
    let jobsRev = cellNew(Nil);
    let hits = cellNew(0);
    let misses = cellNew(0);
    let idx = cellNew(0);
    let cur = cellNew(cgus);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(cgu, rest) -> {
                let i = cellGet(idx);
                cellSet(idx, i + 1);
                let h = strSlice(sha256Hex(keyPrefix + cgu.cguIr), 0, 24);
                let objPath = pathJoin(cguDir, "cgu_" + h + ".o");
                cellSet(objsRev, Cons(objPath, cellGet(objsRev)));
                if (!noCache && fileExists(objPath)) {
                    cellSet(hits, cellGet(hits) + 1)
                } else {
                    let tmpLl = objPath + ".tmp." + pidStr + "." + intToStr(i) + ".ll";
                    let tmpObj = objPath + ".tmp." + pidStr + "." + intToStr(i) + ".o";
                    writeFile(tmpLl, cgu.cguIr)?;
                    let job = makeCompileIrJob(tmpLl, tmpObj, objPath, target, optLevel, optDebug, minOs, isExt);
                    cellSet(jobsRev, Cons(job, cellGet(jobsRev)));
                    cellSet(misses, cellGet(misses) + 1)
                };
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    let jobs = listRev(cellGet(jobsRev));
    match jobs {
        Nil -> (),
        _ -> runPendingCcJobsParallel(jobs, resolveMaxJobs())?,
    };
    Ok((listRev(cellGet(objsRev)), cellGet(hits), cellGet(misses)))
}

def compileNativeUnitCached(
    cacheDir: String,
    noCache: Bool,
    compiler: String,
    envPfx: String,
    flags: List String,
    optDebug: Bool,
    srcPath: String,
    idx: Int
): Result (String, Bool, Bool, List String) String = {
    let natDir = pathJoin(cacheDir, "native");
    mkdirAll(natDir)?;
    let effFlags = if (optDebug) Cons("-g", flags) else flags;
    let canDep = compilerSupportsDepfile(compiler);
    if (!canDep) {
        let tmpObj = pathJoin(natDir, "uncached_" + intToStr(c_getpid()) + "_" + intToStr(idx) + ".o");
        let argsU = listAppend(effFlags, ["-c", srcPath, "-o", tmpObj]);
        let rc = runHostProc(compiler, argsU, nativeEnvVars());
        if (rc != 0) {
            let _ = removeFile(tmpObj);
            Err("Native compiler '" + compiler + "' failed on '" + srcPath + "'")
        } else {
            Ok((tmpObj, false, false, Nil))
        }
    } else {
        let srcBytes = match readFile(srcPath) { Ok(s) -> s, Err(_) -> "" };
        let keyStr =
            "nat-v4|" + compiler + "|" + envPfx + "|dbg" + (if (optDebug) "1" else "0") + "|" + strJoin(effFlags, "\n")
            + "|" + srcPath + "\n" + srcBytes;
        let h = strSlice(sha256Hex(keyStr), 0, 24);
        let objPath = pathJoin(natDir, "nat_" + h + ".o");
        let depsPath = objPath + ".deps";
        if (!noCache && strLen(srcBytes) > 0 && fileExists(objPath) && verifyScriptDeps(depsPath)) {
            Ok((objPath, true, true, readPathsFromDepsFile(depsPath)))
        } else {
            let pidStr = intToStr(c_getpid());
            let tmpObj = objPath + ".tmp." + pidStr + "." + intToStr(idx) + ".o";
            let tmpDep = objPath + ".tmp." + pidStr + "." + intToStr(idx) + ".d";
            let argsU = listAppend(effFlags, ["-MD", "-MF", tmpDep, "-c", srcPath, "-o", tmpObj]);
            let rc = runHostProc(compiler, argsU, nativeEnvVars());
            if (rc != 0) {
                let _ = removeFile(tmpObj);
                let _ = removeFile(tmpDep);
                Err("Native compiler '" + compiler + "' failed on '" + srcPath + "'")
            } else {
                let parsedDepsOpt =
                    if (!fileExists(tmpDep)) None
                    else match readFile(tmpDep) {
                        Err(_) -> None,
                        Ok(depContent) -> match parseMakeDepfile(depContent) {
                            Nil -> None,
                            ds -> Some(addUniqueStr(ds, srcPath)),
                        },
                    };
                let _ = removeFile(tmpDep);
                let keepUncached = () -> {
                    let uncachedObj = pathJoin(natDir, "uncached_" + pidStr + "_" + intToStr(idx) + ".o");
                    if (c_rename(tmpObj, uncachedObj) != 0) {
                        let _ = removeFile(tmpObj);
                        Err("Failed to stage uncached native object '" + uncachedObj + "'")
                    } else {
                        Ok((uncachedObj, false, false, Nil))
                    }
                };
                match parsedDepsOpt {
                    None -> keepUncached(),
                    Some(depPaths) -> {
                        let manifestOk = writeNativeDepManifest(depsPath, depPaths)?;
                        if (!manifestOk) {
                            keepUncached()
                        } else if (c_rename(tmpObj, objPath) != 0) {
                            let _ = removeFile(tmpObj);
                            Err("Failed to commit cached native object '" + objPath + "'")
                        } else {
                            Ok((objPath, false, true, depPaths))
                        }
                    },
                }
            }
        }
    }
}

def compileTargetNativeSourcesCached(
    cacheDir: String,
    noCache: Bool,
    tc: TargetCfg,
    ccBin: String,
    envPfx: String,
    targetFlags: List String,
    optFlag: String,
    optDebug: Bool
): Result (List String, Int, Int, Bool, List String) String = {
    let objsRev = cellNew(Nil);
    let hits = cellNew(0);
    let misses = cellNew(0);
    let allCacheable = cellNew(true);
    let allDepPaths = cellNew(Nil);
    let idx = cellNew(0);
    let mergeDeps = (ps: List String) -> {
        let cp = cellNew(ps);
        while (match cellGet(cp) { Nil -> false, _ -> true }) {
            match cellGet(cp) {
                Cons(p, r) -> { cellSet(allDepPaths, addUniqueStr(cellGet(allDepPaths), p)); cellSet(cp, r) },
                Nil -> (),
            }
        }
    };

    let cFlagsAll = listAppend(targetFlags, Cons(optFlag, tc.tcCFlags));
    let cs0 = cellNew(tc.tcCSources);
    while (match cellGet(cs0) { Nil -> false, _ -> true }) {
        match cellGet(cs0) {
            Cons(srcPath, rest) -> {
                let (op, hit, cacheable, deps) = compileNativeUnitCached(cacheDir, noCache, ccBin, envPfx, cFlagsAll, optDebug, srcPath, cellGet(idx))?;
                cellSet(idx, cellGet(idx) + 1);
                cellSet(objsRev, Cons(op, cellGet(objsRev)));
                if (hit) cellSet(hits, cellGet(hits) + 1) else cellSet(misses, cellGet(misses) + 1);
                if (!cacheable) cellSet(allCacheable, false) else mergeDeps(deps);
                cellSet(cs0, rest)
            },
            Nil -> (),
        }
    };

    let cu = cellNew(tc.tcExtraUnits);
    while (match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons(u, ru) -> {
                let cs = cellNew(u.nuSources);
                while (match cellGet(cs) { Nil -> false, _ -> true }) {
                    match cellGet(cs) {
                        Cons(srcPath, rs) -> {
                            let (op, hit, cacheable, deps) = compileNativeUnitCached(cacheDir, noCache, u.nuCompiler, envPfx, u.nuFlags, optDebug, srcPath, cellGet(idx))?;
                            cellSet(idx, cellGet(idx) + 1);
                            cellSet(objsRev, Cons(op, cellGet(objsRev)));
                            if (hit) cellSet(hits, cellGet(hits) + 1) else cellSet(misses, cellGet(misses) + 1);
                            if (!cacheable) cellSet(allCacheable, false) else mergeDeps(deps);
                            cellSet(cs, rs)
                        },
                        Nil -> (),
                    }
                };
                cellSet(cu, ru)
            },
            Nil -> (),
        }
    };

    Ok((listRev(cellGet(objsRev)), cellGet(hits), cellGet(misses), cellGet(allCacheable), cellGet(allDepPaths)))
}

def maybePrintCacheStats(cguTotal: Int, cguHit: Int, cguMiss: Int, natHit: Int, natMiss: Int, optLevel: String): Void =
    match getEnv("GEISHA_CACHE_STATS") {
        Some("1") ->
            eprintLn(
                "[geisha-cache] cgu_total=" + intToStr(cguTotal)
                + " cgu_hit=" + intToStr(cguHit)
                + " cgu_miss=" + intToStr(cguMiss)
                + " native_hit=" + intToStr(natHit)
                + " native_miss=" + intToStr(natMiss)
                + " opt=" + optFlagForLevel(optLevel)
            ),
        _ -> (),
    }

def emitNativeExecutableFromCgus(
    cgus: List CguIr,
    outBin: String,
    tc: TargetCfg,
    rtOverrideOpt: Option String,
    cacheDir: String,
    optLevel: String,
    optDebug: Bool,
    noCache: Bool
): Result (Bool, List String) String = {
    let rtArchive = resolveRuntimeArchive(rtOverrideOpt)?;
    let ccBin = resolveNativeCc();
    let envPfx = nativeEnvPrefix();
    let targetArchFlag = nativeTargetFlag();
    let sysLibs = nativeSysLibs();
    let optFlag = optFlagForLevel(optLevel);
    let minOs = "14.0";

    let (cguObjs, cguHit, cguMiss) = compileCgusToCachedObjs(cgus, cacheDir, noCache, "native", optLevel, optDebug, minOs, false)?;
    let macTgtList =
        if (currentHostOs() == "macos" && (currentHostArch() == "arm64" || currentHostArch() == "x86_64")) {
            ["-target", currentHostArch() + "-apple-macosx" + minOs]
        } else Nil;
    let (natObjs, natHit, natMiss, natCacheable, natDepPaths) = compileTargetNativeSourcesCached(cacheDir, noCache, tc, ccBin, envPfx, macTgtList, optFlag, optDebug)?;
    maybePrintCacheStats(listLen(cgus), cguHit, cguMiss, natHit, natMiss, optLevel);

    let dbgArgs = if (optDebug) ["-g"] else Nil;
    let linkArgs = concatArgLists([
        nativeTargetArgs(),
        [optFlag],
        dbgArgs,
        nativePthreadArgs(),
        natObjs,
        cguObjs,
        [rtArchive],
        tc.tcLinkFlags,
        nativeSysLibArgs(),
        ["-o", outBin]
    ]);
    let rc = runHostProc(ccBin, linkArgs, nativeEnvVars());
    let rcDsym =
        if (rc == 0 && optDebug && currentHostOs() == "macos") {
            runHostProc("dsymutil", [outBin], Nil)
        } else 0;
    if (!natCacheable) {
        let co = cellNew(natObjs);
        while (match cellGet(co) { Nil -> false, _ -> true }) {
            match cellGet(co) {
                Cons(op, r) -> {
                    if (strStartsWith(pathBasename(op), "uncached_")) { let _ = removeFile(op); () } else ();
                    cellSet(co, r)
                },
                Nil -> (),
            }
        }
    } else ();
    if (rc != 0) Err("C/LLVM backend failed while linking executable '" + outBin + "'")
    else if (rcDsym != 0) Err("dsymutil failed while generating dSYM bundle for '" + outBin + "'")
    else Ok((natCacheable, natDepPaths))
}

def emitWasmFromCgus(
    cgus: List CguIr,
    outPath: String,
    tc: TargetCfg,
    rtOverrideOpt: Option String,
    cacheDir: String,
    optLevel: String,
    optDebug: Bool,
    noCache: Bool
): Result Void String = {
    let wasmCc = resolveWasmCc();
    let wasmRt = resolveWasmRuntimeObj(rtOverrideOpt)?;
    let optFlag = optFlagForLevel(optLevel);
    let isSizeOpt = optLevel == "z" || optLevel == "s";
    let (cguObjs, cguHit, cguMiss) = compileCgusToCachedObjs(cgus, cacheDir, noCache, "wasm32", optLevel, optDebug, "", false)?;
    maybePrintCacheStats(listLen(cgus), cguHit, cguMiss, 0, 0, optLevel);
    let doStrip = match tc.tcStrip {
        Some(b) -> b,
        None -> isSizeOpt,
    };
    let ldArgs = resolveWasmLdArgs();
    let stripArgs = if (doStrip) ["-Wl,--strip-all"] else Nil;
    let rtExportArgs =
        if (tc.tcSlimRuntime) Nil
        else [
            "-Wl,--export=gs_wasm_gc_collect",
            "-Wl,--export=gs_wasm_alloc",
            "-Wl,--export=gs_wasm_str_len",
            "-Wl,--export=gs_wasm_heap_used",
            "-Wl,--export=gs_wasm_heap_live"
        ];
    let args = concatArgLists([
        ["--target=wasm32", optFlag, "-mbulk-memory", "-mnontrapping-fptoint", "-Wno-override-module", "-nostdlib"],
        ldArgs,
        tc.tcCFlags,
        cguObjs,
        [wasmRt],
        tc.tcCSources,
        tc.tcLinkFlags,
        ["-Wl,--no-entry", "-Wl,--allow-undefined", "-Wl,--gc-sections", "-Wl,--export-table"],
        stripArgs,
        rtExportArgs,
        ["-o", outPath]
    ]);
    let rc = runHostProc(wasmCc, args, Nil);
    if (rc != 0) {
        Err("LLVM wasm32 backend failed while linking '" + outPath + "' (ensure lld/wasm-ld is installed)")
    } else if (isSizeOpt && !isWasmOptDisabled()) {
        match findExeInPath("wasm-opt") {
            Some(wasmOptBin) -> {
                let optArgs = ["-Oz", "--enable-bulk-memory", "--enable-nontrapping-float-to-int", outPath, "-o", outPath];
                let optRc = runHostProc(wasmOptBin, optArgs, Nil);
                if (optRc == 0) Ok(())
                else Err("wasm-opt failed while optimizing '" + outPath + "'")
            },
            None -> Ok(()),
        }
    } else Ok(())
}

def emitAppleBundleFromCgus(
    target: String,
    cgus: List CguIr,
    tc: TargetCfg,
    ab: AppleBundleCfg,
    pkgName: String,
    pkgVersion: String,
    outDirOrBundleOpt: Option String,
    rtOverrideOpt: Option String,
    cacheDir: String,
    optLevel: String,
    optDebug: Bool,
    noCache: Bool
): Result String String = {
    if (currentHostOs() != "macos") {
        Err("Apple bundle target '" + target + "' requires macOS with Xcode Command Line Tools")
    } else {
        let isMacos = target == "macos-app";
        let isIosSim = target == "ios-sim-app";
        let isExt = !isMacos && ab.abIsExtension;
        let bundleName = match ab.abBundleName { Some(n) -> n, None -> pkgName };
        let bundleId = match ab.abBundleId { Some(id) -> id, None -> "com.geisha." + pkgName };
        let version = match ab.abVersion { Some(v) -> v, None -> pkgVersion };
        let minOs = match ab.abMinOs { Some(m) -> m, None -> if (isMacos) "14.0" else "16.0" };
        let extSuffix = if (isExt) ".appex" else ".app";
        let bundlePath = match outDirOrBundleOpt {
            Some(p) ->
                if (strEndsWith(p, ".app") || strEndsWith(p, ".appex")) p
                else pathJoin(p, bundleName + extSuffix),
            None -> bundleName + extSuffix,
        };
        let contentsDir = if (isMacos) pathJoin(bundlePath, "Contents") else bundlePath;
        let execDir = if (isMacos) pathJoin(contentsDir, "MacOS") else bundlePath;
        let resDir = if (isMacos) pathJoin(contentsDir, "Resources") else bundlePath;
        let binPath = pathJoin(execDir, bundleName);
        mkdirAll(execDir)?;
        mkdirAll(resDir)?;

        let rtTarget = if (isMacos) "native" else if (isIosSim) "ios-sim" else "ios";
        let rtArchive = resolveRuntimeArchiveForTarget(rtTarget, rtOverrideOpt)?;
        let optFlag = optFlagForLevel(optLevel);
        let (cguObjs, cguHit, cguMiss) = compileCgusToCachedObjs(cgus, cacheDir, noCache, target, optLevel, optDebug, minOs, isExt)?;
        maybePrintCacheStats(listLen(cgus), cguHit, cguMiss, 0, 0, optLevel);

        let hostArch = currentHostArch();
        let compilePrefix =
            if (isMacos) {
                "MACOSX_DEPLOYMENT_TARGET=" + minOs + " " + shellQuote(resolveNativeCc())
                + " -target " + hostArch + "-apple-macosx" + minOs
            } else if (isIosSim) {
                "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=" + minOs
                + " xcrun --sdk iphonesimulator clang -target arm64-apple-ios" + minOs + "-simulator"
            } else {
                "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer IPHONEOS_DEPLOYMENT_TARGET=" + minOs
                + " xcrun --sdk iphoneos clang -target arm64-apple-ios" + minOs
            };
        let extLinkFlags = if (isExt) " -fapplication-extension -e _NSExtensionMain" else "";
        let cmdLink =
            compilePrefix + extLinkFlags + " " + optFlag + (if (optDebug) " -g" else "") + " -pthread"
            + shellQuoteArgs(tc.tcCFlags)
            + shellQuoteArgs(tc.tcCSources)
            + shellQuoteArgs(cguObjs)
            + " " + shellQuote(rtArchive)
            + shellQuoteArgs(tc.tcLinkFlags)
            + " -o " + shellQuote(binPath);
        let rc2 = shell(cmdLink);
        let rcDsym =
            if (rc2 == 0 && optDebug) {
                shell("dsymutil " + shellQuote(binPath))
            } else 0;
        if (rc2 != 0) {
            Err("Linker failed while building Apple bundle '" + bundlePath + "'")
        } else if (rcDsym != 0) {
            Err("dsymutil failed while generating dSYM bundle for '" + binPath + "'")
        } else {
            let iconFileOpt = match ab.abIcon {
                Some(icPath) -> {
                    let _ = copyPathsIntoDir([icPath], resDir)?;
                    Some(pathBasename(icPath))
                },
                None -> None,
            };
            let _ = copyPathsIntoDir(ab.abResources, resDir)?;
            let plistDst = pathJoin(contentsDir, "Info.plist");
            let _ = match ab.abInfoPlist {
                Some(srcPlist) -> {
                    let rawP = readFile(srcPlist)?;
                    writeFile(plistDst, rawP)
                },
                None -> {
                    let genP =
                        if (isMacos) generateDefaultMacosPlist(bundleId, bundleName, version, minOs, ab.abLsuiElement, iconFileOpt)
                        else generateDefaultIosPlist(bundleId, bundleName, version, minOs, isExt, ab.abExtensionPoint, ab.abPrincipalClass);
                    writeFile(plistDst, genP)
                },
            }?;
            let _ = match ab.abProvisioningProfile {
                Some(prov) -> {
                    let dstProv = pathJoin(bundlePath, "embedded.mobileprovision");
                    if (shell("cp " + shellQuote(prov) + " " + shellQuote(dstProv)) != 0) {
                        Err("failed to copy provisioning profile '" + prov + "'")
                    } else Ok(())
                },
                None -> Ok(()),
            }?;
            let _ = match ab.abEmbedExtensions {
                Nil -> Ok(()),
                exts -> {
                    let pluginsDir = pathJoin(contentsDir, "PlugIns");
                    mkdirAll(pluginsDir)?;
                    copyPathsIntoDir(exts, pluginsDir)
                },
            }?;
            let signId = match ab.abCodesign { Some(s) -> s, None -> "-" };
            if (strLen(signId) > 0 && signId != "none") {
                let entFlag = match ab.abEntitlements {
                    Some(ep) -> " --entitlements " + shellQuote(ep),
                    None -> "",
                };
                let rtOptFlag = if (isMacos && signId != "-") " --options runtime" else "";
                let signCmd =
                    "codesign --force --sign " + shellQuote(signId)
                    + rtOptFlag + entFlag + " " + shellQuote(bundlePath);
                if (shell(signCmd) != 0) {
                    Err("codesign failed for Apple bundle '" + bundlePath + "'")
                } else Ok(bundlePath)
            } else {
                Ok(bundlePath)
            }
        }
    }
}

def serializePkgSpecForKey(b: std.buf.StringBuf, p: PkgSpec): Void = {
    bufPushStr(b, p.pkgId);
    bufPushByte(b, 124);
    bufPushStr(b, strJoin(p.srcRoots, ","));
    bufPushByte(b, 124);
    let cd = cellNew(p.deps);
    while (match cellGet(cd) { Nil -> false, _ -> true }) {
        match cellGet(cd) {
            Cons((al, tid), r) -> {
                bufPushStr(b, al);
                bufPushByte(b, 61);
                bufPushStr(b, tid);
                bufPushByte(b, 59);
                cellSet(cd, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(b, 10)
}

def serializeProjGraphForKey(rootSpec: PkgSpec, extSpecs: List PkgSpec, tc: TargetCfg): String = {
    let b = bufNew();
    serializePkgSpecForKey(b, rootSpec);
    let ce = cellNew(extSpecs);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons(ep, r) -> { serializePkgSpecForKey(b, ep); cellSet(ce, r) },
            Nil -> (),
        }
    };
    bufPushStr(b, strJoin(tc.tcCFlags, ","));
    bufPushByte(b, 124);
    bufPushStr(b, strJoin(tc.tcLinkFlags, ","));
    bufPushByte(b, 124);
    bufPushStr(b, strJoin(tc.tcExports, ","));
    bufPushByte(b, 124);
    bufPushStr(b, if (tc.tcOwnsMain) "1" else "0");
    bufPushByte(b, 124);
    match tc.tcBootSymbol { Some(s) -> bufPushStr(b, s), None -> () };
    bufPushByte(b, 124);
    let cs = cellNew(tc.tcCSources);
    while (match cellGet(cs) { Nil -> false, _ -> true }) {
        match cellGet(cs) {
            Cons(fp, r) -> {
                bufPushStr(b, fp);
                bufPushByte(b, 59);
                cellSet(cs, r)
            },
            Nil -> (),
        }
    };
    let cu = cellNew(tc.tcExtraUnits);
    while (match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons(u, ru) -> {
                bufPushStr(b, u.nuCompiler);
                bufPushByte(b, 58);
                bufPushStr(b, strJoin(u.nuFlags, ","));
                bufPushByte(b, 58);
                bufPushStr(b, strJoin(u.nuSources, ","));
                bufPushByte(b, 59);
                cellSet(cu, ru)
            },
            Nil -> (),
        }
    };
    bufToString(b)
}

def makeCompileCallbacks(debugInfo: Bool, optLevel: String, singleCgu: Bool, noCache: Bool): CompileCallbacks = MkCompileCallbacks {
    cbCompileNativeExe: (entryFile, rootSpec, extSpecs, tc, outOpt, dumpCoreOpt, rtOpt, cacheDirOpt) -> {
        let outBin = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + hostExeExt() };
        let effOpt = match tc.tcOptLevel { Some(lvl) -> lvl, None -> optLevel };
        let cacheDir = effectiveCacheDir(cacheDirOpt);
        let rtArchive = resolveRuntimeArchive(rtOpt)?;
        let projCacheDir = pathJoin(cacheDir, "proj");
        let projKey = strSlice(
            sha256Hex(
                "proj-native-v5|" + scriptCompilerFingerprint(rtArchive)
                + "|" + resolveNativeCc()
                + "|O" + effOpt
                + "|dbg" + (if (debugInfo) "1" else "0")
                + "|" + (if (singleCgu) "scgu" else "mcgu")
                + "|" + entryFile + "|" + outBin + "\n"
                + serializeProjGraphForKey(rootSpec, extSpecs, tc)
            ),
            0, 24
        );
        let projDepsPath = pathJoin(projCacheDir, "p_" + projKey + ".deps");
        let dsymReady =
            if (debugInfo && currentHostOs() == "macos") {
                fileExists(outBin + ".dSYM/Contents/Resources/DWARF/" + pathBasename(outBin))
            } else true;
        let canSkipWhole = !noCache && match dumpCoreOpt { None -> true, Some(_) -> false } && fileExists(outBin) && dsymReady && verifyProjectDeps(projDepsPath, projKey, outBin);
        if (canSkipWhole) {
            match getEnv("GEISHA_CACHE_STATS") {
                Some("1") -> eprintLn("[geisha-cache] project_hit=1 opt=" + optFlagForLevel(effOpt)),
                _ -> (),
            };
            Ok(())
        } else {
            diagReset();
            let cgus = compileWithPkgSpecsToCgusForArchDebug(
                entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
                false, currentHostArch(), tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol, debugInfo, singleCgu
            )?;
            let (natCacheable, natDepPaths) = emitNativeExecutableFromCgus(cgus, outBin, tc, rtOpt, cacheDir, effOpt, debugInfo, noCache)?;
            if (!noCache && natCacheable && match dumpCoreOpt { None -> true, Some(_) -> false }) {
                mkdirAll(projCacheDir)?;
                let _ = writeProjectDeps(projDepsPath, projKey, outBin, tc, natDepPaths);
                ()
            } else ();
            Ok(())
        }
    },
    cbCompileNativeExeSource: (entryLabel, srcText, rootSpec, extSpecs, tc, outOpt, rtOpt) -> {
        diagReset();
        let rawDefs = loadSingleSourceProgramWithPkgsNamed(entryLabel, srcText, rootSpec, extSpecs, Nil)?;
        let llText = compileLoadedDefsToIr(rawDefs, None, false, tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol)?;
        let outBin = match outOpt { Some(p) -> p, None -> pathStem(entryLabel) + hostExeExt() };
        emitNativeExecutableFromIr(llText, outBin, tc, rtOpt)
    },
    cbCompileNativeObj: (entryFile, rootSpec, extSpecs, tc, outOpt, dumpCoreOpt) -> {
        let llText = compileWithPkgSpecsToIrDebug(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            false, tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol, debugInfo
        )?;
        let outObj = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + ".o" };
        let effOpt = match tc.tcOptLevel { Some(lvl) -> " -O" + lvl, None -> " -O" + optLevel };
        emitNativeObjFromIrOpt(llText, outObj, effOpt)
    },
    cbCompileWasm: (entryFile, rootSpec, extSpecs, tc, compOnly, outOpt, dumpCoreOpt, rtOpt, cacheDirOpt) -> {
        let effOpt = match tc.tcOptLevel { Some(lvl) -> lvl, None -> optLevel };
        let outWasm = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + (if (compOnly) ".o" else ".wasm") };
        if (compOnly) {
            let llText = compileWithPkgSpecsToIrDebug(
                entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
                true, tc.tcExports, false, None, debugInfo
            )?;
            emitWasmFromIrOpt(llText, outWasm, true, tc, rtOpt, " -O" + effOpt)
        } else {
            let cgus = compileWithPkgSpecsToCgusForArchDebug(
                entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
                true, "wasm32", tc.tcExports, false, None, debugInfo, singleCgu
            )?;
            emitWasmFromCgus(cgus, outWasm, tc, rtOpt, effectiveCacheDir(cacheDirOpt), effOpt, debugInfo, noCache)
        }
    },
    cbCompileWasmGc: (entryFile, rootSpec, extSpecs, tc, outOpt, dumpCoreOpt) -> {
        let outWasm = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + ".wasm" };
        compileWithPkgSpecsToWasmGc(entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt, tc, outWasm)
    },
    cbCompileJs: (entryFile, rootSpec, extSpecs, tc, outOpt, dumpCoreOpt) -> {
        let outJs = match outOpt { Some(p) -> p, None -> pathStem(entryFile) + ".mjs" };
        compileWithPkgSpecsToJs(entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt, tc, outJs)
    },
    cbCompileAppleBundle: (target, entryFile, rootSpec, extSpecs, tc, ab, pkgName, pkgVersion, outOpt, dumpCoreOpt, rtOpt, cacheDirOpt) -> {
        let noMainFlag = tc.tcOwnsMain || (target != "macos-app" && ab.abIsExtension);
        let arch = if (target == "macos-app") currentHostArch() else "arm64";
        let effOpt = match tc.tcOptLevel { Some(lvl) -> lvl, None -> optLevel };
        let cgus = compileWithPkgSpecsToCgusForArchDebug(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            false, arch, tc.tcExports, noMainFlag, tc.tcBootSymbol, debugInfo, singleCgu
        )?;
        emitAppleBundleFromCgus(target, cgus, tc, ab, pkgName, pkgVersion, outOpt, rtOpt, effectiveCacheDir(cacheDirOpt), effOpt, debugInfo, noCache)
    },
    cbCompileTargetArchive: (target, entryFile, rootSpec, extSpecs, tc, outArc, dumpCoreOpt, rtOpt) -> {
        let arch = if (target == "ios" || target == "ios-sim") "arm64" else currentHostArch();
        let llText = compileWithPkgSpecsToIrForArchDebug(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            false, arch, tc.tcExports, true, tc.tcBootSymbol, debugInfo
        )?;
        let effOpt = match tc.tcOptLevel { Some(lvl) -> " -O" + lvl, None -> " -O" + optLevel };
        emitStaticLibFromIrOpt(llText, outArc, target, rtOpt, effOpt)
    },
    cbEmitIr: (entryFile, rootSpec, extSpecs, tc, isWasm, outOpt, dumpCoreOpt) -> {
        let llText = compileWithPkgSpecsToIrDebug(
            entryFile, true, rootSpec, extSpecs, Nil, dumpCoreOpt,
            isWasm, tc.tcExports, tc.tcOwnsMain, tc.tcBootSymbol, debugInfo
        )?;
        match outOpt {
            Some(outLl) -> writeFile(outLl, llText),
            None -> {
                printLn(llText);
                Ok(())
            },
        }
    },
}

def scriptCompilerFingerprint(rtArchive: String): String = {
    let exePath = {
        let p = c_exe_path();
        if (ptrIsNull(p)) argAt(0) else ptrToString(p)
    };
    let exeSz = i64ToStr(c_file_size(exePath));
    let exeMt = i64ToStr(c_file_mtime_ms(exePath));
    let rtSz = i64ToStr(c_file_size(rtArchive));
    let rtMt = i64ToStr(c_file_mtime_ms(rtArchive));
    "geisha-script-v2|" + exePath + "|" + exeSz + "|" + exeMt + "|" + rtArchive + "|" + rtSz + "|" + rtMt
}

def formatProjectOutStamp(projKey: String, outBin: String): String =
    "#out\t" + projKey + "\t" + i64ToStr(c_file_size(outBin)) + "\t" + i64ToStr(c_file_mtime_ms(outBin)) + "\t" + outBin

def verifyProjectDeps(depsPath: String, expectedProjKey: String, outBin: String): Bool = match readFile(depsPath) {
    Err(_) -> false,
    Ok(content) -> {
        let expectedStamp = formatProjectOutStamp(expectedProjKey, outBin);
        match strSplitChar(content, '\n') {
            Cons(firstLine, restLines) ->
                if (firstLine != expectedStamp) false
                else {
                    let cur = cellNew(restLines);
                    let ok = cellNew(true);
                    while (cellGet(ok) && match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(line, rest) -> {
                                if (strLen(line) > 0) {
                                    match strIndexOfByte(line, 9, 0) {
                                        Some(tabIdx) if (tabIdx > 0 && tabIdx + 1 < strLen(line)) -> {
                                            let expSha = strSlice(line, 0, tabIdx);
                                            let depPath = strSlice(line, tabIdx + 1, strLen(line));
                                            match readFile(depPath) {
                                                Ok(depBytes) ->
                                                    if (sha256Hex(depBytes) != expSha) cellSet(ok, false) else (),
                                                Err(_) -> cellSet(ok, false),
                                            }
                                        },
                                        _ -> cellSet(ok, false),
                                    }
                                } else ();
                                cellSet(cur, rest)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(ok)
                },
            Nil -> false,
        }
    },
}

def writeProjectDeps(depsPath: String, projKey: String, outBin: String, tc: TargetCfg, natDepPaths: List String): Result Void String = {
    let files = diagRegisteredFiles();
    let n = vecLen(files);
    let out = bufNew();
    bufPushStr(out, formatProjectOutStamp(projKey, outBin));
    bufPushByte(out, 10);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let sf = vecGetOr(files, cellGet(i), MkSourceFile { sfPath: "", sfContent: "" });
        if (sf.sfPath != "<eval>" && strLen(sf.sfPath) > 0 && fileExists(sf.sfPath)) {
            bufPushStr(out, sha256Hex(sf.sfContent));
            bufPushByte(out, 9);
            bufPushStr(out, sf.sfPath);
            bufPushByte(out, 10)
        } else ();
        cellSet(i, cellGet(i) + 1)
    };
    let allExtraPaths = cellNew(natDepPaths);
    let cs = cellNew(tc.tcCSources);
    while (match cellGet(cs) { Nil -> false, _ -> true }) {
        match cellGet(cs) {
            Cons(fp, r) -> { cellSet(allExtraPaths, addUniqueStr(cellGet(allExtraPaths), fp)); cellSet(cs, r) },
            Nil -> (),
        }
    };
    let cu = cellNew(tc.tcExtraUnits);
    while (match cellGet(cu) { Nil -> false, _ -> true }) {
        match cellGet(cu) {
            Cons(u, ru) -> {
                let us = cellNew(u.nuSources);
                while (match cellGet(us) { Nil -> false, _ -> true }) {
                    match cellGet(us) {
                        Cons(fp, rs) -> { cellSet(allExtraPaths, addUniqueStr(cellGet(allExtraPaths), fp)); cellSet(us, rs) },
                        Nil -> (),
                    }
                };
                cellSet(cu, ru)
            },
            Nil -> (),
        }
    };
    let ce = cellNew(sortUniqueStrings(cellGet(allExtraPaths)));
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons(fp, r) -> {
                if (strLen(fp) > 0 && fileExists(fp)) {
                    match readFile(fp) {
                        Ok(bytes) -> {
                            bufPushStr(out, sha256Hex(bytes));
                            bufPushByte(out, 9);
                            bufPushStr(out, fp);
                            bufPushByte(out, 10)
                        },
                        Err(_) -> (),
                    }
                } else ();
                cellSet(ce, r)
            },
            Nil -> (),
        }
    };
    writeFile(depsPath, bufToString(out))
}

def verifyScriptDeps(depsPath: String): Bool = match readFile(depsPath) {
    Err(_) -> false,
    Ok(content) -> {
        let lines = strSplitChar(content, '\n');
        let cur = cellNew(lines);
        let ok = cellNew(true);
        while (cellGet(ok) && match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(line, rest) -> {
                    if (strLen(line) > 0) {
                        match strIndexOfByte(line, 9, 0) {
                            Some(tabIdx) if (tabIdx > 0 && tabIdx + 1 < strLen(line)) -> {
                                let expSha = strSlice(line, 0, tabIdx);
                                let depPath = strSlice(line, tabIdx + 1, strLen(line));
                                match readFile(depPath) {
                                    Ok(depBytes) ->
                                        if (sha256Hex(depBytes) != expSha) cellSet(ok, false) else (),
                                    Err(_) -> cellSet(ok, false),
                                }
                            },
                            _ -> cellSet(ok, false),
                        }
                    } else ();
                    cellSet(cur, rest)
                },
                Nil -> (),
            }
        };
        cellGet(ok)
    },
}

def writeScriptDeps(depsPath: String, skipPath: String): Result Void String = {
    let files = diagRegisteredFiles();
    let n = vecLen(files);
    let out = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let sf = vecGetOr(files, cellGet(i), MkSourceFile { sfPath: "", sfContent: "" });
        if (sf.sfPath != skipPath && sf.sfPath != "<eval>" && strLen(sf.sfPath) > 0 && fileExists(sf.sfPath)) {
            bufPushStr(out, sha256Hex(sf.sfContent));
            bufPushByte(out, 9);
            bufPushStr(out, sf.sfPath);
            bufPushByte(out, 10)
        } else ();
        cellSet(i, cellGet(i) + 1)
    };
    writeFile(depsPath, bufToString(out))
}

def execCachedScriptBin(binPath: String, appArgs: List String): Int =
    runHostProc(binPath, appArgs, Nil)

def emptyPlainTargetCfg(): TargetCfg = MkTargetCfg {
    tcCSources: Nil,
    tcCFlags: Nil,
    tcLinkFlags: Nil,
    tcExtraUnits: Nil,
    tcExports: Nil,
    tcWebAssets: Nil,
    tcOwnsMain: false,
    tcBootSymbol: None,
    tcOptLevel: None,
    tcStrip: None,
    tcSlimRuntime: false,
    tcEmitDts: true,
}

def runUncachedScriptFile(
    gsaFile: String,
    appArgs: List String,
    rtOverrideOpt: Option String,
    debugInfo: Bool,
    optFlag: String
): Result Int String = {
    diagReset();
    let rootSpec = MkPkgSpec {
        pkgId: "",
        pkgName: "",
        srcRoots: [pathDirname(gsaFile)],
        deps: Nil,
    };
    let llText = compileWithPkgSpecsToIrDebug(
        gsaFile, true, rootSpec, Nil, Nil, None, false, Nil, false, None, debugInfo
    )?;
    let cacheDir = pathJoin(pathJoin(geishaHomeDir(), "cache"), "scripts");
    mkdirAll(cacheDir)?;
    let tmpBin = pathJoin(cacheDir, "run_" + intToStr(c_getpid()) + hostExeExt());
    emitNativeExecutableFromIrDebug(llText, tmpBin, emptyPlainTargetCfg(), rtOverrideOpt, debugInfo, optFlag)?;
    let rc = execCachedScriptBin(tmpBin, appArgs);
    let _ = removeFile(tmpBin);
    if (debugInfo && currentHostOs() == "macos") {
        let _ = removeDirAll(tmpBin + ".dSYM");
        ()
    } else ();
    Ok(rc)
}

def runCachedScriptFile(
    gsaFile: String,
    appArgs: List String,
    rtOverrideOpt: Option String,
    optLevel: String,
    optDebug: Bool,
    noCache: Bool
): Result Int String = {
    let rtArchive = resolveRuntimeArchive(rtOverrideOpt)?;
    let entrySrc = readFile(gsaFile)?;
    let cacheDir = pathJoin(pathJoin(geishaHomeDir(), "cache"), "scripts");
    mkdirAll(cacheDir)?;
    let key = strSlice(
        sha256Hex("script\n" + scriptCompilerFingerprint(rtArchive) + "\nO" + optLevel + "|dbg" + (if (optDebug) "1" else "0") + "\n" + gsaFile + "\n" + entrySrc),
        0,
        24
    );
    let binPath = pathJoin(cacheDir, "s_" + key + hostExeExt());
    let depsPath = binPath + ".deps";
    if (!noCache && fileExists(binPath) && verifyScriptDeps(depsPath)) {
        match getEnv("GEISHA_CACHE_STATS") {
            Some("1") -> eprintLn("[geisha-cache] script_hit=1 opt=" + optFlagForLevel(optLevel)),
            _ -> (),
        };
        Ok(execCachedScriptBin(binPath, appArgs))
    } else {
        match getEnv("GEISHA_CACHE_STATS") {
            Some("1") -> eprintLn("[geisha-cache] script_hit=0 opt=" + optFlagForLevel(optLevel)),
            _ -> (),
        };
        diagReset();
        let rootSpec = MkPkgSpec {
            pkgId: "",
            pkgName: "",
            srcRoots: [pathDirname(gsaFile)],
            deps: Nil,
        };
        let llText = compileWithPkgSpecsToIrDebug(
            gsaFile, true, rootSpec, Nil, Nil, None, false, Nil, false, None, optDebug
        )?;
        let tmpBin = pathJoin(cacheDir, "s_" + key + ".tmp." + intToStr(c_getpid()) + hostExeExt());
        emitNativeExecutableFromIrDebug(llText, tmpBin, emptyPlainTargetCfg(), rtOverrideOpt, optDebug, " -O" + optLevel)?;
        writeScriptDeps(depsPath, gsaFile)?;
        if (c_rename(tmpBin, binPath) != 0) {
            let _ = removeFile(tmpBin);
            Err("failed to cache compiled script binary at '" + binPath + "'")
        } else {
            Ok(execCachedScriptBin(binPath, appArgs))
        }
    }
}

def runEvalSubcmd(rawArgs: List String, rtOverrideOpt: Option String): Result Int String =
    match rawArgs {
        Nil -> Err("missing code argument (usage: geisha eval '<code>' [args...])"),
        Cons(code, rest0) -> {
            let appArgs = match rest0 {
                Cons("--", tail) -> tail,
                other -> other,
            };
            let rtArchive = resolveRuntimeArchive(rtOverrideOpt)?;
            let cacheDir = pathJoin(pathJoin(geishaHomeDir(), "cache"), "scripts");
            mkdirAll(cacheDir)?;
            let key = strSlice(
                sha256Hex("eval\n" + scriptCompilerFingerprint(rtArchive) + "\n" + code),
                0,
                24
            );
            let binPath = pathJoin(cacheDir, "e_" + key + hostExeExt());
            let depsPath = binPath + ".deps";
            if (fileExists(binPath) && verifyScriptDeps(depsPath)) {
                Ok(execCachedScriptBin(binPath, appArgs))
            } else {
                diagReset();
                let rootSpec = MkPkgSpec {
                    pkgId: "",
                    pkgName: "",
                    srcRoots: ["."],
                    deps: Nil,
                };
                let rawDefs = loadSingleSourceProgramWithPkgsNamed("<eval>", code, rootSpec, Nil, Nil)?;
                let llText = compileLoadedDefsToIr(rawDefs, None, false, Nil, false, None)?;
                let tmpBin = pathJoin(cacheDir, "e_" + key + ".tmp." + intToStr(c_getpid()) + hostExeExt());
                emitNativeExecutableFromIr(llText, tmpBin, emptyPlainTargetCfg(), rtOverrideOpt)?;
                writeScriptDeps(depsPath, "<eval>")?;
                if (c_rename(tmpBin, binPath) != 0) {
                    let _ = removeFile(tmpBin);
                    Err("failed to cache compiled eval binary at '" + binPath + "'")
                } else {
                    Ok(execCachedScriptBin(binPath, appArgs))
                }
            }
        },
    }

