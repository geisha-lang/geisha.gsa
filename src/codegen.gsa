            } else {
                let (rawSz, _) = typeSizeAndAlignFor(elemTy, mctx.mcPtrSize);
                let byteSz = if (rawSz < 8) 8 else rawSz;
                emitGcAllocForType(mctx, fctx, byteSz, elemTy)
