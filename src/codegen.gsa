// Static LP64 ABI Layout Calculator & LLVM 20 Opaque-Pointer Textual IR Emitter (`codegen`)

use std.option.{Option, Some, None}
use std.list.{listRev, listLen}
use std.vec.{Vec, vecNew, vecPush, vecLen, vecGetOr}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.buf.{StringBuf, bufNew, bufLen, bufPushStr, bufPushByte, bufPushBuf, bufToString}
use std.str.{intToStr, i64ToStr, floatToHex16, strJoin, strStartsWith}
use diag.{diagGetFile, diagSpanLineCol}
use ast.{
    Span, emptySpan, typeToString,
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmMono, schemeBody,
    Lit, LitInt, LitFloat, LitChar, LitStr, LitBool, LitUnit,
    BinOp, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpAnd, OpOr,
    OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, OpUshr,
    OpEq, OpNe, OpLt, OpLe, OpGt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct
}
use infer.{
    VariantInfo, AdtInfo, findVariantByName, applyExplicitSubst, buildPairMap
}
use core.{
    ClosureSpec, TaggedTerm, MkTerm, CoreArm, Term,
    TmLit, TmVar, TmGlobalVar, TmTuple, TmBlock, TmMakeCls, TmApplyCls, TmApplyDir,
    TmBin, TmUn, TmLet, TmIf, TmWhile, TmMatch, TmMakeData, TmGetTag,
    FunDef, GlobalValDef, ExternDef, EscapeInfo, CoreProgram,
    extractTypeArgs, isStackAlloc, fnHasStackAlloc, isRecursiveAdt
}

// ============================================================================
// LLVM Identifier Formatting & String Escaping
// ============================================================================

def isSimpleLlvmIdentByte(b: Int, isFirst: Bool): Bool =
    if (b >= 65 && b <= 90) true
    else if (b >= 97 && b <= 122) true
    else if (b == 95 || b == 46) true
    else if (!isFirst && b >= 48 && b <= 57) true
    else false

pub def llvmSym(name: String): String = {
    let n = strLen(name);
    if (n == 0) "@\"\""
    else {
        let simple = cellNew(true);
        let i = cellNew(0);
        while (cellGet(i) < n && cellGet(simple)) {
            let idx = cellGet(i);
            if (!isSimpleLlvmIdentByte(strByteAt(name, idx), idx == 0)) {
                cellSet(simple, false)
            } else ();
            cellSet(i, idx + 1)
        };
        if (cellGet(simple)) "@" + name
        else {
            let b = bufNew();
            bufPushByte(b, 64);
            bufPushByte(b, 34);
            let k = cellNew(0);
            while (cellGet(k) < n) {
                let c = strByteAt(name, cellGet(k));
                if (c == 34 || c == 92) {
                    bufPushByte(b, 92);
                    pushHexByteUpper(b, c)
                } else {
                    bufPushByte(b, c)
                };
                cellSet(k, cellGet(k) + 1)
            };
            bufPushByte(b, 34);
            bufToString(b)
        }
    }
}

def hexDigitUpper(nib: Int): Int =
    if (nib < 10) 48 + nib else 55 + nib

def pushHexByteUpper(b: StringBuf, byteVal: Int): Void = {
    let v = byteVal & 255;
    bufPushByte(b, hexDigitUpper((v >>> 4) & 15));
    bufPushByte(b, hexDigitUpper(v & 15))
}

def encodeLlvmCString(s: String): String = {
    let b = bufNew();
    bufPushStr(b, "c\"");
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let c = strByteAt(s, cellGet(i));
        if (c >= 32 && c <= 126 && c != 34 && c != 92) {
            bufPushByte(b, c)
        } else {
            bufPushByte(b, 92);
            pushHexByteUpper(b, c)
        };
        cellSet(i, cellGet(i) + 1)
    };
    bufPushStr(b, "\\00\"");
    bufToString(b)
}

// ============================================================================
// Geisha `Type` -> LLVM 20 Opaque-Pointer Type & Static LP64 ABI Calculator
// ============================================================================

pub def isVoidGeishaType(ty: Type): Bool = match ty {
    TyVoid -> true,
    TyCon(n) -> n == "Void",
    _ -> false,
}

def getCompBaseName(ty: Type): String = match ty {
    TyComp(b, _) -> getCompBaseName(b),
    TyCon(n) -> n,
    _ -> "",
}

def isAdtGeishaType(ty: Type): Bool = match ty {
    TyCon(n) ->
        !(n == "Int" || n == "Int64" || n == "Float" || n == "Char"
          || n == "String" || n == "Void" || n == "Bool" || n == "Ptr" || n == "AtomicInt"),
    TyComp(_, _) -> {
        let base = getCompBaseName(ty);
        !(base == "Int" || base == "Int64" || base == "Float" || base == "Char"
          || base == "String" || base == "Void" || base == "Bool" || base == "Ptr"
          || base == "Cell" || base == "MutArray" || base == "MVar"
          || base == "Chan" || base == "Task" || base == "Actor")
    },
    _ -> false,
}

def gActiveAdtReg: Cell (StrMap AdtInfo) = cellNew(strMapNew())
def gActiveEscape: Cell (Option EscapeInfo) = cellNew(None)
def gActivePtrSize: Cell Int = cellNew(8)
def gUnboxMemo: Cell (StrMap (Option (List Type))) = cellNew(strMapNew())

def typeHasTyVar(ty: Type): Bool = match ty {
    TyVar(_) -> true,
    TyTuple(es) -> typeListHasTyVar(es),
    TyComp(b, a) -> typeHasTyVar(b) || typeHasTyVar(a),
    TyArr(e, ps, r) -> typeHasTyVar(e) || typeListHasTyVar(ps) || typeHasTyVar(r),
    _ -> false,
}

def typeListHasTyVar(ts: List Type): Bool = match ts {
    Nil -> false,
    Cons(h, t) -> typeHasTyVar(h) || typeListHasTyVar(t),
}

def unboxTypeKey(ty: Type): String = match ty {
    TyVoid -> "V",
    TyVar(v) -> "?" + v,
    TyCon(n) -> n,
    TyComp(b, a) -> "(" + unboxTypeKey(b) + " " + unboxTypeKey(a) + ")",
    TyTuple(es) -> "{" + unboxTypeListKey(es) + "}",
    TyArr(_, _, _) -> "Fn",
}

def unboxTypeListKey(ts: List Type): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> unboxTypeKey(h),
    Cons(h, t) -> unboxTypeKey(h) + "," + unboxTypeListKey(t),
}

def listContainsStr(xs: List String, target: String): Bool = match xs {
    Nil -> false,
    Cons(h, t) -> if (h == target) true else listContainsStr(t, target),
}

// Transparent value-type unboxing for small, non-recursive, single-constructor ADTs (<= 64 bytes).
// Memoized in `gUnboxMemo` with explicit cycle guard `visiting` so mutual recursion is O(1) and safe.
def unboxedAdtFieldsRec(ty: Type, visiting: List String, depth: Int): Option (List Type) =
    if (depth > 32 || !isAdtGeishaType(ty)) None
    else match cellGet(gActiveEscape) {
        None -> None,
        Some(esc) -> {
            let key = unboxTypeKey(ty);
            let memo = cellGet(gUnboxMemo);
            match strMapGet(memo, key) {
                Some(cached) -> cached,
                None ->
                    if (listContainsStr(visiting, key)) None
                    else {
                        let adtReg = cellGet(gActiveAdtReg);
                        let (adtName, typeArgs) = match ty {
                            TyCon(n) -> (n, Nil),
                            TyComp(_, _) -> (getCompBaseName(ty), extractTypeArgs(ty)),
                            _ -> ("", Nil),
                        };
                        let res =
                            if (strLen(adtName) == 0 || isRecursiveAdt(esc, adtName)) None
                            else match strMapGet(adtReg, adtName) {
                                None -> None,
                                Some(ainfo) -> match ainfo.variants {
                                    Cons(vinfo, Nil) -> match vinfo.fieldTypes {
                                        Nil -> None,
                                        _ -> {
                                            let sub = buildPairMap(ainfo.typeParams, typeArgs);
                                            let concreteFields = substTypeList(vinfo.fieldTypes, sub);
                                            if (typeListHasTyVar(concreteFields)) None
                                            else {
                                                let nextVis = Cons(key, visiting);
                                                let (sz, _) = structSizeAndAlignRec(concreteFields, cellGet(gActivePtrSize), nextVis, depth + 1);
                                                if (ainfo.isCStruct || (sz > 0 && sz <= 64)) Some(concreteFields) else None
                                            }
                                        },
                                    },
                                    _ -> None,
                                },
                            };
                        strMapInsert(memo, key, res);
                        res
                    },
            }
        },
    }

pub def unboxedAdtFields(ty: Type): Option (List Type) = unboxedAdtFieldsRec(ty, Nil, 0)

pub def isNoscanElemType(ty: Type): Bool = match ty {
    TyVoid -> true,
    TyCon(n) ->
        if (n == "Int" || n == "Int64" || n == "Float" || n == "Float32" || n == "Char" || n == "Bool" || n == "Void" || n == "ScopedPtr" || n == "Arena") true
        else match unboxedAdtFields(ty) {
            Some(fs) -> isNoscanList(fs),
            None -> false,
        },
    TyComp(_, _) -> match unboxedAdtFields(ty) {
        Some(fs) -> isNoscanList(fs),
        None -> false,
    },
    TyTuple(es) -> isNoscanList(es),
    _ -> false,
}

def isNoscanList(ts: List Type): Bool = match ts {
    Nil -> true,
    Cons(h, t) -> isNoscanElemType(h) && isNoscanList(t),
}

pub def isGcPointerType(ty: Type): Bool = match ty {
    TyArr(_, _, _) -> true,
    TyCon(n) ->
        if (n == "String" || n == "AtomicInt" || n == "ForeignPtr") true
        else if (isAdtGeishaType(ty)) match unboxedAdtFields(ty) { Some(_) -> false, None -> true }
        else false,
    TyComp(_, _) -> {
        let base = getCompBaseName(ty);
        if (base == "Cell" || base == "MutArray" || base == "ImmArray" || base == "MVar"
            || base == "Chan" || base == "Task" || base == "Actor") true
        else if (isAdtGeishaType(ty)) match unboxedAdtFields(ty) { Some(_) -> false, None -> true }
        else false
    },
    _ -> false,
}

pub def getValLlvmType(ty: Type): String = match ty {
    TyVoid -> "i8",
    TyCon(n) ->
        if (n == "Int") "i32"
        else if (n == "Int64") "i64"
        else if (n == "Float") "double"
        else if (n == "Float32") "float"
        else if (n == "Char") "i8"
        else if (n == "Bool") "i1"
        else if (n == "Void") "i8"
        else match unboxedAdtFields(ty) {
            Some(fs) -> formatLlvmStructType(mapValLlvmTypes(fs)),
            None -> "ptr",
        },
    TyArr(_, _, _) -> "ptr",
    TyComp(_, _) -> match unboxedAdtFields(ty) {
        Some(fs) -> formatLlvmStructType(mapValLlvmTypes(fs)),
        None -> "ptr",
    },
    TyTuple(elems) -> formatLlvmStructType(mapValLlvmTypes(elems)),
    TyVar(_) -> "i64",
}

def mapValLlvmTypes(ts: List Type): List String = {
    let rev = cellNew(Nil);
    let cur = cellNew(ts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(t, r) -> {
                cellSet(rev, Cons(getValLlvmType(t), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

def formatLlvmStructType(fieldLlvmTys: List String): String = match fieldLlvmTys {
    Nil -> "{}",
    _ -> "{ " + strJoin(fieldLlvmTys, ", ") + " }",
}

def getFnRetLlvmType(retTy: Type): String =
    if (isVoidGeishaType(retTy)) "void" else getValLlvmType(retTy)

def llvmZeroValue(llvmTy: String): String =
    if (llvmTy == "i1") "false"
    else if (llvmTy == "i8" || llvmTy == "i32" || llvmTy == "i64") "0"
    else if (llvmTy == "double") "0x0000000000000000"
    else if (llvmTy == "float") "0.000000e+00"
    else if (llvmTy == "ptr") "null"
    else "zeroinitializer"

def alignUp(offset: Int, align: Int): Int =
    if (align <= 1) offset
    else {
        let rem = offset % align;
        if (rem == 0) offset else offset + (align - rem)
    }

// Returns `(byteSize, abiAlign)` for target pointer size (`8` on LP64, `4` on wasm32)
def typeSizeAndAlignRec(ty: Type, ptrSize: Int, visiting: List String, depth: Int): (Int, Int) = match ty {
    TyVoid -> (1, 1),
    TyCon(n) ->
        if (n == "Int") (4, 4)
        else if (n == "Int64") (8, 8)
        else if (n == "Float") (8, 8)
        else if (n == "Float32") (4, 4)
        else if (n == "Char" || n == "Bool" || n == "Void") (1, 1)
        else match unboxedAdtFieldsRec(ty, visiting, depth) {
            Some(fs) -> structSizeAndAlignRec(fs, ptrSize, Cons(unboxTypeKey(ty), visiting), depth + 1),
            None -> (ptrSize, ptrSize),
        },
    TyArr(_, _, _) -> (ptrSize, ptrSize),
    TyComp(_, _) -> match unboxedAdtFieldsRec(ty, visiting, depth) {
        Some(fs) -> structSizeAndAlignRec(fs, ptrSize, Cons(unboxTypeKey(ty), visiting), depth + 1),
        None -> (ptrSize, ptrSize),
    },
    TyVar(_) -> (8, 8),
    TyTuple(elems) -> structSizeAndAlignRec(elems, ptrSize, visiting, depth),
}

def structSizeAndAlignRec(elems: List Type, ptrSize: Int, visiting: List String, depth: Int): (Int, Int) = match elems {
    Nil -> (0, 1),
    _ -> {
        let off = cellNew(0);
        let maxAl = cellNew(1);
        let cur = cellNew(elems);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(el, r) -> {
                    let (sz, al) = typeSizeAndAlignRec(el, ptrSize, visiting, depth);
                    let aligned = alignUp(cellGet(off), al);
                    cellSet(off, aligned + sz);
                    if (al > cellGet(maxAl)) cellSet(maxAl, al) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let finalAl = cellGet(maxAl);
        (alignUp(cellGet(off), finalAl), finalAl)
    },
}

pub def typeSizeAndAlignFor(ty: Type, ptrSize: Int): (Int, Int) = typeSizeAndAlignRec(ty, ptrSize, Nil, 0)

pub def structSizeAndAlignFor(elems: List Type, ptrSize: Int): (Int, Int) = structSizeAndAlignRec(elems, ptrSize, Nil, 0)

pub def typeSizeAndAlign(ty: Type): (Int, Int) = typeSizeAndAlignFor(ty, 8)

pub def structSizeAndAlign(elems: List Type): (Int, Int) = structSizeAndAlignFor(elems, 8)

// Compute exact 40-bit GC pointer word mask on LP64 (`ptrSize == 8`).
// Returns `None` to fall back to conservative `@gc_alloc` if layout is unknown or >40 words.
def accumPtrMaskType(ty: Type, baseOff: Int, maskAcc: Int64): Option Int64 = match ty {
    TyVoid -> Some(maskAcc),
    TyVar(_) -> None,
    TyTuple(es) -> accumPtrMaskFields(es, baseOff, maskAcc),
    _ -> match unboxedAdtFields(ty) {
        Some(fs) -> accumPtrMaskFields(fs, baseOff, maskAcc),
        None ->
            if (isNoscanElemType(ty)) Some(maskAcc)
            else {
                let wordIdx = baseOff / 8;
                if (baseOff % 8 != 0 || wordIdx < 0 || wordIdx >= 40) None
                else Some(maskAcc | (intToI64(1) << wordIdx))
            },
    },
}

def accumPtrMaskFields(ts: List Type, startOff: Int, initMask: Int64): Option Int64 = {
    let off = cellNew(startOff);
    let mask = cellNew(initMask);
    let ok = cellNew(true);
    let cur = cellNew(ts);
    while (cellGet(ok) && match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(el, r) -> {
                let (sz, al) = typeSizeAndAlignFor(el, 8);
                let aligned = alignUp(cellGet(off), al);
                match accumPtrMaskType(el, aligned, cellGet(mask)) {
                    Some(m2) -> {
                        cellSet(mask, m2);
                        cellSet(off, aligned + sz)
                    },
                    None -> cellSet(ok, false),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    if (cellGet(ok)) Some(cellGet(mask)) else None
}

def emitInlineNurseryAlloc(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    byteSz: Int,
    noscan: Bool,
    isMasked: Bool,
    ptrMask: Int64,
    fallbackCall: String
): String = {
    let payloadWords = if (byteSz <= 0) 1 else (byteSz + 7) / 8;
    let totalBytes = (payloadWords + 1) * 8;
    if (mctx.mcIsWasm || mctx.mcPtrSize != 8 || totalBytes > 512) {
        emitAssign(fctx, fallbackCall)
    } else {
        let wBits = intToI64(payloadWords) << 3;
        if (noscan) {
            let hdrConst = wBits | intToI64(1);
            emitAssign(fctx, "call ptr @__gs_tlab_alloc_atomic(i64 " + intToStr(totalBytes) + ", i64 " + i64ToStr(hdrConst) + ", i64 " + intToStr(byteSz) + ")")
        } else if (isMasked) {
            let hdrConst = wBits | intToI64(4) | (ptrMask << 24);
            emitAssign(fctx, "call ptr @__gs_tlab_alloc_masked(i64 " + intToStr(totalBytes) + ", i64 " + i64ToStr(hdrConst) + ", i64 " + intToStr(byteSz) + ", i64 " + i64ToStr(ptrMask) + ")")
        } else {
            emitAssign(fctx, fallbackCall)
        }
    }
}

def emitGcAllocForType(mctx: ModEmitCtx, fctx: FnEmitCtx, byteSz: Int, ty: Type): String =
    if (isNoscanElemType(ty)) {
        emitInlineNurseryAlloc(mctx, fctx, byteSz, true, false, intToI64(0), "call ptr @gc_alloc_atomic_uninit(i64 " + intToStr(byteSz) + ")")
    } else if (!mctx.mcIsWasm) {
        match accumPtrMaskType(ty, 0, intToI64(0)) {
            Some(mask) ->
                if (mask == intToI64(0)) emitInlineNurseryAlloc(mctx, fctx, byteSz, true, false, intToI64(0), "call ptr @gc_alloc_atomic_uninit(i64 " + intToStr(byteSz) + ")")
                else emitInlineNurseryAlloc(mctx, fctx, byteSz, false, true, mask, "call ptr @gc_alloc_masked(i64 " + intToStr(byteSz) + ", i64 " + i64ToStr(mask) + ")"),
            None -> emitAssign(fctx, "call ptr @gc_alloc(i64 " + intToStr(byteSz) + ")"),
        }
    } else {
        emitAssign(fctx, "call ptr @gc_alloc(i64 " + intToStr(byteSz) + ")")
    }

def applyTypeArgs(base: Type, targs: List Type): Type = match targs {
    Nil -> base,
    Cons(a, r) -> applyTypeArgs(TyComp(base, a), r),
}

def computeFieldsGcMask64(fieldTys: List Type, startOff: Int): Option Int64 =
    if (isNoscanList(fieldTys)) Some(intToI64(0))
    else accumPtrMaskFields(fieldTys, startOff, intToI64(0))

pub def initCodegenLayoutContext(prog: CoreProgram): Void = {
    cellSet(gActiveAdtReg, prog.coreAdtReg);
    cellSet(gActiveEscape, Some(prog.coreEscape));
    cellSet(gActivePtrSize, 8);
    cellSet(gUnboxMemo, strMapNew())
}

pub def computeCodegenVariantGcMaskSExpr(baseName: String, targs: List Type, fieldTys: List Type): String =
    match fieldTys {
        Nil -> "static",
        _ -> {
            let adtTy = applyTypeArgs(TyCon(baseName), targs);
            match unboxedAdtFields(adtTy) {
                Some(_) -> "unboxed",
                None -> match computeFieldsGcMask64(fieldTys, 8) {
                    Some(m) -> "(mask " + i64ToStr(m) + ")",
                    None -> "conservative",
                },
            }
        },
    }

def emitGcAllocForFields(mctx: ModEmitCtx, fctx: FnEmitCtx, byteSz: Int, fieldTys: List Type, startOff: Int): String =
    if (isNoscanList(fieldTys)) {
        emitInlineNurseryAlloc(mctx, fctx, byteSz, true, false, intToI64(0), "call ptr @gc_alloc_atomic_uninit(i64 " + intToStr(byteSz) + ")")
    } else if (!mctx.mcIsWasm) {
        match computeFieldsGcMask64(fieldTys, startOff) {
            Some(mask) ->
                if (mask == intToI64(0)) emitInlineNurseryAlloc(mctx, fctx, byteSz, true, false, intToI64(0), "call ptr @gc_alloc_atomic_uninit(i64 " + intToStr(byteSz) + ")")
                else emitInlineNurseryAlloc(mctx, fctx, byteSz, false, true, mask, "call ptr @gc_alloc_masked(i64 " + intToStr(byteSz) + ", i64 " + i64ToStr(mask) + ")"),
            None -> emitAssign(fctx, "call ptr @gc_alloc(i64 " + intToStr(byteSz) + ")"),
        }
    } else {
        emitAssign(fctx, "call ptr @gc_alloc(i64 " + intToStr(byteSz) + ")")
    }

// Compute `{ i32 tag, [N x word] }` LLVM struct type, its byte size, and max payload alignment
def getAdtStorageLayout(adtReg: StrMap AdtInfo, adtName: String, typeArgs: List Type, ptrSize: Int): (String, Int, Int) =
    match strMapGet(adtReg, adtName) {
        None -> ("{ i32 }", 4, 1),
        Some(ainfo) -> {
            let sub = buildPairMap(ainfo.typeParams, typeArgs);
            let maxBytes = cellNew(0);
            let maxAlign = cellNew(1);
            let cv = cellNew(ainfo.variants);
            while (match cellGet(cv) { Nil -> false, _ -> true }) {
                match cellGet(cv) {
                    Cons(vi, r) -> {
                        match vi.fieldTypes {
                            Nil -> (),
                            fts -> {
                                let instTys = substTypeList(fts, sub);
                                let (sz, al) = structSizeAndAlignFor(instTys, ptrSize);
                                if (sz > cellGet(maxBytes)) cellSet(maxBytes, sz) else ();
                                if (al > cellGet(maxAlign)) cellSet(maxAlign, al) else ()
                            },
                        };
                        cellSet(cv, r)
                    },
                    Nil -> (),
                }
            };
            let mb = cellGet(maxBytes);
            let ma = cellGet(maxAlign);
            if (mb == 0) {
                ("{ i32 }", 4, 1)
            } else if (ma >= 8) {
                let words = (mb + 7) / 8;
                ("{ i32, [" + intToStr(words) + " x i64] }", 8 + words * 8, ma)
            } else {
                let words = (mb + 3) / 4;
                ("{ i32, [" + intToStr(words) + " x i32] }", 4 + words * 4, ma)
            }
        },
    }

def getAdtStorageTypeAndSize(adtReg: StrMap AdtInfo, adtName: String, typeArgs: List Type, ptrSize: Int): (String, Int) = {
    let (st, sz, _) = getAdtStorageLayout(adtReg, adtName, typeArgs, ptrSize);
    (st, sz)
}

def substTypeList(ts: List Type, sub: StrMap Type): List Type = {
    let rev = cellNew(Nil);
    let cur = cellNew(ts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(t, r) -> {
                cellSet(rev, Cons(applyExplicitSubst(t, sub), cellGet(rev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    listRev(cellGet(rev))
}

// ============================================================================
// Module & Function IR Builder Contexts
// ============================================================================

data VarSlot {
    MkVarSlot { vsPtr: String, vsLlvmTy: String, vsGeishaTy: Type },
}

data BasicBlockBuf {
    MkBlockBuf { bbLabel: String, bbInstrs: StringBuf, bbTerm: Cell Bool },
}

data FnEmitCtx {
    MkFnEmitCtx {
        fcName: String,
        fcRegCnt: Cell Int,
        fcBlkCnt: Cell Int,
        fcAllocas: StringBuf,
        fcBlocks: Vec BasicBlockBuf,
        fcCurBlk: Cell Int,
        fcPendingLet: Cell (Option String),
        fcDummyBlk: BasicBlockBuf,
        fcDebug: Bool,
        fcSubprogramId: Int,
        fcSrcFileId: Int,
        fcDiFileId: Int,
        fcDefLine: Int,
        fcCurLocId: Cell Int,
        fcCurSpan: Cell Span,
    },
}

data ModEmitCtx {
    MkModEmitCtx {
        mcStrCnt: Cell Int,
        mcStrDecls: StringBuf,
        mcStrPool: StrMap String,
        mcConstPool: StrMap String,
        mcConstCnt: Cell Int,
        mcSynthFns: StringBuf,
        mcSynthSet: StrMap Bool,
        mcGlobalSlots: StrMap VarSlot,
        mcFns: StrMap FunDef,
        mcExterns: StrMap ExternDef,
        mcMultiExternLinks: StrMap Bool,
        mcAdtReg: StrMap AdtInfo,
        mcEscape: EscapeInfo,
        mcIsWasm: Bool,
        mcTargetArch: String,
        mcPtrSize: Int,
        mcWasmExports: StrMap Bool,
        mcHasExplicitExports: Bool,
        mcCExportSyms: StrMap Bool,
        mcUseGlobalsOnce: Bool,
        mcDebug: Bool,
        mcDbgCwd: String,
        mcDbgNextId: Cell Int,
        mcDbgDecls: StringBuf,
        mcDbgCuId: Cell Int,
        mcDbgSubTyId: Cell Int,
        mcDbgFileIds: StrMap Int,
        mcDbgLexFileIds: StrMap Int,
        mcDbgLocCache: StrMap Int,
        mcDbgTypeCache: StrMap Int,
    },
}

// ============================================================================
// C ABI Lowering for `extern data`, Pure `extern` Exports, `extern init`, & `cFnPtr`
// ============================================================================

data CAbiParamMode {
    CAbiDirect(String),
    CAbiPair(String, String),
    CAbiIndirectPtr(String, Int, Bool),
}

data CAbiRetMode {
    CAbiRetVoid,
    CAbiRetDirect(String),
    CAbiRetSret(String, Int),
}

def isCStructType(ty: Type): Bool = match ty {
    TyCon(n) -> match strMapGet(cellGet(gActiveAdtReg), n) {
        Some(ai) -> ai.isCStruct,
        None -> false,
    },
    _ -> false,
}

def flattenCStructLeavesRec(ty: Type, baseOff: Int, ptrSize: Int, acc: Cell (List (Int, Int, String))): Void =
    match ty {
        TyCon(n) ->
            if (n == "Float") {
                cellSet(acc, consLeaf(cellGet(acc), (baseOff, 8, "f64")))
            } else if (n == "Float32") {
                cellSet(acc, consLeaf(cellGet(acc), (baseOff, 4, "f32")))
            } else if (n == "Int") {
                cellSet(acc, consLeaf(cellGet(acc), (baseOff, 4, "int")))
            } else if (n == "Int64") {
                cellSet(acc, consLeaf(cellGet(acc), (baseOff, 8, "int")))
            } else if (n == "Char" || n == "Bool") {
                cellSet(acc, consLeaf(cellGet(acc), (baseOff, 1, "int")))
            } else if (n == "Ptr" || n == "ScopedPtr") {
                cellSet(acc, consLeaf(cellGet(acc), (baseOff, ptrSize, "int")))
            } else match unboxedAdtFields(ty) {
                Some(fs) -> {
                    let off = cellNew(baseOff);
                    let cur = cellNew(fs);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(ft, r) -> {
                                let (fsz, fal) = typeSizeAndAlignFor(ft, ptrSize);
                                let aligned = alignUp(cellGet(off), fal);
                                flattenCStructLeavesRec(ft, aligned, ptrSize, acc);
                                cellSet(off, aligned + fsz);
                                cellSet(cur, r)
                            },
                            Nil -> (),
                        }
                    }
                },
                None -> cellSet(acc, consLeaf(cellGet(acc), (baseOff, ptrSize, "int"))),
            },
        _ -> cellSet(acc, consLeaf(cellGet(acc), (baseOff, ptrSize, "int"))),
    }

def consLeaf(xs: List (Int, Int, String), item: (Int, Int, String)): List (Int, Int, String) =
    Cons(item, xs)

def classifyHfaKind(leaves: List (Int, Int, String)): Option (String, Int) = {
    let n = listLen(leaves);
    if (n < 1 || n > 4) None
    else {
        let allF64 = cellNew(true);
        let allF32 = cellNew(true);
        let cur = cellNew(leaves);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((_, _, k), r) -> {
                    if (k != "f64") cellSet(allF64, false) else ();
                    if (k != "f32") cellSet(allF32, false) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        if (cellGet(allF64)) Some(("double", n))
        else if (cellGet(allF32)) Some(("float", n))
        else None
    }
}

def classifyX64Eightbyte(leaves: List (Int, Int, String), ebStart: Int, totalSz: Int): String = {
    let ebEnd = ebStart + 8;
    let hasInt = cellNew(false);
    let hasF64 = cellNew(false);
    let f32Cnt = cellNew(0);
    let cur = cellNew(leaves);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((off, fsz, k), r) -> {
                if (off < ebEnd && off + fsz > ebStart) {
                    if (k == "int") cellSet(hasInt, true)
                    else if (k == "f64") cellSet(hasF64, true)
                    else cellSet(f32Cnt, cellGet(f32Cnt) + 1)
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    let ebBytes = if (totalSz - ebStart < 8) totalSz - ebStart else 8;
    if (cellGet(hasInt)) {
        if (ebBytes <= 1) "i8"
        else if (ebBytes <= 2) "i16"
        else if (ebBytes <= 4) "i32"
        else "i64"
    } else if (cellGet(hasF64)) {
        "double"
    } else if (cellGet(f32Cnt) >= 2 || ebBytes > 4) {
        "<2 x float>"
    } else {
        "float"
    }
}

def classifyCAbiParam(arch: String, ptrSize: Int, ty: Type): CAbiParamMode =
    if (!isCStructType(ty)) CAbiDirect(getValLlvmType(ty))
    else {
        let sLlvm = getValLlvmType(ty);
        let (sz, aln) = typeSizeAndAlignFor(ty, ptrSize);
        let leavesRev = cellNew(Nil);
        flattenCStructLeavesRec(ty, 0, ptrSize, leavesRev);
        let leaves = listRev(cellGet(leavesRev));
        if (arch == "arm64") {
            match classifyHfaKind(leaves) {
                Some((elemTy, n)) -> CAbiDirect("[" + intToStr(n) + " x " + elemTy + "]"),
                None ->
                    if (sz <= 1) CAbiDirect("i8")
                    else if (sz <= 2) CAbiDirect("i16")
                    else if (sz <= 4) CAbiDirect("i32")
                    else if (sz <= 8) CAbiDirect("i64")
                    else if (sz <= 16) CAbiDirect("[2 x i64]")
                    else CAbiIndirectPtr(sLlvm, aln, false),
            }
        } else if (arch == "x86_64") {
            if (sz > 16) CAbiIndirectPtr(sLlvm, aln, true)
            else if (sz <= 8) CAbiDirect(classifyX64Eightbyte(leaves, 0, sz))
            else {
                let eb0 = classifyX64Eightbyte(leaves, 0, sz);
                let eb1 = classifyX64Eightbyte(leaves, 8, sz);
                CAbiPair(eb0, eb1)
            }
        } else {
            CAbiIndirectPtr(sLlvm, aln, false)
        }
    }

def classifyCAbiRet(arch: String, ptrSize: Int, ty: Type): CAbiRetMode =
    if (isVoidGeishaType(ty)) CAbiRetVoid
    else if (!isCStructType(ty)) CAbiRetDirect(getValLlvmType(ty))
    else {
        let sLlvm = getValLlvmType(ty);
        let (sz, aln) = typeSizeAndAlignFor(ty, ptrSize);
        let leavesRev = cellNew(Nil);
        flattenCStructLeavesRec(ty, 0, ptrSize, leavesRev);
        let leaves = listRev(cellGet(leavesRev));
        if (arch == "arm64") {
            match classifyHfaKind(leaves) {
                Some((elemTy, n)) -> CAbiRetDirect("[" + intToStr(n) + " x " + elemTy + "]"),
                None ->
                    if (sz <= 1) CAbiRetDirect("i8")
                    else if (sz <= 2) CAbiRetDirect("i16")
                    else if (sz <= 4) CAbiRetDirect("i32")
                    else if (sz <= 8) CAbiRetDirect("i64")
                    else if (sz <= 16) CAbiRetDirect("[2 x i64]")
                    else CAbiRetSret(sLlvm, aln),
            }
        } else if (arch == "x86_64") {
            if (sz > 16) CAbiRetSret(sLlvm, aln)
            else if (sz <= 8) CAbiRetDirect(classifyX64Eightbyte(leaves, 0, sz))
            else {
                let eb0 = classifyX64Eightbyte(leaves, 0, sz);
                let eb1 = classifyX64Eightbyte(leaves, 8, sz);
                CAbiRetDirect("{ " + eb0 + ", " + eb1 + " }")
            }
        } else {
            CAbiRetSret(sLlvm, aln)
        }
    }

def cAbiDeclParamStrings(arch: String, ptrSize: Int, paramTys: List Type, retTy: Type): (String, List String) = {
    let partsRev = cellNew(Nil);
    let retMode = classifyCAbiRet(arch, ptrSize, retTy);
    let retStr = match retMode {
        CAbiRetVoid -> "void",
        CAbiRetDirect(rt) -> rt,
        CAbiRetSret(sTy, aln) -> {
            cellSet(partsRev, Cons("ptr sret(" + sTy + ") align " + intToStr(aln), cellGet(partsRev)));
            "void"
        },
    };
    let cur = cellNew(paramTys);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(pt, r) -> {
                match classifyCAbiParam(arch, ptrSize, pt) {
                    CAbiDirect(lt) -> cellSet(partsRev, Cons(lt, cellGet(partsRev))),
                    CAbiPair(t0, t1) -> {
                        cellSet(partsRev, Cons(t0, cellGet(partsRev)));
                        cellSet(partsRev, Cons(t1, cellGet(partsRev)))
                    },
                    CAbiIndirectPtr(sTy, aln, useByval) ->
                        if (useByval) cellSet(partsRev, Cons("ptr byval(" + sTy + ") align " + intToStr(aln), cellGet(partsRev)))
                        else cellSet(partsRev, Cons("ptr", cellGet(partsRev))),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    (retStr, listRev(cellGet(partsRev)))
}

def emitMarshalStructToDirect(fctx: FnEmitCtx, geishaTy: Type, rawVal: String, cTy: String): String = {
    let sTy = getValLlvmType(geishaTy);
    if (sTy == cTy) rawVal
    else {
        let buf = emitEntryAlloca(fctx, "[4 x i64]");
        emitLine(fctx, "store [4 x i64] zeroinitializer, ptr " + buf + ", align 8");
        emitLine(fctx, "store " + sTy + " " + rawVal + ", ptr " + buf + ", align 8");
        emitAssign(fctx, "load " + cTy + ", ptr " + buf + ", align 8")
    }
}

def emitUnmarshalDirectToStruct(fctx: FnEmitCtx, geishaTy: Type, cVal: String, cTy: String): String = {
    let sTy = getValLlvmType(geishaTy);
    if (sTy == cTy) cVal
    else {
        let buf = emitEntryAlloca(fctx, "[4 x i64]");
        emitLine(fctx, "store [4 x i64] zeroinitializer, ptr " + buf + ", align 8");
        emitLine(fctx, "store " + cTy + " " + cVal + ", ptr " + buf + ", align 8");
        emitAssign(fctx, "load " + sTy + ", ptr " + buf + ", align 8")
    }
}

def emitMarshalStructToPair(fctx: FnEmitCtx, geishaTy: Type, rawVal: String, t0: String, t1: String): (String, String) = {
    let sTy = getValLlvmType(geishaTy);
    let buf = emitEntryAlloca(fctx, "[2 x i64]");
    emitLine(fctx, "store [2 x i64] zeroinitializer, ptr " + buf + ", align 8");
    emitLine(fctx, "store " + sTy + " " + rawVal + ", ptr " + buf + ", align 8");
    let v0 = emitAssign(fctx, "load " + t0 + ", ptr " + buf + ", align 8");
    let p1 = emitAssign(fctx, "getelementptr inbounds i8, ptr " + buf + ", i64 8");
    let v1 = emitAssign(fctx, "load " + t1 + ", ptr " + p1 + ", align 8");
    (v0, v1)
}

def emitUnmarshalPairToStruct(fctx: FnEmitCtx, geishaTy: Type, v0: String, t0: String, v1: String, t1: String): String = {
    let sTy = getValLlvmType(geishaTy);
    let buf = emitEntryAlloca(fctx, "[2 x i64]");
    emitLine(fctx, "store [2 x i64] zeroinitializer, ptr " + buf + ", align 8");
    emitLine(fctx, "store " + t0 + " " + v0 + ", ptr " + buf + ", align 8");
    let p1 = emitAssign(fctx, "getelementptr inbounds i8, ptr " + buf + ", i64 8");
    emitLine(fctx, "store " + t1 + " " + v1 + ", ptr " + p1 + ", align 8");
    emitAssign(fctx, "load " + sTy + ", ptr " + buf + ", align 8")
}

def emitCAbiTrampoline(
    out: StringBuf,
    mctx: ModEmitCtx,
    fd: FunDef,
    cSymName: String,
    isExternal: Bool
): Void = {
    let fctx = newFnEmitCtx(cSymName);
    let funTy = schemeBody(fd.fnScm);
    let retGeishaTy = match funTy {
        TyArr(_, _, r) -> r,
        _ -> TyVoid,
    };
    let retMode = classifyCAbiRet(mctx.mcTargetArch, mctx.mcPtrSize, retGeishaTy);
    let sigPartsRev = cellNew(Nil);
    let sretRegOpt = match retMode {
        CAbiRetSret(sTy, aln) -> {
            cellSet(sigPartsRev, Cons("ptr sret(" + sTy + ") align " + intToStr(aln) + " %__sret", cellGet(sigPartsRev)));
            Some("%__sret")
        },
        _ -> None,
    };
    let retLlvm = match retMode {
        CAbiRetVoid -> "void",
        CAbiRetDirect(rt) -> rt,
        CAbiRetSret(_, _) -> "void",
    };

    let tokReg = if (!mctx.mcIsWasm) {
        let anchor = emitEntryAlloca(fctx, "i64");
        emitLine(fctx, "store i64 0, ptr " + anchor + ", align 8");
        let tok = emitAssign(fctx, "call i64 @gc_host_enter(ptr " + anchor + ")");
        if (mctx.mcUseGlobalsOnce) {
            emitLine(fctx, "call void @__gs_init_globals_once()")
        } else ();
        tok
    } else "0";

    let gsArgTysRev = cellNew(Nil);
    let gsArgValsRev = cellNew(Nil);
    let pIdx = cellNew(0);
    let cp = cellNew(fd.fnParams);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(vd, r) -> {
                let i = cellGet(pIdx);
                let pTy = schemeBody(vd.vscm);
                let gsTy = getValLlvmType(pTy);
                let gsVal = match classifyCAbiParam(mctx.mcTargetArch, mctx.mcPtrSize, pTy) {
                    CAbiDirect(cTy) -> {
                        let reg = "%carg" + intToStr(i);
                        cellSet(sigPartsRev, Cons(cTy + " " + reg, cellGet(sigPartsRev)));
                        if (isCStructType(pTy)) emitUnmarshalDirectToStruct(fctx, pTy, reg, cTy)
                        else reg
                    },
                    CAbiPair(t0, t1) -> {
                        let r0 = "%carg" + intToStr(i) + "_0";
                        let r1 = "%carg" + intToStr(i) + "_1";
                        cellSet(sigPartsRev, Cons(t0 + " " + r0, cellGet(sigPartsRev)));
                        cellSet(sigPartsRev, Cons(t1 + " " + r1, cellGet(sigPartsRev)));
                        emitUnmarshalPairToStruct(fctx, pTy, r0, t0, r1, t1)
                    },
                    CAbiIndirectPtr(sTy, aln, useByval) -> {
                        let reg = "%carg" + intToStr(i);
                        let pDecl = if (useByval) "ptr byval(" + sTy + ") align " + intToStr(aln) + " " + reg else "ptr " + reg;
                        cellSet(sigPartsRev, Cons(pDecl, cellGet(sigPartsRev)));
                        emitAssign(fctx, "load " + sTy + ", ptr " + reg + ", align " + intToStr(aln))
                    },
                };
                cellSet(gsArgTysRev, Cons(gsTy, cellGet(gsArgTysRev)));
                cellSet(gsArgValsRev, Cons(gsVal, cellGet(gsArgValsRev)));
                cellSet(pIdx, i + 1);
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };

    let allGsTys = listRev(Cons("ptr", cellGet(gsArgTysRev)));
    let allGsVals = listRev(Cons("null", cellGet(gsArgValsRev)));
    let gsCallArgs = formatTypedArgs(allGsTys, allGsVals);
    let gsRetLlvm = getFnRetLlvmType(retGeishaTy);
    let targetSym = geishaCallImplSym(mctx, fd.fnName);

    let gsRes =
        if (gsRetLlvm == "void") {
            emitLine(fctx, "call void " + targetSym + "(" + gsCallArgs + ")");
            "0"
        } else {
            emitAssign(fctx, "call " + gsRetLlvm + " " + targetSym + "(" + gsCallArgs + ")")
        };

    match retMode {
        CAbiRetVoid -> {
            if (!mctx.mcIsWasm) emitLine(fctx, "call void @gc_host_leave(i64 " + tokReg + ")") else ();
            emitTermLine(fctx, "ret void")
        },
        CAbiRetDirect(cRetTy) -> {
            let finalRes =
                if (isCStructType(retGeishaTy)) emitMarshalStructToDirect(fctx, retGeishaTy, gsRes, cRetTy)
                else gsRes;
            if (!mctx.mcIsWasm) emitLine(fctx, "call void @gc_host_leave(i64 " + tokReg + ")") else ();
            emitTermLine(fctx, "ret " + cRetTy + " " + finalRes)
        },
        CAbiRetSret(sTy, aln) -> {
            let sretP = match sretRegOpt { Some(r) -> r, None -> "null" };
            emitLine(fctx, "store " + sTy + " " + gsRes + ", ptr " + sretP + ", align " + intToStr(aln));
            if (!mctx.mcIsWasm) emitLine(fctx, "call void @gc_host_leave(i64 " + tokReg + ")") else ();
            emitTermLine(fctx, "ret void")
        },
    };

    let linkage = if (isExternal) "" else "internal ";
    let wasmAttr = if (mctx.mcIsWasm && isExternal) " \"wasm-export-name\"=\"" + cSymName + "\"" else "";
    let header = "define " + linkage + retLlvm + " " + llvmSym(cSymName) + "(" + strJoin(listRev(cellGet(sigPartsRev)), ", ") + ") nounwind" + wasmAttr;
    flushFunctionToBuf(out, header, fctx)
}

def ensureCCallbackTrampoline(mctx: ModEmitCtx, fnName: String): String = {
    let cbName = "__gs_cb_" + fnName;
    if (!strMapContains(mctx.mcSynthSet, cbName)) {
        strMapInsert(mctx.mcSynthSet, cbName, true);
        match strMapGet(mctx.mcFns, fnName) {
            Some(fd) -> emitCAbiTrampoline(mctx.mcSynthFns, mctx, fd, cbName, false),
            None -> (),
        }
    } else ();
    llvmSym(cbName)
}

def strlenSym(mctx: ModEmitCtx): String =
    if (mctx.mcIsWasm) "@gs_strlen" else "@strlen"

def emitLlvmMemcpy(fctx: FnEmitCtx, dst: String, src: String, len64: String): Void =
    emitLine(fctx, "call void @llvm.memcpy.p0.p0.i64(ptr " + dst + ", ptr " + src + ", i64 " + len64 + ", i1 false)")

def emitLlvmMemmove(fctx: FnEmitCtx, dst: String, src: String, len64: String): Void =
    emitLine(fctx, "call void @llvm.memmove.p0.p0.i64(ptr " + dst + ", ptr " + src + ", i64 " + len64 + ", i1 false)")

def isDefaultWasmExport(fnName: String): Bool = {
    let n = strLen(fnName);
    if (n == 0 || fnName == "main") false
    else if (n >= 2 && strByteAt(fnName, 0) == 95 && strByteAt(fnName, 1) == 95) false
    else {
        let ok = cellNew(true);
        let i = cellNew(0);
        while (cellGet(i) < n && cellGet(ok)) {
            let c = strByteAt(fnName, cellGet(i));
            if (c == 46 || c == 36) cellSet(ok, false) else ();
            cellSet(i, cellGet(i) + 1)
        };
        cellGet(ok)
    }
}

def shouldExportSymbol(mctx: ModEmitCtx, fnName: String): Bool =
    if (mctx.mcIsWasm) {
        if (mctx.mcHasExplicitExports) strMapContains(mctx.mcWasmExports, fnName)
        else isDefaultWasmExport(fnName)
    } else {
        strMapContains(mctx.mcWasmExports, fnName)
    }

def geishaFnSym(mctx: ModEmitCtx, fnName: String): String =
    if (strMapContains(mctx.mcCExportSyms, fnName)) llvmSym("__gs_fn_" + fnName)
    else llvmSym(fnName)

def geishaCallImplSym(mctx: ModEmitCtx, fnName: String): String =
    if (strMapContains(mctx.mcCExportSyms, fnName)) llvmSym("__gs_fn_" + fnName)
    else if (!mctx.mcIsWasm && shouldExportSymbol(mctx, fnName)) llvmSym("__gs_exp_" + fnName)
    else llvmSym(fnName)

// TODO(#12): switch to `gs_sys_realpath` once Windows runtime shim lands
extern "realpath" def c_realpath(path: String, resolved: Ptr): Ptr
extern "free" def c_dbg_free(p: Ptr): Void

def resolveDbgCwd(): String = {
    let p = c_realpath(".", ptrNull());
    if (ptrIsNull(p)) "."
    else {
        let s = ptrToString(p);
        c_dbg_free(p);
        s
    }
}

// ============================================================================
// DWARF Debug Info Metadata Emitter (LLVM 18-21 `@llvm.dbg.declare` + `!DILocation`)
// ============================================================================

def escapeDbgStr(s: String): String = {
    let b = bufNew();
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let ch = strByteAt(s, cellGet(i));
        if (ch == 92) bufPushStr(b, "\\\\")
        else if (ch == 34) bufPushStr(b, "\\\"")
        else if (ch == 10) bufPushStr(b, "\\n")
        else if (ch == 13) bufPushStr(b, "\\r")
        else if (ch == 9) bufPushStr(b, "\\t")
        else bufPushByte(b, ch);
        cellSet(i, cellGet(i) + 1)
    };
    bufToString(b)
}

def splitDbgPath(path: String, cwd: String): (String, String) = {
    let n = strLen(path);
    if (n == 0) (if (strLen(cwd) > 0) cwd else ".", "<unknown>")
    else if (strByteAt(path, 0) == 60) (".", path)
    else {
        let lastSlash = cellNew(-1);
        let i = cellNew(0);
        while (cellGet(i) < n) {
            if (strByteAt(path, cellGet(i)) == 47) cellSet(lastSlash, cellGet(i)) else ();
            cellSet(i, cellGet(i) + 1)
        };
        let sl = cellGet(lastSlash);
        if (sl < 0) {
            (if (strLen(cwd) > 0) cwd else ".", path)
        } else {
            let rawDir = if (sl == 0) "/" else strSlice(path, 0, sl);
            let base = strSlice(path, sl + 1, n);
            let fullDir =
                if (strLen(rawDir) > 0 && strByteAt(rawDir, 0) != 47 && strLen(cwd) > 0) cwd + "/" + rawDir
                else rawDir;
            (fullDir, base)
        }
    }
}

def dbgAllocId(mctx: ModEmitCtx): Int = {
    let id = cellGet(mctx.mcDbgNextId);
    cellSet(mctx.mcDbgNextId, id + 1);
    id
}

def dbgEmitNode(mctx: ModEmitCtx, id: Int, body: String): Void = {
    bufPushStr(mctx.mcDbgDecls, "!");
    bufPushStr(mctx.mcDbgDecls, intToStr(id));
    bufPushStr(mctx.mcDbgDecls, " = ");
    bufPushStr(mctx.mcDbgDecls, body);
    bufPushByte(mctx.mcDbgDecls, 10)
}

def dbgGetOrCreateFile(mctx: ModEmitCtx, fileId: Int): Int = {
    let key = intToStr(fileId);
    match strMapGet(mctx.mcDbgFileIds, key) {
        Some(id) -> id,
        None -> {
            let sfPath = match diagGetFile(fileId) {
                Some(sf) -> sf.sfPath,
                None -> "<unknown>",
            };
            let (dir, fname) = splitDbgPath(sfPath, mctx.mcDbgCwd);
            let id = dbgAllocId(mctx);
            dbgEmitNode(mctx, id, "!DIFile(filename: \"" + escapeDbgStr(fname) + "\", directory: \"" + escapeDbgStr(dir) + "\")");
            strMapInsert(mctx.mcDbgFileIds, key, id);
            id
        },
    }
}

def dbgInitModule(mctx: ModEmitCtx, primaryFileId: Int): Void =
    if (mctx.mcDebug) {
        let cuId = dbgAllocId(mctx);
        let fileNodeId = dbgGetOrCreateFile(mctx, primaryFileId);
        let subTyId = dbgAllocId(mctx);
        dbgEmitNode(mctx, cuId, "distinct !DICompileUnit(language: DW_LANG_C99, file: !" + intToStr(fileNodeId) + ", producer: \"geisha\", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)");
        dbgEmitNode(mctx, subTyId, "!DISubroutineType(types: !{null})");
        cellSet(mctx.mcDbgCuId, cuId);
        cellSet(mctx.mcDbgSubTyId, subTyId)
    } else ()

def dbgCreateSubprogram(mctx: ModEmitCtx, displayName: String, linkageName: String, sp: Span): (Int, Int, Int) = {
    let diFileId = dbgGetOrCreateFile(mctx, sp.fileId);
    let (line0, _) = diagSpanLineCol(sp);
    let ln = if (line0 > 0) line0 else 1;
    let spId = dbgAllocId(mctx);
    let body =
        "distinct !DISubprogram(name: \"" + escapeDbgStr(displayName)
        + "\", linkageName: \"" + escapeDbgStr(linkageName)
        + "\", scope: !" + intToStr(diFileId)
        + ", file: !" + intToStr(diFileId)
        + ", line: " + intToStr(ln)
        + ", type: !" + intToStr(cellGet(mctx.mcDbgSubTyId))
        + ", scopeLine: " + intToStr(ln)
        + ", spFlags: DISPFlagDefinition, unit: !" + intToStr(cellGet(mctx.mcDbgCuId)) + ")";
    dbgEmitNode(mctx, spId, body);
    (spId, diFileId, ln)
}

def dbgGetOrCreateScopeForFile(mctx: ModEmitCtx, fctx: FnEmitCtx, srcFileId: Int): Int =
    if (srcFileId == 0 || srcFileId == fctx.fcSrcFileId) fctx.fcSubprogramId
    else {
        let key = intToStr(fctx.fcSubprogramId) + ":" + intToStr(srcFileId);
        match strMapGet(mctx.mcDbgLexFileIds, key) {
            Some(id) -> id,
            None -> {
                let diFileId = dbgGetOrCreateFile(mctx, srcFileId);
                let id = dbgAllocId(mctx);
                dbgEmitNode(mctx, id, "!DILexicalBlockFile(scope: !" + intToStr(fctx.fcSubprogramId) + ", file: !" + intToStr(diFileId) + ", discriminator: 0)");
                strMapInsert(mctx.mcDbgLexFileIds, key, id);
                id
            },
        }
    }

def dbgGetOrCreateLoc(mctx: ModEmitCtx, fctx: FnEmitCtx, sp: Span): Int = {
    let scopeId = dbgGetOrCreateScopeForFile(mctx, fctx, sp.fileId);
    let (line0, col0) = diagSpanLineCol(sp);
    let ln = if (line0 > 0) line0 else fctx.fcDefLine;
    let col = if (line0 > 0) col0 else 1;
    let key = intToStr(scopeId) + ":" + intToStr(ln) + ":" + intToStr(col);
    match strMapGet(mctx.mcDbgLocCache, key) {
        Some(id) -> id,
        None -> {
            let id = dbgAllocId(mctx);
            dbgEmitNode(mctx, id, "!DILocation(line: " + intToStr(ln) + ", column: " + intToStr(col) + ", scope: !" + intToStr(scopeId) + ")");
            strMapInsert(mctx.mcDbgLocCache, key, id);
            id
        },
    }
}

def dbgEmitStructType(
    mctx: ModEmitCtx,
    structId: Int,
    typeName: String,
    fieldNames: List String,
    fieldTys: List Type
): Void = {
    let memIdsRev: Cell (List String) = cellNew(Nil);
    let off = cellNew(0);
    let maxAl = cellNew(1);
    let idx = cellNew(0);
    let cf = cellNew(fieldTys);
    let cn = cellNew(fieldNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(ft, rft) -> {
                let fname = match cellGet(cn) {
                    Cons(nm, rnm) -> { cellSet(cn, rnm); nm },
                    Nil -> "_" + intToStr(cellGet(idx)),
                };
                let (fsz, fal) = typeSizeAndAlignFor(ft, mctx.mcPtrSize);
                let alignedOff = alignUp(cellGet(off), fal);
                let fDbgTy = dbgTypeForGeishaType(mctx, ft);
                let memId = dbgAllocId(mctx);
                let offClause = if (alignedOff > 0) ", offset: " + intToStr(alignedOff * 8) else "";
                dbgEmitNode(
                    mctx,
                    memId,
                    "!DIDerivedType(tag: DW_TAG_member, name: \"" + escapeDbgStr(fname)
                    + "\", scope: !" + intToStr(structId)
                    + ", baseType: !" + intToStr(fDbgTy)
                    + ", size: " + intToStr(fsz * 8)
                    + offClause + ")"
                );
                cellSet(memIdsRev, Cons("!" + intToStr(memId), cellGet(memIdsRev)));
                cellSet(off, alignedOff + fsz);
                if (fal > cellGet(maxAl)) cellSet(maxAl, fal) else ();
                cellSet(idx, cellGet(idx) + 1);
                cellSet(cf, rft)
            },
            Nil -> (),
        }
    };
    let totalBytes = alignUp(cellGet(off), cellGet(maxAl));
    let totalBits = if (totalBytes > 0) totalBytes * 8 else 8;
    let elemsId = dbgAllocId(mctx);
    dbgEmitNode(mctx, elemsId, "!{" + strJoin(listRev(cellGet(memIdsRev)), ", ") + "}");
    dbgEmitNode(
        mctx,
        structId,
        "distinct !DICompositeType(tag: DW_TAG_structure_type, name: \"" + escapeDbgStr(typeName)
        + "\", size: " + intToStr(totalBits)
        + ", elements: !" + intToStr(elemsId) + ")"
    )
}

def dbgTypeForGeishaType(mctx: ModEmitCtx, ty: Type): Int = {
    let key = typeToString(ty);
    match strMapGet(mctx.mcDbgTypeCache, key) {
        Some(id) -> id,
        None -> {
            let ptrBits = mctx.mcPtrSize * 8;
            match ty {
                TyVoid -> {
                    let id = dbgAllocId(mctx);
                    dbgEmitNode(mctx, id, "!DIBasicType(name: \"Void\", size: 8, encoding: DW_ATE_unsigned)");
                    strMapInsert(mctx.mcDbgTypeCache, key, id);
                    id
                },
                TyCon(n) ->
                    if (n == "Int") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Int\", size: 32, encoding: DW_ATE_signed)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "Int64") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Int64\", size: 64, encoding: DW_ATE_signed)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "Float") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Float\", size: 64, encoding: DW_ATE_float)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "Float32") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Float32\", size: 32, encoding: DW_ATE_float)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "Bool") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Bool\", size: 8, encoding: DW_ATE_boolean)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "Char") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Char\", size: 8, encoding: DW_ATE_signed_char)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "Void") {
                        let id = dbgAllocId(mctx);
                        dbgEmitNode(mctx, id, "!DIBasicType(name: \"Void\", size: 8, encoding: DW_ATE_unsigned)");
                        strMapInsert(mctx.mcDbgTypeCache, key, id);
                        id
                    } else if (n == "String") {
                        let charId = dbgTypeForGeishaType(mctx, TyCon("Char"));
                        let ptrId = dbgAllocId(mctx);
                        dbgEmitNode(mctx, ptrId, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: !" + intToStr(charId) + ", size: " + intToStr(ptrBits) + ")");
                        let tdId = dbgAllocId(mctx);
                        dbgEmitNode(mctx, tdId, "!DIDerivedType(tag: DW_TAG_typedef, name: \"String\", baseType: !" + intToStr(ptrId) + ")");
                        strMapInsert(mctx.mcDbgTypeCache, key, tdId);
                        tdId
                    } else {
                        dbgTypeForAdtOrOpaque(mctx, ty, key, ptrBits)
                    },
                TyTuple(elems) -> {
                    let structId = dbgAllocId(mctx);
                    strMapInsert(mctx.mcDbgTypeCache, key, structId);
                    dbgEmitStructType(mctx, structId, key, Nil, elems);
                    structId
                },
                TyComp(_, elemTy) -> {
                    let base = getCompBaseName(ty);
                    if (base == "Cell") {
                        let ptrId = dbgAllocId(mctx);
                        strMapInsert(mctx.mcDbgTypeCache, key, ptrId);
                        let innerId = dbgTypeForGeishaType(mctx, elemTy);
                        dbgEmitNode(mctx, ptrId, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: !" + intToStr(innerId) + ", size: " + intToStr(ptrBits) + ")");
                        ptrId
                    } else if (base == "MutArray" || base == "ImmArray") {
                        let ptrId = dbgAllocId(mctx);
                        strMapInsert(mctx.mcDbgTypeCache, key, ptrId);
                        let structId = dbgAllocId(mctx);
                        dbgEmitStructType(mctx, structId, "gs_array<" + typeToString(elemTy) + ">", ["len", "elem0"], [TyCon("Int64"), elemTy]);
                        dbgEmitNode(mctx, ptrId, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: !" + intToStr(structId) + ", size: " + intToStr(ptrBits) + ")");
                        ptrId
                    } else {
                        dbgTypeForAdtOrOpaque(mctx, ty, key, ptrBits)
                    }
                },
                _ -> {
                    let id = dbgAllocId(mctx);
                    dbgEmitNode(mctx, id, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: " + intToStr(ptrBits) + ")");
                    strMapInsert(mctx.mcDbgTypeCache, key, id);
                    id
                },
            }
        },
    }
}

def dbgTypeForAdtOrOpaque(mctx: ModEmitCtx, ty: Type, key: String, ptrBits: Int): Int =
    match unboxedAdtFields(ty) {
        Some(fs) -> {
            let structId = dbgAllocId(mctx);
            strMapInsert(mctx.mcDbgTypeCache, key, structId);
            let adtBase = getCompBaseName(ty);
            let fnames = match strMapGet(mctx.mcAdtReg, adtBase) {
                Some(ainfo) -> match ainfo.variants {
                    Cons(v, _) -> match v.fieldNames { Some(ns) -> ns, None -> Nil },
                    Nil -> Nil,
                },
                None -> Nil,
            };
            dbgEmitStructType(mctx, structId, key, fnames, fs);
            structId
        },
        None ->
            if (isAdtGeishaType(ty)) {
                let ptrId = dbgAllocId(mctx);
                strMapInsert(mctx.mcDbgTypeCache, key, ptrId);
                let structId = dbgAllocId(mctx);
                let adtBase = getCompBaseName(ty);
                let targs = extractTypeArgs(ty);
                let (_, _, maxAlign) = getAdtStorageLayout(mctx.mcAdtReg, adtBase, targs, mctx.mcPtrSize);
                let payTy = if (maxAlign >= 8) TyCon("Int64") else TyCon("Int");
                dbgEmitStructType(mctx, structId, "gs_adt<" + key + ">", ["tag", "payload"], [TyCon("Int"), payTy]);
                dbgEmitNode(mctx, ptrId, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: !" + intToStr(structId) + ", size: " + intToStr(ptrBits) + ")");
                ptrId
            } else {
                let id = dbgAllocId(mctx);
                dbgEmitNode(mctx, id, "!DIDerivedType(tag: DW_TAG_pointer_type, baseType: null, size: " + intToStr(ptrBits) + ")");
                strMapInsert(mctx.mcDbgTypeCache, key, id);
                id
            },
    }

def dbgEmitLocalVar(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    varName: String,
    varTy: Type,
    slotPtr: String,
    sp: Span,
    argNum: Int
): Void =
    if (mctx.mcDebug && fctx.fcDebug && fctx.fcSubprogramId >= 0 && strLen(varName) > 0 && strByteAt(varName, 0) != 46) {
        let bb = vecGetOr(fctx.fcBlocks, cellGet(fctx.fcCurBlk), fctx.fcDummyBlk);
        if (!cellGet(bb.bbTerm)) {
            let varDbgTy = dbgTypeForGeishaType(mctx, varTy);
            let (line0, _) = diagSpanLineCol(sp);
            let ln = if (line0 > 0) line0 else fctx.fcDefLine;
            let argClause = if (argNum > 0) ", arg: " + intToStr(argNum) else "";
            let varId = dbgAllocId(mctx);
            dbgEmitNode(
                mctx,
                varId,
                "!DILocalVariable(name: \"" + escapeDbgStr(varName) + "\"" + argClause
                + ", scope: !" + intToStr(fctx.fcSubprogramId)
                + ", file: !" + intToStr(fctx.fcDiFileId)
                + ", line: " + intToStr(ln)
                + ", type: !" + intToStr(varDbgTy) + ")"
            );
            let locId = dbgGetOrCreateLoc(mctx, fctx, sp);
            bufPushStr(bb.bbInstrs, "  call void @llvm.dbg.declare(metadata ptr ");
            bufPushStr(bb.bbInstrs, slotPtr);
            bufPushStr(bb.bbInstrs, ", metadata !");
            bufPushStr(bb.bbInstrs, intToStr(varId));
            bufPushStr(bb.bbInstrs, ", metadata !DIExpression()), !dbg !");
            bufPushStr(bb.bbInstrs, intToStr(locId));
            bufPushByte(bb.bbInstrs, 10)
        } else ()
    } else ()

def newFnEmitCtx(fnName: String): FnEmitCtx = {
    let blks: Vec BasicBlockBuf = vecNew();
    let entryBb = MkBlockBuf { bbLabel: "entry", bbInstrs: bufNew(), bbTerm: cellNew(false) };
    vecPush(blks, entryBb);
    MkFnEmitCtx {
        fcName: fnName,
        fcRegCnt: cellNew(0),
        fcBlkCnt: cellNew(0),
        fcAllocas: bufNew(),
        fcBlocks: blks,
        fcCurBlk: cellNew(0),
        fcPendingLet: cellNew(None),
        fcDummyBlk: entryBb,
        fcDebug: false,
        fcSubprogramId: -1,
        fcSrcFileId: 0,
        fcDiFileId: -1,
        fcDefLine: 1,
        fcCurLocId: cellNew(-1),
        fcCurSpan: cellNew(emptySpan()),
    }
}

def dbgGetOrCreatePrologueLoc(mctx: ModEmitCtx, scopeId: Int): Int = {
    let key = intToStr(scopeId) + ":0:0";
    match strMapGet(mctx.mcDbgLocCache, key) {
        Some(id) -> id,
        None -> {
            let id = dbgAllocId(mctx);
            dbgEmitNode(mctx, id, "!DILocation(line: 0, column: 0, scope: !" + intToStr(scopeId) + ")");
            strMapInsert(mctx.mcDbgLocCache, key, id);
            id
        },
    }
}

def newFnEmitCtxDebug(mctx: ModEmitCtx, fnName: String, displayName: String, linkageName: String, sp: Span): FnEmitCtx =
    if (!mctx.mcDebug) newFnEmitCtx(fnName)
    else {
        let blks: Vec BasicBlockBuf = vecNew();
        let entryBb = MkBlockBuf { bbLabel: "entry", bbInstrs: bufNew(), bbTerm: cellNew(false) };
        vecPush(blks, entryBb);
        let (spId, diFileId, defLine) = dbgCreateSubprogram(mctx, displayName, linkageName, sp);
        let fctx = MkFnEmitCtx {
            fcName: fnName,
            fcRegCnt: cellNew(0),
            fcBlkCnt: cellNew(0),
            fcAllocas: bufNew(),
            fcBlocks: blks,
            fcCurBlk: cellNew(0),
            fcPendingLet: cellNew(None),
            fcDummyBlk: entryBb,
            fcDebug: true,
            fcSubprogramId: spId,
            fcSrcFileId: sp.fileId,
            fcDiFileId: diFileId,
            fcDefLine: defLine,
            fcCurLocId: cellNew(-1),
            fcCurSpan: cellNew(sp),
        };
        let prologueLoc = dbgGetOrCreatePrologueLoc(mctx, spId);
        cellSet(fctx.fcCurLocId, prologueLoc);
        fctx
    }

def freshReg(fctx: FnEmitCtx): String = {
    let n = cellGet(fctx.fcRegCnt) + 1;
    cellSet(fctx.fcRegCnt, n);
    "%r" + intToStr(n)
}

def appendBlock(fctx: FnEmitCtx, prefix: String): Int = {
    let n = cellGet(fctx.fcBlkCnt) + 1;
    cellSet(fctx.fcBlkCnt, n);
    let lbl = prefix + "." + intToStr(n);
    let idx = vecLen(fctx.fcBlocks);
    vecPush(fctx.fcBlocks, MkBlockBuf { bbLabel: lbl, bbInstrs: bufNew(), bbTerm: cellNew(false) });
    idx
}

def setInsertBlock(fctx: FnEmitCtx, blkIdx: Int): Void =
    cellSet(fctx.fcCurBlk, blkIdx)

def getInsertBlock(fctx: FnEmitCtx): Int =
    cellGet(fctx.fcCurBlk)

def blockLabel(fctx: FnEmitCtx, blkIdx: Int): String = {
    let bb = vecGetOr(fctx.fcBlocks, blkIdx, fctx.fcDummyBlk);
    bb.bbLabel
}

def curBlockHasTerm(fctx: FnEmitCtx): Bool = {
    let bb = vecGetOr(fctx.fcBlocks, cellGet(fctx.fcCurBlk), fctx.fcDummyBlk);
    cellGet(bb.bbTerm)
}

def emitLine(fctx: FnEmitCtx, line: String): Void = {
    let bb = vecGetOr(fctx.fcBlocks, cellGet(fctx.fcCurBlk), fctx.fcDummyBlk);
    if (!cellGet(bb.bbTerm)) {
        bufPushStr(bb.bbInstrs, "  ");
        bufPushStr(bb.bbInstrs, line);
        if (fctx.fcDebug) {
            let loc = cellGet(fctx.fcCurLocId);
            if (loc >= 0) {
                bufPushStr(bb.bbInstrs, ", !dbg !");
                bufPushStr(bb.bbInstrs, intToStr(loc))
            } else ()
        } else ();
        bufPushByte(bb.bbInstrs, 10)
    } else ()
}

def emitTermLine(fctx: FnEmitCtx, line: String): Void = {
    let bb = vecGetOr(fctx.fcBlocks, cellGet(fctx.fcCurBlk), fctx.fcDummyBlk);
    if (!cellGet(bb.bbTerm)) {
        bufPushStr(bb.bbInstrs, "  ");
        bufPushStr(bb.bbInstrs, line);
        if (fctx.fcDebug) {
            let loc = cellGet(fctx.fcCurLocId);
            if (loc >= 0) {
                bufPushStr(bb.bbInstrs, ", !dbg !");
                bufPushStr(bb.bbInstrs, intToStr(loc))
            } else ()
        } else ();
        bufPushByte(bb.bbInstrs, 10);
        cellSet(bb.bbTerm, true)
    } else ()
}

def emitAssign(fctx: FnEmitCtx, rhs: String): String = {
    let reg = freshReg(fctx);
    emitLine(fctx, reg + " = " + rhs);
    reg
}

def emitEntryAlloca(fctx: FnEmitCtx, llvmTy: String): String = {
    let reg = freshReg(fctx);
    bufPushStr(fctx.fcAllocas, "  ");
    bufPushStr(fctx.fcAllocas, reg);
    bufPushStr(fctx.fcAllocas, " = alloca ");
    bufPushStr(fctx.fcAllocas, llvmTy);
    bufPushByte(fctx.fcAllocas, 10);
    reg
}

def emitBr(fctx: FnEmitCtx, targetBlk: Int): Void =
    emitTermLine(fctx, "br label %" + blockLabel(fctx, targetBlk))

def emitCondBr(fctx: FnEmitCtx, condVal: String, thenBlk: Int, elseBlk: Int): Void =
    emitTermLine(fctx, "br i1 " + condVal + ", label %" + blockLabel(fctx, thenBlk) + ", label %" + blockLabel(fctx, elseBlk))

def emitStructFieldPtr(fctx: FnEmitCtx, structTy: String, basePtr: String, fieldIdx: Int): String =
    emitAssign(fctx, "getelementptr inbounds " + structTy + ", ptr " + basePtr + ", i32 0, i32 " + intToStr(fieldIdx))

def emitGep(fctx: FnEmitCtx, elemTy: String, basePtr: String, idx64Val: String): String =
    emitAssign(fctx, "getelementptr " + elemTy + ", ptr " + basePtr + ", i64 " + idx64Val)

def emitLoad(fctx: FnEmitCtx, llvmTy: String, ptrVal: String): String =
    emitAssign(fctx, "load " + llvmTy + ", ptr " + ptrVal)

def emitStore(fctx: FnEmitCtx, llvmTy: String, val: String, ptrVal: String): Void = {
    let normVal = if (llvmTy == "ptr" && val == "0") "null" else val;
    emitLine(fctx, "store " + llvmTy + " " + normVal + ", ptr " + ptrVal)
}

def flushFunctionToBuf(out: StringBuf, header: String, fctx: FnEmitCtx): Void = {
    bufPushStr(out, header);
    if (fctx.fcDebug && fctx.fcSubprogramId >= 0) {
        bufPushStr(out, " !dbg !");
        bufPushStr(out, intToStr(fctx.fcSubprogramId))
    } else ();
    bufPushStr(out, " {\nentry:\n");
    bufPushBuf(out, fctx.fcAllocas);
    let entryBb = vecGetOr(fctx.fcBlocks, 0, fctx.fcDummyBlk);
    bufPushBuf(out, entryBb.bbInstrs);
    let total = vecLen(fctx.fcBlocks);
    let i = cellNew(1);
    while (cellGet(i) < total) {
        let bb = vecGetOr(fctx.fcBlocks, cellGet(i), fctx.fcDummyBlk);
        bufPushByte(out, 10);
        bufPushStr(out, bb.bbLabel);
        bufPushStr(out, ":\n");
        bufPushBuf(out, bb.bbInstrs);
        cellSet(i, cellGet(i) + 1)
    };
    bufPushStr(out, "}\n\n")
}

// ============================================================================
// Lexical Symbol Table Lookup & Global String Pool
// ============================================================================

def lookupVarSlot(locals: List (String, VarSlot), globals: StrMap VarSlot, name: String): Option VarSlot =
    match lookupLocalSlot(locals, name) {
        Some(s) -> Some(s),
        None -> strMapGet(globals, name),
    }

def lookupLocalSlot(locals: List (String, VarSlot), name: String): Option VarSlot = match locals {
    Nil -> None,
    Cons((k, v), r) -> if (k == name) Some(v) else lookupLocalSlot(r, name),
}

def emitGlobalStringConst(mctx: ModEmitCtx, s: String): String =
    match strMapGet(mctx.mcStrPool, s) {
        Some(existing) -> existing,
        None -> {
            let id = cellGet(mctx.mcStrCnt);
            cellSet(mctx.mcStrCnt, id + 1);
            let sym = "@.str." + intToStr(id);
            let byteLen = strLen(s) + 1;
            bufPushStr(mctx.mcStrDecls, sym);
            bufPushStr(mctx.mcStrDecls, " = private unnamed_addr constant [");
            bufPushStr(mctx.mcStrDecls, intToStr(byteLen));
            bufPushStr(mctx.mcStrDecls, " x i8] ");
            bufPushStr(mctx.mcStrDecls, encodeLlvmCString(s));
            bufPushStr(mctx.mcStrDecls, ", align 1\n");
            strMapInsert(mctx.mcStrPool, s, sym);
            sym
        },
    }

def emitNullaryAdtConst(mctx: ModEmitCtx, tag: Int): String = {
    let tagStr = intToStr(tag);
    let key = "adt:" + tagStr;
    match strMapGet(mctx.mcConstPool, key) {
        Some(sym) -> sym,
        None -> {
            let sym = "@.adt.tag." + tagStr;
            bufPushStr(mctx.mcStrDecls, sym);
            bufPushStr(mctx.mcStrDecls, " = private unnamed_addr constant { i32 } { i32 ");
            bufPushStr(mctx.mcStrDecls, tagStr);
            bufPushStr(mctx.mcStrDecls, " }, align 4\n");
            strMapInsert(mctx.mcConstPool, key, sym);
            sym
        },
    }
}

def emitStaticClosureConst(mctx: ModEmitCtx, entryName: String): String = {
    let key = "cls:" + entryName;
    match strMapGet(mctx.mcConstPool, key) {
        Some(sym) -> sym,
        None -> {
            let id = cellGet(mctx.mcConstCnt);
            cellSet(mctx.mcConstCnt, id + 1);
            let sym = "@.cls." + intToStr(id);
            bufPushStr(mctx.mcStrDecls, sym);
            if (mctx.mcIsWasm) {
                bufPushStr(mctx.mcStrDecls, " = private unnamed_addr constant { ptr, i32, {} } { ptr ");
                bufPushStr(mctx.mcStrDecls, geishaFnSym(mctx, entryName));
                bufPushStr(mctx.mcStrDecls, ", i32 0, {} zeroinitializer }, align 8\n")
            } else {
                bufPushStr(mctx.mcStrDecls, " = private unnamed_addr constant { ptr, {} } { ptr ");
                bufPushStr(mctx.mcStrDecls, geishaFnSym(mctx, entryName));
                bufPushStr(mctx.mcStrDecls, ", {} zeroinitializer }, align 8\n")
            };
            strMapInsert(mctx.mcConstPool, key, sym);
            sym
        },
    }
}

def genLit(mctx: ModEmitCtx, lit: Lit): String = match lit {
    LitInt(i) -> intToStr(i),
    LitFloat(f) -> floatToHex16(f),
    LitChar(c) -> intToStr(c & 255),
    LitBool(b) -> if (b) "true" else "false",
    LitUnit -> "0",
    LitStr(s) -> emitGlobalStringConst(mctx, s),
}

// ============================================================================
// GC Safepoint Poll & Concurrency Helpers (`box`, `unbox`, Trampolines)
// ============================================================================

def emitInlineWriteBarrier(fctx: FnEmitCtx, containerPtr: String): Void = {
    let hdrPtr = emitAssign(fctx, "getelementptr i8, ptr " + containerPtr + ", i64 -8");
    let hdrVal = emitAssign(fctx, "load atomic i64, ptr " + hdrPtr + " monotonic, align 8");
    let bits = emitAssign(fctx, "and i64 " + hdrVal + ", 8388610");
    let need = emitAssign(fctx, "icmp eq i64 " + bits + ", 8388608");
    let slowBlk = appendBlock(fctx, "wb.slow");
    let doneBlk = appendBlock(fctx, "wb.done");
    emitCondBr(fctx, need, slowBlk, doneBlk);
    setInsertBlock(fctx, slowBlk);
    emitLine(fctx, "call void @gc_write_barrier(ptr " + containerPtr + ")");
    emitBr(fctx, doneBlk);
    setInsertBlock(fctx, doneBlk)
}

def emitGcSafepointPoll(mctx: ModEmitCtx, fctx: FnEmitCtx): Void =
    if (mctx.mcIsWasm) ()
    else {
        let flag = emitAssign(fctx, "load atomic i32, ptr @__gs_gc_stw_requested monotonic, align 4");
        let needSp = emitAssign(fctx, "icmp ne i32 " + flag + ", 0");
        let slowBlk = appendBlock(fctx, "gc.sp.slow");
        let contBlk = appendBlock(fctx, "gc.sp.cont");
        emitCondBr(fctx, needSp, slowBlk, contBlk);

        setInsertBlock(fctx, slowBlk);
        emitLine(fctx, "call void @gc_safepoint_slow()");
        emitBr(fctx, contBlk);

        setInsertBlock(fctx, contBlk)
    }

def mangleConcTypeSym(ty: Type): String = match ty {
    TyVoid -> "Void",
    TyCon(n) -> replaceDotsUnderscore(n),
    TyVar(v) -> "V_" + v,
    TyTuple(es) -> "Tup" + intToStr(listLen(es)) + "_" + joinConcTypes(es),
    TyArr(_, ps, r) -> "Fn" + intToStr(listLen(ps)) + "_" + joinConcTypes(ps) + "_to_" + mangleConcTypeSym(r),
    TyComp(b, a) -> mangleConcTypeSym(b) + "_of_" + mangleConcTypeSym(a),
}

def joinConcTypes(ts: List Type): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> mangleConcTypeSym(h),
    Cons(h, t) -> mangleConcTypeSym(h) + "_" + joinConcTypes(t),
}

def replaceDotsUnderscore(s: String): String = {
    let n = strLen(s);
    let b = bufNew();
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let c = strByteAt(s, cellGet(i));
        bufPushByte(b, if (c == 46) 95 else c);
        cellSet(i, cellGet(i) + 1)
    };
    bufToString(b)
}

def boxGeishaValue(mctx: ModEmitCtx, fctx: FnEmitCtx, val: String, ty: Type): String =
    if (isVoidGeishaType(ty)) "null"
    else {
        let elemLlvmTy = getValLlvmType(ty);
        let (rawSz, _) = typeSizeAndAlign(ty);
        let byteSz = if (rawSz < 8) 8 else rawSz;
        let boxPtr = emitGcAllocForType(mctx, fctx, byteSz, ty);
        emitStore(fctx, elemLlvmTy, val, boxPtr);
        boxPtr
    }

def unboxGeishaValue(fctx: FnEmitCtx, boxPtr: String, ty: Type): String =
    if (isVoidGeishaType(ty)) "0"
    else emitLoad(fctx, getValLlvmType(ty), boxPtr)

def emitNullableBoxToPair(fctx: FnEmitCtx, boxPtr: String, pairRetTy: Type): String = {
    let elemTy = match pairRetTy {
        TyTuple(Cons(_, Cons(et, _))) -> et,
        _ -> TyVoid,
    };
    let pairLlvmTy = getValLlvmType(pairRetTy);
    let elemLlvmTy = getValLlvmType(elemTy);
    let hasVal = emitAssign(fctx, "icmp ne ptr " + boxPtr + ", null");

    let someBlk = appendBlock(fctx, "conc.some");
    let noneBlk = appendBlock(fctx, "conc.none");
    let mergeBlk = appendBlock(fctx, "conc.merge");
    emitCondBr(fctx, hasVal, someBlk, noneBlk);

    setInsertBlock(fctx, someBlk);
    let loadedVal = if (isVoidGeishaType(elemTy)) "0" else emitLoad(fctx, elemLlvmTy, boxPtr);
    let someEnd = getInsertBlock(fctx);
    emitBr(fctx, mergeBlk);

    setInsertBlock(fctx, noneBlk);
    let zeroVal = llvmZeroValue(elemLlvmTy);
    let noneEnd = getInsertBlock(fctx);
    emitBr(fctx, mergeBlk);

    setInsertBlock(fctx, mergeBlk);
    let valPhi = emitAssign(
        fctx,
        "phi " + elemLlvmTy + " [ " + loadedVal + ", %" + blockLabel(fctx, someEnd) + " ], [ " + zeroVal + ", %" + blockLabel(fctx, noneEnd) + " ]"
    );
    let agg0 = emitAssign(fctx, "insertvalue " + pairLlvmTy + " undef, i1 " + hasVal + ", 0");
    emitAssign(fctx, "insertvalue " + pairLlvmTy + " " + agg0 + ", " + elemLlvmTy + " " + valPhi + ", 1")
}

def emitClosureFnSlot(mctx: ModEmitCtx, fctx: FnEmitCtx, clsPtr: String): String =
    if (mctx.mcIsWasm) emitStructFieldPtr(fctx, "{ ptr, i32, {} }", clsPtr, 0)
    else emitStructFieldPtr(fctx, "{ ptr, ptr }", clsPtr, 0)

def emitClosureFvsPtr(mctx: ModEmitCtx, fctx: FnEmitCtx, clsPtr: String): String =
    if (mctx.mcIsWasm) emitStructFieldPtr(fctx, "{ ptr, i32, {} }", clsPtr, 2)
    else emitStructFieldPtr(fctx, "{ ptr, ptr }", clsPtr, 1)

def getOrEmitThunkRunner(mctx: ModEmitCtx, retTy: Type): String = {
    let rawSym = "__gs_thunk_runner__" + mangleConcTypeSym(retTy);
    let sym = llvmSym(rawSym);
    if (!strMapContains(mctx.mcSynthSet, rawSym)) {
        strMapInsert(mctx.mcSynthSet, rawSym, true);
        let rf = newFnEmitCtx(rawSym);
        let fvsPtr = emitClosureFvsPtr(mctx, rf, "%cls_ptr");
        let fnSlot = emitClosureFnSlot(mctx, rf, "%cls_ptr");
        let fnEntry = emitLoad(rf, "ptr", fnSlot);
        let retLlvm = getFnRetLlvmType(retTy);
        let callVal =
            if (retLlvm == "void") {
                emitLine(rf, "call void " + fnEntry + "(ptr " + fvsPtr + ")");
                "0"
            } else {
                emitAssign(rf, "call " + retLlvm + " " + fnEntry + "(ptr " + fvsPtr + ")")
            };
        let boxed =
            if (isVoidGeishaType(retTy)) {
                emitAssign(rf, "call ptr @gc_alloc_atomic_uninit(i64 8)")
            } else {
                boxGeishaValue(mctx, rf, callVal, retTy)
            };
        emitTermLine(rf, "ret ptr " + boxed);
        flushFunctionToBuf(mctx.mcSynthFns, "define internal ptr " + sym + "(ptr %cls_ptr) nounwind", rf)
    } else ();
    sym
}

def getOrEmitActorRunner(mctx: ModEmitCtx, stateTy: Type, retTy: Type): String = {
    let rawSym = "__gs_actor_runner__" + mangleConcTypeSym(stateTy) + "__" + mangleConcTypeSym(retTy);
    let sym = llvmSym(rawSym);
    if (!strMapContains(mctx.mcSynthSet, rawSym)) {
        strMapInsert(mctx.mcSynthSet, rawSym, true);
        let rf = newFnEmitCtx(rawSym);
        let stVal = unboxGeishaValue(rf, "%state_box", stateTy);
        let stLlvm = getValLlvmType(stateTy);
        let fvsPtr = emitClosureFvsPtr(mctx, rf, "%cls_ptr");
        let fnSlot = emitClosureFnSlot(mctx, rf, "%cls_ptr");
        let fnEntry = emitLoad(rf, "ptr", fnSlot);
        let retLlvm = getFnRetLlvmType(retTy);
        let callVal =
            if (retLlvm == "void") {
                emitLine(rf, "call void " + fnEntry + "(" + stLlvm + " " + stVal + ", ptr " + fvsPtr + ")");
                "0"
            } else {
                emitAssign(rf, "call " + retLlvm + " " + fnEntry + "(" + stLlvm + " " + stVal + ", ptr " + fvsPtr + ")")
            };
        let boxed =
            if (isVoidGeishaType(retTy)) "null"
            else boxGeishaValue(mctx, rf, callVal, retTy);
        emitTermLine(rf, "ret ptr " + boxed);
        flushFunctionToBuf(mctx.mcSynthFns, "define internal ptr " + sym + "(ptr %state_box, ptr %cls_ptr) nounwind", rf)
    } else ();
    sym
}

def getOrEmitTabulateRunner(mctx: ModEmitCtx, elemTy: Type): String = {
    let rawSym = "__gs_tabulate_runner__" + mangleConcTypeSym(elemTy);
    let sym = llvmSym(rawSym);
    if (!strMapContains(mctx.mcSynthSet, rawSym)) {
        strMapInsert(mctx.mcSynthSet, rawSym, true);
        let rf = newFnEmitCtx(rawSym);
        let elemLlvm = getValLlvmType(elemTy);
        let retLlvm = getFnRetLlvmType(elemTy);
        let fvsPtr = emitClosureFvsPtr(mctx, rf, "%cls_ptr");
        let fnSlot = emitClosureFnSlot(mctx, rf, "%cls_ptr");
        let fnEntry = emitLoad(rf, "ptr", fnSlot);
        let elemsBase = emitGep(rf, "i8", "%arr_ptr", "8");
        let idxSlot = emitEntryAlloca(rf, "i32");
        emitStore(rf, "i32", "%lo", idxSlot);

        let condBlk = appendBlock(rf, "tab.cond");
        let bodyBlk = appendBlock(rf, "tab.body");
        let doneBlk = appendBlock(rf, "tab.done");
        emitBr(rf, condBlk);

        setInsertBlock(rf, condBlk);
        emitGcSafepointPoll(mctx, rf);
        let curI = emitLoad(rf, "i32", idxSlot);
        let more = emitAssign(rf, "icmp slt i32 " + curI + ", %hi");
        emitCondBr(rf, more, bodyBlk, doneBlk);

        setInsertBlock(rf, bodyBlk);
        let callVal =
            if (retLlvm == "void") {
                emitLine(rf, "call void " + fnEntry + "(i32 " + curI + ", ptr " + fvsPtr + ")");
                "0"
            } else {
                emitAssign(rf, "call " + retLlvm + " " + fnEntry + "(i32 " + curI + ", ptr " + fvsPtr + ")")
            };
        let i64Idx = emitAssign(rf, "sext i32 " + curI + " to i64");
        let slotPtr = emitGep(rf, elemLlvm, elemsBase, i64Idx);
        emitStore(rf, elemLlvm, callVal, slotPtr);
        if (!mctx.mcIsWasm && !isNoscanElemType(elemTy)) {
            emitInlineWriteBarrier(rf, "%arr_ptr")
        } else ();
        let nextI = emitAssign(rf, "add i32 " + curI + ", 1");
        emitStore(rf, "i32", nextI, idxSlot);
        emitBr(rf, condBlk);

        setInsertBlock(rf, doneBlk);
        emitTermLine(rf, "ret void");
        flushFunctionToBuf(mctx.mcSynthFns, "define internal void " + sym + "(ptr %arr_ptr, i32 %lo, i32 %hi, ptr %cls_ptr) nounwind", rf)
    } else ();
    sym
}

// ============================================================================
// Binary Operators, Intrinsics, Pattern Matching, and Expression Emission
// ============================================================================

def emitBinOperator(mctx: ModEmitCtx, fctx: FnEmitCtx, op: BinOp, lhs: String, rhs: String, operandTy: Type): String = {
    let tyName = match operandTy {
        TyCon(n) -> n,
        _ -> "Int",
    };
    if (tyName == "String") {
        match op {
            OpAdd -> {
                let sl = strlenSym(mctx);
                let la = emitAssign(fctx, "call i64 " + sl + "(ptr " + lhs + ")");
                let lb = emitAssign(fctx, "call i64 " + sl + "(ptr " + rhs + ")");
                let lab = emitAssign(fctx, "add i64 " + la + ", " + lb);
                let allocSz = emitAssign(fctx, "add i64 " + lab + ", 1");
                let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + allocSz + ")");
                emitLlvmMemcpy(fctx, dst, lhs, la);
                let dstB = emitGep(fctx, "i8", dst, la);
                emitLlvmMemcpy(fctx, dstB, rhs, lb);
                let termPtr = emitGep(fctx, "i8", dst, lab);
                emitStore(fctx, "i8", "0", termPtr);
                dst
            },
            _ -> {
                let cmpVal = emitAssign(fctx, "call i32 @gs_str_cmp(ptr " + lhs + ", ptr " + rhs + ")");
                let pred = match op {
                    OpEq -> "eq",
                    OpNe -> "ne",
                    OpLt -> "slt",
                    OpLe -> "sle",
                    OpGt -> "sgt",
                    OpGe -> "sge",
                    _ -> "eq",
                };
                emitAssign(fctx, "icmp " + pred + " i32 " + cmpVal + ", 0")
            },
        }
    } else if (tyName == "Float") {
        match op {
            OpAdd -> emitAssign(fctx, "fadd double " + lhs + ", " + rhs),
            OpSub -> emitAssign(fctx, "fsub double " + lhs + ", " + rhs),
            OpMul -> emitAssign(fctx, "fmul double " + lhs + ", " + rhs),
            OpDiv -> emitAssign(fctx, "fdiv double " + lhs + ", " + rhs),
            OpEq -> emitAssign(fctx, "fcmp oeq double " + lhs + ", " + rhs),
            OpNe -> emitAssign(fctx, "fcmp one double " + lhs + ", " + rhs),
            OpLt -> emitAssign(fctx, "fcmp olt double " + lhs + ", " + rhs),
            OpLe -> emitAssign(fctx, "fcmp ole double " + lhs + ", " + rhs),
            OpGt -> emitAssign(fctx, "fcmp ogt double " + lhs + ", " + rhs),
            OpGe -> emitAssign(fctx, "fcmp oge double " + lhs + ", " + rhs),
            _ -> emitAssign(fctx, "fadd double " + lhs + ", " + rhs),
        }
    } else if (tyName == "Float32") {
        match op {
            OpAdd -> emitAssign(fctx, "fadd float " + lhs + ", " + rhs),
            OpSub -> emitAssign(fctx, "fsub float " + lhs + ", " + rhs),
            OpMul -> emitAssign(fctx, "fmul float " + lhs + ", " + rhs),
            OpDiv -> emitAssign(fctx, "fdiv float " + lhs + ", " + rhs),
            OpEq -> emitAssign(fctx, "fcmp oeq float " + lhs + ", " + rhs),
            OpNe -> emitAssign(fctx, "fcmp one float " + lhs + ", " + rhs),
            OpLt -> emitAssign(fctx, "fcmp olt float " + lhs + ", " + rhs),
            OpLe -> emitAssign(fctx, "fcmp ole float " + lhs + ", " + rhs),
            OpGt -> emitAssign(fctx, "fcmp ogt float " + lhs + ", " + rhs),
            OpGe -> emitAssign(fctx, "fcmp oge float " + lhs + ", " + rhs),
            _ -> emitAssign(fctx, "fadd float " + lhs + ", " + rhs),
        }
    } else if (tyName == "Bool" || tyName == "Char") {
        let lty = if (tyName == "Bool") "i1" else "i8";
        match op {
            OpEq -> emitAssign(fctx, "icmp eq " + lty + " " + lhs + ", " + rhs),
            OpNe -> emitAssign(fctx, "icmp ne " + lty + " " + lhs + ", " + rhs),
            OpLt -> emitAssign(fctx, "icmp ult " + lty + " " + lhs + ", " + rhs),
            OpLe -> emitAssign(fctx, "icmp ule " + lty + " " + lhs + ", " + rhs),
            OpGt -> emitAssign(fctx, "icmp ugt " + lty + " " + lhs + ", " + rhs),
            OpGe -> emitAssign(fctx, "icmp uge " + lty + " " + lhs + ", " + rhs),
            OpAnd -> emitAssign(fctx, "and " + lty + " " + lhs + ", " + rhs),
            OpOr -> emitAssign(fctx, "or " + lty + " " + lhs + ", " + rhs),
            OpBitAnd -> emitAssign(fctx, "and " + lty + " " + lhs + ", " + rhs),
            OpBitOr -> emitAssign(fctx, "or " + lty + " " + lhs + ", " + rhs),
            OpBitXor -> emitAssign(fctx, "xor " + lty + " " + lhs + ", " + rhs),
            _ -> emitAssign(fctx, "icmp eq " + lty + " " + lhs + ", " + rhs),
        }
    } else {
        // `Int` (`i32`) or `Int64` (`i64`)
        let ity = if (tyName == "Int64") "i64" else "i32";
        match op {
            OpAdd -> emitAssign(fctx, "add " + ity + " " + lhs + ", " + rhs),
            OpSub -> emitAssign(fctx, "sub " + ity + " " + lhs + ", " + rhs),
            OpMul -> emitAssign(fctx, "mul " + ity + " " + lhs + ", " + rhs),
            OpDiv -> {
                let divZeroBlk = appendBlock(fctx, "div.zero");
                let divNonZeroBlk = appendBlock(fctx, "div.nonzero");
                let divOvBlk = appendBlock(fctx, "div.ov");
                let divNormalBlk = appendBlock(fctx, "div.normal");
                let divDoneBlk = appendBlock(fctx, "div.done");
                let isZero = emitAssign(fctx, "icmp eq " + ity + " " + rhs + ", 0");
                emitCondBr(fctx, isZero, divZeroBlk, divNonZeroBlk);

                setInsertBlock(fctx, divZeroBlk);
                emitLine(fctx, "call void @gs_div_zero_fail()");
                emitTermLine(fctx, "unreachable");

                setInsertBlock(fctx, divNonZeroBlk);
                let minLit = if (tyName == "Int64") "-9223372036854775808" else "-2147483648";
                let isMin = emitAssign(fctx, "icmp eq " + ity + " " + lhs + ", " + minLit);
                let isNeg1 = emitAssign(fctx, "icmp eq " + ity + " " + rhs + ", -1");
                let isOv = emitAssign(fctx, "and i1 " + isMin + ", " + isNeg1);
                emitCondBr(fctx, isOv, divOvBlk, divNormalBlk);

                setInsertBlock(fctx, divOvBlk);
                emitBr(fctx, divDoneBlk);

                setInsertBlock(fctx, divNormalBlk);
                let q = emitAssign(fctx, "sdiv " + ity + " " + lhs + ", " + rhs);
                emitBr(fctx, divDoneBlk);

                setInsertBlock(fctx, divDoneBlk);
                emitAssign(fctx, "phi " + ity + " [ " + minLit + ", %" + blockLabel(fctx, divOvBlk) + " ], [ " + q + ", %" + blockLabel(fctx, divNormalBlk) + " ]")
            },
            OpRem -> {
                let remZeroBlk = appendBlock(fctx, "rem.zero");
                let remNonZeroBlk = appendBlock(fctx, "rem.nonzero");
                let remOvBlk = appendBlock(fctx, "rem.ov");
                let remNormalBlk = appendBlock(fctx, "rem.normal");
                let remDoneBlk = appendBlock(fctx, "rem.done");
                let isZero = emitAssign(fctx, "icmp eq " + ity + " " + rhs + ", 0");
                emitCondBr(fctx, isZero, remZeroBlk, remNonZeroBlk);

                setInsertBlock(fctx, remZeroBlk);
                emitLine(fctx, "call void @gs_div_zero_fail()");
                emitTermLine(fctx, "unreachable");

                setInsertBlock(fctx, remNonZeroBlk);
                let minLit = if (tyName == "Int64") "-9223372036854775808" else "-2147483648";
                let isMin = emitAssign(fctx, "icmp eq " + ity + " " + lhs + ", " + minLit);
                let isNeg1 = emitAssign(fctx, "icmp eq " + ity + " " + rhs + ", -1");
                let isOv = emitAssign(fctx, "and i1 " + isMin + ", " + isNeg1);
                emitCondBr(fctx, isOv, remOvBlk, remNormalBlk);

                setInsertBlock(fctx, remOvBlk);
                emitBr(fctx, remDoneBlk);

                setInsertBlock(fctx, remNormalBlk);
                let r = emitAssign(fctx, "srem " + ity + " " + lhs + ", " + rhs);
                emitBr(fctx, remDoneBlk);

                setInsertBlock(fctx, remDoneBlk);
                emitAssign(fctx, "phi " + ity + " [ 0, %" + blockLabel(fctx, remOvBlk) + " ], [ " + r + ", %" + blockLabel(fctx, remNormalBlk) + " ]")
            },
            OpBitAnd -> emitAssign(fctx, "and " + ity + " " + lhs + ", " + rhs),
            OpBitOr -> emitAssign(fctx, "or " + ity + " " + lhs + ", " + rhs),
            OpBitXor -> emitAssign(fctx, "xor " + ity + " " + lhs + ", " + rhs),
            OpShl ->
                if (tyName == "Int64") {
                    let m32 = emitAssign(fctx, "and i32 " + rhs + ", 63");
                    let cnt64 = emitAssign(fctx, "zext i32 " + m32 + " to i64");
                    emitAssign(fctx, "shl i64 " + lhs + ", " + cnt64)
                } else {
                    let m32 = emitAssign(fctx, "and i32 " + rhs + ", 31");
                    emitAssign(fctx, "shl i32 " + lhs + ", " + m32)
                },
            OpShr ->
                if (tyName == "Int64") {
                    let m32 = emitAssign(fctx, "and i32 " + rhs + ", 63");
                    let cnt64 = emitAssign(fctx, "zext i32 " + m32 + " to i64");
                    emitAssign(fctx, "ashr i64 " + lhs + ", " + cnt64)
                } else {
                    let m32 = emitAssign(fctx, "and i32 " + rhs + ", 31");
                    emitAssign(fctx, "ashr i32 " + lhs + ", " + m32)
                },
            OpUshr ->
                if (tyName == "Int64") {
                    let m32 = emitAssign(fctx, "and i32 " + rhs + ", 63");
                    let cnt64 = emitAssign(fctx, "zext i32 " + m32 + " to i64");
                    emitAssign(fctx, "lshr i64 " + lhs + ", " + cnt64)
                } else {
                    let m32 = emitAssign(fctx, "and i32 " + rhs + ", 31");
                    emitAssign(fctx, "lshr i32 " + lhs + ", " + m32)
                },
            OpEq -> emitAssign(fctx, "icmp eq " + ity + " " + lhs + ", " + rhs),
            OpNe -> emitAssign(fctx, "icmp ne " + ity + " " + lhs + ", " + rhs),
            OpLt -> emitAssign(fctx, "icmp slt " + ity + " " + lhs + ", " + rhs),
            OpLe -> emitAssign(fctx, "icmp sle " + ity + " " + lhs + ", " + rhs),
            OpGt -> emitAssign(fctx, "icmp sgt " + ity + " " + lhs + ", " + rhs),
            OpGe -> emitAssign(fctx, "icmp sge " + ity + " " + lhs + ", " + rhs),
            _ -> emitAssign(fctx, "add " + ity + " " + lhs + ", " + rhs),
        }
    }
}

def nthArgTerm(args: List TaggedTerm, idx: Int): TaggedTerm = match args {
    Cons(h, t) -> if (idx == 0) h else nthArgTerm(t, idx - 1),
    Nil -> MkTerm { tspan: emptySpan(), tscm: ScmMono(TyVoid), tnode: TmLit(LitUnit) },
}

def tryEmitIntrinsic(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    name: String,
    args: List TaggedTerm,
    retTy: Type,
    locals: List (String, VarSlot),
    directLetVar: Option String
): Option String = {
    if (name == "__blackBox") {
        let a0 = nthArgTerm(args, 0);
        let argVal = genExpr(mctx, fctx, a0, locals, false);
        let valTy = schemeBody(a0.tscm);
        match valTy {
            TyVoid -> {
                emitLine(fctx, "call void @gs_bench_black_box_void()");
                Some("0")
            },
            _ -> {
                let llvmTy = getValLlvmType(valTy);
                let slot = emitEntryAlloca(fctx, llvmTy);
