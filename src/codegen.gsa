            Some(bindName) -> isStackAlloc(mctx.mcEscape, fctx.fcName, bindName),
            None -> false,
        };
        let cellPtr =
            if (useStack) {
                if (!mctx.mcIsWasm && !isNoscanElemType(elemTy)) {
