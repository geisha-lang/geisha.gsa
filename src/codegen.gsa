    } else if (name == "gcHandleNew") {
        let argTerm = nthArgTerm(args, 0);
        let argTy = schemeBody(argTerm.tscm);
        let v = genExpr(mctx, fctx, argTerm, locals, false);
        let rawPtr = if (isGcPointerType(argTy)) v else boxGeishaValue(mctx, fctx, v, argTy);
        Some(emitAssign(fctx, "call i64 @gc_handle_new(ptr " + rawPtr + ")"))
    } else if (name == "gcHandleGet") {
        let h = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let rawPtr = emitAssign(fctx, "call ptr @gc_handle_get(i64 " + h + ")");
        if (isGcPointerType(retTy)) Some(rawPtr)
        else Some(unboxGeishaValue(fctx, rawPtr, retTy))
    } else if (name == "gcHandleFree") {
        let h = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        emitLine(fctx, "call void @gc_handle_free(i64 " + h + ")");
        Some("0")
    } else if (name == "gcTrim") {
        emitLine(fctx, "call void @gc_trim()");
        Some("0")
    } else if (name == "gcSetThresholds") {
        let minB = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let majB = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        emitLine(fctx, "call void @gc_set_thresholds(i64 " + minB + ", i64 " + majB + ")");
        Some("0")
    } else if (name == "gcHeapLiveBytes") {
        Some(emitAssign(fctx, "call i64 @gc_heap_live_bytes()"))
    } else if (name == "ptrCopyBytes") {
        let dst = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let dstOff32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let src = genExpr(mctx, fctx, nthArgTerm(args, 2), locals, false);
        let srcOff32 = genExpr(mctx, fctx, nthArgTerm(args, 3), locals, false);
        let len32 = genExpr(mctx, fctx, nthArgTerm(args, 4), locals, false);
        let dstOff64 = emitAssign(fctx, "sext i32 " + dstOff32 + " to i64");
        let srcOff64 = emitAssign(fctx, "sext i32 " + srcOff32 + " to i64");
        let len64 = emitAssign(fctx, "sext i32 " + len32 + " to i64");
        let dstP = emitGep(fctx, "i8", dst, dstOff64);
        let srcP = emitGep(fctx, "i8", src, srcOff64);
        emitLlvmMemmove(fctx, dstP, srcP, len64);
        Some("0")
    } else if (name == "ptrCopyFromStr") {
        let dst = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let dstOff32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let src = genExpr(mctx, fctx, nthArgTerm(args, 2), locals, false);
        let len32 = genExpr(mctx, fctx, nthArgTerm(args, 3), locals, false);
        let dstOff64 = emitAssign(fctx, "sext i32 " + dstOff32 + " to i64");
        let len64 = emitAssign(fctx, "sext i32 " + len32 + " to i64");
        let dstP = emitGep(fctx, "i8", dst, dstOff64);
        emitLlvmMemcpy(fctx, dstP, src, len64);
        Some("0")
    } else if (name == "ptrSliceFromStr") {
        let s = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let start32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let len32 = genExpr(mctx, fctx, nthArgTerm(args, 2), locals, false);
        let start64 = emitAssign(fctx, "sext i32 " + start32 + " to i64");
        let len64 = emitAssign(fctx, "sext i32 " + len32 + " to i64");
        let alloc64 = emitAssign(fctx, "add i64 " + len64 + ", 1");
        let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + alloc64 + ")");
        let srcP = emitGep(fctx, "i8", s, start64);
        emitLlvmMemcpy(fctx, dst, srcP, len64);
        let termPtr = emitGep(fctx, "i8", dst, len64);
        emitStore(fctx, "i8", "0", termPtr);
        Some(dst)
    } else if (name == "ptrSliceToString") {
        let p = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let len32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let len64 = emitAssign(fctx, "sext i32 " + len32 + " to i64");
        let alloc64 = emitAssign(fctx, "add i64 " + len64 + ", 1");
        let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + alloc64 + ")");
        emitLlvmMemcpy(fctx, dst, p, len64);
        let termPtr = emitGep(fctx, "i8", dst, len64);
        emitStore(fctx, "i8", "0", termPtr);
        Some(dst)
    } else if (name == "ptrToString") {
        let p = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let len64 = emitAssign(fctx, "call i64 " + strlenSym(mctx) + "(ptr " + p + ")");
        let alloc64 = emitAssign(fctx, "add i64 " + len64 + ", 1");
        let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + alloc64 + ")");
        emitLlvmMemcpy(fctx, dst, p, len64);
        let termPtr = emitGep(fctx, "i8", dst, len64);
        emitStore(fctx, "i8", "0", termPtr);
        Some(dst)
    } else if (name == "strLen") {
        let s = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let len64 = emitAssign(fctx, "call i64 " + strlenSym(mctx) + "(ptr " + s + ")");
        Some(emitAssign(fctx, "trunc i64 " + len64 + " to i32"))
    } else if (name == "strByteAt") {
        let s = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let idx32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let oob = emitAssign(fctx, "icmp slt i32 " + idx32 + ", 0");

        let oobBlk = appendBlock(fctx, "str.oob_trap");
        let okBlk = appendBlock(fctx, "str.ok");
        emitCondBr(fctx, oob, oobBlk, okBlk);

        setInsertBlock(fctx, oobBlk);
        emitLine(fctx, "call void @gs_bounds_fail(i32 " + idx32 + ", i32 0)");
        emitTermLine(fctx, "unreachable");

        setInsertBlock(fctx, okBlk);
        let idx64 = emitAssign(fctx, "sext i32 " + idx32 + " to i64");
        let bp = emitGep(fctx, "i8", s, idx64);
        let b8 = emitLoad(fctx, "i8", bp);
        Some(emitAssign(fctx, "zext i8 " + b8 + " to i32"))
    } else if (name == "strSlice") {
        let s = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let start32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let end32 = genExpr(mctx, fctx, nthArgTerm(args, 2), locals, false);
        let len64 = emitAssign(fctx, "call i64 " + strlenSym(mctx) + "(ptr " + s + ")");
        let len32 = emitAssign(fctx, "trunc i64 " + len64 + " to i32");
        let bad1 = emitAssign(fctx, "icmp slt i32 " + start32 + ", 0");
        let bad2 = emitAssign(fctx, "icmp slt i32 " + end32 + ", " + start32);
        let bad3 = emitAssign(fctx, "icmp sgt i32 " + end32 + ", " + len32);
        let bad12 = emitAssign(fctx, "or i1 " + bad1 + ", " + bad2);
        let bad = emitAssign(fctx, "or i1 " + bad12 + ", " + bad3);

        let oobBlk = appendBlock(fctx, "sl.oob");
        let okBlk = appendBlock(fctx, "sl.ok");
        emitCondBr(fctx, bad, oobBlk, okBlk);

        setInsertBlock(fctx, oobBlk);
        emitLine(fctx, "call void @gs_bounds_fail(i32 " + end32 + ", i32 " + len32 + ")");
        emitTermLine(fctx, "unreachable");

        setInsertBlock(fctx, okBlk);
        let start64 = emitAssign(fctx, "sext i32 " + start32 + " to i64");
        let end64 = emitAssign(fctx, "sext i32 " + end32 + " to i64");
        let subLen = emitAssign(fctx, "sub i64 " + end64 + ", " + start64);
        let allocSz = emitAssign(fctx, "add i64 " + subLen + ", 1");
        let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + allocSz + ")");
        let srcPtr = emitGep(fctx, "i8", s, start64);
        emitLlvmMemcpy(fctx, dst, srcPtr, subLen);
        let termPtr = emitGep(fctx, "i8", dst, subLen);
        emitStore(fctx, "i8", "0", termPtr);
        Some(dst)
    } else if (name == "strConcat") {
        let a = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let b = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let sl = strlenSym(mctx);
        let la = emitAssign(fctx, "call i64 " + sl + "(ptr " + a + ")");
        let lb = emitAssign(fctx, "call i64 " + sl + "(ptr " + b + ")");
        let lab = emitAssign(fctx, "add i64 " + la + ", " + lb);
        let allocSz = emitAssign(fctx, "add i64 " + lab + ", 1");
        let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + allocSz + ")");
        emitLlvmMemcpy(fctx, dst, a, la);
        let dstB = emitGep(fctx, "i8", dst, la);
        emitLlvmMemcpy(fctx, dstB, b, lb);
        let termPtr = emitGep(fctx, "i8", dst, lab);
        emitStore(fctx, "i8", "0", termPtr);
        Some(dst)
    } else if (name == "strFromBytes") {
        let arrPtr = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let count32 = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let cap64 = emitLoad(fctx, "i64", arrPtr);
        let cap32 = emitAssign(fctx, "trunc i64 " + cap64 + " to i32");
        let neg = emitAssign(fctx, "icmp slt i32 " + count32 + ", 0");
        let gt = emitAssign(fctx, "icmp sgt i32 " + count32 + ", " + cap32);
        let bad = emitAssign(fctx, "or i1 " + neg + ", " + gt);

        let oobBlk = appendBlock(fctx, "sfb.oob");
        let allocBlk = appendBlock(fctx, "sfb.alloc");
        let condBlk = appendBlock(fctx, "sfb.cond");
        let bodyBlk = appendBlock(fctx, "sfb.body");
        let doneBlk = appendBlock(fctx, "sfb.done");
        emitCondBr(fctx, bad, oobBlk, allocBlk);

        setInsertBlock(fctx, oobBlk);
        emitLine(fctx, "call void @gs_bounds_fail(i32 " + count32 + ", i32 " + cap32 + ")");
        emitTermLine(fctx, "unreachable");

        setInsertBlock(fctx, allocBlk);
        let count64 = emitAssign(fctx, "sext i32 " + count32 + " to i64");
        let allocSz = emitAssign(fctx, "add i64 " + count64 + ", 1");
        let dst = emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 " + allocSz + ")");
        let elemsBase = emitGep(fctx, "i8", arrPtr, "8");
        let idxSlot = emitEntryAlloca(fctx, "i64");
        emitStore(fctx, "i64", "0", idxSlot);
        emitBr(fctx, condBlk);

        setInsertBlock(fctx, condBlk);
        let cur = emitLoad(fctx, "i64", idxSlot);
        let more = emitAssign(fctx, "icmp slt i64 " + cur + ", " + count64);
        emitCondBr(fctx, more, bodyBlk, doneBlk);

        setInsertBlock(fctx, bodyBlk);
        let srcP = emitGep(fctx, "i32", elemsBase, cur);
        let v32 = emitLoad(fctx, "i32", srcP);
        let v8 = emitAssign(fctx, "trunc i32 " + v32 + " to i8");
        let dstP = emitGep(fctx, "i8", dst, cur);
        emitStore(fctx, "i8", v8, dstP);
        let next = emitAssign(fctx, "add i64 " + cur + ", 1");
        emitStore(fctx, "i64", next, idxSlot);
        emitBr(fctx, condBlk);

        setInsertBlock(fctx, doneBlk);
        let termP = emitGep(fctx, "i8", dst, count64);
        emitStore(fctx, "i8", "0", termP);
        Some(dst)
    } else if (name == "sysArgc") {
        Some(emitLoad(fctx, "i32", "@__gs_argc"))
    } else if (name == "sysArgv") {
        let idx32 = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let argc = emitLoad(fctx, "i32", "@__gs_argc");
        let oob = emitAssign(fctx, "icmp uge i32 " + idx32 + ", " + argc);

        let oobBlk = appendBlock(fctx, "cli.oob_trap");
        let okBlk = appendBlock(fctx, "cli.ok");
        emitCondBr(fctx, oob, oobBlk, okBlk);

        setInsertBlock(fctx, oobBlk);
        emitLine(fctx, "call void @gs_bounds_fail(i32 " + idx32 + ", i32 " + argc + ")");
        emitTermLine(fctx, "unreachable");

        setInsertBlock(fctx, okBlk);
        let argv = emitLoad(fctx, "ptr", "@__gs_argv");
        let idx64 = emitAssign(fctx, "sext i32 " + idx32 + " to i64");
        let elemP = emitGep(fctx, "ptr", argv, idx64);
        Some(emitLoad(fctx, "ptr", elemP))
    } else {
        tryEmitConcIntrinsic(mctx, fctx, name, args, retTy, locals)
    }
}

def tryEmitConcIntrinsic(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    name: String,
    args: List TaggedTerm,
    retTy: Type,
    locals: List (String, VarSlot)
): Option String = {
    if (name == "__concAtomicNew") {
        let init = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        Some(emitAssign(fctx, "call ptr @gs_atomic_new(i32 " + init + ")"))
    } else if (name == "__concAtomicLoad") {
        let a = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        Some(emitAssign(fctx, "call i32 @gs_atomic_load(ptr " + a + ")"))
    } else if (name == "__concAtomicStore") {
        let a = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let v = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        emitLine(fctx, "call void @gs_atomic_store(ptr " + a + ", i32 " + v + ")");
        Some("0")
    } else if (name == "__concAtomicAdd") {
        let a = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let d = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        Some(emitAssign(fctx, "call i32 @gs_atomic_add(ptr " + a + ", i32 " + d + ")"))
    } else if (name == "__concAtomicCas") {
        let a = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let exp = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let des = genExpr(mctx, fctx, nthArgTerm(args, 2), locals, false);
        let r = emitAssign(fctx, "call i32 @gs_atomic_cas(ptr " + a + ", i32 " + exp + ", i32 " + des + ")");
        Some(emitAssign(fctx, "icmp ne i32 " + r + ", 0"))
    } else if (name == "__concMVarNew") {
        let a0 = nthArgTerm(args, 0);
        let valTy = schemeBody(a0.tscm);
        let val = genExpr(mctx, fctx, a0, locals, false);
        let boxed = if (isVoidGeishaType(valTy)) emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 8)") else boxGeishaValue(mctx, fctx, val, valTy);
        Some(emitAssign(fctx, "call ptr @gs_mvar_new(ptr " + boxed + ", i32 1)"))
    } else if (name == "__concMVarEmpty") {
        Some(emitAssign(fctx, "call ptr @gs_mvar_new(ptr null, i32 0)"))
    } else if (name == "__concMVarTake") {
        let m = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let bp = emitAssign(fctx, "call ptr @gs_mvar_take(ptr " + m + ")");
        Some(unboxGeishaValue(fctx, bp, retTy))
    } else if (name == "__concMVarPut") {
        let m = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let a1 = nthArgTerm(args, 1);
        let valTy = schemeBody(a1.tscm);
        let val = genExpr(mctx, fctx, a1, locals, false);
        let boxed = if (isVoidGeishaType(valTy)) emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 8)") else boxGeishaValue(mctx, fctx, val, valTy);
        emitLine(fctx, "call void @gs_mvar_put(ptr " + m + ", ptr " + boxed + ")");
        Some("0")
    } else if (name == "__concMVarRead") {
        let m = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let bp = emitAssign(fctx, "call ptr @gs_mvar_read(ptr " + m + ")");
        Some(unboxGeishaValue(fctx, bp, retTy))
    } else if (name == "__concMVarTryTake") {
        let m = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let bp = emitAssign(fctx, "call ptr @gs_mvar_try_take(ptr " + m + ")");
        Some(emitNullableBoxToPair(fctx, bp, retTy))
    } else if (name == "__concChanNew") {
        let cap = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        Some(emitAssign(fctx, "call ptr @gs_chan_new(i32 " + cap + ")"))
    } else if (name == "__concChanSend") {
        let ch = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let a1 = nthArgTerm(args, 1);
        let valTy = schemeBody(a1.tscm);
        let val = genExpr(mctx, fctx, a1, locals, false);
        let boxed = if (isVoidGeishaType(valTy)) emitAssign(fctx, "call ptr @gc_alloc_atomic_uninit(i64 8)") else boxGeishaValue(mctx, fctx, val, valTy);
        let r = emitAssign(fctx, "call i32 @gs_chan_send(ptr " + ch + ", ptr " + boxed + ")");
        Some(emitAssign(fctx, "icmp ne i32 " + r + ", 0"))
    } else if (name == "__concChanRecv") {
        let ch = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let bp = emitAssign(fctx, "call ptr @gs_chan_recv(ptr " + ch + ")");
        Some(emitNullableBoxToPair(fctx, bp, retTy))
    } else if (name == "__concChanTryRecv") {
        let ch = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let bp = emitAssign(fctx, "call ptr @gs_chan_try_recv(ptr " + ch + ")");
        Some(emitNullableBoxToPair(fctx, bp, retTy))
    } else if (name == "__concChanClose") {
        let ch = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        emitLine(fctx, "call void @gs_chan_close(ptr " + ch + ")");
        Some("0")
    } else if (name == "__concChanIsClosed") {
        let ch = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let r = emitAssign(fctx, "call i32 @gs_chan_is_closed(ptr " + ch + ")");
        Some(emitAssign(fctx, "icmp ne i32 " + r + ", 0"))
    } else if (name == "__concTaskSpawn") {
        let innerTy = match retTy {
            TyComp(_, elem) -> elem,
            _ -> TyVoid,
        };
        let clsPtr = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let runner = getOrEmitThunkRunner(mctx, innerTy);
        Some(emitAssign(fctx, "call ptr @gs_task_spawn(ptr " + runner + ", ptr " + clsPtr + ")"))
    } else if (name == "__concTaskAwait") {
        let t = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let bp = emitAssign(fctx, "call ptr @gs_task_await(ptr " + t + ")");
        Some(unboxGeishaValue(fctx, bp, retTy))
    } else if (name == "__concTaskIsReady") {
        let t = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let r = emitAssign(fctx, "call i32 @gs_task_is_ready(ptr " + t + ")");
        Some(emitAssign(fctx, "icmp ne i32 " + r + ", 0"))
    } else if (name == "__concTaskWaitAny") {
        let arr = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let cnt = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let tmo = genExpr(mctx, fctx, nthArgTerm(args, 2), locals, false);
        emitLine(fctx, "call void @gs_task_wait_any(ptr " + arr + ", i32 " + cnt + ", i32 " + tmo + ")");
        Some("0")
    } else if (name == "__concNumCpu") {
        Some(emitAssign(fctx, "call i32 @gs_conc_num_cpu()"))
    } else if (name == "__concSleepMs") {
        let ms = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        emitLine(fctx, "call void @gs_conc_sleep_ms(i32 " + ms + ")");
        Some("0")
    } else if (name == "__concActorSpawn") {
        let stateTy = match retTy {
            TyComp(_, st) -> st,
            _ -> TyVoid,
        };
        let initCls = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        let runner = getOrEmitThunkRunner(mctx, stateTy);
        Some(emitAssign(fctx, "call ptr @gs_actor_spawn(ptr " + runner + ", ptr " + initCls + ")"))
    } else if (name == "__concActorCall") {
        let a0 = nthArgTerm(args, 0);
        let stateTy = match schemeBody(a0.tscm) {
            TyComp(_, st) -> st,
            _ -> TyVoid,
        };
        let respTy = match retTy {
            TyComp(_, r) -> r,
            _ -> TyVoid,
        };
        let actorH = genExpr(mctx, fctx, a0, locals, false);
        let handlerCls = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let runner = getOrEmitActorRunner(mctx, stateTy, respTy);
        Some(emitAssign(fctx, "call ptr @gs_actor_call(ptr " + actorH + ", ptr " + runner + ", ptr " + handlerCls + ")"))
    } else if (name == "__concActorSend") {
        let a0 = nthArgTerm(args, 0);
        let stateTy = match schemeBody(a0.tscm) {
            TyComp(_, st) -> st,
            _ -> TyVoid,
        };
        let actorH = genExpr(mctx, fctx, a0, locals, false);
        let handlerCls = genExpr(mctx, fctx, nthArgTerm(args, 1), locals, false);
        let runner = getOrEmitActorRunner(mctx, stateTy, TyVoid);
        emitLine(fctx, "call void @gs_actor_send(ptr " + actorH + ", ptr " + runner + ", ptr " + handlerCls + ")");
        Some("0")
    } else if (name == "__concActorStop") {
        let actorH = genExpr(mctx, fctx, nthArgTerm(args, 0), locals, false);
        emitLine(fctx, "call void @gs_actor_stop(ptr " + actorH + ")");
        Some("0")
    } else {
        None
    }
}

def extractAdtNameAndArgs(adtReg: StrMap AdtInfo, valTy: Type, ctorName: String): (String, List Type) = {
    let targs = extractTypeArgs(valTy);
    let curr = cellNew(valTy);
    while (match cellGet(curr) { TyComp(_, _) -> true, _ -> false }) {
        match cellGet(curr) {
            TyComp(b, _) -> cellSet(curr, b),
            _ -> (),
        }
    };
    match cellGet(curr) {
        TyCon(name) -> (name, targs),
        _ -> (ctorName, Nil),
    }
}

def emitPatternCheck(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    val: String,
    valTy: Type,
    pat: Pattern,
    localsCell: Cell (List (String, VarSlot)),
    failBlk: Int
): Void = match pat {
    PatWild -> (),
    PatVar(vname) -> {
        let llvmTy = getValLlvmType(valTy);
        let slotPtr = emitEntryAlloca(fctx, llvmTy);
        dbgEmitLocalVar(mctx, fctx, vname, valTy, slotPtr, cellGet(fctx.fcCurSpan), 0);
        emitStore(fctx, llvmTy, val, slotPtr);
        let slot = MkVarSlot { vsPtr: slotPtr, vsLlvmTy: llvmTy, vsGeishaTy: valTy };
        cellSet(localsCell, Cons((vname, slot), cellGet(localsCell)))
    },
    PatLit(lit) -> match lit {
        LitUnit -> (),
        _ -> {
            let litVal = genLit(mctx, lit);
            let cmp = match lit {
                LitInt(_) -> emitAssign(fctx, "icmp eq i32 " + val + ", " + litVal),
                LitBool(_) -> emitAssign(fctx, "icmp eq i1 " + val + ", " + litVal),
                LitChar(_) -> emitAssign(fctx, "icmp eq i8 " + val + ", " + litVal),
                LitFloat(_) -> emitAssign(fctx, "fcmp oeq double " + val + ", " + litVal),
                LitStr(_) -> {
                    let diff = emitAssign(fctx, "call i32 @gs_str_cmp(ptr " + val + ", ptr " + litVal + ")");
                    emitAssign(fctx, "icmp eq i32 " + diff + ", 0")
                },
                LitUnit -> "true",
            };
            let okBlk = appendBlock(fctx, "pat.lit.ok");
            emitCondBr(fctx, cmp, okBlk, failBlk);
            setInsertBlock(fctx, okBlk)
        },
    },
    PatTuple(subPats) -> {
        let tupleLlvm = getValLlvmType(valTy);
        let elemTys = match valTy {
            TyTuple(es) -> es,
            _ -> Nil,
        };
        let idx = cellNew(0);
        let cp = cellNew(subPats);
        let ct = cellNew(elemTys);
        while (match (cellGet(cp), cellGet(ct)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
            match (cellGet(cp), cellGet(ct)) {
                (Cons(sp, rp), Cons(et, rt)) -> {
                    let i = cellGet(idx);
                    let elemVal = emitAssign(fctx, "extractvalue " + tupleLlvm + " " + val + ", " + intToStr(i));
                    emitPatternCheck(mctx, fctx, elemVal, et, sp, localsCell, failBlk);
                    cellSet(idx, i + 1);
                    cellSet(cp, rp);
                    cellSet(ct, rt)
                },
                _ -> (),
            }
        }
    },
    PatCtor(ctorName, subPats) -> match unboxedAdtFields(valTy) {
        Some(concreteFieldTys) -> {
            let structLlvm = getValLlvmType(valTy);
            let idx = cellNew(0);
            let cp = cellNew(subPats);
            let cgt = cellNew(concreteFieldTys);
            while (match (cellGet(cp), cellGet(cgt)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                match (cellGet(cp), cellGet(cgt)) {
                    (Cons(sp, rp), Cons(gt, rgt)) -> {
                        let i = cellGet(idx);
                        match sp {
                            PatWild -> (),
                            _ -> {
                                let fVal = emitAssign(fctx, "extractvalue " + structLlvm + " " + val + ", " + intToStr(i));
                                emitPatternCheck(mctx, fctx, fVal, gt, sp, localsCell, failBlk)
                            },
                        };
                        cellSet(idx, i + 1);
                        cellSet(cp, rp);
                        cellSet(cgt, rgt)
                    },
                    _ -> (),
                }
            }
        },
        None -> {
            let (adtName, typeArgs) = extractAdtNameAndArgs(mctx.mcAdtReg, valTy, ctorName);
            match strMapGet(mctx.mcAdtReg, adtName) {
                None -> (),
                Some(ainfo) -> match findVariantByName(ainfo.variants, ctorName) {
                    None -> (),
                    Some(vinfo) -> {
                        let (adtStorageTy, _) = getAdtStorageTypeAndSize(mctx.mcAdtReg, adtName, typeArgs, mctx.mcPtrSize);
                        let tagPtr = emitStructFieldPtr(fctx, adtStorageTy, val, 0);
                        let actualTag = emitLoad(fctx, "i32", tagPtr);
                        let tagEq = emitAssign(fctx, "icmp eq i32 " + actualTag + ", " + intToStr(vinfo.tag));
                        let tagOkBlk = appendBlock(fctx, "pat.ctor.ok");
                        emitCondBr(fctx, tagEq, tagOkBlk, failBlk);
                        setInsertBlock(fctx, tagOkBlk);

                        match subPats {
                            Nil -> (),
                            _ -> {
                                let sub = buildPairMap(ainfo.typeParams, typeArgs);
                                let concreteFieldTys = substTypeList(vinfo.fieldTypes, sub);
                                let fieldLlvmTys = mapValLlvmTypes(concreteFieldTys);
                                let payloadStructTy = formatLlvmStructType(fieldLlvmTys);
                                let payloadPtr = emitStructFieldPtr(fctx, adtStorageTy, val, 1);

                                let idx = cellNew(0);
                                let cp = cellNew(subPats);
                                let cgt = cellNew(concreteFieldTys);
                                let clt = cellNew(fieldLlvmTys);
                                while (match (cellGet(cp), cellGet(cgt), cellGet(clt)) { (Cons(_, _), Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                                    match (cellGet(cp), cellGet(cgt), cellGet(clt)) {
                                        (Cons(sp, rp), Cons(gt, rgt), Cons(lt, rlt)) -> {
                                            let i = cellGet(idx);
                                            match sp {
                                                PatWild -> (),
                                                _ -> {
                                                    let fPtr = emitStructFieldPtr(fctx, payloadStructTy, payloadPtr, i);
                                                    let fVal = emitLoad(fctx, lt, fPtr);
                                                    emitPatternCheck(mctx, fctx, fVal, gt, sp, localsCell, failBlk)
                                                },
                                            };
                                            cellSet(idx, i + 1);
                                            cellSet(cp, rp);
                                            cellSet(cgt, rgt);
                                            cellSet(clt, rlt)
                                        },
                                        _ -> (),
                                    }
                                }
                            },
                        }
                    },
                },
            }
        },
    },
    PatStruct(_, _) -> (),
}

def isInfalliblePat(pat: Pattern): Bool = match pat {
    PatWild -> true,
    PatVar(_) -> true,
    PatTuple(ps) -> isInfalliblePatList(ps),
    _ -> false,
}

def isInfalliblePatList(ps: List Pattern): Bool = match ps {
    Nil -> true,
    Cons(h, t) -> isInfalliblePat(h) && isInfalliblePatList(t),
}

def canEmitAdtSwitch(mctx: ModEmitCtx, scrutTy: Type, arms: List CoreArm): Bool = {
    let (adtName, _) = extractAdtNameAndArgs(mctx.mcAdtReg, scrutTy, "");
    match strMapGet(mctx.mcAdtReg, adtName) {
        None -> false,
        Some(ainfo) -> {
            let seenTags: StrMap Bool = strMapNew();
            let ctorCount = cellNew(0);
            let ok = cellNew(true);
            let sawDefault = cellNew(false);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> cellGet(ok) }) {
                match cellGet(cur) {
                    Cons(arm, rest) -> {
                        if (cellGet(sawDefault)) {
                            cellSet(ok, false)
                        } else match arm.caGuard {
                            Some(_) -> cellSet(ok, false),
                            None -> match arm.caPat {
                                PatCtor(cname, subPats) -> match findVariantByName(ainfo.variants, cname) {
                                    None -> cellSet(ok, false),
                                    Some(vinfo) -> {
                                        let tk = intToStr(vinfo.tag);
                                        if (strMapContains(seenTags, tk) || !isInfalliblePatList(subPats)) {
                                            cellSet(ok, false)
                                        } else {
                                            strMapInsert(seenTags, tk, true);
                                            cellSet(ctorCount, cellGet(ctorCount) + 1)
                                        }
                                    },
                                },
                                PatWild -> cellSet(sawDefault, true),
                                PatVar(_) -> cellSet(sawDefault, true),
                                _ -> cellSet(ok, false),
                            },
                        };
                        cellSet(cur, rest)
                    },
                    Nil -> (),
                }
            };
            cellGet(ok) && cellGet(ctorCount) >= 2
        },
    }
}

def bindCtorSubPats(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    scrutVal: String,
    adtStorageTy: String,
    ainfo: AdtInfo,
    typeArgs: List Type,
    vinfo: VariantInfo,
    subPats: List Pattern,
    localsCell: Cell (List (String, VarSlot)),
    failBlk: Int
): Void = match subPats {
    Nil -> (),
    _ -> {
        let sub = buildPairMap(ainfo.typeParams, typeArgs);
        let concreteFieldTys = substTypeList(vinfo.fieldTypes, sub);
        let fieldLlvmTys = mapValLlvmTypes(concreteFieldTys);
        let payloadStructTy = formatLlvmStructType(fieldLlvmTys);
        let payloadPtr = emitStructFieldPtr(fctx, adtStorageTy, scrutVal, 1);

        let idx = cellNew(0);
        let cp = cellNew(subPats);
        let cgt = cellNew(concreteFieldTys);
        let clt = cellNew(fieldLlvmTys);
        while (match (cellGet(cp), cellGet(cgt), cellGet(clt)) { (Cons(_, _), Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
            match (cellGet(cp), cellGet(cgt), cellGet(clt)) {
                (Cons(sp, rp), Cons(gt, rgt), Cons(lt, rlt)) -> {
                    let i = cellGet(idx);
                    match sp {
                        PatWild -> (),
                        _ -> {
                            let fPtr = emitStructFieldPtr(fctx, payloadStructTy, payloadPtr, i);
                            let fVal = emitLoad(fctx, lt, fPtr);
                            emitPatternCheck(mctx, fctx, fVal, gt, sp, localsCell, failBlk)
                        },
                    };
                    cellSet(idx, i + 1);
                    cellSet(cp, rp);
                    cellSet(cgt, rgt);
                    cellSet(clt, rlt)
                },
                _ -> (),
            }
        }
    },
}

def emitAdtSwitchMatch(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    scrutVal: String,
    scrutTy: Type,
    resTy: Type,
    arms: List CoreArm,
    locals: List (String, VarSlot),
    inTail: Bool
): String = {
    let (adtName, typeArgs) = extractAdtNameAndArgs(mctx.mcAdtReg, scrutTy, "");
    match strMapGet(mctx.mcAdtReg, adtName) {
        None -> llvmZeroValue(getValLlvmType(resTy)),
        Some(ainfo) -> {
            let (adtStorageTy, _) = getAdtStorageTypeAndSize(mctx.mcAdtReg, adtName, typeArgs, mctx.mcPtrSize);
            let tagPtr = emitStructFieldPtr(fctx, adtStorageTy, scrutVal, 0);
            let tagVal = emitLoad(fctx, "i32", tagPtr);

            let contBlk = appendBlock(fctx, "sw.cont");
            let armBlks: Vec Int = vecNew();
            let defaultBlkCell = cellNew(-1);
            let swCases = bufNew();

            let ca0 = cellNew(arms);
            while (match cellGet(ca0) { Nil -> false, _ -> true }) {
                match cellGet(ca0) {
                    Cons(arm, r) -> {
                        let ablk = appendBlock(fctx, "sw.arm");
                        vecPush(armBlks, ablk);
                        match arm.caPat {
                            PatCtor(cname, _) -> match findVariantByName(ainfo.variants, cname) {
                                Some(vinfo) -> {
                                    bufPushStr(swCases, " i32 ");
                                    bufPushStr(swCases, intToStr(vinfo.tag));
                                    bufPushStr(swCases, ", label %");
                                    bufPushStr(swCases, blockLabel(fctx, ablk))
                                },
                                None -> (),
                            },
                            _ -> cellSet(defaultBlkCell, ablk),
                        };
                        cellSet(ca0, r)
                    },
                    Nil -> (),
                }
            };

            let hasDefault = cellGet(defaultBlkCell) >= 0;
            let failBlk = if (hasDefault) cellGet(defaultBlkCell) else appendBlock(fctx, "sw.fail");
            let defaultLbl = blockLabel(fctx, failBlk);
            emitTermLine(fctx, "switch i32 " + tagVal + ", label %" + defaultLbl + " [" + bufToString(swCases) + " ]");

            let incomingRev: Cell (List (String, String)) = cellNew(Nil);
            let idx = cellNew(0);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        let i = cellGet(idx);
                        setInsertBlock(fctx, vecGetOr(armBlks, i, failBlk));
                        let armLocals = cellNew(locals);
                        match arm.caPat {
                            PatCtor(cname, subPats) -> match findVariantByName(ainfo.variants, cname) {
                                Some(vinfo) -> bindCtorSubPats(mctx, fctx, scrutVal, adtStorageTy, ainfo, typeArgs, vinfo, subPats, armLocals, failBlk),
                                None -> (),
                            },
                            PatVar(vname) -> emitPatternCheck(mctx, fctx, scrutVal, scrutTy, PatVar(vname), armLocals, failBlk),
                            _ -> (),
                        };
                        let bodyVal = genExpr(mctx, fctx, arm.caBody, cellGet(armLocals), inTail);
                        let bodyEnd = getInsertBlock(fctx);
                        emitBr(fctx, contBlk);
                        cellSet(incomingRev, Cons((bodyVal, blockLabel(fctx, bodyEnd)), cellGet(incomingRev)));
                        cellSet(idx, i + 1);
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            };

            if (!hasDefault) {
                setInsertBlock(fctx, failBlk);
                emitLine(fctx, "call void @gs_match_fail()");
                emitTermLine(fctx, "unreachable")
            } else ();

            setInsertBlock(fctx, contBlk);
            let resLlvm = getValLlvmType(resTy);
            match listRev(cellGet(incomingRev)) {
                Nil -> {
                    emitTermLine(fctx, "unreachable");
                    llvmZeroValue(resLlvm)
                },
                incList -> emitAssign(fctx, "phi " + resLlvm + " " + formatPhiIncoming(incList)),
            }
        },
    }
}

def formatTypedArgs(argTys: List String, argVals: List String): String = {
    let pairsRev = cellNew(Nil);
    let ct = cellNew(argTys);
    let cv = cellNew(argVals);
    while (match (cellGet(ct), cellGet(cv)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
        match (cellGet(ct), cellGet(cv)) {
            (Cons(t, rt), Cons(v, rv)) -> {
                let normV = if (t == "ptr" && v == "0") "null" else v;
                cellSet(pairsRev, Cons(t + " " + normV, cellGet(pairsRev)));
                cellSet(ct, rt);
                cellSet(cv, rv)
            },
            _ -> (),
        }
    };
    strJoin(listRev(cellGet(pairsRev)), ", ")
}

def formatPhiIncoming(pairs: List (String, String)): String = {
    let partsRev = cellNew(Nil);
    let cur = cellNew(pairs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((v, blkLbl), r) -> {
                cellSet(partsRev, Cons("[ " + v + ", %" + blkLbl + " ]", cellGet(partsRev)));
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    strJoin(listRev(cellGet(partsRev)), ", ")
}

def genExpr(
    mctx: ModEmitCtx,
    fctx: FnEmitCtx,
    tm: TaggedTerm,
    locals: List (String, VarSlot),
    inTail: Bool
): String = {
    // Consume `fcPendingLet` immediately so subexpressions never inherit outer `let` stack strategy!
    let directLetVar = cellGet(fctx.fcPendingLet);
    cellSet(fctx.fcPendingLet, None);

    let prevLoc = cellGet(fctx.fcCurLocId);
    let prevSpan = cellGet(fctx.fcCurSpan);
    if (fctx.fcDebug && tm.tspan.fileId != 0) {
        cellSet(fctx.fcCurLocId, dbgGetOrCreateLoc(mctx, fctx, tm.tspan));
        cellSet(fctx.fcCurSpan, tm.tspan)
    } else ();

    let exprRes = match tm.tnode {
        TmLit(lit) -> genLit(mctx, lit),

        TmVar(vn) -> match lookupVarSlot(locals, mctx.mcGlobalSlots, vn) {
            Some(slot) -> emitLoad(fctx, slot.vsLlvmTy, slot.vsPtr),
            None -> "0",
        },

        TmGlobalVar(vn) -> match strMapGet(mctx.mcGlobalSlots, vn) {
            Some(slot) -> emitLoad(fctx, slot.vsLlvmTy, slot.vsPtr),
            None -> "0",
        },

        TmTuple(elems) -> {
            let tupleLlvm = getValLlvmType(schemeBody(tm.tscm));
            let agg = cellNew("undef");
            let idx = cellNew(0);
            let cur = cellNew(elems);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(el, r) -> {
                        let i = cellGet(idx);
                        let v = genExpr(mctx, fctx, el, locals, false);
                        let elLlvm = getValLlvmType(schemeBody(el.tscm));
                        cellSet(agg, emitAssign(fctx, "insertvalue " + tupleLlvm + " " + cellGet(agg) + ", " + elLlvm + " " + v + ", " + intToStr(i)));
                        cellSet(idx, i + 1);
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(agg)
        },

        TmUn(op, operand) -> {
            let val = genExpr(mctx, fctx, operand, locals, false);
            let opTy = schemeBody(operand.tscm);
            match op {
                UnNot -> emitAssign(fctx, "xor i1 " + val + ", true"),
                UnNeg -> match opTy {
                    TyCon("Float") -> emitAssign(fctx, "fneg double " + val),
                    TyCon("Float32") -> emitAssign(fctx, "fneg float " + val),
                    _ -> {
                        let ity = getValLlvmType(opTy);
                        emitAssign(fctx, "sub " + ity + " 0, " + val)
                    },
                },
                UnBitNot -> {
                    let ity = getValLlvmType(opTy);
                    emitAssign(fctx, "xor " + ity + " " + val + ", -1")
                },
            }
        },

        TmBin(OpAnd, lhs, rhs) -> {
            let lval = genExpr(mctx, fctx, lhs, locals, false);
            let lhsEndBlk = getInsertBlock(fctx);
            let rhsBlk = appendBlock(fctx, "and.rhs");
            let mergeBlk = appendBlock(fctx, "and.end");
            emitCondBr(fctx, lval, rhsBlk, mergeBlk);

            setInsertBlock(fctx, rhsBlk);
            let rval = genExpr(mctx, fctx, rhs, locals, false);
            let rhsEndBlk = getInsertBlock(fctx);
            emitBr(fctx, mergeBlk);

            setInsertBlock(fctx, mergeBlk);
            emitAssign(fctx, "phi i1 [ false, %" + blockLabel(fctx, lhsEndBlk) + " ], [ " + rval + ", %" + blockLabel(fctx, rhsEndBlk) + " ]")
        },

        TmBin(OpOr, lhs, rhs) -> {
            let lval = genExpr(mctx, fctx, lhs, locals, false);
            let lhsEndBlk = getInsertBlock(fctx);
            let rhsBlk = appendBlock(fctx, "or.rhs");
            let mergeBlk = appendBlock(fctx, "or.end");
            emitCondBr(fctx, lval, mergeBlk, rhsBlk);

            setInsertBlock(fctx, rhsBlk);
            let rval = genExpr(mctx, fctx, rhs, locals, false);
            let rhsEndBlk = getInsertBlock(fctx);
            emitBr(fctx, mergeBlk);

            setInsertBlock(fctx, mergeBlk);
            emitAssign(fctx, "phi i1 [ true, %" + blockLabel(fctx, lhsEndBlk) + " ], [ " + rval + ", %" + blockLabel(fctx, rhsEndBlk) + " ]")
        },

        TmBin(op, lhs, rhs) -> {
            let lval = genExpr(mctx, fctx, lhs, locals, false);
            let rval = genExpr(mctx, fctx, rhs, locals, false);
            emitBinOperator(mctx, fctx, op, lval, rval, schemeBody(lhs.tscm))
        },

        TmLet(vd, val, exp) -> {
            cellSet(fctx.fcPendingLet, Some(vd.vname));
            let initVal = genExpr(mctx, fctx, val, locals, false);
            cellSet(fctx.fcPendingLet, None);

            let vGeishaTy = schemeBody(vd.vscm);
            let vLlvmTy = getValLlvmType(vGeishaTy);
            let slotPtr = emitEntryAlloca(fctx, vLlvmTy);
            dbgEmitLocalVar(mctx, fctx, vd.vname, vGeishaTy, slotPtr, tm.tspan, 0);
            emitStore(fctx, vLlvmTy, initVal, slotPtr);
            let slot = MkVarSlot { vsPtr: slotPtr, vsLlvmTy: vLlvmTy, vsGeishaTy: vGeishaTy };
            genExpr(mctx, fctx, exp, Cons((vd.vname, slot), locals), inTail)
        },

        TmApplyCls(callee, args) -> {
            let calleePtr = genExpr(mctx, fctx, callee, locals, false);
            let argValsRev = cellNew(Nil);
            let argTysRev = cellNew(Nil);
            let cur = cellNew(args);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        cellSet(argValsRev, Cons(genExpr(mctx, fctx, a, locals, false), cellGet(argValsRev)));
                        cellSet(argTysRev, Cons(getValLlvmType(schemeBody(a.tscm)), cellGet(argTysRev)));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let fvsPtr = emitClosureFvsPtr(mctx, fctx, calleePtr);
            let fnEntryPtr = emitClosureFnSlot(mctx, fctx, calleePtr);
            let fnEntry = emitLoad(fctx, "ptr", fnEntryPtr);

            let allTys = listRev(Cons("ptr", cellGet(argTysRev)));
            let allVals = listRev(Cons(fvsPtr, cellGet(argValsRev)));
            let typedArgsStr = formatTypedArgs(allTys, allVals);

            let retTy = match schemeBody(callee.tscm) {
                TyArr(_, _, r) -> r,
                _ -> schemeBody(tm.tscm),
            };
            let retLlvm = getFnRetLlvmType(retTy);
            let callPrefix = if (inTail) "tail call " else "call ";
            if (retLlvm == "void") {
                emitLine(fctx, callPrefix + "void " + fnEntry + "(" + typedArgsStr + ")");
                "0"
            } else {
                emitAssign(fctx, callPrefix + retLlvm + " " + fnEntry + "(" + typedArgsStr + ")")
            }
        },

        TmApplyDir(funDecl, args) -> {
            let calleeName = funDecl.vname;
            let retGeishaTy = schemeBody(tm.tscm);
            match tryEmitIntrinsic(mctx, fctx, calleeName, args, retGeishaTy, locals, directLetVar) {
                Some(intrinVal) -> intrinVal,
                None -> match strMapGet(mctx.mcExterns, calleeName) {
                    Some(extDef) -> {
                        let extParamTys0 = match extDef.extTy {
                            TyArr(_, ps, _) -> ps,
                            _ -> Nil,
                        };
                        let (calleeVal, callArgs, extParamTys) =
                            if (extDef.extIsFnPtr) {
                                match (args, extParamTys0) {
                                    (Cons(fpArg, restArgs), Cons(_, restPtys)) -> {
                                        let fpReg = genExpr(mctx, fctx, fpArg, locals, false);
                                        (fpReg, restArgs, restPtys)
                                    },
                                    _ -> ("null", Nil, Nil),
                                }
                            } else {
                                (llvmSym(extDef.extLink), args, extParamTys0)
                            };

                        let extRetTy = match extDef.extTy {
                            TyArr(_, _, r) -> r,
                            _ -> retGeishaTy,
                        };
                        let retMode = classifyCAbiRet(mctx.mcTargetArch, mctx.mcPtrSize, extRetTy);
                        let callArgPartsRev = cellNew(Nil);
                        let fnSigPartsRev = cellNew(Nil);
                        let keepAliveFpsRev = cellNew(Nil);
                        let sretBufOpt = match retMode {
                            CAbiRetSret(sTy, aln) -> {
                                let sb = emitEntryAlloca(fctx, sTy);
                                cellSet(callArgPartsRev, Cons("ptr sret(" + sTy + ") align " + intToStr(aln) + " " + sb, cellGet(callArgPartsRev)));
                                cellSet(fnSigPartsRev, Cons("ptr", cellGet(fnSigPartsRev)));
                                Some((sb, sTy, aln))
                            },
                            _ -> None,
                        };

                        let cur = cellNew(callArgs);
                        let curP = cellNew(extParamTys);
                        while (match cellGet(cur) { Nil -> false, _ -> true }) {
                            match cellGet(cur) {
                                Cons(a, r) -> {
                                    let actualTy = schemeBody(a.tscm);
                                    let expectedTy = match cellGet(curP) {
                                        Cons(pt, rp) -> { cellSet(curP, rp); pt },
                                        Nil -> actualTy,
                                    };
                                    let rawVal = genExpr(mctx, fctx, a, locals, false);
                                    let passVal = match (expectedTy, actualTy) {
                                        (TyCon("ScopedPtr"), TyCon("ForeignPtr")) -> {
                                            cellSet(keepAliveFpsRev, Cons(rawVal, cellGet(keepAliveFpsRev)));
                                            emitAssign(fctx, "call ptr @gc_foreign_ptr_get(ptr " + rawVal + ")")
                                        },
                                        _ -> rawVal,
                                    };
                                    match classifyCAbiParam(mctx.mcTargetArch, mctx.mcPtrSize, expectedTy) {
                                        CAbiDirect(cTy) -> {
                                            let cVal =
                                                if (isCStructType(expectedTy)) emitMarshalStructToDirect(fctx, expectedTy, passVal, cTy)
                                                else passVal;
                                            cellSet(callArgPartsRev, Cons(cTy + " " + cVal, cellGet(callArgPartsRev)));
                                            cellSet(fnSigPartsRev, Cons(cTy, cellGet(fnSigPartsRev)))
                                        },
                                        CAbiPair(t0, t1) -> {
                                            let (v0, v1) = emitMarshalStructToPair(fctx, expectedTy, passVal, t0, t1);
                                            cellSet(callArgPartsRev, Cons(t0 + " " + v0, cellGet(callArgPartsRev)));
                                            cellSet(callArgPartsRev, Cons(t1 + " " + v1, cellGet(callArgPartsRev)));
                                            cellSet(fnSigPartsRev, Cons(t0, cellGet(fnSigPartsRev)));
                                            cellSet(fnSigPartsRev, Cons(t1, cellGet(fnSigPartsRev)))
                                        },
                                        CAbiIndirectPtr(sTy, aln, useByval) -> {
                                            let tmp = emitEntryAlloca(fctx, sTy);
                                            emitLine(fctx, "store " + sTy + " " + passVal + ", ptr " + tmp + ", align " + intToStr(aln));
                                            if (useByval) {
                                                let declP = "ptr byval(" + sTy + ") align " + intToStr(aln);
                                                cellSet(callArgPartsRev, Cons(declP + " " + tmp, cellGet(callArgPartsRev)));
                                                cellSet(fnSigPartsRev, Cons("ptr", cellGet(fnSigPartsRev)))
                                            } else {
                                                cellSet(callArgPartsRev, Cons("ptr " + tmp, cellGet(callArgPartsRev)));
                                                cellSet(fnSigPartsRev, Cons("ptr", cellGet(fnSigPartsRev)))
                                            }
                                        },
                                    };
                                    cellSet(cur, r)
                                },
                                Nil -> (),
                            }
                        };
                        let typedArgsStr = strJoin(listRev(cellGet(callArgPartsRev)), ", ");
                        let sigParamsStr = strJoin(listRev(cellGet(fnSigPartsRev)), ", ");
                        let useBlocking = !mctx.mcIsWasm && !extDef.extNoAlloc;
                        if (useBlocking) {
                            let jbPtr = emitEntryAlloca(fctx, "[64 x i64]");
                            emitLine(fctx, "call i32 @_setjmp(ptr " + jbPtr + ")");
                            emitLine(fctx, "call void @gc_enter_blocking(ptr " + jbPtr + ")")
                        } else ();

                        let callRetLlvm = match retMode {
                            CAbiRetVoid -> "void",
                            CAbiRetDirect(rt) -> rt,
                            CAbiRetSret(_, _) -> "void",
                        };
                        let needExplicitSig = extDef.extIsFnPtr || strMapContains(mctx.mcMultiExternLinks, extDef.extLink);
                        let callHead =
                            if (needExplicitSig) "call " + callRetLlvm + " (" + sigParamsStr + ") " + calleeVal + "(" + typedArgsStr + ")"
                            else "call " + callRetLlvm + " " + calleeVal + "(" + typedArgsStr + ")";
                        let rawCRes =
                            if (callRetLlvm == "void") {
                                emitLine(fctx, callHead);
                                "0"
                            } else {
                                emitAssign(fctx, callHead)
                            };
                        if (useBlocking) emitLine(fctx, "call void @gc_leave_blocking()") else ();
                        if (!mctx.mcIsWasm) {
                            let ck = cellNew(listRev(cellGet(keepAliveFpsRev)));
                            while (match cellGet(ck) { Nil -> false, _ -> true }) {
                                match cellGet(ck) {
                                    Cons(fpReg, rk) -> {
                                        emitLine(fctx, "call void asm sideeffect \"\", \"r,~{memory}\"(ptr " + fpReg + ")");
                                        cellSet(ck, rk)
                                    },
                                    Nil -> (),
                                }
                            }
                        } else ();
                        match retMode {
                            CAbiRetVoid -> "0",
                            CAbiRetDirect(cRetTy) ->
                                if (isCStructType(extRetTy)) emitUnmarshalDirectToStruct(fctx, extRetTy, rawCRes, cRetTy)
                                else rawCRes,
                            CAbiRetSret(_, _) -> match sretBufOpt {
                                Some((sb, sTy, aln)) -> emitAssign(fctx, "load " + sTy + ", ptr " + sb + ", align " + intToStr(aln)),
                                None -> "0",
                            },
                        }
                    },
                    None -> {
                        let argValsRev = cellNew(Nil);
                        let argTysRev = cellNew(Nil);
                        let cur = cellNew(args);
                        while (match cellGet(cur) { Nil -> false, _ -> true }) {
                            match cellGet(cur) {
                                Cons(a, r) -> {
                                    cellSet(argValsRev, Cons(genExpr(mctx, fctx, a, locals, false), cellGet(argValsRev)));
                                    cellSet(argTysRev, Cons(getValLlvmType(schemeBody(a.tscm)), cellGet(argTysRev)));
                                    cellSet(cur, r)
                                },
                                Nil -> (),
                            }
                        };
                        let allTys = listRev(Cons("ptr", cellGet(argTysRev)));
                        let allVals = listRev(Cons("null", cellGet(argValsRev)));
                        let typedArgsStr = formatTypedArgs(allTys, allVals);

                        let fnRetTy = match schemeBody(funDecl.vscm) {
                            TyArr(_, _, r) -> r,
                            _ -> retGeishaTy,
                        };
                        let retLlvm = getFnRetLlvmType(fnRetTy);
                        let isIoFn =
                            calleeName == "printLn" || calleeName == "putNumber"
                            || calleeName == "putFloat" || calleeName == "putF32" || calleeName == "putChar";
                        let callPrefix = if (inTail && !isIoFn) "tail call " else "call ";
                        let targetSym = geishaFnSym(mctx, calleeName);
                        if (retLlvm == "void") {
                            emitLine(fctx, callPrefix + "void " + targetSym + "(" + typedArgsStr + ")");
                            "0"
                        } else {
                            emitAssign(fctx, callPrefix + retLlvm + " " + targetSym + "(" + typedArgsStr + ")")
                        }
                    },
                },
            }
        },

        TmBlock(items) -> {
            let ret = cellNew("0");
            let cur = cellNew(items);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(it, r) -> {
                        let isLast = match r { Nil -> true, _ -> false };
                        cellSet(ret, genExpr(mctx, fctx, it, locals, inTail && isLast));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            cellGet(ret)
        },

        TmMakeCls(vd, cls, exp) -> {
            let clsSlotPtr = emitEntryAlloca(fctx, "ptr");
            let clsSlot = MkVarSlot { vsPtr: clsSlotPtr, vsLlvmTy: "ptr", vsGeishaTy: schemeBody(vd.vscm) };
            let extLocals = Cons((vd.vname, clsSlot), locals);

            match cls.clsFvs {
                Nil -> {
                    let staticCls = emitStaticClosureConst(mctx, cls.clsEntry);
                    emitStore(fctx, "ptr", staticCls, clsSlotPtr);
                    genExpr(mctx, fctx, exp, extLocals, inTail)
                },
                _ -> {
                    let stackAlloc = isStackAlloc(mctx.mcEscape, fctx.fcName, vd.vname);
                    let fvLlvmRev = cellNew(Nil);
                    let fvGeishaRev = cellNew(Nil);
                    let cf = cellNew(cls.clsFvs);
                    while (match cellGet(cf) { Nil -> false, _ -> true }) {
                        match cellGet(cf) {
                            Cons(fvName, r) -> {
                                match lookupVarSlot(extLocals, mctx.mcGlobalSlots, fvName) {
                                    Some(s) -> {
                                        cellSet(fvLlvmRev, Cons(s.vsLlvmTy, cellGet(fvLlvmRev)));
                                        cellSet(fvGeishaRev, Cons(s.vsGeishaTy, cellGet(fvGeishaRev)))
                                    },
                                    None -> (),
                                };
                                cellSet(cf, r)
                            },
                            Nil -> (),
                        }
                    };
                    let fvLlvmTys = listRev(cellGet(fvLlvmRev));
                    let fvGeishaTys = listRev(cellGet(fvGeishaRev));
                    let envStructTy = formatLlvmStructType(fvLlvmTys);
                    let clsStructTy =
                        if (mctx.mcIsWasm) "{ ptr, i32, " + envStructTy + " }"
                        else "{ ptr, " + envStructTy + " }";
                    let clsEnvFieldIdx = if (mctx.mcIsWasm) 2 else 1;
                    let (envSz, _) = structSizeAndAlignFor(fvGeishaTys, mctx.mcPtrSize);
                    let clsByteSz = alignUp(8 + envSz, 8);

                    let clsObjPtr =
                        if (stackAlloc) emitEntryAlloca(fctx, clsStructTy)
                        else emitGcAllocForFields(mctx, fctx, clsByteSz, fvGeishaTys, 8);

                    emitStore(fctx, "ptr", clsObjPtr, clsSlotPtr);
                    let fnFieldPtr = emitStructFieldPtr(fctx, clsStructTy, clsObjPtr, 0);
                    emitStore(fctx, "ptr", geishaFnSym(mctx, cls.clsEntry), fnFieldPtr);

                    let clsFvPtr = emitStructFieldPtr(fctx, clsStructTy, clsObjPtr, clsEnvFieldIdx);
                    let idx = cellNew(0);
                    let cf2 = cellNew(cls.clsFvs);
                    while (match cellGet(cf2) { Nil -> false, _ -> true }) {
                        match cellGet(cf2) {
                            Cons(fvName, r) -> {
                                let i = cellGet(idx);
                                match lookupVarSlot(extLocals, mctx.mcGlobalSlots, fvName) {
                                    Some(vs) -> {
                                        let fvVal = emitLoad(fctx, vs.vsLlvmTy, vs.vsPtr);
                                        let fvSlot = emitStructFieldPtr(fctx, envStructTy, clsFvPtr, i);
                                        emitStore(fctx, vs.vsLlvmTy, fvVal, fvSlot)
                                    },
                                    None -> (),
                                };
                                cellSet(idx, i + 1);
                                cellSet(cf2, r)
                            },
                            Nil -> (),
                        }
                    };
                    genExpr(mctx, fctx, exp, extLocals, inTail && !stackAlloc)
                },
            }
        },

        TmIf(c, t, e) -> {
            let condVal = genExpr(mctx, fctx, c, locals, false);
            let thenBlk = appendBlock(fctx, "if.then");
            let elseBlk = appendBlock(fctx, "if.else");
            let contBlk = appendBlock(fctx, "if.cont");
            emitCondBr(fctx, condVal, thenBlk, elseBlk);

            setInsertBlock(fctx, thenBlk);
            let thenVal = genExpr(mctx, fctx, t, locals, inTail);
            let thenEnd = getInsertBlock(fctx);
            emitBr(fctx, contBlk);

            setInsertBlock(fctx, elseBlk);
            let elseVal = genExpr(mctx, fctx, e, locals, inTail);
            let elseEnd = getInsertBlock(fctx);
            emitBr(fctx, contBlk);

            setInsertBlock(fctx, contBlk);
            let resLlvm = getValLlvmType(schemeBody(tm.tscm));
            emitAssign(
                fctx,
                "phi " + resLlvm + " [ " + thenVal + ", %" + blockLabel(fctx, thenEnd) + " ], [ " + elseVal + ", %" + blockLabel(fctx, elseEnd) + " ]"
            )
        },

        TmWhile(cond, body) -> {
            let condBlk = appendBlock(fctx, "while.cond");
            let bodyBlk = appendBlock(fctx, "while.body");
            let endBlk = appendBlock(fctx, "while.end");
            emitBr(fctx, condBlk);

            setInsertBlock(fctx, condBlk);
            if (termNeedsSafepoint(cond) || termNeedsSafepoint(body)) {
                emitGcSafepointPoll(mctx, fctx)
            } else ();
            let cval = genExpr(mctx, fctx, cond, locals, false);
            emitCondBr(fctx, cval, bodyBlk, endBlk);

            setInsertBlock(fctx, bodyBlk);
            let _ = genExpr(mctx, fctx, body, locals, false);
            if (!curBlockHasTerm(fctx)) emitBr(fctx, condBlk) else ();

            setInsertBlock(fctx, endBlk);
            "0"
        },

        TmMakeData(adtName, tag, fields, fieldTys, typeArgs) -> match fields {
            Nil -> emitNullaryAdtConst(mctx, tag),
            _ -> {
                let fvalsRev = cellNew(Nil);
                let cur = cellNew(fields);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(f, r) -> {
                            cellSet(fvalsRev, Cons(genExpr(mctx, fctx, f, locals, false), cellGet(fvalsRev)));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                let fieldVals = listRev(cellGet(fvalsRev));
                let resTy = schemeBody(tm.tscm);
                match unboxedAdtFields(resTy) {
                    Some(_) -> {
                        let structLlvm = getValLlvmType(resTy);
                        let fLlvmTys = mapValLlvmTypes(fieldTys);
                        let agg = cellNew("undef");
                        let idx = cellNew(0);
                        let cv = cellNew(fieldVals);
                        let ct = cellNew(fLlvmTys);
                        while (match (cellGet(cv), cellGet(ct)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                            match (cellGet(cv), cellGet(ct)) {
                                (Cons(fv, rv), Cons(flt, rt)) -> {
                                    let i = cellGet(idx);
                                    cellSet(agg, emitAssign(fctx, "insertvalue " + structLlvm + " " + cellGet(agg) + ", " + flt + " " + fv + ", " + intToStr(i)));
                                    cellSet(idx, i + 1);
                                    cellSet(cv, rv);
                                    cellSet(ct, rt)
                                },
                                _ -> (),
                            }
                        };
                        cellGet(agg)
                    },
                    None -> {
                        let (adtStorageTy, adtByteSz) = getAdtStorageTypeAndSize(mctx.mcAdtReg, adtName, typeArgs, mctx.mcPtrSize);
                        let useStack =
                            if (isRecursiveAdt(mctx.mcEscape, adtName)) false
                            else match directLetVar {
                                Some(bindName) -> isStackAlloc(mctx.mcEscape, fctx.fcName, bindName),
                                None -> false,
                            };
                        let adtPtr =
                            if (useStack) emitEntryAlloca(fctx, adtStorageTy)
                            else emitGcAllocForFields(mctx, fctx, adtByteSz, fieldTys, 8);

                        let tagPtr = emitStructFieldPtr(fctx, adtStorageTy, adtPtr, 0);
                        emitStore(fctx, "i32", intToStr(tag), tagPtr);

                        let payloadPtr = emitStructFieldPtr(fctx, adtStorageTy, adtPtr, 1);
                        let fLlvmTys = mapValLlvmTypes(fieldTys);
                        let payloadStructTy = formatLlvmStructType(fLlvmTys);
                        let idx = cellNew(0);
                        let cv = cellNew(fieldVals);
                        let ct = cellNew(fLlvmTys);
                        while (match (cellGet(cv), cellGet(ct)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                            match (cellGet(cv), cellGet(ct)) {
                                (Cons(fv, rv), Cons(flt, rt)) -> {
                                    let i = cellGet(idx);
                                    let fPtr = emitStructFieldPtr(fctx, payloadStructTy, payloadPtr, i);
                                    emitStore(fctx, flt, fv, fPtr);
                                    cellSet(idx, i + 1);
                                    cellSet(cv, rv);
                                    cellSet(ct, rt)
                                },
                                _ -> (),
                            }
                        };
                        adtPtr
                    },
                }
            },
        },

        TmGetTag(node) -> {
            let nodeTy = schemeBody(node.tscm);
            match unboxedAdtFields(nodeTy) {
                Some(_) -> {
                    let _ = genExpr(mctx, fctx, node, locals, false);
                    "0"
                },
                None -> {
                    let adtPtr = genExpr(mctx, fctx, node, locals, false);
                    let tagPtr = emitStructFieldPtr(fctx, "{ i32 }", adtPtr, 0);
                    emitLoad(fctx, "i32", tagPtr)
                },
            }
        },

        TmMatch(scrut, arms) -> {
            let scrutVal = genExpr(mctx, fctx, scrut, locals, false);
            let scrutTy = schemeBody(scrut.tscm);
            if (canEmitAdtSwitch(mctx, scrutTy, arms)) {
                emitAdtSwitchMatch(mctx, fctx, scrutVal, scrutTy, schemeBody(tm.tscm), arms, locals, inTail)
            } else {
            let contBlk = appendBlock(fctx, "match.cont");
            let failBlk = appendBlock(fctx, "match.fail");

            let testBlks: Vec Int = vecNew();
            let ca0 = cellNew(arms);
            while (match cellGet(ca0) { Nil -> false, _ -> true }) {
                match cellGet(ca0) {
                    Cons(_, r) -> {
                        vecPush(testBlks, appendBlock(fctx, "match.test"));
                        cellSet(ca0, r)
                    },
                    Nil -> (),
                }
            };

            let armCount = vecLen(testBlks);
            if (armCount == 0) emitBr(fctx, failBlk)
            else emitBr(fctx, vecGetOr(testBlks, 0, failBlk));

            let incomingRev: Cell (List (String, String)) = cellNew(Nil);
            let idx = cellNew(0);
            let ca = cellNew(arms);
            while (match cellGet(ca) { Nil -> false, _ -> true }) {
                match cellGet(ca) {
                    Cons(arm, r) -> {
                        let i = cellGet(idx);
                        let nextFail = if (i + 1 < armCount) vecGetOr(testBlks, i + 1, failBlk) else failBlk;
                        setInsertBlock(fctx, vecGetOr(testBlks, i, failBlk));

                        let armLocals = cellNew(locals);
                        emitPatternCheck(mctx, fctx, scrutVal, scrutTy, arm.caPat, armLocals, nextFail);

                        match arm.caGuard {
                            Some(gTerm) -> {
                                let gVal = genExpr(mctx, fctx, gTerm, cellGet(armLocals), false);
                                let passBlk = appendBlock(fctx, "match.body");
                                emitCondBr(fctx, gVal, passBlk, nextFail);
                                setInsertBlock(fctx, passBlk)
                            },
                            None -> (),
                        };

                        let bodyVal = genExpr(mctx, fctx, arm.caBody, cellGet(armLocals), inTail);
                        let bodyEnd = getInsertBlock(fctx);
                        emitBr(fctx, contBlk);
                        cellSet(incomingRev, Cons((bodyVal, blockLabel(fctx, bodyEnd)), cellGet(incomingRev)));
                        cellSet(idx, i + 1);
                        cellSet(ca, r)
                    },
                    Nil -> (),
                }
            };

            setInsertBlock(fctx, failBlk);
            emitLine(fctx, "call void @gs_match_fail()");
            emitTermLine(fctx, "unreachable");

            setInsertBlock(fctx, contBlk);
            let resLlvm = getValLlvmType(schemeBody(tm.tscm));
            match listRev(cellGet(incomingRev)) {
                Nil -> {
                    emitTermLine(fctx, "unreachable");
                    llvmZeroValue(resLlvm)
                },
                incList -> emitAssign(fctx, "phi " + resLlvm + " " + formatPhiIncoming(incList)),
            }
            }
        },
    };
    cellSet(fctx.fcCurLocId, prevLoc);
    cellSet(fctx.fcCurSpan, prevSpan);
    exprRes
}

// ============================================================================
// Top-Level Function, Main Trampoline, and Module Emission
// ============================================================================

def termListHasCall(ts: List TaggedTerm): Bool = match ts {
    Nil -> false,
    Cons(h, r) -> if (termHasCall(h)) true else termListHasCall(r),
}

def armListHasCall(arms: List CoreArm): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let gCall = match a.caGuard { Some(g) -> termHasCall(g), None -> false };
        if (gCall || termHasCall(a.caBody)) true else armListHasCall(r)
    },
}

def isPureBuiltinIntrinsic(name: String): Bool =
    name == "cellNew" || name == "cellGet" || name == "cellSet"
    || name == "arrayNew" || name == "arrayNewZeroed" || name == "arrayLen"
    || name == "arrayGet" || name == "arraySet" || name == "arrayClearSlot"
    || name == "arrayFreeze" || name == "immArrayLen" || name == "immArrayGet"
    || name == "bitAnd" || name == "bitAnd64" || name == "bitOr" || name == "bitOr64"
    || name == "bitXor" || name == "bitXor64" || name == "bitNot" || name == "bitNot64"
    || name == "bitShl" || name == "bitShr" || name == "bitUshr"
    || name == "bitShl64" || name == "bitShr64" || name == "bitUshr64"
    || name == "bitPopCount" || name == "bitPopCount64" || name == "bitCtz"
    || name == "charToInt" || name == "intToChar" || name == "intToI64" || name == "i64ToInt"
    || name == "floatToBits64" || name == "bits64ToFloat" || name == "floatToBits32" || name == "bits32ToFloat"
    || name == "intToFloat" || name == "floatToInt"
    || name == "floatToF32" || name == "f32ToFloat" || name == "intToF32" || name == "f32ToInt"
    || name == "f32ToBits32" || name == "bits32ToF32"
    || name == "mathExp" || name == "mathLog" || name == "mathSqrt" || name == "mathSin" || name == "mathCos"
    || name == "mathTanh" || name == "mathPow" || name == "mathAbs" || name == "mathFloor" || name == "mathCeil" || name == "mathFma"
    || name == "mathExpF32" || name == "mathLogF32" || name == "mathSqrtF32" || name == "mathSinF32" || name == "mathCosF32"
    || name == "mathTanhF32" || name == "mathPowF32" || name == "mathAbsF32" || name == "mathFloorF32" || name == "mathCeilF32" || name == "mathFmaF32"
    || name == "ptrNull" || name == "ptrIsNull" || name == "ptrOffset" || name == "ptrOffset64" || name == "cFnPtr" || name == "ptrAllocBytes" || name == "ptrAllocBytes64" || name == "cFnPtr"
    || name == "ptrByteAt" || name == "ptrSetByte"
    || name == "ptrReadI8" || name == "ptrReadU16Le" || name == "ptrReadU32Le"
    || name == "ptrReadI64Le" || name == "ptrReadF32Le" || name == "ptrReadF64Le"
    || name == "ptrWriteU16Le" || name == "ptrWriteU32Le"
    || name == "ptrWriteI64Le" || name == "ptrWriteF32Le" || name == "ptrWriteF64Le"
    || name == "ptrReadI64Le64" || name == "ptrWriteI64Le64"
    || name == "ptrReadF32Le64" || name == "ptrWriteF32Le64"
    || name == "ptrReadF64Le64" || name == "ptrWriteF64Le64"
    || name == "ptrCopyBytes" || name == "ptrCopyBytes64"
    || name == "scopedPtrOffset" || name == "scopedPtrOffset64" || name == "scopedPtrByteAt" || name == "scopedPtrSetByte"
    || name == "scopedPtrReadI32Le" || name == "scopedPtrWriteI32Le"
    || name == "scopedPtrReadI64Le" || name == "scopedPtrWriteI64Le"
    || name == "scopedPtrReadF32Le" || name == "scopedPtrWriteF32Le"
    || name == "scopedPtrReadF32Le64" || name == "scopedPtrWriteF32Le64"
    || name == "scopedPtrReadF64Le" || name == "scopedPtrWriteF64Le"
    || name == "scopedPtrReadF64Le64" || name == "scopedPtrWriteF64Le64"
    || name == "scopedPtrCopyBytes"
    || name == "ptrCopyFromStr" || name == "ptrSliceFromStr" || name == "ptrSliceToString" || name == "ptrToString"
    || name == "strLen" || name == "strByteAt" || name == "strSlice"
    || name == "strConcat" || name == "strFromBytes" || name == "sysArgc" || name == "sysArgv"

def isNonAllocLeafIntrinsic(name: String): Bool =
    name == "cellGet" || name == "cellSet"
    || name == "arrayLen" || name == "arrayGet" || name == "arraySet" || name == "arrayClearSlot"
    || name == "immArrayLen" || name == "immArrayGet"
    || name == "bitAnd" || name == "bitAnd64" || name == "bitOr" || name == "bitOr64"
    || name == "bitXor" || name == "bitXor64" || name == "bitNot" || name == "bitNot64"
    || name == "bitShl" || name == "bitShr" || name == "bitUshr"
    || name == "bitShl64" || name == "bitShr64" || name == "bitUshr64"
    || name == "bitPopCount" || name == "bitPopCount64" || name == "bitCtz"
    || name == "charToInt" || name == "intToChar" || name == "intToI64" || name == "i64ToInt"
    || name == "floatToBits64" || name == "bits64ToFloat" || name == "floatToBits32" || name == "bits32ToFloat"
    || name == "intToFloat" || name == "floatToInt"
    || name == "floatToF32" || name == "f32ToFloat" || name == "intToF32" || name == "f32ToInt"
    || name == "f32ToBits32" || name == "bits32ToF32"
    || name == "mathExp" || name == "mathLog" || name == "mathSqrt" || name == "mathSin" || name == "mathCos"
    || name == "mathTanh" || name == "mathPow" || name == "mathAbs" || name == "mathFloor" || name == "mathCeil" || name == "mathFma"
    || name == "mathExpF32" || name == "mathLogF32" || name == "mathSqrtF32" || name == "mathSinF32" || name == "mathCosF32"
    || name == "mathTanhF32" || name == "mathPowF32" || name == "mathAbsF32" || name == "mathFloorF32" || name == "mathCeilF32" || name == "mathFmaF32"
    || name == "ptrNull" || name == "ptrIsNull" || name == "ptrOffset" || name == "ptrOffset64" || name == "cFnPtr"
    || name == "ptrByteAt" || name == "ptrSetByte"
    || name == "ptrReadI8" || name == "ptrReadU16Le" || name == "ptrReadU32Le"
    || name == "ptrReadI64Le" || name == "ptrReadF32Le" || name == "ptrReadF64Le"
    || name == "ptrWriteU16Le" || name == "ptrWriteU32Le"
    || name == "ptrWriteI64Le" || name == "ptrWriteF32Le" || name == "ptrWriteF64Le"
    || name == "ptrReadI64Le64" || name == "ptrWriteI64Le64"
    || name == "ptrReadF32Le64" || name == "ptrWriteF32Le64"
    || name == "ptrReadF64Le64" || name == "ptrWriteF64Le64"
    || name == "ptrCopyBytes" || name == "ptrCopyBytes64"
    || name == "scopedPtrOffset" || name == "scopedPtrOffset64" || name == "scopedPtrByteAt" || name == "scopedPtrSetByte"
    || name == "scopedPtrReadI32Le" || name == "scopedPtrWriteI32Le"
    || name == "scopedPtrReadI64Le" || name == "scopedPtrWriteI64Le"
    || name == "scopedPtrReadF32Le" || name == "scopedPtrWriteF32Le"
    || name == "scopedPtrReadF32Le64" || name == "scopedPtrWriteF32Le64"
    || name == "scopedPtrReadF64Le" || name == "scopedPtrWriteF64Le"
    || name == "scopedPtrReadF64Le64" || name == "scopedPtrWriteF64Le64"
    || name == "scopedPtrCopyBytes"

def termListNeedsSafepoint(ts: List TaggedTerm): Bool = match ts {
    Nil -> false,
    Cons(h, r) -> if (termNeedsSafepoint(h)) true else termListNeedsSafepoint(r),
}

def armListNeedsSafepoint(arms: List CoreArm): Bool = match arms {
    Nil -> false,
    Cons(a, r) -> {
        let gSp = match a.caGuard { Some(g) -> termNeedsSafepoint(g), None -> false };
        if (gSp || termNeedsSafepoint(a.caBody)) true else armListNeedsSafepoint(r)
    },
}

// Pure numerical leaf loops (no calls, no heap allocations, no nested loops) omit the inner-loop
// atomic safepoint poll so LLVM LoopVectorizer can auto-vectorize (NEON / AVX SIMD).
def termNeedsSafepoint(tm: TaggedTerm): Bool = match tm.tnode {
    TmApplyCls(_, _) -> true,
    TmApplyDir(vd, args) -> if (isNonAllocLeafIntrinsic(vd.vname)) termListNeedsSafepoint(args) else true,
    TmTuple(es) -> termListNeedsSafepoint(es),
    TmBlock(es) -> termListNeedsSafepoint(es),
    TmMakeData(_, _, es, _, _) -> match es {
        Nil -> false,
        _ -> match unboxedAdtFields(schemeBody(tm.tscm)) {
            Some(_) -> termListNeedsSafepoint(es),
            None -> true,
        },
    },
    TmBin(op, l, r) -> match (op, schemeBody(l.tscm)) {
        (OpAdd, TyCon("String")) -> true,
        _ -> termNeedsSafepoint(l) || termNeedsSafepoint(r),
    },
    TmUn(_, e) -> termNeedsSafepoint(e),
    TmGetTag(e) -> termNeedsSafepoint(e),
    TmLet(_, v, b) -> termNeedsSafepoint(v) || termNeedsSafepoint(b),
    TmMakeCls(_, _, _) -> true,
    TmIf(c, t, e) -> termNeedsSafepoint(c) || termNeedsSafepoint(t) || termNeedsSafepoint(e),
    TmWhile(_, _) -> true,
    TmMatch(s, arms) -> termNeedsSafepoint(s) || armListNeedsSafepoint(arms),
    _ -> false,
}

def termHasCall(tm: TaggedTerm): Bool = match tm.tnode {
    TmApplyCls(_, _) -> true,
    TmApplyDir(vd, args) -> if (isPureBuiltinIntrinsic(vd.vname)) termListHasCall(args) else true,
    TmTuple(es) -> termListHasCall(es),
    TmBlock(es) -> termListHasCall(es),
    TmMakeData(_, _, es, _, _) -> termListHasCall(es),
    TmBin(_, l, r) -> termHasCall(l) || termHasCall(r),
    TmUn(_, e) -> termHasCall(e),
    TmGetTag(e) -> termHasCall(e),
    TmLet(_, v, b) -> termHasCall(v) || termHasCall(b),
    TmMakeCls(_, _, b) -> termHasCall(b),
    TmIf(c, t, e) -> termHasCall(c) || termHasCall(t) || termHasCall(e),
    TmWhile(c, b) -> termHasCall(c) || termHasCall(b),
    TmMatch(s, arms) -> termHasCall(s) || armListHasCall(arms),
    _ -> false,
}

def emitTopLevelFunction(out: StringBuf, mctx: ModEmitCtx, fd: FunDef): Void = {
    let isCExported = strMapContains(mctx.mcCExportSyms, fd.fnName);
    let isExp = !isCExported && shouldExportSymbol(mctx, fd.fnName);
    let linkageName =
        if (isCExported) "__gs_fn_" + fd.fnName
        else if (!mctx.mcIsWasm && isExp) "__gs_exp_" + fd.fnName
        else fd.fnName;
    let fctx = newFnEmitCtxDebug(mctx, fd.fnName, fd.fnName, linkageName, fd.fnSpan);
    let funTy = schemeBody(fd.fnScm);
    let retGeishaTy = match funTy {
        TyArr(_, _, r) -> r,
        _ -> TyVoid,
    };
    let retLlvm = getFnRetLlvmType(retGeishaTy);

    let paramSigPartsRev = cellNew(Nil);
    let localsRev = cellNew(Nil);
    let pIdx = cellNew(0);
    let cp = cellNew(fd.fnParams);
    while (match cellGet(cp) { Nil -> false, _ -> true }) {
        match cellGet(cp) {
            Cons(vd, r) -> {
                let i = cellGet(pIdx);
                let argReg = "%arg" + intToStr(i);
                let pGeishaTy = schemeBody(vd.vscm);
                let pLlvmTy = getValLlvmType(pGeishaTy);
                cellSet(paramSigPartsRev, Cons(pLlvmTy + " " + argReg, cellGet(paramSigPartsRev)));

                let slotPtr = emitEntryAlloca(fctx, pLlvmTy);
                dbgEmitLocalVar(mctx, fctx, vd.vname, pGeishaTy, slotPtr, fd.fnSpan, i + 1);
                emitStore(fctx, pLlvmTy, argReg, slotPtr);
                let slot = MkVarSlot { vsPtr: slotPtr, vsLlvmTy: pLlvmTy, vsGeishaTy: pGeishaTy };
                cellSet(localsRev, Cons((vd.vname, slot), cellGet(localsRev)));
                cellSet(pIdx, i + 1);
                cellSet(cp, r)
            },
            Nil -> (),
        }
    };
    cellSet(paramSigPartsRev, Cons("ptr %fvs", cellGet(paramSigPartsRev)));

    // Unpack captured closure environment from `ptr %fvs`
    match fd.fnFvs {
        Nil -> (),
        fvs -> {
            let fvLlvmRev = cellNew(Nil);
            let cf0 = cellNew(fvs);
            while (match cellGet(cf0) { Nil -> false, _ -> true }) {
                match cellGet(cf0) {
                    Cons(vd, r) -> {
                        cellSet(fvLlvmRev, Cons(getValLlvmType(schemeBody(vd.vscm)), cellGet(fvLlvmRev)));
                        cellSet(cf0, r)
                    },
                    Nil -> (),
                }
            };
            let fvLlvmTys = listRev(cellGet(fvLlvmRev));
            let fvStructTy = formatLlvmStructType(fvLlvmTys);

            let idx = cellNew(0);
            let cf1 = cellNew(fvs);
            let clt = cellNew(fvLlvmTys);
            while (match (cellGet(cf1), cellGet(clt)) { (Cons(_, _), Cons(_, _)) -> true, _ -> false }) {
                match (cellGet(cf1), cellGet(clt)) {
                    (Cons(vd, r1), Cons(elemTy, r2)) -> {
                        let i = cellGet(idx);
                        let slotPtr = emitEntryAlloca(fctx, elemTy);
                        let fPtr = emitStructFieldPtr(fctx, fvStructTy, "%fvs", i);
                        let fvVal = emitLoad(fctx, elemTy, fPtr);
                        dbgEmitLocalVar(mctx, fctx, vd.vname, schemeBody(vd.vscm), slotPtr, fd.fnSpan, 0);
                        emitStore(fctx, elemTy, fvVal, slotPtr);
                        let slot = MkVarSlot { vsPtr: slotPtr, vsLlvmTy: elemTy, vsGeishaTy: schemeBody(vd.vscm) };
                        cellSet(localsRev, Cons((vd.vname, slot), cellGet(localsRev)));
                        cellSet(idx, i + 1);
                        cellSet(cf1, r1);
                        cellSet(clt, r2)
                    },
                    _ -> (),
                }
            }
        },
    };

    let allowTail = !mctx.mcDebug && !fnHasStackAlloc(mctx.mcEscape, fd.fnName);
    if (termHasCall(fd.fnBody)) emitGcSafepointPoll(mctx, fctx) else ();
    let bodyVal = genExpr(mctx, fctx, fd.fnBody, listRev(cellGet(localsRev)), allowTail);
    if (!curBlockHasTerm(fctx)) {
        if (retLlvm == "void") emitTermLine(fctx, "ret void")
        else emitTermLine(fctx, "ret " + retLlvm + " " + bodyVal)
    } else ();

    let paramSigStr = strJoin(listRev(cellGet(paramSigPartsRev)), ", ");
    if (isCExported) {
        let implHeader = "define internal " + retLlvm + " " + llvmSym("__gs_fn_" + fd.fnName) + "(" + paramSigStr + ") nounwind";
        flushFunctionToBuf(out, implHeader, fctx)
    } else if (!mctx.mcIsWasm && isExp) {
        let implSym = llvmSym("__gs_exp_" + fd.fnName);
        let implHeader = "define internal " + retLlvm + " " + implSym + "(" + paramSigStr + ") nounwind";
        flushFunctionToBuf(out, implHeader, fctx);
        // Emit thread-safe C/Swift host entry trampoline for exported native symbol
        bufPushStr(out, "define " + retLlvm + " " + llvmSym(fd.fnName) + "(" + paramSigStr + ") nounwind {\nentry:\n");
        bufPushStr(out, "  %anchor = alloca i64, align 8\n");
        bufPushStr(out, "  store i64 0, ptr %anchor, align 8\n");
        bufPushStr(out, "  %tok = call i64 @gc_host_enter(ptr %anchor)\n");
        if (mctx.mcUseGlobalsOnce) {
            bufPushStr(out, "  call void @__gs_init_globals_once()\n")
        } else ();
        if (retLlvm == "void") {
            bufPushStr(out, "  call void " + implSym + "(" + paramSigStr + ")\n");
            bufPushStr(out, "  call void @gc_host_leave(i64 %tok)\n");
            bufPushStr(out, "  ret void\n}\n\n")
        } else {
            bufPushStr(out, "  %res = call " + retLlvm + " " + implSym + "(" + paramSigStr + ")\n");
            bufPushStr(out, "  call void @gc_host_leave(i64 %tok)\n");
            bufPushStr(out, "  ret " + retLlvm + " %res\n}\n\n")
        }
    } else {
        let linkage = if (isExp) "" else "internal ";
        let exportAttr =
            if (mctx.mcIsWasm && isExp) " \"wasm-export-name\"=\"" + fd.fnName + "\""
            else "";
        let header = "define " + linkage + retLlvm + " " + llvmSym(fd.fnName) + "(" + paramSigStr + ") nounwind" + exportAttr;
        flushFunctionToBuf(out, header, fctx)
    }
}

def emitRegisterGlobalRoots(fctx: FnEmitCtx, ty: Type, basePtr: String): Void =
    if (isGcPointerType(ty)) {
        emitLine(fctx, "call void @gc_register_root(ptr " + basePtr + ")")
    } else match ty {
        TyTuple(es) -> emitRegisterStructFieldRoots(fctx, es, basePtr),
        _ -> match unboxedAdtFields(ty) {
            Some(fs) -> emitRegisterStructFieldRoots(fctx, fs, basePtr),
            None -> (),
        },
    }

def emitRegisterStructFieldRoots(fctx: FnEmitCtx, fields: List Type, basePtr: String): Void = {
    let structTy = formatLlvmStructType(mapValLlvmTypes(fields));
    let idx = cellNew(0);
    let cur = cellNew(fields);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ft, r) -> {
                let i = cellGet(idx);
                if (!isNoscanElemType(ft)) {
                    let fp = emitStructFieldPtr(fctx, structTy, basePtr, i);
                    emitRegisterGlobalRoots(fctx, ft, fp)
                } else ();
                cellSet(idx, i + 1);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    }
}

def emitWasmInitFunction(out: StringBuf, mctx: ModEmitCtx, mainOpt: Option FunDef, globals: List GlobalValDef): Void = {
    let fctx = newFnEmitCtx("__geisha_init");
    let cg = cellNew(globals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(g, r) -> {
                match strMapGet(mctx.mcGlobalSlots, g.gvName) {
                    Some(slot) -> {
                        emitRegisterGlobalRoots(fctx, g.gvTy, slot.vsPtr);
                        cellSet(fctx.fcPendingLet, None);
                        let initVal = genExpr(mctx, fctx, g.gvInit, Nil, false);
                        emitStore(fctx, slot.vsLlvmTy, initVal, slot.vsPtr)
                    },
                    None -> (),
                };
                cellSet(cg, r)
            },
            Nil -> (),
        }
    };
    match mainOpt {
        Some(mainFd) -> {
            let _ = genExpr(mctx, fctx, mainFd.fnBody, Nil, false);
            ()
        },
        None -> (),
    };
    if (!curBlockHasTerm(fctx)) emitTermLine(fctx, "ret void") else ();
    flushFunctionToBuf(out, "define void @__geisha_init() nounwind \"wasm-export-name\"=\"__geisha_init\"", fctx)
}

def emitMainFunctions(out: StringBuf, mctx: ModEmitCtx, mainFd: FunDef, globals: List GlobalValDef, useGlobalsOnce: Bool): Void = {
    let fctx = newFnEmitCtxDebug(mctx, "main", "main", "__geisha_main", mainFd.fnSpan);
    if (useGlobalsOnce) {
        emitLine(fctx, "call void @__gs_init_globals_once()")
    } else {
        let cg = cellNew(globals);
        while (match cellGet(cg) { Nil -> false, _ -> true }) {
            match cellGet(cg) {
                Cons(g, r) -> {
                    match strMapGet(mctx.mcGlobalSlots, g.gvName) {
                        Some(slot) -> {
                            emitRegisterGlobalRoots(fctx, g.gvTy, slot.vsPtr);
                            cellSet(fctx.fcPendingLet, None);
                            let initVal = genExpr(mctx, fctx, g.gvInit, Nil, false);
                            emitStore(fctx, slot.vsLlvmTy, initVal, slot.vsPtr)
                        },
                        None -> (),
                    };
                    cellSet(cg, r)
                },
                Nil -> (),
            }
        }
    };

    let _ = genExpr(mctx, fctx, mainFd.fnBody, Nil, false);
    if (!curBlockHasTerm(fctx)) emitTermLine(fctx, "ret void") else ();
    flushFunctionToBuf(out, "define internal void @__geisha_main() nounwind", fctx);

    // Emit C entry trampoline `@main(i32 %argc, ptr %argv)` with stack anchor strictly above `@__geisha_main`
    if (mctx.mcDebug) {
        let (trampSp, _, trampLn) = dbgCreateSubprogram(mctx, "main_entry", "main", mainFd.fnSpan);
        let trampLoc = dbgAllocId(mctx);
        dbgEmitNode(mctx, trampLoc, "!DILocation(line: " + intToStr(trampLn) + ", column: 1, scope: !" + intToStr(trampSp) + ")");
        let dbgSuffix = ", !dbg !" + intToStr(trampLoc);
        bufPushStr(out, "define i32 @main(i32 %argc, ptr %argv) nounwind !dbg !" + intToStr(trampSp) + " {\nentry:\n");
        bufPushStr(out, "  store i32 %argc, ptr @__gs_argc\n");
        bufPushStr(out, "  store ptr %argv, ptr @__gs_argv\n");
        bufPushStr(out, "  %anchor = alloca i64, align 8\n");
        bufPushStr(out, "  store i64 0, ptr %anchor, align 8\n");
        bufPushStr(out, "  call void @gc_init_with_stack(i64 131072, ptr %anchor)\n");
        bufPushStr(out, "  call void @gc_enable_generational()\n");
        bufPushStr(out, "  call void @__geisha_main()" + dbgSuffix + "\n");
        bufPushStr(out, "  ret i32 0" + dbgSuffix + "\n}\n\n")
    } else {
        bufPushStr(out, "define i32 @main(i32 %argc, ptr %argv) nounwind {\nentry:\n");
        bufPushStr(out, "  store i32 %argc, ptr @__gs_argc\n");
        bufPushStr(out, "  store ptr %argv, ptr @__gs_argv\n");
        bufPushStr(out, "  %anchor = alloca i64, align 8\n");
        bufPushStr(out, "  store i64 0, ptr %anchor, align 8\n");
        bufPushStr(out, "  call void @gc_init_with_stack(i64 131072, ptr %anchor)\n");
        bufPushStr(out, "  call void @gc_enable_generational()\n");
        bufPushStr(out, "  call void @__geisha_main()\n");
        bufPushStr(out, "  ret i32 0\n}\n\n")
    }
}

def emitRuntimeDeclares(out: StringBuf, declaredSyms: StrMap Bool, definedFns: StrMap FunDef, isWasm: Bool): Void = {
    let decls = if (isWasm) [
        ("gc_init_with_stack", "declare void @gc_init_with_stack(i64, ptr) nounwind"),
        ("gc_register_root", "declare void @gc_register_root(ptr) nounwind"),
        ("gc_handle_new", "declare i64 @gc_handle_new(ptr) nounwind"),
        ("gc_handle_get", "declare ptr @gc_handle_get(i64) nounwind"),
        ("gc_handle_free", "declare void @gc_handle_free(i64) nounwind"),
        ("gc_trim", "declare void @gc_trim() nounwind"),
        ("gc_set_thresholds", "declare void @gc_set_thresholds(i64, i64) nounwind"),
        ("gc_heap_live_bytes", "declare i64 @gc_heap_live_bytes() nounwind"),
        ("gc_alloc", "declare noalias nonnull ptr @gc_alloc(i64) nounwind"),
        ("gc_alloc_atomic", "declare noalias nonnull ptr @gc_alloc_atomic(i64) nounwind"),
        ("gc_alloc_atomic_uninit", "declare noalias nonnull ptr @gc_alloc_atomic_uninit(i64) nounwind"),
        ("gs_str_cmp", "declare i32 @gs_str_cmp(ptr, ptr) nounwind willreturn memory(argmem: read)"),
        ("gs_match_fail", "declare void @gs_match_fail() cold noreturn nounwind"),
        ("gs_bounds_fail", "declare void @gs_bounds_fail(i32, i32) cold noreturn nounwind"),
        ("gs_div_zero_fail", "declare void @gs_div_zero_fail() cold noreturn nounwind"),
        ("gs_bench_black_box_mem", "declare void @gs_bench_black_box_mem(ptr) nounwind"),
        ("gs_bench_black_box_void", "declare void @gs_bench_black_box_void() nounwind"),
        ("gs_strlen", "declare i64 @gs_strlen(ptr) nounwind willreturn memory(argmem: read)"),
        ("llvm.memcpy.p0.p0.i64", "declare void @llvm.memcpy.p0.p0.i64(ptr noalias writeonly, ptr noalias readonly, i64, i1 immarg) nounwind"),
        ("llvm.memmove.p0.p0.i64", "declare void @llvm.memmove.p0.p0.i64(ptr writeonly, ptr readonly, i64, i1 immarg) nounwind"),
        ("llvm.ctpop.i32", "declare i32 @llvm.ctpop.i32(i32) nounwind willreturn memory(none)"),
        ("llvm.ctpop.i64", "declare i64 @llvm.ctpop.i64(i64) nounwind willreturn memory(none)"),
        ("llvm.cttz.i32", "declare i32 @llvm.cttz.i32(i32, i1 immarg) nounwind willreturn memory(none)"),
        ("llvm.stacksave.p0", "declare ptr @llvm.stacksave.p0() nounwind"),
        ("llvm.stackrestore.p0", "declare void @llvm.stackrestore.p0(ptr) nounwind"),
        ("llvm.exp.f64", "declare double @llvm.exp.f64(double) nounwind willreturn memory(none)"),
        ("llvm.log.f64", "declare double @llvm.log.f64(double) nounwind willreturn memory(none)"),
        ("llvm.sqrt.f64", "declare double @llvm.sqrt.f64(double) nounwind willreturn memory(none)"),
        ("llvm.sin.f64", "declare double @llvm.sin.f64(double) nounwind willreturn memory(none)"),
        ("llvm.cos.f64", "declare double @llvm.cos.f64(double) nounwind willreturn memory(none)"),
        ("llvm.pow.f64", "declare double @llvm.pow.f64(double, double) nounwind willreturn memory(none)"),
        ("llvm.fabs.f64", "declare double @llvm.fabs.f64(double) nounwind willreturn memory(none)"),
        ("llvm.floor.f64", "declare double @llvm.floor.f64(double) nounwind willreturn memory(none)"),
        ("llvm.ceil.f64", "declare double @llvm.ceil.f64(double) nounwind willreturn memory(none)"),
        ("llvm.fma.f64", "declare double @llvm.fma.f64(double, double, double) nounwind willreturn memory(none)"),
        ("llvm.exp.f32", "declare float @llvm.exp.f32(float) nounwind willreturn memory(none)"),
        ("llvm.log.f32", "declare float @llvm.log.f32(float) nounwind willreturn memory(none)"),
        ("llvm.sqrt.f32", "declare float @llvm.sqrt.f32(float) nounwind willreturn memory(none)"),
        ("llvm.sin.f32", "declare float @llvm.sin.f32(float) nounwind willreturn memory(none)"),
        ("llvm.cos.f32", "declare float @llvm.cos.f32(float) nounwind willreturn memory(none)"),
        ("llvm.pow.f32", "declare float @llvm.pow.f32(float, float) nounwind willreturn memory(none)"),
        ("llvm.fabs.f32", "declare float @llvm.fabs.f32(float) nounwind willreturn memory(none)"),
        ("llvm.floor.f32", "declare float @llvm.floor.f32(float) nounwind willreturn memory(none)"),
        ("llvm.ceil.f32", "declare float @llvm.ceil.f32(float) nounwind willreturn memory(none)"),
        ("llvm.fma.f32", "declare float @llvm.fma.f32(float, float, float) nounwind willreturn memory(none)"),
        ("tanh", "declare double @tanh(double) nounwind willreturn memory(none)"),
        ("tanhf", "declare float @tanhf(float) nounwind willreturn memory(none)"),
        ("gc_foreign_ptr_new", "declare ptr @gc_foreign_ptr_new(ptr, ptr, i64) nounwind"),
        ("gc_foreign_ptr_alloc", "declare ptr @gc_foreign_ptr_alloc(i64) nounwind"),
        ("gc_foreign_ptr_get", "declare ptr @gc_foreign_ptr_get(ptr) nounwind"),
        ("gc_external_live_bytes", "declare i64 @gc_external_live_bytes() nounwind"),
        ("gc_arena_new", "declare ptr @gc_arena_new() nounwind"),
        ("gc_arena_alloc", "declare ptr @gc_arena_alloc(ptr, i64) nounwind"),
        ("gc_arena_destroy", "declare void @gc_arena_destroy(ptr) nounwind"),
        ("gs_conc_par_tabulate", "declare void @gs_conc_par_tabulate(ptr, i32, ptr, ptr)"),
        ("printLn", "declare void @printLn(ptr, ptr) nounwind"),
        ("putNumber", "declare void @putNumber(i32, ptr) nounwind"),
        ("putFloat", "declare void @putFloat(double, ptr) nounwind"),
        ("putF32", "declare void @putF32(float, ptr) nounwind"),
        ("putChar", "declare void @putChar(i8, ptr) nounwind")
    ] else [
        ("gc_init_with_stack", "declare void @gc_init_with_stack(i64, ptr) nounwind"),
        ("gc_enable_generational", "declare void @gc_enable_generational() nounwind"),
        ("gc_register_root", "declare void @gc_register_root(ptr) nounwind"),
        ("gc_run_globals_init_once", "declare void @gc_run_globals_init_once(ptr, ptr) nounwind"),
        ("gc_host_enter", "declare i64 @gc_host_enter(ptr) nounwind"),
        ("gc_host_leave", "declare void @gc_host_leave(i64) nounwind"),
        ("gc_handle_new", "declare i64 @gc_handle_new(ptr) nounwind"),
        ("gc_handle_get", "declare ptr @gc_handle_get(i64) nounwind"),
        ("gc_handle_free", "declare void @gc_handle_free(i64) nounwind"),
        ("gc_trim", "declare void @gc_trim() nounwind"),
        ("gc_set_thresholds", "declare void @gc_set_thresholds(i64, i64) nounwind"),
        ("gc_heap_live_bytes", "declare i64 @gc_heap_live_bytes() nounwind"),
        ("gc_alloc", "declare noalias nonnull ptr @gc_alloc(i64) nounwind"),
        ("gc_alloc_atomic", "declare noalias nonnull ptr @gc_alloc_atomic(i64) nounwind"),
        ("gc_alloc_atomic_uninit", "declare noalias nonnull ptr @gc_alloc_atomic_uninit(i64) nounwind"),
        ("gc_alloc_masked", "declare noalias nonnull ptr @gc_alloc_masked(i64, i64) nounwind"),
        ("gc_write_barrier", "declare void @gc_write_barrier(ptr) cold nounwind"),
        ("gc_safepoint_slow", "declare void @gc_safepoint_slow() cold nounwind"),
        ("_setjmp", "declare i32 @_setjmp(ptr) returns_twice"),
        ("gc_enter_blocking", "declare void @gc_enter_blocking(ptr) nounwind"),
        ("gc_leave_blocking", "declare void @gc_leave_blocking() nounwind"),
        ("gs_str_cmp", "declare i32 @gs_str_cmp(ptr, ptr) nounwind willreturn memory(argmem: read)"),
        ("gs_match_fail", "declare void @gs_match_fail() cold noreturn nounwind"),
        ("gs_bounds_fail", "declare void @gs_bounds_fail(i32, i32) cold noreturn nounwind"),
        ("gs_div_zero_fail", "declare void @gs_div_zero_fail() cold noreturn nounwind"),
        ("gs_bench_black_box_mem", "declare void @gs_bench_black_box_mem(ptr) nounwind"),
        ("gs_bench_black_box_void", "declare void @gs_bench_black_box_void() nounwind"),
        ("strlen", "declare i64 @strlen(ptr) nounwind willreturn memory(argmem: read)"),
        ("llvm.memcpy.p0.p0.i64", "declare void @llvm.memcpy.p0.p0.i64(ptr noalias writeonly, ptr noalias readonly, i64, i1 immarg) nounwind"),
        ("llvm.memmove.p0.p0.i64", "declare void @llvm.memmove.p0.p0.i64(ptr writeonly, ptr readonly, i64, i1 immarg) nounwind"),
        ("llvm.ctpop.i32", "declare i32 @llvm.ctpop.i32(i32) nounwind willreturn memory(none)"),
        ("llvm.ctpop.i64", "declare i64 @llvm.ctpop.i64(i64) nounwind willreturn memory(none)"),
        ("llvm.cttz.i32", "declare i32 @llvm.cttz.i32(i32, i1 immarg) nounwind willreturn memory(none)"),
        ("llvm.stacksave.p0", "declare ptr @llvm.stacksave.p0() nounwind"),
        ("llvm.stackrestore.p0", "declare void @llvm.stackrestore.p0(ptr) nounwind"),
        ("llvm.exp.f64", "declare double @llvm.exp.f64(double) nounwind willreturn memory(none)"),
        ("llvm.log.f64", "declare double @llvm.log.f64(double) nounwind willreturn memory(none)"),
        ("llvm.sqrt.f64", "declare double @llvm.sqrt.f64(double) nounwind willreturn memory(none)"),
        ("llvm.sin.f64", "declare double @llvm.sin.f64(double) nounwind willreturn memory(none)"),
        ("llvm.cos.f64", "declare double @llvm.cos.f64(double) nounwind willreturn memory(none)"),
        ("llvm.pow.f64", "declare double @llvm.pow.f64(double, double) nounwind willreturn memory(none)"),
        ("llvm.fabs.f64", "declare double @llvm.fabs.f64(double) nounwind willreturn memory(none)"),
        ("llvm.floor.f64", "declare double @llvm.floor.f64(double) nounwind willreturn memory(none)"),
        ("llvm.ceil.f64", "declare double @llvm.ceil.f64(double) nounwind willreturn memory(none)"),
        ("llvm.fma.f64", "declare double @llvm.fma.f64(double, double, double) nounwind willreturn memory(none)"),
        ("llvm.exp.f32", "declare float @llvm.exp.f32(float) nounwind willreturn memory(none)"),
        ("llvm.log.f32", "declare float @llvm.log.f32(float) nounwind willreturn memory(none)"),
        ("llvm.sqrt.f32", "declare float @llvm.sqrt.f32(float) nounwind willreturn memory(none)"),
        ("llvm.sin.f32", "declare float @llvm.sin.f32(float) nounwind willreturn memory(none)"),
        ("llvm.cos.f32", "declare float @llvm.cos.f32(float) nounwind willreturn memory(none)"),
        ("llvm.pow.f32", "declare float @llvm.pow.f32(float, float) nounwind willreturn memory(none)"),
        ("llvm.fabs.f32", "declare float @llvm.fabs.f32(float) nounwind willreturn memory(none)"),
        ("llvm.floor.f32", "declare float @llvm.floor.f32(float) nounwind willreturn memory(none)"),
        ("llvm.ceil.f32", "declare float @llvm.ceil.f32(float) nounwind willreturn memory(none)"),
        ("llvm.fma.f32", "declare float @llvm.fma.f32(float, float, float) nounwind willreturn memory(none)"),
        ("tanh", "declare double @tanh(double) nounwind willreturn memory(none)"),
        ("tanhf", "declare float @tanhf(float) nounwind willreturn memory(none)"),
        ("gc_foreign_ptr_new", "declare ptr @gc_foreign_ptr_new(ptr, ptr, i64) nounwind"),
        ("gc_foreign_ptr_alloc", "declare ptr @gc_foreign_ptr_alloc(i64) nounwind"),
        ("gc_foreign_ptr_get", "declare ptr @gc_foreign_ptr_get(ptr) nounwind"),
        ("gc_external_live_bytes", "declare i64 @gc_external_live_bytes() nounwind"),
        ("gc_arena_new", "declare ptr @gc_arena_new() nounwind"),
        ("gc_arena_alloc", "declare ptr @gc_arena_alloc(ptr, i64) nounwind"),
        ("gc_arena_destroy", "declare void @gc_arena_destroy(ptr) nounwind"),
        ("gs_conc_par_tabulate", "declare void @gs_conc_par_tabulate(ptr, i32, ptr, ptr)"),
        ("printLn", "declare void @printLn(ptr, ptr) nounwind"),
        ("putNumber", "declare void @putNumber(i32, ptr) nounwind"),
        ("putFloat", "declare void @putFloat(double, ptr) nounwind"),
        ("putF32", "declare void @putF32(float, ptr) nounwind"),
        ("putChar", "declare void @putChar(i8, ptr) nounwind"),
        ("gs_atomic_new", "declare ptr @gs_atomic_new(i32)"),
        ("gs_atomic_load", "declare i32 @gs_atomic_load(ptr)"),
        ("gs_atomic_store", "declare void @gs_atomic_store(ptr, i32)"),
        ("gs_atomic_add", "declare i32 @gs_atomic_add(ptr, i32)"),
        ("gs_atomic_cas", "declare i32 @gs_atomic_cas(ptr, i32, i32)"),
        ("gs_mvar_new", "declare ptr @gs_mvar_new(ptr, i32)"),
        ("gs_mvar_take", "declare ptr @gs_mvar_take(ptr)"),
        ("gs_mvar_put", "declare void @gs_mvar_put(ptr, ptr)"),
        ("gs_mvar_read", "declare ptr @gs_mvar_read(ptr)"),
        ("gs_mvar_try_take", "declare ptr @gs_mvar_try_take(ptr)"),
        ("gs_chan_new", "declare ptr @gs_chan_new(i32)"),
        ("gs_chan_send", "declare i32 @gs_chan_send(ptr, ptr)"),
        ("gs_chan_recv", "declare ptr @gs_chan_recv(ptr)"),
        ("gs_chan_try_recv", "declare ptr @gs_chan_try_recv(ptr)"),
        ("gs_chan_close", "declare void @gs_chan_close(ptr)"),
        ("gs_chan_is_closed", "declare i32 @gs_chan_is_closed(ptr)"),
        ("gs_task_spawn", "declare ptr @gs_task_spawn(ptr, ptr)"),
        ("gs_task_await", "declare ptr @gs_task_await(ptr)"),
        ("gs_task_is_ready", "declare i32 @gs_task_is_ready(ptr)"),
        ("gs_task_wait_any", "declare void @gs_task_wait_any(ptr, i32, i32)"),
        ("gs_conc_num_cpu", "declare i32 @gs_conc_num_cpu()"),
        ("gs_conc_sleep_ms", "declare void @gs_conc_sleep_ms(i32)"),
        ("gs_actor_spawn", "declare ptr @gs_actor_spawn(ptr, ptr)"),
        ("gs_actor_call", "declare ptr @gs_actor_call(ptr, ptr, ptr)"),
        ("gs_actor_send", "declare void @gs_actor_send(ptr, ptr, ptr)"),
        ("gs_actor_stop", "declare void @gs_actor_stop(ptr)")
    ];
    let cur = cellNew(decls);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((sym, line), r) -> {
                strMapInsert(declaredSyms, sym, true);
                if (!strMapContains(definedFns, sym)) {
                    bufPushStr(out, line);
                    bufPushByte(out, 10)
                } else ();
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(out, 10)
}

def computeMultiExternLinks(externs: StrMap ExternDef, externNames: List String): StrMap Bool = {
    let seen: StrMap Bool = strMapNew();
    let multi: StrMap Bool = strMapNew();
    let cur = cellNew(externNames);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ename, r) -> {
                match strMapGet(externs, ename) {
                    Some(ed) if (!ed.extIsFnPtr) ->
                        if (strMapContains(seen, ed.extLink)) strMapInsert(multi, ed.extLink, true)
                        else strMapInsert(seen, ed.extLink, true),
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    multi
}

def emitUserExternDeclares(
    out: StringBuf,
    declaredSyms: StrMap Bool,
    definedFns: StrMap FunDef,
    externs: StrMap ExternDef,
    externNames: List String,
    multiLinks: StrMap Bool,
    targetArch: String,
    ptrSize: Int
): Void = {
    let cur = cellNew(externNames);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(ename, r) -> {
                match strMapGet(externs, ename) {
                    Some(ed) if (!ed.extIsFnPtr) -> {
                        if (!strMapContains(declaredSyms, ed.extLink) && !strMapContains(definedFns, ed.extLink)) {
                            strMapInsert(declaredSyms, ed.extLink, true);
                            if (strMapContains(multiLinks, ed.extLink)) {
                                bufPushStr(out, "declare ptr " + llvmSym(ed.extLink) + "()\n")
                            } else {
                                match ed.extTy {
                                    TyArr(_, ps, ret) -> {
                                        let (rTy, pTys) = cAbiDeclParamStrings(targetArch, ptrSize, ps, ret);
                                        bufPushStr(out, "declare ");
                                        bufPushStr(out, rTy);
                                        bufPushByte(out, 32);
                                        bufPushStr(out, llvmSym(ed.extLink));
                                        bufPushByte(out, 40);
                                        bufPushStr(out, strJoin(pTys, ", "));
                                        bufPushStr(out, if (ed.extNoAlloc) ") nounwind\n" else ")\n")
                                    },
                                    _ -> (),
                                }
                            }
                        } else ()
                    },
                    _ -> (),
                };
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(out, 10)
}

def emitGlobalsInitOnceHelper(
    out: StringBuf,
    mctx: ModEmitCtx,
    globals: List GlobalValDef
): Void = {
    let bodyCtx = newFnEmitCtx("__gs_init_globals_body");
    let cg = cellNew(globals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(g, r) -> {
                match strMapGet(mctx.mcGlobalSlots, g.gvName) {
                    Some(slot) -> {
                        emitRegisterGlobalRoots(bodyCtx, g.gvTy, slot.vsPtr);
                        cellSet(bodyCtx.fcPendingLet, None);
                        let initVal = genExpr(mctx, bodyCtx, g.gvInit, Nil, false);
                        emitStore(bodyCtx, slot.vsLlvmTy, initVal, slot.vsPtr)
                    },
                    None -> (),
                };
                cellSet(cg, r)
            },
            Nil -> (),
        }
    };
    if (!curBlockHasTerm(bodyCtx)) emitTermLine(bodyCtx, "ret void") else ();
    flushFunctionToBuf(out, "define internal void @__gs_init_globals_body() nounwind", bodyCtx);

    bufPushStr(out, "define internal void @__gs_init_globals_once() nounwind {\nentry:\n");
    bufPushStr(out, "  %st = load atomic i32, ptr @__gs_globals_init_state acquire, align 4\n");
    bufPushStr(out, "  %done = icmp eq i32 %st, 2\n");
    bufPushStr(out, "  br i1 %done, label %ginit_ok, label %ginit_slow\n");
    bufPushStr(out, "ginit_slow:\n");
    bufPushStr(out, "  call void @gc_run_globals_init_once(ptr @__gs_globals_init_state, ptr @__gs_init_globals_body)\n");
    bufPushStr(out, "  br label %ginit_ok\n");
    bufPushStr(out, "ginit_ok:\n");
    bufPushStr(out, "  ret void\n}\n\n")
}

def emitGlobalCtors(
    out: StringBuf,
    mctx: ModEmitCtx,
    ctors: List (String, Int),
    hasGlobalsOnce: Bool
): Void = match ctors {
    Nil -> (),
    _ -> {
        let entriesRev = cellNew(Nil);
        let idx = cellNew(0);
        let cur = cellNew(ctors);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons((fnName, prio), r) -> {
                    let i = cellGet(idx);
                    let ctorSym = "@__gs_ctor_" + intToStr(i);
                    bufPushStr(out, "define internal void " + ctorSym + "() nounwind {\nentry:\n");
                    if (!mctx.mcIsWasm) {
                        bufPushStr(out, "  %anchor = alloca i64, align 8\n");
                        bufPushStr(out, "  store i64 0, ptr %anchor, align 8\n");
                        bufPushStr(out, "  %tok = call i64 @gc_host_enter(ptr %anchor)\n")
                    } else ();
                    if (hasGlobalsOnce) {
                        bufPushStr(out, "  call void @__gs_init_globals_once()\n")
                    } else ();
                    let targetSym = geishaCallImplSym(mctx, fnName);
                    bufPushStr(out, "  call void " + targetSym + "(ptr null)\n");
                    if (!mctx.mcIsWasm) {
                        bufPushStr(out, "  call void @gc_host_leave(i64 %tok)\n")
                    } else ();
                    bufPushStr(out, "  ret void\n}\n\n");
                    cellSet(entriesRev, Cons("{ i32, ptr, ptr } { i32 " + intToStr(prio) + ", ptr " + ctorSym + ", ptr null }", cellGet(entriesRev)));
                    cellSet(idx, i + 1);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        let n = cellGet(idx);
        let entries = listRev(cellGet(entriesRev));
        bufPushStr(out, "@llvm.global_ctors = appending global [" + intToStr(n) + " x { i32, ptr, ptr }] [\n  " + strJoin(entries, ",\n  ") + "\n]\n\n")
    },
}

def emitNativeCustomBootFunctions(
    out: StringBuf,
    mctx: ModEmitCtx,
    mainOpt: Option FunDef,
    globals: List GlobalValDef,
    bootSymOpt: Option String,
    useGlobalsOnce: Bool
): Void = {
    let fctx = newFnEmitCtx("__geisha_init");
    let anchor = emitEntryAlloca(fctx, "i64");
    emitLine(fctx, "store i64 0, ptr " + anchor + ", align 8");
    let tokReg = emitAssign(fctx, "call i64 @gc_host_enter(ptr " + anchor + ")");
    if (useGlobalsOnce) {
        emitLine(fctx, "call void @__gs_init_globals_once()")
    } else {
        let cg = cellNew(globals);
        while (match cellGet(cg) { Nil -> false, _ -> true }) {
            match cellGet(cg) {
                Cons(g, r) -> {
                    match strMapGet(mctx.mcGlobalSlots, g.gvName) {
                        Some(slot) -> {
                            emitRegisterGlobalRoots(fctx, g.gvTy, slot.vsPtr);
                            cellSet(fctx.fcPendingLet, None);
                            let initVal = genExpr(mctx, fctx, g.gvInit, Nil, false);
                            emitStore(fctx, slot.vsLlvmTy, initVal, slot.vsPtr)
                        },
                        None -> (),
                    };
                    cellSet(cg, r)
                },
                Nil -> (),
            }
        }
    };
    match mainOpt {
        Some(mainFd) -> {
            let _ = genExpr(mctx, fctx, mainFd.fnBody, Nil, false);
            ()
        },
        None -> (),
    };
    if (!curBlockHasTerm(fctx)) {
        emitLine(fctx, "call void @gc_host_leave(i64 " + tokReg + ")");
        emitTermLine(fctx, "ret void")
    } else ();
    flushFunctionToBuf(out, "define void @__geisha_init() nounwind", fctx);

    match bootSymOpt {
        Some(bsym) ->
            if (strLen(bsym) > 0 && bsym != "__geisha_init") {
                bufPushStr(out, "define void " + llvmSym(bsym) + "() nounwind {\nentry:\n");
                bufPushStr(out, "  call void @__geisha_init()\n");
                bufPushStr(out, "  ret void\n}\n\n")
            } else (),
        None -> (),
    }
}

pub def emitProgramLlvmIrForArchDebug(
    prog: CoreProgram,
    isWasm: Bool,
    targetArch: String,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String,
    debugInfo: Bool
): String = {
    cellSet(gActiveAdtReg, prog.coreAdtReg);
    cellSet(gActiveEscape, Some(prog.coreEscape));
    cellSet(gActivePtrSize, if (isWasm) 4 else 8);
    cellSet(gUnboxMemo, strMapNew());
    let globalSlots: StrMap VarSlot = strMapNew();
    let globalsBuf = bufNew();

    bufPushStr(globalsBuf, "; ModuleID = 'geisha_module'\n");
    bufPushStr(globalsBuf, "source_filename = \"geisha_module\"\n");
    if (isWasm) {
        bufPushStr(globalsBuf, "target datalayout = \"e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-n32:64-S128-ni:1:10:20\"\n");
        bufPushStr(globalsBuf, "target triple = \"wasm32-unknown-unknown\"\n\n")
    } else {
        bufPushByte(globalsBuf, 10)
    };
    bufPushStr(globalsBuf, "@__gs_argc = internal global i32 0\n");
    bufPushStr(globalsBuf, "@__gs_argv = internal global ptr null\n");
    let hasGlobals = match prog.coreGlobals { Nil -> false, _ -> true };
    let useGlobalsOnce = !isWasm && hasGlobals;
    if (useGlobalsOnce) {
        bufPushStr(globalsBuf, "@__gs_globals_init_state = internal global i32 0\n")
    } else ();
    if (!isWasm) {
        bufPushStr(globalsBuf, "@__gs_gc_stw_requested = external global i32\n");
        bufPushStr(globalsBuf, "@__gs_tls_thread = external thread_local global ptr\n");
        bufPushStr(globalsBuf, "declare i64 @llvm.cttz.i64(i64, i1 immarg) nounwind willreturn memory(none)\n");
        bufPushStr(globalsBuf, "define internal noalias nonnull ptr @__gs_tlab_alloc_atomic(i64 %totalBytes, i64 %hdrConst, i64 %byteSz) nounwind {\n");
        bufPushStr(globalsBuf, "entry:\n");
        bufPushStr(globalsBuf, "  %self = load ptr, ptr @__gs_tls_thread, align 8\n");
        bufPushStr(globalsBuf, "  %has_thr = icmp ne ptr %self, null\n");
        bufPushStr(globalsBuf, "  br i1 %has_thr, label %thr, label %slow\n");
        bufPushStr(globalsBuf, "thr:\n");
        bufPushStr(globalsBuf, "  %nurs = load ptr, ptr %self, align 8\n");
        bufPushStr(globalsBuf, "  %has_nurs = icmp ne ptr %nurs, null\n");
        bufPushStr(globalsBuf, "  br i1 %has_nurs, label %nurs_ok, label %slow\n");
        bufPushStr(globalsBuf, "nurs_ok:\n");
        bufPushStr(globalsBuf, "  %cur = load ptr, ptr %nurs, align 8\n");
        bufPushStr(globalsBuf, "  %end_p = getelementptr inbounds i8, ptr %nurs, i64 8\n");
        bufPushStr(globalsBuf, "  %end = load ptr, ptr %end_p, align 8\n");
        bufPushStr(globalsBuf, "  %next = getelementptr inbounds i8, ptr %cur, i64 %totalBytes\n");
        bufPushStr(globalsBuf, "  %fits = icmp ule ptr %next, %end\n");
        bufPushStr(globalsBuf, "  br i1 %fits, label %fast, label %slow\n");
        bufPushStr(globalsBuf, "fast:\n");
        bufPushStr(globalsBuf, "  store ptr %next, ptr %nurs, align 8\n");
        bufPushStr(globalsBuf, "  %cur_i = ptrtoint ptr %cur to i64\n");
        bufPushStr(globalsBuf, "  %off = and i64 %cur_i, 262143\n");
        bufPushStr(globalsBuf, "  %slot = lshr i64 %off, 3\n");
        bufPushStr(globalsBuf, "  %widx = lshr i64 %slot, 6\n");
        bufPushStr(globalsBuf, "  %bpos = and i64 %slot, 63\n");
        bufPushStr(globalsBuf, "  %bit = shl i64 1, %bpos\n");
        bufPushStr(globalsBuf, "  %bmap_base = getelementptr inbounds i8, ptr %nurs, i64 24\n");
        bufPushStr(globalsBuf, "  %bmap_p = getelementptr inbounds i64, ptr %bmap_base, i64 %widx\n");
        bufPushStr(globalsBuf, "  %old_w = load i64, ptr %bmap_p, align 8\n");
        bufPushStr(globalsBuf, "  %new_w = or i64 %old_w, %bit\n");
        bufPushStr(globalsBuf, "  store i64 %new_w, ptr %bmap_p, align 8\n");
        bufPushStr(globalsBuf, "  store i64 %hdrConst, ptr %cur, align 8\n");
        bufPushStr(globalsBuf, "  %res = getelementptr inbounds i8, ptr %cur, i64 8\n");
        bufPushStr(globalsBuf, "  ret ptr %res\n");
        bufPushStr(globalsBuf, "slow:\n");
        bufPushStr(globalsBuf, "  %sres = tail call ptr @gc_alloc_atomic_uninit(i64 %byteSz) cold\n");
        bufPushStr(globalsBuf, "  ret ptr %sres\n");
        bufPushStr(globalsBuf, "}\n");
        bufPushStr(globalsBuf, "define internal noalias nonnull ptr @__gs_tlab_alloc_masked(i64 %totalBytes, i64 %hdrConst, i64 %byteSz, i64 %ptrMask) nounwind {\n");
        bufPushStr(globalsBuf, "entry:\n");
        bufPushStr(globalsBuf, "  %self = load ptr, ptr @__gs_tls_thread, align 8\n");
        bufPushStr(globalsBuf, "  %has_thr = icmp ne ptr %self, null\n");
        bufPushStr(globalsBuf, "  br i1 %has_thr, label %thr, label %slow\n");
        bufPushStr(globalsBuf, "thr:\n");
        bufPushStr(globalsBuf, "  %nurs = load ptr, ptr %self, align 8\n");
        bufPushStr(globalsBuf, "  %has_nurs = icmp ne ptr %nurs, null\n");
        bufPushStr(globalsBuf, "  br i1 %has_nurs, label %nurs_ok, label %slow\n");
        bufPushStr(globalsBuf, "nurs_ok:\n");
        bufPushStr(globalsBuf, "  %cur = load ptr, ptr %nurs, align 8\n");
        bufPushStr(globalsBuf, "  %end_p = getelementptr inbounds i8, ptr %nurs, i64 8\n");
        bufPushStr(globalsBuf, "  %end = load ptr, ptr %end_p, align 8\n");
        bufPushStr(globalsBuf, "  %next = getelementptr inbounds i8, ptr %cur, i64 %totalBytes\n");
        bufPushStr(globalsBuf, "  %fits = icmp ule ptr %next, %end\n");
        bufPushStr(globalsBuf, "  br i1 %fits, label %fast, label %slow\n");
        bufPushStr(globalsBuf, "fast:\n");
        bufPushStr(globalsBuf, "  store ptr %next, ptr %nurs, align 8\n");
        bufPushStr(globalsBuf, "  %cur_i = ptrtoint ptr %cur to i64\n");
        bufPushStr(globalsBuf, "  %off = and i64 %cur_i, 262143\n");
        bufPushStr(globalsBuf, "  %slot = lshr i64 %off, 3\n");
        bufPushStr(globalsBuf, "  %widx = lshr i64 %slot, 6\n");
        bufPushStr(globalsBuf, "  %bpos = and i64 %slot, 63\n");
        bufPushStr(globalsBuf, "  %bit = shl i64 1, %bpos\n");
        bufPushStr(globalsBuf, "  %bmap_base = getelementptr inbounds i8, ptr %nurs, i64 24\n");
        bufPushStr(globalsBuf, "  %bmap_p = getelementptr inbounds i64, ptr %bmap_base, i64 %widx\n");
        bufPushStr(globalsBuf, "  %old_w = load i64, ptr %bmap_p, align 8\n");
        bufPushStr(globalsBuf, "  %new_w = or i64 %old_w, %bit\n");
        bufPushStr(globalsBuf, "  store i64 %new_w, ptr %bmap_p, align 8\n");
        bufPushStr(globalsBuf, "  store i64 %hdrConst, ptr %cur, align 8\n");
        bufPushStr(globalsBuf, "  %res = getelementptr inbounds i8, ptr %cur, i64 8\n");
        bufPushStr(globalsBuf, "  %m0 = icmp ne i64 %ptrMask, 0\n");
        bufPushStr(globalsBuf, "  br i1 %m0, label %zloop, label %zdone\n");
        bufPushStr(globalsBuf, "zloop:\n");
        bufPushStr(globalsBuf, "  %m = phi i64 [ %ptrMask, %fast ], [ %mnext, %zloop ]\n");
        bufPushStr(globalsBuf, "  %tz = call i64 @llvm.cttz.i64(i64 %m, i1 true)\n");
        bufPushStr(globalsBuf, "  %zp = getelementptr inbounds i64, ptr %res, i64 %tz\n");
        bufPushStr(globalsBuf, "  store i64 0, ptr %zp, align 8\n");
        bufPushStr(globalsBuf, "  %m1 = sub i64 %m, 1\n");
        bufPushStr(globalsBuf, "  %mnext = and i64 %m, %m1\n");
        bufPushStr(globalsBuf, "  %more = icmp ne i64 %mnext, 0\n");
        bufPushStr(globalsBuf, "  br i1 %more, label %zloop, label %zdone\n");
        bufPushStr(globalsBuf, "zdone:\n");
        bufPushStr(globalsBuf, "  ret ptr %res\n");
        bufPushStr(globalsBuf, "slow:\n");
        bufPushStr(globalsBuf, "  %sres = tail call ptr @gc_alloc_masked(i64 %byteSz, i64 %ptrMask) cold\n");
        bufPushStr(globalsBuf, "  ret ptr %sres\n");
        bufPushStr(globalsBuf, "}\n")
    } else ();

    let exportMap: StrMap Bool = strMapNew();
    let hasExplicit = match exports { Nil -> false, _ -> true };
    let ce = cellNew(exports);
    while (match cellGet(ce) { Nil -> false, _ -> true }) {
        match cellGet(ce) {
            Cons(en, r) -> {
                strMapInsert(exportMap, en, true);
                cellSet(ce, r)
            },
            Nil -> (),
        }
    };

    let cg = cellNew(prog.coreGlobals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(g, r) -> {
                let rawGName = "__gval_" + g.gvName;
                let gSym = llvmSym(rawGName);
                let valLlvm = getValLlvmType(g.gvTy);
                bufPushStr(globalsBuf, gSym + " = internal global " + valLlvm + " " + llvmZeroValue(valLlvm) + "\n");
                strMapInsert(globalSlots, g.gvName, MkVarSlot {
                    vsPtr: gSym,
                    vsLlvmTy: valLlvm,
                    vsGeishaTy: g.gvTy,
                });
                cellSet(cg, r)
            },
            Nil -> (),
        }
    };
    bufPushByte(globalsBuf, 10);

    let multiLinks = computeMultiExternLinks(prog.coreExterns, prog.coreExternNames);
    let cExportSymMap: StrMap Bool = strMapNew();
    let ccem = cellNew(prog.coreCExports);
    while (match cellGet(ccem) { Nil -> false, _ -> true }) {
        match cellGet(ccem) {
            Cons((_, cSym), r) -> {
                strMapInsert(cExportSymMap, cSym, true);
                cellSet(ccem, r)
            },
            Nil -> (),
        }
    };

    let dbgCwd = if (debugInfo) resolveDbgCwd() else ".";

    let mctx = MkModEmitCtx {
        mcStrCnt: cellNew(0),
        mcStrDecls: bufNew(),
        mcStrPool: strMapNew(),
        mcConstPool: strMapNew(),
        mcConstCnt: cellNew(0),
        mcSynthFns: bufNew(),
        mcSynthSet: strMapNew(),
        mcGlobalSlots: globalSlots,
        mcFns: prog.coreFns,
        mcExterns: prog.coreExterns,
        mcMultiExternLinks: multiLinks,
        mcAdtReg: prog.coreAdtReg,
        mcEscape: prog.coreEscape,
        mcIsWasm: isWasm,
        mcTargetArch: targetArch,
        mcPtrSize: if (isWasm) 4 else 8,
        mcWasmExports: exportMap,
        mcHasExplicitExports: hasExplicit,
        mcCExportSyms: cExportSymMap,
        mcUseGlobalsOnce: useGlobalsOnce,
        mcDebug: debugInfo,
        mcDbgCwd: dbgCwd,
        mcDbgNextId: cellNew(0),
        mcDbgDecls: bufNew(),
        mcDbgCuId: cellNew(-1),
        mcDbgSubTyId: cellNew(-1),
        mcDbgFileIds: strMapNew(),
        mcDbgLexFileIds: strMapNew(),
        mcDbgLocCache: strMapNew(),
        mcDbgTypeCache: strMapNew(),
    };

    if (debugInfo) {
        let primaryFileId = cellNew(1);
        match strMapGet(prog.coreFns, "main") {
            Some(mfd) if (mfd.fnSpan.fileId > 0) -> cellSet(primaryFileId, mfd.fnSpan.fileId),
            _ -> {
                let cfn = cellNew(prog.coreFnNames);
                let found = cellNew(false);
                while (!cellGet(found) && match cellGet(cfn) { Nil -> false, _ -> true }) {
                    match cellGet(cfn) {
                        Cons(nm, r) -> {
                            match strMapGet(prog.coreFns, nm) {
                                Some(fd) if (fd.fnSpan.fileId > 0) -> {
                                    cellSet(primaryFileId, fd.fnSpan.fileId);
                                    cellSet(found, true)
                                },
                                _ -> (),
                            };
                            cellSet(cfn, r)
                        },
                        Nil -> (),
                    }
                }
            },
        };
        dbgInitModule(mctx, cellGet(primaryFileId))
    } else ();

    let fnsBuf = bufNew();
    if (useGlobalsOnce) {
        emitGlobalsInitOnceHelper(fnsBuf, mctx, prog.coreGlobals)
    } else ();
    if (isWasm) {
        emitWasmInitFunction(fnsBuf, mctx, strMapGet(prog.coreFns, "main"), prog.coreGlobals)
    } else if (noMain) {
        emitNativeCustomBootFunctions(fnsBuf, mctx, strMapGet(prog.coreFns, "main"), prog.coreGlobals, bootSymOpt, useGlobalsOnce)
    } else {
        match strMapGet(prog.coreFns, "main") {
            Some(mainFd) -> emitMainFunctions(fnsBuf, mctx, mainFd, prog.coreGlobals, useGlobalsOnce),
            None -> (),
        }
    };

    let cf = cellNew(prog.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnm, r) -> {
                if (fnm != "main") {
                    match strMapGet(prog.coreFns, fnm) {
                        Some(fd) -> emitTopLevelFunction(fnsBuf, mctx, fd),
                        None -> (),
                    }
                } else ();
                cellSet(cf, r)
            },
            Nil -> (),
        }
    };

    // Emit pure C ABI export trampolines (`extern ["sym"] def ... = ...`, no trailing `%fvs`)
    let cce = cellNew(prog.coreCExports);
    while (match cellGet(cce) { Nil -> false, _ -> true }) {
        match cellGet(cce) {
            Cons((fnm, cSym), r) -> {
                match strMapGet(prog.coreFns, fnm) {
                    Some(fd) -> emitCAbiTrampoline(fnsBuf, mctx, fd, cSym, true),
                    None -> (),
                };
                cellSet(cce, r)
            },
            Nil -> (),
        }
    };

    // Emit `extern init` static constructors (`@llvm.global_ctors`)
    emitGlobalCtors(fnsBuf, mctx, prog.coreCtors, useGlobalsOnce);

    let out = bufNew();
    bufPushBuf(out, globalsBuf);
    let declaredSyms: StrMap Bool = strMapNew();
    emitRuntimeDeclares(out, declaredSyms, prog.coreFns, isWasm);
    emitUserExternDeclares(out, declaredSyms, prog.coreFns, prog.coreExterns, prog.coreExternNames, multiLinks, targetArch, if (isWasm) 4 else 8);

    if (bufLen(mctx.mcStrDecls) > 0) {
        bufPushBuf(out, mctx.mcStrDecls);
        bufPushByte(out, 10)
    } else ();

    if (bufLen(mctx.mcSynthFns) > 0) {
        bufPushBuf(out, mctx.mcSynthFns)
    } else ();

    bufPushBuf(out, fnsBuf);
    if (debugInfo) {
        bufPushStr(out, "declare void @llvm.dbg.declare(metadata, metadata, metadata) nounwind readnone speculatable willreturn\n\n");
        let dwVerId = dbgAllocId(mctx);
        let diVerId = dbgAllocId(mctx);
        dbgEmitNode(mctx, dwVerId, "!{i32 7, !\"Dwarf Version\", i32 4}");
        dbgEmitNode(mctx, diVerId, "!{i32 2, !\"Debug Info Version\", i32 3}");
        bufPushStr(out, "!llvm.dbg.cu = !{!" + intToStr(cellGet(mctx.mcDbgCuId)) + "}\n");
        bufPushStr(out, "!llvm.module.flags = !{!" + intToStr(dwVerId) + ", !" + intToStr(diVerId) + "}\n\n");
        bufPushBuf(out, mctx.mcDbgDecls)
    } else ();
    bufToString(out)
}

pub def emitProgramLlvmIrForArch(
    prog: CoreProgram,
    isWasm: Bool,
    targetArch: String,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String
): String =
    emitProgramLlvmIrForArchDebug(prog, isWasm, targetArch, exports, noMain, bootSymOpt, false)

pub def emitProgramLlvmIrOpts(
    prog: CoreProgram,
    isWasm: Bool,
    exports: List String,
    noMain: Bool,
    bootSymOpt: Option String
): String =
    emitProgramLlvmIrForArch(prog, isWasm, if (isWasm) "wasm32" else "arm64", exports, noMain, bootSymOpt)

pub def emitProgramLlvmIrTarget(prog: CoreProgram, isWasm: Bool, wasmExports: List String): String =
    emitProgramLlvmIrOpts(prog, isWasm, wasmExports, false, None)

pub def emitProgramLlvmIr(prog: CoreProgram): String =
    emitProgramLlvmIrTarget(prog, false, Nil)
