// Decentralized Zero-Server Package Manager & Build Driver (`pkg`).
//
// Architecture:
// - `geisha.toml` declarative manifest + optional `geisha.local.toml` local path overrides
// - Git URLs as canonical coordinates + optional static Git index (`$GEISHA_INDEX`)
// - Minimal Version Selection (MVS) reading `git show <ref>:geisha.toml` from bare treeless clones
// - Content-addressed global store (`~/.geisha/cache/p/<name>-<ver>-<sha256_12>/`) & `geisha.lock`

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend, listLen}
use std.str.{
    intToStr, strStartsWith, strEndsWith, strTrim, strSplitChar, strJoin,
    strIndexOfByte, parseInt
}
use std.buf.{bufNew, bufPushByte, bufPushStr, bufToString}
use std.path.{isAbsPath, pathJoin, pathDirname, pathBasename, pathStem}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.sha256.{sha256New, sha256Update, sha256FinishHex, sha256Hex}
use std.codec.{Value, VNull, VBool, VInt, VStr, VArr, VObj}
use std.toml.{parse as tomlParse, stringify as tomlStringify}
use sys.env.{getEnv}
use sys.fs.{fileExists, isDir, mkdirAll, readDir, readFile, writeFile, removeFile, renameFile, removeDirAll}
use sys.io.eprintLn
use sys.proc.{ExitStatus, Exited, Signaled, command, cmdCwd, cmdEnv, run as procRun, spawn as procSpawn, childWait}
use ast.{sortUniqueStrings, listContainsStr, addUniqueStr}
use loader.{PkgSpec, MkPkgSpec}

extern "gs_sys_getpid" def c_getpid(): Int
extern "gs_sys_realpath" def c_realpath(path: String): Ptr
extern "free" def c_free(ptr: Ptr): Void

