// Source-mapped diagnostics (`diag`): compact 1D format built for both Agents and humans.
//
// Example:
//   foo.gsa:2:18: error[type]: expected `Int`, found `String`
//     near: "oops"
//     line 2: let x: Int = "oops";
//     hint: ...

use std.option.{Option, Some, None}
use std.vec.{Vec, vecNew, vecPush, vecLen, vecGetOr, vecSet}
use std.buf.{bufNew, bufPushStr, bufPushByte, bufToString}
use std.str.intToStr
use ast.Span

pub data SourceFile {
    MkSourceFile { sfPath: String, sfContent: String },
}

def gDiagFiles: Cell (Vec SourceFile) = cellNew(vecNew())
def gDiagLineTables: Cell (Vec (Option (Vec Int))) = cellNew(vecNew())

pub def diagReset(): Void = {
    cellSet(gDiagFiles, vecNew());
    cellSet(gDiagLineTables, vecNew())
}

pub def diagRegisterFile(path: String, src: String): Int = {
    let fs = cellGet(gDiagFiles);
    vecPush(fs, MkSourceFile { sfPath: path, sfContent: src });
    vecPush(cellGet(gDiagLineTables), None);
    vecLen(fs)
}

pub def diagGetFile(fileId: Int): Option SourceFile = {
    let fs = cellGet(gDiagFiles);
    if (fileId <= 0 || fileId > vecLen(fs)) None
    else Some(vecGetOr(fs, fileId - 1, MkSourceFile { sfPath: "", sfContent: "" }))
}

pub def diagRegisteredFiles(): Vec SourceFile =
    cellGet(gDiagFiles)

def buildLineStarts(src: String): Vec Int = {
    let starts: Vec Int = vecNew();
    vecPush(starts, 0);
    let n = strLen(src);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let idx = cellGet(i);
        if (strByteAt(src, idx) == 10) {
            vecPush(starts, idx + 1)
        } else ();
        cellSet(i, idx + 1)
    };
    starts
}

def getOrBuildLineStarts(fileId: Int, src: String): Vec Int = {
    let tbls = cellGet(gDiagLineTables);
    let idx = fileId - 1;
    match vecGetOr(tbls, idx, None) {
        Some(v) -> v,
        None -> {
            let v = buildLineStarts(src);
            vecSet(tbls, idx, Some(v));
            v
        },
    }
}

/// Fast O(log L) 1-based `(line, col)` lookup for a `Span` using cached per-file line tables.
/// Returns `(0, 0)` when `sp.fileId` is invalid or unregistered.
pub def diagSpanLineCol(sp: Span): (Int, Int) =
    match diagGetFile(sp.fileId) {
        None -> (0, 0),
        Some(sf) -> {
            let src = sf.sfContent;
            let n = strLen(src);
            let pos = if (sp.start < 0) 0 else if (sp.start > n) n else sp.start;
            let starts = getOrBuildLineStarts(sp.fileId, src);
            let lo = cellNew(0);
            let hi = cellNew(vecLen(starts) - 1);
            while (cellGet(lo) < cellGet(hi)) {
                let mid = (cellGet(lo) + cellGet(hi) + 1) / 2;
                if (vecGetOr(starts, mid, 0) <= pos) cellSet(lo, mid)
                else cellSet(hi, mid - 1)
            };
            let lineIdx = cellGet(lo);
            let lineStart = vecGetOr(starts, lineIdx, 0);
            (lineIdx + 1, (pos - lineStart) + 1)
        },
    }

def shortDiagKind(kind: String): String =
    if (kind == "Type error") "type"
    else if (kind == "Parse error") "syntax"
    else if (kind == "Lex error") "lex"
    else kind

def trimWsSlice(src: String, start: Int, end: Int): String = {
    let s = cellNew(start);
    let e = cellNew(end);
    while (cellGet(s) < cellGet(e) && (strByteAt(src, cellGet(s)) == 32 || strByteAt(src, cellGet(s)) == 9)) {
        cellSet(s, cellGet(s) + 1)
    };
    while (cellGet(e) > cellGet(s) && (strByteAt(src, cellGet(e) - 1) == 32 || strByteAt(src, cellGet(e) - 1) == 9 || strByteAt(src, cellGet(e) - 1) == 13)) {
        cellSet(e, cellGet(e) - 1)
    };
    strSlice(src, cellGet(s), cellGet(e))
}

pub def diagSpanTerm(sp: Span): Option String =
    match diagGetFile(sp.fileId) {
        None -> None,
        Some(sf) -> {
            let src = sf.sfContent;
            let n = strLen(src);
            let s = if (sp.start < 0) 0 else if (sp.start > n) n else sp.start;
            let e = if (sp.end < s) s else if (sp.end > n) n else sp.end;
            if (e <= s) None
            else {
                let raw = trimWsSlice(src, s, e);
                let rn = strLen(raw);
                if (rn == 0) None
                else {
                    let b = bufNew();
                    let i = cellNew(0);
                    let prevSpace = cellNew(false);
                    let outLen = cellNew(0);
                    while (cellGet(i) < rn && cellGet(outLen) < 50) {
                        let ch = strByteAt(raw, cellGet(i));
                        if (ch == 10 || ch == 13 || ch == 9 || ch == 32) {
                            if (!cellGet(prevSpace)) {
                                bufPushByte(b, 32);
                                cellSet(outLen, cellGet(outLen) + 1);
                                cellSet(prevSpace, true)
                            } else ()
                        } else {
                            bufPushByte(b, ch);
                            cellSet(outLen, cellGet(outLen) + 1);
                            cellSet(prevSpace, false)
                        };
                        cellSet(i, cellGet(i) + 1)
                    };
                    if (cellGet(i) < rn) bufPushStr(b, "...") else ();
                    Some(bufToString(b))
                }
            }
        },
    }

def formatDiagInternal(kind: String, fileId: Int, startByte: Int, endByte: Int, msg: String, hintOpt: Option String, showNear: Bool): String = {
    let tag = shortDiagKind(kind);
    let hintSuffix = match hintOpt {
        Some(h) -> "\n  hint: " + h,
        None -> "",
    };
    match diagGetFile(fileId) {
        None -> "error[" + tag + "]: " + msg + hintSuffix,
        Some(sf) -> {
            let src = sf.sfContent;
            let n = strLen(src);
            let pos = if (startByte < 0) 0 else if (startByte > n) n else startByte;

            // Compute 1-based line number and lineStart byte offset
            let line = cellNew(1);
            let lineStart = cellNew(0);
            let i = cellNew(0);
            while (cellGet(i) < pos) {
                let idx = cellGet(i);
                if (strByteAt(src, idx) == 10) {
                    cellSet(line, cellGet(line) + 1);
                    cellSet(lineStart, idx + 1)
                } else ();
                cellSet(i, idx + 1)
            };

            // Find end of current line
            let ls = cellGet(lineStart);
            let le = cellNew(pos);
            while (cellGet(le) < n && strByteAt(src, cellGet(le)) != 10) {
                cellSet(le, cellGet(le) + 1)
            };
            let lineEndRaw = cellGet(le);
            let lineEnd =
                if (lineEndRaw > ls && strByteAt(src, lineEndRaw - 1) == 13) lineEndRaw - 1
                else lineEndRaw;

            let col = (pos - ls) + 1;
            let lineText = trimWsSlice(src, ls, lineEnd);

            let rawEnd = if (endByte > pos) endByte else pos;
            let clampedEnd = if (rawEnd < lineEnd) rawEnd else lineEnd;
            let spanText =
                if (showNear && clampedEnd > pos && clampedEnd - pos <= 80) trimWsSlice(src, pos, clampedEnd)
                else "";

            let lineStr = intToStr(cellGet(line));

            let out = bufNew();
            bufPushStr(out, sf.sfPath);
            bufPushStr(out, ":");
            bufPushStr(out, lineStr);
            bufPushStr(out, ":");
            bufPushStr(out, intToStr(col));
            bufPushStr(out, ": error[");
            bufPushStr(out, tag);
            bufPushStr(out, "]: ");
            bufPushStr(out, msg);
            if (strLen(spanText) > 0 && spanText != lineText) {
                bufPushStr(out, "\n  near: ");
                bufPushStr(out, spanText)
            } else ();
            if (strLen(lineText) > 0) {
                bufPushStr(out, "\n  line ");
                bufPushStr(out, lineStr);
                bufPushStr(out, ": ");
                bufPushStr(out, lineText)
            } else ();
            bufPushStr(out, hintSuffix);
            bufToString(out)
        },
    }
}

pub def formatDiagAtWithHint(kind: String, fileId: Int, startByte: Int, endByte: Int, msg: String, hintOpt: Option String): String =
    formatDiagInternal(kind, fileId, startByte, endByte, msg, hintOpt, true)

pub def formatDiagAt(kind: String, fileId: Int, startByte: Int, endByte: Int, msg: String): String =
    formatDiagInternal(kind, fileId, startByte, endByte, msg, None, true)

pub def formatSpanDiag(kind: String, sp: Span, msg: String): String =
    formatDiagInternal(kind, sp.fileId, sp.start, sp.end, msg, None, true)

pub def formatSpanDiagNoNear(kind: String, sp: Span, msg: String): String =
    formatDiagInternal(kind, sp.fileId, sp.start, sp.end, msg, None, false)

pub def formatSpanDiagHint(kind: String, sp: Span, msg: String, hint: String): String =
    formatDiagInternal(kind, sp.fileId, sp.start, sp.end, msg, Some(hint), true)

pub def isFormattedDiag(s: String): Bool = {
    let n = strLen(s);
    let i = cellNew(0);
    let found = cellNew(false);
    while (cellGet(i) + 6 <= n && !cellGet(found) && strByteAt(s, cellGet(i)) != 10) {
        let p = cellGet(i);
        if (strByteAt(s, p) == 101 && strByteAt(s, p + 1) == 114 && strByteAt(s, p + 2) == 114 && strByteAt(s, p + 3) == 111 && strByteAt(s, p + 4) == 114 && (strByteAt(s, p + 5) == 91 || strByteAt(s, p + 5) == 58)) {
            cellSet(found, true)
        } else ();
        cellSet(i, p + 1)
    };
    cellGet(found)
}
