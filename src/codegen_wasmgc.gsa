// Geisha Core IR -> WebAssembly GC (`.wasm` + companion `.mjs` / `.d.ts`) Backend (`codegen_wasmgc`)
//
// Directly lowers monomorphized, K-converted `CoreProgram` to a standalone WasmGC binary
// with ZERO linear memory and ZERO custom GC runtime:
//   - Records / single-variant ADTs  -> `sub final` WasmGC `struct` (`struct.new` / `struct.get`)
//   - Multi-variant ADTs             -> tagged `sub` base struct + `sub final` variant structs (`ref.test` / `ref.cast`)
//   - Pure unit-variant enums        -> unboxed `i31ref` (`ref.i31` / `i31.get_s`), zero heap allocation
//   - `String`                       -> `array (mut i8)` + passive data segment (`array.new_data` / `array.copy`)
//   - `MutArray a` / `ImmArray a`    -> `array (mut T)` (`array.new` / `array.new_default` / `array.get` / `array.set` / `array.len`)
//   - `Cell a` / `AtomicInt`         -> mutable 1-field `struct (field (mut T))` (`struct.new` / `struct.get` / `struct.set`)
//   - Closures                       -> closure base `struct (field (ref $fn))` + `sub final` env struct + `ref.func` + `call_ref`
//   - `Ptr`/`ScopedPtr`/`ForeignPtr` -> GC-managed `{ buf: array (mut i8), off: i32 }` struct (zero linear memory!)
//   - Tail calls                     -> native Wasm `return_call` / `return_call_ref`

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listLen, listAppend}
use std.vec.{Vec, vecNew, vecPush, vecLen, vecGetOr, vecSet}
use std.map.{StrMap, strMapNew, strMapGet, strMapInsert, strMapContains}
use std.buf.{StringBuf, MkStringBuf, bufNew, bufLen, bufPushStr, bufPushByte, bufPushBuf, bufToString}
use std.str.{intToStr, strJoin, strStartsWith}
use ast.{
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp,
    Scheme, ScmMono, schemeBody,
    Lit, LitInt, LitFloat, LitChar, LitStr, LitBool, LitUnit,
    BinOp, OpAdd, OpSub, OpMul, OpDiv, OpRem, OpAnd, OpOr,
    OpBitAnd, OpBitOr, OpBitXor, OpShl, OpShr, OpUshr,
    OpEq, OpNe, OpLt, OpLe, OpGt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct,
    Span, emptySpan
}
use diag.formatSpanDiag
use infer.{
    VariantInfo, AdtInfo, findVariantByName, applyExplicitSubst, buildPairMap
}
use core.{
    ClosureSpec, TaggedTerm, MkTerm, CoreArm, Term,
    TmLit, TmVar, TmGlobalVar, TmTuple, TmBlock, TmMakeCls, TmApplyCls, TmApplyDir,
    TmBin, TmUn, TmLet, TmIf, TmWhile, TmMatch, TmMakeData, TmGetTag,
    FunDef, GlobalValDef, ExternDef, CoreProgram,
    extractTypeArgs
}

// ============================================================================
// Low-Level Wasm Binary Encoding Helpers
// ============================================================================

def emitUleb(b: StringBuf, n: Int): Void = {
    let v = cellNew(n);
    let more = cellNew(true);
    while (cellGet(more)) {
        let cur = cellGet(v);
        let byte = cur & 127;
        let next = cur >>> 7;
        if (next != 0) {
            bufPushByte(b, byte | 128);
            cellSet(v, next)
        } else {
            bufPushByte(b, byte);
            cellSet(more, false)
        }
    }
}

def emitSleb(b: StringBuf, n: Int): Void = {
    let v = cellNew(n);
    let more = cellNew(true);
    while (cellGet(more)) {
        let cur = cellGet(v);
        let byte = cur & 127;
        let next = cur >> 7;
        if ((next == 0 && (byte & 64) == 0) || (next == -1 && (byte & 64) != 0)) {
            bufPushByte(b, byte);
            cellSet(more, false)
        } else {
            bufPushByte(b, byte | 128);
            cellSet(v, next)
        }
    }
}

def emitSleb64(b: StringBuf, n: Int64): Void = {
    let v = cellNew(n);
    let more = cellNew(true);
    let z64 = intToI64(0);
    let m1_64 = intToI64(-1);
    let mask7 = intToI64(127);
    while (cellGet(more)) {
        let cur = cellGet(v);
        let byte = i64ToInt(bitAnd64(cur, mask7));
        let next = bitShr64(cur, 7);
        if ((next == z64 && (byte & 64) == 0) || (next == m1_64 && (byte & 64) != 0)) {
            bufPushByte(b, byte);
            cellSet(more, false)
        } else {
            bufPushByte(b, byte | 128);
            cellSet(v, next)
        }
    }
}

def emitF32Le(b: StringBuf, f: Float32): Void = {
    let bits = f32ToBits32(f);
    bufPushByte(b, bits & 255);
    bufPushByte(b, (bits >>> 8) & 255);
    bufPushByte(b, (bits >>> 16) & 255);
    bufPushByte(b, (bits >>> 24) & 255)
}

def emitF64Le(b: StringBuf, f: Float): Void = {
    let bits = floatToBits64(f);
    let mask = intToI64(255);
    bufPushByte(b, i64ToInt(bitAnd64(bits, mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 8), mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 16), mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 24), mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 32), mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 40), mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 48), mask)));
    bufPushByte(b, i64ToInt(bitAnd64(bitUshr64(bits, 56), mask)))
}

def emitWasmName(b: StringBuf, s: String): Void = {
    emitUleb(b, strLen(s));
    bufPushStr(b, s)
}

def emitSection(out: StringBuf, secId: Int, body: StringBuf): Void = {
    bufPushByte(out, secId);
    emitUleb(out, bufLen(body));
    bufPushBuf(out, body)
}

// ============================================================================
// WasmGC Type Representation
// ============================================================================

// Pre-allocated core type indices in the single `rec` group:
//   0 = String: array (mut i8)
//   1 = Ptr:    struct (field (mut (ref null 0))) (field (mut i32))
//   2 = CellI32: struct (field (mut i32))
//   3 = ArrI32:  array (mut i32)

data WgcValType {
    WTI32,
    WTI64,
    WTF32,
    WTF64,
    WTI31,
    WTAny,
    WTRefNull(Int),
    WTRef(Int),
}

data WgcStorageType {
    WSVal(WgcValType),
    WSI8,
}

data WgcFieldType {
    MkWgcField { wfTy: WgcStorageType, wfMut: Bool },
}

data WgcTypeDef {
    WTDPlaceholder,
    WTDArray(WgcFieldType),
    WTDStruct(List WgcFieldType),
    WTDSubStruct(Option Int, Bool, List WgcFieldType),
    WTDFunc(List WgcValType, List WgcValType),
}

def valTypeKey(wt: WgcValType): String = match wt {
    WTI32 -> "i32",
    WTI64 -> "i64",
    WTF32 -> "f32",
    WTF64 -> "f64",
    WTI31 -> "i31",
    WTAny -> "any",
    WTRefNull(idx) -> "rn" + intToStr(idx),
    WTRef(idx) -> "r" + intToStr(idx),
}

def valTypeListKey(wts: List WgcValType): String = match wts {
    Nil -> "",
    Cons(h, Nil) -> valTypeKey(h),
    Cons(h, t) -> valTypeKey(h) + "," + valTypeListKey(t),
}

def emitValType(b: StringBuf, wt: WgcValType): Void = match wt {
    WTI32 -> bufPushByte(b, 0x7F),
    WTI64 -> bufPushByte(b, 0x7E),
    WTF32 -> bufPushByte(b, 0x7D),
    WTF64 -> bufPushByte(b, 0x7C),
    WTI31 -> bufPushByte(b, 0x6C),
    WTAny -> bufPushByte(b, 0x6E),
    WTRefNull(idx) -> {
        bufPushByte(b, 0x63);
        emitSleb(b, idx)
    },
    WTRef(idx) -> {
        bufPushByte(b, 0x64);
        emitSleb(b, idx)
    },
}

def emitFieldType(b: StringBuf, f: WgcFieldType): Void = {
    match f.wfTy {
        WSVal(wt) -> emitValType(b, wt),
        WSI8 -> bufPushByte(b, 0x78),
    };
    bufPushByte(b, if (f.wfMut) 1 else 0)
}

def emitFieldList(b: StringBuf, fs: List WgcFieldType): Void = {
    emitUleb(b, listLen(fs));
    let cur = cellNew(fs);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(f, r) -> { emitFieldType(b, f); cellSet(cur, r) },
            Nil -> (),
        }
    }
}

def emitValTypeVec(b: StringBuf, wts: List WgcValType): Void = {
    emitUleb(b, listLen(wts));
    let cur = cellNew(wts);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(wt, r) -> { emitValType(b, wt); cellSet(cur, r) },
            Nil -> (),
        }
    }
}

def emitTypeDef(b: StringBuf, td: WgcTypeDef): Void = match td {
    WTDPlaceholder -> {
        // Should never be emitted; fallback to empty struct
        bufPushByte(b, 0x5F);
        bufPushByte(b, 0x00)
    },
    WTDArray(ft) -> {
        bufPushByte(b, 0x5E);
        emitFieldType(b, ft)
    },
    WTDStruct(fs) -> {
        bufPushByte(b, 0x5F);
        emitFieldList(b, fs)
    },
    WTDSubStruct(supOpt, isFinal, fs) -> {
        bufPushByte(b, if (isFinal) 0x4F else 0x50);
        match supOpt {
            None -> bufPushByte(b, 0x00),
            Some(sup) -> {
                bufPushByte(b, 0x01);
                emitUleb(b, sup)
            },
        };
        bufPushByte(b, 0x5F);
        emitFieldList(b, fs)
    },
    WTDFunc(ps, rs) -> {
        bufPushByte(b, 0x60);
        emitValTypeVec(b, ps);
        emitValTypeVec(b, rs)
    },
}

def emitDefaultVal(b: StringBuf, wt: WgcValType): Void = match wt {
    WTI32 -> { bufPushByte(b, 0x41); bufPushByte(b, 0x00) },
    WTI64 -> { bufPushByte(b, 0x42); bufPushByte(b, 0x00) },
    WTF32 -> { bufPushByte(b, 0x43); emitF32Le(b, floatToF32(0.0)) },
    WTF64 -> { bufPushByte(b, 0x44); emitF64Le(b, 0.0) },
    WTI31 -> { bufPushByte(b, 0xD0); bufPushByte(b, 0x6C) },
    WTAny -> { bufPushByte(b, 0xD0); bufPushByte(b, 0x6E) },
    WTRefNull(idx) -> { bufPushByte(b, 0xD0); emitSleb(b, idx) },
    WTRef(idx) -> { bufPushByte(b, 0xD0); emitSleb(b, idx) },
}

// ============================================================================
// ADT Layout & Module State
// ============================================================================

data WgcAdtLayout {
    WALEnumI31,
    WALSingleStruct(Int, List WgcValType),
    WALMultiAdt(Int, List (Int, Int, List WgcValType)),
}

data WgcImport {
    MkWgcImport { impMod: String, impName: String, impTypeIdx: Int },
}

data WgcDefinedFn {
    MkWgcDefinedFn {
        dfTypeIdx: Int,
        dfBody: Cell StringBuf,
    },
}

data WgcGlobal {
    MkWgcGlobal { glValTy: WgcValType, glMut: Bool },
}

data WgcExport {
    MkWgcExport { expName: String, expFuncIdx: Int },
}

data WgcModule {
    MkWgcModule {
        wmProg: CoreProgram,
        wmTypes: Vec WgcTypeDef,
        wmTypeCache: StrMap Int,
        wmClsCache: StrMap (Int, Int),
        wmAdtLayouts: StrMap WgcAdtLayout,
        wmImports: Vec WgcImport,
        wmImportMap: StrMap Int,
        wmNumImports: Cell Int,
        wmDefinedFns: Vec WgcDefinedFn,
        wmFnIdxMap: StrMap Int,
        wmFnRetVoid: StrMap Bool,
        wmThunkMap: StrMap Int,
        wmHelperMap: StrMap Int,
        wmGlobals: Vec WgcGlobal,
        wmGlobalMap: StrMap Int,
        wmGlobalWts: StrMap WgcValType,
        wmExports: Vec WgcExport,
        wmRefFuncSet: StrMap Bool,
        wmRefFuncList: Vec Int,
        wmDataPool: StringBuf,
        wmStrLitMap: StrMap (Int, Int),
        wmStartFunc: Cell (Option Int),
        wmNeedsStrInterop: Cell Bool,
        wmErr: Cell (Option String),
    },
}

def newWgcModule(prog: CoreProgram): WgcModule = {
    let types: Vec WgcTypeDef = vecNew();
    // 0: TY_STR = array (mut i8)
    vecPush(types, WTDArray(MkWgcField { wfTy: WSI8, wfMut: true }));
    // 1: TY_PTR = struct (field (mut (ref null 0))) (field (mut i32))
    vecPush(types, WTDStruct([
        MkWgcField { wfTy: WSVal(WTRefNull(0)), wfMut: true },
        MkWgcField { wfTy: WSVal(WTI32), wfMut: true },
    ]));
    // 2: TY_CELL_I32 = struct (field (mut i32))
    vecPush(types, WTDStruct([
        MkWgcField { wfTy: WSVal(WTI32), wfMut: true },
    ]));
    // 3: TY_ARR_I32 = array (mut i32)
    vecPush(types, WTDArray(MkWgcField { wfTy: WSVal(WTI32), wfMut: true }));

    let tcache: StrMap Int = strMapNew();
    strMapInsert(tcache, "cell:i32", 2);
    strMapInsert(tcache, "arr:i32", 3);

    MkWgcModule {
        wmProg: prog,
        wmTypes: types,
        wmTypeCache: tcache,
        wmClsCache: strMapNew(),
        wmAdtLayouts: strMapNew(),
        wmImports: vecNew(),
        wmImportMap: strMapNew(),
        wmNumImports: cellNew(0),
        wmDefinedFns: vecNew(),
        wmFnIdxMap: strMapNew(),
        wmFnRetVoid: strMapNew(),
        wmThunkMap: strMapNew(),
        wmHelperMap: strMapNew(),
        wmGlobals: vecNew(),
        wmGlobalMap: strMapNew(),
        wmGlobalWts: strMapNew(),
        wmExports: vecNew(),
        wmRefFuncSet: strMapNew(),
        wmRefFuncList: vecNew(),
        wmDataPool: bufNew(),
        wmStrLitMap: strMapNew(),
        wmStartFunc: cellNew(None),
        wmNeedsStrInterop: cellNew(false),
        wmErr: cellNew(None),
    }
}

def setWgcErr(wm: WgcModule, sp: Span, msg: String): Void = match cellGet(wm.wmErr) {
    Some(_) -> (),
    None -> cellSet(wm.wmErr, Some(formatSpanDiag("codegen", sp, msg))),
}

def addRawType(wm: WgcModule, td: WgcTypeDef): Int = {
    let idx = vecLen(wm.wmTypes);
    vecPush(wm.wmTypes, td);
    idx
}

def internFuncType(wm: WgcModule, params: List WgcValType, results: List WgcValType): Int = {
    let key = "fn:(" + valTypeListKey(params) + ")->(" + valTypeListKey(results) + ")";
    match strMapGet(wm.wmTypeCache, key) {
        Some(idx) -> idx,
        None -> {
            let idx = addRawType(wm, WTDFunc(params, results));
            strMapInsert(wm.wmTypeCache, key, idx);
            idx
        },
    }
}

def internCellType(wm: WgcModule, elemWt: WgcValType): Int = {
    let key = "cell:" + valTypeKey(elemWt);
    match strMapGet(wm.wmTypeCache, key) {
        Some(idx) -> idx,
        None -> {
            let idx = addRawType(wm, WTDStruct([MkWgcField { wfTy: WSVal(elemWt), wfMut: true }]));
            strMapInsert(wm.wmTypeCache, key, idx);
            idx
        },
    }
}

def internArrayType(wm: WgcModule, elemWt: WgcValType): Int = {
    let key = "arr:" + valTypeKey(elemWt);
    match strMapGet(wm.wmTypeCache, key) {
        Some(idx) -> idx,
        None -> {
            let idx = addRawType(wm, WTDArray(MkWgcField { wfTy: WSVal(elemWt), wfMut: true }));
            strMapInsert(wm.wmTypeCache, key, idx);
            idx
        },
    }
}

def mapMutFields(wts: List WgcValType, isMut: Bool): List WgcFieldType = match wts {
    Nil -> Nil,
    Cons(h, t) -> Cons(MkWgcField { wfTy: WSVal(h), wfMut: isMut }, mapMutFields(t, isMut)),
}

def internTupleType(wm: WgcModule, elemWts: List WgcValType): Int = {
    let key = "tup:(" + valTypeListKey(elemWts) + ")";
    match strMapGet(wm.wmTypeCache, key) {
        Some(idx) -> idx,
        None -> {
            let idx = addRawType(wm, WTDStruct(mapMutFields(elemWts, false)));
            strMapInsert(wm.wmTypeCache, key, idx);
            idx
        },
    }
}

def internClsTypes(wm: WgcModule, paramWts: List WgcValType, retWts: List WgcValType): (Int, Int) = {
    let key = "cls:(" + valTypeListKey(paramWts) + ")->(" + valTypeListKey(retWts) + ")";
    match strMapGet(wm.wmClsCache, key) {
        Some(pair) -> pair,
        None -> {
            // Reserve both indices so they mutually reference each other in the rec group!
            let baseIdx = addRawType(wm, WTDPlaceholder);
            let fnIdx = addRawType(wm, WTDPlaceholder);
            let pair = (baseIdx, fnIdx);
            strMapInsert(wm.wmClsCache, key, pair);
            vecSet(wm.wmTypes, baseIdx, WTDSubStruct(None, false, [
                MkWgcField { wfTy: WSVal(WTRef(fnIdx)), wfMut: false },
            ]));
            vecSet(wm.wmTypes, fnIdx, WTDFunc(Cons(WTRefNull(baseIdx), paramWts), retWts));
            pair
        },
    }
}

def internClsEnvType(wm: WgcModule, baseIdx: Int, fnIdx: Int, fvWts: List WgcValType): Int = {
    let key = "clsenv:" + intToStr(baseIdx) + ":" + valTypeListKey(fvWts);
    match strMapGet(wm.wmTypeCache, key) {
        Some(idx) -> idx,
        None -> {
            let fields = Cons(
                MkWgcField { wfTy: WSVal(WTRef(fnIdx)), wfMut: false },
                mapMutFields(fvWts, true)
            );
            let idx = addRawType(wm, WTDSubStruct(Some(baseIdx), true, fields));
            strMapInsert(wm.wmTypeCache, key, idx);
            idx
        },
    }
}

// ============================================================================
// Geisha Type -> WasmGC Type Mapping
// ============================================================================

def isVoidTy(ty: Type): Bool = match ty {
    TyVoid -> true,
    TyCon(n) -> n == "Void",
    _ -> false,
}

def tyConName(ty: Type): String = match ty {
    TyCon(n) -> n,
    TyComp(b, _) -> tyConName(b),
    _ -> "",
}

def substTypeList(ts: List Type, sub: StrMap Type): List Type = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(applyExplicitSubst(h, sub), substTypeList(t, sub)),
}

def adtMangleKey(adtName: String, targs: List Type): String = match targs {
    Nil -> adtName,
    _ -> adtName + "<" + joinTypeKeys(targs) + ">",
}

def joinTypeKeys(ts: List Type): String = match ts {
    Nil -> "",
    Cons(h, Nil) -> ast.typeToString(h),
    Cons(h, t) -> ast.typeToString(h) + "," + joinTypeKeys(t),
}

def allVariantsUnit(vs: List VariantInfo): Bool = match vs {
    Nil -> true,
    Cons(v, r) -> match v.fieldTypes {
        Nil -> allVariantsUnit(r),
        _ -> false,
    },
}

def resolveAdtLayout(wm: WgcModule, adtName: String, targs: List Type): WgcAdtLayout = {
    let key = adtMangleKey(adtName, targs);
    match strMapGet(wm.wmAdtLayouts, key) {
        Some(lay) -> lay,
        None -> match strMapGet(wm.wmProg.coreAdtReg, adtName) {
            None -> WALEnumI31,
            Some(ainfo) -> {
                if (allVariantsUnit(ainfo.variants)) {
                    strMapInsert(wm.wmAdtLayouts, key, WALEnumI31);
                    WALEnumI31
                } else match ainfo.variants {
                    Cons(onlyVar, Nil) -> {
                        // Single-variant record/struct ADT: zero tag field overhead!
                        let styIdx = addRawType(wm, WTDPlaceholder);
                        // Insert placeholder layout first so recursive fields resolve cleanly
                        strMapInsert(wm.wmAdtLayouts, key, WALSingleStruct(styIdx, Nil));
                        let sub = buildPairMap(ainfo.typeParams, targs);
                        let concreteFts = substTypeList(onlyVar.fieldTypes, sub);
                        let fieldWts = mapGeishaTypesToWgc(wm, concreteFts);
                        vecSet(wm.wmTypes, styIdx, WTDSubStruct(None, true, mapMutFields(fieldWts, false)));
                        let lay = WALSingleStruct(styIdx, fieldWts);
                        strMapInsert(wm.wmAdtLayouts, key, lay);
                        lay
                    },
                    _ -> {
                        // Multi-variant ADT with payload: base `sub (struct (field i32))` + `sub final` per variant
                        let baseIdx = addRawType(wm, WTDSubStruct(None, false, [
                            MkWgcField { wfTy: WSVal(WTI32), wfMut: false },
                        ]));
                        // Register base layout early for recursive ADTs (e.g. List, Expr, Json)
                        strMapInsert(wm.wmAdtLayouts, key, WALMultiAdt(baseIdx, Nil));
                        let sub = buildPairMap(ainfo.typeParams, targs);
                        let varsRev = cellNew(Nil);
                        let cv = cellNew(ainfo.variants);
                        while (match cellGet(cv) { Nil -> false, _ -> true }) {
                            match cellGet(cv) {
                                Cons(vi, rv) -> {
                                    let concreteFts = substTypeList(vi.fieldTypes, sub);
                                    let fieldWts = mapGeishaTypesToWgc(wm, concreteFts);
                                    let allFields = Cons(
                                        MkWgcField { wfTy: WSVal(WTI32), wfMut: false },
                                        mapMutFields(fieldWts, false)
                                    );
                                    let varIdx = addRawType(wm, WTDSubStruct(Some(baseIdx), true, allFields));
                                    cellSet(varsRev, Cons((vi.tag, varIdx, fieldWts), cellGet(varsRev)));
                                    cellSet(cv, rv)
                                },
                                Nil -> (),
                            }
                        };
                        let lay = WALMultiAdt(baseIdx, listRev(cellGet(varsRev)));
                        strMapInsert(wm.wmAdtLayouts, key, lay);
                        lay
                    },
                }
            },
        },
    }
}

def mapGeishaTypesToWgc(wm: WgcModule, ts: List Type): List WgcValType = match ts {
    Nil -> Nil,
    Cons(h, t) -> Cons(geishaTypeToWgc(wm, h), mapGeishaTypesToWgc(wm, t)),
}

def geishaTypeToWgc(wm: WgcModule, ty: Type): WgcValType = match ty {
    TyVoid -> WTI32,
    TyVar(_) -> WTI32,
    TyCon(n) ->
        if (n == "Int" || n == "Bool" || n == "Char" || n == "Void") WTI32
        else if (n == "Int64") WTI64
        else if (n == "Float32") WTF32
        else if (n == "Float") WTF64
        else if (n == "String") WTRefNull(0)
        else if (n == "Ptr" || n == "ScopedPtr" || n == "ForeignPtr" || n == "Arena") WTRefNull(1)
        else if (n == "AtomicInt") WTRefNull(2)
        else if (strMapContains(wm.wmProg.coreAdtReg, n)) {
            match resolveAdtLayout(wm, n, Nil) {
                WALEnumI31 -> WTI31,
                WALSingleStruct(sty, _) -> WTRefNull(sty),
                WALMultiAdt(baseIdx, _) -> WTRefNull(baseIdx),
            }
        } else WTAny,
    TyComp(_, _) -> {
        let base = tyConName(ty);
        let targs = extractTypeArgs(ty);
        if (base == "Cell") {
            let elemWt = match targs { Cons(t, _) -> geishaTypeToWgc(wm, t), Nil -> WTI32 };
            WTRefNull(internCellType(wm, elemWt))
        } else if (base == "MutArray" || base == "ImmArray") {
            let elemWt = match targs { Cons(t, _) -> geishaTypeToWgc(wm, t), Nil -> WTI32 };
            WTRefNull(internArrayType(wm, elemWt))
        } else if (strMapContains(wm.wmProg.coreAdtReg, base)) {
            match resolveAdtLayout(wm, base, targs) {
                WALEnumI31 -> WTI31,
                WALSingleStruct(sty, _) -> WTRefNull(sty),
                WALMultiAdt(baseIdx, _) -> WTRefNull(baseIdx),
            }
        } else WTAny
    },
    TyTuple(es) -> WTRefNull(internTupleType(wm, mapGeishaTypesToWgc(wm, es))),
    TyArr(_, ps, r) -> {
        let pWts = mapGeishaTypesToWgc(wm, ps);
        let rWts = geishaRetToWgc(wm, r);
        let (baseIdx, _) = internClsTypes(wm, pWts, rWts);
        WTRefNull(baseIdx)
    },
}

def geishaRetToWgc(wm: WgcModule, ty: Type): List WgcValType =
    if (isVoidTy(ty)) Nil else [geishaTypeToWgc(wm, ty)]

def emitBlockType(wm: WgcModule, code: StringBuf, optWt: Option WgcValType): Void = match optWt {
    None -> bufPushByte(code, 0x40),
    Some(WTI32) -> bufPushByte(code, 0x7F),
    Some(WTI64) -> bufPushByte(code, 0x7E),
    Some(WTF32) -> bufPushByte(code, 0x7D),
    Some(WTF64) -> bufPushByte(code, 0x7C),
    Some(WTI31) -> bufPushByte(code, 0x6C),
    Some(WTAny) -> bufPushByte(code, 0x6E),
    Some(wt) -> {
        let fty = internFuncType(wm, Nil, [wt]);
        emitSleb(code, fty)
    },
}

// ============================================================================
// Function Index, String Data Pool & Declarative ref.func Registration
// ============================================================================

def registerRefFunc(wm: WgcModule, fidx: Int): Void = {
    let k = intToStr(fidx);
    if (!strMapContains(wm.wmRefFuncSet, k)) {
        strMapInsert(wm.wmRefFuncSet, k, true);
        vecPush(wm.wmRefFuncList, fidx)
    } else ()
}

def allocDefinedFn(wm: WgcModule, typeIdx: Int): Int = {
    let fidx = cellGet(wm.wmNumImports) + vecLen(wm.wmDefinedFns);
    vecPush(wm.wmDefinedFns, MkWgcDefinedFn { dfTypeIdx: typeIdx, dfBody: cellNew(bufNew()) });
    fidx
}

def setDefinedFnBody(wm: WgcModule, fidx: Int, body: StringBuf): Void = {
    let defIdx = fidx - cellGet(wm.wmNumImports);
    let df = vecGetOr(wm.wmDefinedFns, defIdx, MkWgcDefinedFn { dfTypeIdx: 0, dfBody: cellNew(bufNew()) });
    cellSet(df.dfBody, body)
}

def internStringLit(wm: WgcModule, s: String): (Int, Int) = match strMapGet(wm.wmStrLitMap, s) {
    Some(pair) -> pair,
    None -> {
        let off = bufLen(wm.wmDataPool);
        let len = strLen(s);
        bufPushStr(wm.wmDataPool, s);
        let pair = (off, len);
        strMapInsert(wm.wmStrLitMap, s, pair);
        pair
    },
}

// ============================================================================
// Host Import Discovery (Phase 1: Only Import What Is Actually Called)
// ============================================================================

def addHostImport(wm: WgcModule, impMod: String, impName: String, params: List WgcValType, results: List WgcValType): Int = {
    let key = impMod + "." + impName;
    match strMapGet(wm.wmImportMap, key) {
        Some(idx) -> idx,
        None -> {
            let fty = internFuncType(wm, params, results);
            let idx = vecLen(wm.wmImports);
            vecPush(wm.wmImports, MkWgcImport { impMod: impMod, impName: impName, impTypeIdx: fty });
            strMapInsert(wm.wmImportMap, key, idx);
            cellSet(wm.wmNumImports, idx + 1);
            idx
        },
    }
}

def scanTermImports(wm: WgcModule, tm: TaggedTerm): Void = match tm.tnode {
    TmLit(_) -> (),
    TmVar(_) -> (),
    TmGlobalVar(_) -> (),
    TmTuple(es) -> scanTermListImports(wm, es),
    TmBlock(es) -> scanTermListImports(wm, es),
    TmMakeCls(_, _, body) -> scanTermImports(wm, body),
    TmApplyCls(c, args) -> {
        scanTermImports(wm, c);
        scanTermListImports(wm, args)
    },
    TmBin(_, l, r) -> {
        scanTermImports(wm, l);
        scanTermImports(wm, r)
    },
    TmUn(_, e) -> scanTermImports(wm, e),
    TmLet(_, v, b) -> {
        scanTermImports(wm, v);
        scanTermImports(wm, b)
    },
    TmIf(c, t, e) -> {
        scanTermImports(wm, c);
        scanTermImports(wm, t);
        scanTermImports(wm, e)
    },
    TmWhile(c, b) -> {
        scanTermImports(wm, c);
        scanTermImports(wm, b)
    },
    TmMatch(s, arms) -> {
        scanTermImports(wm, s);
        let cur = cellNew(arms);
        while (match cellGet(cur) { Nil -> false, _ -> true }) {
            match cellGet(cur) {
                Cons(a, r) -> {
                    match a.caGuard { Some(g) -> scanTermImports(wm, g), None -> () };
                    scanTermImports(wm, a.caBody);
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        }
    },
    TmMakeData(_, _, fs, _, _) -> scanTermListImports(wm, fs),
    TmGetTag(e) -> scanTermImports(wm, e),
    TmApplyDir(vd, args) -> {
        scanTermListImports(wm, args);
        let nm = vd.vname;
        if (nm == "printLn") {
            cellSet(wm.wmNeedsStrInterop, true);
            let _ = addHostImport(wm, "geisha", "print_str", [WTAny], Nil);
            ()
        } else if (nm == "putChar") {
            let _ = addHostImport(wm, "geisha", "put_char", [WTI32], Nil);
            ()
        } else if (nm == "putNumber") {
            let _ = addHostImport(wm, "geisha", "put_i32", [WTI32], Nil);
            ()
        } else if (nm == "putFloat" || nm == "putF32") {
            let _ = addHostImport(wm, "geisha", "put_f64", [WTF64], Nil);
            ()
        } else if (nm == "mathExp" || nm == "mathExpF32") {
            let _ = addHostImport(wm, "geisha", "math_exp", [WTF64], [WTF64]);
            ()
        } else if (nm == "mathLog" || nm == "mathLogF32") {
            let _ = addHostImport(wm, "geisha", "math_log", [WTF64], [WTF64]);
            ()
        } else if (nm == "mathSin" || nm == "mathSinF32") {
            let _ = addHostImport(wm, "geisha", "math_sin", [WTF64], [WTF64]);
            ()
        } else if (nm == "mathCos" || nm == "mathCosF32") {
            let _ = addHostImport(wm, "geisha", "math_cos", [WTF64], [WTF64]);
            ()
        } else if (nm == "mathTanh" || nm == "mathTanhF32") {
            let _ = addHostImport(wm, "geisha", "math_tanh", [WTF64], [WTF64]);
            ()
        } else if (nm == "mathPow" || nm == "mathPowF32") {
            let _ = addHostImport(wm, "geisha", "math_pow", [WTF64, WTF64], [WTF64]);
            ()
        } else {
            match strMapGet(wm.wmProg.coreExterns, nm) {
                Some(ext) -> {
                    let link = ext.extLink;
                    if (link == "strtod") {
                        cellSet(wm.wmNeedsStrInterop, true);
                        let _ = addHostImport(wm, "geisha", "strtod", [WTAny], [WTF64]);
                        ()
                    } else if (link == "gs_fmt_f64") {
                        cellSet(wm.wmNeedsStrInterop, true);
                        let _ = addHostImport(wm, "geisha", "fmt_f64", [WTF64], [WTAny]);
                        ()
                    } else if (link == "gs_sys_time_now_ms") {
                        let _ = addHostImport(wm, "geisha", "time_now_ms", Nil, [WTI64]);
                        ()
                    } else if (link == "gs_sys_time_mono_ms") {
                        let _ = addHostImport(wm, "geisha", "time_mono_ms", Nil, [WTI64]);
                        ()
                    } else if (link == "gs_sys_time_mono_ns") {
                        let _ = addHostImport(wm, "geisha", "time_mono_ns", Nil, [WTI64]);
                        ()
                    } else if (link == "gs_sys_rand_seed") {
                        let _ = addHostImport(wm, "geisha", "rand_seed", Nil, [WTI64]);
                        ()
                    } else if (link == "gs_sys_fd_write" || link == "write") {
                        cellSet(wm.wmNeedsStrInterop, true);
                        let _ = addHostImport(wm, "geisha", "fd_write", [WTI32, WTAny, WTI64], [WTI64]);
                        ()
                    } else if (link == "exit") {
                        let _ = addHostImport(wm, "geisha", "exit", [WTI32], Nil);
                        ()
                    } else ()
                },
                None -> (),
            }
        }
    },
}

def scanTermListImports(wm: WgcModule, es: List TaggedTerm): Void = match es {
    Nil -> (),
    Cons(h, t) -> { scanTermImports(wm, h); scanTermListImports(wm, t) },
}

def discoverImports(wm: WgcModule): Void = {
    let cg = cellNew(wm.wmProg.coreGlobals);
    while (match cellGet(cg) { Nil -> false, _ -> true }) {
        match cellGet(cg) {
            Cons(gv, r) -> { scanTermImports(wm, gv.gvInit); cellSet(cg, r) },
            Nil -> (),
        }
    };
    let cf = cellNew(wm.wmProg.coreFnNames);
    while (match cellGet(cf) { Nil -> false, _ -> true }) {
        match cellGet(cf) {
            Cons(fnm, r) -> {
                match strMapGet(wm.wmProg.coreFns, fnm) {
                    Some(fd) -> scanTermImports(wm, fd.fnBody),
                    None -> (),
                };
                cellSet(cf, r)
            },
            Nil -> (),
        }
    }
}

// ============================================================================
// Lazy Internal WasmGC Runtime Helpers (Zero Linear Memory!)
// ============================================================================

def wrapSimpleBody(extraLocals: List (Int, WgcValType), instrs: StringBuf): StringBuf = {
    let out = bufNew();
    emitUleb(out, listLen(extraLocals));
    let cur = cellNew(extraLocals);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((cnt, wt), r) -> {
                emitUleb(out, cnt);
                emitValType(out, wt);
                cellSet(cur, r)
            },
            Nil -> (),
        }
    };
    bufPushBuf(out, instrs);
    bufPushByte(out, 0x0B);
    out
}

def getOrCreateHelper(wm: WgcModule, name: String): Int = match strMapGet(wm.wmHelperMap, name) {
    Some(idx) -> idx,
    None -> {
        let fidx =
            if (name == "idiv32") {
                let fty = internFuncType(wm, [WTI32, WTI32], [WTI32]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                // if (b == 0) unreachable
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x45);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x00); bufPushByte(c, 0x0B);
                // if (a == INT32_MIN && b == -1) return INT32_MIN
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x41); emitSleb(c, -2147483647 - 1); bufPushByte(c, 0x46);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x41); emitSleb(c, -1); bufPushByte(c, 0x46);
                bufPushByte(c, 0x71);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40);
                bufPushByte(c, 0x41); emitSleb(c, -2147483647 - 1); bufPushByte(c, 0x0F);
                bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 1);
                bufPushByte(c, 0x6D); // i32.div_s
                setDefinedFnBody(wm, id, wrapSimpleBody(Nil, c));
                id
            } else if (name == "irem32") {
                let fty = internFuncType(wm, [WTI32, WTI32], [WTI32]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x45);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x00); bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x41); emitSleb(c, -2147483647 - 1); bufPushByte(c, 0x46);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x41); emitSleb(c, -1); bufPushByte(c, 0x46);
                bufPushByte(c, 0x71);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40);
                bufPushByte(c, 0x41); bufPushByte(c, 0x00); bufPushByte(c, 0x0F);
                bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 1);
                bufPushByte(c, 0x6F); // i32.rem_s
                setDefinedFnBody(wm, id, wrapSimpleBody(Nil, c));
                id
            } else if (name == "idiv64") {
                let fty = internFuncType(wm, [WTI64, WTI64], [WTI64]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                let min64 = bitShl64(intToI64(1), 63);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x50); // i64.eqz
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x00); bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x42); emitSleb64(c, min64); bufPushByte(c, 0x51);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x42); emitSleb64(c, intToI64(-1)); bufPushByte(c, 0x51);
                bufPushByte(c, 0x71);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40);
                bufPushByte(c, 0x42); emitSleb64(c, min64); bufPushByte(c, 0x0F);
                bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 1);
                bufPushByte(c, 0x7F); // i64.div_s
                setDefinedFnBody(wm, id, wrapSimpleBody(Nil, c));
                id
            } else if (name == "irem64") {
                let fty = internFuncType(wm, [WTI64, WTI64], [WTI64]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                let min64 = bitShl64(intToI64(1), 63);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x50);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x00); bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x42); emitSleb64(c, min64); bufPushByte(c, 0x51);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x42); emitSleb64(c, intToI64(-1)); bufPushByte(c, 0x51);
                bufPushByte(c, 0x71);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40);
                bufPushByte(c, 0x42); bufPushByte(c, 0x00); bufPushByte(c, 0x0F);
                bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 1);
                bufPushByte(c, 0x81); // i64.rem_s
                setDefinedFnBody(wm, id, wrapSimpleBody(Nil, c));
                id
            } else if (name == "strConcat") {
                // (a: (ref null 0), b: (ref null 0)) -> (ref null 0)
                // locals: 2 = lenA: i32, 3 = lenB: i32, 4 = out: (ref null 0)
                let fty = internFuncType(wm, [WTRefNull(0), WTRefNull(0)], [WTRefNull(0)]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0xFB); bufPushByte(c, 0x0F); bufPushByte(c, 0x21); emitUleb(c, 2);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0xFB); bufPushByte(c, 0x0F); bufPushByte(c, 0x21); emitUleb(c, 3);
                bufPushByte(c, 0x20); emitUleb(c, 2); bufPushByte(c, 0x20); emitUleb(c, 3); bufPushByte(c, 0x6A);
                bufPushByte(c, 0xFB); bufPushByte(c, 0x07); emitUleb(c, 0); // array.new_default 0
                bufPushByte(c, 0x21); emitUleb(c, 4);
                // array.copy 0 0 (out, 0, a, 0, lenA)
                bufPushByte(c, 0x20); emitUleb(c, 4);
                bufPushByte(c, 0x41); bufPushByte(c, 0x00);
                bufPushByte(c, 0x20); emitUleb(c, 0);
                bufPushByte(c, 0x41); bufPushByte(c, 0x00);
                bufPushByte(c, 0x20); emitUleb(c, 2);
                bufPushByte(c, 0xFB); bufPushByte(c, 0x11); emitUleb(c, 0); emitUleb(c, 0);
                // array.copy 0 0 (out, lenA, b, 0, lenB)
                bufPushByte(c, 0x20); emitUleb(c, 4);
                bufPushByte(c, 0x20); emitUleb(c, 2);
                bufPushByte(c, 0x20); emitUleb(c, 1);
                bufPushByte(c, 0x41); bufPushByte(c, 0x00);
                bufPushByte(c, 0x20); emitUleb(c, 3);
                bufPushByte(c, 0xFB); bufPushByte(c, 0x11); emitUleb(c, 0); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 4);
                setDefinedFnBody(wm, id, wrapSimpleBody([(2, WTI32), (1, WTRefNull(0))], c));
                id
            } else if (name == "strSlice") {
                // (s: (ref null 0), start: i32, end: i32) -> (ref null 0)
                // locals: 3 = len: i32, 4 = out: (ref null 0)
                let fty = internFuncType(wm, [WTRefNull(0), WTI32, WTI32], [WTRefNull(0)]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                bufPushByte(c, 0x20); emitUleb(c, 2); bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x6B); // end - start
                bufPushByte(c, 0x22); emitUleb(c, 3); // local.tee 3
                bufPushByte(c, 0xFB); bufPushByte(c, 0x07); emitUleb(c, 0); // array.new_default 0
                bufPushByte(c, 0x22); emitUleb(c, 4); // local.tee 4
                bufPushByte(c, 0x41); bufPushByte(c, 0x00);
                bufPushByte(c, 0x20); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 1);
                bufPushByte(c, 0x20); emitUleb(c, 3);
                bufPushByte(c, 0xFB); bufPushByte(c, 0x11); emitUleb(c, 0); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 4);
                setDefinedFnBody(wm, id, wrapSimpleBody([(1, WTI32), (1, WTRefNull(0))], c));
                id
            } else if (name == "strEq") {
                // (a: (ref null 0), b: (ref null 0)) -> i32
                // locals: 2 = len: i32, 3 = i: i32
                let fty = internFuncType(wm, [WTRefNull(0), WTRefNull(0)], [WTI32]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                // if (ref.eq a b) return 1
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0xD3);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x41); bufPushByte(c, 0x01); bufPushByte(c, 0x0F); bufPushByte(c, 0x0B);
                // len = array.len a; if (len != array.len b) return 0
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0xFB); bufPushByte(c, 0x0F); bufPushByte(c, 0x22); emitUleb(c, 2);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0xFB); bufPushByte(c, 0x0F); bufPushByte(c, 0x47);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x41); bufPushByte(c, 0x00); bufPushByte(c, 0x0F); bufPushByte(c, 0x0B);
                // loop i < len
                bufPushByte(c, 0x02); bufPushByte(c, 0x40); // block
                bufPushByte(c, 0x03); bufPushByte(c, 0x40); // loop
                bufPushByte(c, 0x20); emitUleb(c, 3); bufPushByte(c, 0x20); emitUleb(c, 2); bufPushByte(c, 0x4E); // i >= len
                bufPushByte(c, 0x0D); emitUleb(c, 1); // br_if block
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x20); emitUleb(c, 3); bufPushByte(c, 0xFB); bufPushByte(c, 0x0D); emitUleb(c, 0);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0x20); emitUleb(c, 3); bufPushByte(c, 0xFB); bufPushByte(c, 0x0D); emitUleb(c, 0);
                bufPushByte(c, 0x47); // ne
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x41); bufPushByte(c, 0x00); bufPushByte(c, 0x0F); bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 3); bufPushByte(c, 0x41); bufPushByte(c, 0x01); bufPushByte(c, 0x6A); bufPushByte(c, 0x21); emitUleb(c, 3);
                bufPushByte(c, 0x0C); emitUleb(c, 0); // br loop
                bufPushByte(c, 0x0B); bufPushByte(c, 0x0B);
                bufPushByte(c, 0x41); bufPushByte(c, 0x01);
                setDefinedFnBody(wm, id, wrapSimpleBody([(2, WTI32)], c));
                id
            } else if (name == "strCmp") {
                // (a: (ref null 0), b: (ref null 0)) -> i32 (-1, 0, 1)
                // locals: 2 = lenA, 3 = lenB, 4 = minLen, 5 = i, 6 = ca, 7 = cb
                let fty = internFuncType(wm, [WTRefNull(0), WTRefNull(0)], [WTI32]);
                let id = allocDefinedFn(wm, fty);
                let c = bufNew();
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0xD3);
                bufPushByte(c, 0x04); bufPushByte(c, 0x40); bufPushByte(c, 0x41); bufPushByte(c, 0x00); bufPushByte(c, 0x0F); bufPushByte(c, 0x0B);
                bufPushByte(c, 0x20); emitUleb(c, 0); bufPushByte(c, 0xFB); bufPushByte(c, 0x0F); bufPushByte(c, 0x21); emitUleb(c, 2);
                bufPushByte(c, 0x20); emitUleb(c, 1); bufPushByte(c, 0xFB); bufPushByte(c, 0x0F); bufPushByte(c, 0x21); emitUleb(c, 3);
                // minLen = lenA < lenB ? lenA : lenB
                bufPushByte(c, 0x20); emitUleb(c, 2); bufPushByte(c, 0x20); emitUleb(c, 3);
                bufPushByte(c, 0x20); emitUleb(c, 2); bufPushByte(c, 0x20); emitUleb(c, 3); bufPushByte(c, 0x48); // lt_s
                bufPushByte(c, 0x1B); // select
                bufPushByte(c, 0x21); emitUleb(c, 4);
                bufPushByte(c, 0x02); bufPushByte(c, 0x40);
                bufPushByte(c, 0x03); bufPushByte(c, 0x40);
