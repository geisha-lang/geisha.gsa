// Self-Hosting Geisha Compiler CLI Driver (`geisha.gsa`)
//
// Usage:
//   geisha [options] <input.gsa>
//
// Options:
//   -e, --emit-llvm        Emit LLVM 20 textual IR (.ll) to stdout (or `-o <file.ll>`)
//   -c, --compile-only     Compile to native object file (`.o`) without linking
//   -o <output>            Output path (executable, `.o`, or `.ll`)
//   --src-root <dir>       Multi-file module root directory
//   --runtime <path.a>     Path to `libgeisha_runtime.a` (or `$GEISHA_RUNTIME`)
//   -h, --help             Print usage help

mod ast
mod lexer
mod parser
mod stdlib_bundle
mod loader
mod infer
mod core
mod core_dump
mod codegen

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.listRev
use std.str.strStartsWith
use std.buf.{bufNew, bufPushStr, bufPushByte, bufToString}
use std.path.{pathStem, pathJoin, pathDirname}
use sys.env.{argCount, argAt, getEnv}
use sys.fs.{readFile, writeFile, removeFile, fileExists}
use sys.io.eprintLn
use sys.proc.{exit, shell}
use loader.{loadSingleSourceProgramWithLibs, loadProjectProgramWithLibs}
use infer.inferProgram
use core.lowerToCore
use core_dump.dumpCoreProgramSExpr
use codegen.{emitProgramLlvmIr, emitProgramLlvmIrTarget}

data CliOpts {
    MkCliOpts {
        optEmitIr: Bool,
        optDumpCore: Option String,
        optCompileOnly: Bool,
        optTarget: String,
        optExports: List String,
        optOutPath: Option String,
        optSrcRoot: Option String,
        optLibPaths: List String,
        optRuntime: Option String,
        optInput: Option String,
        optHelp: Bool,
    },
}

def shellQuote(s: String): String = {
    let b = bufNew();
    bufPushByte(b, 39);
    let n = strLen(s);
    let i = cellNew(0);
    while (cellGet(i) < n) {
        let c = strByteAt(s, cellGet(i));
        if (c == 39) bufPushStr(b, "'\\''")
        else bufPushByte(b, c);
        cellSet(i, cellGet(i) + 1)
    };
    bufPushByte(b, 39);
    bufToString(b)
}

def parseCliArgs(): Result CliOpts String = {
    let emitIr = cellNew(false);
    let dumpCore: Cell (Option String) = cellNew(None);
    let compOnly = cellNew(false);
    let targetCell = cellNew("native");
    let exportsRev: Cell (List String) = cellNew(Nil);
    let outPath: Cell (Option String) = cellNew(None);
    let srcRoot: Cell (Option String) = cellNew(None);
    let libPathsRev: Cell (List String) = cellNew(Nil);
    let rtPath: Cell (Option String) = cellNew(None);
    let inPath: Cell (Option String) = cellNew(None);
    let showHelp = cellNew(false);
    let errOpt: Cell (Option String) = cellNew(None);

    let argc = argCount();
    let i = cellNew(1);
    while (cellGet(i) < argc && match cellGet(errOpt) { None -> true, Some(_) -> false }) {
        let a = argAt(cellGet(i));
        if (a == "-h" || a == "--help") {
            cellSet(showHelp, true);
            cellSet(i, cellGet(i) + 1)
        } else if (a == "-e" || a == "--emit-llvm") {
            cellSet(emitIr, true);
            cellSet(i, cellGet(i) + 1)
        } else if (a == "--dump-core") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing output path after '--dump-core'"))
            } else {
                cellSet(dumpCore, Some(argAt(cellGet(i) + 1)));
                cellSet(i, cellGet(i) + 2)
            }
        } else if (a == "--target") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing target name after '--target' (native | wasm32)"))
            } else {
                let t = argAt(cellGet(i) + 1);
                if (t == "native" || t == "wasm32") {
                    cellSet(targetCell, t);
                    cellSet(i, cellGet(i) + 2)
                } else {
                    cellSet(errOpt, Some("Unsupported target '" + t + "' (expected 'native' or 'wasm32')"))
                }
            }
        } else if (a == "--export") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing function name after '--export'"))
            } else {
                cellSet(exportsRev, Cons(argAt(cellGet(i) + 1), cellGet(exportsRev)));
                cellSet(i, cellGet(i) + 2)
            }
        } else if (a == "-c" || a == "--compile-only") {
            cellSet(compOnly, true);
            cellSet(i, cellGet(i) + 1)
        } else if (a == "-o" || a == "--output") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing argument after '" + a + "'"))
            } else {
                cellSet(outPath, Some(argAt(cellGet(i) + 1)));
                cellSet(i, cellGet(i) + 2)
            }
        } else if (a == "--src-root") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing directory after '--src-root'"))
            } else {
                cellSet(srcRoot, Some(argAt(cellGet(i) + 1)));
                cellSet(i, cellGet(i) + 2)
            }
        } else if (a == "-L" || a == "--lib-path") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing directory after '" + a + "'"))
            } else {
                cellSet(libPathsRev, Cons(argAt(cellGet(i) + 1), cellGet(libPathsRev)));
                cellSet(i, cellGet(i) + 2)
            }
        } else if (strStartsWith(a, "-L") && strLen(a) > 2) {
            cellSet(libPathsRev, Cons(strSlice(a, 2, strLen(a)), cellGet(libPathsRev)));
            cellSet(i, cellGet(i) + 1)
        } else if (a == "--runtime") {
            if (cellGet(i) + 1 >= argc) {
                cellSet(errOpt, Some("Missing archive path after '--runtime'"))
            } else {
                cellSet(rtPath, Some(argAt(cellGet(i) + 1)));
                cellSet(i, cellGet(i) + 2)
            }
        } else if (strLen(a) > 0 && strByteAt(a, 0) == 45) {
            cellSet(errOpt, Some("Unknown option: '" + a + "'"))
        } else {
            cellSet(inPath, Some(a));
            cellSet(i, cellGet(i) + 1)
        }
    };

    match cellGet(errOpt) {
        Some(e) -> Err(e),
        None -> Ok(MkCliOpts {
            optEmitIr: cellGet(emitIr),
            optDumpCore: cellGet(dumpCore),
            optCompileOnly: cellGet(compOnly),
            optTarget: cellGet(targetCell),
            optExports: cellGet(exportsRev),
            optOutPath: cellGet(outPath),
            optSrcRoot: cellGet(srcRoot),
            optLibPaths: listRev(cellGet(libPathsRev)),
            optRuntime: cellGet(rtPath),
            optInput: cellGet(inPath),
            optHelp: cellGet(showHelp),
        }),
    }
}

def resolveWasmRuntimeObj(explicitOpt: Option String): Result String String =
    match explicitOpt {
        Some(p) ->
            if (fileExists(p)) Ok(p)
            else Err("WASM runtime object not found at '" + p + "'"),
        None -> match getEnv("GEISHA_WASM_RUNTIME") {
            Some(envP) ->
                if (fileExists(envP)) Ok(envP)
                else Err("GEISHA_WASM_RUNTIME object not found at '" + envP + "'"),
            None -> {
                let exeDir = pathDirname(argAt(0));
                let cand1 = pathJoin(exeDir, "wasm_rt.o");
                let cand2 = "build/wasm_rt.o";
                let cand3 = pathJoin(pathDirname(exeDir), "build/wasm_rt.o");
                if (fileExists(cand1)) Ok(cand1)
                else if (fileExists(cand2)) Ok(cand2)
                else if (fileExists(cand3)) Ok(cand3)
                else Err("Could not locate wasm_rt.o; run 'make wasm-runtime' or pass --runtime <path>")
            },
        },
    }

def resolveWasmCc(): String =
    match getEnv("WASM_CC") {
        Some(c) -> c,
        None ->
            if (fileExists("/opt/homebrew/opt/llvm@20/bin/clang")) "/opt/homebrew/opt/llvm@20/bin/clang"
            else if (fileExists("/opt/homebrew/opt/llvm/bin/clang")) "/opt/homebrew/opt/llvm/bin/clang"
            else "clang",
    }

def resolveWasmLdFlag(): String =
    match getEnv("WASM_LD") {
        Some(l) -> " -fuse-ld=" + shellQuote(l),
        None ->
            if (fileExists("/opt/homebrew/opt/lld@20/bin/wasm-ld")) " -fuse-ld=/opt/homebrew/opt/lld@20/bin/wasm-ld"
            else if (fileExists("/opt/homebrew/opt/lld/bin/wasm-ld")) " -fuse-ld=/opt/homebrew/opt/lld/bin/wasm-ld"
            else "",
    }

def resolveRuntimeArchive(explicitOpt: Option String): Result String String =
    match explicitOpt {
        Some(p) ->
            if (fileExists(p)) Ok(p)
            else Err("Runtime archive not found at '" + p + "'"),
        None -> match getEnv("GEISHA_RUNTIME") {
            Some(envP) ->
                if (fileExists(envP)) Ok(envP)
                else Err("GEISHA_RUNTIME archive not found at '" + envP + "'"),
            None -> {
                let exeDir = pathDirname(argAt(0));
                let cand1 = pathJoin(exeDir, "libgeisha_runtime.a");
                let cand2 = "build/libgeisha_runtime.a";
                let cand3 = pathJoin(pathDirname(exeDir), "build/libgeisha_runtime.a");
                if (fileExists(cand1)) Ok(cand1)
                else if (fileExists(cand2)) Ok(cand2)
                else if (fileExists(cand3)) Ok(cand3)
                else Err("Could not locate libgeisha_runtime.a; pass --runtime <path> or set GEISHA_RUNTIME")
            },
        },
    }

def compileInputToIr(
    inputFile: String,
    srcRootOpt: Option String,
    libPaths: List String,
    dumpCoreOpt: Option String,
    isWasm: Bool,
    wasmExports: List String
): Result String String = {
    let rawDefs = match srcRootOpt {
        Some(root) -> loadProjectProgramWithLibs(inputFile, root, libPaths)?,
        None -> {
            let src = readFile(inputFile)?;
            loadSingleSourceProgramWithLibs(src, libPaths)?
        },
    };
    let inf = inferProgram(rawDefs)?;
    let coreProg = lowerToCore(inf)?;
    match dumpCoreOpt {
        Some(dumpPath) -> {
            let sexp = dumpCoreProgramSExpr(coreProg)?;
            writeFile(dumpPath, sexp)?
        },
        None -> (),
    };
    Ok(emitProgramLlvmIrTarget(coreProg, isWasm, wasmExports))
}

def printUsage(): Void = {
    printLn("geisha — Self-hosting Geisha compiler (LLVM 20 IR backend)");
    printLn("");
    printLn("Usage: geisha [options] <input.gsa>");
    printLn("");
    printLn("Options:");
    printLn("  -e, --emit-llvm        Emit LLVM 20 textual IR (.ll) to stdout or -o <file.ll>");
    printLn("  --dump-core <file>     Dump Core Geisha S-expression IR (.gscore) for Lean 4 verifier");
    printLn("  --target <t>           Target platform: 'native' (default) or 'wasm32'");
    printLn("  --export <fn>          Export function symbol in wasm32 target (repeatable)");
    printLn("  -c, --compile-only     Compile to object file (.o) without linking");
    printLn("  -o <output>            Write output to <output>");
    printLn("  --src-root <dir>       Multi-file module source root directory");
    printLn("  -L, --lib-path <dir>   External package/library search path (repeatable)");
    printLn("  --runtime <path>       Path to libgeisha_runtime.a or wasm_rt.o");
    printLn("  -h, --help             Show this help message")
}

def runDriver(): Result Void String = {
    let opts = parseCliArgs()?;
    if (opts.optHelp) {
        printUsage();
        Ok(())
    } else {
        let inputFile = match opts.optInput {
            Some(p) -> p,
            None -> returnErr("No input .gsa file specified (run with --help for usage)")?,
        };
        let isWasm = opts.optTarget == "wasm32";
        let llText = compileInputToIr(inputFile, opts.optSrcRoot, opts.optLibPaths, opts.optDumpCore, isWasm, opts.optExports)?;

        if (opts.optEmitIr) {
            match opts.optOutPath {
                Some(outLl) -> writeFile(outLl, llText),
                None -> {
                    printLn(llText);
                    Ok(())
                },
            }
        } else if (isWasm) {
            let wasmCc = resolveWasmCc();
            if (opts.optCompileOnly) {
                let outObj = match opts.optOutPath {
                    Some(p) -> p,
                    None -> pathStem(inputFile) + ".o",
                };
                let tmpLl = outObj + ".tmp.ll";
                writeFile(tmpLl, llText)?;
                let cmd = shellQuote(wasmCc) + " --target=wasm32 -O2 -mbulk-memory -mnontrapping-fptoint -Wno-override-module -nostdlib -x ir -c "
                          + shellQuote(tmpLl) + " -o " + shellQuote(outObj);
                let rc = shell(cmd);
                let _ = removeFile(tmpLl);
                if (rc == 0) Ok(())
                else Err("LLVM wasm32 backend failed while compiling object '" + outObj + "'")
            } else {
                let outWasm = match opts.optOutPath {
                    Some(p) -> p,
                    None -> pathStem(inputFile) + ".wasm",
                };
                let wasmRt = resolveWasmRuntimeObj(opts.optRuntime)?;
                let tmpLl = outWasm + ".tmp.ll";
                writeFile(tmpLl, llText)?;
                let cmd = shellQuote(wasmCc)
                          + " --target=wasm32 -O2 -flto -mbulk-memory -mnontrapping-fptoint -Wno-override-module -nostdlib"
                          + resolveWasmLdFlag() + " -x ir "
                          + shellQuote(tmpLl) + " -x none " + shellQuote(wasmRt)
                          + " -Wl,--no-entry -Wl,--export-dynamic -Wl,--allow-undefined -Wl,--gc-sections -o "
                          + shellQuote(outWasm);
                let rc = shell(cmd);
                let _ = removeFile(tmpLl);
                if (rc == 0) Ok(())
                else Err("LLVM wasm32 backend failed while linking '" + outWasm + "' (ensure lld/wasm-ld is installed)")
            }
        } else if (opts.optCompileOnly) {
            let outObj = match opts.optOutPath {
                Some(p) -> p,
                None -> pathStem(inputFile) + ".o",
            };
            let tmpLl = outObj + ".tmp.ll";
            writeFile(tmpLl, llText)?;
            let ccBin = match getEnv("CC") { Some(c) -> c, None -> "cc" };
            let cmd = "MACOSX_DEPLOYMENT_TARGET=14.0 " + ccBin + " -O2 -Wno-override-module -x ir -c "
                      + shellQuote(tmpLl) + " -o " + shellQuote(outObj);
            let rc = shell(cmd);
            let _ = removeFile(tmpLl);
            if (rc == 0) Ok(())
            else Err("C/LLVM backend failed while compiling object '" + outObj + "'")
        } else {
            let outBin = match opts.optOutPath {
                Some(p) -> p,
                None -> pathStem(inputFile),
            };
            let rtArchive = resolveRuntimeArchive(opts.optRuntime)?;
            let tmpLl = outBin + ".tmp.ll";
            writeFile(tmpLl, llText)?;
            let ccBin = match getEnv("CC") { Some(c) -> c, None -> "cc" };
            let cmd = "MACOSX_DEPLOYMENT_TARGET=14.0 " + ccBin + " -O2 -flto=thin -Wno-override-module -pthread -x ir "
                      + shellQuote(tmpLl) + " -x none " + shellQuote(rtArchive) + " -o " + shellQuote(outBin);
            let rc = shell(cmd);
            let _ = removeFile(tmpLl);
            if (rc == 0) Ok(())
            else Err("C/LLVM backend failed while linking executable '" + outBin + "'")
        }
    }
}

def returnErr(msg: String): Result String String = Err(msg)

def main(): Void = match runDriver() {
    Ok(_) -> (),
    Err(msg) -> {
        eprintLn("Compiling error:\n" + msg);
        exit(1)
    },
}
