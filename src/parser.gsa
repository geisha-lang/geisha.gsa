// Geisha Parser Built on Geisha-Native `parsec` v0.2 (`TokCursor` + `?` + `pratt` + `backtrack`)
// & AST `?` (`ExTry`) Desugarer (`parser`)

use std.option.{Option, Some, None}
use std.result.{Result, Ok, Err}
use std.list.{listRev, listAppend}
use std.vec.{Vec, vecLen, vecGetOr}
use std.str.{intToStr, parseInt, parseFloat}
use std.char.{isUpperByte, isLowerByte}
use ast.{
    Span, MkSpan, emptySpan, unionSpan,
    Visibility, VisPrivate, VisPublic,
    Type, TyVoid, TyVar, TyCon, TyArr, TyTuple, TyComp, composeTypes, ftvOrdered, addUniqueStr,
    ConstraintSpec, MkConstraint,
    Scheme, ScmMono, ScmPoly, ScmPolyConstrained, ScmSlot,
    Lit, LitInt, LitFloat, LitChar, LitStr, LitBool, LitUnit,
    BinOp, OpAnd, OpOr, OpLt, OpGe,
    UnOp, UnNot, UnNeg, UnBitNot,
    VarDecl, MkVarDecl,
    Pattern, PatVar, PatWild, PatLit, PatTuple, PatCtor, PatStruct,
    MatchArm, MkMatchArm,
    Form, MkForm, mkForm,
    Expr, ExLit, ExVar, ExTuple, ExStructInit, ExList, ExBlock, ExApply,
    ExAbs, ExBin, ExUn, ExLet, ExIf, ExWhile, ExMatch, ExField, ExTry,
    ExContract, ExLoopContract, EnsuresClause, MkEnsuresClause, FnContract, MkFnContract, hasFnContract,
    FieldDecl, MkFieldDecl, VariantBody, VarUnit, VarTuple, VarStruct,
    VariantDef, MkVariantDef, MethodDecl, MkMethodDecl, MethodImpl, MkMethodImpl,
    FunDep, MkFunDep,
    Item, ItForm, ItExtern, ItAlias, ItAlg, ItConcept, ItInstance,
    DefAttr, AttrExport, AttrCtor, AttrCStruct,
    Def, MkDef, UseSpec, MkUseSpec, UseItem, UseSingle, UseMulti, UseGlob, UseAlias,
    ModuleItem, ModDef, ModUse, ModSub, ModDecl, FileModule, MkFileModule,
    encodeOpName, isDefinableOp, builtinBinOpFromStr, infixPrecedence, isRightAssocOp
}
use lexer.{
    TokKind, TkIdent, TkInt, TkFloat, TkStr, TkChar, TkSym, TkQuestion,
    TkLParen, TkRParen, TkLBrace, TkRBrace, TkLBracket, TkRBracket,
    TkComma, TkSemi, TkDot,
    TkDef, TkExtern, TkIf, TkElse, TkWhile, TkLet, TkIn, TkType, TkData,
    TkMatch, TkConcept, TkInstance, TkForall, TkPub, TkUse, TkMod, TkOpen, TkAs,
    TkTrue, TkFalse, TkVoid, TkEof,
    Token, MkToken, tokenizeInFile
}
use diag.{formatSpanDiag, formatSpanDiagHint}
use parsec.core.{
    Span as PSpan, ParseFail, ParseError, TokEntry, TokCursor, InfixInfo,
    curAtEnd, curOffset, newTokCursorEof, newTokCursorLazy, parseTokensFile, finishErrorFor,
    fail, failHint, failSpan, between,
    commit, (<|>), backtrack, opt, optOr, peek, hadNewline, spanFrom,
    many1, skipMany, sepBy1, sepEndBy, sepEndBy1, sepEndByUntil,
    prattInfix, prattPostfix,
    peekTok, atTok, atTokIf, peekNthTok, pushToken, bumpTok,
    eatTok, expectTok, matchTok, tok, skipTok
}

type GsCursor = TokCursor TokKind
type GsResult a = Result a ParseFail

pub data Parser {
    MkParser {
        tokens: Vec Token,
        idx: Cell Int,
        pushedSym: Cell (Option Token),
        eofTok: Token,
        pendingItems: Cell (List ModuleItem),
    },
}

def toAstSpan(sp: PSpan): Span =
    MkSpan { fileId: sp.fileId, start: sp.start, end: sp.end }

def toPSpan(sp: Span): PSpan =
    PSpan { fileId: sp.fileId, start: sp.start, end: sp.end }

def curAstSpan(s: GsCursor): Span = match peekTok(s) {
    Some(e) -> toAstSpan(e.span),
    None -> {
        let off = curOffset(s);
        let startSp = spanFrom(s, off);
        MkSpan { fileId: startSp.fileId, start: off, end: off }
    },
}

def describeGsTok(tk: TokKind): String = match tk {
    TkIdent(s) -> "'" + s + "'",
    TkInt(s) -> "integer '" + s + "'",
    TkFloat(s) -> "float '" + s + "'",
    TkStr(_) -> "string literal",
    TkChar(_) -> "character literal",
    TkSym(s) -> "'" + s + "'",
    TkQuestion -> "'?'",
    TkLParen -> "'('",
    TkRParen -> "')'",
    TkLBrace -> "'{'",
    TkRBrace -> "'}'",
    TkLBracket -> "'['",
    TkRBracket -> "']'",
    TkComma -> "','",
    TkSemi -> "';'",
    TkDot -> "'.'",
    TkDef -> "'def'",
    TkExtern -> "'extern'",
    TkIf -> "'if'",
    TkElse -> "'else'",
    TkWhile -> "'while'",
    TkLet -> "'let'",
    TkIn -> "'in'",
    TkType -> "'type'",
    TkData -> "'data'",
    TkMatch -> "'match'",
    TkConcept -> "'concept'",
    TkInstance -> "'instance'",
    TkForall -> "'forall'",
    TkPub -> "'pub'",
    TkUse -> "'use'",
    TkMod -> "'mod'",
    TkOpen -> "'open'",
    TkAs -> "'as'",
    TkTrue -> "'true'",
    TkFalse -> "'false'",
    TkVoid -> "'Void'",
    TkEof -> "end of input",
}

def copyTokensLoop(toks: Vec Token, out: MutArray (TokEntry TokKind), count: Int, idx: Int, dummy: Token): Void =
    if (idx >= count) ()
    else {
        let t = vecGetOr(toks, idx, dummy);
        arraySet(out, idx, TokEntry {
            kind: t.kind,
            span: toPSpan(t.span),
            hadNewline: t.hadNewline,
        });
        copyTokensLoop(toks, out, count, idx + 1, dummy)
    }

def freezeLexTokens(toks: Vec Token): ImmArray (TokEntry TokKind) = {
    let rawLen = vecLen(toks);
    // `lexer.tokenizeInFile` appends a sentinel `TkEof` at `rawLen - 1`
    let count =
        if (rawLen > 0) {
            let last = vecGetOr(toks, rawLen - 1, MkToken { kind: TkEof, span: emptySpan(), hadNewline: true });
            match last.kind {
                TkEof -> rawLen - 1,
                _ -> rawLen,
            }
        } else 0;
    if (count <= 0) {
        arrayFreeze(arrayNewZeroed(0))
    } else {
        let dummy = MkToken { kind: TkEof, span: emptySpan(), hadNewline: true };
        let t0 = vecGetOr(toks, 0, dummy);
        let arr = arrayNew(count, TokEntry { kind: t0.kind, span: toPSpan(t0.span), hadNewline: t0.hadNewline });
        copyTokensLoop(toks, arr, count, 1, dummy);
        arrayFreeze(arr)
    }
}

def formatParseErrorDiag(pe: ParseError): String = {
    let sp = MkSpan { fileId: pe.fileId, start: pe.offset, end: pe.endOffset };
    let msg =
        if (strLen(pe.expected) > 0 && strByteAt(pe.expected, 0) == 33)
            ptrSliceFromStr(pe.expected, 1, strLen(pe.expected) - 1)
        else
            "expected " + pe.expected + ", found " + pe.found;
    if (strLen(pe.hint) > 0) formatSpanDiagHint("Parse error", sp, msg, pe.hint)
    else formatSpanDiag("Parse error", sp, msg)
}

def failMsg(s: GsCursor, msg: String): GsResult a =
    fail("!" + msg)(s)

def failMsgHint(s: GsCursor, msg: String, hint: String): GsResult a =
    failHint("!" + msg, hint)(s)

def failSpanMsg(s: GsCursor, sp: Span, msg: String): GsResult a = {
    commit(s);
    failSpan(s, toPSpan(sp), "!" + msg, "")
}

def failSpanMsgHint(s: GsCursor, sp: Span, msg: String, hint: String): GsResult a = {
    commit(s);
    failSpan(s, toPSpan(sp), "!" + msg, hint)
}

pub def newParser(toks: Vec Token): Parser = {
    let dummy = MkToken { kind: TkEof, span: emptySpan(), hadNewline: true };
    let rawLen = vecLen(toks);
    let eofTok = if (rawLen > 0) vecGetOr(toks, rawLen - 1, dummy) else dummy;
    MkParser {
        tokens: toks,
        idx: cellNew(0),
        pushedSym: cellNew(None),
        eofTok: eofTok,
        pendingItems: cellNew(Nil),
    }
}

def makeCompatCursor(p: Parser): GsCursor = {
    let rawLen = vecLen(p.tokens);
    let fallbackEof = p.eofTok;
    let lastTok = if (rawLen > 0) vecGetOr(p.tokens, rawLen - 1, fallbackEof) else fallbackEof;
    let count =
        if (rawLen > 0) {
            match lastTok.kind {
                TkEof -> rawLen - 1,
                _ -> rawLen,
            }
        } else 0;
    let firstTok = if (rawLen > 0) vecGetOr(p.tokens, 0, lastTok) else lastTok;
    let fileId = firstTok.span.fileId;
    let eofOff =
        if (lastTok.span.end >= fallbackEof.span.end) lastTok.span.end
        else fallbackEof.span.end;
    let fetchOne = (i: Int) -> {
        let lt = vecGetOr(p.tokens, i, fallbackEof);
        TokEntry {
            kind: lt.kind,
            span: toPSpan(lt.span),
            hadNewline: lt.hadNewline,
        }
    };
    let cur = newTokCursorLazy("", count, eofOff, fetchOne, "<parser>", fileId, describeGsTok);
    let rawIdx = cellGet(p.idx);
    let clampedIdx = if (rawIdx < 0) 0 else if (rawIdx > count) count else rawIdx;
    cellSet(cur.idx, clampedIdx);
    if (clampedIdx > 0 && clampedIdx <= count) {
        let prevLt = vecGetOr(p.tokens, clampedIdx - 1, fallbackEof);
        cellSet(cur.lastEnd, prevLt.span.end)
    } else ();
    match cellGet(p.pushedSym) {
        Some(pt) -> pushToken(cur, TokEntry {
            kind: pt.kind,
            span: toPSpan(pt.span),
            hadNewline: pt.hadNewline,
        }),
        None -> (),
    };
    cur
}

def syncCompatParser(p: Parser, cur: GsCursor): Void = {
    cellSet(p.idx, cellGet(cur.idx));
    match cellGet(cur.pushed) {
        Cons(pe, _) -> cellSet(p.pushedSym, Some(MkToken {
            kind: pe.kind,
            span: toAstSpan(pe.span),
            hadNewline: pe.hadNewline,
        })),
        Nil -> cellSet(p.pushedSym, None),
    }
}

def runCompatParser(p: Parser, f: GsCursor -> GsResult a): Result a String = {
    let cur = makeCompatCursor(p);
    let res = f(cur);
    syncCompatParser(p, cur);
    match res {
        Ok(v) -> Ok(v),
        Err(_) -> Err(formatParseErrorDiag(finishErrorFor(cur))),
    }
}

// ============================================================================
// Lexical Helpers & Strict 32-Bit Numeric Literals
// ============================================================================

def hexDigitVal(b: Int): Int =
    if (b >= 48 && b <= 57) b - 48
    else if (b >= 65 && b <= 70) b - 55
    else if (b >= 97 && b <= 102) b - 87
    else -1

def isRadixIntRaw(raw: String): Bool =
    if (strLen(raw) >= 3 && strByteAt(raw, 0) == 48) {
        let b1 = strByteAt(raw, 1);
        b1 == 120 || b1 == 111 || b1 == 98
    } else false

def scanRadixLoop(raw: String, n: Int, radix: Int, rad64: Int64, limit: Int64, i: Int, acc: Int64): Option Int64 =
    if (i >= n) Some(acc)
    else {
        let dv = hexDigitVal(strByteAt(raw, i));
        let next = acc * rad64 + intToI64(dv);
        if (dv < 0 || dv >= radix || next > limit) None
        else scanRadixLoop(raw, n, radix, rad64, limit, i + 1, next)
    }

def parseStrictIntTok(s: GsCursor, raw: String, neg: Bool, sp: Span): GsResult Int =
    if (isRadixIntRaw(raw)) {
        let b1 = strByteAt(raw, 1);
        let radix = if (b1 == 120) 16 else if (b1 == 111) 8 else 2;
        let maxU32 = (intToI64(65535) << 16) | intToI64(65535);
        let maxNegMag = intToI64(1) << 31;
        let limit = if (neg) maxNegMag else maxU32;
        match scanRadixLoop(raw, strLen(raw), radix, intToI64(radix), limit, 2, intToI64(0)) {
            None -> {
                let disp = if (neg) "-" + raw else raw;
                failSpanMsg(s, sp, "integer literal '" + disp + "' out of 32-bit Int range")
            },
            Some(v64) ->
                if (neg) Ok(i64ToInt(intToI64(0) - v64))
                else Ok(i64ToInt(v64)),
        }
    } else {
        let full = if (neg) "-" + raw else raw;
        match parseInt(full) {
            Ok(n) -> Ok(n),
            Err(_) -> failSpanMsgHint(
                s,
                sp,
                "integer literal '" + full + "' out of 32-bit Int range (-2147483648..2147483647)",
                "append '.0' for Float, or parse via std.str.parseInt64 for 64-bit integers"
            ),
        }
    }

def parseFloatTok(s: GsCursor, raw: String, sp: Span): GsResult Float =
    match parseFloat(raw) {
        Ok(f) -> Ok(f),
        Err(msg) -> failSpanMsg(s, sp, msg),
    }

def skipSemis(s: GsCursor): GsResult Void =
    skipMany(skipTok(TkSemi))(s)

def tryEatSym(s: GsCursor, target: String): Bool =
    if (atTok(s, TkSym(target))) {
        let _ = bumpTok(s);
        true
    } else false

def tryEatTok(s: GsCursor, target: TokKind): Bool =
    if (atTok(s, target)) {
        let _ = bumpTok(s);
        true
    } else false

def eatSym(s: GsCursor, target: String): GsResult Span = {
    let sp = eatTok(s, TkSym(target))?;
    Ok(toAstSpan(sp))
}

def asIdent(tk: TokKind): Option String = match tk {
    TkIdent(id) -> Some(id),
    _ -> None,
}

def asLowerIdent(tk: TokKind): Option String = match tk {
    TkIdent(id) -> {
        let b0 = strByteAt(id, 0);
        if ((isLowerByte(b0) || b0 == 95) && id != "_") Some(id) else None
    },
    _ -> None,
}

def asTypeVarIdent(tk: TokKind): Option String = match tk {
    TkIdent(id) -> if (isLowerByte(strByteAt(id, 0))) Some(id) else None,
    _ -> None,
}

def asUpperIdent(tk: TokKind): Option String = match tk {
    TkIdent(id) -> if (isUpperByte(strByteAt(id, 0))) Some(id) else None,
    _ -> None,
}

def parseIdent(s: GsCursor): GsResult String = {
    let (_, id) = matchTok(s, asIdent, "identifier")?;
    Ok(id)
}

def parseIdentSpan(s: GsCursor): GsResult (Span, String) = {
    let (sp, id) = matchTok(s, asIdent, "identifier")?;
    Ok((toAstSpan(sp), id))
}

def parseLowerIdent(s: GsCursor): GsResult String = {
    let (_, id) = matchTok(s, asLowerIdent, "lowercase identifier")?;
    Ok(id)
}

def parseTypeVarIdent(s: GsCursor): GsResult String = {
    let (_, id) = matchTok(s, asTypeVarIdent, "type variable")?;
    Ok(id)
}

def parseUpperIdent(s: GsCursor): GsResult String = {
    let (_, id) = matchTok(s, asUpperIdent, "uppercase name")?;
    Ok(id)
}

def parseParenOpName(s: GsCursor): GsResult String = {
    let _ = eatTok(s, TkLParen)?;
    let (opSp, sym) = matchTok(s, (tk) -> match tk { TkSym(op) -> Some(op), _ -> None }, "operator")?;
    if (!isDefinableOp(sym)) {
        failSpanMsg(s, toAstSpan(opSp), "reserved symbol '" + sym + "' cannot be defined as an operator")
    } else {
        let _ = eatTok(s, TkRParen)?;
        Ok(encodeOpName(sym))
    }
}

def parseCallableIdent(s: GsCursor): GsResult String =
    if (atTok(s, TkLParen)) parseParenOpName(s)
    else parseIdent(s)

// ============================================================================
// Layer 1: Type, Constraint, FunDep & Scheme Grammar
// ============================================================================

def addFtvsFromTypes(ts: List Type, acc: List String): List String = match ts {
    Nil -> acc,
    Cons(ta, rest) -> {
        let nextAcc = addStringsUnique(ftvOrdered(ta), acc);
        addFtvsFromTypes(rest, nextAcc)
    },
}

def addStringsUnique(xs: List String, acc: List String): List String = match xs {
    Nil -> acc,
    Cons(x, rest) -> addStringsUnique(rest, addUniqueStr(acc, x)),
}

def addFtvsFromConstraints(cs: List ConstraintSpec, acc: List String): List String = match cs {
    Nil -> acc,
    Cons(c, rest) -> addFtvsFromConstraints(rest, addFtvsFromTypes(c.typeArgs, acc)),
}

def buildConstrainedScheme(explicitVars: List String, cs: List ConstraintSpec, body: Type): Scheme = {
    let v1 = addStringsUnique(explicitVars, Nil);
    let v2 = addFtvsFromConstraints(cs, v1);
    let binders = addStringsUnique(ftvOrdered(body), v2);
    match cs {
        Nil -> match binders {
            Nil -> ScmMono(body),
            _ -> ScmPoly(binders, body),
        },
        _ -> ScmPolyConstrained(binders, cs, body),
    }
}

def canStartTypeAtomInline(s: GsCursor): Bool =
    if (hadNewline(s)) false
    else atTokIf(s, (tk) -> match tk {
        TkLParen -> true,
        TkVoid -> true,
        TkIdent(id) -> id != "_",
        _ -> false,
    })

def parseInlineTypeAtoms(s: GsCursor, accRev: List Type): GsResult (List Type) =
    if (!canStartTypeAtomInline(s)) Ok(listRev(accRev))
    else {
        let a = parseTypeAtom(s)?;
        parseInlineTypeAtoms(s, Cons(a, accRev))
    }

def parseTypeConstraint(s: GsCursor): GsResult ConstraintSpec = {
    let cname = parseUpperIdent(s)?;
    let a0 = parseTypeAtom(s)?;
    let args = parseInlineTypeAtoms(s, [a0])?;
    Ok(MkConstraint { conceptName: cname, typeArgs: args })
}

def parseConstraintPrefix(s: GsCursor): GsResult (List ConstraintSpec) =
    if (atTok(s, TkLParen)) {
        let cs = between(tok(TkLParen), tok(TkRParen), sepEndBy1(parseTypeConstraint, skipTok(TkComma)))(s)?;
        let _ = eatSym(s, "=>")?;
        Ok(cs)
    } else {
        let c = parseTypeConstraint(s)?;
        let _ = eatSym(s, "=>")?;
        Ok([c])
    }

def parseConceptSupersClause(s: GsCursor): GsResult (List ConstraintSpec) =
    if (tryEatSym(s, ":")) {
        commit(s);
        if (atTok(s, TkLParen))
            between(tok(TkLParen), tok(TkRParen), sepEndBy1(parseTypeConstraint, skipTok(TkComma)))(s)
        else {
            let c = parseTypeConstraint(s)?;
            Ok([c])
        }
    } else optOr(backtrack(parseConstraintPrefix), Nil)(s)

def parseInlineLowerIdents(s: GsCursor, accRev: List String): GsResult (List String) =
    if (hadNewline(s) || !atTokIf(s, (tk) -> match asTypeVarIdent(tk) { Some(_) -> true, None -> false }))
        Ok(listRev(accRev))
    else {
        let v = parseTypeVarIdent(s)?;
        parseInlineLowerIdents(s, Cons(v, accRev))
    }

def parseFunDep(s: GsCursor): GsResult FunDep = {
    let v0 = parseTypeVarIdent(s)?;
    let lhs = parseInlineLowerIdents(s, [v0])?;
    let _ = eatSym(s, "->")?;
    let r0 = parseTypeVarIdent(s)?;
    let rhs = parseInlineLowerIdents(s, [r0])?;
    Ok(MkFunDep { fdLhs: lhs, fdRhs: rhs })
}

def parseFunDepsClause(s: GsCursor): GsResult (List FunDep) =
    if (!tryEatSym(s, "|")) Ok(Nil)
    else {
        commit(s);
        sepBy1(parseFunDep, skipTok(TkComma))(s)
    }

def parseQualifiedTypeTail(s: GsCursor, prefix: String): GsResult String =
    if (!tryEatTok(s, TkDot)) Ok(prefix)
    else {
        commit(s);
        let seg = parseIdent(s)?;
        parseQualifiedTypeTail(s, prefix + "." + seg)
    }

def parseTypeAtom(s: GsCursor): GsResult Type =
    if (tryEatTok(s, TkVoid)) Ok(TyVoid)
    else if (atTok(s, TkLParen)) {
        let _ = eatTok(s, TkLParen)?;
        commit(s);
        if (tryEatTok(s, TkRParen)) Ok(TyVoid)
        else {
            let first = parseTypeExprCur(s)?;
            if (tryEatTok(s, TkComma)) {
                let (rest, _) = sepEndByUntil(parseTypeExprCur, skipTok(TkComma), tok(TkRParen))(s)?;
                Ok(TyTuple(Cons(first, rest)))
            } else {
                let _ = eatTok(s, TkRParen)?;
                Ok(first)
            }
        }
    } else if (atTokIf(s, (tk) -> match asIdent(tk) { Some(_) -> true, None -> false })) {
        let id = parseIdent(s)?;
        if (isUpperByte(strByteAt(id, 0))) Ok(TyCon(id))
        else if (isLowerByte(strByteAt(id, 0))) {
            if (atTok(s, TkDot)) {
                let full = parseQualifiedTypeTail(s, id)?;
                Ok(TyCon(full))
            } else Ok(TyVar(id))
        } else failMsg(s, "invalid type identifier '" + id + "'")
    } else fail("type")(s)

def finishTypeTailFromHead(s: GsCursor, head: Type): GsResult Type = {
    let lhs =
        if (canStartTypeAtomInline(s)) {
            let all = parseInlineTypeAtoms(s, [head])?;
            composeTypes(all)
        } else head;
    if (tryEatSym(s, "->")) {
        commit(s);
        let rhs = parseTypeExprCur(s)?;
        let params = match lhs {
            TyVoid -> Nil,
            _ -> [lhs],
        };
        Ok(TyArr(TyVoid, params, rhs))
    } else Ok(lhs)
}

def parseSingleOrBType(s: GsCursor): GsResult Type = {
    let first = parseTypeAtom(s)?;
    finishTypeTailFromHead(s, first)
}

// Single-pass `O(n)` parenthesized & arrow type parser (parses `(` ... `)` contents once
// and inspects trailing `->` without exponential backtracking on nested `((((Int))))`).
def parseTypeExprCur(s: GsCursor): GsResult Type =
    if (!atTok(s, TkLParen)) parseSingleOrBType(s)
    else {
        let _ = eatTok(s, TkLParen)?;
        commit(s);
        if (tryEatTok(s, TkRParen)) {
            if (tryEatSym(s, "->")) {
                commit(s);
                let rhs = parseTypeExprCur(s)?;
                Ok(TyArr(TyVoid, Nil, rhs))
            } else finishTypeTailFromHead(s, TyVoid)
        } else {
            let first = parseTypeExprCur(s)?;
            if (tryEatTok(s, TkComma)) {
                let (rest, _) = sepEndByUntil(parseTypeExprCur, skipTok(TkComma), tok(TkRParen))(s)?;
                let elems = Cons(first, rest);
                if (tryEatSym(s, "->")) {
                    commit(s);
                    let rhs = parseTypeExprCur(s)?;
                    Ok(TyArr(TyVoid, elems, rhs))
                } else finishTypeTailFromHead(s, TyTuple(elems))
            } else {
                let _ = eatTok(s, TkRParen)?;
                if (tryEatSym(s, "->")) {
                    commit(s);
                    let rhs = parseTypeExprCur(s)?;
                    Ok(TyArr(TyVoid, [first], rhs))
                } else finishTypeTailFromHead(s, first)
            }
        }
    }

def parseTypeSchemeCur(s: GsCursor): GsResult Scheme =
    if (tryEatTok(s, TkForall)) {
        commit(s);
        if (atTok(s, TkLParen)) {
            let cs = between(tok(TkLParen), tok(TkRParen), sepEndBy1(parseTypeConstraint, skipTok(TkComma)))(s)?;
            let _ = eatTok(s, TkDot)?;
            let body = parseTypeExprCur(s)?;
            Ok(buildConstrainedScheme(Nil, cs, body))
        } else {
            let rawVars = many1(parseTypeVarIdent)(s)?;
            let vs = addStringsUnique(rawVars, Nil);
            let _ = eatTok(s, TkDot)?;
            let csOpt = opt(backtrack(parseConstraintPrefix))(s)?;
            let body = parseTypeExprCur(s)?;
            match csOpt {
                Some(cs) -> Ok(buildConstrainedScheme(vs, cs, body)),
                None -> Ok(ScmPoly(vs, body)),
            }
        }
    } else {
        let csOpt = opt(backtrack(parseConstraintPrefix))(s)?;
        let body = parseTypeExprCur(s)?;
        match csOpt {
            Some(cs) -> Ok(buildConstrainedScheme(Nil, cs, body)),
            None -> Ok(ScmMono(body)),
        }
    }

pub def parseTypeSchemeFromStr(src: String): Scheme = match tokenizeInFile(src, 0) {
    Err(_) -> ScmMono(TyVoid),
    Ok(toks) -> {
        let frozen = freezeLexTokens(toks);
        let cur = newTokCursorEof(src, frozen, strLen(src), "<scheme>", 0, describeGsTok);
        match parseTypeSchemeCur(cur) {
            Ok(scm) -> scm,
            Err(_) -> ScmMono(TyVoid),
        }
    },
}

// ============================================================================
// Layer 2: Pattern Grammar
// ============================================================================

def parseStructPatField(s: GsCursor): GsResult (String, Pattern, Span, Bool) = {
    let fSp = curAstSpan(s);
    let fname = parseLowerIdent(s)?;
    if (tryEatSym(s, ":")) {
        commit(s);
        let sub = parsePatternCur(s)?;
        Ok((fname, sub, fSp, false))
    } else Ok((fname, PatVar(fname, fSp), fSp, true))
}

def parsePatternCur(s: GsCursor): GsResult Pattern = match peekTok(s) {
    None -> fail("pattern")(s),
    Some(e) -> match e.kind {
        TkIdent(name) -> {
            let _ = bumpTok(s)?;
            if (name == "_") Ok(PatWild)
            else if (isUpperByte(strByteAt(name, 0))) {
                if (atTok(s, TkLBrace)) {
                    let _ = eatTok(s, TkLBrace)?;
                    commit(s);
                    let (fs, _) = sepEndByUntil(parseStructPatField, skipTok(TkComma), tok(TkRBrace))(s)?;
                    Ok(PatStruct(name, fs))
                } else if (atTok(s, TkLParen)) {
                    let _ = eatTok(s, TkLParen)?;
                    commit(s);
                    let (args, _) = sepEndByUntil(parsePatternCur, skipTok(TkComma), tok(TkRParen))(s)?;
                    Ok(PatCtor(name, args))
                } else Ok(PatCtor(name, Nil))
            } else Ok(PatVar(name, toAstSpan(e.span)))
        },
        TkLParen -> {
            let _ = bumpTok(s)?;
            commit(s);
            if (tryEatTok(s, TkRParen)) Ok(PatLit(LitUnit))
            else {
                let first = parsePatternCur(s)?;
                if (tryEatTok(s, TkComma)) {
                    let (rest, _) = sepEndByUntil(parsePatternCur, skipTok(TkComma), tok(TkRParen))(s)?;
                    Ok(PatTuple(Cons(first, rest)))
                } else {
                    let _ = eatTok(s, TkRParen)?;
                    Ok(first)
                }
            }
        },
        TkTrue -> { let _ = bumpTok(s)?; Ok(PatLit(LitBool(true))) },
        TkFalse -> { let _ = bumpTok(s)?; Ok(PatLit(LitBool(false))) },
        TkChar(c) -> { let _ = bumpTok(s)?; Ok(PatLit(LitChar(c))) },
        TkStr(str) -> { let _ = bumpTok(s)?; Ok(PatLit(LitStr(str))) },
        TkInt(raw) -> {
            let _ = bumpTok(s)?;
            let n = parseStrictIntTok(s, raw, false, toAstSpan(e.span))?;
            Ok(PatLit(LitInt(n)))
        },
        TkFloat(raw) -> {
            let _ = bumpTok(s)?;
            let f = parseFloatTok(s, raw, toAstSpan(e.span))?;
            Ok(PatLit(LitFloat(f)))
        },
        TkSym(sym) ->
            if (sym == "-") {
                let _ = bumpTok(s)?;
                commit(s);
                let negSp = toAstSpan(e.span);
                match peekTok(s) {
                    Some(ne) -> match ne.kind {
                        TkInt(raw) -> {
                            let _ = bumpTok(s)?;
                            let n = parseStrictIntTok(s, raw, true, unionSpan(negSp, toAstSpan(ne.span)))?;
                            Ok(PatLit(LitInt(n)))
                        },
                        TkFloat(raw) -> {
                            let _ = bumpTok(s)?;
                            let f = parseFloatTok(s, "-" + raw, unionSpan(negSp, toAstSpan(ne.span)))?;
                            Ok(PatLit(LitFloat(f)))
                        },
                        _ -> failMsg(s, "expected numeric literal after '-' in pattern"),
                    },
                    None -> failMsg(s, "expected numeric literal after '-' in pattern"),
                }
            } else failMsg(s, "unexpected symbol '" + sym + "' in pattern"),
        _ -> fail("pattern")(s),
    },
}

// ============================================================================
// Layer 3: Expressions (`pratt` + `pushToken` + `hadNewline` + `backtrack`)
// ============================================================================

data BlockStmtItem {
    BsLetVar(Span, VarDecl, Form),
    BsLetPat(Span, Pattern, Form),
    BsExpr(Form),
}

def foldBlockRevLoop(revItems: List BlockStmtItem, curTail: List Form, tailExpr: Form): List Form = match revItems {
    Nil -> curTail,
    Cons(BsExpr(e), r) -> foldBlockRevLoop(r, Cons(e, curTail), tailExpr),
    Cons(BsLetVar(sp, vd, val), r) -> {
        let bodyForm = match curTail {
            Cons(single, Nil) -> single,
            Cons(first, _) -> mkForm(unionSpan(first.pos, tailExpr.pos), ExBlock(curTail)),
            Nil -> tailExpr,
        };
        foldBlockRevLoop(r, [mkForm(unionSpan(sp, bodyForm.pos), ExLet(vd, val, bodyForm))], tailExpr)
    },
    Cons(BsLetPat(sp, pat, val), r) -> {
        let bodyForm = match curTail {
            Cons(single, Nil) -> single,
            Cons(first, _) -> mkForm(unionSpan(first.pos, tailExpr.pos), ExBlock(curTail)),
            Nil -> tailExpr,
        };
        let arm = MkMatchArm { pat: pat, guard: None, body: bodyForm };
        foldBlockRevLoop(r, [mkForm(unionSpan(sp, bodyForm.pos), ExMatch(val, [arm]))], tailExpr)
    },
}

def foldBlockItems(s: GsCursor, blockSp: Span, items: List BlockStmtItem): GsResult Form = match listRev(items) {
    Cons(BsExpr(tailExpr), restRev) -> {
        let finalItems = foldBlockRevLoop(restRev, [tailExpr], tailExpr);
        match finalItems {
            Cons(first, _) -> Ok(mkForm(unionSpan(first.pos, tailExpr.pos), ExBlock(finalItems))),
            Nil -> failSpanMsg(s, blockSp, "empty block"),
        }
    },
    _ -> failSpanMsg(s, blockSp, "Last item in a block must be an expression"),
}

def parseVarDecl(s: GsCursor): GsResult VarDecl = {
    let name = parseIdent(s)?;
    if (tryEatSym(s, ":")) {
        commit(s);
        let ty = parseTypeExprCur(s)?;
        Ok(MkVarDecl { vname: name, vscm: ScmMono(ty) })
    } else Ok(MkVarDecl { vname: name, vscm: ScmSlot })
}

def parseParamSeq(s: GsCursor): GsResult (List VarDecl) =
    sepEndBy(parseVarDecl, skipTok(TkComma))(s)

def parseLambdaHeader(s: GsCursor): GsResult (Span, List VarDecl, Option Type) = {
    let openSp = toAstSpan(eatTok(s, TkLParen)?);
    let ps = parseParamSeq(s)?;
    let _ = eatTok(s, TkRParen)?;
    let retOpt =
        if (tryEatSym(s, ":")) Some(parseTypeExprCur(s)?)
        else None;
    let _ = eatSym(s, "->")?;
    Ok((openSp, ps, retOpt))
}

def parseVarDeclHeadBeforeEq(s: GsCursor): GsResult VarDecl = {
    let vd = parseVarDecl(s)?;
    if (atTok(s, TkSym("="))) Ok(vd)
    else fail("expected '='")(s)
}

def parseLetBindingHead(s: GsCursor): GsResult (Bool, VarDecl, Pattern) = {
    let vdOpt = opt(backtrack(parseVarDeclHeadBeforeEq))(s)?;
    match vdOpt {
        Some(vd) -> Ok((true, vd, PatWild)),
        None -> {
            let pat = parsePatternCur(s)?;
            Ok((false, MkVarDecl { vname: "", vscm: ScmSlot }, pat))
        },
    }
}

def parseBlockItemsLoop(s: GsCursor, accRev: List BlockStmtItem): GsResult (List BlockStmtItem) = {
    skipSemis(s)?;
    if (atTok(s, TkRBrace) || curAtEnd(s)) Ok(listRev(accRev))
    else {
        let item =
            if (atTok(s, TkLet)) {
                let letSp = toAstSpan(bumpTok(s)?.span);
                let (isVar, vd, pat) = parseLetBindingHead(s)?;
                let _ = eatSym(s, "=")?;
                let val: Form = parseExprCur(s)?;
                if (tryEatTok(s, TkIn)) {
                    let body: Form = parseExprCur(s)?;
                    let fullSp = unionSpan(letSp, body.pos);
                    let eForm =
                        if (isVar) mkForm(fullSp, ExLet(vd, val, body))
                        else mkForm(fullSp, ExMatch(val, [MkMatchArm { pat: pat, guard: None, body: body }]));
                    BsExpr(eForm)
                } else {
                    let fullSp = unionSpan(letSp, val.pos);
                    if (isVar) BsLetVar(fullSp, vd, val) else BsLetPat(fullSp, pat, val)
                }
            } else {
                let e = parseExprCur(s)?;
                BsExpr(e)
            };
        if (atTok(s, TkRBrace) || curAtEnd(s)) {
            Ok(listRev(Cons(item, accRev)))
        } else {
            if (tryEatTok(s, TkSemi) || hadNewline(s)) {
                skipSemis(s)?
            } else {
                let _ = eatTok(s, TkSemi)?;
                ()
            };
            parseBlockItemsLoop(s, Cons(item, accRev))
        }
    }
}

def parseBlockExpr(s: GsCursor): GsResult Form = {
    let openSp = toAstSpan(eatTok(s, TkLBrace)?);
    commit(s);
    let items = parseBlockItemsLoop(s, Nil)?;
    let closeSp = toAstSpan(eatTok(s, TkRBrace)?);
    let fullSp = unionSpan(openSp, closeSp);
    let folded = foldBlockItems(s, fullSp, items)?;
    Ok(MkForm { pos: fullSp, ty: folded.ty, annot: folded.annot, node: folded.node })
}

def makeOperatorSectionForm(sp: Span, op: String): Form =
    if (op == "~") {
        let aid = ".op_arg";
        let body = mkForm(sp, ExUn(UnBitNot, mkForm(sp, ExVar(aid))));
        mkForm(sp, ExAbs([MkVarDecl { vname: aid, vscm: ScmSlot }], None, body))
    } else match builtinBinOpFromStr(op) {
        Some(bop) -> {
            let lid = ".op_lhs";
            let rid = ".op_rhs";
            let body = mkForm(sp, ExBin(bop, mkForm(sp, ExVar(lid)), mkForm(sp, ExVar(rid))));
            mkForm(sp, ExAbs([MkVarDecl { vname: lid, vscm: ScmSlot }, MkVarDecl { vname: rid, vscm: ScmSlot }], None, body))
        },
        None -> mkForm(sp, ExVar(encodeOpName(op))),
    }

def parseOpSectionAfterLParen(s: GsCursor, openSp: Span): GsResult Form = {
    let (_, op) = matchTok(s, (tk) -> match tk { TkSym(sym) -> if (isDefinableOp(sym)) Some(sym) else None, _ -> None }, "operator")?;
    let closeSp = toAstSpan(eatTok(s, TkRParen)?);
    Ok(makeOperatorSectionForm(unionSpan(openSp, closeSp), op))
}

def parseWhileSpecsLoop(
    s: GsCursor,
    invsRev: List (Span, Form),
    decsRev: List (Span, Form)
): GsResult (List (Span, Form), List (Span, Form)) =
    if (atTok(s, TkIdent("invariant"))) {
        let kwSp = toAstSpan(bumpTok(s)?.span);
        let invE: Form = parseExprCur(s)?;
        parseWhileSpecsLoop(s, Cons((unionSpan(kwSp, invE.pos), invE), invsRev), decsRev)
    } else if (atTok(s, TkIdent("decreases"))) {
        let kwSp = toAstSpan(bumpTok(s)?.span);
        let decE: Form = parseExprCur(s)?;
        let callSp = unionSpan(kwSp, decE.pos);
        match decsRev {
            Cons(_, _) -> failSpanMsgHint(
                s,
                callSp,
                "at most one `decreases` clause is allowed per `while` loop",
                "combine termination measures into a single non-negative `Int` expression"
            ),
            Nil -> parseWhileSpecsLoop(s, invsRev, Cons((callSp, decE), decsRev)),
        }
    } else Ok((listRev(invsRev), listRev(decsRev)))

def parseMatchArm(s: GsCursor): GsResult MatchArm = {
    let pat = parsePatternCur(s)?;
    commit(s);
    let guardOpt =
        if (tryEatTok(s, TkIf)) {
            let g = between(tok(TkLParen), tok(TkRParen), parseExprCur)(s)?;
            Some(g)
        } else None;
    if (atTok(s, TkSym("=>"))) {
        failMsgHint(s, "expected `->` in match arm, found `=>`", "Geisha uses `->` (not `=>`) in match arms")
    } else {
        let _ = eatSym(s, "->")?;
        let body = parseExprCur(s)?;
        Ok(MkMatchArm { pat: pat, guard: guardOpt, body: body })
    }
}

def parseStructInitField(s: GsCursor): GsResult (String, Form) = {
    let fnm = parseLowerIdent(s)?;
    commit(s);
    let _ = eatSym(s, ":")?;
    let fval = parseExprCur(s)?;
    Ok((fnm, fval))
}

def looksLikeStructInitAfterBrace(s: GsCursor): Bool =
    match (peekNthTok(s, 1), peekNthTok(s, 2)) {
        (Some(t1), Some(t2)) -> match (t1.kind, t2.kind) {
            (TkIdent(fn0), TkSym(colon)) -> isLowerByte(strByteAt(fn0, 0)) && colon == ":",
            _ -> false,
        },
        _ -> false,
    }

def parseAtomExpr(s: GsCursor): GsResult Form = match peekTok(s) {
    None -> fail("expression")(s),
    Some(e) -> {
        let tSp = toAstSpan(e.span);
        match e.kind {
            TkIf -> {
                let _ = bumpTok(s)?;
                commit(s);
                let _ = expectTok(s, TkLParen, "conditions require parentheses, e.g. `if (cond) ... else ...`")?;
                let cond = parseExprCur(s)?;
                let _ = eatTok(s, TkRParen)?;
                let thenE = parseExprCur(s)?;
                if (tryEatTok(s, TkElse)) {
                    let elseE: Form = parseExprCur(s)?;
                    Ok(mkForm(unionSpan(tSp, elseE.pos), ExIf(cond, thenE, elseE)))
                } else {
                    failMsgHint(s, "missing `else` branch in `if` expression", "add `else ()` if no value is needed")
                }
            },
            TkWhile -> {
                let _ = bumpTok(s)?;
                commit(s);
                let _ = expectTok(s, TkLParen, "conditions require parentheses, e.g. `while (cond) { ... }`")?;
                let cond = parseExprCur(s)?;
                let _ = eatTok(s, TkRParen)?;
                let (invs, decs) = parseWhileSpecsLoop(s, Nil, Nil)?;
                let rawBody: Form = parseExprCur(s)?;
                let body = match (invs, decs) {
                    (Nil, Nil) -> rawBody,
                    _ -> mkForm(rawBody.pos, ExLoopContract(invs, decs, rawBody)),
                };
                Ok(mkForm(unionSpan(tSp, rawBody.pos), ExWhile(cond, body)))
            },
            TkLet -> {
                let _ = bumpTok(s)?;
                commit(s);
                let (isVar, vd, pat) = parseLetBindingHead(s)?;
                let _ = eatSym(s, "=")?;
                let val = parseExprCur(s)?;
                let _ = expectTok(s, TkIn, "in expression context write `let x = v in body`, or wrap statements in `{ ... }`")?;
                let body: Form = parseExprCur(s)?;
                let sp = unionSpan(tSp, body.pos);
                if (isVar) Ok(mkForm(sp, ExLet(vd, val, body)))
                else Ok(mkForm(sp, ExMatch(val, [MkMatchArm { pat: pat, guard: None, body: body }])))
            },
            TkMatch -> {
                let _ = bumpTok(s)?;
                commit(s);
                let scrut = parseExprCur(s)?;
                let _ = eatTok(s, TkLBrace)?;
                let (arms, rawClose) = sepEndByUntil(parseMatchArm, skipTok(TkComma), tok(TkRBrace))(s)?;
                let closeSp = toAstSpan(rawClose);
                Ok(mkForm(unionSpan(tSp, closeSp), ExMatch(scrut, arms)))
            },
            TkLBrace -> parseBlockExpr(s),
            TkLBracket -> {
                let _ = bumpTok(s)?;
                commit(s);
                let (elems, rawClose) = sepEndByUntil(parseExprCur, skipTok(TkComma), tok(TkRBracket))(s)?;
                let closeSp = toAstSpan(rawClose);
                Ok(mkForm(unionSpan(tSp, closeSp), ExList(elems)))
            },
            TkLParen -> {
                let lamHdrOpt = opt(backtrack(parseLambdaHeader))(s)?;
                match lamHdrOpt {
                    Some((openSp, ps, retOpt)) -> {
                        commit(s);
                        let body: Form = parseExprCur(s)?;
                        Ok(mkForm(unionSpan(openSp, body.pos), ExAbs(ps, retOpt, body)))
                    },
                    None -> {
                        let openSp = toAstSpan(bumpTok(s)?.span);
                        commit(s);
                        if (atTok(s, TkRParen)) {
                            let closeSp = toAstSpan(bumpTok(s)?.span);
                            Ok(mkForm(unionSpan(openSp, closeSp), ExLit(LitUnit)))
                        } else {
                            let secOpt = opt(backtrack((sc) -> parseOpSectionAfterLParen(sc, openSp)))(s)?;
                            match secOpt {
                                Some(secForm) -> Ok(secForm),
                                None -> {
                                    let first: Form = parseExprCur(s)?;
                                    if (tryEatTok(s, TkComma)) {
                                        let (rest, rawClose) = sepEndByUntil(parseExprCur, skipTok(TkComma), tok(TkRParen))(s)?;
                                        let closeSp = toAstSpan(rawClose);
                                        Ok(mkForm(unionSpan(openSp, closeSp), ExTuple(Cons(first, rest))))
                                    } else {
                                        let closeSp = toAstSpan(eatTok(s, TkRParen)?);
                                        Ok(MkForm { pos: unionSpan(openSp, closeSp), ty: first.ty, annot: first.annot, node: first.node })
                                    }
                                },
                            }
                        }
                    },
                }
            },
            TkInt(raw) -> {
                let _ = bumpTok(s)?;
                let n = parseStrictIntTok(s, raw, false, tSp)?;
                Ok(mkForm(tSp, ExLit(LitInt(n))))
            },
            TkFloat(raw) -> {
                let _ = bumpTok(s)?;
                let f = parseFloatTok(s, raw, tSp)?;
                Ok(mkForm(tSp, ExLit(LitFloat(f))))
            },
            TkChar(c) -> {
                let _ = bumpTok(s)?;
                Ok(mkForm(tSp, ExLit(LitChar(c))))
            },
            TkStr(str) -> {
                let _ = bumpTok(s)?;
                Ok(mkForm(tSp, ExLit(LitStr(str))))
            },
            TkTrue -> {
                let _ = bumpTok(s)?;
                Ok(mkForm(tSp, ExLit(LitBool(true))))
            },
            TkFalse -> {
                let _ = bumpTok(s)?;
                Ok(mkForm(tSp, ExLit(LitBool(false))))
            },
            TkIdent(name) -> {
                let _ = bumpTok(s)?;
                if (isUpperByte(strByteAt(name, 0)) && atTok(s, TkLBrace) && looksLikeStructInitAfterBrace(s)) {
                    let _ = eatTok(s, TkLBrace)?;
                    commit(s);
                    let (fields, rawClose) = sepEndByUntil(parseStructInitField, skipTok(TkComma), tok(TkRBrace))(s)?;
                    let closeSp = toAstSpan(rawClose);
                    Ok(mkForm(unionSpan(tSp, closeSp), ExStructInit(name, fields)))
                } else Ok(mkForm(tSp, ExVar(name)))
            },
            _ -> fail("expression")(s),
        }
    },
}

def parsePostfixStep(s: GsCursor, prev: Form): GsResult (Option Form) =
    if (!hadNewline(s) && atTok(s, TkLParen)) {
        let _ = eatTok(s, TkLParen)?;
        commit(s);
        let (args, rawClose) = sepEndByUntil(parseExprCur, skipTok(TkComma), tok(TkRParen))(s)?;
        let closeSp = toAstSpan(rawClose);
        Ok(Some(mkForm(unionSpan(prev.pos, closeSp), ExApply(prev, args))))
    } else if (atTok(s, TkDot)) {
        let _ = eatTok(s, TkDot)?;
        commit(s);
        let (fsp, fname) = parseIdentSpan(s)?;
        Ok(Some(mkForm(unionSpan(prev.pos, fsp), ExField(prev, fname))))
    } else if (atTok(s, TkQuestion)) {
        let qsp = toAstSpan(bumpTok(s)?.span);
        Ok(Some(mkForm(unionSpan(prev.pos, qsp), ExTry(prev))))
    } else Ok(None)

def parsePostfixExpr(s: GsCursor): GsResult Form =
    prattPostfix(parseAtomExpr, parsePostfixStep)(s)

def consumeUnaryPrefixChar(s: GsCursor, sym: String, tokSp: PSpan): GsResult Void = {
    let _ = bumpTok(s)?;
    if (strLen(sym) > 1) {
        let rem = ptrSliceFromStr(sym, 1, strLen(sym) - 1);
        let remSp = PSpan { fileId: tokSp.fileId, start: tokSp.start + 1, end: tokSp.end };
        pushToken(s, TokEntry { kind: TkSym(rem), span: remSp, hadNewline: false })
    } else ();
    Ok(())
}

def parseUnaryExpr(s: GsCursor): GsResult Form = match peekTok(s) {
    Some(e) -> match e.kind {
        TkSym(sym) -> {
            let b0 = strByteAt(sym, 0);
            let opSp = toAstSpan(e.span);
            if (b0 == 33 && sym != "!=") {
                consumeUnaryPrefixChar(s, sym, e.span)?;
                commit(s);
                let operand: Form = parseUnaryExpr(s)?;
                Ok(mkForm(unionSpan(opSp, operand.pos), ExUn(UnNot, operand)))
            } else if (b0 == 126) {
                consumeUnaryPrefixChar(s, sym, e.span)?;
                commit(s);
                let operand: Form = parseUnaryExpr(s)?;
                Ok(mkForm(unionSpan(opSp, operand.pos), ExUn(UnBitNot, operand)))
            } else if (b0 == 45 && sym != "->") {
                consumeUnaryPrefixChar(s, sym, e.span)?;
                commit(s);
                match peekTok(s) {
                    Some(ne) -> match ne.kind {
                        TkInt(raw) if (!ne.hadNewline && ne.span.start == e.span.start + 1) -> {
                            let _ = bumpTok(s)?;
                            let fullSp = unionSpan(opSp, toAstSpan(ne.span));
                            let n = parseStrictIntTok(s, raw, true, fullSp)?;
                            Ok(mkForm(fullSp, ExLit(LitInt(n))))
                        },
                        TkFloat(raw) if (!ne.hadNewline && ne.span.start == e.span.start + 1) -> {
                            let _ = bumpTok(s)?;
                            let fullSp = unionSpan(opSp, toAstSpan(ne.span));
                            let f = parseFloatTok(s, "-" + raw, fullSp)?;
                            Ok(mkForm(fullSp, ExLit(LitFloat(f))))
                        },
                        _ -> {
                            let operand: Form = parseUnaryExpr(s)?;
                            Ok(mkForm(unionSpan(opSp, operand.pos), ExUn(UnNeg, operand)))
                        },
                    },
                    None -> {
                        let operand: Form = parseUnaryExpr(s)?;
                        Ok(mkForm(unionSpan(opSp, operand.pos), ExUn(UnNeg, operand)))
                    },
                }
            } else parsePostfixExpr(s)
        },
        _ -> parsePostfixExpr(s),
    },
    None -> parsePostfixExpr(s),
}

def parseGeishaInfixOp(s: GsCursor): GsResult (InfixInfo (String, Span)) = match peekTok(s) {
    Some(e) -> match e.kind {
        TkSym(op) -> {
            let prec = infixPrecedence(op);
            if (prec <= 0) fail("binary operator")(s)
            else {
                let _ = bumpTok(s)?;
                Ok(InfixInfo { op: (op, toAstSpan(e.span)), prec: prec, rightAssoc: isRightAssocOp(op) })
            }
        },
        _ -> fail("binary operator")(s),
    },
    None -> fail("binary operator")(s),
}

def combineGeishaInfix(lhs: Form, opInfo: (String, Span), rhs: Form): Form = {
    let (op, opSp) = opInfo;
    let sp = unionSpan(lhs.pos, rhs.pos);
    if (op == "||") mkForm(sp, ExBin(OpOr, lhs, rhs))
    else if (op == "&&") mkForm(sp, ExBin(OpAnd, lhs, rhs))
    else match builtinBinOpFromStr(op) {
        Some(bop) -> mkForm(sp, ExBin(bop, lhs, rhs)),
        None -> mkForm(sp, ExApply(mkForm(opSp, ExVar(encodeOpName(op))), [lhs, rhs])),
    }
}

def parseExprCur(s: GsCursor): GsResult Form =
    prattInfix(parseUnaryExpr, parseGeishaInfixOp, combineGeishaInfix)(s)

// ============================================================================
// Layer 4: Top-Level Declarations, Modules & Script Mode
// ============================================================================

def parseVisibility(s: GsCursor): Visibility =
    if (tryEatTok(s, TkPub)) VisPublic else VisPrivate

def parseNamedFieldDecl(s: GsCursor): GsResult FieldDecl = {
    let fnm = parseIdent(s)?;
    commit(s);
    let _ = eatSym(s, ":")?;
    let ft = parseTypeExprCur(s)?;
    Ok(MkFieldDecl { fname: Some(fnm), fty: ft })
}

def parseTupleFieldDecl(s: GsCursor): GsResult FieldDecl = {
    let ft = parseTypeExprCur(s)?;
    Ok(MkFieldDecl { fname: None, fty: ft })
}

def parseDataVariant(s: GsCursor): GsResult VariantDef = {
    let vname = parseUpperIdent(s)?;
    commit(s);
    if (atTok(s, TkLParen)) {
        let fs = between(tok(TkLParen), tok(TkRParen), sepEndBy(parseTupleFieldDecl, skipTok(TkComma)))(s)?;
        Ok(MkVariantDef { vname: vname, vbody: VarTuple(fs) })
    } else if (atTok(s, TkLBrace)) {
        let fs = between(tok(TkLBrace), tok(TkRBrace), sepEndBy(parseNamedFieldDecl, skipTok(TkComma)))(s)?;
        Ok(MkVariantDef { vname: vname, vbody: VarStruct(fs) })
    } else Ok(MkVariantDef { vname: vname, vbody: VarUnit })
}

def parseInlineTypeParams(s: GsCursor): GsResult (List String) =
    parseInlineLowerIdents(s, Nil)

def parseExternParamNamed(s: GsCursor): GsResult Type = {
    let _ = parseIdent(s)?;
    let _ = eatSym(s, ":")?;
    commit(s);
    parseTypeExprCur(s)
}

def parseExternParam(s: GsCursor): GsResult Type =
    (backtrack(parseExternParamNamed) <|> parseTypeExprCur)(s)

def parseEnsuresBindArrow(s: GsCursor): GsResult String = {
    let rname = parseIdent(s)?;
    let _ = eatSym(s, "->")?;
    Ok(rname)
}

def parseFnContractLoop(
    s: GsCursor,
    reqRev: List (Span, Form),
    ensRev: List EnsuresClause,
    decRev: List (Span, Form)
): GsResult FnContract =
    if (atTok(s, TkIdent("requires"))) {
        let kwSp = toAstSpan(bumpTok(s)?.span);
        commit(s);
        let reqE = parseExprCur(s)?;
        parseFnContractLoop(s, Cons((unionSpan(kwSp, reqE.pos), reqE), reqRev), ensRev, decRev)
    } else if (atTok(s, TkIdent("ensures"))) {
        let kwSp = toAstSpan(bumpTok(s)?.span);
        commit(s);
        let bindOpt =
            if (tryEatSym(s, "|")) {
                let rname = parseIdent(s)?;
                let _ = eatSym(s, "|")?;
                Some(rname)
            } else opt(backtrack(parseEnsuresBindArrow))(s)?;
        let ensE = parseExprCur(s)?;
        let clause = MkEnsuresClause { ecBind: bindOpt, ecSpan: unionSpan(kwSp, ensE.pos), ecExpr: ensE };
        parseFnContractLoop(s, reqRev, Cons(clause, ensRev), decRev)
    } else if (atTok(s, TkIdent("decreases"))) {
        let kwSp = toAstSpan(bumpTok(s)?.span);
        commit(s);
        let decE = parseExprCur(s)?;
        let callSp = unionSpan(kwSp, decE.pos);
        match decRev {
            Cons(_, _) -> failSpanMsgHint(
                s,
                callSp,
                "at most one `decreases` clause is allowed per function",
                "combine termination measures into a single non-negative `Int` expression"
            ),
            Nil -> parseFnContractLoop(s, reqRev, ensRev, Cons((callSp, decE), decRev)),
        }
    } else Ok(MkFnContract {
        fcRequires: listRev(reqRev),
        fcEnsures: listRev(ensRev),
        fcDecreases: listRev(decRev),
    })

def wrapFnContractBody(fc: FnContract, rawBody: Form): Form =
    if (!hasFnContract(fc)) rawBody
    else mkForm(rawBody.pos, ExContract(fc, rawBody))

def parseFormDefBody(s: GsCursor, vis: Visibility, startSp: Span): GsResult Def = {
    let _ = eatTok(s, TkDef)?;
    commit(s);
    let name = parseCallableIdent(s)?;
    if (atTok(s, TkLParen)) {
        let ps = between(tok(TkLParen), tok(TkRParen), parseParamSeq)(s)?;
        let retScmOpt = if (tryEatSym(s, ":")) Some(parseTypeSchemeCur(s)?) else None;
        let fc = parseFnContractLoop(s, Nil, Nil, Nil)?;
        let _ = eatSym(s, "=")?;
        let rawBody = parseExprCur(s)?;
        let body = wrapFnContractBody(fc, rawBody);
        let (retTy, fnScmAnn) = match retScmOpt {
            Some(ScmMono(t)) -> (Some(t), None),
            Some(poly) -> (None, Some(poly)),
            None -> (None, None),
        };
        let form = MkForm { pos: rawBody.pos, ty: ScmSlot, annot: fnScmAnn, node: ExAbs(ps, retTy, body) };
        Ok(MkDef { ident: name, dpos: unionSpan(startSp, rawBody.pos), vis: vis, attrs: Nil, item: ItForm(form) })
    } else {
        let valAnn = if (tryEatSym(s, ":")) Some(parseTypeSchemeCur(s)?) else None;
        let _ = eatSym(s, "=")?;
        let val = parseExprCur(s)?;
        let annotatedVal = MkForm { pos: val.pos, ty: val.ty, annot: valAnn, node: val.node };
        Ok(MkDef { ident: name, dpos: unionSpan(startSp, val.pos), vis: vis, attrs: Nil, item: ItForm(annotatedVal) })
    }
}

def buildDerivedInstItem(
    dname: String,
    tparams: List String,
    cn: String,
    fullSp: Span,
    vis: Visibility
): ModuleItem = {
    let (targetTy, autoCsRev) = buildDerivedTargetLoop(tparams, cn, TyCon(dname), Nil);
    let instDef = MkDef {
        ident: "instance_" + cn,
        dpos: fullSp,
        vis: vis,
        attrs: Nil,
        item: ItInstance(cn, [targetTy], listRev(autoCsRev), Nil),
    };
    ModDef(vis, instDef)
}

def buildDerivedTargetLoop(
    tps: List String,
    cn: String,
    tyAcc: Type,
    csRev: List ConstraintSpec
): (Type, List ConstraintSpec) = match tps {
    Nil -> (tyAcc, csRev),
    Cons(tp, rest) -> buildDerivedTargetLoop(
        rest,
        cn,
        TyComp(tyAcc, TyVar(tp)),
        Cons(MkConstraint { conceptName: cn, typeArgs: [TyVar(tp)] }, csRev)
    ),
}

def buildDerivedItems(
    derived: List String,
    dname: String,
    tparams: List String,
    fullSp: Span,
    vis: Visibility
): List ModuleItem = match derived {
    Nil -> Nil,
    Cons(cn, rest) -> Cons(
        buildDerivedInstItem(dname, tparams, cn, fullSp, vis),
        buildDerivedItems(rest, dname, tparams, fullSp, vis)
    ),
}

def isRecordShorthandAfterLBrace(s: GsCursor): Bool =
    match (peekTok(s), peekNthTok(s, 1)) {
        (Some(t0), Some(t1)) -> match (t0.kind, t1.kind) {
            (TkIdent(fnm), TkSym(colon)) -> strLen(fnm) > 0 && isLowerByte(strByteAt(fnm, 0)) && colon == ":",
            _ -> false,
        },
        _ -> false,
    }

def parseDataDefBody(
    s: GsCursor,
    vis: Visibility,
    startSp: Span,
    attrs: List DefAttr
): GsResult (Def, List ModuleItem) = {
    let _ = eatTok(s, TkData)?;
    commit(s);
    let dname = parseUpperIdent(s)?;
    let tparams = parseInlineTypeParams(s)?;
    let derived0 =
        if (tryEatSym(s, ":")) sepBy1(parseUpperIdent, skipTok(TkComma))(s)?
        else Nil;
    let (variants, closeSp, derived) =
        if (atTok(s, TkLParen)) {
            let _ = eatTok(s, TkLParen)?;
            let fs = sepEndBy(parseTupleFieldDecl, skipTok(TkComma))(s)?;
            let spClose = toAstSpan(eatTok(s, TkRParen)?);
            let derived1 = match derived0 {
                Nil -> if (tryEatSym(s, ":")) sepBy1(parseUpperIdent, skipTok(TkComma))(s)? else Nil,
                _ -> derived0,
            };
            ([MkVariantDef { vname: dname, vbody: VarTuple(fs) }], spClose, derived1)
        } else {
            let _ = eatTok(s, TkLBrace)?;
            let vs =
                if (isRecordShorthandAfterLBrace(s)) {
                    let fs = sepEndBy(parseNamedFieldDecl, skipTok(TkComma))(s)?;
                    [MkVariantDef { vname: dname, vbody: VarStruct(fs) }]
                } else {
                    sepEndBy(parseDataVariant, skipTok(TkComma))(s)?
                };
            let spClose = toAstSpan(eatTok(s, TkRBrace)?);
            (vs, spClose, derived0)
        };
    let fullSp = unionSpan(startSp, closeSp);
    let extraItems = buildDerivedItems(derived, dname, tparams, fullSp, vis);
    Ok((MkDef { ident: dname, dpos: fullSp, vis: vis, attrs: attrs, item: ItAlg(tparams, variants) }, extraItems))
}

def parseExternExportHeader(s: GsCursor): GsResult (String, List VarDecl, Option Scheme, FnContract) = {
    let _ = eatTok(s, TkDef)?;
    let name = parseCallableIdent(s)?;
    let ps = between(tok(TkLParen), tok(TkRParen), parseParamSeq)(s)?;
    let retScmOpt = if (tryEatSym(s, ":")) Some(parseTypeSchemeCur(s)?) else None;
    let fc = parseFnContractLoop(s, Nil, Nil, Nil)?;
    let _ = eatSym(s, "=")?;
    Ok((name, ps, retScmOpt, fc))
}

def parseExternModsLoop(s: GsCursor, isNoAlloc: Bool, isFnPtr: Bool): GsResult (Bool, Bool) =
    if (tryEatTok(s, TkIdent("noalloc"))) parseExternModsLoop(s, true, isFnPtr)
    else if (tryEatTok(s, TkIdent("ptr"))) parseExternModsLoop(s, isNoAlloc, true)
    else Ok((isNoAlloc, isFnPtr))

def parseForwardDecl(s: GsCursor): GsResult (String, Scheme) = {
    let fname = parseCallableIdent(s)?;
    let _ = eatSym(s, ":")?;
    let scm = parseTypeSchemeCur(s)?;
    Ok((fname, scm))
}

def parseConceptMethodsLoop(s: GsCursor, accRev: List MethodDecl): GsResult (List MethodDecl) = {
    skipSemis(s)?;
    if (atTok(s, TkRBrace)) Ok(listRev(accRev))
    else if (tryEatTok(s, TkDef)) {
        commit(s);
        let mname = parseCallableIdent(s)?;
        let ptys = between(tok(TkLParen), tok(TkRParen), sepEndBy(parseExternParam, skipTok(TkComma)))(s)?;
        let retTy = if (tryEatSym(s, ":")) parseTypeExprCur(s)? else TyVoid;
        let mscm = ScmMono(TyArr(TyVoid, ptys, retTy));
        let _ = tryEatTok(s, TkComma);
        skipSemis(s)?;
        parseConceptMethodsLoop(s, Cons(MkMethodDecl { mname: mname, mty: mscm }, accRev))
    } else {
        let mname = parseCallableIdent(s)?;
        commit(s);
        let _ = eatSym(s, ":")?;
        let mscm = parseTypeSchemeCur(s)?;
        let _ = tryEatTok(s, TkComma);
        skipSemis(s)?;
        parseConceptMethodsLoop(s, Cons(MkMethodDecl { mname: mname, mty: mscm }, accRev))
    }
}

def parseInstanceImplsLoop(s: GsCursor, accRev: List MethodImpl): GsResult (List MethodImpl) = {
    skipSemis(s)?;
    if (atTok(s, TkRBrace)) Ok(listRev(accRev))
    else if (atTok(s, TkDef)) {
        let mSp = toAstSpan(bumpTok(s)?.span);
        commit(s);
        let mname = parseCallableIdent(s)?;
        let mps = between(tok(TkLParen), tok(TkRParen), parseParamSeq)(s)?;
        let mret = if (tryEatSym(s, ":")) Some(parseTypeExprCur(s)?) else None;
        let mfc = parseFnContractLoop(s, Nil, Nil, Nil)?;
        let _ = eatSym(s, "=")?;
        let rawMBody = parseExprCur(s)?;
        let mbody = wrapFnContractBody(mfc, rawMBody);
        let lam = mkForm(unionSpan(mSp, rawMBody.pos), ExAbs(mps, mret, mbody));
        let _ = tryEatTok(s, TkComma);
        skipSemis(s)?;
        parseInstanceImplsLoop(s, Cons(MkMethodImpl { implName: mname, implBody: lam }, accRev))
    } else failMsg(s, "expected 'def' or '}' inside instance block")
}

def parseDefinitionCur(s: GsCursor, knownVis: Option Visibility): GsResult (Def, List ModuleItem) = {
    let fwdOpt: Option (String, Scheme) = match knownVis {
        Some(_) -> None,
        None ->
            if (atTokIf(s, (tk) -> match tk { TkIdent(_) -> true, TkLParen -> true, _ -> false }))
                opt(backtrack(parseForwardDecl))(s)?
            else None,
    };
    match fwdOpt {
        Some((fwdName, fwdScm)) -> {
            commit(s);
            skipSemis(s)?;
            let startSp = curAstSpan(s);
            let vis = parseVisibility(s);
            if (!atTok(s, TkDef)) failMsg(s, "Expected 'def' after forward type declaration")
            else {
                let d = parseFormDefBody(s, vis, startSp)?;
                if (d.ident != fwdName) {
                    failMsg(s, "Forward declaration for '" + fwdName + "' must be followed by its definition")
                } else match d.item {
                    ItForm(f) -> {
                        let f2 = MkForm { pos: f.pos, ty: f.ty, annot: Some(fwdScm), node: f.node };
                        Ok((MkDef { ident: d.ident, dpos: d.dpos, vis: d.vis, attrs: Nil, item: ItForm(f2) }, Nil))
                    },
                    _ -> Ok((d, Nil)),
                }
            }
        },
        None -> {
            let startSp = curAstSpan(s);
            let vis = match knownVis {
                Some(v) -> v,
                None -> parseVisibility(s),
            };
            if (atTok(s, TkDef)) {
                let d = parseFormDefBody(s, vis, startSp)?;
                Ok((d, Nil))
            } else if (tryEatTok(s, TkExtern)) {
                commit(s);
                if (atTok(s, TkData)) {
                    parseDataDefBody(s, vis, startSp, [AttrCStruct])
                } else if (tryEatTok(s, TkIdent("init"))) {
                    let prio =
                        if (tryEatTok(s, TkLParen)) {
                            let (isp, raw) = matchTok(s, (tk) -> match tk { TkInt(ns) -> Some(ns), _ -> None }, "integer priority")?;
                            let pv = parseStrictIntTok(s, raw, false, toAstSpan(isp))?;
                            let _ = eatTok(s, TkRParen)?;
                            pv
                        } else 65535;
                    if (!atTok(s, TkDef)) failMsg(s, "Expected 'def' after 'extern init'")
                    else {
                        let d = parseFormDefBody(s, vis, startSp)?;
                        Ok((MkDef { ident: d.ident, dpos: unionSpan(startSp, d.dpos), vis: vis, attrs: [AttrCtor(prio)], item: d.item }, Nil))
                    }
                } else {
                    let (isNoAlloc, isFnPtr) = parseExternModsLoop(s, false, false)?;
                    let linkOpt = opt((sc) -> {
                        let (_, str) = matchTok(sc, (tk) -> match tk { TkStr(st) -> Some(st), _ -> None }, "link symbol")?;
                        Ok(str)
                    })(s)?;
                    let exportHdrOpt =
                        if (!isNoAlloc && !isFnPtr) opt(backtrack(parseExternExportHeader))(s)?
                        else None;
                    match exportHdrOpt {
                        Some((name, ps, retScmOpt, fc)) -> {
                            let rawBody = parseExprCur(s)?;
                            let body = wrapFnContractBody(fc, rawBody);
                            let (retTy, fnScmAnn) = match retScmOpt {
                                Some(ScmMono(t)) -> (Some(t), None),
                                Some(poly) -> (None, Some(poly)),
                                None -> (None, None),
                            };
                            let form = MkForm { pos: rawBody.pos, ty: ScmSlot, annot: fnScmAnn, node: ExAbs(ps, retTy, body) };
                            let d = MkDef { ident: name, dpos: unionSpan(startSp, rawBody.pos), vis: vis, attrs: [AttrExport(linkOpt)], item: ItForm(form) };
                            Ok((d, Nil))
                        },
                        None -> {
                            let _ = eatTok(s, TkDef)?;
                            let fnName = parseIdent(s)?;
                            let _ = eatTok(s, TkLParen)?;
                            let ps = sepEndBy(parseExternParam, skipTok(TkComma))(s)?;
                            let closeSp = toAstSpan(eatTok(s, TkRParen)?);
                            let retTy = if (tryEatSym(s, ":")) parseTypeExprCur(s)? else TyVoid;
                            let linkSym = match linkOpt {
                                Some(st) -> st,
                                None -> if (isFnPtr) "" else fnName,
                            };
                            let fnTy = TyArr(TyVoid, ps, retTy);
                            let d = MkDef {
                                ident: fnName,
                                dpos: unionSpan(startSp, closeSp),
                                vis: vis,
                                attrs: Nil,
                                item: ItExtern(linkSym, ScmMono(fnTy), isNoAlloc, isFnPtr),
                            };
                            Ok((d, Nil))
                        },
                    }
                }
            } else if (tryEatTok(s, TkType)) {
                commit(s);
                let tname = parseUpperIdent(s)?;
                let tparams = parseInlineTypeParams(s)?;
                let _ = eatSym(s, "=")?;
                let target = parseTypeSchemeCur(s)?;
                Ok((MkDef { ident: tname, dpos: startSp, vis: vis, attrs: Nil, item: ItAlias(tparams, target) }, Nil))
            } else if (atTok(s, TkData)) {
                parseDataDefBody(s, vis, startSp, Nil)
            } else if (tryEatTok(s, TkConcept)) {
                commit(s);
                let cname = parseUpperIdent(s)?;
                let tparams = parseInlineTypeParams(s)?;
                let supers = parseConceptSupersClause(s)?;
                let fundeps = parseFunDepsClause(s)?;
                let _ = eatTok(s, TkLBrace)?;
                let methods = parseConceptMethodsLoop(s, Nil)?;
                let closeSp = toAstSpan(eatTok(s, TkRBrace)?);
                let d = MkDef { ident: cname, dpos: unionSpan(startSp, closeSp), vis: vis, attrs: Nil, item: ItConcept(tparams, supers, fundeps, methods) };
                Ok((d, Nil))
            } else if (tryEatTok(s, TkInstance)) {
                commit(s);
                let cs = optOr(backtrack(parseConstraintPrefix), Nil)(s)?;
                let cname = parseUpperIdent(s)?;
                let t0 = parseTypeAtom(s)?;
                let targs = parseInlineTypeAtoms(s, [t0])?;
                let instIdent = "instance_" + cname;
                if (tryEatTok(s, TkLBrace)) {
                    let impls = parseInstanceImplsLoop(s, Nil)?;
                    let closeSp = toAstSpan(eatTok(s, TkRBrace)?);
                    Ok((MkDef { ident: instIdent, dpos: unionSpan(startSp, closeSp), vis: vis, attrs: Nil, item: ItInstance(cname, targs, cs, impls) }, Nil))
                } else {
                    Ok((MkDef { ident: instIdent, dpos: startSp, vis: vis, attrs: Nil, item: ItInstance(cname, targs, cs, Nil) }, Nil))
                }
            } else fail("top-level definition")(s)
        },
    }
}

def parseUseSpec(s: GsCursor): GsResult UseSpec = {
    let origSp = curAstSpan(s);
    let name = parseCallableIdent(s)?;
    let aliasOpt =
        if (tryEatTok(s, TkAs)) {
            commit(s);
            Some(parseCallableIdent(s)?)
        } else None;
    Ok(MkUseSpec { orig: name, alias: aliasOpt, origSpan: origSp })
}

def parseUseTailLoop(
    s: GsCursor,
    segsRev: List String,
    lastSpan: Span
): GsResult UseItem =
    if (tryEatTok(s, TkDot)) {
        commit(s);
        if (atTok(s, TkLBrace)) {
            let specs = between(tok(TkLBrace), tok(TkRBrace), sepEndBy(parseUseSpec, skipTok(TkComma)))(s)?;
            Ok(UseMulti(listRev(segsRev), specs))
        } else {
            let nextSp = curAstSpan(s);
            let seg = parseIdent(s)?;
            parseUseTailLoop(s, Cons(seg, segsRev), nextSp)
        }
    } else if (tryEatTok(s, TkAs)) {
        commit(s);
        let alias = parseIdent(s)?;
        Ok(UseAlias(listRev(segsRev), alias, lastSpan))
    } else Ok(UseSingle(listRev(segsRev), lastSpan))

def parseUseStatement(s: GsCursor): GsResult UseItem = {
    let firstSp = curAstSpan(s);
    let seg0 = parseIdent(s)?;
    parseUseTailLoop(s, [seg0], firstSp)
}

def parseModPathTail(s: GsCursor, accRev: List String): GsResult (List String) =
    if (!tryEatTok(s, TkDot)) Ok(listRev(accRev))
    else {
        commit(s);
        let seg = parseIdent(s)?;
        parseModPathTail(s, Cons(seg, accRev))
    }

def parseModPath(s: GsCursor): GsResult (List String) = {
    let first = parseIdent(s)?;
    parseModPathTail(s, [first])
}

def prependRev(xs: List a, accRev: List a): List a = match xs {
    Nil -> accRev,
    Cons(h, t) -> prependRev(t, Cons(h, accRev)),
}

def parseSubModItemsLoop(s: GsCursor, accRev: List ModuleItem): GsResult (List ModuleItem) = {
    skipSemis(s)?;
    if (atTok(s, TkRBrace) || curAtEnd(s)) Ok(listRev(accRev))
    else {
        let items = parseModuleItem(s)?;
        skipSemis(s)?;
        parseSubModItemsLoop(s, prependRev(items, accRev))
    }
}

def parseModuleItem(s: GsCursor): GsResult (List ModuleItem) = {
    let startSp = curAstSpan(s);
    let visOpt: Option Visibility =
        if (tryEatTok(s, TkPub)) {
            commit(s);
            Some(VisPublic)
        } else None;
    let vis = match visOpt {
        Some(v) -> v,
        None -> VisPrivate,
    };
    if (tryEatTok(s, TkUse)) {
        commit(s);
        let u = parseUseStatement(s)?;
        Ok([ModUse(vis, u)])
    } else if (tryEatTok(s, TkOpen)) {
        commit(s);
        let mp = parseModPath(s)?;
        Ok([ModUse(vis, UseGlob(mp))])
    } else if (tryEatTok(s, TkMod)) {
        commit(s);
        let mname = parseIdent(s)?;
        if (tryEatTok(s, TkLBrace)) {
            let subItems = parseSubModItemsLoop(s, Nil)?;
            let closeSp = toAstSpan(eatTok(s, TkRBrace)?);
            Ok([ModSub(vis, mname, subItems, unionSpan(startSp, closeSp))])
        } else Ok([ModDecl(vis, mname)])
    } else {
        let (d, derivedItems) = parseDefinitionCur(s, visOpt)?;
        Ok(Cons(ModDef(d.vis, d), derivedItems))
    }
}

def isTopLevelModuleItemStart(s: GsCursor): Bool = match peekTok(s) {
    None -> false,
    Some(e) -> match e.kind {
        TkPub -> true,
        TkUse -> true,
        TkOpen -> true,
        TkMod -> true,
        TkDef -> true,
        TkExtern -> true,
        TkData -> true,
        TkType -> true,
        TkConcept -> true,
        TkInstance -> true,
        TkIdent(_) -> match peek(parseForwardDecl)(s) { Ok(_) -> true, Err(_) -> false },
        TkLParen -> match peek(parseForwardDecl)(s) { Ok(_) -> true, Err(_) -> false },
        _ -> false,
    },
}

def eatScriptStmtSep(s: GsCursor): GsResult Void =
    if (curAtEnd(s)) Ok(())
    else if (tryEatTok(s, TkSemi) || hadNewline(s)) skipSemis(s)
    else {
        let _ = eatTok(s, TkSemi)?;
        Ok(())
    }

def parseTopLevelScriptStmt(s: GsCursor): GsResult BlockStmtItem =
    if (atTok(s, TkLet)) {
        let letSp = toAstSpan(bumpTok(s)?.span);
        commit(s);
        let (isVar, vd, pat) = parseLetBindingHead(s)?;
        let _ = eatSym(s, "=")?;
        let val = parseExprCur(s)?;
        let res =
            if (tryEatTok(s, TkIn)) {
                let body = parseExprCur(s)?;
                let fullSp = unionSpan(letSp, body.pos);
                let eForm =
                    if (isVar) mkForm(fullSp, ExLet(vd, val, body))
                    else mkForm(fullSp, ExMatch(val, [MkMatchArm { pat: pat, guard: None, body: body }]));
                BsExpr(eForm)
            } else {
                let fullSp = unionSpan(letSp, val.pos);
                if (isVar) BsLetVar(fullSp, vd, val) else BsLetPat(fullSp, pat, val)
            };
        eatScriptStmtSep(s)?;
        Ok(res)
    } else {
        let e = parseExprCur(s)?;
        eatScriptStmtSep(s)?;
        Ok(BsExpr(e))
    }

def findMainDefSpan(items: List ModuleItem): Option Span = match items {
    Nil -> None,
    Cons(ModDef(_, d), rest) ->
        if (d.ident == "main") Some(d.dpos)
        else findMainDefSpan(rest),
    Cons(_, rest) -> findMainDefSpan(rest),
}

def normalizeScriptStmts(stmts: List BlockStmtItem): List BlockStmtItem = match listRev(stmts) {
    Nil -> Nil,
    Cons(lastItem, restRev) -> match lastItem {
        BsExpr(lastE) -> {
            let unitForm = mkForm(lastE.pos, ExLit(LitUnit));
            let vd = MkVarDecl { vname: ".script_last", vscm: ScmSlot };
            listRev(Cons(BsExpr(unitForm), Cons(BsLetVar(lastE.pos, vd, lastE), restRev)))
        },
        BsLetVar(sp, vd, val) -> {
            let unitForm = mkForm(sp, ExLit(LitUnit));
            listRev(Cons(BsExpr(unitForm), Cons(BsLetVar(sp, vd, val), restRev)))
        },
        BsLetPat(sp, pat, val) -> {
            let unitForm = mkForm(sp, ExLit(LitUnit));
            listRev(Cons(BsExpr(unitForm), Cons(BsLetPat(sp, pat, val), restRev)))
        },
    },
}

def parseFileLoop(
    s: GsCursor,
    allowTopStmts: Bool,
    itemsRev: List ModuleItem,
    stmtsRev: List BlockStmtItem
): GsResult (List ModuleItem, List BlockStmtItem) = {
    skipSemis(s)?;
    if (curAtEnd(s)) Ok((listRev(itemsRev), listRev(stmtsRev)))
    else if (allowTopStmts && !isTopLevelModuleItemStart(s)) {
        let st = parseTopLevelScriptStmt(s)?;
        parseFileLoop(s, allowTopStmts, itemsRev, Cons(st, stmtsRev))
    } else {
        let modItems = parseModuleItem(s)?;
        parseFileLoop(s, allowTopStmts, prependRev(modItems, itemsRev), stmtsRev)
    }
}

def parseFileModuleBody(s: GsCursor, modPath: List String): GsResult FileModule = {
    let allowTopStmts = match modPath { Nil -> true, _ -> false };
    let (items, stmts) = parseFileLoop(s, allowTopStmts, Nil, Nil)?;
    match stmts {
        Nil -> Ok(MkFileModule { modPath: modPath, items: items }),
        _ -> match findMainDefSpan(items) {
            Some(mainSp) -> failSpanMsg(s, mainSp, "cannot mix top-level script statements with an explicit `def main`"),
            None -> {
                let normStmts = normalizeScriptStmts(stmts);
                let bodyForm = foldBlockItems(s, emptySpan(), normStmts)?;
                let mainForm = mkForm(bodyForm.pos, ExAbs(Nil, Some(TyVoid), bodyForm));
                let mainDef = MkDef {
                    ident: "main",
                    dpos: bodyForm.pos,
                    vis: VisPrivate,
                    attrs: Nil,
                    item: ItForm(mainForm),
                };
                Ok(MkFileModule {
                    modPath: modPath,
                    items: listAppend(items, [ModDef(VisPrivate, mainDef)]),
                })
            },
        },
    }
}

pub def parseTypeExpr(p: Parser): Result Type String =
    runCompatParser(p, parseTypeExprCur)

pub def parseTypeScheme(p: Parser): Result Scheme String =
    runCompatParser(p, parseTypeSchemeCur)

pub def parsePattern(p: Parser): Result Pattern String =
    runCompatParser(p, parsePatternCur)

pub def parseExpr(p: Parser): Result Form String =
    runCompatParser(p, parseExprCur)

pub def parseDefinition(p: Parser, knownVis: Option Visibility): Result Def String = {
    let cur = makeCompatCursor(p);
    let res = parseDefinitionCur(cur, knownVis);
    syncCompatParser(p, cur);
    match res {
        Ok((d, extraItems)) -> {
            match extraItems {
                Nil -> (),
                _ -> cellSet(p.pendingItems, listAppend(cellGet(p.pendingItems), extraItems)),
            };
            Ok(d)
        },
        Err(_) -> Err(formatParseErrorDiag(finishErrorFor(cur))),
    }
}

pub def parseFileModule(src: String, modPath: List String): Result FileModule String =
    parseFileModuleInFile(src, modPath, 0)

pub def parseFileModuleInFile(src: String, modPath: List String, fileId: Int): Result FileModule String = {
    let toks = tokenizeInFile(src, fileId)?;
    let frozen = freezeLexTokens(toks);
    match parseTokensFile((s) -> parseFileModuleBody(s, modPath), src, frozen, "<module>", fileId, describeGsTok) {
        Ok(fm) -> Ok(fm),
        Err(pe) -> Err(formatParseErrorDiag(pe)),
    }
}

// ============================================================================
// AST `?` (`ExTry`) Desugarer
// ============================================================================

def listContainsTry(es: List Form): Bool = match es {
    Nil -> false,
    Cons(h, t) -> if (formContainsTry(h)) true else listContainsTry(t),
}

def namedFieldsContainTry(fs: List (String, Form)): Bool = match fs {
    Nil -> false,
    Cons((_, v), t) -> if (formContainsTry(v)) true else namedFieldsContainTry(t),
}

def armsContainTry(arms: List MatchArm): Bool = match arms {
    Nil -> false,
    Cons(a, rest) -> {
        let gTry = match a.guard {
            Some(g) -> formContainsTry(g),
            None -> false,
        };
        if (gTry || formContainsTry(a.body)) true else armsContainTry(rest)
    },
}

pub def formContainsTry(f: Form): Bool = match f.node {
    ExTry(_) -> true,
    ExLit(_) -> false,
    ExVar(_) -> false,
    ExField(e, _) -> formContainsTry(e),
    ExUn(_, e) -> formContainsTry(e),
    ExTuple(es) -> listContainsTry(es),
    ExList(es) -> listContainsTry(es),
    ExBlock(es) -> listContainsTry(es),
    ExStructInit(_, fs) -> namedFieldsContainTry(fs),
    ExApply(c, args) -> formContainsTry(c) || listContainsTry(args),
    ExAbs(_, _, b) -> formContainsTry(b),
    ExBin(_, l, r) -> formContainsTry(l) || formContainsTry(r),
    ExWhile(c, b) -> formContainsTry(c) || formContainsTry(b),
    ExContract(_, b) -> formContainsTry(b),
    ExLoopContract(_, _, b) -> formContainsTry(b),
    ExLet(_, v, b) -> formContainsTry(v) || formContainsTry(b),
    ExIf(c, t, e) -> formContainsTry(c) || formContainsTry(t) || formContainsTry(e),
    ExMatch(s, arms) -> formContainsTry(s) || armsContainTry(arms),
}

pub def defContainsTry(d: Def): Bool = match d.item {
    ItForm(f) -> formContainsTry(f),
    ItInstance(_, _, _, ms) -> {
        let cur = cellNew(ms);
        let found = cellNew(false);
        while (match cellGet(cur) { Nil -> false, _ -> !cellGet(found) }) {
            match cellGet(cur) {
                Cons(m, r) -> {
                    if (formContainsTry(m.implBody)) cellSet(found, true) else ();
                    cellSet(cur, r)
                },
                Nil -> (),
            }
        };
        cellGet(found)
    },
    _ -> false,
}

data TryCtx {
    MkTryCtx { okCtor: String, errCtor: String, counter: Cell Int },
}

def freshTryNames(ctx: TryCtx): (String, String) = {
    let n = cellGet(ctx.counter) + 1;
    cellSet(ctx.counter, n);
    let s = intToStr(n);
    (".try_ok_" + s, ".try_err_" + s)
}

def freshTryHelper(ctx: TryCtx, prefix: String): String = {
    let n = cellGet(ctx.counter) + 1;
    cellSet(ctx.counter, n);
    "." + prefix + "_" + intToStr(n)
}

def wrapTryBinds(ctx: TryCtx, binds: List (String, Span, Form), cont0: Form): Form = {
    let rev = listRev(binds);
    let cont = cellNew(cont0);
    let cur = cellNew(rev);
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons((okName, sp, scrut), rest) -> {
                let (_, errName) = freshTryNames(ctx);
                let errBody = mkForm(sp, ExApply(mkForm(sp, ExVar(ctx.errCtor)), [mkForm(sp, ExVar(errName))]));
                let errArm = MkMatchArm { pat: PatCtor(ctx.errCtor, [PatVar(errName, emptySpan())]), guard: None, body: errBody };
                let prevCont = cellGet(cont);
                let okArm = MkMatchArm { pat: PatCtor(ctx.okCtor, [PatVar(okName, emptySpan())]), guard: None, body: prevCont };
                cellSet(cont, mkForm(unionSpan(sp, prevCont.pos), ExMatch(scrut, [errArm, okArm])));
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    cellGet(cont)
}

def extractTriesInList(ctx: TryCtx, es: List Form, binds: Cell (List (String, Span, Form))): List Form = match es {
    Nil -> Nil,
    Cons(h, t) -> {
        let ch = extractValueTries(ctx, h, binds);
        Cons(ch, extractTriesInList(ctx, t, binds))
    },
}

def extractTriesInNamed(ctx: TryCtx, fs: List (String, Form), binds: Cell (List (String, Span, Form))): List (String, Form) = match fs {
    Nil -> Nil,
    Cons((k, v), t) -> {
        let cv = extractValueTries(ctx, v, binds);
        Cons((k, cv), extractTriesInNamed(ctx, t, binds))
    },
}

def desugarNonResultList(ctx: TryCtx, es: List Form): List Form = match es {
    Nil -> Nil,
    Cons(h, t) -> Cons(desugarNonResultExpr(ctx, h), desugarNonResultList(ctx, t)),
}

def desugarNonResultNamed(ctx: TryCtx, fs: List (String, Form)): List (String, Form) = match fs {
    Nil -> Nil,
    Cons((k, v), t) -> Cons((k, desugarNonResultExpr(ctx, v)), desugarNonResultNamed(ctx, t)),
}

def desugarNonResultExpr(ctx: TryCtx, f: Form): Form = {
    let n = match f.node {
        ExAbs(ps, rt, body) -> ExAbs(ps, rt, desugarResultScope(ctx, body)),
        ExWhile(c, b) -> ExWhile(desugarNonResultExpr(ctx, c), desugarNonResultExpr(ctx, b)),
        ExContract(fc, b) -> ExContract(fc, desugarResultScope(ctx, b)),
        ExLoopContract(invs, decs, b) -> ExLoopContract(invs, decs, desugarNonResultExpr(ctx, b)),
        ExIf(c, t, e) -> ExIf(desugarNonResultExpr(ctx, c), desugarNonResultExpr(ctx, t), desugarNonResultExpr(ctx, e)),
        ExLet(vd, v, b) -> ExLet(vd, desugarNonResultExpr(ctx, v), desugarNonResultExpr(ctx, b)),
        ExMatch(s, arms) -> {
            let newArms = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ng = match a.guard {
                            Some(g) -> Some(desugarNonResultExpr(ctx, g)),
                            None -> None,
                        };
                        let na = MkMatchArm { pat: a.pat, guard: ng, body: desugarNonResultExpr(ctx, a.body) };
                        cellSet(newArms, listAppend(cellGet(newArms), [na]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            ExMatch(desugarNonResultExpr(ctx, s), cellGet(newArms))
        },
        ExBlock(es) -> ExBlock(desugarNonResultList(ctx, es)),
        ExTuple(es) -> ExTuple(desugarNonResultList(ctx, es)),
        ExList(es) -> ExList(desugarNonResultList(ctx, es)),
        ExStructInit(c, fs) -> ExStructInit(c, desugarNonResultNamed(ctx, fs)),
        ExApply(c, args) -> ExApply(desugarNonResultExpr(ctx, c), desugarNonResultList(ctx, args)),
        ExBin(op, l, r) -> ExBin(op, desugarNonResultExpr(ctx, l), desugarNonResultExpr(ctx, r)),
        ExUn(op, e) -> ExUn(op, desugarNonResultExpr(ctx, e)),
        ExField(e, nm) -> ExField(desugarNonResultExpr(ctx, e), nm),
        other -> other,
    };
    MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: n }
}

def wrapInOkForm(ctx: TryCtx, expr: Form): Form =
    mkForm(expr.pos, ExApply(mkForm(expr.pos, ExVar(ctx.okCtor)), [expr]))

def extractValueTries(ctx: TryCtx, f: Form, binds: Cell (List (String, Span, Form))): Form = match f.node {
    ExTry(inner) -> {
        let cleanInner = extractValueTries(ctx, inner, binds);
        let (okName, _) = freshTryNames(ctx);
        cellSet(binds, listAppend(cellGet(binds), [(okName, f.pos, cleanInner)]));
        MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExVar(okName) }
    },
    ExLit(_) -> f,
    ExVar(_) -> f,
    ExField(b, nm) -> {
        let cb = extractValueTries(ctx, b, binds);
        MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExField(cb, nm) }
    },
    ExUn(op, o) -> {
        let co = extractValueTries(ctx, o, binds);
        MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExUn(op, co) }
    },
    ExBin(OpAnd, l, r) ->
        if (!formContainsTry(r)) {
            let cl = extractValueTries(ctx, l, binds);
            let cr = desugarNonResultExpr(ctx, r);
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExBin(OpAnd, cl, cr) }
        } else {
            let rw = mkForm(f.pos, ExIf(l, r, mkForm(f.pos, ExLit(LitBool(false)))));
            extractValueTries(ctx, rw, binds)
        },
    ExBin(OpOr, l, r) ->
        if (!formContainsTry(r)) {
            let cl = extractValueTries(ctx, l, binds);
            let cr = desugarNonResultExpr(ctx, r);
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExBin(OpOr, cl, cr) }
        } else {
            let rw = mkForm(f.pos, ExIf(l, mkForm(f.pos, ExLit(LitBool(true))), r));
            extractValueTries(ctx, rw, binds)
        },
    ExBin(op, l, r) -> {
        let cl = extractValueTries(ctx, l, binds);
        let cr = extractValueTries(ctx, r, binds);
        MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExBin(op, cl, cr) }
    },
    ExApply(c, args) -> {
        let cc = extractValueTries(ctx, c, binds);
        let cargs = extractTriesInList(ctx, args, binds);
        MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExApply(cc, cargs) }
    },
    ExTuple(es) -> MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExTuple(extractTriesInList(ctx, es, binds)) },
    ExList(es) -> MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExList(extractTriesInList(ctx, es, binds)) },
    ExStructInit(c, fs) -> MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExStructInit(c, extractTriesInNamed(ctx, fs, binds)) },
    ExAbs(ps, rt, body) -> MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExAbs(ps, rt, desugarResultScope(ctx, body)) },
    ExIf(c, t, e) ->
        if (formContainsTry(c) || formContainsTry(t) || formContainsTry(e)) {
            let lifted = desugarResultScope(ctx, mkForm(f.pos, ExIf(c, wrapInOkForm(ctx, t), wrapInOkForm(ctx, e))));
            let (okName, _) = freshTryNames(ctx);
            cellSet(binds, listAppend(cellGet(binds), [(okName, f.pos, lifted)]));
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExVar(okName) }
        } else desugarNonResultExpr(ctx, f),
    ExMatch(s, arms) ->
        if (formContainsTry(s) || armsContainTry(arms)) {
            let liftedArms = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        cellSet(liftedArms, listAppend(cellGet(liftedArms), [MkMatchArm { pat: a.pat, guard: a.guard, body: wrapInOkForm(ctx, a.body) }]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let lifted = desugarResultScope(ctx, mkForm(f.pos, ExMatch(s, cellGet(liftedArms))));
            let (okName, _) = freshTryNames(ctx);
            cellSet(binds, listAppend(cellGet(binds), [(okName, f.pos, lifted)]));
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExVar(okName) }
        } else desugarNonResultExpr(ctx, f),
    ExLet(vd, v, b) ->
        if (formContainsTry(v) || formContainsTry(b)) {
            let lifted = desugarResultScope(ctx, mkForm(f.pos, ExLet(vd, v, wrapInOkForm(ctx, b))));
            let (okName, _) = freshTryNames(ctx);
            cellSet(binds, listAppend(cellGet(binds), [(okName, f.pos, lifted)]));
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExVar(okName) }
        } else desugarNonResultExpr(ctx, f),
    ExBlock(es) ->
        if (listContainsTry(es)) {
            let rev = listRev(es);
            match rev {
                Nil -> f,
                Cons(last, restRev) -> {
                    let wrapped = listAppend(listRev(restRev), [wrapInOkForm(ctx, last)]);
                    let lifted = desugarResultScope(ctx, mkForm(f.pos, ExBlock(wrapped)));
                    let (okName, _) = freshTryNames(ctx);
                    cellSet(binds, listAppend(cellGet(binds), [(okName, f.pos, lifted)]));
                    MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExVar(okName) }
                },
            }
        } else desugarNonResultExpr(ctx, f),
    _ -> desugarNonResultExpr(ctx, f),
}

def sequenceVoidBeforeResult(ctx: TryCtx, stmt: Form, cont: Form): Form = {
    let sp = unionSpan(stmt.pos, cont.pos);
    if (!formContainsTry(stmt)) {
        let cs = desugarNonResultExpr(ctx, stmt);
        match cont.node {
            ExBlock(tailItems) -> mkForm(sp, ExBlock(Cons(cs, tailItems))),
            _ -> mkForm(sp, ExBlock([cs, cont])),
        }
    } else {
        let sPos = stmt.pos;
        match stmt.node {
            ExLet(vd, val, body) -> {
                let binds = cellNew(Nil);
                let cleanVal = extractValueTries(ctx, val, binds);
                let nextCont = sequenceVoidBeforeResult(ctx, body, cont);
                wrapTryBinds(ctx, cellGet(binds), mkForm(sp, ExLet(vd, cleanVal, nextCont)))
            },
            ExBlock(items) -> {
                let rev = listRev(items);
                let acc = cellNew(cont);
                let cur = cellNew(rev);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(it, r) -> {
                            cellSet(acc, sequenceVoidBeforeResult(ctx, it, cellGet(acc)));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                cellGet(acc)
            },
            ExWhile(wcond, wbody) -> {
                let (invs, decs, innerBody) = match wbody.node {
                    ExLoopContract(is, ds, b) -> (is, ds, b),
                    _ -> (Nil, Nil, wbody),
                };
                let loopName = freshTryHelper(ctx, "try_while");
                let callLoop = mkForm(sPos, ExApply(mkForm(sPos, ExVar(loopName)), Nil));
                let mkAssertForm = (asp: Span, condF: Form) -> mkForm(asp, ExApply(mkForm(asp, ExVar("assert")), [condF]));
                let mkAssumeForm = (asp: Span, condF: Form) -> mkForm(asp, ExApply(mkForm(asp, ExVar("assume")), [condF]));
                let prependInvs = (invList: List (Span, Form), useAssume: Bool, tailF: Form) -> {
                    let rev = listRev(invList);
                    let acc = cellNew(tailF);
                    let ci = cellNew(rev);
                    while (match cellGet(ci) { Nil -> false, _ -> true }) {
                        match cellGet(ci) {
                            Cons((isp, ie), r) -> {
                                let chk = if (useAssume) mkAssumeForm(isp, ie) else mkAssertForm(isp, ie);
                                cellSet(acc, mkForm(sp, ExBlock([chk, cellGet(acc)])));
                                cellSet(ci, r)
                            },
                            Nil -> (),
                        }
                    };
                    cellGet(acc)
                };
                let condBinds = cellNew(Nil);
                let cleanCond = extractValueTries(ctx, wcond, condBinds);
                let step = match decs {
                    Cons((dsp, decExpr), _) -> {
                        let decName = freshTryHelper(ctx, "try_dec");
                        let decVar = mkForm(dsp, ExVar(decName));
                        let zeroLit = mkForm(dsp, ExLit(LitInt(0)));
                        let geZero = mkAssertForm(dsp, mkForm(dsp, ExBin(OpGe, decVar, zeroLit)));
                        let ltPrev = mkAssertForm(dsp, mkForm(dsp, ExBin(OpLt, decExpr, decVar)));
                        let backCont = mkForm(sp, ExBlock([ltPrev, prependInvs(invs, false, callLoop)]));
                        let bodyRun = sequenceVoidBeforeResult(ctx, innerBody, backCont);
                        let withGe = mkForm(sp, ExBlock([geZero, bodyRun]));
                        mkForm(sp, ExLet(MkVarDecl { vname: decName, vscm: ScmSlot }, decExpr, withGe))
                    },
                    Nil -> {
                        let backCont = prependInvs(invs, false, callLoop);
                        sequenceVoidBeforeResult(ctx, innerBody, backCont)
                    },
                };
                let branchBody = wrapTryBinds(ctx, cellGet(condBinds), mkForm(sp, ExIf(cleanCond, step, cont)));
                let lamBody = prependInvs(invs, true, branchBody);
                let lam = mkForm(sp, ExAbs(Nil, None, lamBody));
                let loopLet = mkForm(sp, ExLet(MkVarDecl { vname: loopName, vscm: ScmSlot }, lam, callLoop));
                prependInvs(invs, false, loopLet)
            },
            ExIf(c, t, e) -> {
                let joinName = freshTryHelper(ctx, "try_join");
                let callJoin = mkForm(sPos, ExApply(mkForm(sPos, ExVar(joinName)), Nil));
                let binds = cellNew(Nil);
                let cc = extractValueTries(ctx, c, binds);
                let ct = sequenceVoidBeforeResult(ctx, t, callJoin);
                let ce = sequenceVoidBeforeResult(ctx, e, callJoin);
                let br = wrapTryBinds(ctx, cellGet(binds), mkForm(sPos, ExIf(cc, ct, ce)));
                let joinLam = mkForm(sp, ExAbs(Nil, None, cont));
                mkForm(sp, ExLet(MkVarDecl { vname: joinName, vscm: ScmSlot }, joinLam, br))
            },
            ExMatch(scrut, arms) -> {
                let joinName = freshTryHelper(ctx, "try_join");
                let callJoin = mkForm(sPos, ExApply(mkForm(sPos, ExVar(joinName)), Nil));
                let binds = cellNew(Nil);
                let cs = extractValueTries(ctx, scrut, binds);
                let cleanArms = cellNew(Nil);
                let cur = cellNew(arms);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(a, r) -> {
                            let ng = match a.guard {
                                Some(g) -> Some(desugarNonResultExpr(ctx, g)),
                                None -> None,
                            };
                            let nb = sequenceVoidBeforeResult(ctx, a.body, callJoin);
                            cellSet(cleanArms, listAppend(cellGet(cleanArms), [MkMatchArm { pat: a.pat, guard: ng, body: nb }]));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                let mf = wrapTryBinds(ctx, cellGet(binds), mkForm(sPos, ExMatch(cs, cellGet(cleanArms))));
                let joinLam = mkForm(sp, ExAbs(Nil, None, cont));
                mkForm(sp, ExLet(MkVarDecl { vname: joinName, vscm: ScmSlot }, joinLam, mf))
            },
            _ -> {
                let binds = cellNew(Nil);
                let cleanStmt = extractValueTries(ctx, stmt, binds);
                let seq = match cont.node {
                    ExBlock(tailItems) -> mkForm(sp, ExBlock(Cons(cleanStmt, tailItems))),
                    _ -> mkForm(sp, ExBlock([cleanStmt, cont])),
                };
                wrapTryBinds(ctx, cellGet(binds), seq)
            },
        }
    }
}

def desugarResultScope(ctx: TryCtx, f: Form): Form =
    if (!formContainsTry(f)) f
    else match f.node {
        ExAbs(ps, rt, body) ->
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExAbs(ps, rt, desugarResultScope(ctx, body)) },
        ExLet(vd, val, body) -> {
            let binds = cellNew(Nil);
            let cleanVal = extractValueTries(ctx, val, binds);
            let cleanBody = desugarResultScope(ctx, body);
            let rebuilt = MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExLet(vd, cleanVal, cleanBody) };
            wrapTryBinds(ctx, cellGet(binds), rebuilt)
        },
        ExBlock(items) -> {
            let rev = listRev(items);
            match rev {
                Nil -> f,
                Cons(last, restRev) -> {
                    let acc = cellNew(desugarResultScope(ctx, last));
                    let cur = cellNew(restRev);
                    while (match cellGet(cur) { Nil -> false, _ -> true }) {
                        match cellGet(cur) {
                            Cons(stmt, r) -> {
                                cellSet(acc, sequenceVoidBeforeResult(ctx, stmt, cellGet(acc)));
                                cellSet(cur, r)
                            },
                            Nil -> (),
                        }
                    };
                    let res = cellGet(acc);
                    MkForm { pos: res.pos, ty: res.ty, annot: f.annot, node: res.node }
                },
            }
        },
        ExIf(cond, thenE, elseE) -> {
            let binds = cellNew(Nil);
            let cc = extractValueTries(ctx, cond, binds);
            let ct = desugarResultScope(ctx, thenE);
            let ce = desugarResultScope(ctx, elseE);
            let rebuilt = MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExIf(cc, ct, ce) };
            wrapTryBinds(ctx, cellGet(binds), rebuilt)
        },
        ExContract(fc, innerBody) ->
            MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExContract(fc, desugarResultScope(ctx, innerBody)) },
        ExMatch(scrut, arms) -> {
            let binds = cellNew(Nil);
            let cs = extractValueTries(ctx, scrut, binds);
            let cleanArms = cellNew(Nil);
            let cur = cellNew(arms);
            while (match cellGet(cur) { Nil -> false, _ -> true }) {
                match cellGet(cur) {
                    Cons(a, r) -> {
                        let ng = match a.guard {
                            Some(g) -> Some(desugarNonResultExpr(ctx, g)),
                            None -> None,
                        };
                        let na = MkMatchArm { pat: a.pat, guard: ng, body: desugarResultScope(ctx, a.body) };
                        cellSet(cleanArms, listAppend(cellGet(cleanArms), [na]));
                        cellSet(cur, r)
                    },
                    Nil -> (),
                }
            };
            let rebuilt = MkForm { pos: f.pos, ty: f.ty, annot: f.annot, node: ExMatch(cs, cellGet(cleanArms)) };
            wrapTryBinds(ctx, cellGet(binds), rebuilt)
        },
        _ -> {
            let binds = cellNew(Nil);
            let clean = extractValueTries(ctx, f, binds);
            wrapTryBinds(ctx, cellGet(binds), clean)
        },
    }

pub def desugarTryInDef(d: Def, okCtor: String, errCtor: String): Def =
    if (!defContainsTry(d)) d
    else {
        let ctx = MkTryCtx { okCtor: okCtor, errCtor: errCtor, counter: cellNew(0) };
        match d.item {
            ItForm(f) -> MkDef { ident: d.ident, dpos: d.dpos, vis: d.vis, attrs: d.attrs, item: ItForm(desugarResultScope(ctx, f)) },
            ItInstance(cn, tas, cs, ms) -> {
                let newMs = cellNew(Nil);
                let cur = cellNew(ms);
                while (match cellGet(cur) { Nil -> false, _ -> true }) {
                    match cellGet(cur) {
                        Cons(m, r) -> {
                            let nm = MkMethodImpl { implName: m.implName, implBody: desugarResultScope(ctx, m.implBody) };
                            cellSet(newMs, listAppend(cellGet(newMs), [nm]));
                            cellSet(cur, r)
                        },
                        Nil -> (),
                    }
                };
                MkDef { ident: d.ident, dpos: d.dpos, vis: d.vis, attrs: d.attrs, item: ItInstance(cn, tas, cs, cellGet(newMs)) }
            },
            _ -> d,
        }
    }
