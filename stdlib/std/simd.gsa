// Portable Hardware-Accelerated SIMD Vectors & Masks (`std.simd`)
//
// Parameterized `Simd n e` vectors (128-bit & 256-bit) and first-class `Mask n e` masks
// lowered directly to LLVM `<N x T>` vector SSA registers across ARM64 NEON, x86-64 SSE4.2/AVX2,
// WebAssembly SIMD128, and ES Module JavaScript (`DataView`).

use std.bits.{popCount, trailingZeros, leadingZeros}

// ============================================================================
// 1. Lane-Count & Element Marker Types + Concrete Aliases
// ============================================================================

/// Phantom marker for 2-lane SIMD vectors.
pub data L2 {}

/// Phantom marker for 4-lane SIMD vectors.
pub data L4 {}

/// Phantom marker for 8-lane SIMD vectors.
pub data L8 {}

/// Phantom marker for 16-lane SIMD vectors.
pub data L16 {}

/// Phantom marker for 32-lane SIMD vectors.
pub data L32 {}

/// Signed 8-bit integer lane marker (`-128..127`, scalar representation `Int`).
pub data I8 {}

/// Unsigned 8-bit integer lane marker (`0..255`, scalar representation `Int`).
pub data U8 {}

/// Signed 16-bit integer lane marker (`-32768..32767`, scalar representation `Int`).
pub data I16 {}

/// Unsigned 16-bit integer lane marker (`0..65535`, scalar representation `Int`).
pub data U16 {}

/// Signed 32-bit integer lane alias (`Int`).
pub type I32 = Int

/// Unsigned 32-bit integer lane marker (scalar representation `Int`).
pub data U32 {}

/// Signed 64-bit integer lane alias (`Int64`).
pub type I64 = Int64

/// Unsigned 64-bit integer lane marker (scalar representation `Int64`).
pub data U64 {}

/// 32-bit IEEE-754 floating-point lane alias (`Float32`).
pub type F32 = Float32

/// 64-bit IEEE-754 floating-point lane alias (`Float`).
pub type F64 = Float

/// 128-bit SIMD vector of 16 signed 8-bit integers (`<16 x i8>`).
pub type I8x16 = Simd L16 I8

/// 128-bit SIMD vector of 16 unsigned 8-bit integers (`<16 x i8>`).
pub type U8x16 = Simd L16 U8

/// 128-bit SIMD vector of 8 signed 16-bit integers (`<8 x i16>`).
pub type I16x8 = Simd L8 I16

/// 128-bit SIMD vector of 8 unsigned 16-bit integers (`<8 x i16>`).
pub type U16x8 = Simd L8 U16

/// 128-bit SIMD vector of 4 signed 32-bit integers (`<4 x i32>`).
pub type I32x4 = Simd L4 Int

/// 128-bit SIMD vector of 4 unsigned 32-bit integers (`<4 x i32>`).
pub type U32x4 = Simd L4 U32

/// 128-bit SIMD vector of 2 signed 64-bit integers (`<2 x i64>`).
pub type I64x2 = Simd L2 Int64

/// 128-bit SIMD vector of 2 unsigned 64-bit integers (`<2 x i64>`).
pub type U64x2 = Simd L2 U64

/// 128-bit SIMD vector of 4 single-precision floats (`<4 x float>`).
pub type F32x4 = Simd L4 Float32

/// 128-bit SIMD vector of 2 double-precision floats (`<2 x double>`).
pub type F64x2 = Simd L2 Float

/// 256-bit SIMD vector of 32 signed 8-bit integers (`<32 x i8>`).
pub type I8x32 = Simd L32 I8

/// 256-bit SIMD vector of 32 unsigned 8-bit integers (`<32 x i8>`).
pub type U8x32 = Simd L32 U8

/// 256-bit SIMD vector of 16 signed 16-bit integers (`<16 x i16>`).
pub type I16x16 = Simd L16 I16

/// 256-bit SIMD vector of 16 unsigned 16-bit integers (`<16 x i16>`).
pub type U16x16 = Simd L16 U16

/// 256-bit SIMD vector of 8 signed 32-bit integers (`<8 x i32>`).
pub type I32x8 = Simd L8 Int

/// 256-bit SIMD vector of 8 unsigned 32-bit integers (`<8 x i32>`).
pub type U32x8 = Simd L8 U32

/// 256-bit SIMD vector of 4 signed 64-bit integers (`<4 x i64>`).
pub type I64x4 = Simd L4 Int64

/// 256-bit SIMD vector of 4 unsigned 64-bit integers (`<4 x i64>`).
pub type U64x4 = Simd L4 U64

/// 256-bit SIMD vector of 8 single-precision floats (`<8 x float>`).
pub type F32x8 = Simd L8 Float32

/// 256-bit SIMD vector of 4 double-precision floats (`<4 x double>`).
pub type F64x4 = Simd L4 Float

/// Unboxed lane-wise boolean mask with all-ones (`-1`) for `true` lanes and `0` for `false` lanes.
pub data Mask n e (Simd n e)

/// 16-lane 8-bit mask alias (`Mask L16 U8`).
pub type Mask8x16 = Mask L16 U8

/// 32-lane 8-bit mask alias (`Mask L32 U8`).
pub type Mask8x32 = Mask L32 U8

/// 8-lane 16-bit mask alias (`Mask L8 U16`).
pub type Mask16x8 = Mask L8 U16

/// 16-lane 16-bit mask alias (`Mask L16 U16`).
pub type Mask16x16 = Mask L16 U16

/// 4-lane 32-bit mask alias (`Mask L4 Int`).
pub type Mask32x4 = Mask L4 Int

/// 8-lane 32-bit mask alias (`Mask L8 Int`).
pub type Mask32x8 = Mask L8 Int

/// 2-lane 64-bit mask alias (`Mask L2 Int64`).
pub type Mask64x2 = Mask L2 Int64

/// 4-lane 64-bit mask alias (`Mask L4 Int64`).
pub type Mask64x4 = Mask L4 Int64

// ============================================================================
// 2. Core Vector Geometry & Element Concepts (`SimdLane`, `SimdVec`)
// ============================================================================

/// Valid hardware SIMD vector geometry `(n, e)` (128-bit or 256-bit).
pub concept SimdLane n e {
    def laneCount(v: Simd n e): Int,
    def vectorBytes(v: Simd n e): Int
}

pub instance SimdLane L16 I8 {
    def laneCount(_) = 16
    def vectorBytes(_) = 16
}
pub instance SimdLane L16 U8 {
    def laneCount(_) = 16
    def vectorBytes(_) = 16
}
pub instance SimdLane L8 I16 {
    def laneCount(_) = 8
    def vectorBytes(_) = 16
}
pub instance SimdLane L8 U16 {
    def laneCount(_) = 8
    def vectorBytes(_) = 16
}
pub instance SimdLane L4 Int {
    def laneCount(_) = 4
    def vectorBytes(_) = 16
}
pub instance SimdLane L4 U32 {
    def laneCount(_) = 4
    def vectorBytes(_) = 16
}
pub instance SimdLane L2 Int64 {
    def laneCount(_) = 2
    def vectorBytes(_) = 16
}
pub instance SimdLane L2 U64 {
    def laneCount(_) = 2
    def vectorBytes(_) = 16
}
pub instance SimdLane L4 Float32 {
    def laneCount(_) = 4
    def vectorBytes(_) = 16
}
pub instance SimdLane L2 Float {
    def laneCount(_) = 2
    def vectorBytes(_) = 16
}
pub instance SimdLane L32 I8 {
    def laneCount(_) = 32
    def vectorBytes(_) = 32
}
pub instance SimdLane L32 U8 {
    def laneCount(_) = 32
    def vectorBytes(_) = 32
}
pub instance SimdLane L16 I16 {
    def laneCount(_) = 16
    def vectorBytes(_) = 32
}
pub instance SimdLane L16 U16 {
    def laneCount(_) = 16
    def vectorBytes(_) = 32
}
pub instance SimdLane L8 Int {
    def laneCount(_) = 8
    def vectorBytes(_) = 32
}
pub instance SimdLane L8 U32 {
    def laneCount(_) = 8
    def vectorBytes(_) = 32
}
pub instance SimdLane L4 Int64 {
    def laneCount(_) = 4
    def vectorBytes(_) = 32
}
pub instance SimdLane L4 U64 {
    def laneCount(_) = 4
    def vectorBytes(_) = 32
}
pub instance SimdLane L8 Float32 {
    def laneCount(_) = 8
    def vectorBytes(_) = 32
}
pub instance SimdLane L4 Float {
    def laneCount(_) = 4
    def vectorBytes(_) = 32
}

/// Associates a SIMD vector `Simd n e` with its natural Geisha scalar type `s`.
pub concept SimdVec n e s : SimdLane n e | e -> s {
    def splat(val: s): Simd n e,
    def zero(): Simd n e,
    def iota(): Simd n e,
    def extract(v: Simd n e, idx: Int): s,
    def replace(v: Simd n e, idx: Int, val: s): Simd n e
}

pub instance SimdVec L16 I8 Int {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L16 U8 Int {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L8 I16 Int {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L8 U16 Int {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L4 Int Int {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L4 U32 Int {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L2 Int64 Int64 {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(intToI64(0))
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L2 U64 Int64 {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(intToI64(0))
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L4 Float32 Float32 {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0.0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
pub instance SimdVec L2 Float Float {
    def splat(x) = __simdSplat(x)
    def zero() = __simdSplat(0.0)
    def iota() = __simdIota()
    def extract(v, i) = __simdExtract(v, i)
    def replace(v, i, x) = __simdReplace(v, i, x)
}
