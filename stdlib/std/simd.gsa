/// Integer SIMD lane trait carrying bit width and signedness (`SimdBits`).
pub concept SimdBits n e : SimdLane n e {
    def laneBits(_: Simd n e): Int,
    def shrOpcode(_: Simd n e): Int
}

pub instance SimdBits L16 I8 { def laneBits(_) = 8; def shrOpcode(_) = 1 }
pub instance SimdBits L16 U8 { def laneBits(_) = 8; def shrOpcode(_) = 2 }
pub instance SimdBits L8 I16 { def laneBits(_) = 16; def shrOpcode(_) = 1 }
pub instance SimdBits L8 U16 { def laneBits(_) = 16; def shrOpcode(_) = 2 }
pub instance SimdBits L4 Int { def laneBits(_) = 32; def shrOpcode(_) = 1 }
pub instance SimdBits L4 U32 { def laneBits(_) = 32; def shrOpcode(_) = 2 }
pub instance SimdBits L2 Int64 { def laneBits(_) = 64; def shrOpcode(_) = 1 }
pub instance SimdBits L2 U64 { def laneBits(_) = 64; def shrOpcode(_) = 2 }
pub instance SimdBits L32 I8 { def laneBits(_) = 8; def shrOpcode(_) = 1 }
pub instance SimdBits L32 U8 { def laneBits(_) = 8; def shrOpcode(_) = 2 }
pub instance SimdBits L16 I16 { def laneBits(_) = 16; def shrOpcode(_) = 1 }
pub instance SimdBits L16 U16 { def laneBits(_) = 16; def shrOpcode(_) = 2 }
pub instance SimdBits L8 Int { def laneBits(_) = 32; def shrOpcode(_) = 1 }
pub instance SimdBits L8 U32 { def laneBits(_) = 32; def shrOpcode(_) = 2 }
pub instance SimdBits L4 Int64 { def laneBits(_) = 64; def shrOpcode(_) = 1 }
pub instance SimdBits L4 U64 { def laneBits(_) = 64; def shrOpcode(_) = 2 }

pub instance (SimdBits n e) => Rem (Simd n e) {
    def (%)(a, b) = __simdBin(4, a, b)
}

pub instance (SimdLane n e) => Neg (Simd n e) {
    def neg(a) = __simdUnary(0, a)
}

pub instance (SimdBits n e) => BitAnd (Simd n e) {
    def (&)(a, b) = __simdBin(5, a, b)
}

pub instance (SimdBits n e) => BitOr (Simd n e) {
    def (|)(a, b) = __simdBin(6, a, b)
}

pub instance (SimdBits n e) => BitXor (Simd n e) {
    def (^)(a, b) = __simdBin(7, a, b)
}

pub instance (SimdBits n e) => BitNot (Simd n e) {
    def (~)(a) = __simdUnary(1, a)
}

pub instance (SimdBits n e) => Shl (Simd n e) {
    def (<<)(a, amt) = __simdShift(0, a, amt)
}

pub instance (SimdBits n e) => Shr (Simd n e) {
    def (>>)(a, amt) =
        if (shrOpcode(a) == 2) __simdShift(2, a, amt)
        else __simdShift(1, a, amt)
}

pub instance (SimdBits n e) => Ushr (Simd n e) {
    def (>>>)(a, amt) = __simdShift(2, a, amt)
}

/// Whole-vector structural equality (`true` iff all lanes are equal).
pub instance (SimdLane n e) => Eq (Simd n e) {
    def eq(a, b) = {
        let l = laneCount(a);
        let m = __simdReduce(5, __simdCmp(0, a, b));
        if (l == 32) m == -1 else m == ((1 << l) - 1)
    }
}

// ============================================================================
// 4. First-Class `Mask n e` Operations & Blending (`select`)
// ============================================================================

/// Unwrap the underlying all-ones/all-zeros raw `Simd n e` vector of `m`.
pub def maskRaw(m: Mask n e): Simd n e = match m {
    Mask(raw) -> raw,
}

pub instance (SimdLane n e) => BitAnd (Mask n e) {
    def (&)(a, b) = match (a, b) {
        (Mask(x), Mask(y)) -> Mask(__simdBin(5, x, y)),
    }
}

pub instance (SimdLane n e) => BitOr (Mask n e) {
    def (|)(a, b) = match (a, b) {
        (Mask(x), Mask(y)) -> Mask(__simdBin(6, x, y)),
    }
}

pub instance (SimdLane n e) => BitXor (Mask n e) {
    def (^)(a, b) = match (a, b) {
        (Mask(x), Mask(y)) -> Mask(__simdBin(7, x, y)),
    }
}

pub instance (SimdLane n e) => BitNot (Mask n e) {
    def (~)(a) = match a {
        Mask(x) -> Mask(__simdUnary(1, x)),
    }
}

pub instance (SimdLane n e) => Eq (Mask n e) {
    def eq(a, b) = match (a, b) {
        (Mask(x), Mask(y)) -> {
            let mx: Int = __simdReduce(5, x);
            let my: Int = __simdReduce(5, y);
            mx == my
        },
    }
}

/// Pack the truth value of each lane in `m` into an `N`-bit `Int` bitmask (`bit k = lane k`).
/// Compiles to `pmovmskb` on x86-64, `i8x16.bitmask` on Wasm SIMD128, and NEON bit-reduction on ARM64.
bitmask: forall n e. (SimdLane n e) => Mask n e -> Int
pub def bitmask(m) = match m {
    Mask(raw) -> __simdReduce(5, raw),
}

/// Return `true` if at least one lane in `m` is `true`.
any: forall n e. (SimdLane n e) => Mask n e -> Bool
pub def any(m) = bitmask(m) != 0

/// Return `true` if every lane in `m` is `true`.
all: forall n e. (SimdLane n e) => Mask n e -> Bool
pub def all(m) = match m {
    Mask(raw) -> {
        let l = laneCount(raw);
        let bm = __simdReduce(5, raw);
        if (l == 32) bm == -1 else bm == ((1 << l) - 1)
    },
}

/// Return `true` if every lane in `m` is `false`.
none: forall n e. (SimdLane n e) => Mask n e -> Bool
pub def none(m) = bitmask(m) == 0

/// Count the number of `true` lanes in `m`.
countTrue: forall n e. (SimdLane n e) => Mask n e -> Int
pub def countTrue(m) = popCount(bitmask(m))

/// Index (`0..lanes-1`) of the first `true` lane in `m`, or `lanes` if all lanes are `false`.
firstTrue: forall n e. (SimdLane n e) => Mask n e -> Int
pub def firstTrue(m) = match m {
    Mask(raw) -> {
        let l = laneCount(raw);
        let tz = trailingZeros(__simdReduce(5, raw));
        if (tz > l) l else tz
    },
}

/// Index (`0..lanes-1`) of the last `true` lane in `m`, or `-1` if all lanes are `false`.
lastTrue: forall n e. (SimdLane n e) => Mask n e -> Int
pub def lastTrue(m) = {
    let bm = bitmask(m);
    if (bm == 0) -1 else 31 - leadingZeros(bm)
}

/// Branchless lane-wise blend: selects `onTrue[i]` where `m[i]` is `true` and `onFalse[i]` otherwise.
/// Compiles to single-instruction `bsl.16b` (NEON), `vpblendvb` (SSE4.1/AVX2), or `v128.bitselect` (Wasm).
select: forall n e. (SimdLane n e) => (Mask n e, Simd n e, Simd n e) -> Simd n e
pub def select(m, onTrue, onFalse) = match m {
    Mask(raw) -> __simdBin(6, __simdBin(5, onTrue, raw), __simdBin(5, onFalse, __simdUnary(1, raw))),
}

// ============================================================================
// 5. Lane-Wise Comparisons (`==~`, `!=~`, `<~`, `<=~`, `>~`, `>=~`)
// ============================================================================

/// Lane-wise SIMD equality comparison producing a `Mask` (`==~`, `!=~`, precedence 4).
pub concept SimdEq a b m | a b -> m {
    def (==~)(x: a, y: b): m,
    def (!=~)(x: a, y: b): m
}

pub instance (SimdLane n e) => SimdEq (Simd n e)(Simd n e)(Mask n e) {
    def (==~)(a, b) = Mask(__simdCmp(0, a, b))
    def (!=~)(a, b) = Mask(__simdCmp(1, a, b))
}
pub instance (SimdLane n e) => SimdEq (Simd n e) Int (Mask n e) {
    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))
    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))
}
pub instance (SimdLane n e) => SimdEq Int (Simd n e)(Mask n e) {
    def (==~)(s, b) = Mask(__simdCmp(0, __simdSplat(s), b))
    def (!=~)(s, b) = Mask(__simdCmp(1, __simdSplat(s), b))
}
pub instance (SimdLane n U8) => SimdEq (Simd n U8) Char (Mask n U8) {
    def (==~)(a, c) = Mask(__simdCmp(0, a, __simdSplat(charToInt(c))))
    def (!=~)(a, c) = Mask(__simdCmp(1, a, __simdSplat(charToInt(c))))
}
pub instance (SimdLane n U8) => SimdEq Char (Simd n U8)(Mask n U8) {
    def (==~)(c, b) = Mask(__simdCmp(0, __simdSplat(charToInt(c)), b))
    def (!=~)(c, b) = Mask(__simdCmp(1, __simdSplat(charToInt(c)), b))
}
pub instance (SimdLane n I8) => SimdEq (Simd n I8) Char (Mask n I8) {
    def (==~)(a, c) = Mask(__simdCmp(0, a, __simdSplat(charToInt(c))))
    def (!=~)(a, c) = Mask(__simdCmp(1, a, __simdSplat(charToInt(c))))
}
pub instance (SimdLane n I8) => SimdEq Char (Simd n I8)(Mask n I8) {
    def (==~)(c, b) = Mask(__simdCmp(0, __simdSplat(charToInt(c)), b))
    def (!=~)(c, b) = Mask(__simdCmp(1, __simdSplat(charToInt(c)), b))
}
pub instance (SimdLane n Int64) => SimdEq (Simd n Int64) Int64 (Mask n Int64) {
    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))
    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))
}
pub instance (SimdLane n U64) => SimdEq (Simd n U64) Int64 (Mask n U64) {
    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))
    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))
}
pub instance (SimdLane n Float32) => SimdEq (Simd n Float32) Float32 (Mask n Float32) {
    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))
    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))
}
pub instance (SimdLane n Float32) => SimdEq (Simd n Float32) Float (Mask n Float32) {
    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))
    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))
}
pub instance (SimdLane n Float) => SimdEq (Simd n Float) Float (Mask n Float) {
    def (==~)(a, s) = Mask(__simdCmp(0, a, __simdSplat(s)))
    def (!=~)(a, s) = Mask(__simdCmp(1, a, __simdSplat(s)))
}

/// Lane-wise SIMD ordering comparison producing a `Mask` (`<~`, `<=~`, `>~`, `>=~`, precedence 5).
pub concept SimdOrd a b m | a b -> m {
    def (<~)(x: a, y: b): m,
    def (<=~)(x: a, y: b): m,
    def (>~)(x: a, y: b): m,
    def (>=~)(x: a, y: b): m
}

pub instance (SimdLane n e) => SimdOrd (Simd n e)(Simd n e)(Mask n e) {
    def (<~)(a, b) = Mask(__simdCmp(2, a, b))
    def (<=~)(a, b) = Mask(__simdCmp(3, a, b))
    def (>~)(a, b) = Mask(__simdCmp(4, a, b))
    def (>=~)(a, b) = Mask(__simdCmp(5, a, b))
}
pub instance (SimdLane n e) => SimdOrd (Simd n e) Int (Mask n e) {
    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))
    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))
    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))
    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))
}
pub instance (SimdLane n e) => SimdOrd Int (Simd n e)(Mask n e) {
    def (<~)(s, b) = Mask(__simdCmp(2, __simdSplat(s), b))
    def (<=~)(s, b) = Mask(__simdCmp(3, __simdSplat(s), b))
    def (>~)(s, b) = Mask(__simdCmp(4, __simdSplat(s), b))
    def (>=~)(s, b) = Mask(__simdCmp(5, __simdSplat(s), b))
}
pub instance (SimdLane n U8) => SimdOrd (Simd n U8) Char (Mask n U8) {
    def (<~)(a, c) = Mask(__simdCmp(2, a, __simdSplat(charToInt(c))))
    def (<=~)(a, c) = Mask(__simdCmp(3, a, __simdSplat(charToInt(c))))
    def (>~)(a, c) = Mask(__simdCmp(4, a, __simdSplat(charToInt(c))))
    def (>=~)(a, c) = Mask(__simdCmp(5, a, __simdSplat(charToInt(c))))
}
pub instance (SimdLane n U8) => SimdOrd Char (Simd n U8)(Mask n U8) {
    def (<~)(c, b) = Mask(__simdCmp(2, __simdSplat(charToInt(c)), b))
    def (<=~)(c, b) = Mask(__simdCmp(3, __simdSplat(charToInt(c)), b))
    def (>~)(c, b) = Mask(__simdCmp(4, __simdSplat(charToInt(c)), b))
    def (>=~)(c, b) = Mask(__simdCmp(5, __simdSplat(charToInt(c)), b))
}
pub instance (SimdLane n I8) => SimdOrd (Simd n I8) Char (Mask n I8) {
    def (<~)(a, c) = Mask(__simdCmp(2, a, __simdSplat(charToInt(c))))
    def (<=~)(a, c) = Mask(__simdCmp(3, a, __simdSplat(charToInt(c))))
    def (>~)(a, c) = Mask(__simdCmp(4, a, __simdSplat(charToInt(c))))
    def (>=~)(a, c) = Mask(__simdCmp(5, a, __simdSplat(charToInt(c))))
}
pub instance (SimdLane n I8) => SimdOrd Char (Simd n I8)(Mask n I8) {
    def (<~)(c, b) = Mask(__simdCmp(2, __simdSplat(charToInt(c)), b))
    def (<=~)(c, b) = Mask(__simdCmp(3, __simdSplat(charToInt(c)), b))
    def (>~)(c, b) = Mask(__simdCmp(4, __simdSplat(charToInt(c)), b))
    def (>=~)(c, b) = Mask(__simdCmp(5, __simdSplat(charToInt(c)), b))
}
pub instance (SimdLane n Int64) => SimdOrd (Simd n Int64) Int64 (Mask n Int64) {
    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))
    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))
    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))
    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))
}
pub instance (SimdLane n U64) => SimdOrd (Simd n U64) Int64 (Mask n U64) {
    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))
    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))
    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))
    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))
}
pub instance (SimdLane n Float32) => SimdOrd (Simd n Float32) Float32 (Mask n Float32) {
    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))
    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))
    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))
    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))
}
pub instance (SimdLane n Float32) => SimdOrd (Simd n Float32) Float (Mask n Float32) {
    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))
    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))
    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))
    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))
}
pub instance (SimdLane n Float) => SimdOrd (Simd n Float) Float (Mask n Float) {
    def (<~)(a, s) = Mask(__simdCmp(2, a, __simdSplat(s)))
    def (<=~)(a, s) = Mask(__simdCmp(3, a, __simdSplat(s)))
    def (>~)(a, s) = Mask(__simdCmp(4, a, __simdSplat(s)))
    def (>=~)(a, s) = Mask(__simdCmp(5, a, __simdSplat(s)))
}

// ============================================================================
// 6. Min / Max / Clamp, Reductions, Saturating Int & IEEE Float SIMD Ops
// ============================================================================

/// Lane-wise minimum (signed/unsigned/IEEE minnum).
simdMin: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e
pub def simdMin(a, b) = __simdBin(8, a, b)

/// Lane-wise maximum (signed/unsigned/IEEE maxnum).
simdMax: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e
pub def simdMax(a, b) = __simdBin(9, a, b)

/// Lane-wise clamp of `v` into `[lo, hi]`.
simdClamp: forall n e. (SimdLane n e) => (Simd n e, Simd n e, Simd n e) -> Simd n e
pub def simdClamp(v, lo, hi) = simdMin(simdMax(v, lo), hi)

/// Lane-wise absolute value.
simdAbs: forall n e. (SimdLane n e) => Simd n e -> Simd n e
pub def simdAbs(v) = __simdUnary(2, v)

/// Horizontal sum across all lanes (wrapping for integers, pairwise halving tree for floats).
reduceAdd: forall n e s. (SimdVec n e s) => Simd n e -> s
pub def reduceAdd(v) = __simdReduce(0, v)

/// Horizontal minimum across all lanes.
reduceMin: forall n e s. (SimdVec n e s) => Simd n e -> s
pub def reduceMin(v) = __simdReduce(1, v)

/// Horizontal maximum across all lanes.
reduceMax: forall n e s. (SimdVec n e s) => Simd n e -> s
pub def reduceMax(v) = __simdReduce(2, v)

/// Horizontal bitwise OR across all integer lanes.
reduceBitOr: forall n e s. (SimdVec n e s, SimdBits n e) => Simd n e -> s
pub def reduceBitOr(v) = __simdReduce(3, v)

/// Horizontal bitwise AND across all integer lanes.
reduceBitAnd: forall n e s. (SimdVec n e s, SimdBits n e) => Simd n e -> s
pub def reduceBitAnd(v) = __simdReduce(4, v)

/// Saturating lane-wise addition (`sadd.sat` / `uadd.sat`).
addSat: forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e
pub def addSat(a, b) = __simdBin(10, a, b)

/// Saturating lane-wise addition operator (`+|`, precedence 11).
(+|): forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e
pub def (+|)(a, b) = __simdBin(10, a, b)

/// Saturating lane-wise subtraction (`ssub.sat` / `usub.sat`).
subSat: forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e
pub def subSat(a, b) = __simdBin(11, a, b)

/// Saturating lane-wise subtraction operator (`-|`, precedence 11).
(-|): forall n e. (SimdBits n e) => (Simd n e, Simd n e) -> Simd n e
pub def (-|)(a, b) = __simdBin(11, a, b)

/// Lane-wise bit rotate-left by `amt` bits.
rotl: forall n e. (SimdBits n e) => (Simd n e, Int) -> Simd n e
pub def rotl(v, amt) = {
    let w = laneBits(v);
    let k = amt & (w - 1);
    if (k == 0) v else (v << k) | (v >>> (w - k))
}

/// Lane-wise bit rotate-right by `amt` bits.
rotr: forall n e. (SimdBits n e) => (Simd n e, Int) -> Simd n e
pub def rotr(v, amt) = {
    let w = laneBits(v);
    let k = amt & (w - 1);
    if (k == 0) v else (v >>> k) | (v << (w - k))
}

/// IEEE-754 floating-point SIMD operations (`Float32`, `Float`).
pub concept SimdFloat n e s : SimdVec n e s | e -> s {
    def simdFma(a: Simd n e, b: Simd n e, c: Simd n e): Simd n e,
    def simdSqrt(v: Simd n e): Simd n e,
    def simdFloor(v: Simd n e): Simd n e,
    def simdCeil(v: Simd n e): Simd n e,
    def simdRound(v: Simd n e): Simd n e
}

pub instance SimdFloat L4 Float32 Float32 {
    def simdFma(a, b, c) = __simdFma(a, b, c)
    def simdSqrt(v) = __simdUnary(3, v)
    def simdFloor(v) = __simdUnary(4, v)
    def simdCeil(v) = __simdUnary(5, v)
    def simdRound(v) = __simdUnary(6, v)
}
pub instance SimdFloat L8 Float32 Float32 {
    def simdFma(a, b, c) = __simdFma(a, b, c)
    def simdSqrt(v) = __simdUnary(3, v)
    def simdFloor(v) = __simdUnary(4, v)
    def simdCeil(v) = __simdUnary(5, v)
    def simdRound(v) = __simdUnary(6, v)
}
pub instance SimdFloat L2 Float Float {
    def simdFma(a, b, c) = __simdFma(a, b, c)
    def simdSqrt(v) = __simdUnary(3, v)
    def simdFloor(v) = __simdUnary(4, v)
    def simdCeil(v) = __simdUnary(5, v)
    def simdRound(v) = __simdUnary(6, v)
}
pub instance SimdFloat L4 Float Float {
    def simdFma(a, b, c) = __simdFma(a, b, c)
    def simdSqrt(v) = __simdUnary(3, v)
    def simdFloor(v) = __simdUnary(4, v)
    def simdCeil(v) = __simdUnary(5, v)
    def simdRound(v) = __simdUnary(6, v)
}

/// Horizontal dot product `reduceAdd(a * b)`.
simdDot: forall n e s. (SimdFloat n e s) => (Simd n e, Simd n e) -> s
pub def simdDot(a, b) = {
    let prod: Simd n e = __simdBin(2, a, b);
    __simdReduce(0, prod)
}

// ============================================================================
// 7. Permutations, Swizzles, Halves, Widening / Narrowing & Casts
// ============================================================================

/// Reverse all lanes of `v`.
reverseLanes: forall n e. (SimdLane n e) => Simd n e -> Simd n e
pub def reverseLanes(v) = __simdPermute(0, v, v, 0)

/// Interleave low halves of `a` and `b` (`[a0, b0, a1, b1, ...]`).
zipLo: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e
pub def zipLo(a, b) = __simdPermute(1, a, b, 0)

/// Interleave high halves of `a` and `b`.
zipHi: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e
pub def zipHi(a, b) = __simdPermute(2, a, b, 0)

/// De-interleave even-indexed lanes across `a` followed by `b` (`[a0, a2, ..., b0, b2, ...]`).
unzipEven: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e
pub def unzipEven(a, b) = __simdPermute(3, a, b, 0)

/// De-interleave odd-indexed lanes across `a` followed by `b` (`[a1, a3, ..., b1, b3, ...]`).
unzipOdd: forall n e. (SimdLane n e) => (Simd n e, Simd n e) -> Simd n e
pub def unzipOdd(a, b) = __simdPermute(4, a, b, 0)

/// Dynamic 16-byte lookup table (`tbl.16b` / `pshufb` / `i8x16.swizzle`):
/// selects `table[idx[i]]` when `0 <= idx[i] < 16` and `0` when `idx[i] >= 16`.
pub def swizzleZero(table: U8x16, idx: U8x16): U8x16 = __simdPermute(6, table, idx, 0)

/// Parallel 32-byte lookup into a 16-byte table (`vpshufb` / dual `tbl.16b` / dual `i8x16.swizzle`):
/// for each lane `i` in `0..31`, selects `table[idx[i]]` when `0 <= idx[i] < 16` and `0` otherwise.
pub def swizzle32(table: U8x16, idx: U8x32): U8x32 = {
    let tbl32: U8x32 = __simdCombine(0, table, table);
    __simdPermute(6, tbl32, idx, 0)
}

/// Shift `curr` right by 1 byte, shifting in the last byte `prev[15]` into lane 0 (`ext.16b` / `palignr`).
pub def prev1Byte16(curr: U8x16, prev: U8x16): U8x16 = __simdPermute(5, prev, curr, 15)

/// Shift `curr` right by 1 byte across 32 lanes, shifting `prev[31]` into lane 0.
pub def prev1Byte32(curr: U8x32, prev: U8x32): U8x32 = __simdPermute(5, prev, curr, 31)

/// Shift bytes of `v` toward lane 0 by `k` (`0..16`), filling vacated upper lanes with `0`.
pub def shiftBytesRightZero16(v: U8x16, k: Int): U8x16 =
    if (k <= 0) v
    else if (k >= 16) zero()
    else {
        let baseIdx: U8x16 = iota();
        swizzleZero(v, baseIdx + k)
    }

/// Relates a 128-bit vector `Simd nHalf e` and its 256-bit counterpart `Simd nFull e`.
pub concept SimdHalves nHalf nFull e | nHalf -> nFull, nFull -> nHalf {
    def splitHalves(v: Simd nFull e): (Simd nHalf e, Simd nHalf e),
    def concatHalves(lo: Simd nHalf e, hi: Simd nHalf e): Simd nFull e
}

pub instance SimdHalves L16 L32 I8 {
    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))
    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)
}
pub instance SimdHalves L16 L32 U8 {
    def splitHalves(v) = (__simdConvert(4, v), __simdConvert(5, v))
    def concatHalves(lo, hi) = __simdCombine(0, lo, hi)
