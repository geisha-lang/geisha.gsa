// Bit manipulation helpers (`std.bits`) backed by LLVM hardware bit intrinsics (`ctpop` / `cttz` / `ctlz`)

/// Return `true` when every bit in `mask` is set in `flags`.
pub def hasFlag(flags: Int, mask: Int): Bool
    ensures r -> r <==> ((flags & mask) == mask)
= (flags & mask) == mask

/// Set all bits of `mask` in `flags`.
pub def setFlag(flags: Int, mask: Int): Int
    ensures r -> (r & mask) == mask
= flags | mask

/// Clear all bits of `mask` in `flags`.
pub def clearFlag(flags: Int, mask: Int): Int
    ensures r -> (r & mask) == 0
= flags & ~mask

/// Flip all bits of `mask` in `flags`.
pub def toggleFlag(flags: Int, mask: Int): Int
    ensures r -> (r ^ mask) == flags
= flags ^ mask

/// Count set `1` bits in a 32-bit `Int`.
pub def popCount(x: Int): Int
    ensures r -> r >= 0 && r <= 32 && ((r == 0) <==> (x == 0))
= bitPopCount(x)

/// Count set `1` bits in a 64-bit `Int64`.
pub def popCount64(x: Int64): Int
    ensures r -> r >= 0 && r <= 64 && ((r == 0) <==> (x == intToI64(0)))
= bitPopCount64(x)

/// Count trailing `0` bits in a 32-bit `Int` (`32` when `x == 0`).
pub def trailingZeros(x: Int): Int
    ensures r -> r >= 0 && r <= 32 && ((r == 32) <==> (x == 0))
= bitCtz(x)

/// Count trailing `0` bits in a 64-bit `Int64` (`64` when `x == 0`).
pub def trailingZeros64(x: Int64): Int
    ensures r -> r >= 0 && r <= 64 && ((r == 64) <==> (x == intToI64(0)))
= bitCtz64(x)

/// Count leading `0` bits in a 32-bit `Int` (`32` when `x == 0`).
pub def leadingZeros(x: Int): Int
    ensures r -> r >= 0 && r <= 32 && ((r == 32) <==> (x == 0))
= bitClz(x)

/// Count leading `0` bits in a 64-bit `Int64` (`64` when `x == 0`).
pub def leadingZeros64(x: Int64): Int
    ensures r -> r >= 0 && r <= 64 && ((r == 64) <==> (x == intToI64(0)))
= bitClz64(x)

/// Inclusive prefix XOR across all 32 bits of `x` (`bit k = x[0] ^ ... ^ x[k]`).
/// Equivalent to carryless multiply by `0xFFFFFFFF`; turns delimiter bitmasks into interior region masks.
pub def prefixXor(x: Int): Int = {
    let a = x ^ (x << 1);
    let b = a ^ (a << 2);
    let c = b ^ (b << 4);
    let d = c ^ (c << 8);
    d ^ (d << 16)
}

/// Inclusive prefix XOR across all 64 bits of `x` (`bit k = x[0] ^ ... ^ x[k]`).
/// Equivalent to carryless multiply by `-1` (`0xFFFFFFFFFFFFFFFF`).
pub def prefixXor64(x: Int64): Int64 = {
    let a = x ^ (x << 1);
    let b = a ^ (a << 2);
    let c = b ^ (b << 4);
    let d = c ^ (c << 8);
    let e = d ^ (d << 16);
    e ^ (e << 32)
}
